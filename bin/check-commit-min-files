#!/usr/bin/env bash
set -euo pipefail

MIN_FILES=5
SCHEMA_PATH='db/schema.rb'

count_paths() {
  sed '/^$/d' | LC_ALL=C sort -u | awk 'END { print NR+0 }'
}

validate_changes() {
  local reference="$1" paths="$2" statuses="$3" changed
  changed="$(printf '%s\n' "$paths" | count_paths)"

  if (( changed >= MIN_FILES )); then
    printf 'OK: %s contiene %s archivos modificados (mínimo %s).\n' "$reference" "$changed" "$MIN_FILES"
    return 0
  fi

  # Única excepción: el archivo de esquema existente fue modificado (M)
  # y ningún otro archivo forma parte del commit.
  if (( changed == 1 )) && [[ "$statuses" == "$(printf 'M\t%s' "$SCHEMA_PATH")" ]]; then
    printf 'OK: %s modifica exclusivamente %s (excepción del esquema).\n' "$reference" "$SCHEMA_PATH"
    return 0
  fi

  printf 'ERROR: %s contiene %s archivos modificados.\n' "$reference" "$changed" >&2
  printf 'Se requieren al menos %s archivos relacionados, excepto un único archivo modificado: %s.\n' "$MIN_FILES" "$SCHEMA_PATH" >&2
  printf 'No se permiten altas, eliminaciones ni renombres como excepción del esquema.\n' >&2
  printf 'No agregues cambios artificiales para superar el mínimo.\n' >&2
  return 1
}

check_commit() {
  local revision="$1" parents paths statuses
  parents="$(git rev-list --parents -n 1 "$revision")"
  if (( $(wc -w <<< "$parents") > 2 )); then
    printf 'INFO: %s es un commit de fusión; se omite la regla de tamaño.\n' "$revision"
    return 0
  fi

  if git rev-parse -q --verify "${revision}^" >/dev/null 2>&1; then
    paths="$(git diff --no-renames --name-only --diff-filter=ACDMRTUXB "${revision}^" "$revision")"
    statuses="$(git diff --no-renames --name-status --diff-filter=ACDMRTUXB "${revision}^" "$revision")"
  else
    paths="$(git diff-tree --root --no-renames --no-commit-id --name-only -r "$revision")"
    statuses="$(git diff-tree --root --no-renames --no-commit-id --name-status -r "$revision")"
  fi
  validate_changes "$revision" "$paths" "$statuses"
}

case "${1:---staged}" in
  --staged)
    paths="$(git diff --cached --no-renames --name-only --diff-filter=ACDMRTUXB)"
    statuses="$(git diff --cached --no-renames --name-status --diff-filter=ACDMRTUXB)"
    validate_changes 'el área de preparación (staging)' "$paths" "$statuses"
    ;;
  --commit)
    [[ $# -eq 2 ]] || { echo 'Uso: check-commit-min-files --commit SHA' >&2; exit 2; }
    check_commit "$2"
    ;;
  --range)
    [[ $# -eq 3 ]] || { echo 'Uso: check-commit-min-files --range ANTES DESPUES' >&2; exit 2; }
    while IFS= read -r revision; do
      check_commit "$revision"
    done < <(git rev-list --reverse --no-merges "${2}..${3}")
    ;;
  *)
    echo 'Uso: check-commit-min-files [--staged | --commit SHA | --range ANTES DESPUES]' >&2
    exit 2
    ;;
esac
