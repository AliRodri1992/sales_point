#!/usr/bin/env bash
set -euo pipefail

export RAILS_ENV=test
export POSTGRES_DB_TEST="${POSTGRES_DB_TEST:-sale_point_test}"
export POSTGRES_USER="${POSTGRES_USER:-postgres}"
export POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-postgres}"
export POSTGRES_HOST="${POSTGRES_HOST:-db}"
export POSTGRES_PORT="${POSTGRES_PORT:-5432}"

if docker ps --format '{{.Names}}' | grep -qx 'rails_sale_point'; then
  exec docker exec \
    -e RAILS_ENV="$RAILS_ENV" \
    -e POSTGRES_DB_TEST="$POSTGRES_DB_TEST" \
    -e POSTGRES_USER="$POSTGRES_USER" \
    -e POSTGRES_PASSWORD="$POSTGRES_PASSWORD" \
    -e POSTGRES_HOST="$POSTGRES_HOST" \
    -e POSTGRES_PORT="$POSTGRES_PORT" \
    rails_sale_point \
    sh -lc 'unset DATABASE_URL && bundle exec rails db:test:prepare && bundle exec rspec "$@"' \
    overcommit-rspec "$@"
fi

bundle exec rails db:test:prepare
exec bundle exec rspec
