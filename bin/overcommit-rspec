#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

fail() {
  printf '[RSpec] ERROR: %s\n' "$1" >&2
  exit 1
}

command -v docker >/dev/null 2>&1 || fail 'Docker no está instalado o no está en PATH.'
docker info >/dev/null 2>&1 || fail 'Docker Desktop no está iniciado o el daemon no está disponible.'
docker compose version >/dev/null 2>&1 || fail 'Se requiere Docker Compose v2 (docker compose).'

compose=(docker compose -f docker-compose.dev.yml)

# These test-only overrides target PostgreSQL on the Compose network, never
# localhost or a development DATABASE_URL inherited from the container.
test_environment=(
  -e RAILS_ENV=test
  -e POSTGRES_DB_TEST="${POSTGRES_DB_TEST:-sale_point_test}"
  -e POSTGRES_HOST=db
  -e POSTGRES_PORT=5432
  -e POSTGRES_USER=postgres
  -e POSTGRES_PASSWORD=postgres
)

rails_and_specs='unset DATABASE_URL; exec bundle exec ruby bin/with-test-db-lock sh -lc '\''bin/rails db:prepare && exec bundle exec rspec "$@"'\'' overcommit-rspec "$@"'

# Always run in an isolated, disposable container to prevent browser specs
# and test processes from exhausting the live development web container.
printf '[RSpec] Ejecutando pruebas en un contenedor temporal aislado; el servidor web no se interrumpe.\n'
command=("${compose[@]}" run --rm -T "${test_environment[@]}" web sh -lc "$rails_and_specs" overcommit-rspec "$@")

status=0
"${command[@]}" || status=$?
if (( status != 0 )); then
  printf '[RSpec] ERROR: No se completó db:prepare + RSpec en Docker (código %s). Revisa los errores de PostgreSQL o de las pruebas.\n' "$status" >&2
fi
exit "$status"
