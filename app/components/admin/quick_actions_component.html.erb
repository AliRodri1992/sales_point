<!-- Quick Actions -->
<div
  class="grid-stack-item"
  gs-id="quick-actions"
  gs-x="8"
  gs-y="0"
  gs-w="4"
  gs-h="5"
  gs-min-w="4"
  gs-min-h="5"
>
  <div class="grid-stack-item-content dashboard-widget">

    <div class="dashboard-widget-card h-full rounded-2xl border border-slate-200 bg-white p-6">

      <div class="mb-6 flex items-center justify-between">
        <div>
          <h2 class="font-bold text-slate-900">
            <%= t('admin.dashboard.widgets.quick_actions.title') %>
          </h2>

          <p class="mt-1 text-xs text-slate-600">
            <%= t('admin.dashboard.widgets.quick_actions.subtitle') %>
          </p>
        </div>
      </div>

      <% unless sales_ready? %>
        <div class="mb-4 rounded-xl border border-amber-200 bg-amber-50 p-3" role="status">
          <div class="flex items-start gap-2">
            <%= helpers.delta_icon "exclamation-triangle", class: "mt-0.5 size-4 shrink-0 text-amber-600" %>
            <div>
              <p class="text-xs font-semibold text-amber-800"><%= t('admin.dashboard.onboarding.action_required') %></p>
              <p class="mt-1 text-xs text-amber-700">
                <%= t('admin.dashboard.onboarding.sales_dependency', sections: sales_missing_sections.map { |section| t("admin.onboarding.sections.#{section}") }.to_sentence) %>
              </p>
              <% if @onboarding_progress.present? %>
                <%= link_to t('admin.dashboard.onboarding.continue'),
                            admin_onboarding_path,
                            class: "mt-2 inline-flex text-xs font-semibold text-amber-800 underline decoration-amber-300 underline-offset-2 hover:text-amber-900" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <div class="dashboard-quick-actions">
        <%= link_to new_admin_product_path, class: "dashboard-action-link" do %>
          <span class="dashboard-action-icon"><%= helpers.delta_icon("plus", class: "size-5") %></span>
          <span><strong><%= t('admin.dashboard.widgets.quick_actions.product') %></strong><small><%= t('admin.dashboard.widgets.quick_actions.add_product') %></small></span>
          <%= helpers.delta_icon("arrow-right", class: "size-4 dashboard-action-arrow") %>
        <% end %>
        <%= link_to new_admin_client_path, class: "dashboard-action-link" do %>
          <span class="dashboard-action-icon"><%= helpers.delta_icon("users", class: "size-5") %></span>
          <span><strong><%= t('admin.dashboard.widgets.quick_actions.customer') %></strong><small><%= t('admin.dashboard.widgets.quick_actions.new_customer') %></small></span>
          <%= helpers.delta_icon("arrow-right", class: "size-4 dashboard-action-arrow") %>
        <% end %>
        <div class="dashboard-upcoming-actions">
          <span><%= t('admin.dashboard.widgets.quick_actions.new_sale') %> · <%= t('admin.dashboard.widgets.quick_actions.cash_cut') %></span>
          <span class="dashboard-upcoming-badge"><%= t('admin.dashboard.experience.coming_soon') %></span>
        </div>
      </div>
    </div>
  </div>
</div>
