<!-- Recent Sales -->
<!-- RECENT SALES -->

<div
  class="grid-stack-item"
  gs-id="recent-sales"
  gs-x="0"
  gs-y="5"
  gs-w="8"
  gs-h="7"
>
  <div class="grid-stack-item-content dashboard-widget dashboard-widget--row-gap">

    <div class="dashboard-widget-card h-[calc(100%-2rem)] overflow-hidden rounded-2xl border border-slate-200 bg-white md:h-full">

      <div class="flex items-center justify-between p-6">

        <div>
          <h3 class="font-bold">
            <%= t('admin.dashboard.widgets.recent_sales.title') %>
          </h3>

          <p class="mt-1 text-xs text-slate-400">
            <%= t('admin.dashboard.widgets.recent_sales.subtitle') %>
          </p>
        </div>

        <a
          href="#"
          class="text-xs font-semibold text-nexus-blue hover:text-nexus-hover"
        >
          <%= t('admin.dashboard.widgets.recent_sales.view_all') %>
        </a>

      </div>

      <div class="overflow-x-auto">

        <table class="w-full text-sm">

          <thead>
          <tr class="border-y border-slate-100 text-xs text-slate-400">

            <th class="px-6 py-3 text-left font-medium">
              <%= t('admin.dashboard.widgets.recent_sales.columns.folio') %>
            </th>

            <th class="px-6 py-3 text-left font-medium">
              <%= t('admin.dashboard.widgets.recent_sales.columns.customer') %>
            </th>

            <th class="px-6 py-3 text-left font-medium">
              <%= t('admin.dashboard.widgets.recent_sales.columns.method') %>
            </th>

            <th class="px-6 py-3 text-right font-medium">
              <%= t('admin.dashboard.widgets.recent_sales.columns.total') %>
            </th>

            <th class="px-6 py-3 text-right font-medium">
              <%= t('admin.dashboard.widgets.recent_sales.columns.status') %>
            </th>

          </tr>
          </thead>

          <tbody class="divide-y divide-slate-100">

          <% sales.each do |sale| %>
            <tr class="hover:bg-slate-50">

              <td class="px-6 py-4 font-semibold">
                <%= sale.folio %>
              </td>

              <td class="px-6 py-4">
                <%= sale.customer %>
              </td>

              <td class="px-6 py-4 text-slate-500">
                <%= t('admin.dashboard.widgets.recent_sales.payment_methods.' + sale.payment_method.to_s) %>
              </td>

              <td class="px-6 py-4 text-right font-semibold tabular-nums">
                <%= sale.total %>
              </td>

              <td class="px-6 py-4 text-right">

                  <span
                    class="inline-flex rounded-full px-2 py-1 text-[11px] font-semibold <%= sale.status_background %> <%= sale.status_text %>"
                  >
                    <%= t('admin.dashboard.widgets.recent_sales.statuses.' + sale.status.to_s) %>
                  </span>

              </td>

            </tr>
          <% end %>

          </tbody>

        </table>

      </div>

    </div>

  </div>
</div>
