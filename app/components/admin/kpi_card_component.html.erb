<div class="dashboard-widget rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="flex items-start justify-between">
    <div>
      <p class="text-sm font-medium text-slate-500">
        <%= title %>
      </p>

      <p class="mt-2 text-2xl font-bold tracking-tight text-slate-900">
        <%= value %>
      </p>
    </div>

    <% if icon.present? %>
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
        <i class="<%= icon %>"></i>
      </div>
    <% end %>
  </div>

  <div class="mt-3">
    <% if change.present? %>
      <span class="inline-flex items-center gap-1 text-sm font-medium text-emerald-600">
        <%= change %>
      </span>
    <% end %>

    <% if status.present? %>
      <span class="text-sm font-medium text-emerald-600">
        <%= status %>
      </span>
    <% end %>
  </div>
</div>