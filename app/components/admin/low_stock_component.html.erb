<!-- Low Stock -->
<div
  class="grid-stack-item"
  gs-id="low-stock"
  gs-x="8"
  gs-y="5"
  gs-w="4"
  gs-h="5"
  gs-min-w="4"
  gs-min-h="5"
>
  <div class="grid-stack-item-content dashboard-widget">

    <div class="dashboard-widget-card h-full overflow-hidden rounded-2xl border border-slate-200 bg-white">

      <div class="flex items-center justify-between p-6">

        <div>
          <h2 class="font-bold">
            <%= t('admin.dashboard.widgets.low_stock.title') %>
          </h2>

          <p class="mt-1 text-xs text-slate-600">
            <%= t('admin.dashboard.widgets.low_stock.subtitle') %>
          </p>
        </div>

        <span class="rounded-full bg-amber-50 px-2 py-1 text-xs font-semibold text-amber-700">
          <%= t('admin.dashboard.widgets.low_stock.alerts', count: alert_count) %>
        </span>

      </div>

      <div class="space-y-4 px-6 pb-5">

        <% products.each do |product| %>
          <div class="flex items-center gap-3">

            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-slate-100 text-slate-600">

              <svg
                class="h-5 w-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M20 7l-8-4-8 4m16 0v10l-8 4-8-4V7m16 0l-8 4m-8-4l8 4m0 0v10"
                  />
              </svg>

            </div>

            <div class="min-w-0 flex-1">

              <p class="truncate text-sm font-medium">
                <%= product.name %>
              </p>

              <p class="text-xs text-slate-600">
                <%= t('admin.dashboard.widgets.low_stock.sku', sku: product.sku) %>
              </p>

            </div>

            <span class="text-xs font-bold <%= product.quantity_color %>">
              <%= t('admin.dashboard.widgets.low_stock.units', count: product.quantity) %>
            </span>

          </div>
        <% end %>

        <p class="text-xs text-slate-600"><%= t('admin.dashboard.experience.sample_data') %></p>

      </div>

    </div>

  </div>
</div>