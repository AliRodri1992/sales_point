<div class="<%= wrapper_classes %>">
  <% if badge.present? %>
    <div class="mb-4">
      <%= render Ui::BadgeComponent.new(text: badge) %>
    </div>
  <% end %>

  <h2 class="text-4xl font-extrabold tracking-tight text-slate-900 lg:text-5xl">
    <%= title %>
  </h2>

  <% if subtitle.present? %>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-slate-600">
      <%= subtitle %>
    </p>
  <% end %>
</div>