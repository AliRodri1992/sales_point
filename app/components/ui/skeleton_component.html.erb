<div class="delta-skeleton delta-skeleton--<%= variant %>" aria-hidden="true">
  <% case variant %>
  <% when :table %>
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
        <span class="delta-skeleton__bar h-4 w-32 rounded-md"></span>
        <span class="delta-skeleton__bar h-3 w-16 rounded-md"></span>
      </div>
      <div class="hidden overflow-hidden md:block">
        <div class="delta-skeleton__table-grid border-b border-slate-100 bg-slate-50 px-5 py-4" style="--skeleton-columns: <%= columns %>">
          <% columns.times do %>
            <span class="delta-skeleton__bar h-3 w-3/4 rounded-md"></span>
          <% end %>
        </div>
        <% rows.times do %>
          <div class="delta-skeleton__table-grid min-h-16 border-b border-slate-100 px-5 py-4 last:border-b-0" style="--skeleton-columns: <%= columns %>">
            <% columns.times do |index| %>
              <div class="flex items-center gap-2">
                <% if index.zero? %><span class="delta-skeleton__bar size-8 shrink-0 rounded-lg"></span><% end %>
                <span class="delta-skeleton__bar h-3 <%= index.zero? ? 'w-3/5' : 'w-4/5' %> rounded-md"></span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
      <div class="grid gap-3 p-4 md:hidden">
        <% rows.times do %>
          <div class="rounded-xl border border-slate-100 p-4">
            <div class="flex items-center gap-3">
              <span class="delta-skeleton__bar size-10 shrink-0 rounded-xl"></span>
              <div class="flex-1 space-y-2">
                <div class="delta-skeleton__bar h-3 w-3/4 rounded-md"></div>
                <div class="delta-skeleton__bar h-3 w-2/5 rounded-md"></div>
              </div>
              <span class="delta-skeleton__bar h-6 w-14 rounded-full"></span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% when :dashboard %>
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <% 4.times do %>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex justify-between gap-4">
            <div class="flex-1 space-y-4">
              <div class="delta-skeleton__bar h-3 w-2/3 rounded-md"></div>
              <div class="delta-skeleton__bar h-7 w-3/4 rounded-md"></div>
            </div>
            <span class="delta-skeleton__bar size-10 rounded-xl"></span>
          </div>
          <div class="delta-skeleton__bar mt-4 h-3 w-1/3 rounded-md"></div>
        </div>
      <% end %>
    </div>
    <div class="mt-5 rounded-2xl border border-slate-200 bg-white p-6">
      <div class="delta-skeleton__bar h-4 w-44 rounded-md"></div>
      <div class="mt-7 flex h-44 items-end gap-3">
        <% 8.times do |index| %>
          <div class="delta-skeleton__bar flex-1 rounded-t-lg" style="height: <%= 40 + ((index * 19) % 60) %>%"></div>
        <% end %>
      </div>
    </div>
  <% when :card %>
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      <% rows.times do %>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-center gap-3">
            <span class="delta-skeleton__bar size-12 shrink-0 rounded-xl"></span>
            <div class="flex-1 space-y-2">
              <div class="delta-skeleton__bar h-4 w-3/4 rounded-md"></div>
              <div class="delta-skeleton__bar h-3 w-1/2 rounded-md"></div>
            </div>
          </div>
          <div class="delta-skeleton__bar mt-5 h-3 w-full rounded-md"></div>
          <div class="delta-skeleton__bar mt-2 h-3 w-4/5 rounded-md"></div>
          <div class="delta-skeleton__bar mt-5 h-8 w-28 rounded-lg"></div>
        </div>
      <% end %>
    </div>
  <% when :form %>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
      <div class="delta-skeleton__bar h-5 w-44 rounded-md"></div>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        <% rows.times do %>
          <div class="space-y-2">
            <div class="delta-skeleton__bar h-3 w-28 rounded-md"></div>
            <div class="delta-skeleton__bar h-11 w-full rounded-xl"></div>
          </div>
        <% end %>
      </div>
      <div class="mt-7 flex justify-end gap-3">
        <span class="delta-skeleton__bar h-10 w-24 rounded-xl"></span>
        <span class="delta-skeleton__bar h-10 w-32 rounded-xl"></span>
      </div>
    </div>
  <% when :detail %>
    <div class="grid gap-5 lg:grid-cols-[minmax(0,2fr)_minmax(14rem,1fr)]">
      <div class="space-y-5">
        <% 2.times do %>
          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <div class="delta-skeleton__bar h-5 w-40 rounded-md"></div>
            <div class="mt-6 grid gap-5 sm:grid-cols-2">
              <% rows.times do %>
                <div class="space-y-2">
                  <div class="delta-skeleton__bar h-3 w-24 rounded-md"></div>
                  <div class="delta-skeleton__bar h-4 w-3/4 rounded-md"></div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <div class="delta-skeleton__bar size-16 rounded-2xl"></div>
        <div class="delta-skeleton__bar mt-4 h-5 w-3/4 rounded-md"></div>
        <div class="delta-skeleton__bar mt-3 h-3 w-1/2 rounded-md"></div>
      </div>
    </div>
  <% when :list %>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
      <% rows.times do %>
        <div class="flex items-center gap-3 border-b border-slate-100 px-5 py-4 last:border-b-0">
          <span class="delta-skeleton__bar size-11 shrink-0 rounded-full"></span>
          <div class="flex-1 space-y-2">
            <div class="delta-skeleton__bar h-4 w-2/3 rounded-md"></div>
            <div class="delta-skeleton__bar h-3 w-1/3 rounded-md"></div>
          </div>
          <span class="delta-skeleton__bar h-8 w-16 rounded-lg"></span>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
