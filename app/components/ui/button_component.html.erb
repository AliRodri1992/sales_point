<% if href.present? %>
  <%= link_to href, class: classes do %>
    <% if icon.present? && icon_position == :left %>
      <%= helpers.icon icon_name, class: "h-5 w-5" %>
    <% end %>

    <%= text %>

    <% if icon.present? && icon_position == :right %>
      <%= helpers.icon icon_name, class: "h-5 w-5" %>
    <% end %>

  <% end %>

<% else %>

  <button type="button" class="<%= classes %>"
    <%= "disabled" if disabled %>>

    <% if icon.present? && icon_position == :left %>
      <%= helpers.icon icon_name, class: "h-5 w-5" %>
    <% end %>

    <%= text %>

    <% if icon.present? && icon_position == :right %>
      <%= helpers.icon icon_name, class: "h-5 w-5" %>
    <% end %>
  </button>
<% end %>