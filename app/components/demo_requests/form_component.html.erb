
<div class="mx-auto w-full max-w-sm space-y-4 my-auto" data-controller="demo-request-wizard">
  <% if notice.present? %>
    <div class="rounded-xl border border-emerald-100 bg-emerald-50 px-3 py-2 text-xs font-medium text-emerald-700" role="status"><%= notice %></div>
  <% end %>

  <% if demo_request.errors.any? %>
    <div class="rounded-xl border border-rose-100 bg-rose-50 px-3 py-2 text-xs text-rose-700" role="alert"><%= t('demo_requests.new.error_summary', count: demo_request.errors.count) %></div>
  <% end %>

  <div class="relative mx-auto mb-5 flex max-w-xs items-center justify-between select-none" aria-label="<%= t('demo_requests.new.progress_label') %>">
    <div class="absolute left-0 top-1/2 z-0 h-0.5 w-full -translate-y-1/2 bg-slate-100"><div data-demo-request-wizard-target="progress" class="h-full w-0 bg-[var(--demo-primary-start)] transition-all duration-300"></div></div>
    <% 2.times do |index| %>
      <% step = index + 1 %>
      <div data-demo-request-wizard-target="node" data-step="<%= step %>" class="z-10 flex h-7 w-7 items-center justify-center rounded-full text-xs font-bold transition-all duration-300 <%= step == 1 ? 'bg-[var(--demo-primary-start)] text-white shadow-sm' : 'bg-slate-100 text-slate-400' %>" aria-current="<%= step == 1 ? 'step' : nil %>"><%= step %></div>
    <% end %>
  </div>

  <%= form_with model: demo_request, class: 'space-y-3.5', data: { 'demo-request-wizard-target': 'form', action: 'submit->demo-request-wizard#submit', validation_title: t('demo_requests.new.validation_title') }, html: { novalidate: true } do |f| %>
    <div data-demo-request-wizard-target="step" data-step="1" class="space-y-3.5">
      <div>
        <h3 class="font-jakarta text-base font-extrabold leading-none text-slate-900"><%= t('demo_requests.new.contact_title') %></h3>
        <p class="mt-1 text-[11px] font-medium leading-relaxed text-slate-400"><%= t('demo_requests.new.contact_description') %></p>
      </div>

      <% [['name', 'user'], ['email', 'envelope'], ['phone', 'phone']].each do |attribute, icon_name| %>
        <div>
          <%= f.label attribute, t("demo_requests.new.#{attribute}"), class: 'block font-jakarta text-xs font-medium text-slate-700' %>
          <div class="relative mt-1 rounded-xl shadow-sm">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400"><%= render Ui::IconComponent.new(name: icon_name, size: :sm, color: :gray) %></div>
            <%= f.public_send("#{attribute == 'email' ? 'email' : attribute == 'phone' ? 'telephone' : 'text'}_field", attribute, class: "#{field_classes(attribute)} pl-9 pr-3") %>
          </div>
          <%= error_for(attribute) %>
          <p data-demo-request-wizard-target="<%= attribute %>Error" class="mt-1 hidden text-[10px] font-medium text-rose-500" data-required-message="<%= t("demo_requests.new.required.#{attribute}") %>" data-invalid-message="<%= t('demo_requests.new.invalid_email') %>"><%= demo_request.errors[attribute].first if demo_request.errors[attribute].any? %></p>
        </div>
      <% end %>

      <div class="pt-1.5">
        <button type="button" data-action="demo-request-wizard#next" class="btn-delta-gradient flex w-full justify-center rounded-xl px-4 py-2 text-xs font-semibold text-white shadow-md transition-all duration-150 hover:scale-[0.99] active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--demo-primary-start)] focus-visible:ring-offset-2"><%= t('demo_requests.new.continue') %></button>
      </div>
    </div>

    <div data-demo-request-wizard-target="step" data-step="2" class="hidden space-y-3.5">
      <div>
        <h3 class="font-jakarta text-base font-extrabold leading-none text-slate-900"><%= t('demo_requests.new.business_title') %></h3>
        <p class="mt-1 text-[11px] font-medium leading-relaxed text-slate-400"><%= t('demo_requests.new.business_description') %></p>
      </div>

      <div class="relative w-full text-left">
        <label for="demo_business_type" class="mb-1 block font-jakarta text-xs font-medium text-slate-700"><%= t('demo_requests.new.business_type') %></label>
        <%= f.select :business_type,
          DemoRequest::BUSINESS_TYPES.map { |sector| [t("demo_requests.new.business_types.#{sector}"), sector] },
          { prompt: t('demo_requests.new.business_type_placeholder') },
          { id: 'demo_business_type',
            data: { 'demo-request-wizard-target': 'businessType' },
            class: 'w-full appearance-none rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500' } %>
        <%= render Ui::IconComponent.new(name: 'chevron-down', size: :xs, color: :gray, css_class: 'pointer-events-none absolute right-3 top-8') %>
        <%= error_for(:business_type) %>
        <p data-demo-request-wizard-target="businessError" class="mt-1 hidden text-[10px] font-medium text-rose-500"><%= t('demo_requests.new.required.business_type') %></p>
      </div>

      <div>
        <%= f.label :company, t('demo_requests.new.company'), class: 'block font-jakarta text-xs font-medium text-slate-700' %>
        <%= f.text_field :company, class: field_classes(:company), placeholder: t('demo_requests.new.company_placeholder') %>
        <%= error_for(:company) %>
      </div>

      <div>
        <%= f.label :branches, t('demo_requests.new.branches'), class: 'block font-jakarta text-xs font-medium text-slate-700' %>
        <%= f.number_field :branches, min: 1, max: DemoRequest::MAX_BRANCHES,
          data: { 'demo-request-wizard-target': 'branches' },
          class: 'mt-1 block w-full appearance-none rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-emerald-500' %>
        <%= error_for(:branches) %>
        <p data-demo-request-wizard-target="branchesError" class="mt-1 hidden text-[10px] font-medium text-rose-500"><%= t('demo_requests.new.required.branches') %></p>
      </div>

      <div>
        <%= f.label :message, t('demo_requests.new.message'), class: 'block font-jakarta text-xs font-medium text-slate-700' %>
        <%= f.text_area :message, rows: 2, class: field_classes(:message), placeholder: t('demo_requests.new.message_placeholder') %>
        <%= error_for(:message) %>
      </div>

      <div class="flex flex-col pt-1">
        <div class="flex items-start">
          <%= f.check_box :terms_accepted,
          { data: { 'demo-request-wizard-target': 'terms' },
            class: 'mt-0.5 h-4 w-4 rounded-md border-slate-300 text-[var(--demo-primary-start)] focus:ring-[var(--demo-primary-start)]' } %>
          <label for="demo_request_terms_accepted" class="ml-2 block text-[11px] leading-normal text-slate-500"><%= t('demo_requests.new.privacy') %> <%= link_to t('demo_requests.new.privacy_link'), root_path(anchor: 'privacy'), class: 'font-medium text-[var(--demo-primary-start)] transition-opacity hover:opacity-80' %>.</label>
        </div>
        <%= error_for(:terms_accepted) %>
        <p data-demo-request-wizard-target="termsError" class="mt-1 hidden text-[10px] font-medium text-rose-500"><%= t('demo_requests.new.required.terms') %></p>
      </div>

      <div class="grid grid-cols-2 gap-3 pt-1.5">
        <button type="button" data-action="demo-request-wizard#back" class="w-full rounded-xl border border-slate-200 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-300"><%= t('demo_requests.new.back_step') %></button>
        <%= f.submit t('demo_requests.new.submit'), class: 'btn-delta-gradient flex w-full justify-center rounded-xl px-4 py-2 text-xs font-semibold text-white shadow-md transition-all duration-150 hover:scale-[0.99] active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--demo-primary-start)] focus-visible:ring-offset-2', data: { 'demo-request-wizard-target': 'submit' } %>
      </div>
    </div>
  <% end %>

  <div class="mt-5 border-t border-slate-100 pt-4 text-center"><p class="text-xs text-slate-500"><%= t('demo_requests.new.return_prompt') %> <%= link_to t('demo_requests.new.return_home'), root_path, class: 'font-semibold text-[var(--demo-primary-start)]' %></p></div>
</div>
