<div class="space-y-6">
  <% if notice.present? %>
    <section class="success-state space-y-5 rounded-2xl border border-emerald-200 bg-white p-6 text-center shadow-sm" role="status" aria-live="polite" tabindex="-1" data-demo-request-wizard-target="success">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-emerald-50 text-2xl font-bold text-emerald-700" aria-hidden="true">✓</div>
      <h2 class="font-jakarta text-xl font-extrabold text-slate-900"><%= t('demo_requests.new.success_state.title') %></h2>
      <p class="text-sm leading-6 text-slate-600"><%= notice %></p>
      <p class="rounded-xl bg-slate-50 p-4 text-sm leading-6 text-slate-600"><%= t('demo_requests.new.success_state.next_steps') %></p>
      <%= link_to t('demo_requests.new.success_state.back_home'), root_path, class: 'btn-delta-gradient inline-flex w-full items-center justify-center rounded-xl px-4 py-3 text-sm font-semibold text-white' %>
    </section>
  <% else %>
    <% if demo_request.errors.any? %>
      <div class="demo-form-feedback" role="alert"><%= t('demo_requests.new.error_summary', count: demo_request.errors.count) %></div>
    <% end %>
    <div class="demo-form-feedback hidden" role="alert" tabindex="-1" data-demo-request-wizard-target="feedback"></div>
    <nav aria-label="<%= t('demo_requests.new.progress_label') %>">
      <div class="mb-4 h-1 overflow-hidden rounded-full bg-slate-100" aria-hidden="true"><div data-demo-request-wizard-target="progress" class="demo-progress h-full w-0"></div></div>
      <ol class="grid grid-cols-2 gap-3">
        <% [t('demo_requests.form.contact_step'), t('demo_requests.form.business_step')].each_with_index do |label, index| %>
          <li data-demo-request-wizard-target="node" data-step="<%= index + 1 %>" aria-current="<%= index.zero? ? 'step' : nil %>" class="demo-step-node">
            <span class="demo-step-number" aria-hidden="true"><%= index + 1 %></span><span><%= label %></span>
          </li>
        <% end %>
      </ol>
    </nav>
    <%= form_with model: demo_request, class: 'space-y-6',
      data: { 'demo-request-wizard-target': 'form', validation_title: t('demo_requests.new.validation_title'),
        action: 'submit->demo-request-wizard#submit input->demo-request-wizard#revalidate change->demo-request-wizard#revalidate focusout->demo-request-wizard#validateOnBlur international-phone:validated->demo-request-wizard#revalidate turbo:before-fetch-response->demo-request-wizard#beforeResponse turbo:submit-start->demo-request-wizard#submitStart turbo:submit-end->demo-request-wizard#submitEnd turbo:fetch-request-error->demo-request-wizard#requestError' },
      html: { novalidate: true } do |f| %>
      <div data-demo-request-wizard-target="step" data-step="1" class="space-y-5">
        <h2 class="demo-step-title" tabindex="-1"><%= t('demo_requests.new.contact_title') %></h2>
        <% [['name', 'user'], ['email', 'envelope'], ['phone', 'phone']].each do |attribute, icon_name| %>
          <% field = attribute.to_sym %>
          <div>
            <%= f.label field, demo_field_label(field), class: 'demo-field-label' %>
            <% if field == :phone %>
              <div class="mt-1.5" data-controller="international-phone">
                <%= f.telephone_field field, **field_options(field, data: { international_phone_target: 'input' }), class: field_classes(field), autocomplete: 'tel', inputmode: 'tel' %>
              </div>
            <% else %>
              <div class="relative mt-1.5">
                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400" aria-hidden="true"><%= render Ui::IconComponent.new(name: icon_name, size: :sm, color: :gray) %></span>
                <%= f.public_send(field == :email ? :email_field : :text_field, field, **field_options(field), class: "#{field_classes(field)} pl-10", autocomplete: field == :email ? 'email' : 'name') %>
              </div>
            <% end %>
            <div id="demo_request_<%= field %>_error" class="demo-field-error <%= 'hidden' if demo_request.errors[field].empty? %>" role="alert"><%= error_for(field) %></div>
          </div>
        <% end %>
        <button type="button" data-action="demo-request-wizard#next" class="btn-delta-gradient demo-primary-button"><%= t('demo_requests.new.continue') %></button>
      </div>
      <div data-demo-request-wizard-target="step" data-step="2" class="hidden space-y-5">
        <div>
          <h2 class="demo-step-title" tabindex="-1"><%= t('demo_requests.new.business_title') %></h2>
          <p class="mt-2 text-sm leading-6 text-slate-600"><%= t('demo_requests.new.business_description') %></p>
        </div>
        <div>
          <%= f.label :business_type, demo_field_label(:business_type), for: 'demo_business_type', class: 'demo-field-label' %>
          <%= f.select :business_type, DemoRequest::BUSINESS_TYPES.map { |sector| [t("demo_requests.new.business_types.#{sector}"), sector] },
            { prompt: t('demo_requests.new.business_type_placeholder') },
            field_options(:business_type).merge(id: 'demo_business_type', class: "#{field_classes(:business_type)} mt-1.5") %>
          <div id="demo_request_business_type_error" class="demo-field-error <%= 'hidden' if demo_request.errors[:business_type].empty? %>" role="alert"><%= error_for(:business_type) %></div>
        </div>
        <div>
          <%= f.label :company, demo_field_label(:company), class: 'demo-field-label' %>
          <%= f.text_field :company, **field_options(:company), class: "#{field_classes(:company)} mt-1.5", placeholder: t('demo_requests.new.company_placeholder'), autocomplete: 'organization' %>
          <div id="demo_request_company_error" class="demo-field-error <%= 'hidden' if demo_request.errors[:company].empty? %>" role="alert"><%= error_for(:company) %></div>
        </div>
        <div>
          <%= f.label :branches, demo_field_label(:branches), class: 'demo-field-label' %>
          <%= f.number_field :branches, **field_options(:branches), min: 1, max: DemoRequest::MAX_BRANCHES, step: 1, class: "#{field_classes(:branches)} mt-1.5" %>
          <div id="demo_request_branches_error" class="demo-field-error <%= 'hidden' if demo_request.errors[:branches].empty? %>" role="alert"><%= error_for(:branches) %></div>
        </div>
        <div>
          <%= f.label :message, t('demo_requests.new.message'), class: 'demo-field-label' %>
          <%= f.text_area :message, **field_options(:message), rows: 3, class: "#{field_classes(:message)} mt-1.5", placeholder: t('demo_requests.new.message_placeholder') %>
          <p class="mt-1 text-xs text-slate-600"><%= t('demo_requests.form.message_hint') %></p>
          <div id="demo_request_message_error" class="demo-field-error <%= 'hidden' if demo_request.errors[:message].empty? %>" role="alert"><%= error_for(:message) %></div>
        </div>
        <div>
          <div class="flex items-start gap-3">
            <%= f.check_box :terms_accepted, field_options(:terms_accepted).merge(class: 'demo-consent-checkbox') %>
            <label for="demo_request_terms_accepted" class="text-sm leading-6 text-slate-600">
              <%= t('demo_requests.new.privacy') %>
              <%= link_to t('demo_requests.new.privacy_link'), helpers.authentication_document_url(:privacy), target: '_blank', rel: 'noopener noreferrer', class: 'demo-link underline underline-offset-2' %>.
            </label>
          </div>
          <div id="demo_request_terms_accepted_error" class="demo-field-error <%= 'hidden' if demo_request.errors[:terms_accepted].empty? %>" role="alert"><%= error_for(:terms_accepted) %></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <button type="button" data-action="demo-request-wizard#back" class="demo-secondary-button"><%= t('demo_requests.new.back_step') %></button>
          <%= f.submit t('demo_requests.new.submit'), class: 'btn-delta-gradient demo-primary-button', data: { turbo_submits_with: t('demo_requests.form.sending') } %>
        </div>
      </div>
    <% end %>
    <p class="border-t border-slate-100 pt-5 text-center text-sm leading-6 text-slate-600"><%= t('demo_requests.new.return_prompt') %> <%= link_to t('demo_requests.new.return_home'), root_path, class: 'demo-link' %></p>
  <% end %>
</div>
