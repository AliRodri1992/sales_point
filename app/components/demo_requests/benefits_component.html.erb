<div class="relative z-10 flex h-full max-w-sm select-none flex-col justify-between text-white">
  <div class="flex items-center gap-3">
    <%= image_tag 'delta-pos-logo.svg', class: 'h-20 w-20 shrink-0', alt: t('demo_requests.new.logo_alt') %>
    <div class="flex flex-col leading-none">
      <span class="font-jakarta text-[30px] font-extrabold tracking-tight leading-none">DELTA <span class="text-emerald-500">POS</span></span>
      <span class="mt-0.5 font-inter text-xs font-medium uppercase tracking-[0.2em] text-gray-400"><%= t('demo_requests.new.brand_tagline') %></span>
    </div>
  </div>

  <div class="my-auto w-full space-y-5">
    <div class="space-y-2">
      <h1 id="demo-request-title" class="font-jakarta text-xl font-extrabold leading-tight tracking-tight text-white"><%= t('demo_requests.new.panel_title') %></h1>
      <p class="text-xs font-medium leading-relaxed text-slate-400"><%= t('demo_requests.new.panel_description') %></p>
    </div>

    <div class="space-y-2.5">
      <% module_styles = {
        'inventory' => %w[cube emerald],
        'billing' => %w[document-text teal],
        'reports' => %w[chart-bar sky]
      } %>
      <% module_styles.each do |module_key, (icon_name, tone)| %>
        <div class="flex items-start space-x-3 rounded-xl border border-white/[0.06] bg-white/[0.03] p-3 backdrop-blur-md">
          <div class="shrink-0 rounded-lg border p-1.5 <%= tone == 'emerald' ? 'border-emerald-500/20 bg-emerald-500/10 text-emerald-400' : tone == 'teal' ? 'border-teal-500/20 bg-teal-500/10 text-teal-400' : 'border-sky-500/20 bg-sky-500/10 text-sky-400' %>">
            <%= render Ui::IconComponent.new(name: icon_name, size: :sm, color: :inherit) %>
          </div>
          <div class="leading-none">
            <h2 class="font-jakarta text-xs font-bold text-white"><%= t("demo_requests.new.modules.#{module_key}.title") %></h2>
            <p class="mt-1 text-[10px] leading-normal text-slate-400"><%= t("demo_requests.new.modules.#{module_key}.description") %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="relative text-[11px] tracking-wide text-slate-500"><%= t('demo_requests.new.copyright', year: Time.current.year) %></div>
</div>
