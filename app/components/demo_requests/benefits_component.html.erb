<div>
  <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-blue-50 px-4 py-2 text-sm font-medium text-blue-700">
    <span class="h-2 w-2 rounded-full bg-blue-600"></span>
    <%= t('demo_requests.new.badge') %>
  </div>

  <h1 class="max-w-xl text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
    <%= t('demo_requests.new.hero_title') %>
    <span class="bg-gradient-to-r from-emerald-500 to-blue-600 bg-clip-text text-transparent">
      <%= t('demo_requests.new.brand') %>
    </span>
    <%= t('demo_requests.new.hero_title_suffix') %>
  </h1>

  <p class="mt-6 max-w-xl text-lg leading-8 text-slate-600">
    <%= t('demo_requests.new.hero_description') %>
  </p>

  <div class="mt-10 space-y-5">
    <% benefits.each do |benefit| %>
      <div class="flex gap-4">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[var(--brand-light)] text-[var(--brand)]">
          ✓
        </div>
        <div>
          <h3 class="font-semibold text-slate-900">
            <%= t("demo_requests.new.benefits.#{benefit}.title") %>
          </h3>
          <p class="mt-1 text-sm leading-6 text-slate-600">
            <%= t("demo_requests.new.benefits.#{benefit}.description") %>
          </p>
        </div>
      </div>
    <% end %>
  </div>
</div>
