<section id="faq" class="border-b border-slate-200/60 bg-white py-16 sm:py-20 lg:py-24">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <%= render Ui::SectionTitleComponent.new(
      badge: t("landing.navbar.faq"),
      title: title,
      subtitle: subtitle
    ) %>

    <div class="mt-10 space-y-4 sm:mt-12">
      <% questions.each do |question| %>
        <details class="group overflow-hidden rounded-xl border border-slate-200 bg-slate-50/50 transition hover:border-emerald-300">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-jakarta text-sm font-bold text-slate-900 marker:hidden sm:p-6 sm:text-base">
            <span><%= question.question %></span>
            <span class="text-slate-400 transition group-open:rotate-180 group-hover:text-emerald-600" aria-hidden="true">⌄</span>
          </summary>
          <div class="border-t border-slate-100 bg-white px-5 pb-5 pt-4 text-sm leading-7 text-slate-500 sm:px-6 sm:pb-6">
            <%= question.answer %>
          </div>
        </details>
      <% end %>
    </div>
  </div>
</section>
