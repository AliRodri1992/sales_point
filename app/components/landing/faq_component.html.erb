<section
  id="faq"
  class="bg-slate-50 py-16 sm:py-28">

  <div class="mx-auto max-w-4xl px-4 sm:px-6">

    <%= render Ui::SectionTitleComponent.new(
      badge: t('landing.navbar.faq'),
      title: title,
      subtitle: subtitle
    ) %>

    <div class="mt-10 space-y-4 sm:mt-16">

      <% questions.each do |question| %>

        <details
          class="group rounded-2xl border border-slate-200 bg-white p-4 transition hover:border-cyan-300 sm:p-6">

          <summary
            class="cursor-pointer list-none text-base font-semibold text-slate-900 sm:text-lg">

            <%= question.question %>

          </summary>

          <p
            class="mt-4 leading-7 text-slate-600">

            <%= question.answer %>

          </p>

        </details>

      <% end %>

    </div>

  </div>

</section>