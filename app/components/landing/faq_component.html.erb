<section
  id="faq"
  class="bg-slate-50 py-28">

  <div class="mx-auto max-w-4xl px-6">

    <%= render Ui::SectionTitleComponent.new(
      badge: "FAQ",
      title: title,
      subtitle: subtitle
    ) %>

    <div class="mt-16 space-y-4">

      <% questions.each do |question| %>

        <details
          class="group rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-cyan-300">

          <summary
            class="cursor-pointer list-none text-lg font-semibold text-slate-900">

            <%= question.question %>

          </summary>

          <p
            class="mt-4 leading-7 text-slate-600">

            <%= question.answer %>

          </p>

        </details>

      <% end %>

    </div>

  </div>

</section>