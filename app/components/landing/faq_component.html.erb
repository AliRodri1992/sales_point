<section id="faq" class="border-b border-slate-200/60 bg-white py-12 lg:py-16">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 text-center"><h2 class="font-jakarta text-3xl font-extrabold tracking-tight text-slate-900"><%= title %></h2><p class="mt-3 text-sm leading-6 text-slate-500"><%= subtitle %></p></div>
    <div class="space-y-4">
      <% questions.each do |question| %>
        <details class="group overflow-hidden rounded-xl border border-slate-200 bg-slate-50/50 transition-all hover:border-emerald-500">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6 text-left font-jakarta text-base font-bold text-slate-900">
            <span class="transition-colors group-hover:text-emerald-600"><%= question.question %></span>
            <svg class="h-5 w-5 shrink-0 text-slate-400 transition-transform duration-300 group-open:rotate-180 group-hover:text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
          </summary>
          <div class="border-t border-slate-100 px-6 pb-6 pt-4 text-sm leading-relaxed text-slate-500"><%= question.answer %></div>
        </details>
      <% end %>
    </div>
  </div>
</section>