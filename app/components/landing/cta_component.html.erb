<section id="contacto" class="bg-gradient-to-r from-emerald-600 to-teal-600 py-16 text-center text-white">
  <div class="mx-auto max-w-4xl space-y-6 px-4 sm:px-6 lg:px-8">
    <h2 class="font-jakarta text-3xl font-extrabold tracking-tight sm:text-4xl"><%= title %></h2>
    <p class="mx-auto max-w-xl text-sm text-emerald-50 sm:text-base"><%= description %></p>
    <%= link_to button_text, button_href, class: "inline-block rounded-xl border border-slate-200 bg-white px-8 py-3.5 font-bold text-slate-700 shadow-lg transition-all duration-150 hover:border-slate-400 hover:bg-slate-50 hover:text-slate-800 active:scale-95" %>
  </div>
</section>