<section
  class="bg-gradient-to-r from-emerald-500 to-blue-600 py-16 sm:py-24">

  <div
    class="mx-auto max-w-4xl px-4 text-center sm:px-6">

    <h2
      class="text-3xl font-black text-white sm:text-4xl lg:text-5xl">

      <%= title %>

    </h2>

    <p
      class="mx-auto mt-4 max-w-2xl text-base leading-7 text-cyan-50 sm:mt-6 sm:text-lg sm:leading-8">

      <%= description %>

    </p>

    <div class="mt-10">

      <%= render button %>

    </div>

  </div>

</section>