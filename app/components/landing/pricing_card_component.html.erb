<%= render Ui::CardComponent.new(hover: true, shadow: true, full_height: true) do |card| %>
  <% card.with_body do %>
    <div class="relative flex h-full flex-col gap-6">
      <% if badge? %>
        <div class="absolute right-0 top-0">
          <%= render Ui::BadgeComponent.new(text: t('landing.pricing.most_popular'), color: :primary) %>
        </div>
      <% end %>
      <div class="min-h-24">
        <h3 class="text-2xl font-bold text-slate-900"><%= name %></h3>
        <p class="mt-2 text-slate-500"><%= description %></p>
      </div>
      <div class="min-h-16">
        <span class="text-5xl font-black text-blue-600">
          $<%= price %>
        </span>
        <span class="text-slate-500"><%= t('landing.pricing.per_month') %></span>
      </div>
      <ul class="flex-1 space-y-4">
        <% features.each do |feature| %>
          <li class="flex items-center gap-3">
            <%= render Ui::IconComponent.new(name: :check_circle, variant: :solid, color: :success) %>
            <span><%= feature %></span>
          </li>
        <% end %>
      </ul>
      <%= render Ui::ButtonComponent.new(text: t('landing.pricing.choose_plan'), href: new_user_registration_path, variant: :primary, full_width: true) %>
    </div>
  <% end %>
<% end %>