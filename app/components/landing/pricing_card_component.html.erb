<article class="<%= card_classes %>">
  <% if badge? %>
    <span class="absolute right-8 top-0 -translate-y-1/2 rounded-full bg-emerald-600 px-3 py-1 font-jakarta text-xs font-semibold uppercase tracking-wide text-white">
      <%= t("landing.pricing.most_popular") %>
    </span>
  <% end %>
  <div>
    <h3 class="font-jakarta text-xl font-bold text-slate-900"><%= name %></h3>
    <p class="mt-1 text-sm text-slate-400"><%= description %></p>
    <div class="mb-6 mt-6">
      <span class="font-jakarta text-4xl font-extrabold text-slate-900">$<%= price %></span>
      <span class="text-sm font-medium text-slate-400"><%= t("landing.pricing.per_month") %></span>
    </div>
    <ul class="space-y-3.5 text-sm">
      <% features.each do |feature| %>
        <li class="flex items-center gap-2.5 text-slate-600">
          <svg class="h-4 w-4 shrink-0 text-emerald-600" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
          <span><%= feature %></span>
        </li>
      <% end %>
    </ul>
  </div>
  <%= link_to plan_button_text, new_user_registration_path, class: button_classes %>
</article>