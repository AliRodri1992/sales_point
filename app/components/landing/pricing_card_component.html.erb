<%= render Ui::CardComponent.new(hover: true, shadow: true, full_height: true) do |card| %>
  <% card.with_body do %>
    <div class="relative flex h-full flex-col gap-6">
      <% if badge? %>
        <div class="absolute right-0 top-0">
          <%= render Ui::BadgeComponent.new(text: t("landing.pricing.most_popular"), color: :primary) %>
        </div>
      <% end %>

      <div>
        <h3 class="font-jakarta text-xl font-bold text-slate-900"><%= name %></h3>
        <p class="mt-1 text-sm text-slate-400"><%= description %></p>
      </div>

      <div>
        <span class="font-jakarta text-4xl font-extrabold text-slate-900">$<%= price %></span>
        <span class="text-sm font-medium text-slate-400"><%= t("landing.pricing.per_month") %></span>
      </div>

      <ul class="flex-1 space-y-3.5 text-sm">
        <% features.each do |feature| %>
          <li class="flex items-center gap-2.5 text-slate-600">
            <%= render Ui::IconComponent.new(name: :check, variant: :solid, color: :success) %>
            <span><%= feature %></span>
          </li>
        <% end %>
      </ul>

      <%= render Ui::ButtonComponent.new(
        text: t("landing.pricing.choose_plan"),
        href: new_user_registration_path,
        variant: badge? ? :success : :outline,
        full_width: true
      ) %>
    </div>
  <% end %>
<% end %>
