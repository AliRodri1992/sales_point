<section class="relative overflow-hidden bg-white">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 pb-20 pt-10 sm:px-6 lg:grid-cols-12 lg:gap-12 lg:pb-28 lg:pt-14 lg:px-8">
    <div class="text-center lg:col-span-6 lg:text-left">
      <%= render Ui::BadgeComponent.new(text: badge) %>

      <h1 class="mt-5 font-jakarta text-4xl font-extrabold leading-[1.1] tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        <%= title %>
        <span class="bg-gradient-to-r from-emerald-600 to-teal-600 bg-clip-text text-transparent"><%= highlighted %></span>
      </h1>

      <p class="mx-auto mt-6 max-w-xl text-lg leading-8 text-slate-500 lg:mx-0">
        <%= description %>
      </p>

      <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row lg:justify-start">
        <%= render primary_button %>
        <%= render secondary_button %>
      </div>
    </div>

    <div class="relative lg:col-span-6">
      <div class="rounded-2xl border border-slate-100 bg-white p-4 shadow-xl sm:p-6">
        <div class="mb-4 flex items-center justify-between border-b border-slate-100 pb-4">
          <div class="flex items-center gap-2" aria-hidden="true">
            <span class="h-3 w-3 rounded-full bg-rose-400"></span>
            <span class="h-3 w-3 rounded-full bg-amber-400"></span>
            <span class="h-3 w-3 rounded-full bg-emerald-400"></span>
          </div>
          <span class="font-mono text-xs font-medium text-slate-400">dashboard_live_analytics.json</span>
        </div>

        <div class="mb-6 grid grid-cols-3 gap-3 sm:gap-4">
          <div class="rounded-xl border border-emerald-100 bg-emerald-50/60 p-3">
            <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 sm:text-xs">Ventas de Hoy</span>
            <div class="mt-1 text-lg font-bold text-slate-800 sm:text-xl">$4,820</div>
            <span class="text-xs font-medium text-emerald-600">↑ +12.4%</span>
          </div>
          <div class="rounded-xl border border-teal-100 bg-teal-50/60 p-3">
            <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 sm:text-xs">Transacciones</span>
            <div class="mt-1 text-lg font-bold text-slate-800 sm:text-xl">142</div>
            <span class="text-xs font-medium text-emerald-600">En tiempo real</span>
          </div>
          <div class="rounded-xl border border-slate-100 bg-slate-50 p-3">
            <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 sm:text-xs">Stock Alertas</span>
            <div class="mt-1 text-lg font-bold text-slate-800 sm:text-xl">3</div>
            <span class="text-xs font-medium text-rose-500">Acción requerida</span>
          </div>
        </div>

        <div class="space-y-3" aria-hidden="true">
          <div class="h-4 w-full rounded-md bg-gradient-to-r from-emerald-600 to-teal-600"></div>
          <div class="h-4 w-5/6 rounded-md bg-slate-100"></div>
          <div class="h-4 w-4/6 rounded-md bg-slate-100"></div>
        </div>
      </div>
    </div>
  </div>
</section>
