<section class="relative overflow-hidden bg-gradient-to-b from-[#f8fafc] to-white">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:gap-20 sm:px-6 sm:py-24 lg:grid-cols-2 lg:items-center">
    <div>
      <%= render Ui::BadgeComponent.new(text: badge) %>
      <h1 class="mt-6 text-4xl font-black leading-tight text-slate-900 sm:mt-8 sm:text-5xl lg:text-7xl">
        <%= title %>
        <span class="bg-gradient-to-r from-emerald-500 to-blue-600 bg-clip-text text-transparent"><%= highlighted %></span>
      </h1>
      <p class="mt-6 max-w-xl text-base leading-7 text-slate-600 sm:mt-8 sm:text-lg sm:leading-8"><%= description %></p>
      <div class="mt-8 flex flex-col items-stretch gap-4 sm:mt-10 sm:flex-row sm:flex-wrap sm:items-center">
        <%= render primary_button %>
        <%= render secondary_button %>
      </div>
      <div class="mt-12 grid grid-cols-1 gap-8 sm:mt-16 sm:grid-cols-3 sm:gap-8">
        <% statistics.each do |statistic| %>
          <%= render statistic %>
        <% end %>
      </div>
    </div>
    <div>
      <%= render "shared/fake_dashboard" %>
    </div>
  </div>
</section>