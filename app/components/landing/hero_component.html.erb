<section class="relative overflow-hidden bg-gradient-to-b from-[#f8fafc] to-white">
  <div class="mx-auto grid max-w-7xl gap-20 px-6 py-24 lg:grid-cols-2 lg:items-center">
    <div>
      <%= render Ui::BadgeComponent.new(text: badge) %>
      <h1 class="mt-8 text-5xl font-black leading-tight text-slate-900 lg:text-7xl">
        <%= title %>
        <span class="bg-gradient-to-r from-emerald-500 to-blue-600 bg-clip-text text-transparent"><%= highlighted %></span>
      </h1>
      <p class="mt-8 max-w-xl text-lg leading-8 text-slate-600"><%= description %></p>
      <div class="mt-10 flex flex-wrap gap-4">
        <%= render primary_button %>
        <%= render secondary_button %>
      </div>
      <div class="mt-16 grid grid-cols-3 gap-8">
        <% statistics.each do |statistic| %>
          <%= render statistic %>
        <% end %>
      </div>
    </div>
    <div>
      <%= render "shared/fake_dashboard" %>
    </div>
  </div>
</section>