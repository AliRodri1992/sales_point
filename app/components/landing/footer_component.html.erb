<footer class="border-t border-slate-800 bg-slate-900 pt-16 text-slate-300">
  <div class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 border-b border-slate-800 pb-12 md:grid-cols-5">
      <div class="col-span-2 space-y-4">
        <div class="flex items-center gap-3"><%= image_tag "delta-pos-logo.svg", class: "h-9 w-9", alt: t("landing.footer.brand_alt") %><span class="font-jakarta text-lg font-extrabold text-white">DELTA <span class="text-emerald-500">POS</span></span></div>
        <p class="max-w-xs text-xs leading-relaxed text-slate-400"><%= t("landing.footer.description") %></p>
      </div>
      <div><h3 class="mb-4 font-jakarta text-sm font-semibold tracking-wide text-white"><%= t("landing.footer.product") %></h3><ul class="space-y-2 text-xs text-slate-400"><% product_links.each do |link| %><li><%= link_to t("landing.footer.#{link.title_key}"), link.href, class: "transition hover:text-white" %></li><% end %></ul></div>
      <div><h3 class="mb-4 font-jakarta text-sm font-semibold tracking-wide text-white"><%= t("landing.footer.support") %></h3><ul class="space-y-2 text-xs text-slate-400"><% support_links.each do |link| %><li><%= link_to t("landing.footer.#{link.title_key}"), link.href, class: "transition hover:text-white" %></li><% end %></ul></div>
      <div><h3 class="mb-4 font-jakarta text-sm font-semibold tracking-wide text-white"><%= t("landing.footer.company") %></h3><ul class="space-y-2 text-xs text-slate-400"><% company_links.each do |link| %><li><%= link_to t("landing.footer.#{link.title_key}"), link.href, class: "transition hover:text-white" %></li><% end %></ul></div>
    </div>
    <div class="flex flex-col items-center justify-between gap-4 pt-8 text-xs text-slate-500 md:flex-row">
      <p><%= t("landing.footer.copyright", year: 2026) %></p>
      <div class="flex gap-6"><%= link_to t("landing.footer.terms"), "#", class: "transition hover:text-slate-300" %><%= link_to t("landing.footer.privacy"), "#", class: "transition hover:text-slate-300" %><%= link_to t("landing.footer.security"), "#", class: "transition hover:text-slate-300" %></div>
    </div>
  </div>
</footer>
