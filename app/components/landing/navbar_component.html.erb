<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6">
    <%= link_to root_path, class: "flex items-center gap-3" do %>
      <%= image_tag "logo.png", class: "h-10 w-auto", alt: "PuntoVeloz" %>
      <div>
        <h1 class="text-xl font-black text-slate-900">PuntoVeloz</h1>
        <p class="text-xs text-slate-500">Punto de Venta Inteligente</p>
      </div>
    <% end %>

    <nav class="hidden items-center gap-10 lg:flex">
      <% menu_items.each do |item| %>
        <%= link_to item.href, class: "font-medium text-slate-600 transition hover:text-blue-600" do %>
          <%= item.title %>
        <% end %>
      <% end %>
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <%= render Ui::ButtonComponent.new(text: "Iniciar sesión", href: new_user_session_path, variant: :ghost) %>
      <%= render Ui::ButtonComponent.new(text: "Comenzar", href: new_user_registration_path) %>
    </div>

    <button class="lg:hidden">
      <%= render Ui::IconComponent.new(name: 'bars-3', size: :xl) %>
    </button>
  </div>
</header>