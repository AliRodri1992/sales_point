<header class="sticky top-0 z-50 border-b border-slate-700 bg-slate-900 text-white shadow-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <%= link_to root_path, class: "flex items-center gap-3", aria: { label: t('app.name') } do %>
      <%= image_tag "delta-pos-logo.svg", class: "h-11 w-11 shrink-0", alt: t('app.name') %>
      <div class="flex flex-col leading-none">
        <span class="font-jakarta text-2xl font-extrabold tracking-tight text-white"><%= t('app.name') %> <span class="text-emerald-500"><%= t('app.short_name') %></span></span>
        <span class="mt-0.5 font-inter text-[10px] font-medium uppercase tracking-[0.2em] text-gray-400"><%= t('app.slogan') %></span>
      </div>
    <% end %>
    <nav class="hidden items-center gap-8 text-sm font-medium md:flex">
      <% menu_items.each do |item| %>
        <%= link_to item.title, item.href, class: "text-slate-300 transition hover:text-white" %>
      <% end %>
    </nav>
    <div class="hidden items-center gap-6 md:flex">
      <%= link_to t('landing.buttons.sign_in'), new_user_session_path, class: "text-sm font-medium text-slate-300 transition hover:text-white" %>
      <%= link_to t('landing.buttons.start'), new_user_registration_path, class: "rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition-all duration-200 hover:from-emerald-700 hover:to-teal-600" %>
      <% if helpers.current_language %>
        <div class="relative" data-controller="language-selector">
          <button type="button" data-action="click->language-selector#toggle" class="inline-flex items-center gap-1.5 rounded-xl bg-slate-800 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700" aria-haspopup="true" aria-expanded="false">
            <%= render Ui::IconComponent.new(name: "language", size: :md, color: :white) %>
            <span><%= helpers.current_language.code.upcase %></span>
            <%= render Ui::IconComponent.new(name: "chevron-down", size: :xs, color: :white) %>
          </button>
          <div data-language-selector-target="dropdown" class="absolute right-0 top-full z-50 mt-2 hidden w-40 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-lg">
            <% Language.available.order(:code).each do |language| %>
              <button type="button" data-action="click->language-selector#select" data-language="<%= language.code %>" class="flex w-full items-center gap-3 px-3 py-2 text-sm font-medium <%= language.code == helpers.current_language.code ? 'bg-emerald-50 text-emerald-700' : 'text-slate-700 hover:bg-slate-100 hover:text-slate-900' %>">
                <img
                  src="<%= language.flag_url %>"
                  srcset="<%= language.flag_srcset %>"
                  class="h-6 w-6 shrink-0 rounded-full object-cover"
                  alt="<%= language.name %>">
                <span class="flex-1 text-left"><%= language.code.upcase %></span>
                <% if language.code == helpers.current_language.code %>
                  <%= render Ui::IconComponent.new(name: "check", size: :sm, color: :success) %>
                <% end %>
              </button>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <button type="button" class="rounded-lg p-2 text-white transition hover:bg-slate-800 md:hidden" data-navbar-target="button" data-action="click->navbar#toggle" aria-label="<%= t('landing.buttons.open_menu') %>" aria-expanded="false">
      <span data-navbar-target="iconOpen"><%= render Ui::IconComponent.new(name: "bars-3", size: :xl, color: :white) %></span>
      <span class="hidden" data-navbar-target="iconClose"><%= render Ui::IconComponent.new(name: "x-mark", size: :xl, color: :white) %></span>
    </button>
  </div>
  <div class="hidden border-t border-slate-700 px-4 pb-5 md:hidden" data-navbar-target="menu">
    <nav class="flex flex-col gap-1 pt-4">
      <% menu_items.each do |item| %>
        <%= link_to item.title, item.href, class: "rounded-lg px-3 py-2 text-sm font-medium text-slate-300 transition hover:bg-slate-800 hover:text-white", data: { action: "click->navbar#close" } %>
      <% end %>
      <%= link_to t('landing.buttons.sign_in'), new_user_session_path, class: "mt-2 block rounded-lg px-3 py-2 text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white" %>
      <%= link_to t('landing.buttons.start'), "#precios", class: "mt-2 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 px-3 py-2.5 text-center text-sm font-semibold text-white transition hover:from-emerald-700 hover:to-teal-600" %>
    </nav>
  </div>
  </div>
</header>