<header data-controller="navbar"
  data-action="keydown->navbar#keydown click@window->navbar#outsideClick resize@window->navbar#resize turbo:before-cache@document->navbar#close"
  data-navbar-open-label-value="<%= t('landing.buttons.open_menu') %>"
  data-navbar-close-label-value="<%= t('landing.buttons.close_menu') %>"
  class="sticky top-0 z-50 border-b border-slate-700 bg-slate-900 text-white shadow-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <%= link_to root_path, class: "flex shrink-0 items-center gap-3", aria: { label: t('app.name') } do %>
      <%= image_tag "delta-pos-logo.svg", class: "h-11 w-11 shrink-0", alt: t('app.name') %>
      <div class="flex flex-col whitespace-nowrap leading-none">
        <span class="font-jakarta text-2xl font-extrabold tracking-tight text-white"><%= t('app.name') %> <span class="text-emerald-500"><%= t('app.short_name') %></span></span>
        <span class="mt-0.5 font-inter text-[10px] font-medium uppercase tracking-[0.2em] text-gray-400"><%= t('app.slogan') %></span>
      </div>
    <% end %>
    <nav class="hidden items-center gap-8 text-sm font-medium xl:flex">
      <% menu_items.each do |item| %>
        <%= link_to item.title, item.href, class: "text-slate-300 transition hover:text-white" %>
      <% end %>
    </nav>
    <div class="hidden items-center gap-6 xl:flex">
      <%= link_to t('landing.buttons.sign_in'), new_user_session_path, class: "text-sm font-medium text-slate-300 transition hover:text-white" %>
      <%= link_to t('landing.buttons.start'), new_user_registration_path, class: "rounded-xl bg-gradient-to-r from-emerald-700 to-teal-700 px-4 py-2 text-sm font-medium text-white shadow-sm transition-all duration-200 hover:from-emerald-800 hover:to-teal-800" %>
      <%= render 'landing/language_selector', id_prefix: 'landing-desktop' %>
    </div>
    <button type="button" class="rounded-lg p-2 text-white transition hover:bg-slate-800 xl:hidden" aria-controls="landing-mobile-menu" data-navbar-target="button" data-action="click->navbar#toggle" aria-label="<%= t('landing.buttons.open_menu') %>" aria-expanded="false">
      <span data-navbar-target="iconOpen"><%= render Ui::IconComponent.new(name: "bars-3", size: :xl, color: :white) %></span>
      <span class="hidden" data-navbar-target="iconClose"><%= render Ui::IconComponent.new(name: "x-mark", size: :xl, color: :white) %></span>
    </button>
  </div>
  <div id="landing-mobile-menu" class="hidden max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-slate-700 px-4 pb-5 xl:hidden" data-navbar-target="menu">
    <nav class="flex flex-col gap-1 pt-4">
      <% menu_items.each do |item| %>
        <%= link_to item.title, item.href, class: "rounded-lg px-3 py-2 text-sm font-medium text-slate-300 transition hover:bg-slate-800 hover:text-white", data: { action: "click->navbar#close" } %>
      <% end %>
      <%= link_to t('landing.buttons.sign_in'), new_user_session_path, class: "mt-2 block rounded-lg px-3 py-2 text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white" %>
      <%= link_to t('landing.buttons.start'), new_user_registration_path, class: "mt-2 rounded-xl bg-gradient-to-r from-emerald-700 to-teal-700 px-3 py-2.5 text-center text-sm font-semibold text-white transition hover:from-emerald-800 hover:to-teal-800" %>
    </nav>
    <div class="mt-3 flex justify-end border-t border-slate-700 pt-3">
      <%= render 'landing/language_selector', id_prefix: 'landing-mobile', mobile: true %>
    </div>
  </div>
</header>
