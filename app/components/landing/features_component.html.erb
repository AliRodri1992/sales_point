<section id="features" class="bg-white py-16 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <%= render Ui::SectionTitleComponent.new(badge: t('landing.navbar.features'), title: title, subtitle: subtitle) %>
    <div class="mt-12 grid gap-6 sm:mt-20 sm:gap-8 md:grid-cols-2 xl:grid-cols-3">
      <% features.each do |feature| %>
        <%= render Landing::FeatureCardComponent.new(
          icon: feature.icon,
          title: feature.title,
          description: feature.description,
          color: feature.color
        ) %>
      <% end %>
    </div>
  </div>
</section>