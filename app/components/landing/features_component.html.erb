<section id="features" class="bg-white py-28">
  <div class="mx-auto max-w-7xl px-6">
    <%= render Ui::SectionTitleComponent.new(badge: "Características", title: title, subtitle: subtitle) %>
    <div class="mt-20 grid gap-8 md:grid-cols-2 xl:grid-cols-3">
      <% features.each do |feature| %>
        <%= render Landing::FeatureCardComponent.new(icon: feature.icon, title: feature.title, description: feature.description) %>
      <% end %>
    </div>
  </div>
</section>