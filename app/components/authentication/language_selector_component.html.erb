<% if current_language %>
  <div class="relative" data-controller="language-selector">
    <button
      type="button"
      data-action="click->language-selector#toggle"
      class="inline-flex h-10 w-24 items-center justify-between rounded-xl border border-slate-200/80 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-600 shadow-sm transition hover:border-emerald-200 hover:bg-emerald-50 hover:text-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
      aria-label="<%= t('authentication.language_selector.toggle', default: 'Select language') %>">
      <span class="flex items-center gap-1.5">
        <img
          data-language-selector-target="flag"
          src="<%= current_language.flag_url %>"
          srcset="<%= current_language.flag_srcset %>"
          width="16"
          height="12"
          alt="<%= current_language.name %>"
          class="shrink-0 rounded-sm object-cover">
        <span data-language-selector-target="languageCode"><%= current_language.code.upcase %></span>
      </span>
      <%= icon "chevron-down", variant: :outline, class: "h-3 w-3 text-slate-400" %>
    </button>

    <div
      data-language-selector-target="dropdown"
      class="absolute right-0 mt-1 hidden w-24 overflow-hidden rounded-xl border border-slate-100/80 bg-white shadow-2xl">
      <div id="language_selector_content" class="flex flex-col">
        <% languages.each do |language| %>
          <button
            type="button"
            data-action="click->language-selector#select"
            data-language="<%= language.code %>"
            data-flag="<%= language.flag_url %>"
            class="<%= language.code == current_language.code ? 'bg-emerald-500 text-white hover:bg-emerald-600' : 'text-slate-600 hover:bg-emerald-50 hover:text-emerald-700' %> flex w-full items-center gap-2 px-3 py-2 text-xs font-semibold transition-all duration-150 focus:outline-none">
            <img
              src="<%= language.flag_url %>"
              srcset="<%= language.flag_srcset %>"
              width="16"
              height="12"
              alt="<%= language.name %>"
              class="shrink-0 rounded-sm">
            <span><%= language.code.upcase %></span>
          </button>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
