<% content_for :title, t('dashboard.index.title') %>

<div class="mb-8">
  <p class="text-sm font-semibold uppercase tracking-[0.12em] text-emerald-600"><%= t('dashboard.eyebrow') %></p>
  <h1 class="mt-2 font-jakarta text-3xl font-bold tracking-tight text-slate-900"><%= t('dashboard.index.heading') %></h1>
  <p class="mt-2 max-w-2xl text-sm text-slate-500"><%= t('dashboard.index.subtitle') %></p>
</div>

<section aria-labelledby="dashboard-kpis" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
  <h2 id="dashboard-kpis" class="sr-only"><%= t('dashboard.kpis.title') %></h2>

  <% [
    ['total', @total_demo_requests, 'text-slate-900'],
    ['pending', @pending_demo_requests, 'text-amber-600'],
    ['contacted', @contacted_demo_requests, 'text-sky-600'],
    ['completed', @completed_demo_requests, 'text-emerald-600'],
    ['users', @delta_users, 'text-teal-600']
  ].each do |key, value, color_class| %>
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-slate-500"><%= t("dashboard.kpis.#{key}") %></p>
      <p class="mt-3 font-jakarta text-3xl font-bold <%= color_class %>"><%= value %></p>
    </article>
  <% end %>
</section>

<section class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
  <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
    <div>
      <h2 class="font-jakarta text-lg font-bold text-slate-900"><%= t('dashboard.recent.title') %></h2>
      <p class="mt-1 text-sm text-slate-500"><%= t('dashboard.recent.subtitle') %></p>
    </div>
  </div>

  <% if @recent_demo_requests.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-100">
        <thead class="bg-slate-50">
          <tr>
            <% %w[name company email status].each do |column| %>
              <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                <%= t("dashboard.recent.columns.#{column}") %>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @recent_demo_requests.each do |request| %>
            <tr class="transition hover:bg-slate-50">
              <td class="whitespace-nowrap px-5 py-4 text-sm font-semibold text-slate-900"><%= request.name %></td>
              <td class="whitespace-nowrap px-5 py-4 text-sm text-slate-600"><%= request.company %></td>
              <td class="whitespace-nowrap px-5 py-4 text-sm text-slate-600"><%= request.email %></td>
              <td class="whitespace-nowrap px-5 py-4">
                <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700">
                  <%= t("dashboard.statuses.#{request.status}") %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="px-5 py-12 text-center">
      <p class="text-sm font-medium text-slate-700"><%= t('dashboard.recent.empty.title') %></p>
      <p class="mt-1 text-sm text-slate-500"><%= t('dashboard.recent.empty.subtitle') %></p>
    </div>
  <% end %>
</section>
