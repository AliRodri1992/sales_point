<turbo-frame id="conversation_panel">
  <% other = @conversation.other_user(current_user) %>

  <div class="flex items-center justify-between bg-gradient-to-r from-slate-950 to-slate-800 px-5 py-4">
    <div class="flex items-center gap-3">
      <%= user_avatar(other, size: "h-9 w-9") %>
      <div>
        <p class="truncate font-jakarta text-sm font-bold text-white">
          <%= other.display_name %>
        </p>
        <span class="text-xs text-slate-300">
          <%= other.online? ? t("admin.shared.conversation.online") : t("admin.shared.conversation.offline") %>
        </span>
      </div>
    </div>
    <button
      type="button"
      id="conversationCloseButton"
      class="flex h-9 w-9 items-center justify-center rounded-xl text-slate-300 transition hover:bg-white/10 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-white"
      aria-label="<%= t('admin.shared.conversation.close') %>"
    >
      <%= delta_icon("x-mark", class: "size-4") %>
    </button>
  </div>

  <%= turbo_stream_from @conversation %>

  <div
    id="conversation_messages"
    class="flex h-[min(22rem,48vh)] flex-col gap-3 overflow-y-auto bg-gradient-to-b from-slate-50 to-white p-4"
    data-controller="conversation-messages"
    data-conversation-messages-current-user-id-value="<%= current_user.id %>"
  >
    <% @messages.each do |message| %>
      <%= render "messages/message", message: message %>
    <% end %>
  </div>

  <div class="border-t border-slate-100 bg-white p-4">
    <%= render "messages/form", conversation: @conversation, message: Message.new %>
  </div>
</turbo-frame>
