<header class="report-header">
  <div class="report-brand">
    <% if organization_logo.present? %>
      <img class="organization-logo" src="<%= organization_logo %>" alt="">
    <% else %>
      <div class="default-logo">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="46" height="46" aria-hidden="true">
          <path d="M50 5 L7 92 L50 68 Z" fill="#065f46"/>
          <path d="M50 5 L93 92 L50 68 Z" fill="#0d9488"/>
          <path d="M7 92 L93 92 L50 68 Z" fill="#065f46"/>
          <path d="M22 64 L38 80 L76 30" fill="none" stroke="white" stroke-width="9.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="brand">DELTA <span>POS</span></span>
      </div>
    <% end %>
    <div class="report-type"><%= report.title %></div>
  </div>
  <div class="report-meta">
    <strong><%= report.organization.name %></strong>
    <div><%= I18n.l(Time.current, format: :long) %></div>
  </div>
</header>

<section class="report-content">
  <table>
    <thead>
      <tr>
        <% report.columns.each do |column| %>
          <th scope="col"><%= column.fetch(:label) %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% report.each_row do |record| %>
        <tr>
          <% report.columns.each do |column| %>
            <td><%= column.fetch(:value).call(record) %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
