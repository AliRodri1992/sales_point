<!-- Dashboard -->

<div class="grid min-h-[360px] grid-cols-[56px_1fr] sm:min-h-[430px] sm:grid-cols-[72px_1fr]">
  <!-- Sidebar -->
  <div class="bg-slate-900 p-3 sm:p-4">
    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-600 text-white sm:h-9 sm:w-9">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h7v7H3V3Zm11 0h7v7h-7V3ZM3 14h7v7H3v-7Zm11 0h7v7h-7v-7Z"/>
      </svg>
    </div>

    <div class="mt-8 space-y-5">
      <div class="mx-auto h-5 w-5 rounded bg-slate-700"></div>
      <div class="mx-auto h-5 w-5 rounded bg-slate-700"></div>
      <div class="mx-auto h-5 w-5 rounded bg-blue-500"></div>
      <div class="mx-auto h-5 w-5 rounded bg-slate-700"></div>
      <div class="mx-auto h-5 w-5 rounded bg-slate-700"></div>
    </div>
  </div>

  <!-- Main dashboard -->
  <div class="min-w-0 bg-slate-50 p-3 sm:p-5">
    <div class="flex items-center justify-between">
      <div>
        <div class="text-lg font-bold text-slate-900"><%= t('landing.dashboard.title') %></div>
        <div class="text-xs text-slate-500"><%= t('landing.dashboard.summary') %></div>
      </div>
      <div class="h-8 w-24 rounded-lg bg-white"></div>
    </div>


    <!-- Cards -->
    <div class="mt-5 grid gap-3 sm:grid-cols-3">
      <div class="rounded-xl bg-white p-4 shadow-sm">
        <div class="text-[10px] text-slate-500"><%= t('landing.dashboard.sales') %></div>
        <div class="mt-2 text-lg font-black">$84,250</div>

        <div class="mt-1 text-[10px] text-emerald-600">+12.5%</div>
      </div>


      <div
        class="rounded-xl bg-white p-4 shadow-sm">

        <div class="text-[10px] text-slate-500">
          <%= t('landing.dashboard.products') %>
        </div>

        <div class="mt-2 text-lg font-black">
          1,284
        </div>

        <div
          class="mt-1 text-[10px] text-blue-600">
          <%= t('landing.dashboard.inventory') %>
        </div>

      </div>


      <div
        class="rounded-xl bg-white p-4 shadow-sm">

        <div class="text-[10px] text-slate-500">
          <%= t('landing.dashboard.customers') %>
        </div>

        <div class="mt-2 text-lg font-black">
          2,840
        </div>

        <div
          class="mt-1 text-[10px] text-emerald-600">
          +8.4%
        </div>

      </div>

    </div>


    <!-- Chart -->

    <div
      class="mt-4 rounded-xl bg-white p-5 shadow-sm">

      <div class="flex justify-between">

        <div
          class="text-sm font-bold">
          <%= t('landing.dashboard.sales') %>
        </div>

        <div
          class="text-xs text-slate-400">
          <%= t('landing.dashboard.last_seven_days') %>
        </div>

      </div>


      <div
        class="mt-6 flex h-36 items-end gap-3">

        <div
          class="h-[35%] flex-1 rounded-t bg-blue-100">
        </div>

        <div
          class="h-[50%] flex-1 rounded-t bg-blue-200">
        </div>

        <div
          class="h-[42%] flex-1 rounded-t bg-blue-200">
        </div>

        <div
          class="h-[68%] flex-1 rounded-t bg-blue-400">
        </div>

        <div
          class="h-[58%] flex-1 rounded-t bg-blue-300">
        </div>

        <div
          class="h-[82%] flex-1 rounded-t bg-blue-500">
        </div>

        <div
          class="h-[94%] flex-1 rounded-t bg-blue-600">
        </div>

      </div>

    </div>

  </div>

</div>