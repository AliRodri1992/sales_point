<dialog role="dialog" aria-modal="true" aria-labelledby="permission-review-title" aria-describedby="permission-review-description"
        data-role-permissions-target="dialog"
        class="fixed inset-0 m-auto max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-lg overflow-y-auto rounded-2xl border border-slate-200 bg-white p-0 shadow-2xl backdrop:bg-slate-900/60">
  <div class="border-b border-slate-200 p-4 sm:p-6">
    <div class="flex items-center gap-3"><span class="role-editor-emblem"><%= delta_icon('role-editor-shield', class: 'size-6') %></span><h2 id="permission-review-title" class="font-jakarta text-lg font-bold text-slate-900"><%= t('admin.system_roles.catalog.review_title') %></h2></div>
    <p id="permission-review-description" class="mt-1 text-sm text-slate-600"><%= t('admin.system_roles.catalog.save_hint') %></p>
  </div>
  <div class="space-y-4 px-4 py-5 text-sm text-slate-700 sm:px-6">
    <div class="grid grid-cols-2 gap-3">
      <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-emerald-900"><strong class="block text-xl" data-role-permissions-target="addedCount">0</strong><%= t('admin.system_roles.permission_history.added') %></div>
      <div class="rounded-xl border border-rose-200 bg-rose-50 p-3 text-rose-900"><strong class="block text-xl" data-role-permissions-target="removedCount">0</strong><%= t('admin.system_roles.permission_history.removed') %></div>
    </div>
    <p hidden data-role-permissions-target="noPermissionChanges"><%= t('admin.system_roles.catalog.no_permission_changes') %></p>
    <p hidden data-role-permissions-target="reviewDetails"><%= t('admin.system_roles.catalog.pending_details') %></p>
    <section hidden data-role-permissions-target="added" aria-labelledby="permission-review-added">
      <h3 id="permission-review-added" class="font-semibold text-emerald-800"><%= t('admin.system_roles.permission_history.added') %></h3>
      <ul class="mt-2 list-disc space-y-1 pl-5" data-role-permissions-target="addedList"></ul>
    </section>
    <p class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs leading-5 text-amber-900"><%= t('admin.system_roles.workspace.impact_warning') %></p>
    <section hidden data-role-permissions-target="removed" aria-labelledby="permission-review-removed">
      <h3 id="permission-review-removed" class="font-semibold text-rose-800"><%= t('admin.system_roles.permission_history.removed') %></h3>
      <ul class="mt-2 list-disc space-y-1 pl-5" data-role-permissions-target="removedList"></ul>
    </section>
  </div>
  <div class="sticky bottom-0 flex flex-wrap justify-end gap-2 border-t border-slate-200 bg-white p-4 sm:px-6">
    <button type="button" autofocus data-action="role-permissions#closeReview"
            class="min-h-11 rounded-xl border border-slate-300 px-4 text-sm font-semibold text-slate-700 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700"><%= t('admin.system_roles.catalog.back_to_permissions') %></button>
    <button type="button" data-action="role-permissions#confirm"
            class="min-h-11 rounded-xl bg-emerald-700 px-4 text-sm font-semibold text-white hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700"><%= t('admin.system_roles.catalog.confirm_changes') %></button>
  </div>
</dialog>
