<% module_label = permission_module_label(module_key) %>
<% resources = permissions.group_by { |permission| permission_resource_key(permission) } %>
<% matrices = resources.transform_values { |items| matrix_resource_permissions(items) } %>
<details open class="role-editor-group group" data-role-permissions-target="group">
  <summary class="role-editor-group-header">
    <span class="role-editor-group-icon"><%= delta_icon(permission_workspace_icon(module_key), class: 'size-5') %></span>
    <span class="min-w-0 flex-1">
      <span class="block break-words font-jakarta text-sm font-bold text-slate-900"><%= module_label %></span>
      <span class="block break-words text-xs text-slate-500"><%= t('admin.system_roles.workspace.group_description', resources: resources.values.map { |items| permission_resource_label(items.first) }.join(' · ')) %></span>
    </span>
    <span class="role-editor-group-count">
      <span data-group-count><%= permissions.count { |permission| @assigned_permission_ids.include?(permission.id) } %></span> / <%= permissions.size %>
      <span class="sr-only"><%= t('admin.system_roles.catalog.selected') %></span>
    </span>
    <%= delta_icon('chevron-right', class: 'size-4 shrink-0 text-slate-500 group-open:rotate-90') %>
  </summary>
  <fieldset class="min-w-0 border-t border-slate-200" <%= 'disabled' if read_only %>>
    <legend class="sr-only"><%= module_label %></legend>
    <% unless read_only %>
      <div class="role-editor-bulk">
        <% %w[grant revoke].each do |state| %>
          <button type="button" data-bulk-state="<%= state %>" data-action="role-permissions#setVisible"
                  aria-label="<%= t('admin.system_roles.catalog.bulk_scope', action: t("admin.system_roles.catalog.#{state}_visible"), module: module_label) %>"
                  class="min-h-11 rounded-md px-2 text-xs font-semibold text-emerald-800 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 disabled:cursor-default disabled:text-slate-500 disabled:no-underline">
            <%= t("admin.system_roles.catalog.#{state}_visible") %>
          </button>
        <% end %>
      </div>
    <% end %>
    <% if matrices.values.any? { |matrix| matrix.values.any? } %>
      <table class="role-matrix-table" data-permission-matrix>
        <thead>
          <tr>
            <th scope="col"><%= t('admin.system_roles.workspace.resource') %></th>
            <% RolePermissionCatalogHelper::MATRIX_ACTIONS.each_key do |action| %>
              <th scope="col"><%= t("admin.system_roles.workspace.actions.#{action}") %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% matrices.each do |resource_key, matrix| %>
            <% next unless matrix.values.any? %>
            <% items = matrix.values.compact %>
            <tr data-permission-resource>
              <th scope="row">
                <span class="block text-sm font-semibold text-slate-800"><%= permission_resource_label(resources.fetch(resource_key).first) %></span>
                <span class="block text-xs font-normal text-slate-500"><span data-resource-count><%= items.count { |permission| @assigned_permission_ids.include?(permission.id) } %></span> / <%= items.size %> <%= t('admin.system_roles.catalog.selected') %></span>
              </th>
              <% matrix.each_value do |permission| %>
                <% if permission %>
                  <td><%= render 'system_roles/permission_card', permission: permission, assigned_ids: @assigned_permission_ids, module_label: module_label, read_only: read_only, matrix: true %></td>
                <% else %>
                  <td class="role-matrix-unavailable" aria-label="<%= t('admin.system_roles.workspace.not_available') %>">—</td>
                <% end %>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
    <% resources.each do |resource_key, items| %>
      <% special = items - matrices.fetch(resource_key).values.compact %>
      <% next if special.empty? %>
      <section class="role-editor-special" data-permission-special-actions data-permission-resource>
        <h3 class="text-xs font-semibold text-slate-600"><%= t('admin.system_roles.workspace.special_actions', resource: permission_resource_label(items.first)) %></h3>
        <div class="role-extra-grid">
          <% sorted_resource_permissions(special).each do |permission| %>
            <%= render 'system_roles/permission_card', permission: permission, assigned_ids: @assigned_permission_ids, module_label: module_label, read_only: read_only %>
          <% end %>
        </div>
      </section>
    <% end %>
  </fieldset>
</details>
