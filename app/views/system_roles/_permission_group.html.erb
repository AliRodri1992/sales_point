<% module_label = permission_module_label(module_key) %>
<% resources = permissions.group_by { |permission| permission_resource_key(permission) } %>
<details open class="group rounded-xl border border-slate-200 bg-white" data-role-permissions-target="group">
  <summary class="flex min-h-12 cursor-pointer list-none items-center gap-2 rounded-xl bg-slate-50 px-3 py-2.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 [&::-webkit-details-marker]:hidden sm:px-4">
    <%= delta_icon('chevron-right', class: 'size-4 shrink-0 text-slate-500 group-open:rotate-90') %>
    <span class="min-w-0 flex-1 break-words font-jakarta text-sm font-bold text-slate-900"><%= module_label %></span>
    <span class="shrink-0 rounded-full bg-white px-2.5 py-1 text-xs font-semibold tabular-nums text-slate-700">
      <span data-group-count><%= permissions.count { |permission| @assigned_permission_ids.include?(permission.id) } %></span> / <%= permissions.size %>
      <span class="sr-only"><%= t('admin.system_roles.catalog.selected') %></span>
    </span>
  </summary>
  <fieldset class="min-w-0 border-t border-slate-200" <%= 'disabled' if read_only %>>
    <legend class="sr-only"><%= module_label %></legend>
    <% unless read_only %>
      <div class="flex flex-wrap justify-end gap-x-3 border-b border-slate-200 px-3 sm:px-4">
        <% %w[grant revoke].each do |state| %>
          <button type="button" data-bulk-state="<%= state %>" data-action="role-permissions#setVisible"
                  aria-label="<%= t('admin.system_roles.catalog.bulk_scope', action: t("admin.system_roles.catalog.#{state}_visible"), module: module_label) %>"
                  class="min-h-11 break-words rounded-md px-1.5 text-xs font-semibold text-emerald-800 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 disabled:cursor-default disabled:text-slate-500 disabled:no-underline">
            <%= t("admin.system_roles.catalog.#{state}_visible") %>
          </button>
        <% end %>
      </div>
    <% end %>
    <div class="divide-y divide-slate-200">
      <% resources.each_value do |resource_permissions| %>
        <div data-permission-resource class="grid gap-x-4 gap-y-1 px-3 py-2.5 sm:px-4 lg:grid-cols-[minmax(0,10rem)_minmax(0,1fr)]">
          <h3 class="min-w-0 break-words py-2 text-xs font-bold uppercase tracking-wide text-slate-600"><%= permission_resource_label(resource_permissions.first) %></h3>
          <div class="grid min-w-0 gap-1 sm:grid-cols-2 xl:grid-cols-3">
            <% sorted_resource_permissions(resource_permissions).each do |permission| %>
              <%= render 'system_roles/permission_card', permission: permission, assigned_ids: @assigned_permission_ids,
                         module_label: module_label, read_only: read_only %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </fieldset>
</details>
