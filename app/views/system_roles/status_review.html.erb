<% content_for :title, t('admin.system_roles.lifecycle.review_title') %>
<% content_for :system_role_breadcrumb_label, system_role_name(@system_role) %>
<% counts = @impact.counts %>
<% blocked_archive = @target == 'deprecated' && counts[:assignments].positive? %>
<% blocked_activation = @target == 'active' && counts[:permissions].zero? %>
<div class="mx-auto max-w-4xl space-y-6 pb-20 sm:pb-0">
  <header>
    <p class="text-xs font-bold uppercase tracking-wider text-emerald-700"><%= t('admin.system_roles.index.title') %></p>
    <h1 class="mt-2 font-jakarta text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"><%= t('admin.system_roles.lifecycle.review_title') %></h1>
    <p class="mt-2 break-words text-sm text-slate-600"><%= system_role_name(@system_role) %> · <%= t("admin.system_roles.types.#{@system_role.role_type}") %></p>
  </header>
  <% if @status_error %><div role="alert" class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800"><%= @status_error %></div><% end %>
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
    <% if @allowed_transition %>
      <div class="flex flex-wrap items-center gap-3 text-sm font-semibold">
        <%= render 'system_roles/status_badge', system_role: @system_role %>
        <span aria-hidden="true">→</span>
        <span class="rounded-full bg-slate-100 px-3 py-1 text-slate-700"><%= t("admin.system_roles.statuses.#{@target}") %></span>
      </div>
      <p class="mt-4 text-sm leading-6 text-slate-600"><%= t("admin.system_roles.lifecycle.effects.#{@system_role.deprecated? ? 'restore' : @target}") %></p>
      <p class="mt-2 text-xs leading-5 text-slate-500"><%= t('admin.system_roles.lifecycle.global_scope') %></p>
      <dl class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <% %i[users branches without_other_roles permissions].each do |key| %>
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
            <dt class="text-xs leading-5 text-slate-600"><%= t("admin.system_roles.lifecycle.counts.#{key}") %></dt>
            <dd class="mt-1 text-2xl font-bold text-slate-900"><%= counts[key] %></dd>
          </div>
        <% end %>
      </dl>
      <% if blocked_archive || blocked_activation %>
        <div role="alert" class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-900"><%= t(blocked_archive ? 'admin.system_roles.lifecycle.errors.assignments_remain' : 'admin.system_roles.lifecycle.errors.permissions_required') %></div>
      <% end %>
      <% if counts[:users].positive? %>
        <details class="mt-5 rounded-xl border border-slate-200 p-4">
          <summary class="cursor-pointer text-sm font-semibold text-slate-700"><%= t('admin.system_roles.lifecycle.affected_users') %></summary>
          <p class="mt-2 text-xs text-slate-500"><%= t('admin.system_roles.lifecycle.affected_hint') %></p>
          <ul class="mt-3 space-y-2 text-sm text-slate-700">
            <% @affected_users.each do |user| %>
              <li class="break-words"><%= user.display_name %><% if policy(user).edit? %> · <%= link_to t('admin.system_roles.lifecycle.manage_user'), edit_admin_user_path(user), class: 'font-semibold text-emerald-700 underline underline-offset-2' %><% end %></li>
            <% end %>
          </ul>
        </details>
      <% end %>
      <% unless blocked_archive || blocked_activation %>
        <%= form_with url: status_system_role_path(@system_role), method: :patch, html: { novalidate: true }, class: 'mt-6 space-y-5' do %>
          <%= hidden_field_tag :target, @target %>
          <%= hidden_field_tag :review_token, @review_token %>
          <div>
            <%= label_tag :reason, class: 'mb-2 block text-sm font-semibold text-slate-700' do %>
              <%= t('admin.system_roles.lifecycle.reason') %><span class="ml-1 font-bold text-rose-600" aria-hidden="true">*</span>
            <% end %>
            <%= text_area_tag :reason, params[:reason], maxlength: 1000, rows: 3,
                  aria: { invalid: @reason_error.present?, describedby: @reason_error.present? ? 'role_reason_error' : nil },
                  class: "w-full rounded-xl border p-3 text-sm focus:border-emerald-700 focus:ring-emerald-100 #{@reason_error ? 'border-rose-500 bg-rose-50' : 'border-slate-300'}" %>
            <% if @reason_error.present? %><p id="role_reason_error" role="alert" class="mt-1 text-xs text-rose-600"><%= t('admin.system_roles.lifecycle.reason') %> <%= @reason_error %></p><% end %>
          </div>
          <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-900">
            <%= check_box_tag :confirmed, '1', false, class: 'mt-1 size-4 shrink-0 rounded border-amber-300 text-emerald-700 focus:ring-emerald-700',
                  aria: { invalid: @confirmation_error.present?, describedby: @confirmation_error.present? ? 'role_confirmation_error' : nil } %>
            <span><%= t('admin.system_roles.lifecycle.confirmation') %><span class="ml-1 font-bold text-rose-600" aria-hidden="true">*</span></span>
          </label>
          <% if @confirmation_error.present? %><p id="role_confirmation_error" role="alert" class="mt-1 text-xs text-rose-600"><%= t('admin.system_roles.lifecycle.confirmation_label') %> <%= @confirmation_error %></p><% end %>
          <div class="flex flex-wrap justify-end gap-3 sm:pr-28">
            <%= link_to t('admin.system_roles.new.cancel'), system_role_path(@system_role), class: 'inline-flex min-h-11 items-center rounded-xl border border-slate-300 px-4 text-sm font-semibold text-slate-700 hover:bg-slate-50' %>
            <%= submit_tag t('admin.system_roles.lifecycle.confirm'), class: 'min-h-11 cursor-pointer rounded-xl bg-emerald-700 px-5 text-sm font-semibold text-white hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700', data: { turbo_submits_with: t('admin.system_roles.catalog.saving') } %>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <p role="alert" class="text-sm text-rose-800"><%= t('admin.system_roles.lifecycle.errors.invalid_transition') %></p>
    <% end %>
    <% if !@allowed_transition || blocked_archive || blocked_activation %>
      <%= link_to t('admin.system_roles.show.back'), system_role_path(@system_role), class: 'mt-5 inline-flex min-h-11 items-center rounded-xl border border-slate-300 px-4 text-sm font-semibold text-slate-700 hover:bg-slate-50' %>
    <% end %>
  </section>
</div>
