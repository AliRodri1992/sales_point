<% content_for :title, t('admin.system_roles.index.page_title') %>

<div>
  <div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <div class="mb-2 flex items-center gap-2 text-sm text-slate-400">
        <%= icon('shield-check', class: 'size-4') %>
        <span><%= t('admin.system_roles.index.eyebrow') %></span>
      </div>
      <h1 class="font-jakarta text-2xl font-bold text-slate-900">
        <%= t('admin.system_roles.index.title') %>
      </h1>
      <p class="mt-1 max-w-2xl text-sm text-slate-500">
        <%= t('admin.system_roles.index.subtitle') %>
      </p>
    </div>

    <%= link_to new_system_role_path,
                class: 'inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700' do %>
      <%= icon('plus', class: 'size-4') %>
      <%= t('admin.system_roles.index.new') %>
    <% end %>
  </div>

  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% @system_roles.each do |system_role| %>
      <%= link_to system_role_path(system_role),
                  class: 'group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-md' do %>
        <div class="flex items-start justify-between gap-4">
          <div class="flex min-w-0 items-center gap-3">
            <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
              <%= icon('shield-check', class: 'size-5') %>
            </div>

            <div class="min-w-0">
              <h2 class="truncate font-jakarta text-base font-bold text-slate-900 group-hover:text-blue-600">
                <%= system_role.name %>
              </h2>
              <p class="mt-0.5 text-xs text-slate-400"><%= system_role.code %></p>
            </div>
          </div>

          <% if system_role.active? %>
            <span class="inline-flex shrink-0 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">
              <%= t('admin.system_roles.statuses.active') %>
            </span>
          <% else %>
            <span class="inline-flex shrink-0 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">
              <%= t('admin.system_roles.statuses.inactive') %>
            </span>
          <% end %>
        </div>

        <p class="mt-4 min-h-10 text-sm leading-5 text-slate-500">
          <%= system_role.description.presence || t('admin.system_roles.index.no_description') %>
        </p>

        <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4">
          <span class="text-xs font-medium uppercase tracking-wide text-slate-400">
            <%= system_role.system? ? t('admin.system_roles.types.system') : t('admin.system_roles.types.branch') %>
          </span>

          <span class="inline-flex items-center gap-1 text-sm font-semibold text-blue-600">
            <%= t('admin.system_roles.index.manage_permissions') %>
            <%= icon('arrow-right', class: 'size-4 transition group-hover:translate-x-0.5') %>
          </span>
        </div>
      <% end %>
    <% end %>
  </div>

  <% if @system_roles.empty? %>
    <div class="rounded-xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center">
      <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-slate-100 text-slate-400">
        <%= icon('shield-check', class: 'size-6') %>
      </div>
      <h2 class="mt-4 font-jakarta text-base font-bold text-slate-900">
        <%= t('admin.system_roles.index.empty_title') %>
      </h2>
      <p class="mt-1 text-sm text-slate-500">
        <%= t('admin.system_roles.index.empty_subtitle') %>
      </p>
    </div>
  <% end %>
</div>
