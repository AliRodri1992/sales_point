<% content_for :title, t('admin.system_roles.index.page_title') %>

<div class="mx-auto max-w-[92rem]">
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="font-jakarta text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        <%= t('admin.system_roles.index.title') %>
      </h1>
      <p class="mt-1 max-w-2xl text-sm text-slate-500">
        <%= t('admin.system_roles.index.subtitle') %>
      </p>
    </div>

    <%= link_to new_system_role_path,
                class: 'inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 motion-reduce:transition-none' do %>
      <%= delta_icon('plus', class: 'size-4') %>
      <%= t('admin.system_roles.index.new') %>
    <% end %>
  </div>

  <nav class="mb-5 flex flex-wrap gap-2" aria-label="<%= t('admin.system_roles.lifecycle.filter_label') %>">
    <% [false, true].each do |archived| %>
      <%= link_to t(archived ? 'admin.system_roles.lifecycle.archived' : 'admin.system_roles.lifecycle.available'), system_roles_path(filter: archived ? 'archived' : nil), aria: { current: @archived == archived ? 'page' : nil }, class: "inline-flex min-h-11 items-center rounded-xl border px-4 text-sm font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 #{@archived == archived ? 'border-emerald-200 bg-emerald-50 text-emerald-800' : 'border-slate-200 bg-white text-slate-600 hover:bg-slate-50'}" %>
    <% end %>
  </nav>
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% @system_roles.each do |system_role| %>
      <%= link_to system_role_path(system_role), data: { role_card: true },
                  class: 'group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-emerald-300 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 motion-reduce:transition-none' do %>
        <div class="flex items-start justify-between gap-4">
          <div class="flex min-w-0 items-center gap-3">
            <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
              <%= delta_icon(system_role_icon(system_role), class: 'size-5', data: { role_icon: system_role.code }) %>
            </div>

            <div class="min-w-0">
              <h2 class="break-words font-jakarta text-base font-bold text-slate-900 group-hover:text-emerald-700">
                <%= system_role_name(system_role) %>
              </h2>
              <p class="mt-0.5 text-xs text-slate-400"><%= system_role.code %></p>
            </div>
          </div>

          <%= render 'system_roles/status_badge', system_role: system_role %>
        </div>

        <p class="mt-4 min-h-10 text-sm leading-5 text-slate-500">
          <%= system_role_description(system_role).presence || t('admin.system_roles.index.no_description') %>
        </p>

        <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4">
          <span class="text-xs font-medium uppercase tracking-wide text-slate-400">
            <%= system_role.system? ? t('admin.system_roles.types.system') : t('admin.system_roles.types.branch') %>
          </span>

          <span class="inline-flex items-center gap-1 text-sm font-semibold text-emerald-700">
            <%= t(system_role.protected_permissions? || system_role.deprecated? ? 'admin.system_roles.catalog.view_permissions' : 'admin.system_roles.index.manage_permissions') %>
            <%= delta_icon('arrow-right', class: 'size-4') %>
          </span>
        </div>
      <% end %>
    <% end %>
  </div>

  <%= render 'admin/shared/table_pagination', table_key: 'system_roles' %>

  <% if @system_roles.empty? %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center">
      <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-slate-100 text-slate-400">
        <%= delta_icon('shield-check', class: 'size-6') %>
      </div>
      <h2 class="mt-4 font-jakarta text-base font-bold text-slate-900">
        <%= t(@archived ? 'admin.system_roles.lifecycle.empty_archived_title' : 'admin.system_roles.index.empty_title') %>
      </h2>
      <p class="mt-1 text-sm text-slate-500">
        <%= t(@archived ? 'admin.system_roles.lifecycle.empty_archived_hint' : 'admin.system_roles.index.empty_subtitle') %>
      </p>
    </div>
  <% end %>
</div>
