<% read_only = local_assigns.fetch(:read_only) { @system_role.persisted? } %>
<% creating = @system_role.new_record? %>
<% permissions_only = local_assigns.fetch(:permissions_only, false) %>
<% metadata_read_only = read_only || permissions_only %>
<% form_url = creating ? system_roles_path : system_role_path(@system_role) %>
<% form_url = permissions_system_role_path(@system_role) if permissions_only %>
<% reviewing = !creating && !read_only %>
<% show_history = local_assigns.fetch(:show_history, false) %>
<% history_active = show_history && (params[:history_page].present? || params[:permission_history_page].present?) %>
<% form_data = {
     controller: 'role-permissions',
     role_permissions_dependency_template_value: t('admin.system_roles.catalog.auto_added_access'),
     role_permissions_removed_dependency_template_value: t('admin.system_roles.catalog.auto_removed_actions')
   } %>
<% if reviewing
     saved_ids = @system_role.errors.any? ? @system_role.permissions.available.ids : @assigned_permission_ids
     current_ids = @permissions.map(&:id) & @assigned_permission_ids
     pending_count = (current_ids - saved_ids).size + (saved_ids - current_ids).size
     form_data.merge!(
       role_permissions_saved_permission_ids_value: saved_ids,
       role_permissions_pending_breakdown_template_value: t('admin.system_roles.workspace.pending_breakdown', added: '%{added}', removed: '%{removed}'),
       role_permissions_saved_label_value: t('admin.system_roles.workspace.saved'),
       action: 'role-permissions:selection-changed->role-permissions#refreshPending submit->role-permissions#review turbo:submit-end->role-permissions#submissionEnded turbo:before-cache@document->role-permissions#closeReview turbo:before-visit@document->role-permissions#guardNavigation beforeunload@window->role-permissions#guardUnload'
     )
   end %>
<%= form_with model: @system_role, url: form_url, method: creating ? :post : :patch, html: { novalidate: true },
              data: form_data.merge(permission_workspace: !creating, role_permissions_initial_tab_value: history_active ? 'role-history-panel' : 'role-permissions-panel'),
              class: creating ? 'pb-24 sm:pb-0' : 'role-editor-surface' do |form| %>
  <%= hidden_field_tag 'permission_ids[]', '', disabled: read_only %>
  <% unless creating %>
    <%= render 'system_roles/permission_identity', role_name: role_name, role_description: role_description, show_history: show_history %>
    <div id="role-permissions-panel" role="tabpanel" aria-labelledby="role-permissions-tab" data-role-permissions-target="panel" <%= 'hidden' if history_active %>>
  <% end %>
  <% @system_role.errors[:base].uniq.each do |message| %>
    <p role="alert" class="mb-4 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800"><%= message %></p>
  <% end %>
  <% unless creating %>
    <%= render 'system_roles/permissions', read_only: read_only %>
    <details class="role-editor-details" <%= 'open' if @system_role.errors.any? %>>
      <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-2 font-semibold text-slate-700">
        <%= t('admin.system_roles.new.details_title') %><%= delta_icon('chevron-down', class: 'size-4') %>
      </summary>
  <% end %>
  <section class="<%= creating ? 'mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6' : 'pb-4' %>">
    <% if creating %>
    <h2 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.system_roles.new.details_title') %></h2>
      <p class="mt-1 text-sm text-slate-600"><%= t('admin.system_roles.new.details_subtitle') %></p>
    <% end %>
    <fieldset class="mt-5 grid gap-5 md:grid-cols-2" <%= 'disabled' if metadata_read_only %>>
      <legend class="sr-only"><%= t('admin.system_roles.new.details_title') %></legend>
      <div>
        <%= form.label :name, class: 'mb-2 block text-sm font-semibold text-slate-700' do %>
          <%= t('admin.system_roles.new.fields.name') %><span class="ml-1 font-bold text-rose-600" aria-hidden="true">*</span>
          <span class="sr-only"><%= t('admin.system_roles.form.required_field') %></span>
        <% end %>
        <%= form.text_field :name, maxlength: 50, aria: { invalid: @system_role.errors[:name].any?,
            describedby: @system_role.errors[:name].any? ? 'system_role_name_error' : nil },
            data: reviewing && !metadata_read_only ? { role_permissions_target: 'metadata', saved_value: @system_role.name_in_database.to_s,
                                action: 'input->role-permissions#refreshPending' } : {},
            class: "min-h-11 w-full rounded-xl border px-3 text-sm focus:border-emerald-700 focus:ring-2 focus:ring-emerald-100 #{form_state_classes(@system_role, :name)}",
            placeholder: t('admin.system_roles.new.fields.name_placeholder') %>
        <%= error_message_for(@system_role, :name, label: t('admin.system_roles.new.fields.name')) %>
        <%= error_message_for(@system_role, :code, label: t('admin.system_roles.form.code_label')) %>
      </div>
      <% if creating %>
        <div>
          <%= form.label :role_type, class: 'mb-2 block text-sm font-semibold text-slate-700' do %>
            <%= t('admin.system_roles.new.fields.type') %><span class="ml-1 font-bold text-rose-600" aria-hidden="true">*</span>
            <span class="sr-only"><%= t('admin.system_roles.form.required_field') %></span>
          <% end %>
          <div data-controller="delta-select">
            <%= form.select :role_type, [[t('admin.system_roles.types.system'), 'system'], [t('admin.system_roles.types.branch'), 'branch']], {},
                aria: { invalid: @system_role.errors[:role_type].any?,
                         describedby: @system_role.errors[:role_type].any? ? 'system_role_role_type_error' : nil },
                class: "min-h-11 w-full rounded-xl border bg-white px-3 text-sm focus:border-emerald-700 focus:ring-2 focus:ring-emerald-100 #{form_state_classes(@system_role, :role_type)}" %>
          </div>
          <%= error_message_for(@system_role, :role_type, label: t('admin.system_roles.new.fields.type')) %>
        </div>
        <div>
          <p class="mb-2 text-sm font-semibold text-slate-700"><%= t('admin.system_roles.new.fields.status') %></p>
          <%= render 'system_roles/status_badge', system_role: @system_role %>
          <p class="mt-2 text-xs leading-5 text-slate-500"><%= t('admin.system_roles.lifecycle.create_hint') %></p>
          <%= error_message_for(@system_role, :status, label: t('admin.system_roles.new.fields.status')) %>
        </div>
      <% else %>
        <%= error_message_for(@system_role, :status, label: t('admin.system_roles.new.fields.status')) %>
      <% end %>
      <div>
        <%= form.label :description, t('admin.system_roles.new.fields.description'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.text_area :description, rows: 3, class: 'w-full rounded-xl border border-slate-300 px-3 py-2 text-sm focus:border-emerald-700 focus:ring-2 focus:ring-emerald-100', placeholder: t('admin.system_roles.new.fields.description_placeholder'),
            data: reviewing && !metadata_read_only ? { role_permissions_target: 'metadata', saved_value: @system_role.description_in_database.to_s,
                                action: 'input->role-permissions#refreshPending' } : {} %>
      </div>
    </fieldset>
  </section>
  <% if creating %>
    <%= render 'system_roles/permissions', read_only: read_only %>
  <% else %>
    </details>
    </div>
    <% if show_history %>
      <div id="role-history-panel" role="tabpanel" aria-labelledby="role-history-tab" data-role-permissions-target="panel" <%= 'hidden' unless history_active %> class="role-editor-history">
        <%= render 'system_roles/permission_history' %>
        <%= render 'system_roles/status_history' %>
      </div>
    <% end %>
  <% end %>
  <% unless read_only %>
    <% footer_layout = if reviewing
                         'sticky bottom-24 flex-wrap items-center justify-between gap-x-4 gap-y-2 p-3 sm:bottom-3 sm:p-4'
                       else
                         'flex-col-reverse gap-3 p-4 sm:sticky sm:bottom-3 sm:flex-row sm:items-center sm:justify-between'
                       end %>
    <div class="<%= reviewing ? 'role-editor-footer' : 'z-10 mt-6 flex rounded-xl border border-slate-200 bg-white shadow-sm sm:pr-40' %> <%= footer_layout %>">
      <% if reviewing %>
        <div class="flex min-w-0 items-center gap-3" data-role-permissions-target="pending" role="status" aria-atomic="true">
          <span class="role-editor-change-icon"><%= delta_icon('role-editor-shield', class: 'size-5') %></span>
          <div class="min-w-0">
            <p class="text-sm font-semibold text-slate-800"><span data-role-permissions-target="pendingCount" class="tabular-nums"><%= pending_count %></span> <span data-role-permissions-target="pendingLabel"><%= t('admin.system_roles.catalog.pending_permissions') %></span></p>
            <p class="text-xs text-slate-600" data-role-permissions-target="pendingBreakdown"><%= t('admin.system_roles.workspace.saved') %></p>
            <p hidden data-role-permissions-target="pendingDetails" class="text-xs font-medium text-slate-600"><%= t('admin.system_roles.catalog.pending_details') %></p>
          </div>
        </div>
      <% else %>
        <p class="text-xs text-slate-500"><%= t('admin.system_roles.catalog.save_hint') %></p>
      <% end %>
      <div class="flex flex-wrap justify-end gap-3">
        <% if reviewing %>
          <button type="button" hidden data-role-permissions-target="discard" data-action="role-permissions#discard"
                  class="min-h-11 rounded-xl border border-slate-300 px-4 text-sm font-semibold text-slate-700 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 disabled:cursor-default disabled:text-slate-500"><%= t('admin.system_roles.catalog.discard_changes') %></button>
        <% else %>
          <%= link_to t('admin.system_roles.new.cancel'), system_roles_path, class: 'inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-300 px-4 text-sm font-semibold text-slate-700 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700' %>
        <% end %>
        <% if reviewing %>
          <%= form.button type: :submit, class: 'role-editor-save', data: { role_permissions_target: 'save', turbo_submits_with: t('admin.system_roles.catalog.saving') } do %>
            <%= delta_icon('role-editor-check', class: 'size-4') %><%= t('admin.system_roles.workspace.review_save') %>
            <span data-role-permissions-target="saveCount" class="role-editor-save-count" aria-hidden="true" hidden></span>
          <% end %>
        <% else %>
          <%= form.submit t('admin.system_roles.new.submit'), class: 'min-h-11 cursor-pointer rounded-xl bg-emerald-700 px-5 text-sm font-semibold text-white hover:bg-emerald-800', data: { turbo_submits_with: t('admin.system_roles.catalog.saving') } %>
        <% end %>
      </div>
    </div>
  <% end %>
  <% if reviewing %>
    <%= render 'system_roles/permission_review' %>
    <%= render 'system_roles/permission_discard' %>
  <% elsif !creating %>
    <div class="role-editor-footer"><div class="flex items-center gap-3"><span class="role-editor-change-icon"><%= delta_icon('lock-closed', class: 'size-5') %></span><div><strong class="text-sm"><%= t('admin.system_roles.workspace.read_only_title') %></strong><p class="text-xs text-slate-600"><%= t('admin.system_roles.catalog.view_subtitle') %></p></div></div></div>
  <% end %>
<% end %>
