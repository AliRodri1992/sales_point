<% content_for :system_role_breadcrumb_label, system_role_name(@system_role) %>
<% content_for :title, "#{system_role_name(@system_role)} | #{t('admin.system_roles.index.title')}" %>
<div class="mx-auto max-w-[92rem]">
<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
  <div class="min-w-0">
    <p class="text-xs font-bold uppercase tracking-[.18em] text-emerald-700"><%= t('admin.system_roles.index.title') %></p>
    <div class="mt-1 flex flex-wrap items-center gap-3">
      <h1 class="break-words font-jakarta text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"><%= system_role_name(@system_role) %></h1>
      <%= render 'system_roles/status_badge', system_role: @system_role %>
    </div>
    <p class="mt-2 max-w-2xl text-sm text-slate-600"><%= t('admin.system_roles.catalog.edit_subtitle') %></p>
  </div>
  <%= link_to system_roles_path, class: 'inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-emerald-200 hover:bg-emerald-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 motion-reduce:transition-none' do %>
    <%= delta_icon('arrow-left', class: 'size-4') %><%= t('admin.system_roles.show.back') %>
  <% end %>
</div>
<%= render 'system_roles/lifecycle' %>
<%= render 'system_roles/form' %>
<%= render 'system_roles/status_history' %>
<%= render 'system_roles/permission_history' %>
</div>
