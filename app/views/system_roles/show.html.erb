<% role_policy = policy(@system_role) %>
<% read_only = !role_policy.update_permissions? %>
<% permissions_only = !read_only && !role_policy.update? %>
<% subtitle_key = if read_only
                    'admin.system_roles.catalog.view_subtitle'
                  elsif permissions_only
                    'admin.system_roles.catalog.edit_permissions_subtitle'
                  else
                    'admin.system_roles.catalog.edit_subtitle'
                  end %>
<% role_name = system_role_name(@system_role, persisted: true) %>
<% role_description = system_role_description(@system_role, persisted: true) %>
<% workspace_title = t(read_only ? 'admin.system_roles.catalog.view_permissions' : 'admin.system_roles.index.manage_permissions') %>
<% content_for :system_role_breadcrumb_label, workspace_title %>
<% content_for :title, "#{workspace_title} | #{role_name}" %>

<div class="mx-auto max-w-[92rem]" data-permissions-mode="<%= read_only ? 'view' : 'edit' %>">
  <header class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0">
      <h1 class="font-jakarta text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl"><%= workspace_title %></h1>
      <p class="mt-2 max-w-2xl text-sm text-slate-600"><%= t(subtitle_key) %></p>
    </div>
    <%= link_to system_roles_path, data: { role_workspace_back: true }, class: 'inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 transition hover:border-emerald-200 hover:bg-emerald-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 motion-reduce:transition-none' do %>
      <%= delta_icon('arrow-left', class: 'size-4') %><%= t('admin.system_roles.show.back') %>
    <% end %>
  </header>

  <%= render 'system_roles/form', read_only: read_only, permissions_only: permissions_only,
             role_name: role_name, role_description: role_description, show_history: role_policy.audit_history? %>
  <div class="mt-6"><%= render 'system_roles/lifecycle' %></div>
</div>
