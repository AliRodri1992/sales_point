<section id="permission-history" class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
  <h2 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.system_roles.permission_history.title') %></h2>
  <% if @permission_audit_events.any? %>
    <ol class="mt-4 divide-y divide-slate-100">
      <% @permission_audit_events.each do |event| %>
        <li class="py-4 first:pt-0">
          <p class="text-xs text-slate-600"><%= event.actor.display_name %> · <%= l(event.created_at, format: :short) %></p>
          <% if event.added_permission_codes.any? %>
            <p class="mt-2 break-words text-sm text-emerald-800"><strong><%= t('admin.system_roles.permission_history.added') %>:</strong> <%= event.added_permission_codes.join(', ') %></p>
          <% end %>
          <% if event.removed_permission_codes.any? %>
            <p class="mt-2 break-words text-sm text-rose-800"><strong><%= t('admin.system_roles.permission_history.removed') %>:</strong> <%= event.removed_permission_codes.join(', ') %></p>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="mt-3 text-sm text-slate-500"><%= t('admin.system_roles.permission_history.empty') %></p>
  <% end %>
</section>
