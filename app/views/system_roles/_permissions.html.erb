<section class="rounded-2xl border border-slate-200 bg-white shadow-sm" data-controller="role-permissions">
  <div class="border-b border-slate-200 p-5 sm:p-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h2 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.system_roles.new.permissions_title') %></h2>
        <p class="mt-1 max-w-2xl text-sm text-slate-600"><%= t('admin.system_roles.catalog.help') %></p>
      </div>
      <p class="rounded-xl bg-emerald-50 px-3 py-2 text-sm font-medium text-emerald-800" aria-live="polite" aria-atomic="true">
        <span data-role-permissions-target="total"><%= @assigned_permission_ids.size %></span> / <%= @permissions.size %>
        <%= t('admin.system_roles.catalog.selected') %>
      </p>
    </div>
    <% if read_only %>
      <p class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900"><%= t(@system_role.deprecated? ? 'admin.system_roles.lifecycle.archived_read_only' : 'admin.system_roles.show.managed_permissions') %></p>
    <% end %>
    <div class="mt-5">
      <label for="permission-search" class="mb-2 block text-sm font-semibold text-slate-700"><%= t('admin.system_roles.catalog.search') %></label>
      <input type="search" id="permission-search" placeholder="<%= t('admin.system_roles.catalog.search_placeholder') %>"
             class="min-h-11 w-full rounded-xl border border-slate-300 px-4 text-sm focus:border-emerald-700 focus:ring-2 focus:ring-emerald-100"
             data-role-permissions-target="search" data-action="input->role-permissions#filter" aria-describedby="permission-results">
      <p id="permission-results" class="mt-2 text-xs text-slate-500" role="status">
        <span data-role-permissions-target="results"><%= @permissions.size %></span> <%= t('admin.system_roles.catalog.results') %>
      </p>
    </div>
  </div>
  <div class="space-y-4 bg-slate-50/60 p-4 sm:p-6">
    <% grouped_role_permissions(@permissions).each_with_index do |(module_key, permissions), index| %>
      <%= render 'system_roles/permission_group', module_key: module_key, permissions: permissions, index: index, read_only: read_only %>
    <% end %>
    <p hidden data-role-permissions-target="empty" class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-600"><%= t(@permissions.empty? ? 'admin.system_roles.catalog.empty' : 'admin.system_roles.catalog.no_results') %></p>
  </div>
</section>
