<section class="role-editor-catalog">
  <div class="role-editor-toolbar">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0 flex-1 basis-64">
        <h2 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.system_roles.workspace.matrix_title') %></h2>
        <% unless read_only %>
          <p class="mt-1 max-w-2xl text-sm text-slate-600"><%= t('admin.system_roles.catalog.help') %></p>
        <% end %>
        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-xs font-medium text-slate-700">
          <li class="flex items-center gap-1.5">
            <span aria-hidden="true" class="inline-flex h-3.5 w-6 items-center justify-end rounded-full bg-emerald-700 px-0.5"><span class="size-2.5 rounded-full bg-white"></span></span>
            <%= t('admin.system_roles.catalog.granted') %>
          </li>
          <li class="flex items-center gap-1.5">
            <span aria-hidden="true" class="inline-flex h-3.5 w-6 items-center rounded-full bg-slate-300 px-0.5"><span class="size-2.5 rounded-full bg-white"></span></span>
            <%= t('admin.system_roles.catalog.not_granted') %>
          </li>
        </ul>
        <%= error_message_for(@system_role, :permission_ids, label: t('admin.system_roles.new.permissions_title')) %>
      </div>
      <div class="w-full max-w-60 rounded-lg border border-emerald-100 bg-emerald-50 px-3 py-2">
        <p class="flex flex-wrap items-baseline justify-between gap-x-3 text-xs font-semibold text-emerald-900" aria-live="polite" aria-atomic="true">
          <span id="permission-total-label"><%= t('admin.system_roles.catalog.granted_total') %></span>
          <span class="tabular-nums"><span data-role-permissions-target="total"><%= @assigned_permission_ids.size %></span> / <%= @permissions.size %></span>
        </p>
        <% if @permissions.any? %>
          <progress aria-labelledby="permission-total-label" class="mt-2 block h-1.5 w-full overflow-hidden rounded-full bg-emerald-100 [&::-moz-progress-bar]:bg-emerald-700 [&::-webkit-progress-bar]:bg-emerald-100 [&::-webkit-progress-value]:bg-emerald-700"
                    data-role-permissions-target="progress" value="<%= @assigned_permission_ids.size %>" max="<%= @permissions.size %>"></progress>
        <% end %>
      </div>
    </div>
    <div class="mt-5 flex flex-wrap items-end gap-3">
      <div class="min-w-0 flex-1 basis-64">
        <label for="permission-search" class="mb-1.5 block text-sm font-semibold text-slate-700"><%= t('admin.system_roles.catalog.search') %></label>
        <div class="relative">
          <%= delta_icon('magnifying-glass', class: 'pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-slate-500') %>
          <input type="search" id="permission-search" placeholder="<%= t('admin.system_roles.catalog.search_placeholder') %>" autocomplete="off"
                 class="min-h-11 w-full min-w-0 rounded-lg border border-slate-300 pr-3 pl-9 text-sm focus:border-emerald-700 focus:ring-2 focus:ring-emerald-100"
                 data-role-permissions-target="search" data-action="input->role-permissions#searchChanged" aria-describedby="permission-results">
        </div>
      </div>
      <div role="group" aria-label="<%= t('admin.system_roles.catalog.filter_label') %>" class="inline-flex max-w-full flex-wrap gap-0.5 rounded-lg border border-slate-200 bg-slate-50 p-0.5">
        <% %w[all assigned unassigned].each do |state| %>
          <button type="button" data-filter-state="<%= state %>" aria-pressed="<%= state == 'all' %>"
                  data-role-permissions-target="stateFilter" data-action="role-permissions#filterState"
                  class="min-h-10 rounded-md px-2.5 text-xs font-semibold text-slate-700 hover:bg-white focus-visible:z-10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 aria-pressed:bg-white aria-pressed:text-emerald-800 aria-pressed:shadow-sm">
            <%= t("admin.system_roles.catalog.filter_#{state}") %>
          </button>
        <% end %>
      </div>
    </div>
    <div class="mt-2 flex flex-wrap items-center justify-between gap-x-3">
      <p id="permission-results" class="text-xs text-slate-600" role="status">
        <span data-role-permissions-target="results"><%= @permissions.size %></span> <%= t('admin.system_roles.workspace.results_total', count: @permissions.size) %>
      </p>
      <div class="flex flex-wrap gap-x-3">
        <button type="button" class="min-h-11 rounded-md text-xs font-semibold text-emerald-800 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" data-action="role-permissions#expandAll"><%= t('admin.system_roles.catalog.expand_all') %></button>
        <button type="button" class="min-h-11 rounded-md text-xs font-semibold text-emerald-800 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" data-action="role-permissions#collapseAll"><%= t('admin.system_roles.catalog.collapse_all') %></button>
      </div>
    </div>
    <% if read_only %>
      <% notice = if @system_role.deprecated?
                    'admin.system_roles.lifecycle.archived_read_only'
                  elsif @system_role.protected_permissions?
                    'admin.system_roles.show.managed_permissions'
                  else
                    'admin.system_roles.catalog.view_subtitle'
                  end %>
      <p class="mt-2 flex items-start gap-2 rounded-lg border border-amber-200 bg-amber-50 p-2.5 text-xs text-amber-900">
        <%= delta_icon('lock-closed', class: 'size-4 shrink-0') %>
        <%= t(notice) %>
      </p>
    <% else %>
      <p class="mt-2 flex items-start gap-2 rounded-lg bg-slate-50 p-2.5 text-xs text-slate-700">
        <%= delta_icon('information-circle', class: 'size-4 shrink-0 text-slate-500') %>
        <%= t('admin.system_roles.catalog.access_hint') %>
      </p>
    <% end %>
    <p data-role-permissions-target="dependencyNotice" role="status" aria-atomic="true"
       class="mt-2 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs text-emerald-900 empty:sr-only"></p>
  </div>
  <div class="role-editor-groups">
    <% grouped_role_permissions(@permissions).each do |module_key, permissions| %>
      <%= render 'system_roles/permission_group', module_key: module_key, permissions: permissions, read_only: read_only %>
    <% end %>
    <div <%= 'hidden' if @permissions.any? %> data-role-permissions-target="empty" class="rounded-xl border border-dashed border-slate-300 bg-white p-5 text-center text-sm text-slate-700">
      <%= delta_icon('magnifying-glass', class: 'mx-auto mb-3 size-7 text-slate-400') %>
      <p class="font-semibold"><%= t(@permissions.empty? ? 'admin.system_roles.catalog.empty' : 'admin.system_roles.catalog.no_results') %></p>
      <% if @permissions.any? %>
        <button type="button" class="mt-2 min-h-11 rounded-md px-2 text-sm font-semibold text-emerald-800 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" data-action="role-permissions#clearFilters"><%= t('admin.system_roles.catalog.clear_filters') %></button>
      <% end %>
    </div>
  </div>
</section>
