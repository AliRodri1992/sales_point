<section class="role-editor-header" aria-labelledby="role-identity-title">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="flex min-w-0 items-start gap-3">
      <span class="role-editor-emblem"><%= delta_icon(system_role_icon(@system_role), class: 'size-6') %></span>
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <h2 id="role-identity-title" class="break-words font-jakarta text-xl font-extrabold tracking-tight text-slate-900"><%= role_name %></h2>
          <%= render 'system_roles/status_badge', system_role: @system_role %>
        </div>
        <code class="mt-1 block break-all text-xs text-slate-500"><%= @system_role.code %></code>
        <p class="mt-2 break-words text-sm leading-5 text-slate-600"><%= role_description.presence || t('admin.system_roles.index.no_description') %></p>
      </div>
    </div>
    <span class="role-editor-context"><%= delta_icon('shield-check', class: 'size-4') %><%= t('admin.system_roles.workspace.context') %></span>
  </div>
  <div class="role-editor-meta">
    <span><%= delta_icon('building-office-2', class: 'size-4') %><%= t("admin.system_roles.types.#{@system_role.role_type}") %></span>
    <span><%= delta_icon('user-group', class: 'size-4') %><%= t('admin.system_roles.workspace.assigned_users', count: role_workspace_user_count(@system_role)) %></span>
    <span><%= delta_icon('clock', class: 'size-4') %><%= t('admin.system_roles.workspace.updated', date: l(role_workspace_updated_at(@system_role), format: :short)) %></span>
  </div>
  <div role="tablist" aria-label="<%= t('admin.system_roles.workspace.tabs') %>" class="role-editor-tabs" data-action="keydown->role-permissions#tabKeydown">
    <button type="button" id="role-permissions-tab" role="tab" aria-selected="<%= !history_active %>" aria-controls="role-permissions-panel" tabindex="<%= history_active ? -1 : 0 %>"
            data-role-permissions-target="tab" data-action="role-permissions#selectTab">
      <%= delta_icon('key', class: 'size-4') %><%= t('admin.system_roles.workspace.permissions_tab') %>
      <span class="role-editor-tab-count" data-role-permissions-target="tabCount"><%= @assigned_permission_ids.size %></span>
    </button>
    <% if show_history %>
      <button type="button" id="role-history-tab" role="tab" aria-selected="<%= history_active %>" aria-controls="role-history-panel" tabindex="<%= history_active ? 0 : -1 %>"
              data-role-permissions-target="tab" data-action="role-permissions#selectTab">
        <%= delta_icon('role-editor-history', class: 'size-4') %><%= t('admin.system_roles.workspace.history_tab') %>
      </button>
    <% end %>
  </div>
</section>
