<section id="status-history" class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
  <h2 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.system_roles.lifecycle.history') %></h2>
  <% if @status_events.any? %>
    <ol class="mt-4 divide-y divide-slate-100">
      <% @status_events.each do |event| %>
        <li class="py-4 first:pt-0">
          <p class="flex flex-wrap gap-2 text-sm font-semibold text-slate-800"><span><%= t("admin.system_roles.statuses.#{event.from_status}") %></span><span aria-hidden="true">→</span><span><%= t("admin.system_roles.statuses.#{event.to_status}") %></span></p>
          <p class="mt-1 break-words text-xs text-slate-500"><%= event.actor.display_name %> · <%= l(event.created_at, format: :short) %></p>
          <p class="mt-2 whitespace-pre-wrap break-words text-sm leading-6 text-slate-700"><%= event.reason %></p>
          <p class="mt-2 text-xs text-slate-500"><%= t('admin.system_roles.lifecycle.history_impact', users: event.impact['users'], branches: event.impact['branches']) %></p>
        </li>
      <% end %>
    </ol>
    <% if @history_pages > 1 %>
      <nav class="mt-4 flex flex-wrap items-center gap-3 text-sm" aria-label="<%= t('admin.system_roles.lifecycle.history') %>">
        <% if @history_page > 1 %><%= link_to t('admin.system_roles.lifecycle.previous'), system_role_path(@system_role, history_page: @history_page - 1, anchor: 'status-history'), class: 'rounded-lg border border-slate-200 px-3 py-2 text-emerald-700' %><% end %>
        <span><%= @history_page %> / <%= @history_pages %></span>
        <% if @history_page < @history_pages %><%= link_to t('admin.system_roles.lifecycle.next'), system_role_path(@system_role, history_page: @history_page + 1, anchor: 'status-history'), class: 'rounded-lg border border-slate-200 px-3 py-2 text-emerald-700' %><% end %>
      </nav>
    <% end %>
  <% else %>
    <p class="mt-3 text-sm text-slate-500"><%= t('admin.system_roles.lifecycle.empty_history') %></p>
  <% end %>
</section>
