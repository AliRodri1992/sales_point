<% content_for :title, t('admin.system_roles.new.page_title') %>

<div>
  <div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-medium text-slate-500"><%= t('admin.system_roles.index.title') %></p>
      <h1 class="mt-1 font-jakarta text-2xl font-bold text-slate-900"><%= t('admin.system_roles.new.title') %></h1>
      <p class="mt-1 max-w-2xl text-sm text-slate-500"><%= t('admin.system_roles.new.subtitle') %></p>
    </div>
    <%= link_to system_roles_path, class: 'inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50' do %>
      <%= icon('arrow-left', class: 'size-4') %>
      <%= t('admin.system_roles.new.back') %>
    <% end %>
  </div>

  <%= form_with model: @system_role, url: system_roles_path, method: :post do |form| %>
    <% if @system_role.errors.any? %>
      <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        <p class="font-semibold"><%= t('admin.system_roles.new.error_title') %></p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <% @system_role.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
      <div class="mb-5">
        <h2 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.system_roles.new.details_title') %></h2>
        <p class="mt-1 text-sm text-slate-500"><%= t('admin.system_roles.new.details_subtitle') %></p>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        <div>
          <%= form.label :name, t('admin.system_roles.new.fields.name'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
          <%= form.text_field :name, class: 'w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20', placeholder: t('admin.system_roles.new.fields.name_placeholder') %>
        </div>

        <div>
          <%= form.label :role_type, t('admin.system_roles.new.fields.type'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
          <%= form.select :role_type, [[t('admin.system_roles.types.system'), 'system'], [t('admin.system_roles.types.branch'), 'branch']], {}, class: 'w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20' %>
        </div>

        <div>
          <%= form.label :status, t('admin.system_roles.new.fields.status'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
          <%= form.select :status, [[t('admin.system_roles.statuses.active'), 'active'], [t('admin.system_roles.statuses.inactive'), 'inactive']], {}, class: 'w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-800 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20' %>
        </div>

        <div>
          <%= form.label :description, t('admin.system_roles.new.fields.description'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
          <%= form.text_area :description, rows: 3, class: 'w-full resize-none rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20', placeholder: t('admin.system_roles.new.fields.description_placeholder') %>
        </div>
      </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-5 py-5 sm:px-6">
        <h2 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.system_roles.new.permissions_title') %></h2>
        <p class="mt-1 text-sm text-slate-500"><%= t('admin.system_roles.new.permissions_subtitle') %></p>
      </div>

      <div class="grid gap-4 px-5 py-5 md:grid-cols-2 sm:px-6">
        <%= render partial: 'system_roles/permission_card',
                   collection: @permissions,
                   as: :permission,
                   locals: { assigned_ids: [] } %>
      </div>

      <div class="flex flex-col-reverse gap-3 border-t border-slate-100 px-5 py-5 sm:flex-row sm:items-center sm:justify-end sm:px-6">
        <%= link_to t('admin.system_roles.new.cancel'), system_roles_path, class: 'inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50' %>
        <%= form.submit t('admin.system_roles.new.submit'), class: 'inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700' %>
      </div>
    </div>
  <% end %>
</div>
