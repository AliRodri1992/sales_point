<dialog aria-labelledby="permission-discard-title" aria-describedby="permission-discard-description"
        data-role-permissions-target="discardDialog" data-action="cancel->role-permissions#cancelDiscard"
        class="fixed inset-0 m-auto max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-md overflow-y-auto rounded-2xl border border-slate-200 bg-white p-5 shadow-2xl backdrop:bg-slate-900/60">
  <span class="role-editor-emblem"><%= delta_icon('exclamation-triangle', class: 'size-6') %></span>
  <h2 id="permission-discard-title" class="mt-3 font-jakarta text-lg font-bold text-slate-900"><%= t('admin.system_roles.workspace.discard_title') %></h2>
  <p id="permission-discard-description" class="mt-2 text-sm leading-6 text-slate-600"><%= t('admin.system_roles.workspace.discard_prompt') %></p>
  <div class="mt-5 flex flex-wrap justify-end gap-2">
    <button type="button" autofocus data-action="role-permissions#cancelDiscard" class="min-h-11 rounded-xl border border-slate-300 px-4 text-sm font-semibold text-slate-700"><%= t('admin.system_roles.workspace.keep_changes') %></button>
    <button type="button" data-action="role-permissions#confirmDiscard" class="min-h-11 rounded-xl bg-rose-700 px-4 text-sm font-semibold text-white hover:bg-rose-800"><%= t('admin.system_roles.catalog.discard_changes') %></button>
  </div>
</dialog>
