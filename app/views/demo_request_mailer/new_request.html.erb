<div style="font-size:14px;line-height:22px;color:#475569;">
  <div style="display:inline-block;padding:6px 10px;border-radius:999px;background-color:#ecfdf5;color:#047857;font-size:12px;line-height:16px;font-weight:700;"><%= t('demo_request_mailer.new_request.badge') %></div>
  <h1 style="margin:18px 0 10px;font-size:28px;line-height:36px;color:#0f172a;font-weight:700;"><%= t('demo_request_mailer.new_request.title') %></h1>
  <p style="margin:0 0 28px;color:#64748b;"><%= t('demo_request_mailer.new_request.intro') %></p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;">
    <tr><td colspan="2" style="padding:16px 18px;background-color:#f8fafc;border-bottom:1px solid #e2e8f0;font-size:13px;line-height:18px;font-weight:700;color:#334155;"><%= t('demo_request_mailer.new_request.contact_section') %></td></tr>
    <% [['name', @demo_request.name], ['email', @demo_request.email], ['phone', @demo_request.phone], ['company', @demo_request.company]].each do |field, value| %>
      <tr>
        <td width="34%" style="padding:13px 18px;border-bottom:1px solid #f1f5f9;font-size:13px;line-height:19px;font-weight:700;color:#64748b;vertical-align:top;"><%= t("demo_request_mailer.new_request.fields.#{field}") %></td>
        <td style="padding:13px 18px;border-bottom:1px solid #f1f5f9;font-size:14px;line-height:20px;color:#0f172a;vertical-align:top;word-break:break-word;"><%= value %></td>
      </tr>
    <% end %>
  </table>
  <div style="height:24px;line-height:24px;">&nbsp;</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;">
    <tr><td colspan="2" style="padding:16px 18px;background-color:#f8fafc;border-bottom:1px solid #e2e8f0;font-size:13px;line-height:18px;font-weight:700;color:#334155;"><%= t('demo_request_mailer.new_request.business_section') %></td></tr>
    <tr><td width="34%" style="padding:13px 18px;border-bottom:1px solid #f1f5f9;font-size:13px;line-height:19px;font-weight:700;color:#64748b;"><%= t('demo_request_mailer.new_request.fields.business_type') %></td><td style="padding:13px 18px;border-bottom:1px solid #f1f5f9;font-size:14px;line-height:20px;color:#0f172a;"><%= t("demo_requests.new.business_types.#{@demo_request.business_type}") %></td></tr>
    <tr><td style="padding:13px 18px;border-bottom:1px solid #f1f5f9;font-size:13px;line-height:19px;font-weight:700;color:#64748b;"><%= t('demo_request_mailer.new_request.fields.branches') %></td><td style="padding:13px 18px;border-bottom:1px solid #f1f5f9;font-size:14px;line-height:20px;color:#0f172a;"><%= @demo_request.branches %></td></tr>
    <tr><td style="padding:13px 18px;font-size:13px;line-height:19px;font-weight:700;color:#64748b;"><%= t('demo_request_mailer.new_request.fields.created_at') %></td><td style="padding:13px 18px;font-size:14px;line-height:20px;color:#0f172a;"><%= l(@demo_request.created_at || Time.current, format: :long) %></td></tr>
  </table>
  <% if @demo_request.message.present? %>
    <div style="height:24px;line-height:24px;">&nbsp;</div>
    <div style="padding:18px;border-left:4px solid #059669;background-color:#f8fafc;border-radius:8px;">
      <div style="margin:0 0 8px;font-size:13px;line-height:18px;font-weight:700;color:#334155;"><%= t('demo_request_mailer.new_request.fields.message') %></div>
      <div style="font-size:14px;line-height:22px;color:#475569;"><%= simple_format(@demo_request.message) %></div>
    </div>
  <% end %>
</div>
