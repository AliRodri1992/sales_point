<% content_for :title, t('admin.general_settings.page_title') %>

<div class="mx-auto max-w-6xl space-y-7 pb-10">
  <header class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-emerald-700"><%= t('admin.general_settings.table_section') %></p>
      <h1 class="mt-2 font-jakarta text-2xl font-bold tracking-tight text-slate-900"><%= t('admin.general_settings.title') %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500"><%= t('admin.general_settings.subtitle') %></p>
    </div>
    <span class="inline-flex items-center gap-2 self-start rounded-xl border border-emerald-100 bg-emerald-50 px-3 py-2 text-xs font-semibold text-emerald-700">
      <%= delta_icon('cog', class: 'size-4') %>
      <%= current_organization.name %>
    </span>
  </header>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1.4fr)_minmax(280px,1fr)]">
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-6 py-5">
        <div class="flex items-center gap-3">
          <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                 class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="4" width="18" height="16" rx="2"/>
              <path d="M3 10h18M9 10v10M15 10v10"/>
            </svg>
          </div>
          <div>
            <h2 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.general_settings.table_heading') %></h2>
            <p class="mt-1 text-sm leading-6 text-slate-500"><%= t('admin.general_settings.table_description') %></p>
          </div>
        </div>
      </div>

      <%= form_with model: @settings, url: admin_general_settings_path, method: :patch, class: 'space-y-6 px-6 py-6' do |f| %>
        <div class="max-w-sm">
          <%= f.label :default_table_page_size, t('admin.general_settings.field_label'), class: 'mb-2 block text-sm font-semibold text-slate-800' %>
          <div class="relative" data-controller="delta-select">
            <%= f.select :default_table_page_size,
                         TablePagePreference::OPTIONS.map { |size| [t('admin.general_settings.option_label', count: size), size] },
                         {},
                         class: 'min-h-12 w-full rounded-xl border border-slate-300 bg-white px-4 text-sm text-slate-800 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100' %>
          </div>
          <%= error_message_for(@settings, :default_table_page_size) %>
          <p class="mt-2 text-xs text-slate-500"><%= t('admin.general_settings.unit') %></p>
        </div>

        <div class="rounded-xl border border-emerald-100 bg-emerald-50/60 px-4 py-4">
          <h3 class="text-sm font-bold text-emerald-900"><%= t('admin.general_settings.explanation_title') %></h3>
          <div class="mt-3 space-y-2 text-sm leading-6 text-emerald-950/80">
            <p><%= t('admin.general_settings.organization_rule') %></p>
            <p><%= t('admin.general_settings.user_rule') %></p>
            <p class="font-semibold"><%= t('admin.general_settings.precedence') %></p>
          </div>
        </div>

        <div class="flex justify-end border-t border-slate-100 pt-5">
          <%= f.submit t('admin.general_settings.save'), class: 'inline-flex min-h-11 cursor-pointer items-center justify-center rounded-xl bg-emerald-700 px-6 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700' %>
        </div>
      <% end %>
    </section>

    <aside class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-5 py-5">
        <p class="font-jakarta text-sm font-bold text-slate-900"><%= t('admin.general_settings.preview_title') %></p>
        <p class="mt-1 text-xs leading-5 text-slate-500"><%= t('admin.general_settings.preview_subtitle') %></p>
      </div>
      <div class="p-5">
        <div class="overflow-hidden rounded-xl border border-slate-200">
          <div class="border-b border-slate-100 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-700">
            <%= t('admin.general_settings.example_table') %>
          </div>
          <div class="flex justify-between px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-400">
            <span><%= t('admin.general_settings.example_column') %></span>
            <span><%= t('admin.general_settings.example_status') %></span>
          </div>
          <% 3.times do |index| %>
            <div class="flex justify-between border-t border-slate-100 px-4 py-3 text-sm">
              <span class="flex items-center gap-2 text-slate-700">
                <span class="size-2 rounded-full bg-emerald-400"></span>
                <%= t('admin.general_settings.example_column') %> <%= index + 1 %>
              </span>
              <span class="rounded-md bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700">
                <%= t('admin.general_settings.example_active') %>
              </span>
            </div>
          <% end %>
          <div class="border-t border-slate-100 bg-slate-50 px-4 py-3 text-xs text-slate-500">
            <%= t('admin.general_settings.example_rows', count: @settings.default_table_page_size) %>
          </div>
        </div>
        <div class="mt-5 flex items-center justify-center">
          <%= image_tag 'deltin/waving.svg', alt: '', class: 'h-24 w-24 object-contain' %>
        </div>
      </div>
    </aside>
  </div>
</div>
