<% content_for :title, t('admin.general_settings.page_title') %>

<div class="mx-auto max-w-6xl space-y-7 pb-10"
     data-controller="general-settings-preview"
     data-general-settings-preview-template-value="<%= t('admin.general_settings.example_rows', count: '__PAGE_SIZE__') %>"
     data-general-settings-preview-original-value="<%= @settings.default_table_page_size_in_database || @settings.default_table_page_size %>"
     data-general-settings-preview-recovery-value="<%= !!@recovering_settings %>"
     data-general-settings-preview-unsaved-value="<%= t('admin.general_settings.pending_changes') %>"
     data-general-settings-preview-unchanged-value="<%= t('admin.general_settings.no_changes') %>">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-emerald-700"><%= t('admin.general_settings.table_section') %></p>
      <h1 class="mt-2 font-jakarta text-3xl font-bold tracking-tight text-slate-900"><%= t('admin.general_settings.title') %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500"><%= t('admin.general_settings.subtitle') %></p>
    </div>
    <span class="inline-flex max-w-full items-center gap-2 self-start rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm">
      <%= delta_icon('cog', class: 'size-4') %>
      <span class="min-w-0 break-words"><%= current_organization.name %></span>
    </span>
  </header>

  <div class="grid min-w-0 gap-6 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,0.75fr)]">
    <section class="min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-5 py-5 sm:px-7">
        <div class="flex items-center gap-3">
          <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-800">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                 class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="4" width="18" height="16" rx="2"/>
              <path d="M3 10h18M9 10v10M15 10v10"/>
            </svg>
          </div>
          <div class="min-w-0">
            <h2 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.general_settings.table_heading') %></h2>
            <p class="mt-1 text-sm leading-6 text-slate-500"><%= t('admin.general_settings.table_description') %></p>
          </div>
        </div>
      </div>

      <%= form_with model: @settings, url: admin_general_settings_path, method: :patch, class: 'space-y-6 px-5 py-6 sm:px-7' do |f| %>
        <% if @recovering_settings %>
          <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-4 text-sm text-amber-950" role="status">
            <h3 class="font-bold"><%= t('admin.general_settings.recovery_title') %></h3>
            <p class="mt-1 leading-6"><%= t('admin.general_settings.recovery_description') %></p>
          </div>

          <div class="grid min-w-0 gap-5 sm:grid-cols-2">
            <div class="min-w-0">
              <%= f.label :base_currency_id,
                          required_field_label(t('admin.general_settings.recovery_currency')),
                          class: 'mb-2 block text-sm font-semibold text-slate-800' %>
              <div class="relative" data-controller="delta-select">
                <%= f.select :base_currency_id,
                             @currencies.map { |currency| ["#{currency.code} · #{currency.name}", currency.id] },
                             { include_blank: t('admin.general_settings.recovery_select') },
                             class: 'min-h-12 w-full rounded-xl border border-slate-300 bg-white px-4 text-sm',
                             aria: { required: true, invalid: @settings.errors[:base_currency].any?,
                                     describedby: validation_describedby(@settings, :base_currency) } %>
              </div>
              <%= error_message_for(@settings, :base_currency,
                                    label: t('admin.general_settings.recovery_currency')) %>
              <% if @currencies.empty? %>
                <p class="mt-2 text-xs font-medium text-rose-700"><%= t('admin.general_settings.recovery_no_currencies') %></p>
              <% end %>
            </div>
            <div class="min-w-0">
              <%= f.label :timezone,
                          required_field_label(t('admin.general_settings.recovery_timezone')),
                          class: 'mb-2 block text-sm font-semibold text-slate-800' %>
              <div class="relative" data-controller="delta-select">
                <%= f.select :timezone, OrganizationSetting::ONBOARDING_TIMEZONES.map { |zone| [zone, zone] },
                             { include_blank: t('admin.general_settings.recovery_select') },
                             class: 'min-h-12 w-full rounded-xl border border-slate-300 bg-white px-4 text-sm',
                             aria: { required: true, invalid: @settings.errors[:timezone].any?,
                                     describedby: validation_describedby(@settings, :timezone) } %>
              </div>
              <%= error_message_for(@settings, :timezone,
                                    label: t('admin.general_settings.recovery_timezone')) %>
            </div>
            <div class="min-w-0 sm:col-span-2">
              <%= f.label :payment_method,
                          required_field_label(t('admin.general_settings.recovery_payment_method')),
                          class: 'mb-2 block text-sm font-semibold text-slate-800' %>
              <div class="relative" data-controller="delta-select">
                <%= f.select :payment_method,
                             OrganizationSetting.payment_methods.keys.map { |method|
                               [t("admin.general_settings.recovery_payment_methods.#{method}"), method]
                             },
                             { include_blank: t('admin.general_settings.recovery_select') },
                             class: 'min-h-12 w-full rounded-xl border border-slate-300 bg-white px-4 text-sm',
                             aria: { required: true, invalid: @settings.errors[:payment_method].any?,
                                     describedby: validation_describedby(@settings, :payment_method) } %>
              </div>
              <%= error_message_for(@settings, :payment_method,
                                    label: t('admin.general_settings.recovery_payment_method')) %>
            </div>
          </div>
        <% else %>
          <%= hidden_field_tag :expected_settings_updated_at, @settings.updated_at.utc.iso8601(6) %>
        <% end %>
        <div class="max-w-sm">
          <% page_size_errors = @settings.errors[:default_table_page_size].any? %>
          <%= f.label :default_table_page_size,
                      required_field_label(t('admin.general_settings.field_label')),
                      class: 'mb-2 block text-sm font-semibold text-slate-800' %>
          <div class="relative" data-controller="delta-select">
            <%= f.select :default_table_page_size,
                         TablePagePreference::OPTIONS.map { |size| [t('admin.general_settings.option_label', count: size), size] },
                         { include_blank: page_size_errors && !TablePagePreference::OPTIONS.include?(@settings.default_table_page_size) },
                         class: "min-h-12 w-full rounded-xl border bg-white px-4 text-sm text-slate-800 focus:ring-2 #{page_size_errors ? 'input-field-error border-rose-500 focus:border-rose-500 focus:ring-rose-100' : 'border-slate-300 focus:border-emerald-500 focus:ring-emerald-100'}",
                         aria: { required: true, invalid: page_size_errors,
                                 describedby: validation_describedby(@settings, :default_table_page_size,
                                                                      'general_settings_page_size_help') },
                         data: { action: 'change->general-settings-preview#update',
                                 general_settings_preview_target: 'select' } %>
          </div>
          <%= error_message_for(@settings, :default_table_page_size) %>
          <p id="general_settings_page_size_help" class="mt-2 text-xs text-slate-500"><%= t('admin.general_settings.unit') %></p>
        </div>

        <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-4">
          <h3 class="text-sm font-bold text-slate-900"><%= t('admin.general_settings.explanation_title') %></h3>
          <div class="mt-3 space-y-2 text-sm leading-6 text-slate-600">
            <p><%= t('admin.general_settings.organization_rule') %></p>
            <p><%= t('admin.general_settings.user_rule') %></p>
            <p class="font-semibold"><%= t('admin.general_settings.precedence') %></p>
          </div>
        </div>

        <div class="flex flex-col gap-3 border-t border-slate-100 pt-5 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-xs font-medium text-slate-600" role="status" aria-live="polite"
             data-general-settings-preview-target="dirty">
            <%= @recovering_settings ? t('admin.general_settings.pending_changes') : t('admin.general_settings.no_changes') %>
          </p>
          <%= f.submit t(@recovering_settings ? 'admin.general_settings.recovery_save' : 'admin.general_settings.save'),
                       data: { turbo_submits_with: t('admin.general_settings.saving'),
                               general_settings_preview_target: 'save' },
                       class: 'inline-flex min-h-11 cursor-pointer items-center justify-center rounded-xl bg-emerald-700 px-6 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 disabled:cursor-not-allowed disabled:bg-slate-200 disabled:text-slate-500 disabled:shadow-none' %>
        </div>
      <% end %>
    </section>

    <aside class="min-w-0 self-start overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-5 py-5">
        <p class="font-jakarta text-sm font-bold text-slate-900"><%= t('admin.general_settings.preview_title') %></p>
        <p class="mt-1 text-xs leading-5 text-slate-500"><%= t('admin.general_settings.preview_subtitle') %></p>
      </div>
      <div class="p-5">
        <div class="overflow-hidden rounded-xl border border-slate-200">
          <div class="border-b border-slate-100 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-700">
            <%= t('admin.general_settings.example_table') %>
          </div>
          <div class="flex justify-between gap-4 px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-600">
            <span><%= t('admin.general_settings.example_column') %></span>
            <span><%= t('admin.general_settings.example_status') %></span>
          </div>
          <% 3.times do |index| %>
            <div class="flex justify-between gap-3 border-t border-slate-100 px-4 py-3 text-sm">
              <span class="flex items-center gap-2 text-slate-700">
                <span class="size-2 rounded-full bg-emerald-400"></span>
                <%= t('admin.general_settings.example_column') %> <%= index + 1 %>
              </span>
              <span class="rounded-lg bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700">
                <%= t('admin.general_settings.example_active') %>
              </span>
            </div>
          <% end %>
          <div class="border-t border-slate-100 bg-slate-50 px-4 py-3 text-xs text-slate-500"
               role="status" aria-live="polite" data-general-settings-preview-target="summary">
            <%= t('admin.general_settings.example_rows', count: @settings.default_table_page_size) %>
          </div>
        </div>
        <p class="mt-4 rounded-lg border border-slate-100 bg-slate-50 px-3 py-2 text-xs leading-5 text-slate-600">
          <%= t('admin.general_settings.preview_hint') %>
        </p>
      </div>
    </aside>
  </div>
</div>
