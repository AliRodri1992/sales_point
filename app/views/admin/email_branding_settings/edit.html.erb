<main class="mx-auto max-w-5xl space-y-5 px-4 pb-8 pt-4 sm:px-6 sm:pt-6" data-loading-scope="true">
  <header class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="min-w-0">
      <p class="text-xs font-bold uppercase tracking-widest text-emerald-700"><%= t('admin.email_templates.section') %></p>
      <h1 class="mt-1 font-jakarta text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"><%= t('admin.email_templates.branding') %></h1>
      <p class="mt-2 text-sm leading-6 text-slate-500"><%= t('admin.email_templates.branding_intro') %></p>
    </div>
    <%= link_to admin_email_templates_path, class: 'inline-flex min-h-11 items-center gap-2 self-start rounded-xl border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 hover:bg-slate-50' do %>
      <%= delta_icon('arrow-left', class: 'size-4') %>
      <%= t('admin.email_templates.back') %>
    <% end %>
  </header>

  <%= form_with model: @branding, url: admin_email_branding_settings_path, method: :patch, multipart: true,
                class: 'overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm' do |f| %>
    <%= hidden_field_tag :global, '1' if @branding.organization_id.nil? %>
    <% if @branding.errors.any? %>
      <div role="alert" class="m-5 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800">
        <p class="font-bold"><%= t('admin.email_templates.correct_errors') %></p>
        <ul class="mt-2 list-disc pl-5"><% @branding.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>
    <div class="border-b border-slate-100 px-5 py-4 sm:px-6">
      <h2 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.brand_identity_title') %></h2>
      <p class="mt-1 text-sm text-slate-500"><%= t('admin.email_templates.brand_identity_hint') %></p>
    </div>
    <div class="grid gap-5 px-5 py-5 sm:grid-cols-2 sm:px-6">
      <div class="sm:col-span-2">
        <%= f.label :display_name, t('admin.email_templates.settings_fields.display_name'), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
        <%= f.text_field :display_name, required: true, maxlength: 150, class: 'min-h-11 w-full rounded-xl border border-slate-300 px-4 text-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100' %>
        <%= error_message_for(@branding, :display_name) %>
      </div>
      <% %i[primary_color secondary_color button_color].each do |field| %>
        <div>
          <%= f.label field, t("admin.email_templates.settings_fields.#{field}"), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
          <%= f.text_field field, maxlength: 7, placeholder: '#047857', spellcheck: false,
                           class: 'min-h-11 w-full rounded-xl border border-slate-300 px-4 font-mono text-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100' %>
          <%= error_message_for(@branding, field) %>
        </div>
      <% end %>
      <div class="sm:col-span-2">
        <%= f.label :logo, t('admin.email_templates.settings_fields.logo'), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
        <%= f.file_field :logo, accept: 'image/png,image/jpeg,image/webp',
                         class: 'block min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm file:mr-3 file:rounded-lg file:border-0 file:bg-emerald-50 file:px-3 file:py-1 file:font-semibold file:text-emerald-800' %>
        <p class="mt-1.5 text-xs text-slate-500"><%= t('admin.email_templates.logo_hint') %></p>
        <%= error_message_for(@branding, :logo) %>
      </div>
    </div>
    <div class="border-y border-slate-100 bg-slate-50/60 px-5 py-4 sm:px-6">
      <h2 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.contact_links_title') %></h2>
      <p class="mt-1 text-sm text-slate-500"><%= t('admin.email_templates.contact_links_hint') %></p>
    </div>
    <div class="grid gap-5 px-5 py-5 sm:grid-cols-2 sm:px-6">
      <% %i[support_email support_url privacy_url].each do |field| %>
        <div class="<%= field == :privacy_url ? 'sm:col-span-2' : '' %>">
          <%= f.label field, t("admin.email_templates.settings_fields.#{field}"), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
          <%= f.text_field field, class: 'min-h-11 w-full rounded-xl border border-slate-300 px-4 text-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100' %>
          <%= error_message_for(@branding, field) %>
        </div>
      <% end %>
      <div class="sm:col-span-2">
        <%= f.label :footer_text, t('admin.email_templates.settings_fields.footer_text'), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
        <%= f.text_area :footer_text, rows: 3, class: 'w-full resize-y rounded-xl border border-slate-300 px-4 py-3 text-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100' %>
        <%= error_message_for(@branding, :footer_text) %>
      </div>
    </div>
    <footer class="flex justify-end border-t border-slate-100 bg-slate-50/70 px-5 py-4 sm:px-6">
      <%= f.submit t('admin.email_templates.save'),
                   class: 'min-h-11 cursor-pointer rounded-xl bg-emerald-700 px-5 text-sm font-semibold text-white hover:bg-emerald-800' %>
    </footer>
  <% end %>
  <%= render 'admin/email_setting_audits/history', audits: @audits %>
</main>
