<%= turbo_stream.update "product_modal", "" %>
<%= turbo_stream.update "products_list" do %>
  <%= render "list", products: @products, total_count: @total_count, total_pages: @total_pages %>
<% end %>
<turbo-stream action="swal" target="swal"><template><%= @swal_message %></template></turbo-stream>
