<% content_for :title, t('admin.products.index.title') %>
<div class="catalog-workspace">
<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="font-jakarta text-2xl font-bold text-slate-900">
      <%= t('admin.products.index.title') %>
    </h1>
    <p class="mt-1 text-sm text-slate-500">
      <%= t('admin.products.index.subtitle') %>
    </p>
  </div>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
    <% if policy(Product).create? %>
<%= link_to new_admin_product_path,
                data: { tooltip: t('admin.products.index.new') },
                class: 'inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-800' do %>
      <%= delta_icon('plus', class: 'size-4') %>
      <%= t('admin.products.index.new') %>
    <% end %>
<% end %>


  </div>
</div>

<nav class="catalog-nav" aria-label="<%= t('admin.catalog_design.commercial') %>"><% if policy(PriceList).index? %><%= link_to t('admin.catalog_design.price_lists'), admin_price_lists_path %><% end %><% if policy(Promotion).index? %><%= link_to t('admin.catalog_design.promotions'), admin_promotions_path %><% end %></nav>
<%= form_with url: admin_products_path, method: :get, class: 'products-filters', data: { turbo_frame: 'admin_products_list' } do %>
  <div class="products-filters__primary">
    <div class="products-filters__field">
      <%= label_tag :search, t('admin.catalog_design.search') %>
      <%= search_field_tag :search, params[:search], placeholder: t('admin.products.index.search_placeholder') %>
    </div>
    <div class="products-filters__field">
      <%= label_tag :status, t('admin.catalog_design.status') %>
      <%= select_tag :status, options_for_select([[t('admin.catalog_design.all_statuses'), 'all'], [t('admin.catalog_design.active'), 'active'], [t('admin.catalog_design.inactive'), 'inactive']], params[:status] || 'all') %>
    </div>
  </div>
  <% advanced_active = %i[category_id featured tracking_mode stock_status min_price max_price].any? { |key| params[key].present? && params[key] != 'all' } %>
  <details class="products-filters__advanced" <%= 'open' if advanced_active %>>
    <summary><%= delta_icon('adjustments-horizontal', class: 'size-4') %><%= t('admin.catalog_design.advanced_filters') %></summary>
    <div class="products-filters__grid">
      <div class="products-filters__field">
        <%= label_tag :category_id, t('admin.catalog_design.category_id') %>
        <%= select_tag :category_id, options_for_select([[t('admin.catalog_design.all_categories'), '']] + Category.not_deleted.order(:name).pluck(:name, :id), params[:category_id]), include_blank: false %>
      </div>
      <div class="products-filters__field">
        <%= label_tag :featured, t('admin.catalog_design.featured_filter') %>
        <%= select_tag :featured, options_for_select([[t('admin.catalog_design.all_options'), 'all'], [t('admin.catalog_design.yes_option'), 'true'], [t('admin.catalog_design.no_option'), 'false']], params[:featured] || 'all') %>
      </div>
      <div class="products-filters__field">
        <%= label_tag :tracking_mode, t('admin.catalog_design.tracking_mode') %>
        <%= select_tag :tracking_mode, options_for_select([[t('admin.catalog_design.all_options'), 'all']] + Product.tracking_modes.keys.map { |mode| [t("admin.catalog_design.tracking_#{mode}"), mode] }, params[:tracking_mode] || 'all') %>
      </div>
      <div class="products-filters__field">
        <%= label_tag :stock_status, t('admin.catalog_design.stock_status_filter') %>
        <%= select_tag :stock_status, options_for_select([[t('admin.catalog_design.all_options'), 'all'], [t('admin.catalog_design.stock_available'), 'available'], [t('admin.catalog_design.stock_out'), 'out'], [t('admin.catalog_design.stock_low'), 'low']], params[:stock_status] || 'all') %>
      </div>
      <div class="products-filters__field">
        <%= label_tag :min_price, t('admin.catalog_design.minimum_price') %>
        <%= number_field_tag :min_price, params[:min_price], min: 0, step: '0.01', inputmode: 'decimal' %>
      </div>
      <div class="products-filters__field">
        <%= label_tag :max_price, t('admin.catalog_design.maximum_price') %>
        <%= number_field_tag :max_price, params[:max_price], min: 0, step: '0.01', inputmode: 'decimal' %>
      </div>
    </div>
  </details>
  <div class="products-filters__actions">
    <%= link_to t('admin.catalog_design.clear'), admin_products_path, class: 'catalog-button', data: { turbo_frame: '_top' } %>
    <%= button_tag t('admin.catalog_design.filter'), type: :submit, class: 'catalog-button catalog-button-primary products-filters__apply' %>
  </div>
<% end %>
<div class="delta-skeleton-region" data-controller="skeleton-loading"
     data-skeleton-loading-region-value="admin_products_list" aria-busy="false"
     data-action="skeleton:begin@document->skeleton-loading#begin skeleton:end@document->skeleton-loading#finish turbo:before-fetch-request@document->skeleton-loading#turboStart turbo:frame-load@document->skeleton-loading#turboFinish turbo:fetch-request-error@document->skeleton-loading#turboError turbo:frame-missing@document->skeleton-loading#turboMissing turbo:before-cache@document->skeleton-loading#clear">
  <span class="sr-only" role="status" aria-live="polite" hidden data-skeleton-loading-target="status"><%= t('admin.action_loader.processing') %></span>
  <div class="delta-skeleton-region__progress" data-skeleton-loading-target="indicator" hidden aria-hidden="true"><span></span></div>
  <div data-skeleton-loading-target="content">
<%= turbo_frame_tag "admin_products_list" do %>
  <%= render "list", products: @products %>
<% end %>
  </div>
  <div data-skeleton-loading-target="placeholder" hidden>
    <%= render Ui::SkeletonComponent.new(variant: :table, rows: 6, columns: 8) %>
  </div>
  <div data-skeleton-loading-target="error" hidden role="alert"
       class="mt-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
    <span><%= t('admin.skeleton_loading.failed') %></span>
    <button type="button" data-action="skeleton-loading#retry"
            class="ml-2 font-semibold underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-rose-600"><%= t('admin.skeleton_loading.retry') %></button>
  </div>
</div>
</div>
