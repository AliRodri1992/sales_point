<% content_for :title, @product.name %>
<% product = @product %>
<header class="catalog-header"><div><p class="catalog-eyebrow"><%= t('admin.catalog_design.product_workspace') %></p><h1><%= product.name %></h1><p><%= product.code %><% if product.category %> · <%= product.category.name %><% end %></p></div><div class="catalog-actions"><%= link_to t('admin.catalog_design.back'), catalog_back_path(Product), class: 'catalog-button', data: { turbo_frame: '_top' } %><% if policy(Product).update? %><%= link_to t('admin.products.index.edit'), edit_admin_product_path(product), class: 'catalog-button catalog-button-primary', data: { turbo_frame: '_top' } %><% end %></div></header>
<dl class="catalog-summary"><div class="catalog-stat"><dt><%= t('admin.products.form.price') %></dt><dd><%= product_money(product.price) %></dd></div><div class="catalog-stat"><dt><%= t('admin.catalog_design.margin') %></dt><dd><%= product.gross_margin ? "#{number_with_precision(product.gross_margin, precision: 1)}%" : '—' %></dd></div><div class="catalog-stat"><dt><%= t('admin.products.form.status') %></dt><dd><%= catalog_status(product.active?) %></dd></div></dl>
<div class="catalog-layout"><div class="catalog-main">
<section class="catalog-card"><%= catalog_heading(t('admin.catalog_design.identity'), t('admin.catalog_design.product_identity_hint'), icon: 'cube') %><dl class="catalog-card-body catalog-definition">
<% { code: product.code, sku: product.sku, barcode: product.barcode, description: product.description, category: product.category&.name, sat_unit_key: product.sat_unit_key&.description, sat_tax: product.sat_tax&.name, cost: product.cost ? product_money(product.cost) : '—' }.each do |key, value| %><div><dt><%= t("admin.products.form.#{key}") %></dt><dd><%= value.presence || '—' %></dd></div><% end %>
</dl></section>
<% { variants: product.product_variants, presentations: product.product_presentations, barcodes: product.product_barcodes.includes(:product_variant, :product_presentation) }.each do |section, rows| %><section class="catalog-card"><%= catalog_heading(t("admin.catalog_design.#{section}"), t("admin.catalog_design.#{section}_hint"), icon: 'cube') %><div class="catalog-card-body"><% if rows.any? %><div class="grid gap-3 sm:grid-cols-2"><% rows.each do |row| %><div class="rounded-xl border border-slate-200 p-4"><p class="text-sm font-semibold"><%= section == :barcodes ? row.value : row.name %></p><p class="catalog-hint"><% if section == :variants %><%= [row.sku, *row.options.values].compact_blank.join(' · ') %><% elsif section == :presentations %><%= number_with_precision(row.units, precision: 6, strip_insignificant_zeros: true) %> <%= t('admin.catalog_design.base_units') %><% else %><%= [row.symbology.upcase, row.product_variant&.name, row.product_presentation&.name].compact.join(' · ') %><% end %></p><% if row.respond_to?(:active?) %><div class="mt-2"><%= catalog_status(row.active?) %></div><% end %></div><% end %></div><% else %><p class="catalog-hint"><%= t('admin.catalog_design.no_configuration') %></p><% end %></div></section><% end %>
<% supplier_offers = product.supplier_products.available.joins(:supplier, :currency).merge(Supplier.available).merge(Currency.active).includes(:supplier, :currency).select { |offer| policy(offer.supplier).view_products? } %>
<section class="catalog-card"><%= catalog_heading(t('admin.procurement.title'), t('admin.catalog_design.supplier_offers_hint'), icon: 'truck') %><div class="catalog-card-body"><% if supplier_offers.empty? %><p class="catalog-hint"><%= t('admin.procurement.empty') %></p><% end %><% supplier_offers.each do |offer| %><div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 py-4 text-sm"><div><strong><%= offer.supplier.name %></strong><p class="catalog-hint"><%= offer.presentation_name %> · <%= offer.unit_cost %> <%= offer.currency.code %> / <%= t('admin.procurement.product') %></p></div><%= link_to t('admin.procurement.compare'), admin_supplier_product_comparison_path(offer.supplier, product_id: product.id), class: 'catalog-button', data: { turbo_frame: '_top' } %></div><% end %></div></section>
<section class="catalog-card"><%= catalog_heading(t('admin.catalog_design.price_history'), t('admin.catalog_design.price_approval_hint'), icon: 'clock') %><div class="catalog-card-body"><% events = @price_history %><% if events.any? %><ol class="divide-y divide-slate-100"><% events.each do |event| %><li class="py-4"><div class="flex flex-wrap justify-between gap-2"><strong class="text-sm"><%= number_to_currency(event.previous_price || 0) %> → <%= number_to_currency(event.new_price) %> <%= event.currency %></strong><span class="catalog-status"><%= t("admin.catalog_design.#{event.status}") %></span></div><p class="catalog-hint"><%= event.reason %></p><p class="catalog-hint"><%= t('admin.catalog_design.requested_by') %>: <%= event.actor.display_name %> · <%= l(event.created_at, format: :short) %></p><% if event.approved_by %><p class="catalog-hint"><%= t('admin.catalog_design.reviewed_by') %>: <%= event.approved_by.display_name %> · <%= event.approved_at ? l(event.approved_at, format: :short) : '—' %></p><% end %><% if current_user.admin? && event.pending? %><div class="catalog-actions mt-3"><% %w[approved rejected].each do |decision| %><%= button_to t("admin.catalog_design.#{decision == 'approved' ? 'approve' : 'reject'}"), admin_price_change_event_path(event, decision: decision), method: :patch, class: 'catalog-button', data: { turbo_frame: '_top' } %><% end %></div><% end %></li><% end %></ol><%= render 'admin/shared/table_pagination', table_key: 'product_price_history' %><% else %><p class="catalog-hint"><%= t('admin.catalog_design.no_price_history') %></p><% end %></div></section>
</div><aside class="catalog-aside"><section class="catalog-card catalog-card-body"><div class="catalog-media"><% if product.image.attached? %><%= image_tag product.image, alt: product.name %><% else %><%= delta_icon('photo', class: 'size-12 text-slate-300') %><% end %></div></section>
<section class="catalog-card catalog-card-body"><h2><%= t('admin.catalog_design.commercial') %></h2><p><%= t('admin.catalog_design.commercial_hint') %></p><div class="mt-4 grid gap-2"><% if policy(PriceList).index? %><%= link_to t('admin.catalog_design.price_lists'), admin_price_lists_path, class: 'catalog-button', data: { turbo_frame: '_top' } %><% end %><% if policy(Promotion).index? %><%= link_to t('admin.catalog_design.promotions'), admin_promotions_path, class: 'catalog-button', data: { turbo_frame: '_top' } %><% end %></div></section>
<section class="catalog-card catalog-card-body" data-controller="product-quote" data-product-quote-url-value="<%= quote_admin_product_path(product) %>"><h2><%= t('admin.catalog_design.price_preview') %></h2><p><%= t('admin.catalog_design.price_preview_hint') %></p><div class="catalog-field mt-4"><label for="quote-quantity"><%= t('admin.catalog_design.quantity') %></label><input id="quote-quantity" type="number" min="0.000001" max="1000000" step="0.000001" value="1" data-product-quote-target="quantity"></div><% { variant: product.product_variants.active, presentation: product.product_presentations.active, priceList: current_organization.price_lists.active.effective_at(Time.current) }.each do |target, records| %><div class="catalog-field mt-3"><label for="quote-<%= target %>"><%= t({ variant: 'admin.catalog_design.product_variant_id', presentation: 'admin.catalog_design.product_presentation_id', priceList: 'admin.catalog_design.price_lists' }.fetch(target)) %></label><%= select_tag target, options_for_select(records.map { |record| [record.respond_to?(:customer_segment) && record.customer_segment.present? ? "#{record.name} (#{record.customer_segment})" : record.name, record.id] }), include_blank: true, id: "quote-#{target}", data: { product_quote_target: target } %></div><% end %><div class="catalog-field mt-3"><label for="quote-segment"><%= t('admin.catalog_design.customer_segment') %></label><input id="quote-segment" maxlength="100" data-product-quote-target="segment"></div><button type="button" class="catalog-button mt-3" data-action="product-quote#calculate"><%= t('admin.catalog_design.calculate') %></button><p role="status" aria-live="polite" data-product-quote-target="result" data-error="<%= t('admin.catalog_design.invalid_quote') %>"></p></section>
</aside></div>
