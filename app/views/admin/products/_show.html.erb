<% product = @product %>
<div class="w-full max-w-6xl rounded-2xl border border-slate-200 bg-white shadow-xl">
  <div class="flex items-center justify-between border-b border-slate-100 px-6 py-4">
    <div>
      <h2 id="product-show-title" class="font-jakarta text-lg font-bold text-slate-900">
        <%= t('admin.products.show.title') %>
      </h2>
      <p class="mt-0.5 text-sm text-slate-500">
        <%= t('admin.products.show.subtitle') %>
      </p>
    </div>
    <%= link_to t('admin.products.show.back'),
                admin_products_path,
                data: { turbo: false },
                class: 'inline-flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition' %>
  </div>

    <dl class="divide-y divide-slate-100 px-6">
      <div class="flex items-center justify-between gap-4 py-4">
        <dt class="text-sm font-semibold text-slate-500"><%= t('admin.products.form.code') %></dt>
        <dd>
          <code class="rounded-md bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600"><%= product.code %></code>
        </dd>
      </div>
      <div class="flex items-center justify-between gap-4 py-4">
        <dt class="text-sm font-semibold text-slate-500"><%= t('admin.products.form.name') %></dt>
        <dd class="text-sm font-medium text-slate-900"><%= product.name %></dd>
      </div>
      <% if product.description.present? %>
        <div class="flex items-center justify-between gap-4 py-4">
          <dt class="text-sm font-semibold text-slate-500"><%= t('admin.products.form.description') %></dt>
          <dd class="text-sm text-slate-700"><%= product.description %></dd>
        </div>
      <% end %>
      <div class="flex items-center justify-between gap-4 py-4">
        <dt class="text-sm font-semibold text-slate-500"><%= t('admin.products.form.price') %></dt>
        <dd class="text-sm font-medium text-slate-900"><%= number_to_currency(product.price) %></dd>
      </div>
      <div class="flex items-center justify-between gap-4 py-4">
        <dt class="text-sm font-semibold text-slate-500"><%= t('admin.products.form.cost') %></dt>
        <dd class="text-sm font-medium text-slate-900"><%= number_to_currency(product.cost) %></dd>
      </div>

      <div class="flex items-center justify-between gap-4 py-4">
        <dt class="text-sm font-semibold text-slate-500"><%= t('admin.products.form.image') %></dt>
        <dd class="text-sm font-medium text-slate-900">
          <% if product.image.attached? %>
            <%= image_tag product.image.variant(resize_to_limit: [200, 200]), class: 'h-20 w-20 rounded-lg object-cover' %>
          <% else %>
            <span class="text-slate-400 text-sm"><%= t('admin.products.show.no_image') %></span>
          <% end %>
        </dd>
      </div>


      <% if product.barcode.present? %>
        <div class="flex items-center justify-between gap-4 py-4">
          <dt class="text-sm font-semibold text-slate-500"><%= t('admin.products.form.barcode') %></dt>
          <dd class="text-sm font-medium text-slate-900"><%= product.barcode %></dd>
        </div>
      <% end %>
      <% if product.sku.present? %>
        <div class="flex items-center justify-between gap-4 py-4">
          <dt class="text-sm font-semibold text-slate-500"><%= t('admin.products.form.sku') %></dt>
          <dd class="text-sm font-medium text-slate-900"><%= product.sku %></dd>
        </div>
      <% end %>
      <% if product.category_id.present? %>
        <div class="flex items-center justify-between gap-4 py-4">
          <dt class="text-sm font-semibold text-slate-500"><%= t('admin.products.form.category') %></dt>
          <dd class="text-sm font-medium text-slate-900"><%= product.category.name %></dd>
        </div>
      <% end %>
      <% if product.sat_unit_key_id.present? %>
        <div class="flex items-center justify-between gap-4 py-4">
          <dt class="text-sm font-semibold text-slate-500"><%= t('admin.products.form.sat_unit_key') %></dt>
          <dd class="text-sm font-medium text-slate-900"><%= product.sat_unit_key.to_label %></dd>
        </div>
      <% end %>
      <% if product.sat_tax_id.present? %>
        <div class="flex items-center justify-between gap-4 py-4">
          <dt class="text-sm font-semibold text-slate-500"><%= t('admin.products.form.sat_tax') %></dt>
          <dd class="text-sm font-medium text-slate-900"><%= product.sat_tax.name %></dd>
        </div>
      <% end %>
      <div class="flex items-center justify-between gap-4 py-4">
        <dt class="text-sm font-semibold text-slate-500"><%= t('admin.products.form.featured') %></dt>
        <dd>
          <% if product.featured? %>
            <span class="inline-flex items-center rounded-full px-2 py-1 text-[11px] font-semibold bg-amber-100 text-amber-800">
              <%= t('admin.products.index.columns.featured') %>
            </span>
          <% else %>
            <span class="text-slate-400 text-sm"><%= t('admin.products.index.filters.all_featured') %></span>
          <% end %>
        </dd>
      </div>
      <div class="flex items-center justify-between gap-4 py-4">
        <dt class="text-sm font-semibold text-slate-500"><%= t('admin.products.form.position') %></dt>
        <dd class="text-sm font-medium text-slate-900"><%= product.position || 0 %></dd>
      </div>
      <div class="flex items-center justify-between gap-4 py-4">
        <dt class="text-sm font-semibold text-slate-500"><%= t('admin.products.form.status') %></dt>
        <dd>
          <span class="inline-flex rounded-full px-2 py-1 text-[11px] font-semibold
            <%= product.active? ? 'bg-emerald-50 text-emerald-600' : 'bg-slate-100 text-slate-500' %>">
            <%= t("admin.products.statuses.#{product.status}") %>
          </span>
        </dd>
      </div>
    </dl>

    <% if current_organization && product.organization_id == current_organization.id %>
      <% supplier_offers = product.supplier_products.available.includes(:supplier, :currency) %>
      <section class="border-t border-slate-100 px-6 py-5">
        <h3 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.procurement.title') %></h3>
        <% supplier_offers.each do |offer| %>
          <% if policy(offer.supplier).view_products? %>
            <div class="mt-3 flex flex-wrap items-center justify-between gap-3 rounded-xl bg-slate-50 p-3 text-sm">
              <span><%= offer.supplier.name %> · <%= offer.presentation_name %></span>
              <span><%= offer.unit_cost %> <%= offer.currency.code %> / <%= t('admin.procurement.product') %></span>
              <%= link_to t('admin.procurement.compare'),
                          admin_supplier_product_comparison_path(offer.supplier, product_id: product.id),
                          class: 'font-semibold text-emerald-700 hover:underline' %>
            </div>
          <% end %>
        <% end %>
        <% if supplier_offers.empty? %><p class="mt-3 text-sm text-slate-500"><%= t('admin.procurement.empty') %></p><% end %>
      </section>
    <% end %>

    <div class="flex items-center justify-end gap-2 border-t border-slate-100 px-6 py-4">
      <%= link_to edit_admin_product_path(product),
                  data: { turbo: false },
                  class: 'inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700' do %>
        <%= icon('pencil-square', class: 'size-4') %>
        <%= t('admin.products.index.edit') %>
      <% end %>
    </div>
  </div>