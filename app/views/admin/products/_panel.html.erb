<% content_for :title, @product.persisted? ? t('admin.products.edit.label') : t('admin.products.new.title') %>
<div class="catalog-workspace products-v9-workspace products-e-workspace">
  <header class="catalog-header products-v9-header products-e-page-header">
    <div class="products-v9-heading">
      <span class="products-v9-heading-icon" aria-hidden="true"><%= delta_icon('cube', class: 'size-6') %></span>
      <div>
        <p class="catalog-eyebrow"><%= t('admin.catalog_design.product_workspace') %></p>
        <h1><%= @product.persisted? ? t('admin.products.edit.label') : t('admin.products.new.title') %></h1>
        <p><%= t('admin.catalog_design.product_intro') %></p>
      </div>
    </div>
    <%= link_to catalog_back_path(Product), class: 'catalog-button products-v9-back',
                data: { turbo_frame: '_top' } do %>
      <%= delta_icon('arrow-left', class: 'size-4', aria: { hidden: true }) %>
      <%= t('admin.catalog_design.back') %>
    <% end %>
  </header>
  <%= render 'form', product: @product %>
</div>
