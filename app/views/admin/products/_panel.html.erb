<% product = @product %>
<div
  data-modal-target="panel"
  role="dialog"
  aria-modal="true"
  aria-labelledby="product-panel-title"
  class="relative w-full max-w-5xl rounded-2xl border border-slate-200 bg-white shadow-xl"
>
  <%# Breadcrumbs for modal context %>
  <nav aria-label="breadcrumb" class="border-b border-slate-100 bg-white">
    <ol class="mx-auto flex h-10 items-center gap-1.5 px-4 text-sm lg:px-6">
      <li class="flex min-w-0 items-center gap-1.5">
        <span class="text-slate-300" aria-hidden="true">/</span>
        <%= link_to t('admin.breadcrumbs.home'), admin_dashboard_path, class: "truncate text-slate-500 transition hover:text-slate-800" %>
      </li>
      <li class="flex min-w-0 items-center gap-1.5">
        <span class="text-slate-300" aria-hidden="true">/</span>
        <%= link_to t('admin.products.index.title'), admin_products_path, class: "truncate text-slate-500 transition hover:text-slate-800" %>
      </li>
      <li class="flex min-w-0 items-center gap-1.5">
        <span class="text-slate-300" aria-hidden="true">/</span>
        <span class="truncate font-medium text-slate-800" aria-current="page">
          <%= product.persisted? ? product.name : t('admin.products.new.title') %>
        </span>
      </li>
    </ol>
  </nav>

  <div class="flex items-center justify-between border-b border-slate-100 px-6 py-4">
    <div>
      <h2 id="product-panel-title" class="font-jakarta text-lg font-bold text-slate-900">
        <%= product.persisted? ? t('admin.products.edit.title', name: product.name) : t('admin.products.new.title') %>
      </h2>
      <p class="mt-0.5 text-sm text-slate-500">
        <%= product.persisted? ? t('admin.products.edit.subtitle') : t('admin.products.new.subtitle') %>
      </p>
    </div>

    <%= link_to admin_products_path,
                class: "inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-sm font-semibold text-slate-600 transition hover:bg-slate-50",
                data: { turbo_frame: 'products_list' } do %>
      <%= icon("chevron-left", class: "size-4") %>
      <%= t('admin.products.form.back') %>
    <% end %>
  </div>

  <div class="px-6 py-6">
    <%= render 'form', product: product %>
  </div>
</div>