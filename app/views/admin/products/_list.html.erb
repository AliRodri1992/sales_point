<%# Counts can also be supplied by a streamed update. %>
<% total_count = local_assigns[:total_count] || @total_count || 0 %>
<% total_pages = local_assigns[:total_pages] || @total_pages || 1 %>
<% product_rows = products.to_a %>
<% stock_totals = Inventory.where(organization_id: current_organization&.id, product_id: product_rows.map(&:id)).group(:product_id).sum(:stock) %>
<% filtered = request.query_parameters.slice('search', 'status', 'category_id', 'featured', 'tracking_mode', 'stock_status', 'min_price', 'max_price').values.any? { |value| value.present? && value != 'all' } %>

<section class="catalog-list-directory products-directory" aria-labelledby="products-directory-title">
  <header class="catalog-list-directory-heading">
    <div>
      <h2 id="products-directory-title"><%= t('admin.products.index.card_title') %></h2>
      <p aria-live="polite"><%= t('admin.products.index.total_count', count: total_count) %></p>
    </div>
    <% if product_rows.any? %>
      <span class="catalog-list-page-count"><%= t('admin.catalog_directory.showing', count: product_rows.size) %></span>
    <% end %>
    <%= render 'admin/shared/catalog_mobile_sort', frame: '_top', columns: {
          'products.name' => t('admin.products.index.columns.name'), 'products.code' => t('admin.products.index.columns.code'),
          'products.price' => t('admin.products.index.columns.price'),
          'products.stock' => t('admin.products.index.columns.stock'),
          'products.status' => t('admin.products.index.columns.status') } %>
  </header>

  <% if product_rows.any? %>
    <div class="catalog-list-desktop-table">
      <table class="catalog-list-table">
        <caption class="sr-only"><%= t('admin.products.index.card_title') %></caption>
        <thead>
          <tr>
            <th scope="col" aria-sort="<%= product_sort_state('products.name') %>"><%= product_sort_link('products.name', t('activerecord.models.product')) %></th>
            <th scope="col" class="catalog-list-numeric" aria-sort="<%= product_sort_state('products.price') %>"><%= product_sort_link('products.price', t('admin.products.index.columns.price')) %></th>
            <th scope="col" class="catalog-list-numeric" aria-sort="<%= product_sort_state('products.stock') %>"><%= product_sort_link('products.stock', t('admin.products.index.columns.stock')) %></th>
            <th scope="col" aria-sort="<%= product_sort_state('products.status') %>"><%= product_sort_link('products.status', t('admin.products.index.columns.status')) %></th>
            <th scope="col" class="catalog-list-actions-heading"><%= t('admin.products.index.columns.actions') %></th>
          </tr>
        </thead>
        <tbody>
          <% product_rows.each do |product| %>
            <tr>
              <td><%= render 'listing_identity', product: product %></td>
              <td class="catalog-list-numeric"><%= product_money(product.price) %></td>
              <td class="catalog-list-numeric"><%= number_with_precision(stock_totals.fetch(product.id, 0), strip_insignificant_zeros: true, precision: 3) %></td>
              <td><span class="catalog-list-status <%= 'catalog-list-status--inactive' unless product.active? %>"><%= t("admin.products.statuses.#{product.status}") %></span></td>
              <td><%= render 'row_actions', product: product %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <ul class="catalog-list-mobile-list" aria-label="<%= t('admin.products.index.card_title') %>">
      <% product_rows.each do |product| %>
        <li class="catalog-list-mobile-card">
          <div class="catalog-list-mobile-card-heading">
            <%= render 'listing_identity', product: product %>
            <span class="catalog-list-status <%= 'catalog-list-status--inactive' unless product.active? %>"><%= t("admin.products.statuses.#{product.status}") %></span>
          </div>
          <dl class="catalog-list-mobile-facts">
            <div><dt><%= t('admin.products.index.columns.price') %></dt><dd><%= product_money(product.price) %></dd></div>
            <div><dt><%= t('admin.products.index.columns.stock') %></dt><dd><%= number_with_precision(stock_totals.fetch(product.id, 0), strip_insignificant_zeros: true, precision: 3) %></dd></div>
          </dl>
          <%= render 'row_actions', product: product %>
        </li>
      <% end %>
    </ul>
    <%= render 'admin/shared/catalog_pagination', key: 'products', total_pages: total_pages,
               per_page_label: t('admin.products.index.pagination.per_page_label'), frame: '_top' %>
  <% else %>
    <div class="catalog-list-empty-state">
      <div class="catalog-list-empty-icon" aria-hidden="true"><%= delta_icon('cube', class: 'size-7') %></div>
      <h3><%= t(filtered ? 'admin.catalog_design.no_results' : 'admin.products.index.empty_title') %></h3>
      <p><%= t('admin.products.index.empty_subtitle') %></p>
      <% if filtered %>
        <%= link_to t('admin.catalog_design.product_clear_all'), admin_products_path,
                    class: 'catalog-list-secondary-button', data: { turbo_frame: '_top' } %>
      <% end %>
    </div>
  <% end %>
</section>
