<% content_for :title, t('admin.onboarding_ui.title') %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<section class="onboarding-page" aria-labelledby="onboarding-title" data-controller="onboarding"
  data-action="input->onboarding#changed change->onboarding#changed focusout->onboarding#blur international-phone:validated->onboarding#phoneReady turbo:before-visit@document->onboarding#beforeVisit beforeunload@window->onboarding#beforeUnload"
  data-onboarding-error-value="<%= @onboarding_error %>"
  data-onboarding-copy-value="<%= t('admin.onboarding_ui.client').to_json %>">
  <header class="onboarding-header">
    <div>
      <p class="onboarding-eyebrow"><%= t('admin.onboarding.eyebrow') %></p>
      <h1 id="onboarding-title"><%= t('admin.onboarding_ui.title') %></h1>
      <p class="onboarding-intro"><%= t('admin.onboarding_ui.description') %></p>
      <%= link_to t('admin.onboarding_ui.back_dashboard'), admin_dashboard_path, class: 'onboarding-text-link' %>
    </div>
    <div class="onboarding-progress">
      <div class="flex items-center justify-between gap-4"><span><%= t('admin.onboarding.overall') %></span><strong><%= @progress[:percentage] %>%</strong></div>
      <div class="onboarding-progress-track" role="progressbar" aria-label="<%= t('admin.onboarding.overall') %>" aria-valuenow="<%= @progress[:percentage] %>" aria-valuemin="0" aria-valuemax="100"><span style="width:<%= @progress[:percentage] %>%"></span></div>
      <p><%= t('admin.onboarding_ui.progress_help') %></p>
    </div>
  </header>

  <nav class="onboarding-desktop-steps" aria-label="<%= t('admin.onboarding_ui.steps_label') %>"><%= render 'steps' %></nav>
  <details class="onboarding-mobile-steps">
    <summary><span><%= t('admin.onboarding_ui.current_step', number: @step) %> · <strong><%= t("admin.onboarding.steps.#{@step}.title") %></strong></span><span aria-hidden="true">⌄</span></summary>
    <nav aria-label="<%= t('admin.onboarding_ui.steps_label') %>"><%= render 'steps' %></nav>
  </details>

  <section class="onboarding-card" aria-labelledby="onboarding-step-title">
    <header class="onboarding-card-header">
      <p class="onboarding-eyebrow"><%= t('admin.onboarding_ui.current_step', number: @step) %></p>
      <h2 id="onboarding-step-title" tabindex="-1"><%= onboarding_current_title(@step) %></h2>
      <p><%= @step == 5 ? t('admin.onboarding_ui.review_help') : @step == 3 ? t('admin.onboarding_ui.terminal_intro') : t("admin.onboarding.steps.#{@step}.help") %></p>
    </header>
    <% if @onboarding_error %>
      <div class="onboarding-feedback" role="alert" tabindex="-1" data-onboarding-target="feedback"><%= @onboarding_error %></div>
    <% else %>
      <div class="onboarding-feedback hidden" role="alert" tabindex="-1" data-onboarding-target="feedback"></div>
    <% end %>

    <% if @step == 3 && @terminals.empty? %>
      <%= render 'terminal_recovery' %>
    <% else %>
      <% if @step == 5 && @employees.empty? %><%= render 'team_recovery' %><% end %>
      <%= form_with url: admin_onboarding_path(step: @step), method: :patch, id: 'onboarding-form',
        html: { novalidate: true }, data: { onboarding_target: 'form', action: 'submit->onboarding#submit turbo:submit-start->onboarding#submitStart turbo:submit-end->onboarding#submitEnd turbo:before-fetch-response->onboarding#beforeResponse turbo:fetch-request-error->onboarding#requestError' } do |form| %>
        <% if @step < 5 %><p class="onboarding-required-note"><%= t('admin.onboarding_ui.required_help') %></p><% end %>
        <%= render "step_#{@step}", form: %>
        <div class="onboarding-actions">
          <%= link_to t('admin.onboarding.back'), @step == 1 ? admin_dashboard_path : admin_onboarding_path(step: @step - 1), class: 'onboarding-secondary' %>
          <div class="onboarding-forward-actions">
            <% if @step < 5 %><%= form.button t('admin.onboarding_ui.save_exit'), name: 'destination', value: 'dashboard', class: 'onboarding-secondary', data: { turbo_submits_with: t('admin.onboarding_ui.saving') } %><% end %>
            <%= form.button @step == 5 ? t('admin.onboarding.finish') : t('admin.onboarding_ui.save_continue'), class: 'onboarding-primary', data: { turbo_submits_with: t('admin.onboarding_ui.saving') } %>
          </div>
        </div>
      <% end %>
    <% end %>
  </section>

  <footer class="onboarding-local-footer">
    <p><%= t('admin.onboarding_ui.footer_help') %></p>
    <details>
      <summary><%= t('admin.onboarding_ui.other_actions') %></summary>
      <p><%= t('admin.onboarding_ui.reset_help') %></p>
      <%= button_to t('admin.onboarding.reset_button'), admin_onboarding_reset_path, method: :patch,
        data: { turbo_confirm: t('admin.onboarding_ui.reset_confirm') }, class: 'onboarding-secondary' %>
    </details>
  </footer>
</section>
