<% content_for :title, t(".title") %>

<div class="space-y-6">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-emerald-600"><%= t(".eyebrow") %></p>
      <h1 class="mt-1 font-jakarta text-2xl font-extrabold text-slate-900"><%= t(".title") %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= t(".description") %></p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
      <p class="text-xs font-medium text-slate-500"><%= t(".overall") %></p>
      <p class="mt-1 text-2xl font-extrabold text-emerald-600"><%= @progress[:percentage] %>%</p>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% @progress[:sections].each do |section| %>
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="font-jakarta text-sm font-bold text-slate-900"><%= t(".sections.#{section[:key]}.title") %></h2>
            <p class="mt-1 text-xs text-slate-500"><%= t(".sections.#{section[:key]}.description") %></p>
          </div>
          <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-slate-500">
            <%= t(".statuses.#{section[:status]}") %>
          </span>
        </div>
        <div class="mt-5 h-2 overflow-hidden rounded-full bg-slate-100">
          <div class="h-full rounded-full bg-emerald-500" style="width: <%= section[:percentage] %>%"></div>
        </div>
        <p class="mt-2 text-right text-xs font-semibold text-slate-500"><%= section[:percentage] %>%</p>
      </article>
    <% end %>
  </div>

  <div class="rounded-2xl border border-emerald-100 bg-emerald-50/60 p-5">
    <p class="text-sm font-semibold text-emerald-900"><%= t(".non_blocking.title") %></p>
    <p class="mt-1 text-xs leading-relaxed text-emerald-800"><%= t(".non_blocking.description") %></p>
  </div>
</div>