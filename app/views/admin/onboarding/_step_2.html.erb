<%= fields_for :branch, @branch do |fields| %>
  <div class="onboarding-field-grid">
    <%= render 'field', form: fields, attribute: :name, label: t('admin.onboarding.fields.branch_name'), autocomplete: 'organization' %>
    <% phone = @branch.phones.find { |item| item.kind == 'mobile' && item.primary? && !item.deleted_at } || @branch.phones.build(kind: 'mobile', primary: true) %>
    <%= fields.fields_for :phones, [phone] do |phone_fields| %>
      <% label = t('admin.phones.primary_mobile') %>
      <% options = onboarding_field_options(phone_fields, :number, label:, required: phone.persisted?) %>
      <% options[:data].merge!(international_phone_target: 'input', country_code: phone.country_code.presence || 'MX') %>
      <div class="onboarding-field">
        <%= phone_fields.hidden_field :id if phone.persisted? %><%= phone_fields.hidden_field :kind %><%= phone_fields.hidden_field :primary %><%= phone_fields.hidden_field :country_code %>
        <%= phone_fields.label :number, phone.persisted? ? required_field_label(label) : label, for: options[:id] %>
        <div data-controller="international-phone"><%= phone_fields.telephone_field :number, **options, autocomplete: 'tel' %></div>
        <p class="onboarding-field-hint"><%= t('admin.onboarding_ui.phone_help') %></p>
        <%= render 'field_errors', object: phone, attribute: :number, label:, id: "#{options[:id]}_error" %>
      </div>
    <% end %>
  </div>
  <%= fields.fields_for :address do |address| %>
    <% country_required = Addresses::CountryRules.new(address.object.country&.iso_alpha2).required_fields %>
    <fieldset class="onboarding-fieldset" data-onboarding-target="address">
      <legend><%= t('admin.onboarding_ui.address_title') %></legend>
      <p class="onboarding-field-hint"><%= t('admin.onboarding_ui.address_help') %></p>
      <div class="onboarding-field-grid" data-controller="supplier-country-fields supplier-postal-assist"
           data-action="input->supplier-country-fields#rememberDraft input->supplier-postal-assist#input change->supplier-country-fields#update change->supplier-postal-assist#input"
           data-supplier-country-fields-state-required-codes-value="<%= Addresses::CountryRules::STATE_REQUIRED.to_json %>"
           data-supplier-postal-assist-url-value="<%= postal_suggestions_admin_branches_path %>"
           data-supplier-postal-assist-choice-placeholder-value="<%= t('admin.supplier_details.postal_choose_neighborhood') %>"
           data-supplier-postal-assist-loading-value="<%= t('admin.supplier_details.address_form.postal_loading') %>"
           data-supplier-postal-assist-available-value="<%= t('admin.supplier_details.address_form.postal_available') %>"
           data-supplier-postal-assist-not-found-value="<%= t('admin.supplier_details.address_form.postal_not_found') %>"
           data-supplier-postal-assist-unavailable-value="<%= t('admin.supplier_details.address_form.postal_unavailable') %>">
        <%= render 'field', form: address, attribute: :country_id, error_attribute: :country, label: t('admin.onboarding.fields.country'), collection: onboarding_countries, data: { supplier_postal_field: 'country_id' } %>
        <% %i[postal_code state city neighborhood street exterior_number interior_number].each do |attribute| %>
          <% localized = %i[postal_code state city neighborhood].include?(attribute) %>
          <% labels = localized ? %i[mx other].index_with { |kind| t("admin.supplier_details.address_form.country_labels.#{attribute}.#{kind}") } : nil %>
          <% label = labels ? labels[address.object.country&.iso_alpha2 == 'MX' ? :mx : :other] : t("admin.onboarding.fields.#{attribute}") %>
          <% wrapper = attribute == :postal_code ? { 'data-country-postal-wrapper' => true } : attribute == :neighborhood ? { 'data-address-field' => 'neighborhood' } : {} %>
          <%= render 'field', form: address, attribute:, label:, country_labels: labels, wrapper_data: wrapper,
                     required: %i[street city].include?(attribute) || country_required.include?(attribute),
                     data: { supplier_postal_field: attribute }, postal_assist: true %>
        <% end %>
      </div>
    </fieldset>
  <% end %>
  <label class="onboarding-checkbox-label"><%= fields.check_box :status %><span><strong><%= t('admin.onboarding_ui.active_branch') %></strong><small><%= t('admin.onboarding_ui.active_branch_help') %></small></span></label>
<% end %>
