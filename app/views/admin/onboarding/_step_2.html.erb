<%= fields_for :branch, @branch do |fields| %>
  <div class="onboarding-field-grid">
    <%= render 'field', form: fields, attribute: :name, label: t('admin.onboarding.fields.branch_name'), autocomplete: 'organization' %>
    <% phone = @branch.phones.find { |item| item.kind == 'mobile' && item.primary? && !item.deleted_at } || @branch.phones.build(kind: 'mobile', primary: true) %>
    <%= fields.fields_for :phones, [phone] do |phone_fields| %>
      <% label = t('admin.phones.primary_mobile') %>
      <% options = onboarding_field_options(phone_fields, :number, label:, required: phone.persisted?) %>
      <% options[:data].merge!(international_phone_target: 'input', country_code: phone.country_code.presence || 'MX') %>
      <div class="onboarding-field">
        <%= phone_fields.hidden_field :id if phone.persisted? %><%= phone_fields.hidden_field :kind %><%= phone_fields.hidden_field :primary %><%= phone_fields.hidden_field :country_code %>
        <%= phone_fields.label :number, label %>
        <div data-controller="international-phone"><%= phone_fields.telephone_field :number, **options, autocomplete: 'tel' %></div>
        <p class="onboarding-field-hint"><%= t('admin.onboarding_ui.phone_help') %></p>
        <%= render 'field_errors', object: phone, attribute: :number, label:, id: "#{options[:id]}_error" %>
      </div>
    <% end %>
  </div>
  <%= fields.fields_for :address do |address| %>
    <fieldset class="onboarding-fieldset" data-onboarding-target="address">
      <legend><%= t('admin.onboarding_ui.address_title') %></legend>
      <p class="onboarding-field-hint"><%= t('admin.onboarding_ui.address_help') %></p>
      <div class="onboarding-field-grid">
        <%= render 'field', form: address, attribute: :country_id, error_attribute: :country, label: t('admin.onboarding.fields.country'), collection: onboarding_countries %>
        <%= render 'field', form: address, attribute: :postal_code, label: t('admin.onboarding.fields.postal_code'), autocomplete: 'postal-code', required: false %>
        <%= render 'field', form: address, attribute: :street, label: t('admin.onboarding.fields.street'), autocomplete: 'address-line1' %>
        <% %i[exterior_number interior_number neighborhood city state].each do |attribute| %>
          <%= render 'field', form: address, attribute:, label: t("admin.onboarding.fields.#{attribute}"), required: attribute == :city %>
        <% end %>
      </div>
    </fieldset>
  <% end %>
  <label class="onboarding-checkbox-label"><%= fields.check_box :status %><span><strong><%= t('admin.onboarding_ui.active_branch') %></strong><small><%= t('admin.onboarding_ui.active_branch_help') %></small></span></label>
<% end %>
