<%= render 'admin/financials/navigation' %>
<section class="space-y-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="flex flex-wrap justify-between gap-3">
    <div><h1 class="font-jakarta text-2xl font-bold"><%= t('admin.accounts_payable.invoice') %> <%= @invoice.folio.presence || "##{@invoice.id}" %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= @invoice.supplier.name %> · <%= t("admin.accounts_payable.states.#{@invoice.status}") %></p></div>
    <% if @invoice.xml_document.attached? %>
      <%= link_to t('admin.accounts_payable.download_xml'), download_xml_admin_supplier_invoice_path(@invoice), class: 'rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold text-emerald-700' %>
    <% end %>
  </div>
  <dl class="grid gap-4 sm:grid-cols-3">
    <% [
      [t('admin.accounts_payable.uuid'), @invoice.uuid],
      [t('admin.accounts_payable.issued_on'), @invoice.issued_on],
      [t('admin.accounts_payable.due_on'), @invoice.due_on],
      [t('admin.accounts_payable.amount'), number_to_currency(@invoice.total, unit: '')],
      [t('admin.accounts_payable.currency'), @invoice.currency.code],
      [t('admin.accounts_payable.source'), @invoice.source]
    ].each do |label, value| %>
      <div class="rounded-xl bg-slate-50 p-4"><dt class="text-xs text-slate-500"><%= label %></dt><dd class="mt-1 break-words font-semibold"><%= value.presence || '—' %></dd></div>
    <% end %>
  </dl>
  <% if @invoice.supplier_invoice_lines.any? %>
    <h2 class="font-bold"><%= t('admin.accounts_payable.line_items') %></h2>
    <% @invoice.supplier_invoice_lines.each do |line| %>
      <div class="flex justify-between border-b border-slate-100 py-2 text-sm"><span><%= line.description %> (<%= line.quantity %>)</span><span><%= number_to_currency(line.amount, unit: '') %></span></div>
    <% end %>
  <% end %>
  <div class="flex flex-wrap gap-3">
    <% if @invoice.draft? && policy(@invoice).edit? %>
      <%= link_to t('admin.accounts_payable.edit'), edit_admin_supplier_invoice_path(@invoice), class: 'rounded-xl border border-slate-300 px-5 py-3 font-semibold' %>
    <% end %>
    <% if @invoice.draft? && policy(@invoice).post? %>
      <%= button_to t('admin.accounts_payable.post'), post_invoice_admin_supplier_invoice_path(@invoice), class: 'rounded-xl bg-emerald-600 px-5 py-3 font-semibold text-white' %>
    <% end %>
    <% if !@invoice.cancelled? && policy(@invoice).cancel? %>
      <%= button_to t('admin.accounts_payable.cancel'), cancel_admin_supplier_invoice_path(@invoice), class: 'rounded-xl border border-rose-300 px-5 py-3 font-semibold text-rose-700',
                    form: { data: { turbo_confirm: t('admin.accounts_payable.confirm') } } %>
    <% end %>
    <% if @invoice.account_payable %>
      <%= link_to t('admin.accounts_payable.payable_detail'), admin_account_payable_path(@invoice.account_payable), class: 'rounded-xl border border-slate-300 px-5 py-3 font-semibold text-emerald-700' %>
    <% end %>
  </div>
</section>

