<%= render 'admin/financials/navigation' %>
<section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
  <div class="mb-6 flex flex-wrap justify-between gap-4">
    <h1 class="font-jakarta text-2xl font-bold"><%= t('admin.accounts_payable.invoices') %></h1>
    <% if policy(SupplierInvoice.new(organization: current_organization)).create? %>
      <%= link_to t('admin.accounts_payable.new_invoice'), new_admin_supplier_invoice_path, class: 'inline-flex min-h-11 items-center justify-center rounded-xl bg-emerald-700 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800' %>
    <% end %>
  </div>
  <div class="overflow-x-auto rounded-xl border border-slate-200"><table data-financial-table="invoices" class="w-full min-w-[760px] text-left text-sm">
    <thead class="bg-slate-50 text-slate-500"><tr><% %w[invoice supplier issued_on due_on amount status].each do |key| %>
      <th class="p-3"><%= t("admin.accounts_payable.#{key}") %></th><% end %></tr></thead>
    <tbody><% @invoices.each do |invoice| %>
      <tr class="border-t border-slate-100">
        <td class="p-3"><%= link_to invoice.folio.presence || "##{invoice.id}", admin_supplier_invoice_path(invoice), class: 'font-semibold text-emerald-800 hover:underline' %></td>
        <td class="p-3"><%= invoice.supplier.name %></td><td class="p-3"><%= l(invoice.issued_on) %></td>
        <td class="p-3"><%= l(invoice.due_on) %></td>
        <td class="p-3"><%= number_to_currency(invoice.total, unit: '') %> <%= invoice.currency.code %></td>
        <td class="p-3"><%= render 'admin/financials/status_badge', status: invoice.status %></td>
      </tr>
    <% end %></tbody>
  </table></div>
  <% if @invoices.empty? %><p role="status" class="py-10 text-center text-sm text-slate-500"><%= t('admin.accounts_payable.empty') %></p><% end %>
  <%= render 'admin/financials/pagination' %>
</section>

