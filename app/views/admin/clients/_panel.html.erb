<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
  <div class="border-b border-slate-100 px-6 py-5">
    <h1 class="font-jakarta text-xl font-bold text-slate-900">
      <%= client.persisted? ? t('admin.clients.edit.title', name: client.name) : t('admin.clients.new.title') %>
    </h1>
    <p class="mt-1 text-sm text-slate-500">
      <%= client.persisted? ? t('admin.clients.edit.subtitle') : t('admin.clients.new.subtitle') %>
    </p>
  </div>

  <div class="px-6 py-6">
    <%= render 'form', client: client %>
  </div>
</div>
