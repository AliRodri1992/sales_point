<div class="mb-7 flex items-start justify-between gap-4">
  <div>
    <h1 class="font-jakarta text-2xl font-bold text-slate-900">
      <%= @client.persisted? ? t('admin.clients.edit.title', name: @client.name) : t('admin.clients.new.title') %>
    </h1>
    <p class="mt-1 text-sm text-slate-500">
      <%= @client.persisted? ? t('admin.clients.edit.subtitle') : t('admin.clients.new.subtitle') %>
    </p>
  </div>

  <%= link_to admin_clients_path,
              data: { turbo_frame: '_top' },
              class: 'inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50' do %>
    <%= icon('arrow-left', class: 'size-4') %>
    <%= t('admin.clients.show.back') %>
  <% end %>
</div>

<div class="max-w-6xl rounded-xl border border-slate-200 bg-white shadow-sm">
  <%= render 'form', client: @client %>
</div>
