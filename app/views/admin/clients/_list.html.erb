<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-4 sm:px-6">
    <div>
      <h2 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.clients.index.card_title') %></h2>
      <p class="mt-1 text-xs text-slate-500" role="status" aria-live="polite"><%= t('admin.clients.index.total_count', count: @total_count) %></p>
    </div>
    <span class="rounded-full border border-emerald-100 bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700"><%= t('admin.clients.workspace.directory') %></span>
  </div>

  <% if clients.any? %>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[870px] text-sm">
        <thead class="bg-slate-50/80">
          <tr class="border-b border-slate-100 text-xs text-slate-500">
            <th scope="col" class="px-5 py-3 text-left font-semibold sm:px-6"><%= sort_link('code', t('admin.clients.index.columns.code'), frame: 'clients_list') %></th>
            <th scope="col" class="px-4 py-3 text-left font-semibold"><%= sort_link('name', t('admin.clients.index.columns.name'), frame: 'clients_list') %></th>
            <th scope="col" class="px-4 py-3 text-left font-semibold"><%= t('admin.clients.index.columns.contact') %></th>
            <th scope="col" class="px-4 py-3 text-left font-semibold"><%= t('admin.clients.index.columns.rfc') %></th>
            <th scope="col" class="px-4 py-3 text-center font-semibold"><%= t('admin.clients.index.columns.status') %></th>
            <th scope="col" class="px-5 py-3 text-right font-semibold sm:px-6"><%= t('admin.clients.index.columns.actions') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% clients.each do |client| %>
            <% primary_mobile = client.phones.find { |phone| phone.deleted_at.nil? && phone.kind == 'mobile' && phone.primary? } %>
            <tr class="transition hover:bg-slate-50/80">
              <td class="px-5 py-4 sm:px-6"><code class="rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700"><%= client.code %></code></td>
              <td class="px-4 py-4">
                <div class="flex min-w-0 items-center gap-3">
                  <span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-sm font-bold text-emerald-800" aria-hidden="true"><%= client.name.to_s.first&.upcase %></span>
                  <div class="min-w-0">
                    <div class="max-w-64 truncate font-semibold text-slate-900" title="<%= client.name %>"><%= client.name %></div>
                    <div class="mt-0.5 text-xs text-slate-500"><%= t('admin.clients.workspace.customer') %></div>
                  </div>
                </div>
              </td>
              <td class="px-4 py-4">
                <div class="max-w-52 space-y-1">
                  <div class="truncate text-slate-700" title="<%= client.email %>"><%= client.email.presence || '—' %></div>
                  <div class="text-xs text-slate-500"><%= primary_mobile&.number || '—' %></div>
                </div>
              </td>
              <td class="px-4 py-4"><code class="text-xs font-semibold tracking-wide text-slate-600"><%= client.rfc.presence || '—' %></code></td>
              <td class="px-4 py-4 text-center">
                <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold <%= client.active? ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-600' %>">
                  <span class="size-1.5 rounded-full <%= client.active? ? 'bg-emerald-500' : 'bg-slate-400' %>" aria-hidden="true"></span>
                  <%= t("admin.clients.statuses.#{client.status}") %>
                </span>
              </td>
              <td class="px-5 py-4 sm:px-6">
                <div class="flex items-center justify-end gap-1">
                  <% if policy(Client).show? %>
                    <%= link_to admin_client_path(client), data: { turbo_frame: '_top', tooltip: t('admin.clients.index.show') },
                                aria: { label: t('admin.clients.index.show') },
                                class: 'inline-flex size-10 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 hover:text-slate-800 focus-visible:outline-2 focus-visible:outline-emerald-600' do %>
                      <%= delta_icon('eye', class: 'size-4') %>
                    <% end %>
                  <% end %>
                  <% if policy(Client).update? %>
                    <%= link_to edit_admin_client_path(client), data: { turbo_frame: '_top', tooltip: t('admin.clients.index.edit') },
                                aria: { label: t('admin.clients.index.edit') },
                                class: 'inline-flex size-10 items-center justify-center rounded-lg text-slate-500 transition hover:bg-emerald-50 hover:text-emerald-800 focus-visible:outline-2 focus-visible:outline-emerald-600' do %>
                      <%= delta_icon('pencil-square', class: 'size-4') %>
                    <% end %>
                  <% end %>
                  <% if policy(Client).destroy? %>
                    <%= button_to admin_client_path(client), method: :delete,
                                  data: { controller: 'swal-confirm', turbo_frame: 'clients_list',
                                          turbo_confirm: t('admin.clients.index.confirm_delete'),
                                          swal_cancel_text: t('admin.clients.confirm.cancel'),
                                          confirm_record: client.name },
                                  aria: { label: t('admin.clients.index.delete') },
                                  class: 'inline-flex size-10 items-center justify-center rounded-lg text-slate-500 transition hover:bg-rose-50 hover:text-rose-700 focus-visible:outline-2 focus-visible:outline-rose-600' do %>
                      <%= delta_icon('trash', class: 'size-4') %>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <footer class="flex flex-wrap items-center justify-between gap-4 border-t border-slate-100 px-5 py-4 sm:px-6">
      <%= form_with url: admin_clients_path, method: :get, id: 'client-pagination-form',
                    data: { turbo_frame: 'clients_list' }, class: 'flex items-center gap-3 text-xs font-semibold text-slate-600' do %>
        <% %i[search status credit rfc sat_fiscal_regime_id sort direction].each do |filter| %>
          <%= hidden_field_tag filter, params[filter] if params[filter].present? %>
        <% end %>
        <label for="clients-page-size"><%= t('admin.clients.index.pagination.per_page_label') %></label>
        <div class="relative w-24" data-controller="delta-select">
          <%= select_tag :per_page, options_for_select(TablePagePreference::OPTIONS, @per_page),
                         id: 'clients-page-size',
                         data: { controller: 'table-page-size', table_page_size_key_value: 'clients', action: 'change->table-page-size#apply' },
                         class: 'min-h-10 w-full rounded-lg border border-slate-200 text-sm' %>
        </div>
        <span class="tabular-nums" aria-live="polite"><%= @current_page %> / <%= @total_pages %></span>
      <% end %>
      <nav aria-label="<%= t('admin.clients.workspace.pagination') %>" class="flex flex-wrap items-center gap-1">
        <%= pagination_links(@total_pages, frame: 'clients_list', window: 2) if @total_pages > 1 %>
      </nav>
    </footer>
  <% else %>
    <div class="flex flex-col items-center px-6 py-14 text-center">
      <div class="mb-4 flex size-14 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-700" aria-hidden="true"><%= delta_icon('users', class: 'size-7') %></div>
      <h3 class="font-jakarta text-base font-bold text-slate-900">
        <%= t(@unfiltered_count.positive? ? 'admin.clients.workspace.no_results' : 'admin.clients.index.empty_title') %>
      </h3>
      <p class="mt-2 max-w-md text-sm text-slate-500"><%= t(@unfiltered_count.positive? ? 'admin.clients.workspace.try_filters' : 'admin.clients.index.empty_subtitle') %></p>
      <% if @unfiltered_count.positive? %>
        <%= link_to t('admin.clients.workspace.clear'), admin_clients_path,
                    data: { turbo_frame: '_top' }, class: 'mt-5 text-sm font-semibold text-emerald-700 hover:underline' %>
      <% elsif policy(Client).create? %>
        <%= link_to t('admin.clients.index.new'), new_admin_client_path,
                    data: { turbo_frame: '_top' },
                    class: 'mt-5 inline-flex min-h-11 items-center justify-center rounded-xl bg-emerald-700 px-5 text-sm font-semibold text-white hover:bg-emerald-800' %>
      <% end %>
    </div>
  <% end %>
</div>
