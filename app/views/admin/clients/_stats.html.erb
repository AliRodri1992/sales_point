<section id="clients_stats" aria-label="<%= t('admin.clients.workspace.overview') %>" class="mb-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
  <div class="rounded-2xl border border-slate-200 bg-white px-5 py-4 shadow-sm">
    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500"><%= t('admin.clients.workspace.total') %></p>
    <p class="mt-2 font-jakarta text-2xl font-bold tabular-nums text-slate-900"><%= @unfiltered_count %></p>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white px-5 py-4 shadow-sm">
    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500"><%= t('admin.clients.workspace.active') %></p>
    <p class="mt-2 font-jakarta text-2xl font-bold tabular-nums text-emerald-700"><%= @active_count %></p>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white px-5 py-4 shadow-sm">
    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500"><%= t('admin.clients.workspace.credit') %></p>
    <p class="mt-2 font-jakarta text-2xl font-bold tabular-nums text-slate-900"><%= @credit_count %></p>
  </div>
</section>
