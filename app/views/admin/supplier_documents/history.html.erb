<div class="mx-auto max-w-5xl space-y-5" data-loading-scope="true" data-supplier-document-history>
  <%= render 'admin/suppliers/subpage_header', supplier: @supplier,
             title: t('admin.supplier_document_history.versions'),
             subtitle: t('admin.supplier_dossier.document_empty.subtitle'),
             icon: 'document-text', back_path: admin_supplier_path(@supplier, tab: 'documents') %>
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"
           aria-label="<%= t('admin.supplier_document_history.versions') %>">
    <% if @versions.any? %>
      <ol class="space-y-3">
        <% @versions.each do |version| %>
          <li class="flex flex-col gap-3 rounded-xl border border-slate-200 bg-slate-50/60 p-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex min-w-0 items-start gap-3">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-white text-emerald-700">
                <%= delta_icon('document-text', class: 'size-5') %>
              </span>
              <div class="min-w-0">
                <p class="break-all text-sm font-bold text-slate-900"><%= version.attachment.blob.filename %></p>
                <p class="mt-1 text-xs leading-5 text-slate-600">
                  v<%= version.revision_number %> · <%= l(version.created_at, format: :short) %>
                  · <%= version.uploaded_by&.display_name || '—' %>
                </p>
              </div>
            </div>
            <%= link_to t('admin.supplier_documents.download'),
                        admin_supplier_document_version_download_path(@supplier, document_id: version.attachment_id),
                        aria: { label: "#{t('admin.supplier_documents.download')}: #{version.attachment.blob.filename}, v#{version.revision_number}" },
                        class: 'inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-xl border border-emerald-200 bg-white px-4 text-sm font-semibold text-emerald-800 transition hover:bg-emerald-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' %>
          </li>
        <% end %>
      </ol>
    <% else %>
      <div class="flex flex-col items-center justify-center px-5 py-10 text-center">
        <span class="flex size-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-500">
          <%= delta_icon('document-text', class: 'size-7') %>
        </span>
        <h2 class="mt-4 font-jakarta text-lg font-bold text-slate-900"><%= t('admin.supplier_document_history.versions') %></h2>
        <p class="mt-2 max-w-lg text-sm leading-6 text-slate-600"><%= t('admin.supplier_dossier.document_empty.subtitle') %></p>
      </div>
    <% end %>
  </section>
</div>
