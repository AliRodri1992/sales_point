<%= form_with model: [:admin, area],
              class: 'space-y-5',
              data: {
                controller: 'swal-confirm',
                turbo_frame: 'area_modal',
                swal_cancel_text: t('admin.areas.confirm.cancel')
              } do |form| %>
  <div class="mx-auto max-w-sm space-y-5">
    <div class="grid gap-5 sm:grid-cols-1">
      <div>
        <%= form.label :name, t('admin.areas.form.name'),
                       class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.text_field :name,
                            data: { autofocus: true },
                            class: "input-field w-full rounded-xl #{form_state_classes(area, :name)} px-4 py-3 text-sm font-medium text-slate-800 transition-all duration-200 placeholder:text-slate-400",
                            placeholder: t('admin.areas.form.name_placeholder') %>
        <%= error_message_for(area, :name) %>
      </div>

      <div>
        <%= form.label :code, t('admin.areas.form.code'),
                       class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.text_field :code,
                            class: "input-field w-full rounded-xl #{form_state_classes(area, :code)} px-4 py-3 text-sm font-medium text-slate-800 transition-all duration-200 placeholder:text-slate-400",
                            placeholder: t('admin.areas.form.code_placeholder') %>
        <%= error_message_for(area, :code) %>
      </div>

      <% if area.persisted? %>
        <div>
          <%= form.label :status, t('admin.areas.form.status'),
                         class: 'mb-2 block text-sm font-semibold text-slate-700' %>
          <%= form.select :status,
                          options_for_select(
                            Area.statuses.keys.map { |status| [t("admin.areas.statuses.#{status}"), status] },
                            area.status || 'active'
                          ),
                          {},
                          class: "input-field w-full rounded-xl #{form_state_classes(area, :status)} px-4 py-3 text-sm font-medium text-slate-800 transition-all duration-200" %>
          <%= error_message_for(area, :status) %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex items-center justify-center gap-2 border-t border-slate-100 pt-5">
    <button
      type="button"
      data-modal-dismiss
      data-action="modal#close"
      class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-600 transition hover:bg-slate-50"
    >
      <%= t('admin.areas.form.cancel') %>
    </button>
    <%= form.submit area.persisted? ? t('admin.areas.form.update') : t('admin.areas.form.create'),
                    class: 'inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700' %>
  </div>
<% end %>
