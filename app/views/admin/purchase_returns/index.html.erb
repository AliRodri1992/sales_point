<%= render 'admin/purchases/navigation' %>
<h1 class="mb-6 font-jakarta text-2xl font-bold"><%= t('admin.purchases.returns') %></h1>
<div class="space-y-3"><% @returns.each do |record| %>
  <%= link_to admin_purchase_return_path(record), class: 'block rounded-xl border border-slate-200 bg-white p-4' do %>
    <strong>#<%= record.id %></strong> · <%= record.goods_receipt.purchase_order.code %> ·
    <%= t("admin.purchases.statuses.#{record.status}") %>
  <% end %>
<% end %>
<% if @returns.empty? %><p><%= t('admin.purchases.empty') %></p><% end %></div>
