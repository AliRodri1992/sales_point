<%= render 'admin/purchases/navigation' %>
<h1 class="mb-6 font-jakarta text-2xl font-bold"><%= t('admin.purchases.new_return') %></h1>
<%= form_with model: [:admin, @receipt, @return], class: 'space-y-5' do |form| %>
  <% if @return.errors.any? %>
    <p class="rounded-xl bg-rose-50 p-3 text-sm text-rose-700"><%= @return.errors.full_messages.to_sentence %></p>
  <% end %>
  <section class="rounded-2xl border border-slate-200 bg-white p-6">
    <%= form.label :reason, t('admin.purchases.reason'), class: 'mb-2 block font-semibold' %>
    <%= form.select :reason, PurchaseReturn.reasons.keys.map { |key| [t("admin.purchases.reasons.#{key}"), key] },
                    {}, class: 'w-full rounded-xl border border-slate-200 p-3' %>
    <%= form.label :notes, t('admin.purchases.notes'), class: 'mb-2 mt-4 block font-semibold' %>
    <%= form.text_area :notes, class: 'w-full rounded-xl border border-slate-200 p-3' %>
  </section>
  <section class="rounded-2xl border border-slate-200 bg-white p-6">
    <% @receipt.goods_receipt_items.includes(purchase_order_item: :product).each_with_index do |entry, index| %>
      <div class="mb-4 grid gap-3 md:grid-cols-2">
        <%= hidden_field_tag "purchase_return[purchase_return_items_attributes][#{index}][goods_receipt_item_id]", entry.id %>
        <div><strong><%= entry.purchase_order_item.product.name %></strong>
          <p class="text-sm text-slate-500"><%= t('admin.purchases.received') %>: <%= entry.accepted_quantity %></p></div>
        <div><%= label_tag "return_quantity_#{index}", t('admin.purchases.quantity'), class: 'mb-1 block text-sm' %>
          <%= number_field_tag "purchase_return[purchase_return_items_attributes][#{index}][quantity]", nil,
                               min: 0.001, max: entry.accepted_quantity, step: 0.001,
                               class: 'w-full rounded-xl border border-slate-200 p-2' %></div>
      </div>
    <% end %>
  </section>
  <%= form.submit t('admin.purchases.create'), class: 'rounded-xl bg-emerald-600 px-5 py-3 text-white' %>
<% end %>
