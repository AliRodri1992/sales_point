<!-- Sales Chart -->
<div class="grid-stack-item" gs-id="sales-chart" gs-x="0" gs-y="0" gs-w="8" gs-h="5">
  <div class="grid-stack-item-content">
    <div class="dashboard-widget rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-base font-semibold text-slate-900">
            Ventas
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            Evolución de ventas de los últimos 7 días.
          </p>
        </div>

        <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-50">
          Esta semana
          <i class="fa-solid fa-chevron-down text-xs"></i>
        </button>
      </div>

      <div class="mt-6 h-[calc(100%-5rem)] min-h-[240px]">
        <div class="flex h-full items-end gap-4">
          <div class="flex h-full flex-1 flex-col justify-end gap-2">
            <div class="sales-chart-bar rounded-t-lg bg-blue-500" style="height: 42%;"></div>
            <span class="text-center text-xs text-slate-400">Lun</span>
          </div>

          <div class="flex h-full flex-1 flex-col justify-end gap-2">
            <div class="sales-chart-bar rounded-t-lg bg-blue-500" style="height: 58%;"></div>
            <span class="text-center text-xs text-slate-400">Mar</span>
          </div>

          <div class="flex h-full flex-1 flex-col justify-end gap-2">
            <div class="sales-chart-bar rounded-t-lg bg-blue-500" style="height: 72%;"></div>
            <span class="text-center text-xs text-slate-400">Mié</span>
          </div>

          <div class="flex h-full flex-1 flex-col justify-end gap-2">
            <div class="sales-chart-bar rounded-t-lg bg-blue-500" style="height: 54%;"></div>
            <span class="text-center text-xs text-slate-400">Jue</span>
          </div>

          <div class="flex h-full flex-1 flex-col justify-end gap-2">
            <div class="sales-chart-bar rounded-t-lg bg-blue-600" style="height: 86%;"></div>
            <span class="text-center text-xs font-medium text-slate-600">Vie</span>
          </div>

          <div class="flex h-full flex-1 flex-col justify-end gap-2">
            <div class="sales-chart-bar rounded-t-lg bg-blue-500" style="height: 68%;"></div>
            <span class="text-center text-xs text-slate-400">Sáb</span>
          </div>

          <div class="flex h-full flex-1 flex-col justify-end gap-2">
            <div class="sales-chart-bar rounded-t-lg bg-blue-500" style="height: 38%;"></div>
            <span class="text-center text-xs text-slate-400">Dom</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>