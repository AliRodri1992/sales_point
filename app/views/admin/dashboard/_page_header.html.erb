<div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
  <div>
    <h1 class="font-jakarta text-2xl font-bold tracking-tight text-slate-900">
      <%= t('admin.dashboard.page_header.title') %>
    </h1>

    <p class="mt-1 text-sm text-slate-500">
      <%= t('admin.dashboard.page_header.subtitle') %>
    </p>
  </div>

  <div class="flex items-center gap-3">
    <button
      id="customizeDashboardButton"
      type="button"
      class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50"
    >
      <%= icon("adjustments-horizontal", class: "size-4") %>
      <%= t('admin.dashboard.page_header.customize') %>
    </button>

    <button
      type="button"
      class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700"
    >
      <%= icon("plus", class: "size-4") %>
      <%= t('admin.dashboard.page_header.new_sale') %>
    </button>
  </div>
</div>