<div class="dashboard-page-header">
  <div>
    <h1 id="dashboard-title" class="font-jakarta text-2xl font-bold text-slate-900"><%= t('admin.dashboard.page_header.title') %></h1>
    <p class="mt-1 text-sm text-slate-600"><%= t('admin.dashboard.experience.subtitle') %></p>
  </div>
  <div class="dashboard-page-actions">
    <button id="cancelDashboardButton" type="button" class="dashboard-button dashboard-button-secondary" hidden><%= t('admin.dashboard.experience.cancel') %></button>
    <button id="customizeDashboardButton" type="button" disabled aria-pressed="false" aria-describedby="dashboardEditingHelp" class="dashboard-button dashboard-button-secondary">
      <%= delta_icon("bars-3", class: "size-4") %>
      <span data-dashboard-customize-label><%= t('admin.dashboard.page_header.customize') %></span>
    </button>
    <%= link_to new_admin_product_path, class: "dashboard-button dashboard-button-primary" do %>
      <%= delta_icon("plus", class: "size-4") %>
      <%= t('admin.dashboard.widgets.quick_actions.add_product') %>
    <% end %>
  </div>
</div>
<p id="dashboardEditingHelp" class="dashboard-editing-help" hidden><%= t('admin.dashboard.experience.editing_help') %></p>
