<% content_for :title, t(".title", default: "Admin Dashboard | Nexo POS") %>

<script
  id="dashboardPreferences" type="application/json">
  <%= raw @dashboard_preferences.to_json %>
</script>

<%= render "admin/dashboard/page_header" %>

<%= render "admin/dashboard/kpi_grid" %>

<div id="mainDashboardGrid" class="grid-stack dashboard-grid" data-grid-type="main">
  <%= render "admin/dashboard/sales_chart" %>

  <%= render "admin/dashboard/quick_actions" %>

  <%= render "admin/dashboard/recent_sales" %>

  <%= render "admin/dashboard/low_stock" %>
</div>