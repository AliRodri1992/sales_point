<% content_for :title, t("admin.dashboard.index.title") %>

<script
  id="dashboardPreferences" type="application/json">
  <%= raw json_escape(@dashboard_preferences.to_json) %>
</script>

<div role="region" class="dashboard-overview" aria-labelledby="dashboard-title">
<%= render "admin/dashboard/page_header" %>

<div class="dashboard-preview-notice" role="note">
  <%= delta_icon("information-circle", class: "size-5 shrink-0") %>
  <p><strong><%= t('admin.dashboard.experience.preview_title') %></strong> <%= t('admin.dashboard.experience.preview_description') %></p>
</div>
<p id="dashboardLayoutStatus" class="sr-only" role="status" aria-live="polite"></p>

<%= render "admin/dashboard/onboarding_card" %>

<%= render "admin/dashboard/kpi_grid" %>

<div id="mainDashboardGrid" class="grid-stack dashboard-grid gs-12 grid-stack-animate" data-grid-type="main">
  <%= render Admin::SalesChartComponent.new %>

  <%= render Admin::QuickActionsComponent.new(onboarding_progress: @onboarding_progress, sales_requirements: @sales_requirements) %>

  <%= render Admin::RecentSalesComponent.new %>

  <%= render Admin::LowStockComponent.new %>
</div>

</div>
