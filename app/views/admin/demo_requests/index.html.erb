<% content_for :title, t('admin.demo_requests.index.page_title') %>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="font-jakarta text-2xl font-bold text-slate-900"><%= t('admin.demo_requests.index.title') %></h1>
    <p class="mt-1 text-sm text-slate-500"><%= t('admin.demo_requests.index.subtitle') %></p>
  </div>

  <%= form_with url: admin_demo_requests_path, method: :get, class: 'flex flex-col gap-2 sm:flex-row' do %>
    <%= text_field_tag :search, params[:search],
                       placeholder: t('admin.demo_requests.index.search_placeholder'),
                       class: 'min-w-56 rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-700 placeholder-slate-400 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500' %>
    <%= select_tag :status,
                   options_for_select(
                     [[t('admin.demo_requests.filters.all'), '']] +
                     DemoRequest.statuses.keys.map { |status| [t("admin.demo_requests.statuses.#{status}"), status] },
                     params[:status]
                   ),
                   class: 'rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500' %>
    <%= button_tag type: 'submit',
                   class: 'inline-flex items-center justify-center gap-2 rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-800' do %>
      <%= icon('funnel', class: 'size-4') %>
      <%= t('admin.demo_requests.filters.apply') %>
    <% end %>
  <% end %>
</div>

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <% if @demo_requests.any? %>
    <div class="hidden overflow-x-auto md:block">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <% %w[prospect company status assigned created_at].each do |column| %>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                <%= t("admin.demo_requests.index.columns.#{column}") %>
              </th>
            <% end %>
            <th class="px-6 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">
              <%= t('admin.demo_requests.index.columns.actions') %>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @demo_requests.each do |demo_request| %>
            <tr class="transition hover:bg-slate-50">
              <td class="px-6 py-4">
                <p class="font-medium text-slate-900"><%= demo_request.name %></p>
                <p class="mt-0.5 text-xs text-slate-500"><%= demo_request.email %></p>
              </td>
              <td class="px-6 py-4 text-sm text-slate-700"><%= demo_request.company %></td>
              <td class="px-6 py-4">
                <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">
                  <%= t("admin.demo_requests.statuses.#{demo_request.status}") %>
                </span>
              </td>
              <td class="px-6 py-4 text-sm text-slate-600">
                <%= demo_request.assigned_to&.display_name || t('admin.demo_requests.index.unassigned') %>
              </td>
              <td class="px-6 py-4 text-sm text-slate-600">
                <%= l(demo_request.created_at, format: :short) %>
              </td>
              <td class="px-6 py-4 text-right">
                <%= link_to admin_demo_request_path(demo_request),
                            class: 'inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-50' do %>
                  <%= icon('eye', class: 'size-4') %>
                  <%= t('admin.demo_requests.index.view') %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="divide-y divide-slate-100 md:hidden">
      <% @demo_requests.each do |demo_request| %>
        <article class="p-4">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="font-semibold text-slate-900"><%= demo_request.name %></h2>
              <p class="mt-1 text-sm text-slate-500"><%= demo_request.company %></p>
            </div>
            <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">
              <%= t("admin.demo_requests.statuses.#{demo_request.status}") %>
            </span>
          </div>
          <p class="mt-3 break-all text-sm text-slate-600"><%= demo_request.email %></p>
          <p class="mt-1 text-xs text-slate-500">
            <%= t('admin.demo_requests.index.assigned') %>: <%= demo_request.assigned_to&.display_name || t('admin.demo_requests.index.unassigned') %>
          </p>
          <%= link_to admin_demo_request_path(demo_request),
                      class: 'mt-4 inline-flex items-center gap-2 rounded-lg bg-slate-100 px-3 py-2 text-sm font-semibold text-slate-700' do %>
            <%= icon('eye', class: 'size-4') %>
            <%= t('admin.demo_requests.index.view') %>
          <% end %>
        </article>
      <% end %>
    </div>

    <% if @total_count > @per_page %>
      <div class="flex flex-col gap-4 border-t border-slate-100 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-2 text-sm text-slate-600">
          <span><%= t('admin.demo_requests.index.total', count: @total_count) %></span>
          <%= select_tag :per_page,
                         options_for_select(Admin::DemoRequestsController::PER_PAGE_OPTIONS, @per_page),
                         onchange: "window.location = '#{admin_demo_requests_path(request.query_parameters.except('page').merge(per_page: ''))}' + this.value",
                         class: 'rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-700' %>
        </div>

        <% if @total_pages > 1 %>
          <nav class="flex items-center gap-1" aria-label="<%= t('admin.demo_requests.index.pagination.navigation') %>">
            <% if @current_page > 1 %>
              <%= link_to t('admin.demo_requests.index.pagination.prev'),
                          admin_demo_requests_path(request.query_parameters.merge(page: @current_page - 1)),
                          class: 'rounded-lg border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-100' %>
            <% end %>
            <% (1..@total_pages).each do |page| %>
              <% if page == @current_page %>
                <span class="rounded-lg bg-emerald-600 px-3 py-1.5 text-sm font-semibold text-white" aria-current="page"><%= page %></span>
              <% else %>
                <%= link_to page,
                            admin_demo_requests_path(request.query_parameters.merge(page: page)),
                            class: 'rounded-lg border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-100' %>
              <% end %>
            <% end %>
            <% if @current_page < @total_pages %>
              <%= link_to t('admin.demo_requests.index.pagination.next'),
                          admin_demo_requests_path(request.query_parameters.merge(page: @current_page + 1)),
                          class: 'rounded-lg border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-100' %>
            <% end %>
          </nav>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="px-6 py-14 text-center">
      <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-slate-100 text-slate-500">
        <%= icon('inbox', class: 'size-6') %>
      </div>
      <h2 class="mt-4 text-base font-semibold text-slate-900"><%= t('admin.demo_requests.index.empty_title') %></h2>
      <p class="mt-1 text-sm text-slate-500"><%= t('admin.demo_requests.index.empty_subtitle') %></p>
    </div>
  <% end %>
</div>
