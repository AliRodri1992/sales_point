<% content_for :title, t('admin.demo_requests.show.page_title') %>

<div class="mb-7 flex items-start justify-between gap-4">
  <div>
    <h1 class="font-jakarta text-2xl font-bold text-slate-900"><%= @demo_request.name %></h1>
    <p class="mt-1 text-sm text-slate-500"><%= @demo_request.company %> · <%= @demo_request.email %></p>
  </div>
  <%= link_to admin_demo_requests_path,
              class: 'inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50' do %>
    <%= icon('arrow-left', class: 'size-4') %>
    <%= t('admin.demo_requests.show.back') %>
  <% end %>
</div>

<div class="grid gap-6 lg:grid-cols-3">
  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white lg:col-span-2">
    <div class="border-b border-slate-100 px-6 py-5">
      <h2 class="font-jakarta text-lg font-bold text-slate-900"><%= t('admin.demo_requests.show.request_title') %></h2>
    </div>
    <dl class="grid gap-x-8 px-6 sm:grid-cols-2">
      <% [
        ['name', @demo_request.name],
        ['email', @demo_request.email],
        ['phone', @demo_request.phone],
        ['company', @demo_request.company],
        ['business_type', t("demo_requests.new.business_types.#{@demo_request.business_type}")],
        ['branches', @demo_request.branches],
        ['scheduled_at', @demo_request.scheduled_at ? l(@demo_request.scheduled_at, format: :long) : '—'],
        ['message', @demo_request.message.presence || '—']
      ].each do |key, value| %>
        <div class="border-b border-slate-100 py-4 <%= key == 'message' ? 'sm:col-span-2' : '' %>">
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400"><%= t("admin.demo_requests.show.fields.#{key}") %></dt>
          <dd class="mt-1 break-words text-sm font-medium text-slate-900"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white">
    <div class="border-b border-slate-100 px-6 py-5">
      <h2 class="font-jakarta text-lg font-bold text-slate-900"><%= t('admin.demo_requests.show.workflow_title') %></h2>
    </div>
    <%= form_with model: [:admin, @demo_request], class: 'space-y-5 p-6' do |f| %>
      <div>
        <%= f.label :status, t('admin.demo_requests.show.status'), class: 'block text-sm font-semibold text-slate-700' %>
        <%= f.select :status,
                     DemoRequest.statuses.keys.map { |status| [t("admin.demo_requests.statuses.#{status}"), status] },
                     {},
                     class: 'mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500' %>
      </div>

      <div>
        <%= f.label :scheduled_at, t('admin.demo_requests.show.scheduled_at'), class: 'block text-sm font-semibold text-slate-700' %>
        <%= f.datetime_local_field :scheduled_at,
                                   class: 'mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500' %>
        <p class="mt-1 text-xs text-slate-500"><%= t('admin.demo_requests.show.scheduled_hint') %></p>
      </div>

      <div>
        <%= f.label :assigned_to_id, t('admin.demo_requests.show.assigned_to'), class: 'block text-sm font-semibold text-slate-700' %>
        <%= f.select :assigned_to_id,
                     [[t('admin.demo_requests.index.unassigned'), '']] + @users.map { |user| [user.display_name, user.id] },
                     {},
                     class: 'mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500' %>
      </div>

      <div>
        <%= f.label :contacted_at, t('admin.demo_requests.show.fields.contacted_at'), class: 'block text-sm font-semibold text-slate-700' %>
        <%= f.datetime_local_field :contacted_at,
                                   value: @demo_request.contacted_at&.strftime('%Y-%m-%dT%H:%M'),
                                   class: 'mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500' %>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= f.label :contact_channel, t('admin.demo_requests.show.fields.contact_channel'), class: 'block text-sm font-semibold text-slate-700' %>
          <%= f.select :contact_channel,
                       [[t('admin.demo_requests.filters.select_option'), '']] +
                       DemoRequest::CONTACT_CHANNELS.map { |value| [t("admin.demo_requests.contact_channels.#{value}"), value] },
                       {},
                       class: 'mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500' %>
        </div>
        <div>
          <%= f.label :contact_outcome, t('admin.demo_requests.show.fields.contact_outcome'), class: 'block text-sm font-semibold text-slate-700' %>
          <%= f.select :contact_outcome,
                       [[t('admin.demo_requests.filters.select_option'), '']] +
                       DemoRequest::CONTACT_OUTCOMES.map { |value| [t("admin.demo_requests.contact_outcomes.#{value}"), value] },
                       {},
                       class: 'mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500' %>
        </div>
      </div>

      <div class="border-t border-slate-100 pt-5">
        <p class="text-sm font-semibold text-slate-700"><%= t('admin.demo_requests.show.follow_up_title') %></p>
        <div class="mt-3 space-y-4">
          <div>
            <%= f.label :next_follow_up_at, t('admin.demo_requests.show.fields.next_follow_up_at'), class: 'block text-sm font-semibold text-slate-700' %>
            <%= f.datetime_local_field :next_follow_up_at,
                                       value: @demo_request.next_follow_up_at&.strftime('%Y-%m-%dT%H:%M'),
                                       class: 'mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500' %>
          </div>
          <div>
            <%= f.label :next_action, t('admin.demo_requests.show.fields.next_action'), class: 'block text-sm font-semibold text-slate-700' %>
            <%= f.text_field :next_action,
                             maxlength: 120,
                             placeholder: t('admin.demo_requests.show.fields.next_action_placeholder'),
                             class: 'mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-700 placeholder-slate-400 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500' %>
          </div>
        </div>
      </div>

      <div>
        <%= f.label :demo_outcome, t('admin.demo_requests.show.fields.demo_outcome'), class: 'block text-sm font-semibold text-slate-700' %>
        <%= f.select :demo_outcome,
                     [[t('admin.demo_requests.filters.select_option'), '']] +
                     DemoRequest::DEMO_OUTCOMES.map { |value| [t("admin.demo_requests.demo_outcomes.#{value}"), value] },
                     {},
                     class: 'mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500' %>
      </div>

      <div>
        <%= f.label :note, t('admin.demo_requests.show.note'), class: 'block text-sm font-semibold text-slate-700' %>
        <%= f.text_area :note,
                        rows: 4,
                        placeholder: t('admin.demo_requests.show.note_placeholder'),
                        class: 'mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-700 placeholder-slate-400 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500' %>
        <p class="mt-1 text-xs text-slate-500"><%= t('admin.demo_requests.show.note_hint') %></p>
      </div>

      <% if @demo_request.errors.any? %>
        <div role="alert" class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700">
          <%= @demo_request.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <%= f.submit t('admin.demo_requests.show.save'),
                   class: 'w-full rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700' %>
    <% end %>
  </section>

  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white lg:col-span-3">
    <div class="border-b border-slate-100 px-6 py-5">
      <h2 class="font-jakarta text-lg font-bold text-slate-900"><%= t('admin.demo_requests.show.activity_title') %></h2>
    </div>
    <div class="divide-y divide-slate-100">
      <% if @activities.any? %>
        <% @activities.each do |activity| %>
          <div class="flex gap-3 px-6 py-4">
            <div class="mt-1 flex size-8 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-600">
              <%= icon('clock', class: 'size-4') %>
            </div>
            <div class="min-w-0">
              <p class="text-sm font-medium text-slate-800">
                <%= activity.details.presence || t("admin.demo_requests.activity.#{activity.action}") %>
              </p>
              <p class="mt-1 text-xs text-slate-400">
                <%= activity.user&.display_name || t('admin.demo_requests.activity.system') %>
                · <%= l(activity.created_at, format: :short) %>
              </p>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="px-6 py-8 text-sm text-slate-500"><%= t('admin.demo_requests.show.no_activity') %></p>
      <% end %>
    </div>
  </section>
</div>
