<% content_for :title, t('admin.organizations.show.title') %>
<div>
  <div class="mb-7 flex items-start justify-between gap-4">
    <div>
      <h1 class="font-jakarta text-2xl font-bold text-slate-900"><%= @organization.name %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= @organization.code %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to t('admin.organizations.show.back'), admin_organizations_path, class: 'rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700' %>
      <%= link_to 'Editar', edit_admin_organization_path(@organization), class: 'rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white' %>
    </div>
  </div>
  <div class="grid gap-6 lg:grid-cols-2">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Información</h2>
      <dl class="mt-5 space-y-4 text-sm">
        <div><dt class="text-slate-400"><%= Organization.human_attribute_name(:legal_name) %></dt><dd class="font-medium text-slate-800"><%= @organization.legal_name.presence || '—' %></dd></div>
        <div><dt class="text-slate-400"><%= Organization.human_attribute_name(:tax_id) %></dt><dd class="font-medium text-slate-800"><%= @organization.tax_id.presence || '—' %></dd></div>
        <div><dt class="text-slate-400"><%= Organization.human_attribute_name(:email) %></dt><dd class="font-medium text-slate-800"><%= @organization.email.presence || '—' %></dd></div>
        <div><dt class="text-slate-400"><%= Organization.human_attribute_name(:phone) %></dt><dd class="font-medium text-slate-800"><%= @organization.phone.presence || '—' %></dd></div>
      </dl>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500"><%= t('admin.organizations.show.subscription') %></h2>
      <% if @organization.current_subscription %>
        <div class="mt-5">
          <p class="text-xl font-bold text-slate-900"><%= @organization.subscription.membership_plan.name %></p>
          <p class="mt-1 text-sm text-slate-500"><%= @organization.subscription.status.humanize %></p>
          <%= link_to 'Ver suscripción', admin_subscription_path(@organization.subscription), class: 'mt-4 inline-block text-sm font-semibold text-blue-600' %>
        </div>
      <% else %>
        <p class="mt-5 text-sm text-slate-500"><%= t('admin.organizations.show.no_subscription') %></p>
      <% end %>
    </div>
  </div>
</div>
