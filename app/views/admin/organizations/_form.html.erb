<div class="max-w-4xl rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <%= form_with model: [:admin, @organization], class: 'space-y-6' do |form| %>
    <div>
      <%= form.label :name, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
      <%= form.text_field :name, class: "input-field w-full rounded-xl #{form_state_classes(@organization, :name)} px-4 py-3 text-sm" %>
      <%= error_message_for(@organization, :name) %>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :tax_id, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.text_field :tax_id, class: "input-field w-full rounded-xl #{form_state_classes(@organization, :tax_id)} px-4 py-3 text-sm" %>
        <%= error_message_for(@organization, :tax_id) %>
      </div>
      <div>
        <%= form.label :business_sector, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.select :business_sector, Organization::ONBOARDING_BUSINESS_SECTORS.map { |sector| [sector.humanize, sector] }, {}, class: 'input-field w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm' %>
        <%= error_message_for(@organization, :business_sector) %>
      </div>
    </div>
    <div>
      <%= form.label :status, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
      <%= form.select :status, Organization.statuses.keys.map { |status| [status.humanize, status] }, {}, class: 'input-field w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm' %>
      <%= error_message_for(@organization, :status) %>
    </div>
    <div class="flex justify-end border-t border-slate-100 pt-5">
      <%= form.submit submit_label, class: 'rounded-xl bg-emerald-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-emerald-800' %>
    </div>
  <% end %>
</div>
