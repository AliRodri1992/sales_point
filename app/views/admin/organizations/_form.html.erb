<div class="max-w-4xl rounded-xl border border-slate-200 bg-white shadow-sm">
  <%= form_with model: @organization, url: @organization.persisted? ? admin_organization_path(@organization) : admin_organizations_path, class: 'space-y-6 p-6 lg:p-8' do |form| %>
    <div>
      <%= form.label :name, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
      <%= form.text_field :name, class: "input-field w-full rounded-xl #{form_state_classes(@organization, :name)} px-4 py-3 text-sm" %>
      <%= error_message_for(@organization, :name) %>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :code, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.text_field :code, class: "input-field w-full rounded-xl #{form_state_classes(@organization, :code)} px-4 py-3 text-sm" %>
        <%= error_message_for(@organization, :code) %>
      </div>
      <div>
        <%= form.label :tax_id, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.text_field :tax_id, class: "input-field w-full rounded-xl #{form_state_classes(@organization, :tax_id)} px-4 py-3 text-sm" %>
        <%= error_message_for(@organization, :tax_id) %>
      </div>
    </div>
    <div>
      <%= form.label :legal_name, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
      <%= form.text_field :legal_name, class: "input-field w-full rounded-xl #{form_state_classes(@organization, :legal_name)} px-4 py-3 text-sm" %>
      <%= error_message_for(@organization, :legal_name) %>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :email, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.email_field :email, class: "input-field w-full rounded-xl #{form_state_classes(@organization, :email)} px-4 py-3 text-sm" %>
        <%= error_message_for(@organization, :email) %>
      </div>
      <div>
        <%= form.label :phone, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.telephone_field :phone, class: "input-field w-full rounded-xl #{form_state_classes(@organization, :phone)} px-4 py-3 text-sm" %>
        <%= error_message_for(@organization, :phone) %>
      </div>
    </div>
    <div>
      <%= form.label :status, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
      <%= form.select :status, [['Activa', 'active'], ['Inactiva', 'inactive']], {}, class: 'input-field w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm' %>
      <%= error_message_for(@organization, :status) %>
    </div>
    <div class="flex justify-end border-t border-slate-100 pt-5">
      <%= form.submit submit_label, class: 'rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700' %>
    </div>
  <% end %>
</div>
