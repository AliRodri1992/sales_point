<%= render 'admin/financials/navigation' %>
<section class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="font-jakarta text-2xl font-bold"><%= t('admin.accounts_payable.payable_detail') %> #<%= @payable.id %></h1>
    <%= link_to t('admin.accounts_payable.invoice'), admin_supplier_invoice_path(@payable.supplier_invoice), class: 'text-sm font-semibold text-emerald-700 hover:underline' %>
  </div>
  <p class="text-sm text-slate-600"><%= @payable.supplier.name %> · <%= l(@payable.due_on) %> · <span data-payable-currency><%= @payable.supplier_invoice.currency&.code || '—' %></span></p>
  <div class="grid gap-4 sm:grid-cols-4">
    <% [
      [t('admin.accounts_payable.original_amount'), @payable.amount],
      [t('admin.accounts_payable.paid'), @payable.paid_amount],
      [t('admin.accounts_payable.credit'), @payable.credited_amount],
      [t('admin.accounts_payable.balance'), @payable.balance]
    ].each do |label, amount| %>
      <div class="rounded-xl bg-slate-50 p-4"><p class="text-xs text-slate-500"><%= label %></p>
        <p class="mt-2 text-xl font-bold"><%= number_to_currency(amount, unit: '') %></p></div>
    <% end %>
  </div>
  <h2 class="text-lg font-bold"><%= t('admin.accounts_payable.payments') %></h2>
  <% @payable.supplier_payment_allocations.each do |allocation| %>
    <div class="flex justify-between border-b border-slate-100 py-2 text-sm">
      <%= link_to allocation.supplier_payment.reference.presence || "##{allocation.supplier_payment_id}", admin_supplier_payment_path(allocation.supplier_payment), class: 'text-emerald-700 hover:underline' %>
      <span><%= number_to_currency(allocation.amount, unit: '') %> · <%= t("admin.accounts_payable.states.#{allocation.supplier_payment.status}") %></span>
    </div>
  <% end %>
  <h2 class="text-lg font-bold"><%= t('admin.accounts_payable.credits') %></h2>
  <% @payable.supplier_credit_allocations.each do |allocation| %>
    <div class="flex justify-between border-b border-slate-100 py-2 text-sm">
      <%= link_to allocation.supplier_credit_note.folio.presence || "##{allocation.supplier_credit_note_id}", admin_supplier_credit_note_path(allocation.supplier_credit_note), class: 'text-emerald-700 hover:underline' %>
      <span><%= number_to_currency(allocation.amount, unit: '') %></span>
    </div>
  <% end %>
</section>

