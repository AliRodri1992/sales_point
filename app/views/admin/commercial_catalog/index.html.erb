<% content_for :title, t("admin.catalog_design.#{controller_name}") %>
<% model = controller_name == 'price_lists' ? PriceList : Promotion %>
<div class="catalog-workspace">
<header class="catalog-header"><div><p class="catalog-eyebrow"><%= t('admin.catalog_design.commercial') %></p><h1><%= t("admin.catalog_design.#{controller_name}") %></h1><p><%= t("admin.catalog_design.#{controller_name}_intro") %></p></div><div class="catalog-actions"><%= link_to t('admin.catalog_design.products'), admin_products_path, class: 'catalog-button' %><% if policy(model).create? %><%= link_to t('admin.catalog_design.new_record'), new_polymorphic_path([:admin, model]), class: 'catalog-button catalog-button-primary' %><% end %></div></header>
<%= form_with url: polymorphic_path([:admin, model]), method: :get, class: 'catalog-filter' do %><div><%= label_tag :search, t('admin.catalog_design.search') %><%= search_field_tag :search, params[:search] %></div><div><%= label_tag :status, t('admin.catalog_design.status') %><%= select_tag :status, options_for_select([[t('admin.catalog_design.all_statuses'), 'all'], *model.statuses.keys.map { |status| [t("admin.catalog_design.#{status}"), status] }], params[:status]) %></div><%= submit_tag t('admin.catalog_design.filter'), class: 'catalog-button' %><% end %>
<section class="catalog-card"><div class="catalog-card-heading"><h2><%= t('admin.catalog_design.results', count: @total_count) %></h2></div><% if @records.any? %><div class="overflow-x-auto"><table class="w-full text-left"><thead><tr><% %w[name code currency status actions].each do |key| %><th class="px-5 py-3"><%= t("admin.catalog_design.#{key}") %></th><% end %></tr></thead><tbody class="divide-y divide-slate-100"><% @records.each do |record| %><tr><td class="px-5 py-4 font-semibold"><%= record.name %></td><td class="px-5 py-4"><%= record.code %></td><td class="px-5 py-4"><%= record.currency %></td><td class="px-5 py-4"><span class="catalog-status <%= 'catalog-status-inactive' unless record.active? %>"><%= t("admin.catalog_design.#{record.status}") %></span></td><td class="px-5 py-4"><div class="catalog-actions"><% if policy(record).show? %><%= link_to t('admin.catalog_design.show'), polymorphic_path([:admin, record]), class: 'catalog-button' %><% end %><% if policy(record).update? %><%= link_to t('admin.catalog_design.edit'), edit_polymorphic_path([:admin, record]), class: 'catalog-button' %><% end %></div></td></tr><% end %></tbody></table></div><% else %><div class="catalog-card-body"><p class="catalog-hint"><%= t('admin.catalog_design.no_results') %></p></div><% end %>
<div class="catalog-card-body"><%= render 'admin/shared/table_pagination', table_key: controller_name %></div></section>
</div>
