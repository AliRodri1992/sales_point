<div class="catalog-nested-row" data-nested-catalog-row <%= 'data-controller=commercial-condition' if association == :promotion_conditions %>>
<%= form.hidden_field :id if form.object.persisted? %>
<% if association == :price_list_items %>
<%= catalog_select(form, :product_id, current_organization.products.not_deleted.order(:name).pluck(:name, :id)) %><%= catalog_field(form, :price, type: :number_field, label: required_field_label(t('admin.catalog_design.price')), min: 0, step: '0.01') %><%= catalog_select(form, :product_variant_id, ProductVariant.where(organization: current_organization).includes(:product).map { |item| ["#{item.product.name} · #{item.name}", item.id] }) %><%= catalog_select(form, :product_presentation_id, ProductPresentation.where(organization: current_organization).includes(:product).map { |item| ["#{item.product.name} · #{item.name}", item.id] }) %><%= catalog_field(form, :starts_at, type: :datetime_local_field) %><%= catalog_field(form, :ends_at, type: :datetime_local_field) %>
<% elsif association == :promotion_conditions %>
<div data-action="change->commercial-condition#refresh"><%= catalog_select(form, :kind, PromotionCondition.kinds.keys.map { |kind| [t("admin.catalog_design.condition_#{kind}"), kind] }) %></div><%= catalog_select(form, :product_id, current_organization.products.not_deleted.order(:name).pluck(:name, :id)) %><%= catalog_select(form, :category_id, Category.not_deleted.order(:name).pluck(:name, :id)) %><%= catalog_field(form, :quantity, type: :number_field, min: '0.000001', step: '0.000001') %><%= catalog_field(form, :amount, type: :number_field, min: 0, step: '0.01') %><%= catalog_field(form, :customer_segment, maxlength: 100) %>
<% else %><%= catalog_select(form, :kind, PromotionBenefit.kinds.keys.map { |kind| [t("admin.catalog_design.benefit_#{kind}"), kind] }, include_blank: false) %><%= catalog_field(form, :value, type: :number_field, label: required_field_label(t('admin.catalog_design.value')), min: '0.0001', step: '0.0001') %>
<% end %>
<% if !form.object.persisted? || association != :price_list_items %><%= form.hidden_field :_destroy, value: 0, data: { nested_catalog_destroy: true } if form.object.persisted? %><button type="button" class="catalog-button" data-action="nested-catalog#remove"><%= t('admin.catalog_design.remove') %></button><% end %>
</div>
