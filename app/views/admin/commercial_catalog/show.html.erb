<% content_for :title, @record.name %>
<% is_list = @record.is_a?(PriceList) %>
<div class="catalog-workspace"><header class="catalog-header"><div><p class="catalog-eyebrow"><%= t(is_list ? 'admin.catalog_design.price_lists' : 'admin.catalog_design.promotions') %></p><h1><%= @record.name %></h1><p><%= @record.code %> · <%= @record.currency %></p></div><div class="catalog-actions"><%= link_to t('admin.catalog_design.back'), polymorphic_path([:admin, @record.class]), class: 'catalog-button' %><% if policy(@record).update? %><%= link_to t('admin.catalog_design.edit'), edit_polymorphic_path([:admin, @record]), class: 'catalog-button catalog-button-primary' %><% end %></div></header>
<div class="catalog-layout"><div class="catalog-main"><section class="catalog-card"><%= catalog_heading(t('admin.catalog_design.general'), t('admin.catalog_design.commercial_identity_hint'), icon: 'tag') %><dl class="catalog-card-body catalog-definition"><div><dt><%= t('admin.catalog_design.status') %></dt><dd><%= t("admin.catalog_design.#{@record.status}") %></dd></div><div><dt><%= t('admin.catalog_design.currency') %></dt><dd><%= @record.currency %></dd></div><% [:starts_at, :ends_at].each do |attribute| %><div><dt><%= t("admin.catalog_design.#{attribute}") %></dt><dd><%= @record.public_send(attribute) ? l(@record.public_send(attribute), format: :long) : t('admin.catalog_design.no_limit') %></dd></div><% end %><% unless is_list %><% [:usage_limit, :customer_limit].each do |attribute| %><div><dt><%= t("admin.catalog_design.#{attribute}") %></dt><dd><%= @record.public_send(attribute) || t('admin.catalog_design.no_limit') %></dd></div><% end %><div><dt><%= t('admin.catalog_design.redemptions') %></dt><dd><%= @record.promotion_redemptions.count %></dd></div><% end %></dl></section>
<% if is_list %><section class="catalog-card"><%= catalog_heading(t('admin.catalog_design.price_list_items'), t('admin.catalog_design.price_list_items_hint'), icon: 'currency-dollar') %><div class="catalog-card-body"><% @record.price_list_items.includes(:product, :product_variant, :product_presentation).each do |item| %><div class="flex flex-wrap justify-between gap-3 border-b border-slate-100 py-4"><div><p class="text-sm font-semibold"><%= item.product.name %></p><p class="catalog-hint"><%= [item.product_variant&.name, item.product_presentation&.name].compact.join(' · ') %></p><p class="catalog-hint"><%= item.starts_at ? l(item.starts_at, format: :short) : '—' %> / <%= item.ends_at ? l(item.ends_at, format: :short) : '—' %></p></div><strong class="text-sm"><%= number_to_currency(item.price) %> <%= @record.currency %></strong></div><% end %></div></section>
<% else %><section class="catalog-card"><%= catalog_heading(t('admin.catalog_design.promotion_conditions'), t('admin.catalog_design.promotion_conditions_hint'), icon: 'adjustments-horizontal') %><div class="catalog-card-body"><% if @record.promotion_conditions.empty? %><p class="catalog-hint"><%= t('admin.catalog_design.all_products') %></p><% end %><% @record.promotion_conditions.includes(:product, :category).each do |condition| %><p class="catalog-hint"><strong><%= t("admin.catalog_design.condition_#{condition.kind}") %></strong> · <%= { 'product' => condition.product&.name, 'category' => condition.category&.name, 'min_quantity' => condition.quantity, 'min_subtotal' => condition.amount, 'customer_segment' => condition.customer_segment }[condition.kind] %></p><% end %></div></section><section class="catalog-card"><%= catalog_heading(t('admin.catalog_design.promotion_benefits'), t('admin.catalog_design.promotion_benefits_hint'), icon: 'gift') %><div class="catalog-card-body"><% @record.promotion_benefits.each do |benefit| %><p class="text-sm font-semibold"><%= t("admin.catalog_design.benefit_#{benefit.kind}") %> · <%= benefit.percentage? ? "#{benefit.value}%" : number_to_currency(benefit.value) %></p><% end %></div></section><% end %>
</div><aside class="catalog-aside"><div class="catalog-notice"><%= t(is_list ? 'admin.catalog_design.price_list_help' : 'admin.catalog_design.promotion_help') %></div><% if policy(@record).destroy? && !@record.archived? %><section class="catalog-card catalog-card-body"><h2><%= t('admin.catalog_design.archive') %></h2><p><%= t('admin.catalog_design.archive_hint') %></p><%= button_to t('admin.catalog_design.archive'), polymorphic_path([:admin, @record]), method: :delete, class: 'catalog-button mt-4' %></section><% end %></aside></div></div>
