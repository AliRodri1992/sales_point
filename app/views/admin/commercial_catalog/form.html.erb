<% content_for :title, t("admin.catalog_design.#{controller_name}") %>
<% is_list = @record.is_a?(PriceList) %>
<div class="catalog-workspace"><header class="catalog-header"><div><p class="catalog-eyebrow"><%= t('admin.catalog_design.commercial') %></p><h1><%= t(@record.persisted? ? 'admin.catalog_design.edit_record' : 'admin.catalog_design.new_record') %> · <%= t(is_list ? 'admin.catalog_design.price_lists' : 'admin.catalog_design.promotions') %></h1><p><%= t(is_list ? 'admin.catalog_design.price_lists_intro' : 'admin.catalog_design.promotions_intro') %></p></div><%= link_to t('admin.catalog_design.back'), polymorphic_path([:admin, @record.class]), class: 'catalog-button' %></header>
<%= form_with model: [:admin, @record], class: 'catalog-layout', html: { novalidate: true }, data: { controller: 'nested-catalog', turbo: false } do |form| %><div class="catalog-main"><%= catalog_errors(@record) %><section class="catalog-card"><%= catalog_heading(t('admin.catalog_design.general'), t('admin.catalog_design.commercial_identity_hint'), icon: 'tag') %><div class="catalog-card-body catalog-fields">
<%= catalog_field(form, :name, label: required_field_label(t('admin.catalog_design.name')), maxlength: 100) %><%= catalog_field(form, :code, label: required_field_label(t('admin.catalog_design.code')), maxlength: 50) %><% if @record.persisted? %><div><%= catalog_field(form, :currency, readonly: true) %><p class="catalog-hint"><%= t('admin.catalog_design.currency_fixed') %></p></div><% else %><%= catalog_select(form, :currency, Currency.active.order(:code).pluck(:code, :code), include_blank: false) %><% end %><%= catalog_select(form, :status, @record.class.statuses.keys.map { |status| [t("admin.catalog_design.#{status}"), status] }, include_blank: false) %><%= catalog_field(form, :starts_at, type: :datetime_local_field) %><%= catalog_field(form, :ends_at, type: :datetime_local_field) %>
<% if is_list %><%= catalog_field(form, :customer_segment, maxlength: 100) %><% else %><%= catalog_field(form, :usage_limit, type: :number_field, min: 1, step: 1) %><%= catalog_field(form, :customer_limit, type: :number_field, min: 1, step: 1) %><% end %>
</div></section>
<% associations = is_list ? [:price_list_items] : [:promotion_conditions, :promotion_benefits] %>
<% associations.each do |association| %><section class="catalog-card"><%= catalog_heading(t("admin.catalog_design.#{association}"), t("admin.catalog_design.#{association}_hint"), icon: 'adjustments-horizontal') %><div class="catalog-card-body" data-nested-catalog-group data-nested-catalog-limit="<%= { price_list_items: 50, promotion_conditions: 20, promotion_benefits: 10 }.fetch(association) %>"><div data-nested-catalog-rows><%= form.fields_for association do |nested| %><%= render 'admin/commercial_catalog/row', form: nested, association: association %><% end %></div><template data-nested-catalog-template><%= form.fields_for association, association.to_s.classify.constantize.new, child_index: 'NEW_RECORD' do |nested| %><%= render 'admin/commercial_catalog/row', form: nested, association: association %><% end %></template><button type="button" class="catalog-button" data-action="nested-catalog#add"><%= delta_icon('plus', class: 'size-4') %><%= t('admin.catalog_design.add_row') %></button></div></section><% end %>
<% if is_list && @record.persisted? %><section class="catalog-card catalog-card-body"><div class="catalog-field"><%= label_tag :price_change_reason, t('admin.catalog_design.price_change_reason') %><%= text_area_tag :price_change_reason, params[:price_change_reason], maxlength: 1000, rows: 2 %></div><p class="catalog-hint"><%= t('admin.catalog_design.price_approval_hint') %></p></section><% end %>
<footer class="catalog-footer"><%= link_to t('admin.catalog_design.cancel'), polymorphic_path([:admin, @record.class]), class: 'catalog-button' %><%= form.submit t('admin.catalog_design.save'), class: 'catalog-button catalog-button-primary' %></footer></div>
<aside class="catalog-aside"><div class="catalog-notice"><%= t(is_list ? 'admin.catalog_design.price_list_help' : 'admin.catalog_design.promotion_help') %></div><section class="catalog-card catalog-card-body"><h2><%= t('admin.catalog_design.period_help_title') %></h2><p><%= t('admin.catalog_design.period_help') %></p></section></aside><% end %></div>
