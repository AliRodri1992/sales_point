<% content_for :title, t('admin.users.index.page_title') %>
<% counts = @user_status_counts || {} %>

<div class="mx-auto max-w-[100rem] space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="min-w-0">
      <p class="mb-1 text-xs font-bold uppercase tracking-[.18em] text-emerald-700"><%= t('admin.users.ui.eyebrow') %></p>
      <h1 class="font-jakarta text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"><%= t('admin.users.index.title') %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500"><%= t('admin.users.ui.description') %></p>
    </div>
    <% if @can_manage_users %>
      <%= link_to new_admin_user_path, data: { turbo_frame: '_top' },
                  class: 'inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700' do %>
        <%= delta_icon('plus', class: 'size-5') %><%= t('admin.users.index.new') %>
      <% end %>
    <% end %>
  </header>

  <section class="grid grid-cols-2 gap-3 xl:grid-cols-4" aria-label="<%= t('admin.users.ui.summary') %>">
    <% [
      ['total', counts.values.sum, 'users', 'bg-slate-100 text-slate-700'],
      ['active', counts.fetch('active', 0), 'check-circle', 'bg-emerald-50 text-emerald-700'],
      ['suspended', counts.fetch('suspended', 0), 'clock', 'bg-amber-50 text-amber-700'],
      ['blocked', counts.fetch('blocked', 0), 'shield-exclamation', 'bg-rose-50 text-rose-700']
    ].each do |key, count, icon, theme| %>
      <div class="flex min-w-0 items-center gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
        <span class="flex size-11 shrink-0 items-center justify-center rounded-xl <%= theme %>"><%= delta_icon(icon, class: 'size-5') %></span>
        <div class="min-w-0">
          <p class="truncate text-xs font-medium text-slate-500"><%= t("admin.users.ui.metrics.#{key}") %></p>
          <p class="mt-1 font-jakarta text-2xl font-bold tabular-nums text-slate-900"><%= number_with_delimiter(count) %></p>
        </div>
      </div>
    <% end %>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5" aria-labelledby="users-filters-title">
    <div class="mb-4 flex items-center justify-between gap-3">
      <h2 id="users-filters-title" class="flex items-center gap-2 font-jakarta text-sm font-bold text-slate-800">
        <%= delta_icon('funnel', class: 'size-5 text-emerald-700') %><%= t('admin.users.ui.filters_title') %>
      </h2>
      <%= link_to t('admin.users.index.filters.reset'), admin_users_path,
                  data: { turbo_frame: '_top' }, class: 'text-xs font-semibold text-emerald-800 underline-offset-2 hover:underline' %>
    </div>
    <%= form_with url: admin_users_path, method: :get, data: { turbo_frame: 'users_list' },
                  class: 'grid gap-4 sm:grid-cols-2 xl:grid-cols-[minmax(12rem,2fr)_repeat(3,minmax(9rem,1fr))_auto]' do %>
      <div class="min-w-0 sm:col-span-2 xl:col-span-1">
        <label for="users-filter-search" class="mb-1.5 block text-xs font-semibold text-slate-600"><%= t('admin.users.ui.search_label') %></label>
        <div class="relative">
          <%= delta_icon('magnifying-glass', class: 'pointer-events-none absolute left-3 top-1/2 size-5 -translate-y-1/2 text-slate-400') %>
          <%= search_field_tag :q, params[:q], id: 'users-filter-search',
                               placeholder: t('admin.users.index.filters.search_placeholder'), autocomplete: 'off',
                               class: 'min-h-11 w-full rounded-xl border border-slate-300 bg-white py-2.5 pl-10 pr-3 text-sm text-slate-800 placeholder:text-slate-400 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100' %>
        </div>
      </div>
      <div class="min-w-0">
        <label for="users-filter-type" class="mb-1.5 block text-xs font-semibold text-slate-600"><%= t('admin.users.form.fields.user_type') %></label>
        <div class="relative" data-controller="delta-select">
          <%= select_tag :user_type, options_for_select(
                [[t('admin.users.index.filters.all_types'), '']] +
                  User.user_types.keys.map { |type| [t("admin.users.user_types.#{type}"), type] }, params[:user_type]),
                id: 'users-filter-type', class: 'w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm' %>
        </div>
      </div>
      <div class="min-w-0">
        <label for="users-filter-status" class="mb-1.5 block text-xs font-semibold text-slate-600"><%= t('admin.users.form.fields.status') %></label>
        <div class="relative" data-controller="delta-select">
          <%= select_tag :status, options_for_select(
                [[t('admin.users.index.filters.all_statuses'), '']] +
                  (User.statuses.keys - ['deleted']).map { |status| [t("admin.users.statuses.#{status}"), status] }, params[:status]),
                id: 'users-filter-status', class: 'w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm' %>
        </div>
      </div>
      <div class="min-w-0">
        <label for="users-filter-role" class="mb-1.5 block text-xs font-semibold text-slate-600"><%= t('admin.users.form.fields.system_roles') %></label>
        <div class="relative" data-controller="delta-select">
          <%= select_tag :role, options_for_select(
                [[t('admin.users.index.filters.all_roles'), '']] +
                  @filter_roles.map { |role| [system_role_name(role), role.id] }, params[:role]),
                id: 'users-filter-role', class: 'w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm' %>
        </div>
      </div>
      <%= hidden_field_tag :per_page, params[:per_page] if params[:per_page].present? %>
      <div class="flex items-end sm:col-span-2 xl:col-span-1">
        <button type="submit" class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 xl:w-auto">
          <%= delta_icon('magnifying-glass', class: 'size-4') %><%= t('admin.users.index.filters.apply') %>
        </button>
      </div>
    <% end %>
  </section>

  <div class="delta-skeleton-region" data-controller="skeleton-loading"
       data-skeleton-loading-region-value="users_list" aria-busy="false"
       data-action="skeleton:begin@document->skeleton-loading#begin skeleton:end@document->skeleton-loading#finish turbo:before-fetch-request@document->skeleton-loading#turboStart turbo:frame-load@document->skeleton-loading#turboFinish turbo:fetch-request-error@document->skeleton-loading#turboError turbo:frame-missing@document->skeleton-loading#turboMissing turbo:before-cache@document->skeleton-loading#clear">
    <span class="sr-only" role="status" aria-live="polite" hidden data-skeleton-loading-target="status"><%= t('admin.action_loader.processing') %></span>
    <div class="delta-skeleton-region__progress" data-skeleton-loading-target="indicator" hidden aria-hidden="true"><span></span></div>
    <div data-skeleton-loading-target="content">
      <%= turbo_frame_tag 'users_list' do %>
        <%= render 'list', users: @users, total_count: @total_count, total_pages: @total_pages,
                   current_page: @current_page, per_page: @per_page, can_manage_users: @can_manage_users %>
      <% end %>
    </div>
    <div data-skeleton-loading-target="placeholder" hidden>
      <%= render Ui::SkeletonComponent.new(variant: :table, rows: 6, columns: 6) %>
    </div>
    <div data-skeleton-loading-target="error" hidden role="alert" class="mt-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
      <span><%= t('admin.skeleton_loading.failed') %></span>
      <button type="button" data-action="skeleton-loading#retry" class="ml-2 font-semibold underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-rose-600"><%= t('admin.skeleton_loading.retry') %></button>
    </div>
  </div>
</div>
