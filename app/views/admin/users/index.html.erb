<% content_for :title, t('admin.users.index.page_title') %>

<div>
  <div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="font-jakarta text-2xl font-bold text-slate-900"><%= t('admin.users.index.title') %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= t('admin.users.index.subtitle') %></p>
    </div>

    <% if @can_manage_users %>
      <%= link_to new_admin_user_path,
                  data: { turbo_frame: '_top' },
                  class: 'inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2' do %>
        <%= icon('plus', class: 'size-4') %>
        <%= t('admin.users.index.new') %>
      <% end %>
    <% end %>
  </div>

  <!-- Filtros avanzados -->
  <%= form_with url: admin_users_path,
               method: :get,
               data: { turbo_frame: 'users_list' },
               class: 'mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5' do %>
    <%= text_field_tag :q,
                       params[:q],
                       placeholder: t('admin.users.index.filters.search_placeholder'),
                       class: 'sm:col-span-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100' %>

    <%= select_tag :user_type,
                   options_for_select(
                     [
                       [t('admin.users.index.filters.all_types'), '']
                     ] + User.user_types.keys.map { |type| [t("admin.users.user_types.#{type}"), type] },
                     params[:user_type]
                   ),
                   class: 'w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100' %>

    <%= select_tag :status,
                   options_for_select(
                     [
                       [t('admin.users.index.filters.all_statuses'), '']
                     ] + User.statuses.keys.map { |status| [t("admin.users.statuses.#{status}"), status] },
                     params[:status]
                   ),
                   class: 'w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100' %>

    <%= select_tag :role,
                   options_from_collection_for_select(SystemRole.system.active.order(:name), :id, :name, params[:role]),
                   include_blank: t('admin.users.index.filters.all_roles'),
                   class: 'w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100' %>

    <div class="flex items-end gap-2">
      <button type="submit"
              class="rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">
        <%= t('admin.users.index.filters.apply') %>
      </button>
      <%= link_to admin_users_path,
                  data: { turbo_frame: 'users_list' },
                  class: "rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-100" do %>
        <%= t('admin.users.index.filters.reset') %>
      <% end %>
    </div>
  <% end %>

  <%= turbo_frame_tag 'users_list' do %>
    <%= render 'list',
               users: @users,
               total_count: @total_count,
               total_pages: @total_pages,
               current_page: @current_page,
               per_page: @per_page,
               can_manage_users: @can_manage_users %>
  <% end %>
</div>
