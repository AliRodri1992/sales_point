<%# Render active filters inside the Turbo list frame so it updates with each search. %>
<% active_query = request.query_parameters.slice('q', 'user_type', 'status', 'role', 'branch', 'sort', 'direction', 'per_page') %>
<% active_filters = [] %>
<% if params[:q].present? %>
  <% active_filters << { key: 'q', label: t('admin.users.ui.search_label'), value: params[:q].to_s.strip } %>
<% end %>
<% if params[:user_type].present? %>
  <% active_filters << { key: 'user_type', label: t('admin.users.form.fields.user_type'),
                         value: t("admin.users.user_types.#{params[:user_type]}", default: params[:user_type].to_s) } %>
<% end %>
<% if params[:status].present? %>
  <% active_filters << { key: 'status', label: t('admin.users.form.fields.status'),
                         value: t("admin.users.statuses.#{params[:status]}", default: params[:status].to_s) } %>
<% end %>
<% if params[:role].present? %>
  <% selected_role = @filter_roles.find { |role| role.id.to_s == params[:role].to_s } %>
  <% active_filters << { key: 'role', label: t('admin.users.form.fields.system_roles'),
                         value: selected_role ? system_role_name(selected_role) : params[:role].to_s } %>
<% end %>

<% if params[:branch].present? %>
  <% selected_branch = @filter_branches.find { |branch| branch.id.to_s == params[:branch].to_s } %>
  <% active_filters << { key: 'branch', label: t('admin.users.ui.branch_filter_label'),
                         value: selected_branch ? selected_branch.name : params[:branch].to_s } %>
<% end %>

<% if active_filters.any? %>
  <section id="users-active-filters" class="mb-4 rounded-2xl border border-emerald-200 bg-emerald-50/50 px-4 py-3 sm:px-5"
           aria-label="<%= t('admin.users.ui.active_filters_title') %>">
    <div class="flex flex-wrap items-center gap-2">
      <span class="mr-1 inline-flex items-center gap-2 text-xs font-bold text-emerald-900">
        <%= delta_icon('funnel', class: 'size-4') %>
        <%= t('admin.users.ui.active_filters_title') %>
      </span>
      <% active_filters.each do |filter| %>
        <% tag_label = "#{filter[:label]}: #{filter[:value]}" %>
        <%= link_to admin_users_path(active_query.except(filter[:key])),
                    data: { turbo_frame: '_top', user_filter: filter[:key] },
                    aria: { label: t('admin.users.ui.remove_filter', name: tag_label) },
                    class: 'inline-flex min-h-9 max-w-full items-center gap-2 rounded-full border border-emerald-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-800 shadow-sm transition hover:border-emerald-400 hover:bg-emerald-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' do %>
          <span class="min-w-0 break-words">
            <span class="font-semibold text-emerald-800"><%= filter[:label] %>:</span>
            <%= filter[:value] %>
          </span>
          <%= delta_icon('x-mark', class: 'size-3.5 shrink-0 text-slate-500') %>
        <% end %>
      <% end %>
      <%= link_to t('admin.users.ui.clear_active_filters'), admin_users_path(active_query.except('q', 'user_type', 'status', 'role', 'branch')),
                  data: { turbo_frame: '_top' },
                  class: 'inline-flex min-h-9 items-center rounded-lg px-2 text-xs font-semibold text-emerald-800 underline-offset-2 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' %>
    </div>
  </section>
<% end %>
