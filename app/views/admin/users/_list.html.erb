<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <% if users.any? %>
    <div class="hidden overflow-x-auto md:block">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
              <%= sort_link('users.email', t('admin.users.index.columns.email'), frame: 'users_list') %>
            </th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
              <%= sort_link('users.username', t('admin.users.index.columns.username'), frame: 'users_list') %>
            </th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
              <%= sort_link('users.user_type', t('admin.users.index.columns.user_type'), frame: 'users_list') %>
            </th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
              <%= sort_link('users.status', t('admin.users.index.columns.status'), frame: 'users_list') %>
            </th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
              <%= t('admin.users.index.columns.roles') %>
            </th>
            <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
              <%= sort_link('users.created_at', t('admin.users.index.columns.created_at'), frame: 'users_list') %>
            </th>
            <th class="px-6 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500"><%= t('admin.users.index.columns.actions') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% users.each do |user| %>
            <tr class="transition hover:bg-slate-50">
              <td class="px-6 py-4">
                <span class="block font-medium text-slate-900"><%= user.email %></span>
              </td>
              <td class="px-6 py-4 text-sm text-slate-600"><%= user.username.presence || t('admin.users.index.no_data') %></td>
              <td class="px-6 py-4 text-sm text-slate-600"><%= t("admin.users.user_types.#{user.user_type}") %></td>
              <td class="px-6 py-4"><%= user_status_badge(user.status) %></td>
              <td class="max-w-xs px-6 py-4 text-sm text-slate-600">
                <% if user.system_roles.active.any? %>
                  <div class="flex flex-wrap gap-1.5">
                    <% user.system_roles.active.each do |role| %>
                      <span class="inline-flex items-center rounded-full bg-blue-50 px-2 py-0.5 text-xs font-medium text-blue-700"><%= role.name %></span>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-slate-400"><%= t('admin.users.index.no_roles') %></span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-slate-600"><%= l(user.created_at, format: :short) %></td>
              <td class="px-6 py-4">
                <div class="flex justify-end gap-1">
                  <%= link_to admin_user_path(user),
                              data: { turbo_frame: '_top' },
                              title: t('admin.users.actions.view'),
                              aria: { label: t('admin.users.actions.view') },
                              class: 'rounded-lg p-2 text-slate-600 transition hover:bg-slate-100' do %>
                    <%= icon('eye', class: 'size-5') %>
                  <% end %>
                  <% if can_manage_users %>
                    <%= link_to edit_admin_user_path(user),
                                data: { turbo_frame: '_top' },
                                title: t('admin.users.actions.edit'),
                                aria: { label: t('admin.users.actions.edit') },
                                class: 'rounded-lg p-2 text-blue-600 transition hover:bg-blue-50' do %>
                      <%= icon('pencil-square', class: 'size-5') %>
                    <% end %>
                    <%= button_to admin_user_path(user),
                                  method: :delete,
                                  title: t('admin.users.actions.delete'),
                                  aria: { label: t('admin.users.actions.delete') },
                                  form: {
                                    data: {
                                      controller: 'swal-confirm',
                                      turbo_frame: 'users_list',
                                      turbo_confirm: t('admin.users.confirm_delete'),
                                      swal_cancel_text: t('admin.users.confirm.cancel')
                                    }
                                  },
                                  class: 'rounded-lg p-2 text-red-600 transition hover:bg-red-50' do %>
                      <%= icon('trash', class: 'size-5') %>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="divide-y divide-slate-100 md:hidden">
      <% users.each do |user| %>
        <div class="p-4">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="font-semibold text-slate-900"><%= user.email %></h2>
              <p class="mt-1 text-sm text-slate-500"><%= user.username.presence || t('admin.users.index.no_data') %></p>
            </div>
            <%= user_status_badge(user.status) %>
          </div>
          <div class="mt-3 text-sm text-slate-600"><%= t("admin.users.user_types.#{user.user_type}") %></div>
          <div class="mt-3 flex items-center gap-1.5 flex-wrap">
            <% if user.system_roles.active.any? %>
              <% user.system_roles.active.each do |role| %>
                <span class="inline-flex items-center rounded-full bg-blue-50 px-2 py-0.5 text-xs font-medium text-blue-700"><%= role.name %></span>
              <% end %>
            <% else %>
              <span class="text-slate-400"><%= t('admin.users.index.no_roles') %></span>
            <% end %>
          </div>
          <div class="mt-4 flex justify-end gap-1">
            <%= link_to admin_user_path(user),
                        data: { turbo_frame: '_top' },
                        title: t('admin.users.actions.view'),
                        aria: { label: t('admin.users.actions.view') },
                        class: 'rounded-lg p-2 text-slate-600 transition hover:bg-slate-100' do %>
              <%= icon('eye', class: 'size-5') %>
            <% end %>
            <% if can_manage_users %>
              <%= link_to edit_admin_user_path(user),
                          data: { turbo_frame: '_top' },
                          title: t('admin.users.actions.edit'),
                          aria: { label: t('admin.users.actions.edit') },
                          class: 'rounded-lg p-2 text-blue-600 transition hover:bg-blue-50' do %>
                <%= icon('pencil-square', class: 'size-5') %>
              <% end %>
              <%= button_to admin_user_path(user),
                            method: :delete,
                            title: t('admin.users.actions.delete'),
                            aria: { label: t('admin.users.actions.delete') },
                            form: {
                              data: {
                                controller: 'swal-confirm',
                                turbo_frame: 'users_list',
                                turbo_confirm: t('admin.users.confirm_delete'),
                                swal_cancel_text: t('admin.users.confirm.cancel')
                              }
                            },
                            class: 'rounded-lg p-2 text-red-600 transition hover:bg-red-50' do %>
                <%= icon('trash', class: 'size-5') %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <% if total_pages > 1 %>
      <div class="flex flex-col gap-4 border-t border-slate-100 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-2 text-sm text-slate-600">
          <label for="users-per-page"><%= t('admin.users.index.pagination.per_page_label') %></label>
          <%= select_tag :per_page,
                        options_for_select(Admin::UsersController::PER_PAGE_OPTIONS, per_page),
                        id: 'users-per-page',
                        data: { controller: 'users-pagination', action: 'change->users-pagination#perPageChanged' },
                        class: 'rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500' %>
        </div>

        <nav class="flex items-center gap-1" aria-label="<%= t('admin.users.index.pagination.navigation') %>">
          <% if current_page > 1 %>
            <%= link_to t('admin.users.index.pagination.prev'),
                        admin_users_path(request.query_parameters.merge(page: current_page - 1)),
                        class: 'rounded-lg border border-slate-300 px-3 py-1.5 text-sm text-slate-700 transition hover:bg-slate-100' %>
          <% end %>

          <% (1..total_pages).each do |page| %>
            <% if page == current_page %>
              <span class="rounded-lg bg-blue-600 px-3 py-1.5 text-sm font-semibold text-white" aria-current="page"><%= page %></span>
            <% else %>
              <%= link_to page,
                          admin_users_path(request.query_parameters.merge(page: page)),
                          class: 'rounded-lg border border-slate-300 px-3 py-1.5 text-sm text-slate-700 transition hover:bg-slate-100' %>
            <% end %>
          <% end %>

          <% if current_page < total_pages %>
            <%= link_to t('admin.users.index.pagination.next'),
                        admin_users_path(request.query_parameters.merge(page: current_page + 1)),
                        class: 'rounded-lg border border-slate-300 px-3 py-1.5 text-sm text-slate-700 transition hover:bg-slate-100' %>
          <% end %>
        </nav>
      </div>
    <% end %>
  <% else %>
    <div class="px-6 py-14 text-center">
      <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-slate-100 text-slate-500">
        <%= icon('users', class: 'size-6') %>
      </div>
      <h2 class="mt-4 text-base font-semibold text-slate-900"><%= t('admin.users.index.empty.title') %></h2>
      <p class="mt-1 text-sm text-slate-500"><%= t('admin.users.index.empty.subtitle') %></p>
      <% if can_manage_users %>
        <%= link_to new_admin_user_path,
                    data: { turbo_frame: '_top' },
                    class: 'mt-5 inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700' do %>
          <%= icon('plus', class: 'size-4') %>
          <%= t('admin.users.index.new') %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
