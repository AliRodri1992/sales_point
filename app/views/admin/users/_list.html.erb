<section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="users-results-title">
  <header class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-4 py-4 sm:px-6">
    <div>
      <h2 id="users-results-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.users.ui.results_title') %></h2>
      <p class="mt-0.5 text-xs text-slate-500"><%= t('admin.users.ui.results_count', count: total_count) %></p>
    </div>
    <% if params[:q].present? || params[:user_type].present? || params[:status].present? || params[:role].present? %>
      <span class="rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-800"><%= t('admin.users.ui.filtered') %></span>
    <% end %>
  </header>

  <% if users.any? %>
    <div class="hidden overflow-x-auto lg:block">
      <table class="min-w-full text-sm">
        <thead class="border-b border-slate-200 bg-slate-50/80">
          <tr>
            <% { 'users.username' => 'username', 'users.user_type' => 'user_type',
                 'users.status' => 'status' }.each do |column, label| %>
              <th scope="col" class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-600">
                <%= sort_link(column, t("admin.users.index.columns.#{label}"), frame: 'users_list') %>
              </th>
            <% end %>
            <th scope="col" class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-600"><%= t('admin.users.index.columns.roles') %></th>
            <th scope="col" class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-600"><%= sort_link('users.created_at', t('admin.users.index.columns.created_at'), frame: 'users_list') %></th>
            <th scope="col" class="px-5 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-600"><%= t('admin.users.index.columns.actions') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% users.each do |user| %>
            <tr class="transition-colors hover:bg-emerald-50/40" data-skeleton-record>
              <td class="min-w-52 px-5 py-4">
                <div class="flex items-center gap-3">
                  <span class="flex size-10 shrink-0 items-center justify-center rounded-xl text-sm font-bold" style="<%= user_avatar_style(user) %>" aria-hidden="true"><%= user.initials %></span>
                  <div class="min-w-0">
                    <p class="break-words font-semibold text-slate-900"><%= user.username.presence || user.display_name %></p>
                    <p class="mt-0.5 break-all text-xs text-slate-500"><%= user.email %></p>
                    <% if user == current_user %><span class="mt-1 inline-block text-[11px] font-semibold text-emerald-700"><%= t('admin.users.ui.your_account') %></span><% end %>
                  </div>
                </div>
              </td>
              <td class="px-5 py-4 text-slate-600"><%= t("admin.users.user_types.#{user.user_type}") %></td>
              <td class="px-5 py-4"><%= user_status_badge(user.organization_memberships.find { |membership| membership.organization_id == current_organization.id && membership.active? && membership.deleted_at.nil? }&.account_status || user.status) %></td>
              <td class="max-w-64 px-5 py-4"><%= render 'role_badges', user: user %></td>
              <td class="whitespace-nowrap px-5 py-4 text-xs text-slate-600"><%= l(user.created_at, format: :short) %></td>
              <td class="px-5 py-4"><%= render 'row_actions', user: user, can_manage_users: can_manage_users %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="grid gap-3 p-3 sm:grid-cols-2 lg:hidden sm:p-4">
      <% users.each do |user| %>
        <article class="min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm" data-skeleton-record>
          <div class="flex min-w-0 items-start gap-3">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-xl text-sm font-bold" style="<%= user_avatar_style(user) %>" aria-hidden="true"><%= user.initials %></span>
            <div class="min-w-0 flex-1">
              <p class="break-words font-semibold text-slate-900"><%= user.username.presence || user.display_name %></p>
              <p class="mt-1 break-all text-xs text-slate-500"><%= user.email %></p>
              <% if user == current_user %><p class="mt-1 text-[11px] font-semibold text-emerald-700"><%= t('admin.users.ui.your_account') %></p><% end %>
            </div>
          </div>
          <div class="mt-4 flex flex-wrap items-center gap-2">
            <%= user_status_badge(user.status) %>
            <span class="text-xs text-slate-500"><%= t("admin.users.user_types.#{user.user_type}") %></span>
          </div>
          <div class="mt-4 border-t border-slate-100 pt-3">
            <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-500"><%= t('admin.users.index.columns.roles') %></p>
            <%= render 'role_badges', user: user %>
          </div>
          <div class="mt-4 flex items-center justify-between gap-2 border-t border-slate-100 pt-3">
            <span class="text-xs text-slate-500"><%= l(user.created_at, format: :short) %></span>
            <%= render 'row_actions', user: user, can_manage_users: can_manage_users %>
          </div>
        </article>
      <% end %>
    </div>

    <footer class="flex flex-col gap-3 border-t border-slate-100 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <div class="flex flex-wrap items-center gap-3 text-xs text-slate-600">
        <label for="users-per-page" class="font-semibold"><%= t('admin.users.index.pagination.per_page_label') %></label>
        <div class="relative w-24" data-controller="delta-select">
          <%= select_tag :per_page, options_for_select(Admin::UsersController::PER_PAGE_OPTIONS, per_page),
                         id: 'users-per-page',
                         data: { controller: 'table-page-size', table_page_size_key_value: 'users',
                                 action: 'change->table-page-size#apply' },
                         class: 'w-full rounded-xl border border-slate-300 bg-white px-2 py-2 text-sm text-slate-700' %>
        </div>
        <span aria-live="polite"><%= t('admin.users.ui.range', first: (current_page - 1) * per_page + 1,
                                          last: [current_page * per_page, total_count].min, total: total_count) %></span>
      </div>
      <% if total_pages > 1 %>
        <nav class="flex flex-wrap items-center gap-1" aria-label="<%= t('admin.users.index.pagination.navigation') %>">
          <%= pagination_links(total_pages, frame: 'users_list', window: 2) %>
        </nav>
      <% end %>
    </footer>
  <% else %>
    <% filtered = params[:q].present? || params[:user_type].present? || params[:status].present? || params[:role].present? %>
    <div class="flex flex-col items-center gap-3 px-5 py-14 text-center sm:px-10">
      <span class="flex size-16 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-700">
        <%= delta_icon('users', class: 'size-8') %>
      </span>
      <h3 class="font-jakarta text-lg font-bold text-slate-900"><%= t(filtered ? 'admin.users.ui.no_results' : 'admin.users.index.empty.title') %></h3>
      <p class="max-w-md text-sm leading-6 text-slate-500"><%= t(filtered ? 'admin.users.ui.no_results_hint' : 'admin.users.index.empty.subtitle') %></p>
      <% if filtered %>
        <%= link_to t('admin.users.index.filters.reset'), admin_users_path,
                    data: { turbo_frame: '_top' }, class: 'mt-2 inline-flex min-h-10 items-center rounded-xl border border-emerald-200 px-4 text-sm font-semibold text-emerald-800 hover:bg-emerald-50' %>
      <% elsif can_manage_users %>
        <%= link_to new_admin_user_path, data: { turbo_frame: '_top' },
                    class: 'mt-2 inline-flex min-h-11 items-center gap-2 rounded-xl bg-emerald-700 px-5 text-sm font-semibold text-white hover:bg-emerald-800' do %>
          <%= delta_icon('plus', class: 'size-4') %><%= t('admin.users.index.new') %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>
