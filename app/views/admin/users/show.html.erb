<% content_for :title, "#{@user.display_name} | #{t('admin.users.index.title')}" %>

<div>
  <div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-medium text-slate-500"><%= t('admin.users.index.title') %></p>
      <h1 class="mt-1 font-jakarta text-2xl font-bold text-slate-900"><%= @user.display_name %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= @user.email %></p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <%= link_to admin_users_path,
                  data: { turbo_frame: '_top' },
                  class: 'inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-100' do %>
        <%= icon('arrow-left', class: 'size-4') %>
        <%= t('admin.users.form.buttons.back') %>
      <% end %>

      <% if @can_manage_users %>
        <%= link_to edit_admin_user_path(@user),
                    data: { turbo_frame: '_top' },
                    class: 'inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700' do %>
          <%= icon('pencil-square', class: 'size-4') %>
          <%= t('admin.users.actions.edit') %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm lg:p-8">
      <div class="mb-4 border-b border-slate-100 pb-2">
        <h2 class="font-jakarta text-base font-semibold text-slate-900"><%= t('admin.users.show.identity_title') %></h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400"><%= t('admin.users.show.email') %></p>
          <p class="mt-1 text-sm text-slate-700"><%= @user.email %></p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400"><%= t('admin.users.show.username') %></p>
          <p class="mt-1 text-sm text-slate-700"><%= @user.username.presence || '<span class="text-slate-400">—</span>'.html_safe %></p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400"><%= t('admin.users.show.user_type') %></p>
          <p class="mt-1 text-sm text-slate-700"><%= t("admin.users.user_types.#{@user.user_type}") %></p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400"><%= t('admin.users.show.theme') %></p>
          <p class="mt-1 text-sm text-slate-700"><%= @user.theme %></p>
        </div>
      </div>
    </section>

    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm lg:p-8">
      <div class="mb-4 border-b border-slate-100 pb-2">
        <h2 class="font-jakarta text-base font-semibold text-slate-900"><%= t('admin.users.show.access_title') %></h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400"><%= t('admin.users.show.status') %></p>
          <div class="mt-1"><%= user_status_badge(@user.status) %></div>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400"><%= t('admin.users.show.language') %></p>
          <p class="mt-1 text-sm text-slate-700"><%= @user.language&.name || '—' %></p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400"><%= t('admin.users.show.last_sign_in_at') %></p>
          <p class="mt-1 text-sm text-slate-700"><%= @user.last_sign_in_at ? l(@user.last_sign_in_at, format: :long) : t('admin.users.show.never') %></p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400"><%= t('admin.users.show.sign_in_count') %></p>
          <p class="mt-1 text-sm text-slate-700"><%= @user.sign_in_count %></p>
        </div>
      </div>

      <div class="mt-4 border-t border-slate-100 pt-4">
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400"><%= t('admin.users.show.roles') %></p>
        <% if @user.system_roles.active.any? %>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <% @user.system_roles.active.each do |role| %>
              <span class="inline-flex items-center rounded-full bg-blue-50 px-2.5 py-1 text-xs font-medium text-blue-700"><%= role.name %></span>
            <% end %>
          </div>
        <% else %>
          <p class="mt-2 text-sm text-slate-500"><%= t('admin.users.show.no_roles') %></p>
        <% end %>
      </div>
    </section>
  </div>
</div>
