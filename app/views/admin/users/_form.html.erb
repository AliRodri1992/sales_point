<% editing = @user.persisted? %>
<% submitted_role_ids = params.dig(:user, :system_role_ids) %>
<% selected_role_ids = if submitted_role_ids
                         Array(submitted_role_ids).map(&:to_i)
                       elsif editing
                         @user.user_roles.active.where(branch_id: nil).pluck(:system_role_id)
                       else
                         []
                       end %>
<div class="mx-auto max-w-[92rem] space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="min-w-0">
      <p class="mb-1 text-xs font-bold uppercase tracking-[.18em] text-emerald-700"><%= t('admin.users.ui.eyebrow') %></p>
      <h1 class="font-jakarta text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"><%= title %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500"><%= t('admin.users.form.subtitle') %></p>
    </div>
    <%= link_to(editing ? admin_user_path(@user) : admin_users_path,
                class: 'inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-emerald-200 hover:bg-emerald-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600') do %>
      <%= delta_icon('arrow-left', class: 'size-4') %><%= t('admin.users.form.buttons.back') %>
    <% end %>
  </header>

  <%= form_with model: @user, url: editing ? admin_user_path(@user) : admin_users_path,
                html: { novalidate: true }, class: 'grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_20rem]' do |form| %>
    <div class="min-w-0 space-y-5">
      <% if @user.errors[:base].any? %>
        <div role="alert" class="rounded-2xl border border-rose-200 bg-rose-50 px-5 py-4 text-sm text-rose-800">
          <% @user.errors[:base].each do |message| %><p><%= message %></p><% end %>
        </div>
      <% end %>

      <section class="rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="users-identity-title">
        <header class="flex items-center gap-3 border-b border-slate-100 px-5 py-5 sm:px-6">
          <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><%= delta_icon('user-circle', class: 'size-6') %></span>
          <div>
            <h2 id="users-identity-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.users.ui.form_identity') %></h2>
            <p class="mt-0.5 text-xs text-slate-500"><%= t('admin.users.ui.form_identity_hint') %></p>
          </div>
        </header>
        <div class="grid gap-5 p-5 sm:grid-cols-2 sm:p-6">
          <div class="min-w-0">
            <%= form.label :email, t('admin.users.form.fields.email'), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
            <%= form.email_field :email, autocomplete: 'email',
                                 aria: { invalid: @user.errors[:email].any? },
                                 class: "input-field min-h-11 w-full rounded-xl #{form_state_classes(@user, :email)} px-3.5 py-2.5 text-sm text-slate-800" %>
            <%= error_message_for(@user, :email) %>
          </div>
          <div class="min-w-0">
            <%= form.label :username, t('admin.users.form.fields.username'), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
            <%= form.text_field :username, autocomplete: 'username',
                                aria: { invalid: @user.errors[:username].any? },
                                class: "input-field min-h-11 w-full rounded-xl #{form_state_classes(@user, :username)} px-3.5 py-2.5 text-sm text-slate-800" %>
            <%= error_message_for(@user, :username) %>
          </div>
          <div class="min-w-0">
            <%= form.label :user_type, t('admin.users.form.fields.user_type'), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
            <div class="relative" data-controller="delta-select">
              <%= form.select :user_type, options_for_select(
                User.user_types.keys.map { |type| [t("admin.users.user_types.#{type}"), type] }, @user.user_type),
                { include_blank: t('admin.users.form.fields.user_type_placeholder') },
                class: "input-field min-h-11 w-full rounded-xl #{form_state_classes(@user, :user_type)} px-3.5 py-2.5 text-sm",
                aria: { invalid: @user.errors[:user_type].any? } %>
            </div>
            <%= error_message_for(@user, :user_type) %>
          </div>
          <div class="min-w-0">
            <span class="mb-1.5 block text-sm font-semibold text-slate-700"><%= t('admin.users.form.fields.status') %></span>
            <div class="flex min-h-11 items-center rounded-xl border border-slate-200 bg-slate-50 px-3.5 text-sm font-semibold text-slate-700"><%= t("admin.users.statuses.#{@user.status || 'pending'}") %></div>
            <p class="mt-1.5 text-xs text-slate-500"><%= t(editing ? 'admin.users.form.status_edit_hint' : 'admin.users.form.status_new_hint') %></p>
          </div>
        </div>
      </section>

      <% unless editing %>
        <section class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5">
          <p class="font-semibold text-emerald-900"><%= t('admin.users.form.invitation_title') %></p>
          <p class="mt-2 text-sm text-emerald-800"><%= t('admin.users.form.invitation_hint') %></p>
        </section>
      <% end %>
      <section class="rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="users-access-title">
        <header class="flex items-center gap-3 border-b border-slate-100 px-5 py-5 sm:px-6">
          <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><%= delta_icon('shield-check', class: 'size-6') %></span>
          <div>
            <h2 id="users-access-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.users.form.fields.system_roles') %></h2>
            <p class="mt-0.5 text-xs text-slate-500"><%= t('admin.users.ui.form_roles_hint') %></p>
          </div>
        </header>
        <div class="p-5 sm:p-6">
          <%= hidden_field_tag 'user[system_role_ids][]', '' %>
          <% if @roles.any? %>
            <div class="grid gap-3 sm:grid-cols-2">
              <% @roles.each do |role| %>
                <label for="user_role_<%= role.id %>" class="flex min-w-0 cursor-pointer items-start gap-3 rounded-xl border border-slate-200 bg-slate-50/40 px-4 py-3 transition hover:border-emerald-300 hover:bg-emerald-50/50 focus-within:border-emerald-500 focus-within:ring-2 focus-within:ring-emerald-100">
                  <%= check_box_tag 'user[system_role_ids][]', role.id, selected_role_ids.include?(role.id),
                                    id: "user_role_#{role.id}",
                                    class: 'mt-1 size-4 shrink-0 rounded border-slate-300 text-emerald-700 focus:ring-emerald-500' %>
                  <span class="min-w-0">
                    <span class="block break-words text-sm font-semibold text-slate-800"><%= system_role_name(role) %></span>
                    <% if system_role_description(role).present? %>
                      <span class="mt-1 block text-xs leading-5 text-slate-500"><%= system_role_description(role) %></span>
                    <% end %>
                  </span>
                </label>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-slate-500"><%= t('admin.users.ui.no_roles_available') %></p>
          <% end %>
          <%= error_message_for(@user, :system_role_ids) %>
          <% if editing %>
            <% branch_assignments = @user.user_roles.active.includes(:system_role, :branch).select { |assignment| assignment.branch_id.present? && assignment.branch&.organization_id == current_organization&.id } %>
            <% if branch_assignments.any? %>
              <div class="mt-5 rounded-xl border border-emerald-100 bg-emerald-50/60 p-4">
                <p class="text-xs font-bold text-emerald-900"><%= t('admin.users.ui.branch_roles_title') %></p>
                <p class="mt-1 text-xs leading-5 text-emerald-800"><%= t('admin.users.ui.branch_roles_hint') %></p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <% branch_assignments.each do |assignment| %>
                    <span class="rounded-lg bg-white px-2.5 py-1.5 text-xs font-semibold text-emerald-800"><%= system_role_name(assignment.system_role) %> · <%= assignment.branch.name %></span>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="users-branches-title">
        <header class="flex items-center gap-3 border-b border-slate-100 px-5 py-5 sm:px-6">
          <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><%= delta_icon('building-storefront', class: 'size-6') %></span>
          <div>
            <h2 id="users-branches-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.users.ui.branch_access_title') %></h2>
            <p class="mt-0.5 text-xs text-slate-500"><%= t('admin.users.ui.branch_access_hint') %></p>
          </div>
        </header>
        <div class="p-5 sm:p-6">
          <% selected_branch_assignments = if params.dig(:user, :branch_role_assignments)
               Array(params.dig(:user, :branch_role_assignments))
             elsif editing
               @user.user_roles.active.where(branch_id: @branches.select(:id))
                    .pluck(:branch_id, :system_role_id).map { |branch_id, role_id| "#{branch_id}:#{role_id}" }
             else
               []
             end %>
          <%= hidden_field_tag 'user[branch_role_assignments][]', '' %>
          <% if @branches.any? && @branch_roles.any? %>
            <div class="space-y-3">
              <% @branches.each do |branch| %>
                <% selected_count = @branch_roles.count { |role| selected_branch_assignments.include?("#{branch.id}:#{role.id}") } %>
                <details class="group rounded-xl border border-slate-200 bg-white" <%= 'open' if selected_count.positive? %>>
                  <summary class="flex min-h-12 cursor-pointer list-none items-center gap-3 px-4 py-3 text-sm font-semibold text-slate-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 [&::-webkit-details-marker]:hidden">
                    <%= delta_icon('building-storefront', class: 'size-5 shrink-0 text-emerald-700') %>
                    <span class="min-w-0 flex-1 break-words"><%= branch.name %></span>
                    <% if selected_count.positive? %><span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs text-emerald-800"><%= selected_count %></span><% end %>
                    <%= delta_icon('chevron-down', class: 'size-4 shrink-0 text-slate-500 transition group-open:rotate-180') %>
                  </summary>
                  <div class="grid gap-2 border-t border-slate-100 p-3 sm:grid-cols-2">
                    <% @branch_roles.each do |role| %>
                      <% input_id = "user_branch_role_#{branch.id}_#{role.id}" %>
                      <label for="<%= input_id %>" class="flex cursor-pointer items-start gap-3 rounded-lg bg-slate-50 px-3 py-3 text-sm text-slate-700 transition hover:bg-emerald-50">
                        <%= check_box_tag 'user[branch_role_assignments][]', "#{branch.id}:#{role.id}",
                                          selected_branch_assignments.include?("#{branch.id}:#{role.id}"),
                                          id: input_id, class: 'mt-0.5 size-4 shrink-0 rounded border-slate-300 text-emerald-700 focus:ring-emerald-500' %>
                        <span class="min-w-0">
                          <span class="block break-words font-semibold"><%= system_role_name(role) %></span>
                          <% if system_role_description(role).present? %>
                            <span class="mt-1 block text-xs leading-5 text-slate-500"><%= system_role_description(role) %></span>
                          <% end %>
                        </span>
                      </label>
                    <% end %>
                  </div>
                </details>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-slate-500"><%= t('admin.users.ui.branch_access_empty') %></p>
          <% end %>
          <%= error_message_for(@user, :branch_role_assignments) %>
        </div>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="users-preferences-title">
        <header class="flex items-center gap-3 border-b border-slate-100 px-5 py-5 sm:px-6">
          <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-700"><%= delta_icon('adjustments-horizontal', class: 'size-6') %></span>
          <div>
            <h2 id="users-preferences-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.users.ui.form_preferences') %></h2>
            <p class="mt-0.5 text-xs text-slate-500"><%= t('admin.users.ui.form_preferences_hint') %></p>
          </div>
        </header>
        <div class="grid gap-5 p-5 sm:grid-cols-2 sm:p-6">
          <div class="min-w-0">
            <%= form.label :language_id, t('admin.users.form.fields.language'), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
            <div class="relative" data-controller="delta-select">
              <%= form.collection_select :language_id, @languages, :id, :name,
                                         { include_blank: t('admin.users.form.fields.language_placeholder') },
                                         class: "input-field min-h-11 w-full rounded-xl #{form_state_classes(@user, :language_id)} px-3.5 py-2.5 text-sm",
                                         aria: { invalid: @user.errors[:language_id].any? } %>
            </div>
            <%= error_message_for(@user, :language_id) %>
          </div>
          <div class="min-w-0">
            <%= form.label :theme, t('admin.users.form.fields.theme'), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
            <div class="relative" data-controller="delta-select">
              <%= form.select :theme,
                              @themes.map { |theme| [t("admin.users.themes.#{theme[:id]}", default: theme[:id].humanize), theme[:id]] },
                              { include_blank: true },
                              class: "input-field min-h-11 w-full rounded-xl #{form_state_classes(@user, :theme)} px-3.5 py-2.5 text-sm",
                              aria: { invalid: @user.errors[:theme].any? } %>
            </div>
            <%= error_message_for(@user, :theme) %>
          </div>
        </div>
      </section>

      <footer class="flex flex-wrap items-center justify-end gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:px-6">
        <%= link_to t('admin.users.form.buttons.back'), editing ? admin_user_path(@user) : admin_users_path,
                    class: 'inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-200 px-5 text-sm font-semibold text-slate-700 hover:bg-slate-50' %>
        <%= form.submit submit_label,
                        class: 'inline-flex min-h-11 cursor-pointer items-center justify-center rounded-xl bg-emerald-700 px-6 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700' %>
      </footer>
    </div>

    <aside class="space-y-4 xl:sticky xl:top-24" aria-label="<%= t('admin.users.ui.form_help_title') %>">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <span class="flex size-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><%= delta_icon('information-circle', class: 'size-6') %></span>
        <h2 class="mt-4 font-jakarta text-sm font-bold text-slate-900"><%= t('admin.users.ui.form_help_title') %></h2>
        <p class="mt-2 text-xs leading-6 text-slate-600"><%= t('admin.users.ui.form_help_body') %></p>
      </div>
      <% if editing %>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-center gap-3">
            <span class="flex size-12 shrink-0 items-center justify-center rounded-xl text-sm font-bold" style="<%= user_avatar_style(@user) %>" aria-hidden="true"><%= @user.initials %></span>
            <div class="min-w-0">
              <p class="truncate text-sm font-bold text-slate-900"><%= @user.display_name %></p>
              <p class="truncate text-xs text-slate-500"><%= @user.email %></p>
            </div>
          </div>
          <div class="mt-4"><%= user_status_badge(@user.status) %></div>
        </div>
      <% end %>
    </aside>
  <% end %>
</div>
