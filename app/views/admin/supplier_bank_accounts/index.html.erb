<section class="space-y-5" data-controller="supplier-bank-accounts" data-supplier-bank-accounts-per-page-value="8">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="font-jakarta text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"><%= t('admin.accounts_payable.bank_accounts') %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= t('admin.accounts_payable.bank_list.description') %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to admin_supplier_path(@supplier, tab: 'bank_accounts'), class: 'inline-flex min-h-10 items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-emerald-200 hover:bg-emerald-50 hover:text-emerald-800' do %>
        <%= icon('arrow-left', class: 'size-4') %>
        <%= t('admin.accounts_payable.bank_list.back_to_supplier') %>
      <% end %>
      <% if policy(SupplierBankAccount.new(organization: current_organization, supplier: @supplier)).create? %>
        <%= link_to new_admin_supplier_bank_account_path(@supplier), class: 'inline-flex min-h-10 items-center gap-2 rounded-xl bg-emerald-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' do %>
          <%= icon('plus', class: 'size-4') %>
          <%= t('admin.accounts_payable.new_bank') %>
        <% end %>
      <% end %>
    </div>
  </header>

  <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
    <div class="grid items-end gap-3 md:grid-cols-[minmax(0,1fr)_14rem]">
      <div class="min-w-0">
        <label for="bank-account-search" class="mb-1.5 block text-xs font-semibold text-slate-600"><%= t('admin.accounts_payable.bank_list.search') %></label>
        <div class="relative">
          <%= icon('magnifying-glass', class: 'pointer-events-none absolute left-3 top-1/2 size-5 -translate-y-1/2 text-slate-400') %>
          <input id="bank-account-search" type="search" autocomplete="off"
                 placeholder="<%= t('admin.accounts_payable.bank_list.search_placeholder') %>"
                 data-supplier-bank-accounts-target="search" data-action="input->supplier-bank-accounts#filter"
                 class="min-h-11 w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-3 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100">
        </div>
      </div>
      <div>
        <label for="bank-account-currency" class="mb-1.5 block text-xs font-semibold text-slate-600"><%= t('admin.accounts_payable.currency') %></label>
        <select id="bank-account-currency" data-supplier-bank-accounts-target="currency"
                data-action="change->supplier-bank-accounts#filter"
                class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm text-slate-800 outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100">
          <option value=""><%= t('admin.accounts_payable.bank_list.all_currencies') %></option>
          <% @accounts.map(&:currency_code).uniq.sort.each do |code| %>
            <option value="<%= code %>"><%= code %></option>
          <% end %>
        </select>
      </div>
    </div>
  </div>

  <% if @accounts.any? %>
    <div data-supplier-bank-accounts-target="list" class="grid min-w-0 gap-4 xl:grid-cols-2">
      <%= render partial: 'account_card', collection: @accounts, as: :account, locals: { supplier: @supplier } %>
    </div>
    <div data-supplier-bank-accounts-target="emptyFiltered" class="hidden rounded-2xl border border-dashed border-slate-200 bg-white px-6 py-12 text-center">
      <%= icon('magnifying-glass', class: 'mx-auto size-8 text-emerald-500') %>
      <p class="mt-3 font-jakarta text-base font-bold text-slate-900"><%= t('admin.accounts_payable.bank_list.no_results') %></p>
      <p class="mt-1 text-sm text-slate-500"><%= t('admin.accounts_payable.bank_list.no_results_hint') %></p>
    </div>
    <footer data-supplier-bank-accounts-target="pagination" class="hidden flex-wrap items-center justify-between gap-3 text-sm text-slate-500 sm:flex">
      <span data-supplier-bank-accounts-target="range"
            data-range-template="<%= t('admin.accounts_payable.bank_list.range', from: '{from}', to: '{to}', total: '{total}') %>">
        <%= t('admin.accounts_payable.bank_list.range', from: 1, to: [@accounts.size, 8].min, total: @accounts.size) %>
      </span>
      <div class="flex items-center gap-2">
        <button type="button" data-supplier-bank-accounts-target="previous"
                data-action="supplier-bank-accounts#previous" disabled
                aria-label="<%= t('admin.accounts_payable.bank_list.previous') %>"
                class="flex size-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-700 transition hover:border-emerald-200 hover:text-emerald-800 disabled:cursor-not-allowed disabled:opacity-40">
          <%= icon('chevron-left', class: 'size-4') %>
        </button>
        <span data-supplier-bank-accounts-target="page" class="rounded-lg bg-emerald-50 px-3 py-2 font-semibold tabular-nums text-emerald-800">1</span>
        <button type="button" data-supplier-bank-accounts-target="next"
                data-action="supplier-bank-accounts#next"
                aria-label="<%= t('admin.accounts_payable.bank_list.next') %>"
                class="flex size-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-700 transition hover:border-emerald-200 hover:text-emerald-800 disabled:cursor-not-allowed disabled:opacity-40">
          <%= icon('chevron-right', class: 'size-4') %>
        </button>
      </div>
    </footer>
  <% else %>
    <div data-bank-accounts-empty class="rounded-2xl border border-slate-200 bg-white px-5 py-8 shadow-sm sm:px-8 sm:py-10">
      <div class="mx-auto flex max-w-4xl flex-col items-center justify-center gap-6 md:flex-row md:gap-10">
        <%= image_tag 'sbankaccounts.png', alt: '', loading: 'lazy', class: 'h-auto w-48 shrink-0 sm:w-56' %>
        <div class="max-w-lg text-center md:text-left">
          <h2 class="font-jakarta text-xl font-bold text-slate-900"><%= t('admin.accounts_payable.bank_list.empty_title') %></h2>
          <p class="mt-2 text-sm leading-6 text-slate-500"><%= t('admin.accounts_payable.bank_list.empty_description') %></p>
          <% if policy(SupplierBankAccount.new(organization: current_organization, supplier: @supplier)).create? %>
            <%= link_to new_admin_supplier_bank_account_path(@supplier), class: 'mt-5 inline-flex min-h-10 items-center gap-2 rounded-xl bg-emerald-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-800' do %>
              <%= icon('plus', class: 'size-4') %>
              <%= t('admin.accounts_payable.new_bank') %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</section>
