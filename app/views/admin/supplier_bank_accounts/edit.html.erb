<% content_for :title, t('admin.accounts_payable.edit_bank') %>
<section data-bank-account-form-page="edit" class="mx-auto max-w-[1560px] space-y-6">
  <header class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="min-w-0">
        <p class="mb-2 text-xs font-bold uppercase tracking-wider text-emerald-700"><%= @supplier.name %></p>
        <h1 class="font-jakarta text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl"><%= t('admin.accounts_payable.edit_bank') %></h1>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-500"><%= t('admin.supplier_bank_form.edit_description') %></p>
      </div>
      <span class="inline-flex items-center gap-2 rounded-full bg-amber-50 px-4 py-2 text-xs font-bold text-amber-800">
        <%= icon('pencil', class: 'size-4') %><%= t('admin.supplier_bank_form.editing_badge') %>
      </span>
    </div>
  </header>
  <%= render 'form' %>
</section>
