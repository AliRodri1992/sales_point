<%= render 'admin/financials/errors', record: @account %>
<%= form_with model: @account,
              url: (@account.persisted? ? admin_supplier_bank_account_path(@supplier, @account) : admin_supplier_bank_accounts_path(@supplier)),
              method: (@account.persisted? ? :patch : :post),
              class: 'grid gap-4 sm:grid-cols-2', data: { controller: 'supplier-bank-clabe' } do |f| %>
  <div class="sm:col-span-2">
    <%= f.label :holder_name, t('admin.accounts_payable.holder_name'), class: 'block text-sm font-semibold' %>
    <%= f.text_field :holder_name, required: true, maxlength: 180,
                     class: 'mt-1 w-full rounded-xl border border-slate-300 p-3' %>
  </div>
  <div>
    <%= f.label :clabe, t('admin.accounts_payable.clabe'), class: 'block text-sm font-semibold' %>
    <%= f.password_field :clabe, autocomplete: 'off', inputmode: 'numeric', maxlength: 18,
                         placeholder: (@account.persisted? ? @account.masked_number : t('admin.supplier_bank_details.clabe_placeholder')),
                         data: { supplier_bank_clabe_target: 'clabe', action: 'input->supplier-bank-clabe#lookup' },
                         class: 'mt-1 w-full rounded-xl border border-slate-300 p-3' %>
    <p class="mt-1 text-xs text-slate-500"><%= t('admin.supplier_bank_details.clabe_hint') %></p>
  </div>
  <div>
    <%= f.label :sat_bank_code, t('admin.accounts_payable.bank'), class: 'block text-sm font-semibold' %>
    <%= f.collection_select :sat_bank_code, @banks, :code, :display_name,
                            { include_blank: t('admin.supplier_bank_details.select_bank') },
                            { data: { supplier_bank_clabe_target: 'bank' },
                              class: 'mt-1 w-full rounded-xl border border-slate-300 p-3' } %>
    <p class="mt-1 text-xs text-slate-500"><%= t('admin.supplier_bank_details.bank_hint') %></p>
  </div>
  <div>
    <%= f.label :bank_name, t('admin.accounts_payable.bank_name'), class: 'block text-sm font-semibold' %>
    <%= f.text_field :bank_name, maxlength: 120, class: 'mt-1 w-full rounded-xl border border-slate-300 p-3' %>
  </div>
  <div>
    <%= f.label :account_number, t('admin.accounts_payable.account_number'), class: 'block text-sm font-semibold' %>
    <%= f.password_field :account_number, autocomplete: 'off', inputmode: 'numeric', maxlength: 20,
                         placeholder: (@account.persisted? ? @account.masked_number : nil),
                         class: 'mt-1 w-full rounded-xl border border-slate-300 p-3' %>
  </div>
  <div>
    <%= f.label :card_number, t('admin.supplier_bank_details.card_number'), class: 'block text-sm font-semibold' %>
    <%= f.password_field :card_number, autocomplete: 'off', inputmode: 'numeric', maxlength: 19,
                         placeholder: (@account.persisted? && @account.card_last_four.present? ? "•••• #{@account.card_last_four}" : nil),
                         class: 'mt-1 w-full rounded-xl border border-slate-300 p-3' %>
    <p class="mt-1 text-xs text-slate-500"><%= t('admin.supplier_bank_details.card_hint') %></p>
  </div>
  <div>
    <%= f.label :account_type, t('admin.supplier_bank_details.account_type'), class: 'block text-sm font-semibold' %>
    <%= f.select :account_type,
                 SupplierBankAccount::ACCOUNT_TYPES.map { |type| [t("admin.supplier_bank_details.account_types.#{type}"), type] },
                 { include_blank: t('admin.supplier_bank_details.select_type') },
                 class: 'mt-1 w-full rounded-xl border border-slate-300 p-3' %>
  </div>
  <div>
    <%= f.label :currency_code, t('admin.accounts_payable.currency'), class: 'block text-sm font-semibold' %>
    <%= f.text_field :currency_code, maxlength: 3, required: true,
                     class: 'mt-1 w-full rounded-xl border border-slate-300 p-3' %>
  </div>
  <div>
    <%= f.label :status, t('admin.supplier_bank_details.status'), class: 'block text-sm font-semibold' %>
    <%= f.select :status,
                 SupplierBankAccount::STATUSES.map { |status| [t("admin.supplier_bank_details.statuses.#{status}"), status] },
                 {}, class: 'mt-1 w-full rounded-xl border border-slate-300 p-3' %>
  </div>
  <div>
    <%= f.label :verification_status, t('admin.supplier_bank_details.verification_status'), class: 'block text-sm font-semibold' %>
    <%= f.select :verification_status,
                 SupplierBankAccount::VERIFICATION_STATUSES.map { |status| [t("admin.supplier_bank_details.verification_states.#{status}"), status] },
                 {}, class: 'mt-1 w-full rounded-xl border border-slate-300 p-3' %>
    <% if @account.verified_at.present? %>
      <p class="mt-1 text-xs text-slate-500"><%= t('admin.supplier_bank_details.verified_at', date: l(@account.verified_at, format: :short)) %></p>
    <% end %>
  </div>
  <div class="sm:col-span-2">
    <%= f.label :blocked_reason, t('admin.supplier_bank_details.blocked_reason'), class: 'block text-sm font-semibold' %>
    <%= f.text_area :blocked_reason, rows: 2, maxlength: 500,
                    placeholder: t('admin.supplier_bank_details.blocked_reason_hint'),
                    class: 'mt-1 w-full rounded-xl border border-slate-300 p-3' %>
  </div>
  <div class="flex items-center gap-2 sm:col-span-2">
    <%= f.check_box :primary, class: 'size-4 accent-emerald-600' %>
    <%= f.label :primary, t('admin.accounts_payable.primary'), class: 'text-sm font-semibold' %>
  </div>
  <div class="flex gap-3 sm:col-span-2">
    <%= f.submit t('admin.accounts_payable.save'), class: 'rounded-xl bg-emerald-600 px-5 py-3 font-semibold text-white' %>
    <%= link_to t('admin.accounts_payable.back'), admin_supplier_bank_accounts_path(@supplier),
                class: 'rounded-xl border border-slate-300 px-5 py-3' %>
  </div>
<% end %>
