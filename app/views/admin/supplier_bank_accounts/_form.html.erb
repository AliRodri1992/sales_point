<% editing = @account.persisted? %>
<% non_field_errors = @account.errors.attribute_names & %i[base supplier organization] %>
<% if non_field_errors.any? %>
  <div role="alert" class="mb-5 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800">
    <% non_field_errors.each do |attribute| %>
      <% @account.errors.full_messages_for(attribute).each do |message| %>
        <p><%= message %></p>
      <% end %>
    <% end %>
  </div>
<% end %>
<%= form_with model: @account,
              url: (editing ? admin_supplier_bank_account_path(@supplier, @account) : admin_supplier_bank_accounts_path(@supplier)),
              method: (editing ? :patch : :post),
              html: { novalidate: true },
              class: 'grid min-w-0 items-start gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(18rem,22rem)]',
              data: {
                controller: 'supplier-bank-clabe supplier-bank-form',
                action: 'input->supplier-bank-form#refresh change->supplier-bank-form#refresh',
                supplier_bank_form_existing_digits_value: @account.last_four.presence || '',
                supplier_bank_form_bank_placeholder_value: t('admin.bank_cards.unknown_bank')
              } do |f| %>
  <div class="min-w-0 space-y-5">
    <div role="note" class="flex gap-3 rounded-2xl border border-emerald-100 bg-gradient-to-r from-emerald-50 to-teal-50 p-4 sm:p-5">
      <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-white text-emerald-700 shadow-sm"><%= icon('lock-closed', class: 'size-5') %></span>
      <div><p class="font-jakarta text-sm font-bold text-emerald-950"><%= t('admin.supplier_bank_form.secure_title') %></p>
        <p class="mt-1 text-xs leading-5 text-emerald-800"><%= t("admin.supplier_bank_form.#{editing ? 'secure_edit' : 'secure_new'}") %></p>
      </div>
    </div>

    <section data-bank-form-section="information" class="rounded-[22px] border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
      <header class="mb-5 flex items-center gap-3 border-b border-slate-100 pb-5">
        <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><%= icon('building-library', class: 'size-5') %></span>
        <div><h2 class="font-jakarta text-lg font-bold text-slate-900"><%= t('admin.supplier_bank_form.information_title') %></h2>
          <p class="mt-1 text-sm text-slate-500"><%= t('admin.supplier_bank_form.information_description') %></p></div>
      </header>
      <div class="grid min-w-0 gap-x-5 gap-y-5 sm:grid-cols-2">
        <div class="min-w-0 sm:col-span-2">
          <%= f.label :holder_name, t('admin.accounts_payable.holder_name'), class: 'mb-2 block text-sm font-semibold text-slate-800' %>
          <%= f.text_field :holder_name, autocomplete: 'off',
                           placeholder: t('admin.supplier_bank_form.holder_placeholder'),
                           data: { supplier_bank_form_target: 'holder' },
                           class: 'min-h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 aria-[invalid=true]:border-rose-400 aria-[invalid=true]:bg-rose-50 aria-[invalid=true]:focus:ring-rose-200',
                               aria: { invalid: @account.errors[:holder_name].any?,
                                   describedby: (@account.errors[:holder_name].any? ? 'supplier-bank-holder_name-errors' : nil) } %>
          <%= render 'field_errors', record: @account, attribute: :holder_name %>
        </div>
        <div class="min-w-0">
          <%= f.label :clabe, t('admin.accounts_payable.clabe'), class: 'mb-2 block text-sm font-semibold text-slate-800' %>
          <%= f.password_field :clabe, value: nil, autocomplete: 'new-password', inputmode: 'numeric',
                               placeholder: (editing ? @account.masked_number : t('admin.supplier_bank_details.clabe_placeholder')),
                               data: { supplier_bank_clabe_target: 'clabe', supplier_bank_form_target: 'clabe', action: 'input->supplier-bank-clabe#lookup' },
                               class: 'min-h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 aria-[invalid=true]:border-rose-400 aria-[invalid=true]:bg-rose-50 aria-[invalid=true]:focus:ring-rose-200',
                               aria: { invalid: @account.errors[:clabe].any?,
                                   describedby: (@account.errors[:clabe].any? ? 'supplier-bank-clabe-errors' : nil) } %>
          <%= render 'field_errors', record: @account, attribute: :clabe %>
          <p class="mt-2 text-xs leading-5 text-slate-500"><%= editing ? t('admin.supplier_bank_form.keep_secret') : t('admin.supplier_bank_details.clabe_hint') %></p>
        </div>
        <div class="min-w-0">
          <%= f.label :sat_bank_code, t('admin.accounts_payable.bank'), class: 'mb-2 block text-sm font-semibold text-slate-800' %>
          <%= f.collection_select :sat_bank_code, @banks, :code, :display_name,
                                  { include_blank: t('admin.supplier_bank_details.select_bank') },
                                  { data: { supplier_bank_clabe_target: 'bank', supplier_bank_form_target: 'bank' },
                                    class: 'min-h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 aria-[invalid=true]:border-rose-400 aria-[invalid=true]:bg-rose-50 aria-[invalid=true]:focus:ring-rose-200', aria: { invalid: @account.errors[:sat_bank_code].any?,
                                   describedby: (@account.errors[:sat_bank_code].any? ? 'supplier-bank-sat_bank_code-errors' : nil) } } %>
          <%= render 'field_errors', record: @account, attribute: :sat_bank_code %>
          <p class="mt-2 text-xs leading-5 text-slate-500"><%= t('admin.supplier_bank_details.bank_hint') %></p>
        </div>
        <div class="min-w-0">
          <%= f.label :bank_name, t('admin.accounts_payable.bank_name'), class: 'mb-2 block text-sm font-semibold text-slate-800' %>
          <%= f.text_field :bank_name, placeholder: t('admin.supplier_bank_form.bank_placeholder'),
                           data: { supplier_bank_form_target: 'bankName' }, class: 'min-h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 aria-[invalid=true]:border-rose-400 aria-[invalid=true]:bg-rose-50 aria-[invalid=true]:focus:ring-rose-200',
                               aria: { invalid: @account.errors[:bank_name].any?,
                                   describedby: (@account.errors[:bank_name].any? ? 'supplier-bank-bank_name-errors' : nil) } %>
          <%= render 'field_errors', record: @account, attribute: :bank_name %>
        </div>
        <div class="min-w-0">
          <%= f.label :account_type, t('admin.supplier_bank_details.account_type'), class: 'mb-2 block text-sm font-semibold text-slate-800' %>
          <%= f.select :account_type,
                       SupplierBankAccount::ACCOUNT_TYPES.map { |type| [t("admin.supplier_bank_details.account_types.#{type}"), type] },
                       { include_blank: t('admin.supplier_bank_details.select_type') },
                       { data: { supplier_bank_form_target: 'accountType' }, class: 'min-h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 aria-[invalid=true]:border-rose-400 aria-[invalid=true]:bg-rose-50 aria-[invalid=true]:focus:ring-rose-200', aria: { invalid: @account.errors[:account_type].any?,
                                   describedby: (@account.errors[:account_type].any? ? 'supplier-bank-account_type-errors' : nil) } } %>
          <%= render 'field_errors', record: @account, attribute: :account_type %>
        </div>
        <div class="min-w-0">
          <%= f.label :currency_code, t('admin.accounts_payable.currency'), class: 'mb-2 block text-sm font-semibold text-slate-800' %>
          <%= f.text_field :currency_code, autocomplete: 'off', placeholder: 'MXN',
                           class: 'min-h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 aria-[invalid=true]:border-rose-400 aria-[invalid=true]:bg-rose-50 aria-[invalid=true]:focus:ring-rose-200 uppercase',
                               aria: { invalid: @account.errors[:currency_code].any?,
                                   describedby: (@account.errors[:currency_code].any? ? 'supplier-bank-currency_code-errors' : nil) } %>
          <%= render 'field_errors', record: @account, attribute: :currency_code %>
        </div>
      </div>
    </section>

    <section data-bank-form-section="configuration" class="rounded-[22px] border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
      <header class="mb-5 flex items-center gap-3 border-b border-slate-100 pb-5">
        <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><%= icon('shield-check', class: 'size-5') %></span>
        <div><h2 class="font-jakarta text-lg font-bold text-slate-900"><%= t('admin.supplier_bank_form.configuration_title') %></h2>
          <p class="mt-1 text-sm text-slate-500"><%= t('admin.supplier_bank_form.configuration_description') %></p></div>
      </header>
      <div class="grid gap-5 sm:grid-cols-2">
        <% if editing %>
          <div class="min-w-0">
            <%= f.label :status, t('admin.supplier_bank_details.status'), class: 'mb-2 block text-sm font-semibold text-slate-800' %>
            <%= f.select :status, SupplierBankAccount::STATUSES.map { |status| [t("admin.supplier_bank_details.statuses.#{status}"), status] },
                         {}, { data: { supplier_bank_form_target: 'status' }, class: 'min-h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 aria-[invalid=true]:border-rose-400 aria-[invalid=true]:bg-rose-50 aria-[invalid=true]:focus:ring-rose-200', aria: { invalid: @account.errors[:status].any?,
                                   describedby: (@account.errors[:status].any? ? 'supplier-bank-status-errors' : nil) } } %>
          <%= render 'field_errors', record: @account, attribute: :status %>
          </div>
        <% end %>
        <div class="min-w-0">
          <p class="mb-2 text-sm font-semibold text-slate-800"><%= t('admin.supplier_bank_details.verification_status') %></p>
          <p data-bank-review-state="<%= @account.verification_status %>" class="inline-flex min-h-11 items-center rounded-xl bg-slate-50 px-4 text-sm font-semibold text-slate-700">
            <%= t("admin.supplier_bank_details.verification_states.#{@account.verification_status}") %>
          </p>
          <% if @account.verified_at.present? %>
            <p class="mt-2 text-xs text-emerald-800"><%= t('admin.supplier_bank_details.verified_at', date: l(@account.verified_at, format: :short)) %></p>
          <% end %>
        </div>
      </div>
      <% if editing %>
        <div data-supplier-bank-form-target="blockedReasonGroup" class="mt-5 <%= 'hidden' unless @account.status == 'blocked' || @account.errors[:blocked_reason].any? %>">
          <%= f.label :blocked_reason, t('admin.supplier_bank_details.blocked_reason'), class: 'mb-2 block text-sm font-semibold text-slate-800' %>
          <%= f.text_area :blocked_reason, rows: 3, placeholder: t('admin.supplier_bank_details.blocked_reason_hint'),
                          class: 'w-full resize-y rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none placeholder:text-slate-400 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 aria-[invalid=true]:border-rose-400 aria-[invalid=true]:bg-rose-50 aria-[invalid=true]:focus:ring-rose-200',
                               aria: { invalid: @account.errors[:blocked_reason].any?,
                                   describedby: (@account.errors[:blocked_reason].any? ? 'supplier-bank-blocked_reason-errors' : nil) } %>
          <%= render 'field_errors', record: @account, attribute: :blocked_reason %>
        </div>
      <% end %>
      <div class="mt-5 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-emerald-100 bg-emerald-50/50 p-4">
        <div class="flex min-w-0 flex-1 items-center gap-3">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-white text-emerald-700"><%= icon('star', class: 'size-5') %></span>
          <div><p class="text-sm font-semibold text-slate-900"><%= t('admin.accounts_payable.primary') %></p>
            <p class="mt-1 text-xs leading-5 text-slate-500"><%= t('admin.supplier_bank_form.primary_hint') %></p></div>
        </div>
        <label class="relative inline-flex cursor-pointer items-center" aria-label="<%= t('admin.accounts_payable.primary') %>">
          <%= f.check_box :primary, class: 'peer sr-only', data: { supplier_bank_form_target: 'primary' },
                               aria: { invalid: @account.errors[:primary].any?,
                                   describedby: (@account.errors[:primary].any? ? 'supplier-bank-primary-errors' : nil) } %>
          <%= render 'field_errors', record: @account, attribute: :primary %>
          <span class="h-7 w-12 rounded-full bg-slate-300 transition peer-checked:bg-emerald-700 peer-focus-visible:ring-4 peer-focus-visible:ring-emerald-200 after:absolute after:left-1 after:top-1 after:size-5 after:rounded-full after:bg-white after:shadow-sm after:transition after:content-[''] peer-checked:after:translate-x-5"></span>
        </label>
      </div>
    </section>

    <footer data-bank-form-actions class="flex flex-col gap-4 rounded-[22px] border border-emerald-100 bg-white p-4 shadow-sm sm:p-5">
      <div class="flex items-start gap-3"><%= icon('information-circle', class: 'mt-0.5 size-5 shrink-0 text-emerald-700') %>
        <div><p class="text-sm font-semibold text-slate-800"><%= t('admin.supplier_bank_form.action_title') %></p>
          <p class="mt-1 text-xs leading-5 text-slate-500"><%= t('admin.supplier_bank_form.action_description') %></p></div>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <%= link_to t('admin.supplier_bank_form.cancel'), admin_supplier_bank_accounts_path(@supplier),
                    class: 'inline-flex min-h-14 w-full items-center justify-center rounded-xl border border-slate-200 bg-white px-5 text-center text-sm font-bold text-slate-800 transition hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' %>
        <%= f.button type: :submit,
                     class: 'inline-flex min-h-14 w-full items-center justify-center gap-2 rounded-xl bg-emerald-800 px-5 text-sm font-bold text-white shadow-md shadow-emerald-950/10 transition hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' do %>
          <%= icon('check-circle', class: 'size-5') %><%= t("admin.supplier_bank_form.#{editing ? 'update_button' : 'create_button'}") %>
        <% end %>
      </div>
    </footer>
  </div>

  <aside data-bank-form-sidebar class="min-w-0 space-y-5 xl:sticky xl:top-6">
    <section class="overflow-hidden rounded-[22px] border border-emerald-100 bg-white shadow-sm">
      <div class="bg-gradient-to-br from-emerald-50 via-white to-teal-50 p-5">
        <div class="flex items-center gap-3">
          <%= image_tag 'deltin/waving.svg', alt: t('admin.supplier_bank_form.mascot_alt'),
                        class: 'h-32 w-32 shrink-0 object-contain sm:h-36 sm:w-36', loading: 'lazy' %>
          <div class="min-w-0"><h2 class="font-jakarta text-lg font-extrabold leading-snug text-emerald-950"><%= t('admin.supplier_bank_form.security_title') %></h2>
            <p class="mt-2 text-xs leading-5 text-slate-600"><%= t('admin.supplier_bank_form.security_description') %></p></div>
        </div>
      </div>
      <ul class="space-y-3 p-5 text-sm text-slate-700">
        <% %w[encrypted restricted no_cvv].each do |item| %>
          <li class="flex items-start gap-2"><%= icon('check-circle', class: 'mt-0.5 size-4 shrink-0 text-emerald-700') %>
            <span><%= t("admin.supplier_bank_form.#{item}") %></span></li>
        <% end %>
      </ul>
    </section>
    <section class="rounded-[22px] border border-slate-200 bg-white p-5 shadow-sm">
      <div class="mb-4 flex items-center justify-between gap-2">
        <h2 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.supplier_bank_form.preview_title') %></h2>
        <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-700"><%= t('admin.supplier_bank_form.preview_badge') %></span>
      </div>
      <div class="relative isolate flex min-h-[196px] min-w-0 flex-col justify-between overflow-hidden rounded-2xl bg-gradient-to-br from-emerald-950 via-emerald-800 to-teal-600 p-5 text-white shadow-lg shadow-emerald-900/10">
        <div class="pointer-events-none absolute -right-12 -top-12 -z-10 size-44 rounded-full border-[28px] border-white/10"></div>
        <div class="flex items-start justify-between gap-2">
          <p data-supplier-bank-form-target="previewBank" class="min-w-0 break-words font-jakarta text-lg font-extrabold"><%= @account.sat_bank&.name.presence || @account.bank_name.presence || t('admin.bank_cards.unknown_bank') %></p>
          <span data-supplier-bank-form-target="previewPrimary" class="shrink-0 rounded-full bg-white/15 px-2 py-1 text-[10px] font-semibold <%= 'hidden' unless @account.primary? %>"><%= t('admin.accounts_payable.primary') %></span>
        </div>
        <p data-supplier-bank-form-target="previewNumber" class="font-jakarta text-xl font-bold tracking-wider"><%= @account.masked_number %></p>
        <div class="grid grid-cols-2 gap-3 text-xs">
          <div class="min-w-0"><p class="text-[10px] uppercase tracking-wider text-emerald-100"><%= t('admin.accounts_payable.holder_name') %></p>
            <p data-supplier-bank-form-target="previewHolder" class="mt-1 break-words font-semibold"><%= @account.holder_name.presence || '—' %></p></div>
          <div class="min-w-0 text-right"><p class="text-[10px] uppercase tracking-wider text-emerald-100"><%= t('admin.supplier_bank_details.account_type') %></p>
            <p data-supplier-bank-form-target="previewType" class="mt-1 break-words font-semibold"><%= @account.account_type.present? ? t("admin.supplier_bank_details.account_types.#{@account.account_type}") : '—' %></p></div>
        </div>
      </div>
      <p class="mt-3 text-xs leading-5 text-slate-500"><%= t('admin.supplier_bank_form.preview_hint') %></p>
    </section>
    <section class="rounded-[22px] border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="mb-4 flex items-center gap-2 font-jakarta text-base font-bold text-slate-900">
        <%= icon('light-bulb', class: 'size-5 text-emerald-700') %><%= t('admin.supplier_bank_form.tips_title') %>
      </h2>
      <ol class="space-y-4">
        <% %w[tip_bank tip_clabe tip_primary].each_with_index do |key, index| %>
          <li class="flex items-start gap-3">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-sm font-bold text-emerald-800"><%= index + 1 %></span>
            <p class="pt-1 text-xs leading-5 text-slate-600"><%= t("admin.supplier_bank_form.#{key}") %></p>
          </li>
        <% end %>
      </ol>
    </section>
  </aside>
<% end %>
