<div data-phone-item class="min-w-0 rounded-xl border border-slate-200 bg-slate-50/40 p-4 transition hover:border-emerald-200 sm:p-5">
  <%= form.hidden_field :id if form.object.persisted? %>
  <%= form.hidden_field :_destroy, value: '0' %>
  <%= form.hidden_field :country_code, value: form.object.country_code.presence || 'MX' %>
  <div class="mb-4 flex flex-wrap items-start justify-between gap-3 border-b border-slate-100 pb-3">
    <div class="flex min-w-0 items-center gap-3">
      <span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
        <%= delta_icon('phone', class: 'size-4') %>
      </span>
      <div class="min-w-0">
        <p class="text-sm font-bold text-slate-900"><%= t(form.object.persisted? ? 'admin.supplier_details.contact_form.saved_phone_title' : 'admin.supplier_details.contact_form.new_phone_title') %></p>
        <p class="mt-0.5 truncate text-xs text-slate-500"><%= form.object.number.presence || t('admin.supplier_details.contact_form.phone_row_description') %></p>
      </div>
    </div>
    <button type="button" data-action="nested-phones#remove" aria-label="<%= "#{t('admin.phones.remove')}: #{form.object.number.presence || t('admin.supplier_details.contact_form.new_phone_title')}" %>"
            class="inline-flex min-h-9 shrink-0 items-center gap-1.5 rounded-lg border border-rose-100 bg-rose-50 px-3 text-xs font-semibold text-rose-700 transition hover:bg-rose-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-600">
      <%= delta_icon('trash', class: 'size-4') %>
      <%= t('admin.phones.remove') %>
    </button>
  </div>
  <div class="grid min-w-0 gap-x-4 gap-y-4 xl:grid-cols-2">
    <div class="min-w-0">
      <%= form.label :kind, t('admin.phones.kind'), class: 'mb-1.5 block text-xs font-bold text-slate-700' %>
      <div class="relative" data-controller="delta-select">
        <%= form.select :kind, %w[mobile landline other].map { |kind| [t("admin.phones.#{kind}"), kind] }, {},
                        data: { action: 'change->nested-phones#kindChanged' },
                        class: "min-h-11 w-full rounded-xl border bg-white px-3 text-sm #{form_state_classes(form.object, :kind)}" %>
      </div>
      <%= error_message_for(form.object, :kind) %>
    </div>
    <div class="min-w-0">
      <%= form.label :number, t('admin.phones.number'), class: 'mb-1.5 block text-xs font-bold text-slate-700' %>
      <div data-controller="international-phone" class="w-full [&_.iti]:w-full [&_.iti__tel-input]:w-full">
        <%= form.telephone_field :number, data: { international_phone_target: 'input', country_code: form.object.country_code.presence || 'MX' }, autocomplete: 'tel',
                                 class: "min-h-11 w-full rounded-xl border bg-white px-3 text-sm #{form_state_classes(form.object, :number)}",
                                 placeholder: '55 1234 5678' %>
      </div>
      <%= error_message_for(form.object, :number) %>
    </div>
    <div class="min-w-0">
      <%= form.label :extension, t('admin.phones.extension'), class: 'mb-1.5 block text-xs font-bold text-slate-700' %>
      <%= form.text_field :extension, maxlength: 10, class: "min-h-11 w-full rounded-xl border bg-white px-3 text-sm #{form_state_classes(form.object, :extension)}" %>
      <%= error_message_for(form.object, :extension) %>
    </div>
    <div class="min-w-0">
      <%= form.label :label, t('admin.phones.label'), class: 'mb-1.5 block text-xs font-bold text-slate-700' %>
      <%= form.text_field :label, maxlength: 60, class: "min-h-11 w-full rounded-xl border bg-white px-3 text-sm #{form_state_classes(form.object, :label)}" %>
      <%= error_message_for(form.object, :label) %>
    </div>
  </div>
  <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-slate-100 pt-4">
    <label class="inline-flex cursor-pointer items-center gap-2.5 text-xs font-semibold text-slate-700">
      <%= form.check_box :primary, class: 'peer sr-only', data: { action: 'change->nested-phones#primaryChanged' } %>
      <span aria-hidden="true" class="relative h-5 w-9 shrink-0 rounded-full bg-slate-300 transition peer-checked:bg-emerald-600 peer-focus-visible:ring-2 peer-focus-visible:ring-emerald-500 peer-focus-visible:ring-offset-2 after:absolute after:left-0.5 after:top-0.5 after:size-4 after:rounded-full after:bg-white after:shadow-sm after:transition-transform peer-checked:after:translate-x-4"></span>
      <%= t('admin.supplier_details.contact_form.phone_primary_label') %>
    </label>
    <label class="inline-flex cursor-pointer items-center gap-2.5 text-xs font-semibold text-slate-700">
      <%= form.check_box :whatsapp_enabled, class: 'peer sr-only' %>
      <span aria-hidden="true" class="relative h-5 w-9 shrink-0 rounded-full bg-slate-300 transition peer-checked:bg-emerald-600 peer-focus-visible:ring-2 peer-focus-visible:ring-emerald-500 peer-focus-visible:ring-offset-2 after:absolute after:left-0.5 after:top-0.5 after:size-4 after:rounded-full after:bg-white after:shadow-sm after:transition-transform peer-checked:after:translate-x-4"></span>
      WhatsApp
    </label>
  </div>
  <%= error_message_for(form.object, :primary) %>
  <%= error_message_for(form.object, :whatsapp_enabled) %>
</div>
