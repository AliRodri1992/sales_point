<div data-phone-item class="flex h-full min-w-0 flex-col rounded-xl border border-slate-200 bg-slate-50/70 p-4 transition hover:border-emerald-200 sm:p-5">
  <%= form.hidden_field :id if form.object.persisted? %>
  <%= form.hidden_field :_destroy, value: '0' %>
  <%= form.hidden_field :country_code, value: form.object.country_code.presence || 'MX' %>

  <div data-phone-fields class="flex min-w-0 flex-1 flex-col">
    <div class="mb-4 flex min-w-0 items-center justify-between gap-2 border-b border-slate-200/80 pb-3">
      <div class="flex min-w-0 items-center gap-2.5">
        <span data-phone-kind-icon aria-hidden="true" class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-white text-emerald-700 ring-1 ring-slate-200">
          <% %w[mobile landline other].each do |kind| %>
            <span data-phone-kind-icon-variant="<%= kind %>" class="<%= 'hidden' unless (form.object.kind.presence || 'mobile') == kind %>">
              <%= delta_icon(supplier_phone_icon_name(kind), class: 'size-4') %>
            </span>
          <% end %>
        </span>
        <h3 data-phone-kind-title class="min-w-0 text-sm font-bold text-slate-900">
          <%= t("admin.phones.#{form.object.kind.presence || 'mobile'}", default: t('admin.phones.other')) %>
        </h3>
      </div>
      <button type="button" data-action="nested-phones#remove"
              aria-label="<%= "#{t('admin.phones.remove')}: #{form.object.number.presence || t('admin.supplier_details.contact_form.new_phone_title')}" %>"
              class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg text-slate-500 transition hover:bg-rose-100 hover:text-rose-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-600"
              title="<%= t('admin.phones.remove') %>">
        <%= delta_icon('trash', class: 'size-4') %>
      </button>
    </div>

    <div class="min-w-0 space-y-3.5">
      <div class="min-w-0">
        <%= form.label :kind, t('admin.phones.kind'), class: 'mb-1.5 block text-xs font-semibold text-slate-700' %>
        <div class="relative" data-controller="delta-select">
          <%= form.select :kind, %w[mobile landline other].map { |kind| [t("admin.phones.#{kind}"), kind] }, {},
                          data: { action: 'change->nested-phones#kindChanged' },
                          class: "min-h-11 w-full rounded-xl border bg-white px-3 text-sm #{form_state_classes(form.object, :kind)}" %>
        </div>
        <%= error_message_for(form.object, :kind) %>
      </div>
      <div class="min-w-0">
        <%= form.label :number, t('admin.phones.number'), class: 'mb-1.5 block text-xs font-semibold text-slate-700' %>
        <div data-controller="international-phone" class="w-full [&_.iti]:w-full [&_.iti__tel-input]:w-full">
          <%= form.telephone_field :number,
                                   data: { international_phone_target: 'input', country_code: form.object.country_code.presence || 'MX' },
                                   autocomplete: 'tel',
                                   aria: { invalid: form.object.errors[:number].any? },
                                   class: "min-h-11 w-full rounded-xl border bg-white px-3 text-sm #{form_state_classes(form.object, :number)}",
                                   placeholder: '55 1234 5678' %>
        </div>
        <%= error_message_for(form.object, :number) %>
      </div>
      <div data-phone-extension class="min-w-0 max-w-48 <%= 'hidden' if (form.object.kind.presence || 'mobile') == 'mobile' %>">
        <%= form.label :extension, t('admin.phones.extension'), class: 'mb-1.5 block text-xs font-semibold text-slate-700' %>
        <%= form.text_field :extension, maxlength: 10,
                            class: "min-h-11 w-full rounded-xl border bg-white px-3 text-sm #{form_state_classes(form.object, :extension)}" %>
        <%= error_message_for(form.object, :extension) %>
      </div>
      <%= render 'admin/shared/phone_label_picker', form: form %>
    </div>

    <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-slate-200/80 pt-4 [&:not(:first-child)]:mt-4">
      <label class="inline-flex cursor-pointer items-center gap-2 text-xs font-semibold text-slate-700">
        <%= form.check_box :primary, class: 'peer sr-only', data: { action: 'change->nested-phones#primaryChanged' } %>
        <span aria-hidden="true" class="relative h-5 w-9 shrink-0 rounded-full bg-slate-300 transition peer-checked:bg-emerald-600 peer-focus-visible:ring-2 peer-focus-visible:ring-emerald-500 peer-focus-visible:ring-offset-2 after:absolute after:left-0.5 after:top-0.5 after:size-4 after:rounded-full after:bg-white after:shadow-sm after:transition-transform peer-checked:after:translate-x-4"></span>
        <%= t('admin.supplier_details.contact_form.phone_primary_label') %>
      </label>
      <label class="inline-flex cursor-pointer items-center gap-2 text-xs font-semibold text-slate-700">
        <%= form.check_box :whatsapp_enabled, class: 'peer sr-only' %>
        <span aria-hidden="true" class="relative h-5 w-9 shrink-0 rounded-full bg-slate-300 transition peer-checked:bg-emerald-600 peer-focus-visible:ring-2 peer-focus-visible:ring-emerald-500 peer-focus-visible:ring-offset-2 after:absolute after:left-0.5 after:top-0.5 after:size-4 after:rounded-full after:bg-white after:shadow-sm after:transition-transform peer-checked:after:translate-x-4"></span>
        WhatsApp
      </label>
      <%= error_message_for(form.object, :primary) %>
      <%= error_message_for(form.object, :whatsapp_enabled) %>
    </div>
  </div>

  <div data-phone-removed-message class="hidden flex-wrap items-center justify-between gap-3 rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900" role="status">
    <span class="font-semibold"><%= t('admin.supplier_details.contact_form.phone_removed_pending') %></span>
    <button type="button" data-action="nested-phones#undoRemove"
            class="inline-flex min-h-9 items-center gap-1.5 rounded-lg border border-amber-300 bg-white px-3 text-xs font-bold text-amber-900 hover:bg-amber-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700">
      <%= delta_icon('arrow-path', class: 'size-4') %>
      <%= t('admin.supplier_details.contact_form.undo_phone_removal') %>
    </button>
  </div>
</div>
