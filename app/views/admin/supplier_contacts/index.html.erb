<% deleted_contacts = @supplier.contacts.with_deleted.where.not(deleted_at: nil).order(deleted_at: :desc) %>
<% showing_deleted = params[:status] == 'deleted' %>
<% query = params[:q].to_s.strip.downcase %>
<% listed_contacts = showing_deleted ? deleted_contacts : @contacts %>
<% listed_contacts = listed_contacts.select { |contact| [contact.name, contact.position, contact.email].any? { |value| value.to_s.downcase.include?(query) } } if query.present? %>
<div class="space-y-6" data-loading-scope="true" data-controller="swal-confirm">
  <header class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700"><%= @supplier.code %> · <%= @supplier.name %></p>
        <h1 class="mt-1 font-jakarta text-2xl font-bold text-slate-900"><%= t('admin.supplier_details.contacts') %></h1>
        <p class="mt-2 text-sm text-slate-500"><%= t('admin.supplier_details.contacts_description') %></p>
      </div>
      <div class="flex flex-wrap gap-2">
        <%= link_to t('admin.supplier_details.back'), admin_supplier_path(@supplier, tab: 'contacts'), class: 'inline-flex min-h-10 items-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50' %>
        <% if policy(@supplier).manage_contacts? %>
          <%= link_to new_admin_supplier_contact_path(@supplier), class: 'inline-flex min-h-10 items-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-700' do %>
            <%= icon('plus', class: 'size-4') %>
            <%= t('admin.supplier_details.add_contact') %>
          <% end %>
        <% end %>
      </div>
    </div>
  </header>
  <div class="grid gap-3 sm:grid-cols-2">
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-xs font-semibold text-emerald-800"><%= t('admin.supplier_details.active_contacts') %></p>
        <div class="mt-2 flex items-center gap-2"><%= icon('users', class: 'size-5 text-emerald-700') %><p class="font-jakarta text-2xl font-bold text-slate-900"><%= @contacts.size %></p></div>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-xs font-semibold text-slate-600"><%= t('admin.supplier_details.deleted_contacts') %></p>
        <div class="mt-2 flex items-center gap-2"><%= icon('archive-box', class: 'size-5 text-slate-500') %><p class="font-jakarta text-2xl font-bold text-slate-900"><%= deleted_contacts.size %></p></div>
      </div>
  </div>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <nav class="inline-flex w-full flex-wrap gap-1 rounded-xl border border-slate-200 bg-slate-100 p-1 sm:w-auto" aria-label="<%= t('admin.supplier_details.contacts') %>">
      <%= link_to admin_supplier_contacts_path(@supplier), class: "inline-flex min-h-11 flex-1 items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold transition sm:flex-none #{showing_deleted ? 'text-slate-600 hover:bg-white/70' : 'bg-white text-emerald-700 shadow-sm'}", aria: { current: ('page' unless showing_deleted) } do %>
        <%= t('admin.supplier_details.active_contacts') %><span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-700"><%= @contacts.size %></span>
      <% end %>
      <%= link_to admin_supplier_contacts_path(@supplier, status: 'deleted'), class: "inline-flex min-h-11 flex-1 items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold transition sm:flex-none #{showing_deleted ? 'bg-white text-emerald-700 shadow-sm' : 'text-slate-600 hover:bg-white/70'}", aria: { current: ('page' if showing_deleted) } do %>
        <%= t('admin.supplier_details.deleted_contacts') %><span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-700"><%= deleted_contacts.size %></span>
      <% end %>
    </nav>
    <%= form_with url: admin_supplier_contacts_path(@supplier), method: :get, class: 'flex w-full items-center gap-2 sm:w-auto' do |form| %>
      <%= form.hidden_field :status, value: 'deleted' if showing_deleted %>
      <%= form.search_field :q, value: params[:q], placeholder: t('admin.supplier_details.search_contacts'), aria: { label: t('admin.supplier_details.search_contacts') }, class: 'min-w-0 flex-1 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 sm:w-60' %>
      <%= form.button class: 'inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-slate-600 hover:bg-slate-50', aria: { label: t('admin.supplier_details.search_contacts') } do %>
        <%= icon('magnifying-glass', class: 'size-5') %>
      <% end %>
    <% end %>
  </div>
  <% if showing_deleted %>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="font-semibold text-slate-800"><%= t('admin.supplier_details.deleted_contacts') %></p>
      <p class="mt-1 text-sm text-slate-500"><%= t('admin.supplier_details.deleted_contacts_description') %></p>
    </div>
  <% end %>
  <div class="grid items-stretch gap-4 md:grid-cols-2">
    <% listed_contacts.each do |contact| %>
      <article class="flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:border-emerald-200 hover:shadow-md">
        <div class="flex-1 p-5">
          <div class="flex flex-wrap items-start gap-3">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 font-jakarta text-sm font-bold text-emerald-700"><%= contact.name.to_s.split.first(2).map { |part| part.first.upcase }.join %></span>
            <div class="min-w-0 flex-1">
              <h2 class="break-words font-jakarta text-base font-bold text-slate-900"><%= contact.name %></h2>
              <% if contact.position.present? %><p class="mt-1 text-sm text-slate-500"><%= contact.position %></p><% end %>
            </div>
            <% if showing_deleted %>
              <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600"><%= t('admin.supplier_details.deleted_status') %></span>
            <% elsif contact.primary? %>
              <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700"><%= icon('check-circle', class: 'size-3.5') %><%= t('admin.supplier_details.primary') %></span>
            <% end %>
          </div>
          <div class="mt-5 space-y-3 border-t border-slate-100 pt-4">
            <% if contact.email.present? %><div class="flex items-start gap-3 text-sm text-slate-600"><%= icon('envelope', class: 'mt-0.5 size-4 shrink-0 text-slate-400') %><span class="min-w-0 break-all"><%= contact.email %></span></div><% end %>
            <% if contact.phone.present? %><div class="flex items-start gap-3 text-sm text-slate-600"><%= icon('phone', class: 'mt-0.5 size-4 shrink-0 text-slate-400') %><span><%= contact.phone %></span></div><% end %>
            <% if contact.mobile_phone.present? %><div class="flex items-start gap-3 text-sm text-slate-600"><%= icon('device-phone-mobile', class: 'mt-0.5 size-4 shrink-0 text-slate-400') %><span><%= contact.mobile_phone %></span></div><% end %>
            <% if showing_deleted %><p class="text-xs text-slate-500"><%= t('admin.supplier_details.deleted_on', date: l(contact.deleted_at.to_date, format: :long)) %></p><% end %>
          </div>
        </div>
        <% if policy(@supplier).manage_contacts? %>
          <div class="flex min-h-16 items-center justify-end gap-2 border-t border-slate-100 bg-slate-50/60 px-5 py-3">
            <% if showing_deleted %>
              <%= button_to restore_admin_supplier_contact_path(@supplier, contact), method: :patch, class: 'inline-flex min-h-10 items-center gap-2 rounded-xl border border-emerald-200 bg-white px-4 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-50' do %>
                <%= icon('arrow-path', class: 'size-4') %><%= t('admin.supplier_details.restore_contact') %>
              <% end %>
            <% else %>
              <%= link_to edit_admin_supplier_contact_path(@supplier, contact), class: 'inline-flex min-h-10 items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100' do %>
                <%= icon('pencil-square', class: 'size-4') %><%= t('admin.supplier_details.edit') %>
              <% end %>
              <%= button_to admin_supplier_contact_path(@supplier, contact), method: :delete, form: { data: { turbo_confirm: t('admin.supplier_details.confirm') } }, class: 'inline-flex min-h-10 items-center gap-2 rounded-xl border border-rose-200 bg-white px-4 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-50' do %>
                <%= icon('trash', class: 'size-4') %><%= t('admin.supplier_details.delete') %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </article>
    <% end %>
  </div>
  <% if listed_contacts.empty? %>
    <div class="rounded-2xl border border-dashed border-slate-200 bg-white p-10 text-center">
      <%= icon('users', class: 'mx-auto size-9 text-slate-400') %>
      <p class="mt-3 text-center text-sm font-semibold text-slate-700"><%= t('admin.supplier_details.no_contacts') %></p>
    </div>
  <% end %>
</div>
