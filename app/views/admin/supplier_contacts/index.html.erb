<div class="rounded-2xl border border-slate-200 bg-white p-6">
  <h1 class="text-xl font-bold"><%= t('admin.supplier_details.contacts') %> — <%= @supplier.name %></h1>
  <div class="my-4 flex gap-3">
    <%= link_to t('admin.supplier_details.add'), new_admin_supplier_contact_path(@supplier), class: 'rounded-lg bg-emerald-600 px-4 py-2 text-white' %>
    <%= link_to t('admin.supplier_details.back'), admin_supplier_path(@supplier), class: 'rounded-lg border px-4 py-2' %>
  </div>
  <ul class="divide-y">
    <% @contacts.each do |contact| %>
      <li class="flex flex-wrap items-center justify-between gap-3 py-3">
        <div>
          <strong><%= contact.name %></strong>
          <% if contact.primary? %><span class="text-emerald-700"><%= t('admin.supplier_details.primary') %></span><% end %>
          <p class="text-sm text-slate-500"><%= [contact.position, contact.email, contact.phone, contact.mobile_phone].reject(&:blank?).join(' · ') %></p>
        </div>
        <div class="flex gap-3">
          <%= link_to t('admin.supplier_details.edit'), edit_admin_supplier_contact_path(@supplier, contact) %>
          <%= button_to t('admin.supplier_details.delete'), admin_supplier_contact_path(@supplier, contact), method: :delete, data: { turbo_confirm: t('admin.supplier_details.confirm') }, class: 'text-rose-600' %>
        </div>
      </li>
    <% end %>
  </ul>
</div>
