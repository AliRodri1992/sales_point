<div class="mx-auto max-w-7xl space-y-6" data-controller="user-guide">
  <header class="rounded-2xl border border-emerald-100 bg-white p-5 shadow-sm sm:p-8">
    <span class="text-xs font-bold uppercase tracking-widest text-emerald-700">Delta POS · <%= t('admin.user_manual.eyebrow') %></span>
    <h1 class="mt-2 font-jakarta text-2xl font-bold text-slate-900 sm:text-3xl"><%= t('admin.supplier_closure.guide_title') %></h1>
    <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-600"><%= t('admin.user_manual.intro') %></p>
    <figure class="mt-5 overflow-hidden rounded-xl border border-slate-200 bg-slate-900">
      <%= image_tag 'guide/overview.svg', alt: t('admin.user_manual.overview_alt'),
                    class: 'block h-auto w-full', loading: 'eager', width: 1130, height: 240 %>
      <figcaption class="px-4 py-2.5 text-xs leading-5 text-slate-100"><%= t('admin.user_manual.overview_caption') %></figcaption>
    </figure>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-xs font-semibold text-slate-600">
      <p><%= @sections.sum { |section| section[:topics].size } %> <%= t('admin.user_manual.chapters') %> · <%= @sections.sum { |section| section[:topics].sum { |topic| Array(topic[:tasks]).size } } %> <%= t('admin.user_manual.visual_procedures') %></p>
      <div class="flex flex-wrap gap-2">
        <button type="button" data-action="click->user-guide#expandAll" class="rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-emerald-800 hover:bg-emerald-100"><%= t('admin.user_manual.expand_all') %></button>
        <button type="button" data-action="click->user-guide#collapseAll" class="rounded-lg border border-slate-200 px-3 py-2 text-slate-700 hover:bg-slate-50"><%= t('admin.user_manual.collapse_all') %></button>
      </div>
    </div>
    <div class="mt-6 max-w-2xl">
      <label for="guide-search" class="mb-2 block text-sm font-semibold text-slate-700"><%= t('admin.user_manual.search_label') %></label>
      <input id="guide-search" type="search" autocomplete="off"
             placeholder="<%= t('admin.user_manual.search_placeholder') %>"
             data-user-guide-target="search" data-action="input->user-guide#filter"
             class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100">
      <p class="mt-2 text-xs text-slate-500"><%= t('admin.user_manual.search_hint') %></p>
    </div>
  </header>

  <div class="grid items-start gap-6 lg:grid-cols-[16rem_minmax(0,1fr)]">
    <aside class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm lg:sticky lg:top-5">
      <h2 class="px-2 pb-3 font-jakarta text-sm font-bold text-slate-900"><%= t('admin.user_manual.contents') %></h2>
      <nav aria-label="<%= t('admin.user_manual.contents') %>" class="max-h-[65vh] space-y-4 overflow-y-auto">
        <% @sections.each do |section| %>
          <div data-user-guide-target="navSection">
            <h3 class="px-2 text-xs font-semibold uppercase tracking-wide text-slate-500"><%= section[:title] %></h3>
            <ul class="mt-2 space-y-1">
              <% section[:topics].each do |topic| %>
                <li data-user-guide-target="navItem" data-topic-id="<%= topic[:id] %>">
                  <a href="#guide-<%= topic[:id] %>" data-action="click->user-guide#jump"
                     class="block rounded-lg px-2 py-1.5 text-sm text-slate-700 transition hover:bg-emerald-50 hover:text-emerald-800">
                    <%= topic[:title] %>
                  </a>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </nav>
    </aside>

    <main id="guide-content" class="min-w-0 space-y-7">
      <% @sections.each do |section| %>
        <section data-user-guide-target="section" class="space-y-3">
          <div class="px-1">
            <h2 class="font-jakarta text-xl font-bold text-slate-900"><%= section[:title] %></h2>
            <p class="mt-1 text-sm text-slate-600"><%= section[:description] %></p>
          </div>
          <% section[:topics].each do |topic| %>
            <article id="guide-<%= topic[:id] %>" data-user-guide-target="topic"
                     data-topic-id="<%= topic[:id] %>" class="scroll-mt-6">
              <details class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" <%= 'open' if topic[:id] == 'onboarding' %>>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 transition hover:bg-slate-50 sm:p-6">
                  <span class="min-w-0">
                    <span class="block font-jakarta text-lg font-bold text-slate-900"><%= topic[:title] %></span>
                    <span class="mt-1 block text-sm leading-6 text-slate-600"><%= topic[:description] %></span>
                    <span class="mt-2 block text-xs font-semibold text-emerald-700"><%= Array(topic[:tasks]).size %> <%= t('admin.user_manual.procedures') %></span>
                  </span>
                  <%= delta_icon('chevron-down', class: 'size-5 shrink-0 text-emerald-700 transition group-open:rotate-180') %>
                </summary>
                <div class="space-y-6 border-t border-slate-100 px-5 py-5 sm:px-6">
                  <% if topic[:before].present? %>
                    <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
                      <p class="font-semibold"><%= t('admin.user_manual.before') %></p>
                      <p class="mt-1 leading-6"><%= topic[:before] %></p>
                    </div>
                  <% end %>
                  <% Array(topic[:tasks]).each_with_index do |task, task_index| %>
                    <div class="<%= 'border-t border-slate-100 pt-6' if task_index.positive? %>">
                      <h3 class="font-jakarta text-base font-bold text-slate-900"><%= task[:title] %></h3>

                      <div class="mt-4 grid items-start gap-5 xl:grid-cols-[minmax(0,1.12fr)_minmax(0,0.88fr)]">
                        <% illustration = "guide/#{topic[:id]}-#{task_index + 1}.svg" %>
                        <figure class="guide-diagram overflow-hidden rounded-xl border border-slate-200 bg-slate-50" data-topic="<%= topic[:id] %>" data-procedure="<%= task_index + 1 %>">
                          <button type="button" class="block w-full cursor-zoom-in text-left focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-emerald-600"
                                  data-action="click->user-guide#openIllustration"
                                  aria-label="<%= t('admin.user_manual.zoom_diagram', task: task[:title]) %>">
                            <%= image_tag illustration, loading: 'lazy', decoding: 'async',
                                          width: 1120, height: 500, class: 'block h-auto w-full',
                                          alt: t('admin.user_manual.diagram_alt', topic: topic[:title], task: task[:title]) %>
                          </button>
                          <figcaption class="flex items-center justify-between gap-3 border-t border-slate-200 bg-white px-3 py-2.5 text-xs text-slate-600">
                            <span><%= t('admin.user_manual.diagram_caption') %></span>
                            <span class="inline-flex shrink-0 items-center gap-1 font-semibold text-emerald-700"><%= delta_icon('arrow-up-right', class: 'size-3.5') %><%= t('admin.user_manual.zoom') %></span>
                          </figcaption>
                        </figure>
                        <div class="min-w-0">
                          <ol class="space-y-3">
                        <% Array(task[:steps]).each_with_index do |step, index| %>
                          <li class="flex items-start gap-3 text-sm leading-6 text-slate-700">
                            <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-xs font-bold text-emerald-800"><%= index + 1 %></span>
                            <span><%= step %></span>
                          </li>
                        <% end %>
                      </ol>
                      <% if task[:result].present? %>
                        <p class="mt-4 border-l-2 border-emerald-600 pl-3 text-sm leading-6 text-slate-700">
                          <strong class="text-slate-900"><%= t('admin.user_manual.result') %>:</strong> <%= task[:result] %>
                        </p>
                      <% end %>
                        </div>
                      </div>
                    </div>
                  <% end %>
                  <% if topic[:note].present? %>
                    <p class="rounded-xl bg-slate-50 px-4 py-3 text-sm leading-6 text-slate-700">
                      <strong><%= t('admin.user_manual.important') %>:</strong> <%= topic[:note] %>
                    </p>
                  <% end %>
                  <% if (destination = guide_module_path(topic[:id])) %>
                    <%= link_to destination, class: 'inline-flex items-center gap-2 rounded-lg bg-emerald-700 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-800' do %>
                      <%= t('admin.supplier_closure.open_module') %>
                      <%= delta_icon('arrow-up-right', class: 'size-4') %>
                    <% end %>
                  <% end %>
                </div>
              </details>
            </article>
          <% end %>
        </section>
      <% end %>
      <div data-user-guide-target="empty" role="status" class="hidden rounded-2xl border border-slate-200 bg-white p-8 text-center text-sm text-slate-600">
        <%= t('admin.user_manual.no_results') %>
      </div>
      <div class="pb-6 text-right">
        <a href="#guide-search" class="text-sm font-semibold text-emerald-800 hover:underline"><%= t('admin.user_manual.back_to_search') %> ↑</a>
      </div>
    </main>
  </div>
  <dialog data-user-guide-target="viewer"
          data-action="click->user-guide#closeOutside close->user-guide#clearIllustration"
          class="m-auto max-h-[94vh] w-[min(96vw,1250px)] max-w-none overflow-auto rounded-2xl border border-slate-200 bg-white p-0 shadow-2xl backdrop:bg-slate-950/80">
    <div class="sticky top-0 z-10 flex items-center justify-between gap-4 border-b border-slate-200 bg-white px-4 py-3">
      <p class="font-jakarta text-sm font-bold text-slate-900"><%= t('admin.user_manual.diagram_viewer_title') %></p>
      <button type="button" data-action="click->user-guide#closeIllustration"
              class="rounded-lg border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"><%= t('admin.user_manual.close_diagram') %></button>
    </div>
    <img data-user-guide-target="viewerImage" alt="" class="block h-auto w-full" width="1120" height="500">
    <p data-user-guide-target="viewerCaption" class="px-4 py-3 text-sm text-slate-600"></p>
  </dialog>
</div>
