<section class="mx-auto max-w-6xl space-y-6">
  <header class="rounded-2xl border border-emerald-100 bg-white p-6 shadow-sm sm:p-8">
    <span class="text-xs font-bold uppercase tracking-widest text-emerald-700">Delta POS</span>
    <h1 class="mt-2 font-jakarta text-3xl font-bold text-slate-900"><%= t('admin.supplier_closure.guide_title') %></h1>
    <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600"><%= t('admin.supplier_closure.guide_intro') %></p>
  </header>
  <nav aria-label="<%= t('admin.supplier_closure.guide_title') %>" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    <% @topics.each do |topic| %>
      <a href="#guide-<%= topic %>" class="rounded-xl border border-slate-200 bg-white p-4 text-sm font-semibold text-emerald-800 hover:border-emerald-400 hover:bg-emerald-50">
        <%= t("admin.supplier_closure.guide.#{topic}.title") %> →
      </a>
    <% end %>
  </nav>
  <div class="grid gap-4 lg:grid-cols-2">
    <% @topics.each_with_index do |topic, index| %>
      <article id="guide-<%= topic %>" class="scroll-mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center gap-3">
          <span class="flex size-9 items-center justify-center rounded-lg bg-emerald-100 text-sm font-bold text-emerald-800"><%= index + 1 %></span>
          <h2 class="font-jakarta text-lg font-bold text-slate-900"><%= t("admin.supplier_closure.guide.#{topic}.title") %></h2>
        </div>
        <p class="mt-3 text-sm leading-7 text-slate-600"><%= t("admin.supplier_closure.guide.#{topic}.description") %></p>
        <% if topic == 'suppliers' && policy(Supplier).index? %>
          <%= link_to t('admin.supplier_closure.open_module'), admin_suppliers_path,
                      class: 'mt-4 inline-flex font-semibold text-emerald-800 hover:underline' %>
        <% elsif topic == 'profile' %>
          <%= link_to t('admin.supplier_closure.open_module'), admin_profile_path,
                      class: 'mt-4 inline-flex font-semibold text-emerald-800 hover:underline' %>
        <% end %>
      </article>
    <% end %>
  </div>
</section>
