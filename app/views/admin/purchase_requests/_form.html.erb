<%= form_with model: [:admin, @request], class: 'space-y-5' do |form| %>
  <% if @request.errors.any? %><p class="rounded-xl bg-rose-50 p-3 text-sm text-rose-700"><%= @request.errors.full_messages.to_sentence %></p><% end %>
  <div class="grid gap-4 rounded-2xl border border-slate-200 bg-white p-6 md:grid-cols-2">
    <div><%= form.label :branch_id, t('admin.purchases.branch'), class: 'mb-2 block font-medium' %>
      <%= form.collection_select :branch_id, @branches, :id, :name, { include_blank: true },
                                 class: 'w-full rounded-xl border border-slate-200 p-3', required: true %></div>
    <div><%= form.label :needed_on, t('admin.purchases.needed_on'), class: 'mb-2 block font-medium' %>
      <%= form.date_field :needed_on, class: 'w-full rounded-xl border border-slate-200 p-3' %></div>
    <div class="md:col-span-2"><%= form.label :notes, t('admin.purchases.notes'), class: 'mb-2 block font-medium' %>
      <%= form.text_area :notes, rows: 2, class: 'w-full rounded-xl border border-slate-200 p-3' %></div>
  </div>
  <section class="rounded-2xl border border-slate-200 bg-white p-6">
    <h2 class="mb-4 font-semibold"><%= t('admin.purchases.items') %></h2>
    <%= form.fields_for :purchase_request_items do |item| %>
      <div class="mb-4 grid gap-3 border-b border-slate-100 pb-4 md:grid-cols-3">
        <%= item.hidden_field :id if item.object.persisted? %>
        <div><%= item.label :product_id, t('admin.purchases.product'), class: 'mb-1 block text-sm' %>
          <%= item.collection_select :product_id, @products, :id, :name, { include_blank: true },
                                     class: 'w-full rounded-xl border border-slate-200 p-3' %></div>
        <div><%= item.label :quantity, t('admin.purchases.quantity'), class: 'mb-1 block text-sm' %>
          <%= item.number_field :quantity, min: 0.001, step: 0.001, class: 'w-full rounded-xl border border-slate-200 p-3' %></div>
        <div><%= item.label :notes, t('admin.purchases.notes'), class: 'mb-1 block text-sm' %>
          <%= item.text_field :notes, class: 'w-full rounded-xl border border-slate-200 p-3' %></div>
      </div>
    <% end %>
  </section>
  <%= form.submit t('admin.purchases.save'), class: 'rounded-xl bg-emerald-600 px-5 py-3 font-semibold text-white' %>
<% end %>
