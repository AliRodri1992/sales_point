<%= render 'admin/financials/navigation' %>
<section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
  <div class="mb-5 flex flex-wrap justify-between gap-3">
    <h1 class="font-jakarta text-2xl font-bold"><%= t('admin.accounts_payable.payments') %></h1>
    <% if policy(SupplierPayment.new(organization: current_organization)).create? %>
      <%= link_to t('admin.accounts_payable.new_payment'), new_admin_supplier_payment_path, class: 'inline-flex min-h-11 items-center justify-center rounded-xl bg-emerald-700 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800' %>
    <% end %>
  </div>
  <div class="overflow-x-auto rounded-xl border border-slate-200"><table data-financial-table="payments" class="w-full min-w-[760px] text-left text-sm">
    <thead class="bg-slate-50"><tr><% %w[reference supplier paid_on amount status].each do |key| %><th class="p-3"><%= t("admin.accounts_payable.#{key}") %></th><% end %></tr></thead>
    <tbody><% @payments.each do |payment| %>
      <tr class="border-t border-slate-100"><td class="p-3"><%= link_to payment.reference.presence || "##{payment.id}", admin_supplier_payment_path(payment), class: 'font-semibold text-emerald-800 hover:underline' %></td>
      <td class="p-3"><%= payment.supplier.name %></td><td class="p-3"><%= l(payment.paid_on) %></td>
      <td class="p-3"><%= number_to_currency(payment.amount, unit: '') %> <%= payment.currency.code %></td>
      <td class="p-3"><%= render 'admin/financials/status_badge', status: payment.status %></td></tr>
    <% end %></tbody>
  </table></div>
  <% if @payments.empty? %><p role="status" class="py-10 text-center text-sm text-slate-500"><%= t('admin.accounts_payable.empty') %></p><% end %>
  <%= render 'admin/financials/pagination' %>
</section>

