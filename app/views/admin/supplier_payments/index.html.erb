<%= render 'admin/financials/navigation' %>
<section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="mb-5 flex flex-wrap justify-between gap-3">
    <h1 class="font-jakarta text-2xl font-bold"><%= t('admin.accounts_payable.payments') %></h1>
    <% if policy(SupplierPayment.new(organization: current_organization)).create? %>
      <%= link_to t('admin.accounts_payable.new_payment'), new_admin_supplier_payment_path, class: 'rounded-xl bg-emerald-600 px-4 py-2 text-sm font-semibold text-white' %>
    <% end %>
  </div>
  <div class="overflow-x-auto"><table class="min-w-full text-left text-sm">
    <thead class="bg-slate-50"><tr><% %w[reference supplier paid_on amount status].each do |key| %><th class="p-3"><%= t("admin.accounts_payable.#{key}") %></th><% end %></tr></thead>
    <tbody><% @payments.each do |payment| %>
      <tr class="border-t border-slate-100"><td class="p-3"><%= link_to payment.reference.presence || "##{payment.id}", admin_supplier_payment_path(payment), class: 'font-semibold text-emerald-700' %></td>
      <td class="p-3"><%= payment.supplier.name %></td><td class="p-3"><%= l(payment.paid_on) %></td>
      <td class="p-3"><%= number_to_currency(payment.amount, unit: '') %> <%= payment.currency.code %></td>
      <td class="p-3"><%= t("admin.accounts_payable.states.#{payment.status}") %></td></tr>
    <% end %></tbody>
  </table></div>
</section>

