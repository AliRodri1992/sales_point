<%= render 'admin/financials/navigation' %>
<section class="space-y-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <h1 class="font-jakarta text-2xl font-bold"><%= t('admin.accounts_payable.payment') %> #<%= @payment.id %></h1>
  <p class="text-sm text-slate-600"><%= @payment.supplier.name %> · <%= l(@payment.paid_on) %> · <%= t("admin.accounts_payable.states.#{@payment.status}") %></p>
  <p class="font-jakarta text-3xl font-bold"><%= number_to_currency(@payment.amount, unit: '') %> <%= @payment.currency.code %></p>
  <h2 class="text-lg font-semibold"><%= t('admin.accounts_payable.applications') %></h2>
  <% @payment.supplier_payment_allocations.includes(:account_payable).each do |allocation| %>
    <div class="flex justify-between border-b border-slate-100 py-2 text-sm">
      <%= link_to "##{allocation.account_payable_id}", admin_account_payable_path(allocation.account_payable), class: 'text-emerald-700' %>
      <%= number_to_currency(allocation.amount, unit: '') %>
    </div>
  <% end %>
  <% if @payment.draft? && policy(@payment).post? %>
    <%= form_with url: post_payment_admin_supplier_payment_path(@payment), class: 'space-y-4 rounded-xl bg-slate-50 p-5' do %>
      <h3 class="font-semibold"><%= t('admin.accounts_payable.apply_payment') %></h3>
      <p class="text-xs text-slate-500"><%= t('admin.accounts_payable.payment_hint') %></p>
      <%= select_tag 'allocations[][account_payable_id]',
                     options_from_collection_for_select(@payables.select { |p| p.supplier_invoice.currency_id == @payment.currency_id }, :id, :id),
                     prompt: t('admin.accounts_payable.select_payable'), required: true,
                     class: 'w-full rounded-xl border border-slate-300 p-3' %>
      <%= number_field_tag 'allocations[][amount]', @payment.amount, min: '0.01', step: '0.01', required: true,
                           class: 'w-full rounded-xl border border-slate-300 p-3' %>
      <%= submit_tag t('admin.accounts_payable.post'), class: 'rounded-xl bg-emerald-600 px-5 py-3 font-semibold text-white' %>
    <% end %>
  <% end %>
  <% if @payment.posted? && policy(@payment).reverse? %>
    <%= button_to t('admin.accounts_payable.reverse'), reverse_admin_supplier_payment_path(@payment),
                  form: { data: { turbo_confirm: t('admin.accounts_payable.confirm') } },
                  class: 'rounded-xl border border-rose-300 px-5 py-3 font-semibold text-rose-700' %>
  <% end %>
</section>

