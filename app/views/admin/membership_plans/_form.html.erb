<div class="max-w-6xl rounded-xl border border-slate-200 bg-white shadow-sm">
  <%= form_with model: @membership_plan, class: 'space-y-8 p-6 lg:p-8' do |form| %>
    <div class="grid gap-5 lg:grid-cols-2">
      <div>
        <%= form.label :name, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.text_field :name, class: "input-field w-full rounded-xl #{form_state_classes(@membership_plan, :name)} px-4 py-3 text-sm" %>
        <%= error_message_for(@membership_plan, :name) %>
      </div>
      <div>
        <%= form.label :slug, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.text_field :slug, class: "input-field w-full rounded-xl #{form_state_classes(@membership_plan, :slug)} px-4 py-3 text-sm" %>
        <%= error_message_for(@membership_plan, :slug) %>
      </div>
    </div>
    <div>
      <%= form.label :description, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
      <%= form.text_area :description, rows: 3, class: "input-field w-full rounded-xl #{form_state_classes(@membership_plan, :description)} px-4 py-3 text-sm" %>
      <%= error_message_for(@membership_plan, :description) %>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <%= form.label :price, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.number_field :price, step: '0.01', min: 0, class: "input-field w-full rounded-xl #{form_state_classes(@membership_plan, :price)} px-4 py-3 text-sm" %>
        <%= error_message_for(@membership_plan, :price) %>
      </div>
      <div>
        <%= form.label :currency, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.text_field :currency, maxlength: 3, class: "input-field w-full rounded-xl #{form_state_classes(@membership_plan, :currency)} px-4 py-3 text-sm" %>
        <%= error_message_for(@membership_plan, :currency) %>
      </div>
      <div>
        <%= form.label :billing_interval, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.select :billing_interval, [['Mensual', 'monthly'], ['Anual', 'yearly']], {}, class: 'input-field w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm' %>
        <%= error_message_for(@membership_plan, :billing_interval) %>
      </div>
      <div>
        <%= form.label :trial_days, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.number_field :trial_days, min: 0, class: "input-field w-full rounded-xl #{form_state_classes(@membership_plan, :trial_days)} px-4 py-3 text-sm" %>
        <%= error_message_for(@membership_plan, :trial_days) %>
      </div>
    </div>

    <div>
      <div class="mb-4">
        <h2 class="text-base font-semibold text-slate-800">Características y límites</h2>
        <p class="mt-1 text-sm text-slate-500">Selecciona las capacidades incluidas y define sus límites cuando corresponda.</p>
      </div>
      <div class="divide-y divide-slate-100 rounded-xl border border-slate-200">
        <% @features.each do |feature| %>
          <% selected = @selected_features[feature.id] %>
          <div class="grid gap-4 p-4 sm:grid-cols-[1fr_auto_180px] sm:items-center">
            <div>
              <p class="text-sm font-semibold text-slate-800"><%= feature.name %></p>
              <p class="text-xs text-slate-500"><%= feature.key %></p>
            </div>
            <label class="flex items-center gap-2 text-sm text-slate-600">
              <%= check_box_tag 'feature_ids[]', feature.id, selected&.enabled?, class: 'size-4 rounded border-slate-300 text-blue-600' %>
              Habilitada
            </label>
            <div>
              <%= number_field_tag "feature_limits[#{feature.id}]", selected&.limit, min: 0, placeholder: feature.value_type == 'integer' ? 'Límite' : 'Sin límite', class: 'w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm' %>
              <%= hidden_field_tag "feature_values[#{feature.id}]", selected&.value || (feature.value_type == 'boolean' ? 'true' : nil) %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :position, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.number_field :position, min: 0, class: "input-field w-full rounded-xl #{form_state_classes(@membership_plan, :position)} px-4 py-3 text-sm" %>
        <%= error_message_for(@membership_plan, :position) %>
      </div>
      <label class="flex items-center gap-3 rounded-xl border border-slate-200 px-4 py-3">
        <%= form.check_box :active, class: 'size-4 rounded border-slate-300 text-blue-600' %>
        <span class="text-sm font-semibold text-slate-700">Plan activo</span>
      </label>
    </div>

    <div class="flex justify-end border-t border-slate-100 pt-5">
      <%= form.submit submit_label, class: 'rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700' %>
    </div>
  <% end %>
</div>
