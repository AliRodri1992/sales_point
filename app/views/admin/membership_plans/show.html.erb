<% content_for :title, t('admin.membership_plans.show.title') %>
<div>
  <div class="mb-7 flex items-start justify-between gap-4">
    <div><h1 class="font-jakarta text-2xl font-bold text-slate-900"><%= @membership_plan.name %></h1><p class="mt-1 text-sm text-slate-500"><%= @membership_plan.description.presence || @membership_plan.slug %></p></div>
    <div class="flex gap-2">
      <%= link_to t('admin.membership_plans.show.back'), admin_membership_plans_path, class: 'rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700' %>
      <%= link_to t('admin.membership_plans.show.edit'), edit_admin_membership_plan_path(@membership_plan), class: 'rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white' %>
    </div>
  </div>
  <div class="grid gap-6 lg:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-1">
      <p class="text-sm text-slate-500">Precio</p>
      <p class="mt-1 text-3xl font-bold text-slate-900"><%= number_to_currency(@membership_plan.price, unit: '$') %></p>
      <p class="mt-1 text-sm text-slate-500"><%= @membership_plan.billing_interval == 'monthly' ? 'Mensual' : 'Anual' %></p>
      <p class="mt-5 text-sm text-slate-600">Prueba: <strong><%= @membership_plan.trial_days %> días</strong></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-2">
      <h2 class="text-base font-semibold text-slate-800"><%= t('admin.membership_plans.show.features') %></h2>
      <div class="mt-4 divide-y divide-slate-100">
        <% @plan_features.each do |plan_feature| %>
          <div class="flex items-center justify-between gap-4 py-3">
            <div><p class="text-sm font-semibold text-slate-800"><%= plan_feature.membership_feature.name %></p><p class="text-xs text-slate-500"><%= plan_feature.membership_feature.key %></p></div>
            <div class="text-right text-sm text-slate-600">
              <%= plan_feature.enabled? ? t('admin.membership_plans.show.enabled') : t('admin.membership_plans.show.disabled') %>
              <% if plan_feature.limit.present? %><span class="ml-2 font-semibold"><%= plan_feature.limit %></span><% elsif plan_feature.value == 'unlimited' %><span class="ml-2 font-semibold"><%= t('admin.membership_plans.show.unlimited') %></span><% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
