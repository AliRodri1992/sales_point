<% content_for :title, t('admin.membership_plans.index.page_title') %>
<div>
  <div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="font-jakarta text-2xl font-bold text-slate-900"><%= t('admin.membership_plans.index.title') %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= t('admin.membership_plans.index.subtitle') %></p>
    </div>
    <%= link_to new_admin_membership_plan_path, class: 'inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white' do %>
      <%= icon('plus', class: 'size-4') %><%= t('admin.membership_plans.index.new') %>
    <% end %>
  </div>
  <div class="grid gap-6 xl:grid-cols-3">
    <% @membership_plans.each do |plan| %>
      <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-xl font-bold text-slate-900"><%= plan.name %></h2>
            <p class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-400"><%= plan.slug %></p>
          </div>
          <span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= plan.active? ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500' %>"><%= plan.active? ? 'Activo' : 'Inactivo' %></span>
        </div>
        <div class="mt-6">
          <span class="text-3xl font-bold text-slate-900"><%= number_to_currency(plan.price, unit: '$', precision: 2) %></span>
          <span class="text-sm text-slate-500">/<%= plan.billing_interval == 'monthly' ? 'mes' : 'año' %></span>
        </div>
        <p class="mt-3 min-h-10 text-sm text-slate-500"><%= plan.description.presence || '—' %></p>
        <div class="mt-5 text-sm text-slate-600"><%= plan.membership_features.count %> características configuradas</div>
        <div class="mt-6 flex gap-2">
          <%= link_to t('admin.membership_plans.index.view'), admin_membership_plan_path(plan), class: 'rounded-lg border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700' %>
          <%= link_to t('admin.membership_plans.index.edit'), edit_admin_membership_plan_path(plan), class: 'rounded-lg bg-blue-50 px-3 py-2 text-sm font-semibold text-blue-700' %>
        </div>
      </article>
    <% end %>
  </div>
  <% if @membership_plans.empty? %>
    <div class="rounded-xl border border-slate-200 bg-white px-6 py-14 text-center shadow-sm">
      <h2 class="text-lg font-semibold text-slate-800"><%= t('admin.membership_plans.index.empty_title') %></h2>
      <p class="mt-1 text-sm text-slate-500"><%= t('admin.membership_plans.index.empty_subtitle') %></p>
    </div>
  <% end %>
</div>
