<header
  id="adminTopbar"
  class="sticky top-0 z-30 flex h-16 items-center justify-between border-b border-slate-200 bg-white px-4 lg:px-6"
>
  <div class="flex min-w-0 items-center gap-4">
    <button
      id="sidebarToggle"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-xl text-slate-500 transition hover:bg-slate-100 hover:text-slate-700"
      aria-label="<%= t('admin.shared.topbar.toggle_sidebar') %>"
    >
      <%= icon("bars-3", class: "size-5") %>
    </button>

    <div class="hidden min-w-0 sm:block">
      <p class="truncate text-sm font-semibold text-slate-800">
        <%= t('admin.shared.topbar.morning_greeting', name: 'Ivan') %>
      </p>

      <p class="truncate text-xs text-slate-400">
        <%= l(Time.current, format: :long) %>
      </p>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <%= render "admin/shared/branch_selector" %>

    <%= render "admin/shared/notifications" %>

    <%= render "admin/shared/language_selector" %>

    <%= render "admin/shared/user_menu" %>
  </div>
</header>