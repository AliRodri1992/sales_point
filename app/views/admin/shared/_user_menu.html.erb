<div class="relative">
  <button
    id="userMenuButton"
    type="button"
    class="flex items-center gap-2 rounded-xl p-1.5 transition hover:bg-slate-100"
    aria-label="<%= t('admin.shared.user_menu.toggle') %>"
  >
    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-blue-100 text-sm font-semibold text-blue-600">
      IR
    </span>

    <span class="hidden text-left lg:block">
      <span class="block text-sm font-semibold text-slate-700">
        Ivan Rodriguez
      </span>

      <span class="block text-xs text-slate-400">
        <%= t('admin.shared.sidebar.role_admin') %>
      </span>
    </span>

    <%= icon("chevron-down", class: "hidden size-4 text-slate-400 lg:block") %>
  </button>

  <div
    id="userMenu"
    class="absolute right-0 top-full z-50 mt-2 hidden w-56 rounded-xl border border-slate-200 bg-white p-2 shadow-lg"
  >
    <div class="border-b border-slate-100 px-3 py-3">
      <p class="text-sm font-semibold text-slate-800">
        Ivan Rodriguez
      </p>

      <p class="mt-0.5 text-xs text-slate-400">
        <%= t('admin.shared.sidebar.role_admin') %>
      </p>
    </div>

    <div class="py-1">
      <button
        type="button"
        class="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-medium text-slate-600 transition hover:bg-slate-50"
      >
        <%= icon("user", class: "size-4 text-slate-400") %>
        <span><%= t('admin.shared.user_menu.my_profile') %></span>
      </button>

      <button
        type="button"
        class="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-medium text-slate-600 transition hover:bg-slate-50"
      >
        <%= icon("cog-6-tooth", class: "size-4 text-slate-400") %>
        <span><%= t('admin.shared.user_menu.settings') %></span>
      </button>
    </div>

    <div class="border-t border-slate-100 pt-1">
      <%= button_to destroy_user_session_path,
                    method: :delete,
                    class: "flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-medium text-red-600 transition hover:bg-red-50" do %>
        <%= icon("arrow-right-start-on-rectangle", class: "size-4") %>
        <span><%= t('admin.shared.user_menu.sign_out') %></span>
      <% end %>
    </div>
  </div>
</div>