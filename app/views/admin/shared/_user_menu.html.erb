<div class="relative">
  <button
    id="userMenuButton"
    type="button"
    class="flex items-center gap-2 rounded-xl p-1.5 transition hover:bg-slate-100"
    aria-label="<%= t('admin.shared.user_menu.toggle') %>"
    aria-controls="userMenu"
    aria-expanded="false"
  >
    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-100 text-sm font-semibold text-emerald-700">
      <%= current_user.initials %>
    </span>

    <span class="hidden min-w-0 max-w-48 text-left lg:block">
      <span class="block truncate text-sm font-semibold text-slate-700" title="<%= current_user.display_name %>">
        <%= current_user.display_name %>
      </span>

      <span class="block text-xs text-slate-400">
        <%= sidebar_role_label(current_user) %>
      </span>
    </span>

    <%= icon("chevron-down", class: "hidden size-4 text-slate-400 lg:block") %>
  </button>

  <div
    id="userMenu"
    class="absolute right-0 top-full z-50 mt-2 hidden w-56 rounded-xl border border-slate-200 bg-white p-2 shadow-lg"
  >
    <div class="border-b border-slate-100 px-3 py-3">
      <p class="truncate text-sm font-semibold text-slate-800" title="<%= current_user.display_name %>">
        <%= current_user.display_name %>
      </p>

      <p class="mt-0.5 text-xs text-slate-400">
        <%= sidebar_role_label(current_user) %>
      </p>
    </div>

    <%= render 'admin/shared/account_menu_items' %>
  </div>
</div>