<div class="space-y-0.5 p-2">
  <%= link_to admin_profile_path,
              class: 'flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-medium text-slate-700 transition hover:bg-emerald-50 hover:text-emerald-800 focus-visible:outline-2 focus-visible:outline-emerald-600' do %>
    <%= icon('user', class: 'size-4 shrink-0') %>
    <span><%= t('admin.shared.user_menu.my_profile') %></span>
  <% end %>
  <%= link_to admin_guide_path,
              class: 'flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-medium text-slate-700 transition hover:bg-emerald-50 hover:text-emerald-800 focus-visible:outline-2 focus-visible:outline-emerald-600' do %>
    <%= icon('book-open', class: 'size-4 shrink-0') %>
    <span><%= t('admin.supplier_closure.user_guide') %></span>
  <% end %>
</div>
<div class="border-t border-slate-100 p-2">
  <%= button_to destroy_user_session_path, method: :delete,
                class: 'flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-medium text-rose-700 transition hover:bg-rose-50 focus-visible:outline-2 focus-visible:outline-rose-600' do %>
    <%= icon('arrow-right-start-on-rectangle', class: 'size-4 shrink-0') %>
    <span><%= t('admin.shared.user_menu.sign_out') %></span>
  <% end %>
</div>
