<footer class="border-t border-slate-200 bg-white px-6 pt-4 pb-24 sm:py-4 sm:pr-48">
  <div class="flex flex-col items-center justify-between gap-3 text-xs text-slate-500 sm:flex-row sm:flex-wrap">
    <p><%= t('admin.shared.footer.copyright', year: Time.current.year) %></p>
    <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
      <%= link_to t('admin.shared.footer.privacy'), authentication_document_url(:privacy),
                  class: 'inline-flex min-h-11 items-center rounded px-1 transition hover:text-slate-700 focus-visible:outline-2 focus-visible:outline-emerald-700' %>
      <% if (terms_url = authentication_document_url(:terms)) %>
        <%= link_to t('admin.shared.footer.terms'), terms_url,
                    class: 'inline-flex min-h-11 items-center rounded px-1 transition hover:text-slate-700 focus-visible:outline-2 focus-visible:outline-emerald-700' %>
      <% else %>
        <span class="max-w-64 text-center sm:text-left"><%= t('admin.shared.footer.terms_unavailable') %></span>
      <% end %>
      <span>v1.0.0</span>
    </div>
  </div>
</footer>
