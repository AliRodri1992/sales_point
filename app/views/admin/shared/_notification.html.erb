<% record = notification.record %>
<% type_label = notification_type_label(notification) %>

<% if record.is_a?(Language) %>
  <% action = notification.params[:action] || 'updated' %>
  <% actor = notification.params[:user] %>
  <% avatar_text = record.flag_iso.upcase %>
  <% title_text = t("admin.shared.notifications.language.#{action}", name: record.name, default: record.name) %>
  <% if actor %>
    <% subtitle_text = t('admin.shared.notifications.performed_by', user: actor.display_name) %>
  <% else %>
    <% subtitle_text = record.code %>
  <% end %>
<% elsif record.is_a?(Area) %>
  <% action = notification.params[:action] || 'updated' %>
  <% actor = notification.params[:user] %>
  <% avatar_text = record.name.to_s[0, 2].upcase %>
  <% title_text = t("admin.shared.notifications.area.#{action}", name: record.name, default: record.name) %>
  <% if actor %>
    <% subtitle_text = t('admin.shared.notifications.performed_by', user: actor.display_name) %>
  <% else %>
    <% subtitle_text = record.code %>
  <% end %>
<% else %>
  <% sender = record&.user %>
  <% avatar_text = sender ? sender.initials : "?" %>
  <% title_text = t('admin.shared.notifications.new_message') %>
  <% subtitle_text = record&.body || t('admin.shared.notifications.message_unavailable') %>
<% end %>

<button
  type="button"
  class="flex w-full gap-3 border-t border-slate-100 px-4 py-3 text-left transition hover:bg-slate-50 <%= notification.unread? ? "bg-blue-50/60" : "" %>"
>
  <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-blue-100 text-xs font-bold text-blue-600">
    <%= avatar_text %>
  </span>

  <span class="min-w-0">
    <span class="flex flex-wrap items-center gap-2">
      <span class="block text-sm font-medium <%= notification.unread? ? "text-slate-900" : "text-slate-700" %>">
        <%= title_text %>
      </span>

      <% if type_label %>
        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-slate-500">
          <%= type_label %>
        </span>
      <% end %>
    </span>

    <span class="mt-0.5 block truncate text-xs text-slate-500">
      <%= subtitle_text %>
    </span>

    <span class="mt-1 block text-[11px] text-slate-400">
      <%= time_ago_in_words(notification.created_at) %>
    </span>
  </span>

  <% if notification.unread? %>
    <span class="ml-auto mt-1 h-2 w-2 shrink-0 rounded-full bg-blue-600"></span>
  <% end %>
</button>
