<div id="notifications_header" class="flex items-center justify-between border-b border-slate-100 px-4 py-3">
  <div>
    <h3 class="text-sm font-semibold text-slate-900">
      <%= t('admin.shared.notifications.title') %>
    </h3>

    <p class="mt-0.5 text-xs text-slate-400">
      <%= notifications_subtitle(user) %>
    </p>
  </div>

  <%= render "admin/shared/notifications_mark_all_read", user: user %>
</div>
