<%# Dropdown content for language selector - used by Turbo Streams broadcast %>
<% current = current_language %>
<div id="language_selector_content" class="divide-y divide-slate-100">
  <% Language.available.order(:code).each do |language| %>
    <button
      type="button"
      data-action="click->language-selector#select"
      data-language="<%= language.code %>"
      data-flag="<%= language.flag_url %>"
      data-flag-srcset="<%= language.flag_srcset %>"
      class="language-option flex w-full items-center gap-3 px-3 py-2.5 text-left text-sm font-medium transition <%= language.id == current.id ? 'bg-emerald-500 text-white' : 'text-slate-600 hover:bg-emerald-50 hover:text-emerald-700' %>"
    >
      <img
        src="<%= language.flag_url %>"
        srcset="<%= language.flag_srcset %>"
        class="size-7 rounded-full object-cover"
        alt="<%= language.name %>"
      >

      <span class="flex-1">
        <%= language.name %>
      </span>

      <% if language.id == current.id %>
        <%= icon("check", variant: :solid, class: "size-3") %>
      <% end %>
    </button>
  <% end %>
</div>