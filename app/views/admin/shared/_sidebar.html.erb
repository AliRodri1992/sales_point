<aside
  id="adminSidebar"
  aria-label="<%= t('admin.shared.sidebar.navigation') %>"
  aria-labelledby="adminSidebarNavigationLabel"
  class="flex w-64 shrink-0 flex-col border-r border-slate-200 bg-white transition-all duration-300<%= current_user.sidebar_collapsed? ? " sidebar-collapsed" : "" %>"
>
  <span id="adminSidebarNavigationLabel" class="sr-only"><%= t('admin.shared.sidebar.navigation') %></span>
  <div class="flex h-20 items-center justify-between border-b border-slate-200 px-5">
    <a href="<%= admin_dashboard_path %>" aria-label="Delta POS" class="flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-linear-to-br from-emerald-500 to-blue-600 text-white shadow-sm">
        <%= icon("shopping-bag", variant: :solid, class: "size-5") %>
      </div>

      <div class="sidebar-brand">
        <p class="font-jakarta text-lg font-bold tracking-tight text-slate-900">
          Delta <span class="text-blue-600">POS</span>
        </p>

        <p class="-mt-1 text-[10px] font-semibold uppercase tracking-widest text-slate-400">
          <%= t('admin.shared.sidebar.business_os') %>
        </p>
      </div>
    </a>
    <button id="sidebarCloseButton" type="button"
            aria-label="<%= t('admin.shared.sidebar.close_navigation') %>"
            class="sidebar-mobile-close hidden size-10 shrink-0 items-center justify-center rounded-lg text-slate-600 hover:bg-emerald-50 hover:text-emerald-800 focus-visible:ring-2 focus-visible:ring-emerald-600 lg:hidden">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
           class="size-5" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>

  <nav aria-labelledby="adminSidebarNavigationLabel" class="flex-1 overflow-y-auto px-3 py-5">
    <div class="mb-6">
      <p class="mb-2 px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
        <%= t('admin.shared.sidebar.section_main') %>
      </p>

      <div class="space-y-1">
        <a
          href="<%= admin_dashboard_path %>"
          data-tooltip="<%= t('admin.shared.sidebar.dashboard') %>" aria-label="<%= t('admin.shared.sidebar.dashboard') %>"
          aria-current="<%= sidebar_item_active?('dashboard') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('dashboard') %>"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.dashboard') %></span>
        </a>

        <% if onboarding_pending? %>
          <% onboarding_progress = onboarding_progress_for_current_user %>
          <a
            href="<%= admin_onboarding_path %>"
            data-tooltip="<%= t('admin.shared.sidebar.onboarding.progress', percentage: onboarding_progress[:percentage]) %>" aria-label="<%= t('admin.shared.sidebar.onboarding.progress', percentage: onboarding_progress[:percentage]) %>"
            class="mt-2 flex items-center gap-3 rounded-xl border border-emerald-100 bg-emerald-50 px-3 py-2.5 transition hover:border-emerald-200 hover:bg-emerald-100"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5 shrink-0 text-emerald-600" aria-hidden="true"><path d="m3 5 2 2 4-4M3 13l2 2 4-4M13 6h8M13 14h8M3 21h18"/></svg>
            <div class="sidebar-label min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <span class="min-w-0 flex-1 text-xs font-semibold text-emerald-800">
                  <%= t('admin.shared.sidebar.onboarding.title') %>
                </span>
                <span class="text-xs font-bold text-emerald-700"><%= onboarding_progress[:percentage] %>%</span>
              </div>
              <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-emerald-100">
                <div class="h-full rounded-full bg-emerald-500" style="width: <%= onboarding_progress[:percentage] %>%"></div>
              </div>
            </div>
          </a>
        <% end %>
      </div>
    </div>

    <div class="mb-6">
      <p class="mb-2 px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
        <%= t('admin.shared.sidebar.section_operations') %>
      </p>

      <div class="space-y-1">
<% if current_organization && (current_user.admin? || current_user.permission?('purchases.view')) %>
          <a href="<%= admin_purchase_orders_path %>" data-tooltip="<%= t('admin.purchases.orders') %>" aria-label="<%= t('admin.purchases.orders') %>"
             aria-current="<%= sidebar_item_active?('purchase_orders') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('purchase_orders') %>">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true" data-sidebar-icon="purchase-orders"><rect x="5" y="5" width="14" height="17" rx="2"/><path d="M9 5V3h6v2M9 11h6M9 15h6M9 19h6"/></svg>
            <span class="sidebar-label"><%= t('admin.purchases.orders') %></span>
          </a>
        <% end %>

<% if current_organization && (current_user.admin? || current_user.permission?('accounts_payable.view')) %>
          <a href="<%= admin_account_payables_path %>"
             data-tooltip="<%= t('admin.accounts_payable.payables') %>" aria-label="<%= t('admin.accounts_payable.payables') %>"
             aria-current="<%= sidebar_item_active?('account_payables') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('account_payables') %>">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true" data-sidebar-icon="accounts-payable"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h9"/><path d="M13 2v5h5M8 11h7M8 15h3"/><circle cx="17" cy="17" r="4"/><path d="M17 14.5V17l1.5 1"/></svg>
            <span class="sidebar-label"><%= t('admin.accounts_payable.payables') %></span>
          </a>
        <% end %>

        <span aria-disabled="true" title="<%= t('admin.shared.sidebar.coming_soon') %>"
          data-tooltip="<%= t('admin.shared.sidebar.cash_register') %>"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600    cursor-not-allowed opacity-60"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true" data-sidebar-icon="cash-register"><path d="M5 9h14l2 11H3L5 9Z"/><path d="M7 9V4h10v5M8 13h2M14 13h2M8 16h8M9 20h6"/></svg>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.cash_register') %></span>
        </span>

        

        <a
          href="<%= admin_clients_path %>"
          data-tooltip="<%= t('admin.shared.sidebar.customers') %>" aria-label="<%= t('admin.shared.sidebar.customers') %>"
          aria-current="<%= sidebar_item_active?('clients') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('clients') %>"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M16 3.2a4 4 0 0 1 0 7.6M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/></svg>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.customers') %></span>
        </a>

        <a
          href="<%= admin_demo_requests_path %>"
          data-tooltip="<%= t('admin.shared.sidebar.demo_requests') %>" aria-label="<%= t('admin.shared.sidebar.demo_requests') %>"
          aria-current="<%= sidebar_item_active?('demo_requests') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('demo_requests') %>"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true" data-sidebar-icon="demo-requests"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 10h18"/><path d="m10 13 5 3-5 3v-6"/></svg>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.demo_requests') %></span>
        </a>

        <a
          href="<%= admin_suppliers_path %>"
          data-tooltip="<%= t('admin.shared.sidebar.suppliers') %>" aria-label="<%= t('admin.shared.sidebar.suppliers') %>"
          aria-current="<%= sidebar_item_active?('suppliers') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('suppliers') %>"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true" data-sidebar-icon="suppliers"><path d="M3 21V10l6 3V8l6 3V4h6v17H3Z"/><path d="M6.5 17h2M11.5 17h2M16.5 17h2"/></svg>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.suppliers') %></span>
        </a>

        <span aria-disabled="true" title="<%= t('admin.shared.sidebar.coming_soon') %>"
          data-tooltip="<%= t('admin.shared.sidebar.employees') %>"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600    cursor-not-allowed opacity-60"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true"><rect x="3" y="2" width="18" height="20" rx="3"/><circle cx="12" cy="9" r="3"/><path d="M6.5 19a5.5 5.5 0 0 1 11 0"/></svg>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.employees') %></span>
        </span>
      </div>
    </div>

    <div class="mb-6">
      <p class="mb-2 px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
        <%= t('admin.shared.sidebar.section_catalogs') %>
      </p>

      <div class="space-y-1">
        <details class="sidebar-catalog"<%= ' open' if sidebar_section_open?('languages', 'categories', 'products') %>>
          <summary
            class="flex cursor-pointer list-none items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
            data-tooltip="<%= t('admin.shared.sidebar.catalogs') %>"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true"><rect x="3" y="3" width="5" height="18" rx="1"/><rect x="10" y="3" width="5" height="18" rx="1"/><path d="m17 5 4-1 2 16-4 1-2-16Z"/></svg>
            <span class="sidebar-label flex-1"><%= t('admin.shared.sidebar.catalogs') %></span>
            <%= icon("chevron-down", class: "sidebar-chevron size-4 text-slate-400") %>
          </summary>

          <div class="sidebar-submenu ml-3 mt-1 space-y-1 border-l border-slate-200 pl-3">
            <a
              href="<%= admin_languages_path %>"
              data-tooltip="<%= t('admin.shared.sidebar.languages') %>" aria-label="<%= t('admin.shared.sidebar.languages') %>"
              aria-current="<%= sidebar_item_active?('languages') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('languages', variant: :submenu) %>"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="m5 8 6 6M4 14l6-6M3 8h10M8 4v4M12 21l5-11 5 11M14 17h6"/></svg>
              <span class="sidebar-label"><%= t('admin.shared.sidebar.languages') %></span>
            </a>

            <a
              href="<%= admin_products_path %>"
              data-tooltip="<%= t('admin.shared.sidebar.products') %>" aria-label="<%= t('admin.shared.sidebar.products') %>"
              aria-current="<%= sidebar_item_active?('products') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('products', variant: :submenu) %>"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="m12 2 9 5-9 5-9-5 9-5ZM3 7v10l9 5 9-5V7M12 12v10M7.5 4.5l9 5"/></svg>
              <span class="sidebar-label"><%= t('admin.shared.sidebar.products') %></span>
            </a>

            <% if (current_user.admin? || current_user.permission?('categories.access')) %>
              <a
                href="<%= admin_categories_path %>"
                data-tooltip="<%= t('admin.shared.sidebar.categories') %>" aria-label="<%= t('admin.shared.sidebar.categories') %>"
                aria-current="<%= sidebar_item_active?('categories') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('categories', variant: :submenu) %>"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="M12 3H4a1 1 0 0 0-1 1v8l9 9 9-9-9-9Z"/><circle cx="7.5" cy="7.5" r="1"/><path d="M16 3h3a2 2 0 0 1 2 2v3"/></svg>
                <span class="sidebar-label"><%= t('admin.shared.sidebar.categories') %></span>
              </a>
            <% end %>
          </div>
        </details>
      </div>
    </div>

    <div class="mb-6">
      <p class="mb-2 px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
        <%= t('admin.shared.sidebar.section_admin') %>
      </p>

      <div class="space-y-1">
        <span aria-disabled="true" title="<%= t('admin.shared.sidebar.coming_soon') %>"
          data-tooltip="<%= t('admin.shared.sidebar.reports') %>"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600    cursor-not-allowed opacity-60"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true"><path d="M3 3v18h18M7 16l5-5 4 3 5-7M17 7h4v4"/></svg>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.reports') %></span>
        </span>

        <details class="sidebar-catalog"<%= ' open' if sidebar_section_open?('system_roles', 'branches', 'users') %>>
          <summary
            class="flex cursor-pointer list-none items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
            data-tooltip="<%= t('admin.shared.sidebar.settings') %>"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a2 2 0 0 0 .4 2.2l-2.6 2.6a2 2 0 0 0-2.2-.4l-.8 2.6h-4.4L9 19.4a2 2 0 0 0-2.2.4l-2.6-2.6a2 2 0 0 0 .4-2.2L2 14.2V9.8L4.6 9a2 2 0 0 0-.4-2.2l2.6-2.6A2 2 0 0 0 9 4.6L9.8 2h4.4l.8 2.6a2 2 0 0 0 2.2-.4l2.6 2.6a2 2 0 0 0-.4 2.2l2.6.8v4.4l-2.6.8Z"/></svg>
            <span class="sidebar-label flex-1"><%= t('admin.shared.sidebar.settings') %></span>
            <%= icon("chevron-down", class: "sidebar-chevron size-4 text-slate-400") %>
          </summary>

          <div class="sidebar-submenu ml-3 mt-1 space-y-1 border-l border-slate-200 pl-3">
            <span aria-disabled="true" title="<%= t('admin.shared.sidebar.coming_soon') %>"
              class="flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium text-slate-500    cursor-not-allowed opacity-60"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="M4 7h9M17 7h3M4 17h3M11 17h9"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="17" r="2"/></svg>
              <span class="sidebar-label"><%= t('admin.shared.sidebar.general') %></span>
            </span>

            <a
              href="<%= system_roles_path %>"
              data-tooltip="<%= t('admin.shared.sidebar.roles_permissions') %>" aria-label="<%= t('admin.shared.sidebar.roles_permissions') %>"
              aria-current="<%= sidebar_item_active?('system_roles') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('system_roles', variant: :submenu) %>"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true" data-sidebar-icon="roles-permissions"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>
              <span class="sidebar-label"><%= t('admin.shared.sidebar.roles_permissions') %></span>
            </a>

            <a
              href="<%= admin_branches_path %>"
              data-tooltip="<%= t('admin.shared.sidebar.branches') %>" aria-label="<%= t('admin.shared.sidebar.branches') %>"
              aria-current="<%= sidebar_item_active?('branches') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('branches', variant: :submenu) %>"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true" data-sidebar-icon="branches"><rect x="3" y="9" width="8" height="12" rx="1"/><rect x="13" y="3" width="8" height="18" rx="1"/><path d="M6 13h2M6 17h2M16 7h2M16 11h2M16 15h2M3 21h18"/></svg>
              <span class="sidebar-label"><%= t('admin.shared.sidebar.branches') %></span>
            </a>

            <a
              href="<%= admin_users_path %>"
              data-tooltip="<%= t('admin.shared.sidebar.users') %>" aria-label="<%= t('admin.shared.sidebar.users') %>"
              aria-current="<%= sidebar_item_active?('users') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('users', variant: :submenu) %>"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true" data-sidebar-icon="users"><circle cx="9" cy="7" r="3"/><path d="M3 21v-2a6 6 0 0 1 10-4.5M16 7h5M18.5 4.5v5"/><path d="M14 21v-2a4 4 0 0 1 8 0v2"/></svg>
              <span class="sidebar-label"><%= t('admin.shared.sidebar.users') %></span>
            </a>

            <span aria-disabled="true" title="<%= t('admin.shared.sidebar.coming_soon') %>"
              class="flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium text-slate-500    cursor-not-allowed opacity-60"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true" data-sidebar-icon="taxes"><rect x="4" y="2" width="16" height="20" rx="2"/><rect x="7" y="5" width="10" height="4" rx=".5"/><path d="M8 13h2M14 13h2M8 17h2M14 17h2"/></svg>
              <span class="sidebar-label"><%= t('admin.shared.sidebar.taxes') %></span>
            </span>
          </div>
        </details>
      </div>
    </div>
  </nav>

  <div class="border-t border-slate-100 p-4">
    <div class="relative" data-tooltip="<%= current_user.display_name %>">
      <div class="sidebar-user-row flex items-center gap-3 p-2">
        <div class="flex h-9 w-9 min-w-9 items-center justify-center rounded-full bg-blue-100 text-sm font-bold text-blue-600">
          <%= current_user.initials %>
        </div>

        <div class="sidebar-user min-w-0 flex-1 overflow-hidden whitespace-nowrap">
          <p class="truncate text-sm font-semibold">
            <%= current_user.display_name %>
          </p>

          <p class="truncate text-xs text-slate-400">
            <%= sidebar_role_label(current_user) %>
          </p>
        </div>

        <button
          id="sidebarUserMenuButton"
          type="button"
          aria-expanded="false"
          aria-controls="sidebarUserMenu"
          aria-label="<%= t('admin.shared.user_menu.toggle') %>"
          class="user-menu-button flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
        >
          <%= icon("ellipsis-vertical", class: "size-5") %>
        </button>
      </div>

      <div
        id="sidebarUserMenu"
        class="absolute bottom-14 left-0 z-50 hidden w-60 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl"
      >
        <div class="border-b border-slate-100 px-4 py-3">
          <p class="truncate text-sm font-semibold text-slate-800">
            <%= current_user.display_name %>
          </p>

          <p class="mt-0.5 truncate text-xs text-slate-400">
            <%= sidebar_role_label(current_user) %>
          </p>
        </div>

        <div class="py-1">
          <%= link_to admin_profile_path,
                      class: "flex w-full items-center gap-3 px-4 py-2.5 text-left text-sm text-slate-600 transition hover:bg-slate-50 hover:text-emerald-800" do %>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-4 text-slate-400" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="9" r="3"/><path d="M5 19a8 8 0 0 1 14 0"/></svg>
            <span><%= t('admin.shared.user_menu.my_profile') %></span>
          <% end %>

          <span aria-disabled="true" title="<%= t('admin.shared.sidebar.coming_soon') %>"
            type="button"
