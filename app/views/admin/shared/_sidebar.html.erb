<aside
  id="adminSidebar"
  class="flex w-64 shrink-0 flex-col border-r border-slate-200 bg-white transition-all duration-300"
>
  <div class="flex h-16 items-center border-b border-slate-200 px-5">
    <a href="#" class="flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-600 text-white">
        <i class="fa-solid fa-layer-group"></i>
      </div>

      <div class="sidebar-brand">
        <p class="text-lg font-bold tracking-tight text-slate-900">
          NEXO
        </p>

        <p class="-mt-1 text-[10px] font-semibold uppercase tracking-widest text-blue-600">
          POS
        </p>
      </div>
    </a>
  </div>

  <nav class="flex-1 overflow-y-auto px-3 py-5">
    <div class="mb-6">
      <p class="mb-2 px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
        <%= t('admin.shared.sidebar.section_main') %>
      </p>

      <div class="space-y-1">
        <a
          href="#"
          class="flex items-center gap-3 rounded-xl bg-blue-50 px-3 py-2.5 text-sm font-semibold text-blue-600"
        >
          <i class="fa-solid fa-chart-pie w-5 text-center"></i>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.dashboard') %></span>
        </a>
      </div>
    </div>

    <div class="mb-6">
      <p class="mb-2 px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
        <%= t('admin.shared.sidebar.section_operations') %>
      </p>

      <div class="space-y-1">
        <a
          href="#"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <i class="fa-solid fa-cart-shopping w-5 text-center"></i>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.sales') %></span>
        </a>

        <a
          href="#"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <i class="fa-solid fa-cash-register w-5 text-center"></i>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.cash_register') %></span>
        </a>

        <a
          href="#"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <i class="fa-solid fa-boxes-stacked w-5 text-center"></i>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.inventory') %></span>
        </a>

        <a
          href="#"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <i class="fa-solid fa-users w-5 text-center"></i>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.customers') %></span>
        </a>

        <a
          href="#"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <i class="fa-solid fa-truck-field w-5 text-center"></i>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.suppliers') %></span>
        </a>

        <a
          href="#"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <i class="fa-solid fa-user-tie w-5 text-center"></i>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.employees') %></span>
        </a>
      </div>
    </div>

    <div class="mb-6">
      <p class="mb-2 px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
        <%= t('admin.shared.sidebar.section_admin') %>
      </p>

      <div class="space-y-1">
        <a
          href="#"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <i class="fa-solid fa-chart-column w-5 text-center"></i>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.reports') %></span>
        </a>

        <a
          href="#"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <i class="fa-solid fa-gear w-5 text-center"></i>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.settings') %></span>
        </a>
      </div>
    </div>
  </nav>

  <div class="border-t border-slate-200 p-3">
    <div class="flex items-center gap-3 rounded-xl px-3 py-2">
      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-blue-100 text-sm font-semibold text-blue-600">
        IR
      </div>

      <div class="sidebar-user min-w-0 flex-1">
        <p class="truncate text-sm font-semibold text-slate-800">
          Ivan Rodriguez
        </p>

        <p class="truncate text-xs text-slate-400">
          <%= t('admin.shared.sidebar.role_admin') %>
        </p>
      </div>

      <button
        type="button"
        class="text-slate-400 transition hover:text-slate-600"
      >
        <i class="fa-solid fa-ellipsis-vertical"></i>
      </button>
    </div>
  </div>
</aside>

<div id="sidebarOverlay" aria-hidden="true"></div>