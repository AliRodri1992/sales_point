<aside
  id="adminSidebar"
  aria-label="<%= t('admin.shared.sidebar.navigation') %>"
  aria-labelledby="adminSidebarNavigationLabel"
  class="flex w-64 shrink-0 flex-col border-r border-slate-200 bg-white transition-all duration-300<%= current_user.sidebar_collapsed? ? " sidebar-collapsed" : "" %>"
>
  <span id="adminSidebarNavigationLabel" class="sr-only"><%= t('admin.shared.sidebar.navigation') %></span>
  <div class="sidebar-header flex h-20 items-center justify-between border-b border-slate-200 px-5">
    <a href="<%= admin_dashboard_path %>" aria-label="Delta POS" class="sidebar-brand-link flex items-center gap-3 rounded-lg focus-visible:outline-2 focus-visible:outline-emerald-700">
      <%= image_tag 'delta-pos-favicon.svg', alt: '', class: 'sidebar-brand-mark size-9 shrink-0', aria: { hidden: true } %>

      <div class="sidebar-brand">
        <p class="font-jakarta text-lg font-bold tracking-tight text-slate-900">
          Delta <span class="text-emerald-700">POS</span>
        </p>

        <p class="-mt-1 text-[10px] font-semibold uppercase tracking-widest text-slate-400">
          <%= t('admin.shared.sidebar.business_os') %>
        </p>
      </div>
    </a>
    <button id="sidebarCloseButton" type="button"
            aria-label="<%= t('admin.shared.sidebar.close_navigation') %>"
            class="sidebar-mobile-close hidden size-10 shrink-0 items-center justify-center rounded-lg text-slate-600 hover:bg-emerald-50 hover:text-emerald-800 focus-visible:ring-2 focus-visible:ring-emerald-600 lg:hidden">
      <%= sidebar_navigation_icon(:close, class_name: 'size-5') %>
    </button>
  </div>

  <nav aria-labelledby="adminSidebarNavigationLabel" class="flex-1 overflow-y-auto px-3 py-5">
    <div class="mb-6">
      <p class="mb-2 px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
        <%= t('admin.shared.sidebar.section_main') %>
      </p>

      <div class="space-y-1">
        <a
          href="<%= admin_dashboard_path %>"
          data-tooltip="<%= t('admin.shared.sidebar.dashboard') %>" aria-label="<%= t('admin.shared.sidebar.dashboard') %>"
          aria-current="<%= sidebar_item_active?('dashboard') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('dashboard') %>"
        >
          <%= sidebar_navigation_icon(:dashboard, class_name: 'size-5') %>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.dashboard') %></span>
        </a>

        <% if onboarding_pending? %>
          <% onboarding_progress = onboarding_progress_for_current_user %>
          <a
            href="<%= admin_onboarding_path %>"
            data-tooltip="<%= t('admin.shared.sidebar.onboarding.progress', percentage: onboarding_progress[:percentage]) %>" aria-label="<%= t('admin.shared.sidebar.onboarding.progress', percentage: onboarding_progress[:percentage]) %>"
            class="mt-2 flex items-center gap-3 rounded-xl border border-emerald-100 bg-emerald-50 px-3 py-2.5 transition hover:border-emerald-200 hover:bg-emerald-100"
          >
            <%= sidebar_navigation_icon(:onboarding, class_name: 'size-5 shrink-0 text-emerald-600') %>
            <div class="sidebar-label min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <span class="min-w-0 flex-1 text-xs font-semibold text-emerald-800">
                  <%= t('admin.shared.sidebar.onboarding.title') %>
                </span>
                <span class="text-xs font-bold text-emerald-700"><%= onboarding_progress[:percentage] %>%</span>
              </div>
              <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-emerald-100">
                <div class="h-full rounded-full bg-emerald-500" style="width: <%= onboarding_progress[:percentage] %>%"></div>
              </div>
            </div>
          </a>
        <% end %>
      </div>
    </div>

    <div class="mb-6">
      <p class="mb-2 px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
        <%= t('admin.shared.sidebar.section_operations') %>
      </p>

      <div class="space-y-1">
<% if current_organization && (current_user.admin? || current_user.permission?('purchases.view')) %>
          <a href="<%= admin_purchase_orders_path %>" data-tooltip="<%= t('admin.purchases.orders') %>" aria-label="<%= t('admin.purchases.orders') %>"
             aria-current="<%= sidebar_item_active?('purchase_orders') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('purchase_orders') %>">
            <%= sidebar_navigation_icon(:purchase_orders, class_name: 'size-5') %>
            <span class="sidebar-label"><%= t('admin.purchases.orders') %></span>
          </a>
        <% end %>

<% if current_organization && (current_user.admin? || current_user.permission?('accounts_payable.view')) %>
          <a href="<%= admin_account_payables_path %>"
             data-tooltip="<%= t('admin.accounts_payable.payables') %>" aria-label="<%= t('admin.accounts_payable.payables') %>"
             aria-current="<%= sidebar_item_active?('account_payables') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('account_payables') %>">
            <%= sidebar_navigation_icon(:account_payables, class_name: 'size-5') %>
            <span class="sidebar-label"><%= t('admin.accounts_payable.payables') %></span>
          </a>
        <% end %>

        <span aria-disabled="true" title="<%= t('admin.shared.sidebar.coming_soon') %>"
          data-tooltip="<%= t('admin.shared.sidebar.cash_register') %>"
          aria-label="<%= t('admin.shared.sidebar.cash_register') %> — <%= t('admin.shared.sidebar.coming_soon') %>"
          class="sidebar-disabled-option flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 cursor-not-allowed opacity-60"
        >
          <%= sidebar_navigation_icon(:cash_register, class_name: 'size-5') %>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.cash_register') %></span>
        </span>

        

        <a
          href="<%= admin_clients_path %>"
          data-tooltip="<%= t('admin.shared.sidebar.customers') %>" aria-label="<%= t('admin.shared.sidebar.customers') %>"
          aria-current="<%= sidebar_item_active?('clients') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('clients') %>"
        >
          <%= sidebar_navigation_icon(:clients, class_name: 'size-5') %>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.customers') %></span>
        </a>

        <% if policy(DemoRequest).index? %>
        <a
          href="<%= admin_demo_requests_path %>"
          data-tooltip="<%= t('admin.shared.sidebar.demo_requests') %>" aria-label="<%= t('admin.shared.sidebar.demo_requests') %>"
          aria-current="<%= sidebar_item_active?('demo_requests') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('demo_requests') %>"
        >
          <%= sidebar_navigation_icon(:demo_requests, class_name: 'size-5') %>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.demo_requests') %></span>
        </a>
        <% end %>

        <% if current_organization && policy(Supplier).index? %>
        <a
          href="<%= admin_suppliers_path %>"
          data-tooltip="<%= t('admin.shared.sidebar.suppliers') %>" aria-label="<%= t('admin.shared.sidebar.suppliers') %>"
          aria-current="<%= sidebar_item_active?('suppliers') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('suppliers') %>"
        >
          <%= sidebar_navigation_icon(:suppliers) %>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.suppliers') %></span>
        </a>
        <% end %>

        <span aria-disabled="true" title="<%= t('admin.shared.sidebar.coming_soon') %>"
          data-tooltip="<%= t('admin.shared.sidebar.employees') %>"
          aria-label="<%= t('admin.shared.sidebar.employees') %> — <%= t('admin.shared.sidebar.coming_soon') %>"
          class="sidebar-disabled-option flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 cursor-not-allowed opacity-60"
        >
          <%= sidebar_navigation_icon(:employees, class_name: 'size-5') %>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.employees') %></span>
        </span>
      </div>
    </div>

    <div class="mb-6">
      <p class="mb-2 px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
        <%= t('admin.shared.sidebar.section_catalogs') %>
      </p>

      <div class="space-y-1">
        <details class="sidebar-catalog" data-section-active="<%= sidebar_section_open?('languages', 'categories', 'products') %>"<%= ' open' if sidebar_section_open?('languages', 'categories', 'products') %>>
          <summary
            class="flex cursor-pointer list-none items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
            aria-label="<%= t('admin.shared.sidebar.catalogs') %>"
            data-tooltip="<%= t('admin.shared.sidebar.catalogs') %>"
          >
            <%= sidebar_navigation_icon(:catalogs, class_name: 'size-5') %>
            <span class="sidebar-label flex-1"><%= t('admin.shared.sidebar.catalogs') %></span>
            <%= icon("chevron-down", class: "sidebar-chevron size-4 text-slate-400") %>
          </summary>

          <div class="sidebar-submenu ml-3 mt-1 space-y-1 border-l border-slate-200 pl-3">
            <a
              href="<%= admin_languages_path %>"
              data-tooltip="<%= t('admin.shared.sidebar.languages') %>" aria-label="<%= t('admin.shared.sidebar.languages') %>"
              aria-current="<%= sidebar_item_active?('languages') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('languages', variant: :submenu) %>"
            >
              <%= sidebar_navigation_icon(:languages, class_name: 'size-4') %>
              <span class="sidebar-label"><%= t('admin.shared.sidebar.languages') %></span>
            </a>

            <a
              href="<%= admin_products_path %>"
              data-tooltip="<%= t('admin.shared.sidebar.products') %>" aria-label="<%= t('admin.shared.sidebar.products') %>"
              aria-current="<%= sidebar_item_active?('products') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('products', variant: :submenu) %>"
            >
              <%= sidebar_navigation_icon(:products, class_name: 'size-4') %>
              <span class="sidebar-label"><%= t('admin.shared.sidebar.products') %></span>
            </a>

            <% if policy(Category).index? %>
              <a
                href="<%= admin_categories_path %>"
                data-tooltip="<%= t('admin.shared.sidebar.categories') %>" aria-label="<%= t('admin.shared.sidebar.categories') %>"
                aria-current="<%= sidebar_item_active?('categories') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('categories', variant: :submenu) %>"
              >
                <%= sidebar_navigation_icon(:categories, class_name: 'size-4') %>
                <span class="sidebar-label"><%= t('admin.shared.sidebar.categories') %></span>
              </a>
            <% end %>
          </div>
        </details>
      </div>
    </div>

    <div class="mb-6">
      <p class="mb-2 px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
        <%= t('admin.shared.sidebar.section_admin') %>
      </p>

      <div class="space-y-1">
        <span aria-disabled="true" title="<%= t('admin.shared.sidebar.coming_soon') %>"
          data-tooltip="<%= t('admin.shared.sidebar.reports') %>"
          aria-label="<%= t('admin.shared.sidebar.reports') %> — <%= t('admin.shared.sidebar.coming_soon') %>"
          class="sidebar-disabled-option flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 cursor-not-allowed opacity-60"
        >
          <%= sidebar_navigation_icon(:reports, class_name: 'size-5') %>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.reports') %></span>
        </span>

        <% if policy(SystemRole).index? || policy(Branch).index? || policy(User).index? %>
        <details class="sidebar-catalog" data-section-active="<%= sidebar_section_open?('system_roles', 'branches', 'users') %>"<%= ' open' if sidebar_section_open?('system_roles', 'branches', 'users') %>>
          <summary
            class="flex cursor-pointer list-none items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
            aria-label="<%= t('admin.shared.sidebar.settings') %>"
            data-tooltip="<%= t('admin.shared.sidebar.settings') %>"
          >
            <%= sidebar_navigation_icon(:settings, class_name: 'size-5') %>
            <span class="sidebar-label flex-1"><%= t('admin.shared.sidebar.settings') %></span>
            <%= icon("chevron-down", class: "sidebar-chevron size-4 text-slate-400") %>
          </summary>

          <div class="sidebar-submenu ml-3 mt-1 space-y-1 border-l border-slate-200 pl-3">
            <span aria-disabled="true" title="<%= t('admin.shared.sidebar.coming_soon') %>"
              aria-label="<%= t('admin.shared.sidebar.general') %> — <%= t('admin.shared.sidebar.coming_soon') %>"
              class="flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium text-slate-500    cursor-not-allowed opacity-60"
            >
              <%= sidebar_navigation_icon(:general, class_name: 'size-4') %>
              <span class="sidebar-label"><%= t('admin.shared.sidebar.general') %></span>
            </span>

            <% if policy(SystemRole).index? %>
            <a
              href="<%= system_roles_path %>"
              data-tooltip="<%= t('admin.shared.sidebar.roles_permissions') %>" aria-label="<%= t('admin.shared.sidebar.roles_permissions') %>"
              aria-current="<%= sidebar_item_active?('system_roles') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('system_roles', variant: :submenu) %>"
            >
              <%= sidebar_navigation_icon(:roles_permissions, class_name: 'size-4') %>
              <span class="sidebar-label"><%= t('admin.shared.sidebar.roles_permissions') %></span>
            </a>
            <% end %>

            <% if policy(Branch).index? %>
            <a
              href="<%= admin_branches_path %>"
              data-tooltip="<%= t('admin.shared.sidebar.branches') %>" aria-label="<%= t('admin.shared.sidebar.branches') %>"
              aria-current="<%= sidebar_item_active?('branches') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('branches', variant: :submenu) %>"
            >
              <%= sidebar_navigation_icon(:branches, class_name: 'size-4') %>
              <span class="sidebar-label"><%= t('admin.shared.sidebar.branches') %></span>
            </a>
            <% end %>

            <% if policy(User).index? %>
            <a
              href="<%= admin_users_path %>"
              data-tooltip="<%= t('admin.shared.sidebar.users') %>" aria-label="<%= t('admin.shared.sidebar.users') %>"
              aria-current="<%= sidebar_item_active?('users') ? 'page' : 'false' %>"
          class="<%= sidebar_link_classes('users', variant: :submenu) %>"
            >
              <%= sidebar_navigation_icon(:users, class_name: 'size-4') %>
              <span class="sidebar-label"><%= t('admin.shared.sidebar.users') %></span>
            </a>
            <% end %>

            <span aria-disabled="true" title="<%= t('admin.shared.sidebar.coming_soon') %>"
              aria-label="<%= t('admin.shared.sidebar.taxes') %> — <%= t('admin.shared.sidebar.coming_soon') %>"
              class="flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium text-slate-500    cursor-not-allowed opacity-60"
            >
              <%= sidebar_navigation_icon(:taxes, class_name: 'size-4') %>
              <span class="sidebar-label"><%= t('admin.shared.sidebar.taxes') %></span>
            </span>
          </div>
        </details>
        <% end %>
      </div>
    </div>
  </nav>

  <div class="sidebar-footer border-t border-slate-100 p-4">
    <div class="relative" data-tooltip="<%= current_user.display_name %>">
      <div class="sidebar-user-row flex items-center gap-3 p-2">
        <div class="sidebar-avatar flex h-9 w-9 min-w-9 items-center justify-center rounded-full bg-emerald-100 text-sm font-bold text-emerald-700">
          <%= current_user.initials %>
        </div>

        <div class="sidebar-user min-w-0 flex-1 overflow-hidden whitespace-nowrap">
          <p class="truncate text-sm font-semibold">
            <%= current_user.display_name %>
          </p>

          <p class="truncate text-xs text-slate-400">
            <%= sidebar_role_label(current_user) %>
          </p>
        </div>

        <button
          id="sidebarUserMenuButton"
          type="button"
          aria-expanded="false"
          aria-controls="sidebarUserMenu"
          aria-label="<%= t('admin.shared.user_menu.toggle') %>"
          class="user-menu-button flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-slate-400 transition hover:bg-emerald-50 hover:text-emerald-800 focus-visible:outline-2 focus-visible:outline-emerald-600"
        >
          <span class="sidebar-avatar-initials" aria-hidden="true"><%= current_user.initials %></span>
          <%= icon("ellipsis-vertical", class: "sidebar-menu-ellipsis size-5") %>
        </button>
      </div>

      <div
        id="sidebarUserMenu"
        class="absolute bottom-14 left-0 z-50 hidden w-60 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl"
      >
        <div class="border-b border-slate-100 px-4 py-3">
          <p class="truncate text-sm font-semibold text-slate-800">
            <%= current_user.display_name %>
          </p>

          <p class="mt-0.5 truncate text-xs text-slate-400">
            <%= sidebar_role_label(current_user) %>
          </p>
        </div>

        <%= render 'admin/shared/account_menu_items' %>
      </div>
    </div>
  </div>
</aside>

<div id="sidebarOverlay" aria-hidden="true"></div>