<aside
  id="adminSidebar"
  class="flex w-64 shrink-0 flex-col border-r border-slate-200 bg-white transition-all duration-300<%= current_user.sidebar_collapsed? ? " sidebar-collapsed" : "" %>"
>
  <div class="flex h-16 items-center border-b border-slate-200 px-5">
    <a href="#" class="flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-600 text-white">
        <%= icon("squares-2x2", variant: :solid, class: "size-5") %>
      </div>

      <div class="sidebar-brand">
        <p class="text-lg font-bold tracking-tight text-slate-900">
          NEXO
        </p>

        <p class="-mt-1 text-[10px] font-semibold uppercase tracking-widest text-blue-600">
          POS
        </p>
      </div>
    </a>
  </div>

  <nav class="flex-1 overflow-y-auto px-3 py-5">
    <div class="mb-6">
      <p class="mb-2 px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
        <%= t('admin.shared.sidebar.section_main') %>
      </p>

      <div class="space-y-1">
        <a
          href="<%= admin_dashboard_path %>"
          data-tooltip="<%= t('admin.shared.sidebar.dashboard') %>"
          class="flex items-center gap-3 rounded-xl bg-blue-50 px-3 py-2.5 text-sm font-semibold text-blue-600"
        >
          <%= icon("chart-pie", class: "size-5") %>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.dashboard') %></span>
        </a>
      </div>
    </div>

    <div class="mb-6">
      <p class="mb-2 px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
        <%= t('admin.shared.sidebar.section_operations') %>
      </p>

      <div class="space-y-1">
        <a
          href="#"
          data-tooltip="<%= t('admin.shared.sidebar.sales') %>"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <%= icon("shopping-cart", class: "size-5") %>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.sales') %></span>
        </a>

        <a
          href="#"
          data-tooltip="<%= t('admin.shared.sidebar.cash_register') %>"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <%= icon("banknotes", class: "size-5") %>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.cash_register') %></span>
        </a>

        <a
          href="#"
          data-tooltip="<%= t('admin.shared.sidebar.inventory') %>"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <%= icon("square-2-stack", class: "size-5") %>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.inventory') %></span>
        </a>

        <a
          href="#"
          data-tooltip="<%= t('admin.shared.sidebar.customers') %>"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <%= icon("users", class: "size-5") %>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.customers') %></span>
        </a>

        <a
          href="#"
          data-tooltip="<%= t('admin.shared.sidebar.suppliers') %>"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <%= icon("truck", class: "size-5") %>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.suppliers') %></span>
        </a>

        <a
          href="#"
          data-tooltip="<%= t('admin.shared.sidebar.employees') %>"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <%= icon("user", class: "size-5") %>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.employees') %></span>
        </a>
      </div>
    </div>

    <div class="mb-6">
      <p class="mb-2 px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
        <%= t('admin.shared.sidebar.section_catalogs') %>
      </p>

      <div class="space-y-1">
        <details class="sidebar-catalog">
          <summary
            class="flex cursor-pointer list-none items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
            data-tooltip="<%= t('admin.shared.sidebar.catalogs') %>"
          >
            <%= icon("clipboard-document-list", class: "size-5") %>
            <span class="sidebar-label flex-1"><%= t('admin.shared.sidebar.catalogs') %></span>
            <%= icon("chevron-down", class: "sidebar-chevron size-4 text-slate-400") %>
          </summary>

          <div class="sidebar-submenu ml-3 mt-1 space-y-1 border-l border-slate-200 pl-3">
            <a
              href="#"
              class="flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium text-slate-500 transition hover:bg-slate-50 hover:text-slate-900"
            >
              <%= icon("language", class: "size-4") %>
              <span class="sidebar-label"><%= t('admin.shared.sidebar.languages') %></span>
            </a>

            <a
              href="#"
              class="flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium text-slate-500 transition hover:bg-slate-50 hover:text-slate-900"
            >
              <%= icon("cube", class: "size-4") %>
              <span class="sidebar-label"><%= t('admin.shared.sidebar.products') %></span>
            </a>

            <a
              href="#"
              class="flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium text-slate-500 transition hover:bg-slate-50 hover:text-slate-900"
            >
              <%= icon("building-storefront", class: "size-4") %>
              <span class="sidebar-label"><%= t('admin.shared.sidebar.areas') %></span>
            </a>
          </div>
        </details>
      </div>
    </div>

    <div class="mb-6">
      <p class="mb-2 px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
        <%= t('admin.shared.sidebar.section_admin') %>
      </p>

      <div class="space-y-1">
        <a
          href="#"
          data-tooltip="<%= t('admin.shared.sidebar.reports') %>"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <%= icon("chart-bar", class: "size-5") %>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.reports') %></span>
        </a>

        <a
          href="#"
          data-tooltip="<%= t('admin.shared.sidebar.settings') %>"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <%= icon("cog-6-tooth", class: "size-5") %>
          <span class="sidebar-label"><%= t('admin.shared.sidebar.settings') %></span>
        </a>
      </div>
    </div>
  </nav>

  <div class="border-t border-slate-200 p-3">
    <div class="flex items-center gap-3 rounded-xl px-3 py-2" data-tooltip="<%= current_user.display_name %>">
      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-blue-100 text-sm font-semibold text-blue-600">
        <%= current_user.initials %>
      </div>

      <div class="sidebar-user min-w-0 flex-1">
        <p class="truncate text-sm font-semibold text-slate-800">
          <%= current_user.display_name %>
        </p>

        <p class="truncate text-xs text-slate-400">
          <%= t('admin.shared.sidebar.role_admin') %>
        </p>
      </div>

      <button
        type="button"
        class="text-slate-400 transition hover:text-slate-600"
      >
        <%= icon("ellipsis-vertical", class: "size-5") %>
      </button>
    </div>
  </div>
</aside>

<div id="sidebarOverlay" aria-hidden="true"></div>