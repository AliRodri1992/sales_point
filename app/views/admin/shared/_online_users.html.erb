<div
  id="onlineUsersPanel"
  data-controller="online-users"
  data-online-users-current-user-id-value="<%= current_user.id %>"
  class="panel-hidden fixed bottom-[104px] right-4 z-50 w-[calc(100vw-2rem)] max-w-[390px] overflow-hidden rounded-[26px] border border-slate-200/80 bg-white shadow-[0_24px_75px_-25px_rgba(15,23,42,.35)] sm:right-[94px]"
>
  <div class="flex items-center justify-between bg-gradient-to-r from-slate-950 to-slate-800 px-5 py-5">
    <div class="flex items-center gap-3">
      <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-emerald-500/15 text-emerald-300 ring-1 ring-emerald-400/20">
        <%= delta_icon("users", variant: :solid, class: "size-5") %>
      </div>
      <div>
        <p class="font-jakarta text-base font-bold text-white">
          <%= t("admin.shared.online_users.title") %>
        </p>
        <div class="flex items-center gap-1.5">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
          <span class="text-xs text-slate-300">
            <%= t("admin.shared.online_users.subtitle") %>
          </span>
        </div>
      </div>
    </div>
    <button
      id="onlineUsersCloseButton"
      type="button"
      class="flex h-9 w-9 items-center justify-center rounded-xl text-slate-300 transition hover:bg-white/10 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-white"
      aria-label="<%= t('admin.shared.online_users.close') %>"
    >
      <%= delta_icon("x-mark", class: "size-4") %>
    </button>
  </div>

  <%= turbo_stream_from "presence_#{current_user.id}" %>

  <%= render "admin/shared/online_users_list",
        users: User.where(id: User.online_user_ids, status: :active), viewer: current_user %>
</div>

<div
  id="conversationPanel"
  class="panel-hidden fixed bottom-[104px] right-4 z-50 w-[calc(100vw-2rem)] max-w-[390px] overflow-hidden rounded-[26px] border border-slate-200/80 bg-white shadow-[0_24px_75px_-25px_rgba(15,23,42,.35)] sm:right-[94px]"
>
  <turbo-frame id="conversation_panel">
    <div class="flex h-80 items-center justify-center p-8">
      <p class="text-sm text-slate-400">
        <%= t("admin.shared.conversation.select_user") %>
      </p>
    </div>
  </turbo-frame>
</div>

<button
  id="onlineUsersButton"
  type="button"
  class="fixed bottom-5 right-[94px] z-40 flex size-12 items-center justify-center rounded-2xl bg-emerald-600 text-white shadow-lg shadow-emerald-700/20 transition hover:-translate-y-0.5 hover:bg-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700"
  aria-label="<%= t('admin.shared.online_users.open') %>"
>
  <%= delta_icon("users", variant: :solid, class: "size-5") %>
</button>
