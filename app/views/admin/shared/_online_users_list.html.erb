<% visible_users = users.where.not(id: viewer.id).distinct.order(:username, :id) %>
<div id="online_users_list" class="max-h-[min(26rem,60vh)] overflow-y-auto px-4 py-4">
  <div class="mb-3 flex items-center justify-between">
    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500"><%= t("admin.shared.online_users.title") %></p>
    <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-bold tabular-nums text-emerald-700" aria-live="polite"><%= visible_users.size %></span>
  </div>
  <% if visible_users.exists? %>
    <div class="space-y-2">
      <% visible_users.each do |user| %>
        <div data-online-user-id="<%= user.id %>">
          <%= button_to conversations_path(participant_id: user.id),
                data: { turbo_frame: "conversation_panel" },
                class: "group flex w-full items-center gap-3 rounded-2xl border border-transparent bg-slate-50 px-3 py-3 text-left transition hover:border-emerald-200 hover:bg-emerald-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600" do %>
            <%= user_avatar(user, size: "h-11 w-11 text-sm", online_indicator: true) %>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-sm font-semibold text-slate-900"><%= user.display_name %></span>
              <span class="mt-0.5 flex items-center gap-1.5 text-xs text-slate-500">
                <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                <%= t("admin.shared.conversation.online") %>
              </span>
            </span>
            <%= delta_icon("chat-bubble-left-right", class: "size-4 shrink-0 text-slate-400 transition group-hover:text-emerald-700") %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="flex flex-col items-center rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-5 py-9 text-center">
      <span class="mb-3 flex size-12 items-center justify-center rounded-2xl bg-white text-emerald-600 shadow-sm"><%= delta_icon("users", class: "size-6") %></span>
      <p class="text-sm font-semibold text-slate-800"><%= t("admin.shared.online_users.empty") %></p>
      <p class="mt-2 max-w-[17rem] text-xs leading-5 text-slate-500"><%= t("admin.shared.online_users.empty_description") %></p>
    </div>
  <% end %>
</div>
