<div class="relative">
  <button
    id="notificationsButton"
    type="button"
    class="relative inline-flex h-10 w-10 items-center justify-center rounded-xl text-slate-500 transition hover:bg-slate-100 hover:text-slate-700"
    aria-label="Notificaciones"
  >
    <i class="fa-regular fa-bell"></i>

    <span
      class="absolute right-2 top-2 h-2 w-2 rounded-full bg-red-500 ring-2 ring-white"
    ></span>
  </button>

  <div
    id="notificationsMenu"
    class="absolute right-0 top-full z-50 mt-2 hidden w-80 rounded-xl border border-slate-200 bg-white shadow-lg"
  >
    <div class="flex items-center justify-between border-b border-slate-100 px-4 py-3">
      <div>
        <h3 class="text-sm font-semibold text-slate-900">
          Notificaciones
        </h3>

        <p class="mt-0.5 text-xs text-slate-400">
          Tienes nuevas notificaciones.
        </p>
      </div>

      <button
        type="button"
        class="text-xs font-medium text-blue-600 transition hover:text-blue-700"
      >
        Marcar todas como leídas
      </button>
    </div>

    <div class="max-h-80 overflow-y-auto">
      <button
        type="button"
        class="flex w-full gap-3 px-4 py-3 text-left transition hover:bg-slate-50"
      >
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-amber-50 text-amber-600">
          <i class="fa-solid fa-box"></i>
        </span>

        <span class="min-w-0">
          <span class="block text-sm font-medium text-slate-700">
            Stock bajo
          </span>

          <span class="mt-0.5 block text-xs text-slate-400">
            Hay productos que requieren reposición.
          </span>

          <span class="mt-1 block text-[11px] text-slate-400">
            Hace 10 minutos
          </span>
        </span>
      </button>

      <button
        type="button"
        class="flex w-full gap-3 border-t border-slate-100 px-4 py-3 text-left transition hover:bg-slate-50"
      >
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600">
          <i class="fa-solid fa-circle-check"></i>
        </span>

        <span class="min-w-0">
          <span class="block text-sm font-medium text-slate-700">
            Venta completada
          </span>

          <span class="mt-0.5 block text-xs text-slate-400">
            La venta #V-10245 fue registrada correctamente.
          </span>

          <span class="mt-1 block text-[11px] text-slate-400">
            Hace 25 minutos
          </span>
        </span>
      </button>

      <button
        type="button"
        class="flex w-full gap-3 border-t border-slate-100 px-4 py-3 text-left transition hover:bg-slate-50"
      >
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
          <i class="fa-solid fa-cash-register"></i>
        </span>

        <span class="min-w-0">
          <span class="block text-sm font-medium text-slate-700">
            Caja abierta
          </span>

          <span class="mt-0.5 block text-xs text-slate-400">
            La sesión de caja está activa.
          </span>

          <span class="mt-1 block text-[11px] text-slate-400">
            Hace 1 hora
          </span>
        </span>
      </button>
    </div>

    <div class="border-t border-slate-100 p-2">
      <button
        type="button"
        class="w-full rounded-lg px-3 py-2 text-center text-sm font-medium text-blue-600 transition hover:bg-blue-50"
      >
        Ver todas las notificaciones
      </button>
    </div>
  </div>
</div>