<div class="relative">
  <button
    id="branchSelectorButton"
    type="button"
    class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50"
  >
    <%= icon("building-storefront", variant: :solid, class: "size-4 text-blue-600") %>

    <span class="hidden sm:inline">
      <%= t('admin.shared.branch_selector.branch_center') %>
    </span>

    <%= icon("chevron-down", class: "size-3 text-slate-400") %>
  </button>

  <div
    id="branchSelectorMenu"
    class="absolute right-0 top-full z-50 mt-2 hidden w-56 rounded-xl border border-slate-200 bg-white p-2 shadow-lg"
  >
    <button
      type="button"
      class="flex w-full items-center gap-3 rounded-lg bg-blue-50 px-3 py-2.5 text-left text-sm font-medium text-blue-700"
    >
      <%= icon("building-storefront", class: "size-4") %>

      <span class="flex-1">
        <%= t('admin.shared.branch_selector.branch_center') %>
      </span>

      <%= icon("check", variant: :solid, class: "size-3") %>
    </button>

    <button
      type="button"
      class="mt-1 flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-medium text-slate-600 transition hover:bg-slate-50"
    >
      <%= icon("building-storefront", class: "size-4") %>

      <span>
        <%= t('admin.shared.branch_selector.branch_north') %>
      </span>
    </button>

    <button
      type="button"
      class="mt-1 flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-medium text-slate-600 transition hover:bg-slate-50"
    >
      <%= icon("building-storefront", class: "size-4") %>

      <span>
        <%= t('admin.shared.branch_selector.branch_south') %>
      </span>
    </button>
  </div>
</div>