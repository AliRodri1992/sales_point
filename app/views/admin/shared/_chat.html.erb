<div
  id="chatPanel"
  class="chat-hidden fixed bottom-24 right-6 z-50 w-[calc(100vw-3rem)] max-w-sm overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl"
>
  <div class="flex items-center justify-between border-b border-slate-200 bg-slate-900 px-4 py-3">
    <div class="flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-600 text-white">
        <i class="fa-solid fa-headset"></i>
      </div>

      <div>
        <p class="text-sm font-semibold text-white">
          <%= t('admin.shared.chat.assistant_name') %>
        </p>

        <div class="flex items-center gap-1.5">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
          <span class="text-xs text-slate-300">
            <%= t('admin.shared.chat.online') %>
          </span>
        </div>
      </div>
    </div>

    <button
      id="chatCloseButton"
      type="button"
      class="flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-white/10 hover:text-white"
      aria-label="<%= t('admin.shared.chat.close') %>"
    >
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>

  <div class="h-80 overflow-y-auto bg-slate-50 p-4">
    <div class="flex items-start gap-2.5">
      <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-600">
        <i class="fa-solid fa-robot text-sm"></i>
      </div>

      <div class="max-w-[80%] rounded-2xl rounded-tl-md bg-white px-3.5 py-2.5 shadow-sm">
        <p class="text-sm leading-relaxed text-slate-600">
          <%= t('admin.shared.chat.greeting', name: 'Ivan') %>
        </p>
      </div>
    </div>
  </div>

  <div class="border-t border-slate-200 bg-white p-3">
    <div class="flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2">
      <input
        id="chatInput"
        type="text"
        placeholder="<%= t('admin.shared.chat.input_placeholder') %>"
        class="min-w-0 flex-1 border-0 bg-transparent text-sm text-slate-700 outline-none placeholder:text-slate-400 focus:ring-0"
        />

      <button
        id="chatSendButton"
        type="button"
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-600 text-white transition hover:bg-blue-700"
        aria-label="<%= t('admin.shared.chat.send') %>"
      >
        <i class="fa-solid fa-paper-plane text-xs"></i>
      </button>
    </div>
  </div>
</div>

<button
  id="chatFloatingButton"
  type="button"
  class="fixed bottom-6 right-6 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-blue-600 text-white shadow-lg"
  aria-label="<%= t('admin.shared.chat.open') %>"
>
  <i class="fa-solid fa-comments text-lg"></i>
</button>