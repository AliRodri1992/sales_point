<div <% unless local_assigns[:standalone] %>data-modal-target="panel" role="dialog" aria-modal="true"<% end %>
     aria-labelledby="unit-measure-show-title"
     class="relative w-full max-w-xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
  <div class="flex items-start justify-between gap-4 border-b border-slate-100 bg-emerald-50/50 px-6 py-5">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-emerald-700"><%= t('admin.units_of_measure.index.eyebrow') %></p>
      <h2 id="unit-measure-show-title" class="mt-1 font-jakarta text-xl font-bold text-slate-900"><%= @unit.name %></h2>
      <p class="mt-1 text-sm text-slate-500"><%= @unit.abbreviation %></p>
    </div>
    <% unless local_assigns[:standalone] %>
      <button type="button" data-modal-dismiss data-action="modal#close"
              class="inline-flex size-10 items-center justify-center rounded-xl text-slate-500 hover:bg-white"
              aria-label="<%= t('admin.units_of_measure.actions.close') %>"><%= delta_icon('x-mark', class: 'size-5') %></button>
    <% end %>
  </div>
  <dl class="divide-y divide-slate-100 px-6">
    <% [[t('admin.units_of_measure.form.code'), @unit.code],
        [t('admin.units_of_measure.form.name'), @unit.name],
        [t('admin.units_of_measure.form.abbreviation'), @unit.abbreviation],
        [t('admin.units_of_measure.form.sat'), "#{@unit.sat_unit_key.code} — #{@unit.sat_unit_key.description}"],
        [t('admin.units_of_measure.form.precision'), @unit.decimal_precision.to_s],
        [t('admin.units_of_measure.form.status'), t("admin.units_of_measure.statuses.#{@unit.status}")],
        [t('admin.units_of_measure.form.description'), @unit.description.presence || '—']].each do |label, value| %>
      <div class="flex flex-col gap-1 py-3 sm:flex-row sm:items-start sm:justify-between sm:gap-5">
        <dt class="shrink-0 text-sm font-semibold text-slate-500"><%= label %></dt>
        <dd class="max-w-xs whitespace-pre-wrap break-words text-sm font-medium text-slate-900 sm:text-right"><%= value %></dd>
      </div>
    <% end %>
  </dl>
  <div class="flex justify-end gap-3 border-t border-slate-100 px-6 py-4">
    <% if local_assigns[:standalone] %>
      <%= link_to t('admin.units_of_measure.actions.back'), admin_units_of_measure_path, class: 'inline-flex min-h-11 items-center rounded-xl border border-slate-200 px-4 text-sm font-semibold text-slate-700' %>
    <% else %>
      <button type="button" data-modal-dismiss data-action="modal#close" class="inline-flex min-h-11 items-center rounded-xl border border-slate-200 px-4 text-sm font-semibold text-slate-700"><%= t('admin.units_of_measure.actions.close') %></button>
    <% end %>
    <% if policy(UnitOfMeasure).update? %>
      <%= link_to t('admin.units_of_measure.actions.edit'), edit_admin_unit_of_measure_path(@unit),
                  data: { turbo_frame: 'unit_of_measure_modal' },
                  class: 'inline-flex min-h-11 items-center rounded-xl bg-emerald-700 px-5 text-sm font-semibold text-white hover:bg-emerald-800' %>
    <% end %>
  </div>
</div>
