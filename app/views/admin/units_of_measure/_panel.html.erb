<div data-modal-target="panel" role="dialog" aria-modal="true" aria-labelledby="unit-measure-modal-title"
     class="relative flex max-h-[min(90vh,850px)] w-full max-w-2xl flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
  <div class="flex shrink-0 items-start justify-between gap-4 border-b border-slate-100 bg-gradient-to-r from-emerald-50/70 to-white px-5 py-5 sm:px-7">
    <div class="min-w-0">
      <p class="mb-1 text-xs font-bold uppercase tracking-widest text-emerald-700"><%= t('admin.units_of_measure.index.eyebrow') %></p>
      <h2 id="unit-measure-modal-title" class="font-jakarta text-xl font-bold text-slate-900">
        <%= t(@unit.persisted? ? 'admin.units_of_measure.edit.title' : 'admin.units_of_measure.new.title') %>
      </h2>
      <p class="mt-1 text-sm text-slate-500"><%= t('admin.units_of_measure.form.subtitle') %></p>
    </div>
    <button type="button" data-modal-dismiss data-action="modal#close"
            class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl text-slate-500 hover:bg-white hover:text-slate-900"
            aria-label="<%= t('admin.units_of_measure.actions.close') %>"><%= delta_icon('x-mark', class: 'size-5') %></button>
  </div>
  <div class="min-h-0 overflow-y-auto px-5 py-6 sm:px-7">
    <%= render 'form', unit: @unit %>
  </div>
</div>
