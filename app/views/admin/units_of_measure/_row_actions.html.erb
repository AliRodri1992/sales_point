<div class="catalog-list-row-actions">
  <% if policy(UnitOfMeasure).show? %>
    <%= link_to admin_unit_of_measure_path(unit),
                data: { turbo_frame: 'unit_of_measure_modal', tooltip: t('admin.units_of_measure.actions.show') },
                aria: { label: t('admin.units_of_measure.actions.show') }, class: 'catalog-list-icon-button' do %>
      <%= delta_icon('eye', class: 'size-4', aria: { hidden: true }) %>
    <% end %>
  <% end %>
  <% if policy(UnitOfMeasure).update? %>
    <%= link_to edit_admin_unit_of_measure_path(unit),
                data: { turbo_frame: 'unit_of_measure_modal', tooltip: t('admin.units_of_measure.actions.edit') },
                aria: { label: t('admin.units_of_measure.actions.edit') }, class: 'catalog-list-icon-button' do %>
      <%= delta_icon('pencil-square', class: 'size-4', aria: { hidden: true }) %>
    <% end %>
  <% end %>
  <% if policy(UnitOfMeasure).destroy? %>
    <%= button_to admin_unit_of_measure_path(unit, listing_query), method: :delete,
                  data: { controller: 'swal-confirm', turbo_confirm: t('admin.units_of_measure.actions.confirm_delete'),
                          swal_cancel_text: t('admin.units_of_measure.actions.cancel'),
                          confirm_record: unit.name, turbo_frame: 'units_of_measure_list' },
                  aria: { label: t('admin.units_of_measure.actions.delete') },
                  class: 'catalog-list-icon-button catalog-list-icon-button--danger' do %>
      <%= delta_icon('trash', class: 'size-4', aria: { hidden: true }) %>
    <% end %>
  <% end %>
</div>
