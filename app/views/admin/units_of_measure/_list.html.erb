<% listing_query = request.query_parameters.slice(*%w[search status fractional sat_unit_key_id sat_health sort direction page per_page])
                                    .merge('page' => @current_page) %>
<div data-controller="units-of-measure-context" data-list-query="<%= listing_query.to_query %>"
     class="catalog-list-directory" aria-labelledby="units-directory-title">
  <% sat_filter = @sat_filter_options.find { |(_label, id)| id.to_s == params[:sat_unit_key_id].to_s }&.first %>
  <% active_filters = {
       'search' => [t('admin.units_of_measure.filters.search'), params[:search].to_s.strip.presence],
       'status' => [t('admin.units_of_measure.form.status'),
                    UnitOfMeasure.statuses.key?(params[:status]) ? t("admin.units_of_measure.statuses.#{params[:status]}") : nil],
       'fractional' => [t('admin.units_of_measure.filters.fractional'),
                        { 'yes' => t('admin.units_of_measure.filters.yes'), 'no' => t('admin.units_of_measure.filters.no') }[params[:fractional]]],
       'sat_unit_key_id' => [t('admin.units_of_measure.filters.sat'), sat_filter],
       'sat_health' => [t('admin.units_of_measure.filters.sat_health'),
                        %w[current invalid].include?(params[:sat_health]) ? t("admin.units_of_measure.sat.#{params[:sat_health]}") : nil]
     }.select { |_key, (_label, value)| value.present? } %>
  <% if active_filters.any? %>
    <nav id="units_of_measure_active_filters"
         aria-label="<%= t('admin.units_of_measure.filters.active') %>"
         class="catalog-list-filter-chips catalog-list-inline-chips">
      <span class="catalog-list-filter-chips-label"><%= t('admin.units_of_measure.filters.active') %></span>
      <% active_filters.each do |key, (label, value)| %>
        <%= link_to admin_units_of_measure_path(listing_query.except(key, 'page')),
                    data: { turbo_frame: '_top' },
                    aria: { label: t('admin.units_of_measure.filters.remove', filter: "#{label}: #{value}") },
                    class: 'catalog-list-filter-chip' do %>
          <span class="truncate"><%= label %>: <%= value %></span>
          <%= delta_icon('x-mark', class: 'size-3.5 shrink-0') %>
        <% end %>
      <% end %>
      <%= link_to t('admin.units_of_measure.filters.clear_all'), admin_units_of_measure_path,
                  data: { turbo_frame: '_top' },
                  class: 'catalog-list-clear-filters' %>
    </nav>
  <% end %>
  <header class="catalog-list-directory-heading">
    <div>
      <h2 id="units-directory-title"><%= t('admin.units_of_measure.index.catalog_title') %></h2>
      <p aria-live="polite"><%= t('admin.units_of_measure.index.results', count: @total_count) %></p>
    </div>
    <% if @units.any? %>
      <span class="catalog-list-page-count"><%= t('admin.catalog_directory.showing', count: @units.size) %></span>
    <% end %>
    <%= render 'admin/shared/catalog_mobile_sort', frame: 'units_of_measure_list', columns: {
          'name' => t('admin.units_of_measure.form.name'), 'code' => t('admin.units_of_measure.form.code'),
          'decimal_precision' => t('admin.units_of_measure.form.precision') } %>
  </header>
  <% if @units.any? %>
    <div class="catalog-list-desktop-table">
      <table class="catalog-list-table">
        <thead>
          <tr>
            <th scope="col"><%= sort_link('name', t('admin.units_of_measure.form.name'), url_options: { action: 'index', id: nil, format: nil }, frame: 'units_of_measure_list') %></th>
            <th scope="col"><%= sort_link('code', t('admin.units_of_measure.form.code'), url_options: { action: 'index', id: nil, format: nil }, frame: 'units_of_measure_list') %></th>
            <th scope="col"><%= t('admin.units_of_measure.form.sat') %></th>
            <th scope="col"><%= sort_link('decimal_precision', t('admin.units_of_measure.form.precision'), url_options: { action: 'index', id: nil, format: nil }, frame: 'units_of_measure_list') %></th>
            <th scope="col"><%= t('admin.units_of_measure.form.status') %></th>
            <th scope="col" class="catalog-list-actions-heading"><%= t('admin.units_of_measure.actions.title') %></th>
          </tr>
        </thead>
        <tbody>
          <% @units.each do |unit| %>
            <tr>
              <td>
                <span class="catalog-list-identity">
                  <span class="catalog-list-avatar" aria-hidden="true"><%= unit.abbreviation.to_s.first(2) %></span>
                  <span class="catalog-list-mobile-identity"><strong class="catalog-list-name"><%= unit.name %></strong><span class="catalog-list-secondary-text"><%= unit.abbreviation %></span></span>
                </span>
              </td>
              <td><code class="catalog-list-code"><%= unit.code %></code></td>
              <td><%= render 'sat_reference', unit: unit %></td>
              <td><%= unit.decimal_precision %> <span class="catalog-list-secondary-text"><%= t('admin.units_of_measure.index.decimals') %></span></td>
              <td><span class="catalog-list-status <%= 'catalog-list-status--inactive' unless unit.active? %>"><%= t("admin.units_of_measure.statuses.#{unit.status}") %></span></td>
              <td><%= render 'row_actions', unit: unit, listing_query: listing_query %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <ul class="catalog-list-mobile-list" aria-label="<%= t('admin.units_of_measure.index.catalog_title') %>">
      <% @units.each do |unit| %>
        <li class="catalog-list-mobile-card">
          <div class="catalog-list-mobile-card-heading">
            <span class="catalog-list-avatar" aria-hidden="true"><%= unit.abbreviation.to_s.first(2) %></span>
            <div class="catalog-list-mobile-identity"><strong><%= unit.name %></strong><code class="catalog-list-code"><%= unit.code %></code></div>
            <span class="catalog-list-status <%= 'catalog-list-status--inactive' unless unit.active? %>"><%= t("admin.units_of_measure.statuses.#{unit.status}") %></span>
          </div>
          <dl class="catalog-list-mobile-facts">
            <div><dt><%= t('admin.units_of_measure.form.abbreviation') %></dt><dd><%= unit.abbreviation %></dd></div>
            <div><dt><%= t('admin.units_of_measure.form.precision') %></dt><dd><%= unit.decimal_precision %> <%= t('admin.units_of_measure.index.decimals') %></dd></div>
            <div class="catalog-list-fact-wide"><dt><%= t('admin.units_of_measure.form.sat') %></dt><dd><%= render 'sat_reference', unit: unit %></dd></div>
          </dl>
          <%= render 'row_actions', unit: unit, listing_query: listing_query %>
        </li>
      <% end %>
    </ul>
    <%= render 'admin/shared/catalog_pagination', key: 'units_of_measure', total_pages: @total_pages,
               current_page: @current_page, per_page_label: t('admin.units_of_measure.index.per_page'),
               frame: 'units_of_measure_list' %>
  <% else %>
    <div class="catalog-list-empty-state">
      <div class="catalog-list-empty-icon"><%= delta_icon('cog', class: 'size-7') %></div>
      <h3 ><%= t(@unfiltered_count.positive? ? 'admin.units_of_measure.index.no_results' : 'admin.units_of_measure.index.empty_title') %></h3>
      <p ><%= t(@unfiltered_count.positive? ? 'admin.units_of_measure.index.try_filters' : 'admin.units_of_measure.index.empty_subtitle') %></p>
      <% if @unfiltered_count.positive? %>
        <%= link_to t('admin.units_of_measure.filters.clear'), admin_units_of_measure_path,
                    data: { turbo_frame: '_top' }, class: 'catalog-list-secondary-button' %>
      <% elsif policy(UnitOfMeasure).create? %>
        <%= link_to t('admin.units_of_measure.actions.new'), new_admin_unit_of_measure_path,
                    data: { turbo_frame: 'unit_of_measure_modal' },
                    class: 'catalog-list-primary-button' %>
      <% end %>
    </div>
  <% end %>
</div>
