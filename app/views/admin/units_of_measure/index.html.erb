<header class="mb-7 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
  <div class="space-y-2">
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-emerald-700"><%= t('admin.units_of_measure.index.eyebrow') %></p>
    <h1 class="font-jakarta text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"><%= t('admin.units_of_measure.index.title') %></h1>
    <p class="max-w-2xl text-sm leading-relaxed text-slate-500"><%= t('admin.units_of_measure.index.subtitle') %></p>
  </div>
  <% if policy(UnitOfMeasure).create? %>
    <%= link_to new_admin_unit_of_measure_path, data: { turbo_frame: 'unit_of_measure_modal', tooltip: t('admin.units_of_measure.actions.new') },
                class: 'inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-xl bg-emerald-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' do %>
      <%= delta_icon('plus', class: 'size-4') %>
      <%= t('admin.units_of_measure.actions.new') %>
    <% end %>
  <% end %>
</header>

<%= render 'stats' %>

<div class="mb-5 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
  <%= form_with url: admin_units_of_measure_path, method: :get,
                data: { turbo_frame: 'units_of_measure_list', controller: 'categories-search' },
                class: 'grid grid-cols-1 items-end gap-3 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-6' do %>
    <div class="min-w-0 sm:col-span-2 2xl:col-span-1">
      <label for="units-search" class="mb-1.5 block text-xs font-semibold text-slate-600"><%= t('admin.units_of_measure.filters.search') %></label>
      <%= search_field_tag :search, params[:search], id: 'units-search', maxlength: 100,
                           placeholder: t('admin.units_of_measure.filters.placeholder'),
                           data: { action: 'input->categories-search#debouncedSubmit' },
                           class: 'min-h-11 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100' %>
    </div>
    <div class="min-w-0">
      <label for="units-status" class="mb-1.5 block text-xs font-semibold text-slate-600"><%= t('admin.units_of_measure.form.status') %></label>
      <div class="relative" data-controller="delta-select">
        <%= select_tag :status, options_for_select([[t('admin.units_of_measure.filters.all'), 'all'],
                  [t('admin.units_of_measure.statuses.active'), 'active'],
                  [t('admin.units_of_measure.statuses.inactive'), 'inactive']], params[:status] || 'all'),
                  id: 'units-status', class: 'min-h-11 w-full rounded-xl border border-slate-200 px-3 text-sm' %>
      </div>
    </div>
    <div class="min-w-0">
      <label for="units-fractional" class="mb-1.5 block text-xs font-semibold text-slate-600"><%= t('admin.units_of_measure.filters.fractional') %></label>
      <div class="relative" data-controller="delta-select">
        <%= select_tag :fractional, options_for_select([[t('admin.units_of_measure.filters.all'), 'all'],
                  [t('admin.units_of_measure.filters.yes'), 'yes'],
                  [t('admin.units_of_measure.filters.no'), 'no']], params[:fractional] || 'all'),
                  id: 'units-fractional', class: 'min-h-11 w-full rounded-xl border border-slate-200 px-3 text-sm' %>
      </div>
    </div>
    <div class="min-w-0">
      <label for="units-sat" class="mb-1.5 block text-xs font-semibold text-slate-600"><%= t('admin.units_of_measure.filters.sat') %></label>
      <div class="relative" data-controller="delta-select" data-searchable="true" data-search-placeholder="<%= t('admin.units_of_measure.filters.search_sat') %>">
        <%= select_tag :sat_unit_key_id, options_for_select([[t('admin.units_of_measure.filters.all'), '']] + @sat_filter_options, params[:sat_unit_key_id]),
                       id: 'units-sat', class: 'min-h-11 w-full rounded-xl border border-slate-200 px-3 text-sm' %>
      </div>
    </div>
    <div class="min-w-0">
      <label for="units-sat-health" class="mb-1.5 block text-xs font-semibold text-slate-600"><%= t('admin.units_of_measure.filters.sat_health') %></label>
      <div class="relative" data-controller="delta-select">
        <%= select_tag :sat_health, options_for_select([
                         [t('admin.units_of_measure.filters.all'), 'all'],
                         [t('admin.units_of_measure.sat.current'), 'current'],
                         [t('admin.units_of_measure.sat.invalid'), 'invalid']],
                         params[:sat_health] || 'all'),
                         id: 'units-sat-health', class: 'min-h-11 w-full rounded-xl border border-slate-200 px-3 text-sm' %>
      </div>
    </div>
    <div class="flex min-w-0 items-center gap-2">
      <%= button_tag type: :submit, class: 'inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-4 text-sm font-semibold text-emerald-800 hover:bg-emerald-100' do %>
        <%= delta_icon('funnel', class: 'size-4') %>
        <%= t('admin.units_of_measure.filters.apply') %>
      <% end %>
      <%= link_to t('admin.units_of_measure.filters.clear'), admin_units_of_measure_path,
                  data: { turbo_frame: '_top' },
                  class: 'inline-flex min-h-11 items-center justify-center rounded-xl px-3 text-sm font-semibold text-slate-500 hover:bg-slate-100 hover:text-slate-800' %>
    </div>
  <% end %>
</div>

<div id="units_of_measure_alert" aria-live="polite"></div>
<div class="delta-skeleton-region" data-controller="skeleton-loading"
     data-skeleton-loading-region-value="units_of_measure_list" aria-busy="false"
     data-action="skeleton:begin@document->skeleton-loading#begin skeleton:end@document->skeleton-loading#finish turbo:before-fetch-request@document->skeleton-loading#turboStart turbo:frame-load@document->skeleton-loading#turboFinish turbo:fetch-request-error@document->skeleton-loading#turboError turbo:before-cache@document->skeleton-loading#clear">
  <span class="sr-only" role="status" aria-live="polite" hidden data-skeleton-loading-target="status"><%= t('admin.action_loader.processing') %></span>
  <div class="delta-skeleton-region__progress" data-skeleton-loading-target="indicator" hidden aria-hidden="true"><span></span></div>
  <div data-skeleton-loading-target="content">
    <%= turbo_frame_tag 'units_of_measure_list' do %>
      <%= render 'list' %>
    <% end %>
  </div>
  <div data-skeleton-loading-target="placeholder" hidden>
    <%= render Ui::SkeletonComponent.new(variant: :table, rows: 6, columns: 6) %>
  </div>
  <div data-skeleton-loading-target="error" hidden role="alert"
       class="mt-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
    <%= t('admin.skeleton_loading.failed') %>
    <button type="button" data-action="skeleton-loading#retry" class="ml-2 font-semibold underline"><%= t('admin.skeleton_loading.retry') %></button>
  </div>
</div>
