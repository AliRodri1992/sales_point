<section id="supplier-dossier-general" role="tabpanel" tabindex="0" aria-labelledby="supplier-dossier-tab-general" data-supplier-dossier-target="panel" data-section="general" class="hidden w-full min-w-0 space-y-4 lg:flex-1">
  <div data-supplier-general-header class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><%= icon('building-office-2', class: 'size-6') %></span>
        <div>
          <h2 class="font-jakarta text-xl font-bold text-slate-900"><%= t('admin.supplier_dossier.sections.general') %></h2>
          <p class="mt-1 text-sm text-slate-500"><%= t('admin.supplier_dossier.general.information_description') %></p>
        </div>
      </div>
      <% if can_edit %>
        <%= link_to edit_admin_supplier_path(supplier, return_to: 'general'), class: 'inline-flex min-h-10 items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 text-sm font-semibold text-emerald-800 transition hover:bg-emerald-50' do %>
          <%= icon('pencil', class: 'size-4') %><%= t('admin.supplier_details.edit') %>
        <% end %>
      <% end %>
    </div>

  </div>

  <%= render 'dossier_general_identification', supplier: supplier %>
  <%= render 'dossier_general_contact_management', supplier: supplier %>
  <%= render 'dossier_general_additional', supplier: supplier %>
</section>
