<div class="max-w-6xl rounded-xl border border-slate-200 bg-white shadow-sm">
  <div class="mb-7 flex items-start justify-between gap-4 px-6 pt-6">
    <div>
      <h1 class="font-jakarta text-2xl font-bold text-slate-900">
        <%= supplier.persisted? ? t('admin.suppliers.edit.title', name: supplier.name) : t('admin.suppliers.new.title') %>
      </h1>
      <p class="mt-1 text-sm text-slate-500">
        <%= supplier.persisted? ? t('admin.suppliers.edit.subtitle') : t('admin.suppliers.new.subtitle') %>
      </p>
    </div>
    <%= link_to admin_suppliers_path,
                data: { turbo_frame: '_top' },
                class: 'inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50' do %>
      <%= icon('arrow-left', class: 'size-4') %>
      <%= t('admin.suppliers.show.back') %>
    <% end %>
  </div>
  <div class="px-6 pb-6">
    <%= render 'form', supplier: supplier %>
  </div>
</div>
