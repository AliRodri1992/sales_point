<div class="mx-auto w-full max-w-[1600px]">
  <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-sm text-slate-500">
    <%= link_to t('admin.suppliers.index.title'), admin_suppliers_path, class: 'transition hover:text-emerald-700' %>
    <span aria-hidden="true">/</span>
    <span class="font-semibold text-slate-800"><%= supplier.persisted? ? t('admin.suppliers.edit.title', name: supplier.name) : t('admin.suppliers.new.title') %></span>
  </nav>

  <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="font-jakarta text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        <%= supplier.persisted? ? t('admin.suppliers.edit.title', name: supplier.name) : t('admin.suppliers.new.title') %>
      </h1>
      <p class="mt-1 text-sm text-slate-500">
        <%= supplier.persisted? ? t('admin.suppliers.edit.subtitle') : t('admin.suppliers.new.subtitle') %>
      </p>
    </div>
    <%= link_to admin_suppliers_path, data: { turbo_frame: '_top' },
                class: 'inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-emerald-200 hover:text-emerald-700' do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="m12 19-7-7 7-7M5 12h14"/></svg>
      <%= t('admin.suppliers.show.back') %>
    <% end %>
  </div>

  <div class="grid items-start gap-5 2xl:grid-cols-[minmax(0,1fr)_340px]">
    <section class="min-w-0 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7 lg:p-8" aria-label="<%= t('admin.suppliers.form.name') %>">
      <%= render 'form', supplier: supplier %>
    </section>

    <aside class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-sm xl:sticky xl:top-24">
      <div class="rounded-2xl bg-gradient-to-b from-emerald-50 to-teal-50 px-3 py-4">
        <%= image_tag 'supplier-delivery.svg', class: 'mx-auto block w-full', alt: t('admin.suppliers.onboarding.panel.title'), loading: 'eager' %>
      </div>
      <div class="px-2 pb-3 pt-5">
        <p class="text-xs font-extrabold uppercase tracking-wider text-emerald-700"><%= t('admin.suppliers.onboarding.panel.eyebrow') %></p>
        <h2 class="mt-2 font-jakarta text-2xl font-extrabold leading-tight text-slate-900"><%= t('admin.suppliers.onboarding.panel.title') %></h2>
        <p class="mt-3 text-sm leading-6 text-slate-600"><%= t('admin.suppliers.onboarding.panel.description') %></p>
        <div class="mt-6 space-y-5">
          <div class="flex items-start gap-3">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 3 7.5 12 12l9-4.5L12 3Z"/><path d="M3 12l9 4.5 9-4.5M3 16.5 12 21l9-4.5"/></svg>
            </span>
            <div>
              <h3 class="text-sm font-bold text-slate-900"><%= t('admin.suppliers.onboarding.panel.benefit_1.title') %></h3>
              <p class="mt-0.5 text-xs leading-5 text-slate-600"><%= t('admin.suppliers.onboarding.panel.benefit_1.description') %></p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h4"/></svg>
            </span>
            <div>
              <h3 class="text-sm font-bold text-slate-900"><%= t('admin.suppliers.onboarding.panel.benefit_2.title') %></h3>
              <p class="mt-0.5 text-xs leading-5 text-slate-600"><%= t('admin.suppliers.onboarding.panel.benefit_2.description') %></p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V21H3V10.5Z"/><path d="M9 21v-8h6v8M3 11h18"/></svg>
            </span>
            <div>
              <h3 class="text-sm font-bold text-slate-900"><%= t('admin.suppliers.onboarding.panel.benefit_3.title') %></h3>
              <p class="mt-0.5 text-xs leading-5 text-slate-600"><%= t('admin.suppliers.onboarding.panel.benefit_3.description') %></p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="9" cy="10" r="2"/><path d="M5.5 17a3.5 3.5 0 0 1 7 0M15 9h3M15 13h3"/></svg>
            </span>
            <div>
              <h3 class="text-sm font-bold text-slate-900"><%= t('admin.suppliers.onboarding.panel.benefit_4.title') %></h3>
              <p class="mt-0.5 text-xs leading-5 text-slate-600"><%= t('admin.suppliers.onboarding.panel.benefit_4.description') %></p>
            </div>
          </div>
        </div>
      </div>
    </aside>
  </div>
</div>
