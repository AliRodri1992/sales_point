<% contacts.each do |contact| %>
  <article data-supplier-contact-id="<%= contact.id %>" class="min-w-0 self-start rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-emerald-200 hover:shadow-md sm:p-5">
    <div class="flex min-w-0 items-start gap-3">
      <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-emerald-50 font-jakarta text-sm font-bold text-emerald-700">
        <%= contact.name.to_s.split.first(2).map { |part| part.first.upcase }.join %>
      </span>
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-2">
          <h3 class="break-words font-jakarta text-sm font-bold text-slate-900 sm:text-base"><%= contact.name %></h3>
          <% if contact.primary? %>
            <span class="inline-flex rounded-full bg-emerald-100 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-800"><%= t('admin.supplier_details.primary') %></span>
          <% end %>
        </div>
        <p class="mt-0.5 break-words text-xs text-slate-500 sm:text-sm"><%= contact.position.presence || '—' %></p>
      </div>
      <div class="flex shrink-0 items-center gap-1">
        <% if can_manage_contacts %>
          <details class="group relative">
            <summary aria-label="<%= t('admin.supplier_details.actions') %>" class="flex size-9 cursor-pointer list-none items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 [&::-webkit-details-marker]:hidden">
              <%= icon('ellipsis-vertical', class: 'size-5') %>
            </summary>
            <div class="absolute right-0 z-20 mt-1 min-w-36 rounded-xl border border-slate-200 bg-white p-1 shadow-lg">
              <%= link_to edit_admin_supplier_contact_path(supplier, contact), data: { turbo_frame: '_top' }, class: 'flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-800' do %>
                <%= icon('pencil', class: 'size-4') %>
                <%= t('admin.supplier_details.edit') %>
              <% end %>
            </div>
          </details>
        <% end %>
        <button type="button" data-action="supplier-contacts#toggleCard" aria-controls="supplier-contact-detail-<%= contact.id %>" aria-expanded="false" aria-label="<%= t('admin.supplier_dossier.contact_cards.expand', name: contact.name) %>" data-expand-label="<%= t('admin.supplier_dossier.contact_cards.expand', name: contact.name) %>" data-collapse-label="<%= t('admin.supplier_dossier.contact_cards.collapse', name: contact.name) %>" class="flex size-9 items-center justify-center rounded-lg text-slate-600 transition hover:bg-emerald-50 hover:text-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600">
          <%= icon('chevron-down', class: 'size-4 transition-transform') %>
        </button>
      </div>
    </div>

    <div class="mt-3 flex min-w-0 flex-wrap items-center gap-x-5 gap-y-2 pl-0 sm:pl-14">
      <% if contact.phone.present? || contact.mobile_phone.present? %>
        <a href="tel:<%= contact.phone.presence || contact.mobile_phone %>" class="inline-flex items-center gap-2 text-xs font-medium text-slate-600 hover:text-emerald-800 sm:text-sm">
          <%= icon('phone', class: 'size-4 shrink-0 text-emerald-700') %>
          <%= contact.phone.presence || contact.mobile_phone %>
        </a>
      <% else %>
        <span class="inline-flex items-center gap-2 text-xs font-medium text-slate-400 sm:text-sm">
          <%= icon('phone', class: 'size-4 shrink-0 text-slate-400') %>
          <%= t('admin.supplier_dossier.contact_cards.phone_not_registered') %>
        </span>
      <% end %>
      <% if contact.email.present? %>
        <%= mail_to contact.email, class: 'inline-flex min-w-0 items-center gap-2 break-all text-xs font-medium text-emerald-700 hover:underline sm:text-sm' do %>
          <%= icon('envelope', class: 'size-4 shrink-0') %>
          <%= contact.email %>
        <% end %>
      <% else %>
        <span class="inline-flex min-w-0 items-center gap-2 text-xs font-medium text-slate-400 sm:text-sm">
          <%= icon('envelope', class: 'size-4 shrink-0') %>
          <%= t('admin.supplier_dossier.contact_cards.email_not_registered') %>
        </span>
      <% end %>
    </div>

    <div id="supplier-contact-detail-<%= contact.id %>" class="mt-4 hidden border-t border-slate-100 pt-4" data-contact-detail>
      <dl class="grid gap-4 text-xs sm:grid-cols-2 sm:text-sm">
        <div>
          <dt class="text-slate-500"><%= t('admin.supplier_details.contact_fields.position') %></dt>
          <dd class="mt-1 break-words font-semibold text-slate-800"><%= contact.position.presence || '—' %></dd>
        </div>
        <div>
          <dt class="text-slate-500"><%= t('admin.supplier_details.contact_fields.mobile_phone') %></dt>
          <dd class="mt-1 break-words font-semibold text-slate-800"><%= contact.mobile_phone.presence || '—' %></dd>
        </div>
        <div>
          <dt class="text-slate-500"><%= t('admin.supplier_details.contact_fields.primary') %></dt>
          <dd class="mt-1 font-semibold text-slate-800"><%= t("admin.supplier_dossier.contact_cards.#{contact.primary? ? 'yes' : 'no'}") %></dd>
        </div>
        <div>
          <dt class="text-slate-500"><%= t('admin.supplier_details.contact_fields.active') %></dt>
          <dd class="mt-1 font-semibold text-slate-800"><%= t("admin.supplier_details.contact_statuses.#{contact.active? ? 'active' : 'inactive'}") %></dd>
        </div>
        <% if contact.notes.present? %>
          <div class="sm:col-span-2">
            <dt class="text-slate-500"><%= t('admin.supplier_details.contact_fields.notes') %></dt>
            <dd class="mt-1 whitespace-pre-wrap break-words font-medium text-slate-700"><%= contact.notes %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  </article>
<% end %>
