    <div>
      <%= form.label :responsible_user_id, t('admin.supplier_dossier.responsible'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
      <div class="relative" data-controller="delta-select"><%= form.collection_select :responsible_user_id, current_organization.users, :id, :email, { include_blank: t('admin.supplier_dossier.placeholders.responsible') }, class: "input-field block min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/60 outline-none transition focus:border-emerald-500 focus:bg-white focus:ring-4 focus:ring-emerald-100 px-4 py-3 text-sm #{form_state_classes(supplier, :responsible_user)} appearance-none pr-11 cursor-pointer" %></div>
      <%= error_message_for(supplier, :responsible_user) %>
    </div>
    <div>
      <%= form.label :tags_text, t('admin.supplier_dossier.tags'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
      <%= form.text_field :tags_text, class: "input-field block min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/60 outline-none transition focus:border-emerald-500 focus:bg-white focus:ring-4 focus:ring-emerald-100 px-4 py-3 text-sm #{form_state_classes(supplier, :tags)}" %>
      <%= error_message_for(supplier, :tags) %>
    </div>
        </div>
      </section>
      <section data-supplier-form-target="step"  hidden class="hidden" aria-label="<%= t('admin.suppliers.onboarding.steps.step_7') %>">
        <div class="mb-6 border-b border-slate-100 pb-4"><h2 class="font-jakarta text-lg font-bold text-slate-900"><%= t('admin.suppliers.onboarding.steps.step_7') %></h2><p class="mt-1 text-sm text-slate-500"><%= t('admin.suppliers.onboarding.subtitles.step_7') %></p></div>
        <div class="grid gap-x-5 gap-y-6 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <%= form.label :documents, t('admin.supplier_dossier.documents'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
      <%= form.file_field :documents, multiple: true, accept: '.pdf,.png,.jpg,.jpeg', class: "input-field block min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/60 outline-none transition focus:border-emerald-500 focus:bg-white focus:ring-4 focus:ring-emerald-100 px-4 py-3 text-sm #{form_state_classes(supplier, :documents)}" %>
      <%= error_message_for(supplier, :documents) %>
    </div>
    <div class="sm:col-span-2">
      <%= form.label :notes, t('admin.suppliers.form.notes'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
      <%= form.text_area :notes, rows: 3,
                         class: "input-field block min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/60 outline-none transition focus:border-emerald-500 focus:bg-white focus:ring-4 focus:ring-emerald-100 #{form_state_classes(supplier, :notes)} px-4 py-3 text-sm text-slate-800 placeholder:text-slate-400",
                         placeholder: t('admin.suppliers.form.notes_placeholder') %>
      <%= error_message_for(supplier, :notes) %>
    </div>
        </div>
      </section>
      <section data-supplier-form-target="step" hidden class="hidden" aria-label="<%= t('admin.suppliers.onboarding.summary.title') %>">
        <div class="mb-6 border-b border-slate-100 pb-4"><h2 class="font-jakarta text-lg font-bold text-slate-900"><%= t('admin.suppliers.onboarding.summary.title') %></h2><p class="mt-1 text-sm text-slate-500"><%= t('admin.suppliers.onboarding.summary.description') %></p></div>
        <div data-supplier-form-target="summary" class="space-y-4 pr-1" aria-live="polite"></div>
      </section>
      </div>
      <div class="mt-auto grid w-full min-w-0 grid-cols-1 gap-4 border-t border-slate-200 pt-5 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
        <p class="flex items-center gap-2 text-xs text-slate-500"><svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 11v5M12 7h.01"/></svg><%= t('admin.suppliers.onboarding.required') %></p>
        <div class="flex w-full flex-wrap items-center justify-between gap-2 sm:w-auto sm:justify-end">
          <%= link_to t('admin.suppliers.form.cancel'), admin_suppliers_path, data: { turbo_frame: '_top' }, class: 'rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50' %>
          <button type="button" data-supplier-form-target="previous" data-action="supplier-form#previous" class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50"><%= t('admin.suppliers.onboarding.previous') %></button>
          <button type="button" data-supplier-form-target="next" data-action="supplier-form#next" class="rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-emerald-700"><%= t('admin.suppliers.onboarding.next') %> →</button>
          <%= form.submit t('admin.suppliers.form.save'), data: { supplier_form_target: 'submit' }, class: 'cursor-pointer rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-emerald-700' %>
        </div>
      </div>
    </div>
  </div>
<% end %>
