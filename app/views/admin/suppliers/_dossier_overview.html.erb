<section id="supplier-dossier-overview" data-supplier-dossier-target="panel" data-section="overview" class="w-full min-w-0 lg:flex-1 space-y-4">
  <% overview_metrics = [
    [t('admin.supplier_dossier.sections.products'), (can_view_products ? supplier.supplier_products.available.count : nil), t('admin.supplier_dossier.overview.registered_products'), 'box'],
    [t('admin.supplier_dossier.sections.contacts'), contacts.size, t('admin.supplier_dossier.overview.active_contacts'), 'users'],
    [t('admin.supplier_dossier.sections.addresses'), addresses.size, t('admin.supplier_dossier.overview.registered_addresses'), 'pin'],
    [t('admin.supplier_dossier.sections.schedules'), schedules.size, t('admin.supplier_dossier.overview.weekly_schedules'), 'calendar']
  ] %>
  <% overview_metrics.reject! { |_label, value, _subtitle, symbol| symbol == 'box' && value.nil? } %>
  <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
    <% overview_metrics.each do |label, value, subtitle, symbol| %>
      <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
          <% metric_icon = { 'users' => 'users', 'pin' => 'map-pin', 'calendar' => 'calendar-days' }.fetch(symbol, 'cube') %>
          <%= icon(metric_icon, class: 'size-5') %>
        </span>
        <div>
          <p class="text-sm font-medium text-slate-500"><%= label %></p>
          <p class="mt-1 font-jakarta text-2xl font-bold tabular-nums text-slate-900"><%= value %></p>
          <p class="mt-1 text-xs text-slate-500"><%= subtitle %></p>
        </div>
      </div>
    <% end %>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-4">
      <div class="flex items-center gap-3">
        <span class="flex size-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><%= icon('building-office-2', class: 'size-5') %></span>
        <div>
          <h2 class="font-jakarta text-lg font-bold text-slate-900"><%= t('admin.supplier_dossier.overview.main_information') %></h2>
          <p class="text-sm text-slate-500"><%= t('admin.supplier_dossier.overview.main_description') %></p>
        </div>
      </div>
      <% if can_edit %>
        <%= link_to edit_admin_supplier_path(supplier), class: 'inline-flex min-h-10 items-center gap-2 rounded-lg border border-slate-200 px-4 text-sm font-semibold text-emerald-800 hover:bg-emerald-50' do %>
          <%= icon('pencil', class: 'size-4') %><%= t('admin.supplier_details.edit') %>
        <% end %>
      <% end %>
    </div>
    <% first_column = [
      [t('admin.supplier_dossier.general.code'), supplier.code],
      [t('admin.supplier_dossier.fields.legal_name'), supplier.legal_name],
      [t('admin.supplier_dossier.fields.trade_name'), supplier.trade_name],
      [t('admin.supplier_dossier.fields.alias_name'), supplier.alias_name],
      [t('admin.supplier_dossier.fields.classification'), supplier.classification.present? ? t("admin.supplier_dossier.options.#{supplier.classification}") : nil],
      [t('admin.supplier_dossier.general.status'), t("admin.suppliers.statuses.#{supplier.status}")],
      [t('admin.supplier_dossier.responsible'), supplier.responsible_user&.display_name],
      [t('admin.supplier_dossier.overview.phone'), supplier.phone],
      [t('admin.supplier_dossier.overview.email'), supplier.email]
    ] %>
    <% second_column = [
      [t('admin.supplier_dossier.fields.currency'), supplier.currency&.code],
      [t('admin.supplier_dossier.fields.credit_days'), supplier.credit_days],
      [t('admin.supplier_dossier.fields.credit_limit'), supplier.credit_limit.present? ? number_to_currency(supplier.credit_limit) : nil],
      [t('admin.supplier_dossier.fields.discount_percent'), supplier.discount_percent.present? ? "#{supplier.discount_percent}%" : nil],
      [t('admin.supplier_dossier.fields.minimum_order_amount'), supplier.minimum_order_amount.present? ? number_to_currency(supplier.minimum_order_amount) : nil],
      [t('admin.supplier_dossier.notes'), supplier.notes]
    ] %>
    <div class="grid gap-6 pt-4 lg:grid-cols-2 lg:gap-8">
      <% [first_column, second_column].each_with_index do |fields, index| %>
        <dl class="space-y-3 <%= 'lg:border-l lg:border-slate-100 lg:pl-8' if index.positive? %>">
          <% fields.each do |label, value| %>
            <div class="grid gap-1 text-sm sm:grid-cols-[minmax(0,42%)_minmax(0,58%)] sm:gap-3">
              <dt class="text-slate-500"><%= label %></dt>
              <dd class="break-words whitespace-pre-wrap font-medium text-slate-900"><%= value.presence || '—' %></dd>
            </div>
          <% end %>
        </dl>
      <% end %>
    </div>
  </div>

  <div class="grid gap-4 xl:grid-cols-2">
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <span class="flex size-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><%= icon('users', class: 'size-5') %></span>
          <div>
            <h3 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.supplier_dossier.overview.primary_contacts') %></h3>
            <p class="text-xs text-slate-500"><%= t('admin.supplier_dossier.overview.contacts_subtitle') %></p>
          </div>
        </div>
        <button type="button" data-action="supplier-dossier#select" data-section="contacts" class="inline-flex min-h-9 items-center gap-1 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-emerald-800 hover:bg-emerald-50"><%= t('admin.supplier_dossier.overview.view_all') %><%= icon('arrow-right', class: 'size-4') %></button>
      </div>
      <% if contacts.any? %>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[440px] text-left text-xs">
            <thead class="bg-slate-50 text-slate-600">
              <tr>
                <th scope="col" class="px-3 py-3 font-semibold"><%= t('admin.supplier_details.contact_fields.name') %></th>
                <th scope="col" class="px-3 py-3 font-semibold"><%= t('admin.supplier_details.contact_fields.position') %></th>
                <th scope="col" class="px-3 py-3 font-semibold"><%= t('admin.supplier_details.contact_fields.phone') %></th>
                <th scope="col" class="px-3 py-3 font-semibold"><%= t('admin.supplier_details.contact_fields.email') %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700">
              <% contacts.first(3).each do |contact| %>
                <tr>
                  <td class="px-3 py-3 font-semibold text-slate-900"><%= contact.name %></td>
                  <td class="px-3 py-3"><%= contact.position.presence || '—' %></td>
                  <td class="whitespace-nowrap px-3 py-3"><%= contact.phone.presence || contact.mobile_phone.presence || '—' %></td>
                  <td class="max-w-40 truncate px-3 py-3" title="<%= contact.email %>"><%= contact.email.presence || '—' %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="py-8 text-center text-sm text-slate-500"><%= t('admin.supplier_details.no_contacts') %></p>
      <% end %>
    </div>

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <span class="flex size-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><%= icon('calendar-days', class: 'size-5') %></span>
          <div>
            <h3 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.supplier_dossier.overview.upcoming_visits') %></h3>
            <p class="text-xs text-slate-500"><%= t('admin.supplier_dossier.overview.schedule_subtitle') %></p>
          </div>
        </div>
        <button type="button" data-action="supplier-dossier#select" data-section="schedules" class="inline-flex min-h-9 items-center gap-1 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-emerald-800 hover:bg-emerald-50"><%= t('admin.supplier_dossier.overview.view_calendar') %><%= icon('arrow-right', class: 'size-4') %></button>
      </div>
      <% if schedules.any? %>
        <% upcoming = schedules.sort_by { |schedule| [supplier_dossier_next_occurrence(schedule), schedule.starts_at] }.first(3) %>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[390px] text-left text-xs">
            <thead class="bg-slate-50 text-slate-600">
              <tr>
                <th scope="col" class="px-3 py-3 font-semibold"><%= t('admin.supplier_dossier.overview.next_date') %></th>
                <th scope="col" class="px-3 py-3 font-semibold"><%= t('admin.supplier_dossier.kind') %></th>
                <th scope="col" class="px-3 py-3 font-semibold"><%= t('admin.supplier_dossier.branch') %></th>
                <th scope="col" class="px-3 py-3 font-semibold"><%= t('admin.supplier_dossier.overview.recurrence') %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700">
              <% upcoming.each do |schedule| %>
                <tr>
                  <td class="whitespace-nowrap px-3 py-3 font-medium"><%= l(supplier_dossier_next_occurrence(schedule), format: :short) %></td>
                  <td class="px-3 py-3"><%= t("admin.supplier_dossier.kinds.#{schedule.kind}") %></td>
                  <td class="px-3 py-3"><%= schedule.branch.name %></td>
                  <td class="whitespace-nowrap px-3 py-3"><span class="rounded-md bg-emerald-50 px-2 py-1 font-medium text-emerald-700"><%= t('admin.supplier_dossier.overview.weekly') %></span></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="py-8 text-center text-sm text-slate-500"><%= t('admin.supplier_dossier.overview.no_schedules') %></p>
      <% end %>
    </div>
  </div>
</section>
