<section id="supplier-dossier-fiscal" data-supplier-dossier-target="panel" data-section="fiscal" class="hidden space-y-4">
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-5">
      <div class="flex items-center gap-3">
        <span class="flex size-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><%= icon('document-text', class: 'size-6') %></span>
        <div>
          <h2 class="font-jakarta text-xl font-bold text-slate-900"><%= t('admin.supplier_dossier.sections.fiscal') %></h2>
          <p class="mt-1 text-sm text-slate-500"><%= t('admin.supplier_dossier.general.tax_description') %></p>
        </div>
      </div>
      <% if can_edit %>
        <%= link_to edit_admin_supplier_path(supplier), class: 'inline-flex min-h-10 items-center gap-2 rounded-lg border border-slate-200 px-4 text-sm font-semibold text-emerald-800 hover:bg-emerald-50' do %>
          <%= icon('pencil', class: 'size-4') %><%= t('admin.supplier_details.edit') %>
        <% end %>
      <% end %>
    </div>
    <% fiscal_fields = [
      [t('admin.supplier_dossier.general.rfc'), supplier.rfc],
      [t('admin.supplier_dossier.fields.person_type'), supplier.person_type.present? ? t("admin.supplier_dossier.options.#{supplier.person_type}") : nil],
      [t('admin.supplier_dossier.general.fiscal_regime'), supplier.sat_fiscal_regime ? "#{supplier.sat_fiscal_regime.code} — #{supplier.sat_fiscal_regime.description}" : nil],
      [t('admin.supplier_dossier.general.postal_code'), supplier.postal_code]
    ] %>
    <dl class="grid gap-x-8 gap-y-4 pt-5 md:grid-cols-2">
      <% fiscal_fields.each do |label, value| %>
        <div class="border-b border-slate-100 pb-3">
          <dt class="mb-1 text-xs font-medium text-slate-500"><%= label %></dt>
          <dd class="break-words text-sm font-semibold text-slate-900"><%= value.presence || '—' %></dd>
        </div>
      <% end %>
    </dl>
  </div>
  <div class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-emerald-100 bg-emerald-50/50 p-5 shadow-sm sm:p-6">
    <div class="flex items-start gap-3">
      <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-white text-emerald-700"><%= icon('map-pin', class: 'size-5') %></span>
      <div>
        <h3 class="font-jakarta font-bold text-slate-900"><%= t('admin.supplier_dossier.general.fiscal_address') %></h3>
        <p class="mt-1 max-w-xl text-sm text-slate-600"><%= fiscal_address&.full_address.presence || t('admin.supplier_dossier.general.address_hint') %></p>
      </div>
    </div>
    <button type="button" data-action="supplier-dossier#select" data-section="addresses" class="inline-flex min-h-10 items-center gap-2 rounded-lg border border-emerald-200 bg-white px-4 text-sm font-semibold text-emerald-800 hover:bg-emerald-50">
      <%= t('admin.supplier_dossier.general.view_addresses') %>
      <%= icon('arrow-right', class: 'size-4') %>
    </button>
  </div>
</section>
