<div data-supplier-calendar-target="drawer" aria-hidden="true" class="fixed inset-0 z-50 hidden">
  <button type="button" aria-label="<%= t('admin.supplier_calendar.cancel') %>" data-action="supplier-calendar#close" class="absolute inset-0 h-full w-full bg-slate-900/40"></button>
  <aside role="dialog" aria-modal="true" aria-labelledby="supplier-calendar-drawer-title"
         class="absolute inset-y-0 right-0 flex w-full max-w-lg flex-col overflow-y-auto bg-white shadow-2xl">
    <header class="flex items-start justify-between gap-3 border-b border-slate-100 px-6 py-5">
      <div>
        <h3 id="supplier-calendar-drawer-title" class="font-jakarta text-xl font-bold text-slate-900"><%= t('admin.supplier_calendar.new_event') %></h3>
        <p class="mt-1 text-sm text-slate-500"><%= t('admin.supplier_calendar.event_help') %></p>
      </div>
      <button type="button" data-action="supplier-calendar#close" aria-label="<%= t('admin.supplier_calendar.cancel') %>"
              class="flex size-9 shrink-0 items-center justify-center rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50">
        <%= icon('x-mark', class: 'size-5') %>
      </button>
    </header>
    <%= form_with model: supplier.supplier_events.new, url: admin_supplier_events_path(supplier),
                  data: { turbo: false }, class: 'flex flex-1 flex-col px-6 py-6' do |form| %>
      <div class="flex-1 space-y-5">
        <div>
          <%= form.label :title, t('admin.supplier_calendar.fields.title'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
          <%= form.text_field :title, required: true, maxlength: 150, placeholder: t('admin.supplier_calendar.title_placeholder'),
                              class: 'w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-emerald-500' %>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= form.label :kind, t('admin.supplier_dossier.kind'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
            <%= form.select :kind, SupplierEvent::KINDS.map { |kind| [t("admin.supplier_calendar.kinds.#{kind}"), kind] },
                            {}, class: 'w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 text-sm' %>
          </div>
          <div>
            <%= form.label :branch_id, t('admin.supplier_dossier.branch'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
            <%= form.collection_select :branch_id, branches, :id, :name, { include_blank: t('admin.supplier_calendar.select_branch') },
                                       required: true, class: 'w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 text-sm' %>
          </div>
          <div>
            <%= form.label :starts_at, t('admin.supplier_calendar.fields.starts_at'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
            <%= form.datetime_local_field :starts_at, required: true, class: 'w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 text-sm' %>
          </div>
          <div>
            <%= form.label :ends_at, t('admin.supplier_calendar.fields.ends_at'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
            <%= form.datetime_local_field :ends_at, class: 'w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 text-sm' %>
          </div>
        </div>
        <div>
          <%= form.label :notes, t('admin.supplier_dossier.notes'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
          <%= form.text_area :notes, rows: 4, maxlength: 1000,
                             class: 'w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm' %>
        </div>
      </div>
      <footer class="mt-6 flex justify-end gap-3 border-t border-slate-100 pt-5">
        <button type="button" data-action="supplier-calendar#close" class="rounded-xl border border-slate-200 px-5 py-3 text-sm font-semibold text-slate-700"><%= t('admin.supplier_calendar.cancel') %></button>
        <%= form.submit t('admin.supplier_calendar.create_event'), class: 'cursor-pointer rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-700' %>
      </footer>
    <% end %>
  </aside>
</div>
