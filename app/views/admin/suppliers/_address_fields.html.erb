<div data-supplier-nested-item
     data-controller="supplier-postal-assist supplier-country-fields"
     data-action="input->supplier-postal-assist#input change->supplier-postal-assist#input change->supplier-country-fields#update"
     data-supplier-postal-assist-url-value="<%= admin_supplier_postal_suggestions_path %>"
     data-supplier-postal-assist-choice-placeholder-value="<%= t('admin.supplier_details.postal_choose_neighborhood') %>"
     data-supplier-postal-assist-loading-value="<%= t('admin.supplier_details.address_form.postal_loading') %>"
     data-supplier-postal-assist-available-value="<%= t('admin.supplier_details.address_form.postal_available') %>"
     data-supplier-postal-assist-not-found-value="<%= t('admin.supplier_details.address_form.postal_not_found') %>"
     data-supplier-postal-assist-unavailable-value="<%= t('admin.supplier_details.address_form.postal_unavailable') %>"
     class="<%= local_assigns.fetch(:embedded, false) ? '' : 'rounded-2xl border border-slate-200 bg-white p-5 shadow-sm' %>">
  <%= form.hidden_field :id if form.object.persisted? %>
  <%= form.hidden_field :_destroy, value: '0', data: { supplier_nested_destroy: true } %>
  <% if local_assigns.fetch(:allow_remove, true) %>
  <div class="mb-4 flex justify-end"><button type="button" data-action="supplier-nested#remove" class="text-sm font-semibold text-rose-600"><%= t('admin.supplier_details.delete') %></button></div>
<% end %>
  <div class="grid gap-4 sm:grid-cols-2">
    <% %i[street exterior_number interior_number neighborhood city state postal_code].each do |field| %>
      <div <%= 'data-country-postal-wrapper' if field == :postal_code %>>
        <%= form.label field, class: 'mb-2 block text-sm font-semibold text-slate-700' do %>
          <% if %i[state city neighborhood exterior_number postal_code].include?(field) %>
            <span data-country-label data-country-label-mx="<%= t("admin.supplier_details.address_form.country_labels.#{field}.mx") %>" data-country-label-other="<%= t("admin.supplier_details.address_form.country_labels.#{field}.other") %>"><%= t("admin.supplier_details.address_form.country_labels.#{field}.mx") %></span>
          <% else %>
            <%= t("admin.supplier_details.address_fields.#{field}") %>
          <% end %>
          <% if %i[street city].include?(field) %>
            <span data-required-when="always" class="text-rose-600" aria-hidden="true">*</span>
          <% elsif %i[exterior_number neighborhood].include?(field) %>
            <span data-required-when="mx" class="text-rose-600" aria-hidden="true">*</span>
          <% elsif field == :state %>
            <span data-required-when="state" class="text-rose-600" aria-hidden="true">*</span>
          <% elsif field == :postal_code %>
            <span data-required-when="postal" class="text-rose-600" aria-hidden="true">*</span>
          <% end %>
        <% end %>
        <%= form.text_field field,
                            data: ( %i[state city postal_code neighborhood].include?(field) ? { supplier_postal_field: field } : {}),
                            list: (field == :neighborhood ? "#{form.object_name}_neighborhoods".gsub(/[^a-zA-Z0-9_-]/, '_') : nil),
                            placeholder: t("admin.supplier_placeholders.address.#{field}"),
                            inputmode: (field == :postal_code ? 'text' : nil), class: "block min-h-11 w-full rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-2.5 text-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 #{form_state_classes(form.object, field)}" %>
        <% if field == :neighborhood %>
          <datalist id="<%= "#{form.object_name}_neighborhoods".gsub(/[^a-zA-Z0-9_-]/, '_') %>"
                    data-supplier-postal-assist-target="neighborhoods"></datalist>
          <select aria-label="<%= t('admin.supplier_details.postal_choose_neighborhood') %>"
                  data-supplier-postal-assist-target="choices"
                  data-action="change->supplier-postal-assist#chooseNeighborhood"
                  class="mt-2 hidden min-h-10 w-full rounded-xl border border-slate-200 px-3 text-sm"></select>
        <% end %>
        <%= error_message_for(form.object, field) %>
        <% if field == :postal_code %>
          <p class="mt-1 text-xs text-slate-500" data-supplier-postal-assist-target="status" aria-live="polite"></p>
        <% end %>
      </div>
    <% end %>
    <div>
      <%= form.label :country_id, class: 'mb-2 block text-sm font-semibold text-slate-700' do %>
        <%= t('admin.supplier_details.address_fields.country') %> <span class="text-rose-600" aria-hidden="true">*</span>
      <% end %>
      <div class="relative" data-controller="delta-select" data-country-flags="true" data-search-placeholder="<%= t('admin.country_select.search') %>">
        <%= form.select :country_id, options_for_select((@countries || Country.active.ordered).map { |country| [country.localized_name, country.id, { data: { country_code: country.iso_alpha2, flag_url: country_flag_asset_path(country) } }] }, form.object.country_id), { include_blank: t('admin.supplier_placeholders.country') },
                          data: { supplier_postal_field: 'country_id' }, class: "block min-h-11 w-full rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-2.5 text-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 #{form_state_classes(form.object, :country)}" %>
      </div>
      <%= error_message_for(form.object, :country) %>
    </div>
    <% if local_assigns.fetch(:fiscal_locked, false) %>
      <% form.object.purpose = "fiscal" %>
      <%= form.hidden_field :purpose, value: "fiscal" %>
      <div class="mb-4">
        <%= form.label :purpose, t("admin.supplier_details.address_fields.purpose"), class: "mb-2 block text-sm font-semibold text-slate-700" %>
        <%= form.text_field :purpose_display, value: t("admin.supplier_details.address_purposes.fiscal"), disabled: true, class: "block min-h-11 w-full rounded-xl border border-slate-200 bg-slate-100 px-4 py-2.5 text-sm text-slate-500" %>
      </div>
    <% else %>
    <div data-controller="delta-select" class="relative mb-4">
      <%= form.label :purpose, t('admin.supplier_details.address_fields.purpose'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
      <%= form.select :purpose, Address::PURPOSES.map { |purpose| [t("admin.supplier_details.address_purposes.#{purpose}"), purpose] }, { include_blank: t('admin.supplier_placeholders.purpose') }, class: "block min-h-11 w-full rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-2.5 text-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 #{form_state_classes(form.object, :purpose)}" %>
      <%= error_message_for(form.object, :purpose) %>
    </div>
    <% end %>
    <div class="pt-3">
      <label class="inline-flex cursor-pointer items-center gap-3">
        <%= form.check_box :primary, class: 'peer sr-only' %>
        <span aria-hidden="true" class="relative inline-flex h-6 w-11 shrink-0 rounded-full bg-slate-300 transition-colors peer-checked:bg-emerald-600 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-emerald-600 after:absolute after:left-0.5 after:top-0.5 after:size-5 after:rounded-full after:bg-white after:shadow-sm after:transition-transform peer-checked:after:translate-x-5"></span>
        <span class="text-sm font-semibold text-slate-700"><%= t('admin.supplier_details.primary') %></span>
      </label>
      <%= error_message_for(form.object, :primary) %>
    </div>
  </div>
</div>
