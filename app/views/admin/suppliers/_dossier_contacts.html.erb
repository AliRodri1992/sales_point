<section id="supplier-dossier-contacts" role="tabpanel" tabindex="0" aria-labelledby="supplier-dossier-tab-contacts" data-supplier-dossier-target="panel" data-section="contacts" data-controller="supplier-contacts" data-supplier-contacts-url-value="<%= contacts_page_admin_supplier_path(supplier) %>" data-supplier-contacts-next-page-value="<%= contacts_page.next_page || 0 %>" data-supplier-contacts-filter-value="all"
         data-supplier-contacts-no-results-title-value="<%= t('admin.supplier_dossier.contact_cards.no_results_title') %>"
         data-supplier-contacts-no-results-description-value="<%= t('admin.supplier_dossier.contact_cards.no_results_description') %>"
         data-supplier-contacts-empty-title-value="<%= t('admin.supplier_details.no_contacts') %>"
         data-supplier-contacts-empty-description-value="<%= t('admin.supplier_dossier.contact_cards.subtitle') %>" class="hidden w-full min-w-0 space-y-4 lg:flex-1">
  <div data-supplier-contacts-header class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><%= delta_icon('users', class: 'size-5') %></span>
      <div>
        <h2 class="font-jakarta text-xl font-bold text-slate-900"><%= t('admin.supplier_details.contacts') %></h2>
        <p class="mt-1 text-sm text-slate-500"><%= t('admin.supplier_dossier.contact_cards.subtitle') %></p>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <span class="text-sm font-medium text-slate-500" aria-live="polite"><span data-supplier-contacts-target="count"><%= contacts_page.total_count %></span> <%= t('admin.supplier_details.contacts') %></span>
      <label class="relative block min-w-0 sm:w-72">
        <span class="sr-only"><%= t('admin.supplier_details.search_contacts') %></span>
        <%= delta_icon('magnifying-glass', class: 'pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-slate-400') %>
        <input type="search" data-supplier-contacts-target="search" data-action="input->supplier-contacts#search" placeholder="<%= t('admin.supplier_dossier.contact_cards.search_placeholder') %>" class="min-h-10 w-full rounded-xl border border-slate-200 bg-white py-2 pl-10 pr-3 text-sm text-slate-700 placeholder:text-slate-400 focus:border-emerald-500 focus:ring-emerald-500">
      </label>
    </div>
  </div>

  <div data-supplier-contacts-toolbar class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4">
    <div class="flex min-w-0 flex-wrap items-center gap-2" aria-label="<%= t('admin.supplier_dossier.contact_cards.filters') %>">
      <% %w[all active inactive primary].each do |filter| %>
        <button type="button" data-supplier-contacts-target="filter" data-action="supplier-contacts#applyFilter" data-filter="<%= filter %>" aria-pressed="<%= filter == 'all' %>" class="inline-flex min-h-9 items-center gap-1 rounded-full px-4 text-xs font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 <%= filter == 'all' ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
          <%= t("admin.supplier_dossier.contact_cards.filters_options.#{filter}") %>
          <span data-supplier-contacts-target="filterCount" data-filter="<%= filter %>" class="inline-flex min-w-5 items-center justify-center rounded-full bg-white/80 px-1.5 py-0.5 text-[11px] font-bold tabular-nums text-slate-700"><%= contacts_page.filter_counts.fetch(filter) %></span>
        </button>
      <% end %>
    </div>
    <% if can_manage_contacts %>
    <%= link_to admin_supplier_contacts_path(supplier), class: 'inline-flex min-h-10 shrink-0 items-center gap-2 rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-emerald-800 transition hover:bg-emerald-50 sm:ml-auto' do %>
      <%= delta_icon('users', class: 'size-4') %>
      <%= t('admin.supplier_details.manage_contacts') %>
    <% end %>
    <% end %>
  </div>
  </div>

  <div data-supplier-contacts-cards class="min-w-0 pt-1">
    <div class="min-w-0" data-supplier-contacts-target="scroll" tabindex="0" aria-label="<%= t('admin.supplier_dossier.contact_cards.scroll_label') %>">
    <div class="grid grid-cols-1 items-start gap-3 md:grid-cols-2 md:gap-4" data-supplier-contacts-target="list">
      <%= render 'admin/suppliers/dossier_contact_cards', contacts: contacts_page.contacts, supplier: supplier, can_manage_contacts: can_manage_contacts %>
    </div>
    <div data-supplier-contacts-target="empty" class="<%= 'hidden' if contacts_page.total_count.positive? %> rounded-2xl border border-slate-200 bg-white px-5 py-10 text-center shadow-sm sm:px-8 sm:py-14">
      <%= image_tag 'scontactos.png', alt: '', loading: 'lazy', class: 'mx-auto h-auto w-full max-w-[260px] sm:max-w-[300px]' %>
      <h3 data-supplier-contacts-target="emptyTitle" class="mt-3 font-jakarta text-lg font-bold text-slate-900 sm:text-xl"><%= t('admin.supplier_details.no_contacts') %></h3>
      <p data-supplier-contacts-target="emptyText" aria-live="polite" class="mx-auto mt-2 max-w-lg text-sm leading-6 text-slate-500"><%= t('admin.supplier_dossier.contact_cards.subtitle') %></p>
      <% if policy(supplier).create_contacts? %>
        <%= link_to new_admin_supplier_contact_path(supplier), data: { supplier_contacts_target: 'emptyAction' }, class: 'mt-6 inline-flex min-h-10 items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' do %>
          <%= delta_icon('plus', class: 'size-4') %>
          <%= t('admin.supplier_details.add_contact', default: t('admin.supplier_details.manage_contacts')) %>
        <% end %>
      <% end %>
    </div>
    <div data-supplier-contacts-target="sentinel" class="h-1" aria-hidden="true"></div>
    <p data-supplier-contacts-target="loading" role="status" class="hidden py-3 text-center text-xs font-semibold text-emerald-700"><%= t('admin.supplier_dossier.contact_cards.loading') %></p>
    <p data-supplier-contacts-target="error" role="alert" class="hidden py-3 text-center text-sm text-rose-700"><%= t('admin.supplier_dossier.contact_cards.load_error') %></p>
    <div class="flex justify-center py-3">
      <button type="button" data-supplier-contacts-target="loadMore" data-action="supplier-contacts#loadMore" class="<%= 'hidden' unless contacts_page.next_page %> min-h-10 rounded-lg border border-slate-200 px-4 text-sm font-semibold text-emerald-800 transition hover:bg-emerald-50">
        <%= t('admin.supplier_dossier.contact_cards.load_more') %>
      </button>
    </div>
  </div>
  </div>
</section>
