<section id="supplier-dossier-commercial" role="tabpanel" tabindex="0" aria-labelledby="supplier-dossier-tab-commercial" data-supplier-dossier-target="panel" data-section="commercial" class="w-full min-w-0 lg:flex-1 hidden space-y-5">
<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
<div class="flex flex-wrap items-center justify-between gap-3">
<div class="flex items-center gap-3"><span class="rounded-xl bg-emerald-50 p-3 text-emerald-700"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-6" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v5c0 1.66 3.58 3 8 3s8-1.34 8-3V5M4 10v5c0 1.66 3.58 3 8 3s8-1.34 8-3v-5M4 15v4c0 1.66 3.58 3 8 3s8-1.34 8-3v-4"/></svg></span>
<div><h2 class="font-jakarta text-xl font-bold text-slate-900"><%= t('admin.supplier_dossier.commercial.summary') %></h2><p class="text-sm text-slate-500"><%= t('admin.supplier_dossier.commercial.description') %></p></div></div>
<% if can_edit %>
  <%= link_to edit_admin_supplier_path(supplier, return_to: 'commercial'),
              class: 'inline-flex min-h-11 items-center gap-2 rounded-xl border border-slate-200 px-4 text-sm font-semibold text-emerald-800 hover:bg-emerald-50' do %>
    <%= icon('pencil', class: 'size-4') %><%= t('admin.supplier_details.edit') %>
  <% end %>
<% end %>
</div></div>
<div class="grid gap-5 lg:grid-cols-2">
<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
<div class="mb-4 flex items-center gap-3 border-b border-slate-100 pb-4"><span class="rounded-xl bg-emerald-50 p-3 text-emerald-700"><%= icon('credit-card', class: 'size-6') %></span><h3 class="font-jakarta text-lg font-bold text-slate-900"><%= t('admin.supplier_dossier.commercial.payment') %></h3></div>
<dl>
<div class="flex items-center justify-between gap-4 border-b border-slate-100 py-4 last:border-0"><dt class="text-sm text-slate-500"><%= t('admin.supplier_dossier.fields.currency') %></dt><dd class="text-right font-semibold text-slate-900"><%= supplier.currency&.code || '—' %></dd></div>
<div class="flex items-center justify-between gap-4 border-b border-slate-100 py-4 last:border-0"><dt class="text-sm text-slate-500"><%= t('admin.supplier_dossier.fields.credit_days') %></dt><dd class="text-right font-semibold text-slate-900"><%= supplier.credit_days.present? ? supplier.credit_days : '—' %></dd></div>
<div class="flex items-center justify-between gap-4 border-b border-slate-100 py-4 last:border-0"><dt class="text-sm text-slate-500"><%= t('admin.supplier_dossier.fields.credit_limit') %></dt><dd class="text-right font-semibold text-slate-900"><%= supplier.credit_limit.present? ? number_to_currency(supplier.credit_limit, unit: '') + ' ' + (supplier.currency&.code || '—') : '—' %></dd></div></dl></div>
<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
<div class="mb-4 flex items-center gap-3 border-b border-slate-100 pb-4"><span class="rounded-xl bg-emerald-50 p-3 text-emerald-700"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-6" aria-hidden="true"><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/><path d="M19 5 5 19"/></svg></span><h3 class="font-jakarta text-lg font-bold text-slate-900"><%= t('admin.supplier_dossier.commercial.purchase') %></h3></div>
<dl>
<div class="flex items-center justify-between gap-4 border-b border-slate-100 py-4 last:border-0"><dt class="text-sm text-slate-500"><%= t('admin.supplier_dossier.fields.discount_percent') %></dt><dd class="text-right font-semibold text-slate-900"><%= supplier.discount_percent.present? ? "#{supplier.discount_percent}%" : '—' %></dd></div>
<div class="flex items-center justify-between gap-4 border-b border-slate-100 py-4 last:border-0"><dt class="text-sm text-slate-500"><%= t('admin.supplier_dossier.fields.minimum_order_amount') %></dt><dd class="text-right font-semibold text-slate-900"><%= supplier.minimum_order_amount.present? ? number_to_currency(supplier.minimum_order_amount, unit: '') + ' ' + (supplier.currency&.code || '—') : '—' %></dd></div></dl></div></div></section>
