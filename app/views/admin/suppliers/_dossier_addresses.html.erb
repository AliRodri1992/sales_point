<section id="supplier-dossier-addresses" data-supplier-dossier-target="panel" data-section="addresses" data-controller="supplier-addresses" data-supplier-addresses-url-value="<%= addresses_page_admin_supplier_path(supplier) %>" data-supplier-addresses-next-page-value="<%= addresses_page.next_page || 0 %>" data-supplier-addresses-filter-value="all"
         data-supplier-addresses-empty-default-value="<%= t('admin.supplier_dossier.address_cards.empty_description') %>"
         data-supplier-addresses-empty-no-results-value="<%= t('admin.supplier_dossier.address_cards.no_results_description') %>"
         data-supplier-addresses-empty-title-default-value="<%= t('admin.supplier_dossier.address_cards.empty_title') %>"
         data-supplier-addresses-empty-title-no-results-value="<%= t('admin.supplier_dossier.address_cards.no_results_title') %>"
         class="hidden w-full min-w-0 space-y-4 lg:flex-1">
  <div data-supplier-addresses-header class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
    <div data-supplier-addresses-title-row class="grid grid-cols-1 items-center gap-4 lg:grid-cols-[minmax(0,1fr)_auto]">
      <div class="flex min-w-0 items-center gap-3">
        <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
          <%= icon('map-pin', class: 'size-5') %>
        </span>
        <div>
          <h2 class="font-jakarta text-xl font-bold text-slate-900"><%= t('admin.supplier_details.addresses') %></h2>
          <p class="mt-1 text-sm text-slate-500"><%= t('admin.supplier_details.addresses_description') %></p>
        </div>
      </div>
      <div class="flex min-w-0 flex-wrap items-center gap-3 lg:justify-end">
        <span data-supplier-addresses-target="count" class="sr-only" aria-live="polite"><%= addresses_page.total_count %></span>
        <% if can_manage_addresses %>
          <%= link_to admin_supplier_addresses_path(supplier), class: 'inline-flex min-h-10 items-center gap-2 rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-emerald-800 transition hover:bg-emerald-50' do %>
            <%= icon('map-pin', class: 'size-4') %>
            <%= t('admin.supplier_details.manage_addresses') %>
          <% end %>
        <% end %>
      </div>
    </div>

    <div data-supplier-addresses-toolbar class="mt-5 border-t border-slate-100 pt-4">
      <div data-supplier-addresses-filters class="flex min-w-0 flex-wrap items-center gap-2" aria-label="<%= t('admin.supplier_dossier.address_cards.filters') %>">
        <% Suppliers::DossierAddressesPage::FILTERS.each do |filter| %>
          <button type="button" data-supplier-addresses-target="filter" data-action="supplier-addresses#applyFilter" data-filter="<%= filter %>" aria-pressed="<%= filter == 'all' %>" class="inline-flex min-h-9 items-center gap-1 rounded-full px-3 text-xs font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 <%= filter == 'all' ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>">
            <%= t("admin.supplier_dossier.address_cards.filters_options.#{filter}") %>
            <span data-supplier-addresses-target="filterCount" data-filter="<%= filter %>" class="inline-flex min-w-5 items-center justify-center rounded-full bg-white/80 px-1.5 py-0.5 text-[11px] font-bold tabular-nums text-slate-700"><%= addresses_page.filter_counts.fetch(filter) %></span>
          </button>
        <% end %>
      </div>
      <div data-supplier-addresses-search-row class="mt-4 flex w-full items-center">
        <label class="relative block w-full min-w-0 sm:max-w-sm">
          <span class="sr-only"><%= t('admin.supplier_details.search_addresses') %></span>
          <%= icon('magnifying-glass', class: 'pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-slate-400') %>
          <input type="search" data-supplier-addresses-target="search" data-action="input->supplier-addresses#search" placeholder="<%= t('admin.supplier_details.search_addresses') %>" class="min-h-10 w-full rounded-xl border border-slate-200 bg-white py-2 pl-10 pr-3 text-sm text-slate-700 placeholder:text-slate-400 focus:border-emerald-500 focus:ring-emerald-500">
        </label>
      </div>
    </div>
  </div>

  <div data-supplier-addresses-cards class="min-w-0 pt-1">
    <div class="min-w-0" data-supplier-addresses-target="scroll" tabindex="0" aria-label="<%= t('admin.supplier_dossier.address_cards.scroll_label') %>">
      <div class="grid grid-cols-1 items-start gap-3 md:grid-cols-2 md:gap-4" data-supplier-addresses-target="list">
        <%= render 'admin/suppliers/dossier_address_cards', addresses: addresses_page.addresses, supplier: supplier, can_manage_addresses: can_manage_addresses %>
      </div>
      <div data-supplier-addresses-target="empty" class="<%= 'hidden' if addresses_page.total_count.positive? %> rounded-2xl border border-slate-200 bg-white px-5 py-10 text-center shadow-sm sm:px-8 sm:py-14">
        <%= image_tag 'saddresses.png', alt: '', loading: 'lazy', class: 'mx-auto h-auto w-full max-w-[260px] sm:max-w-[300px]' %>
        <h3 data-supplier-addresses-target="emptyTitle" class="mt-3 font-jakarta text-lg font-bold text-slate-900 sm:text-xl"><%= t('admin.supplier_dossier.address_cards.empty_title') %></h3>
        <p data-supplier-addresses-target="emptyText" class="mx-auto mt-2 max-w-lg text-sm leading-6 text-slate-500"><%= t('admin.supplier_dossier.address_cards.empty_description') %></p>
        <% if can_manage_addresses %>
          <%= link_to new_admin_supplier_address_path(supplier, source: 'dossier'), data: { supplier_addresses_target: 'emptyAction' }, class: 'mt-6 inline-flex min-h-10 items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' do %>
            <%= icon('plus', class: 'size-4') %>
            <%= t('admin.supplier_dossier.address_cards.add_first') %>
          <% end %>
        <% end %>
      </div>
      <div data-supplier-addresses-target="sentinel" class="h-1" aria-hidden="true"></div>
      <p data-supplier-addresses-target="loading" role="status" class="hidden py-3 text-center text-xs font-semibold text-emerald-700"><%= t('admin.supplier_dossier.address_cards.loading') %></p>
      <p data-supplier-addresses-target="error" role="alert" class="hidden py-3 text-center text-sm text-rose-700"><%= t('admin.supplier_dossier.address_cards.load_error') %></p>
      <div class="flex justify-center py-3">
        <button type="button" data-supplier-addresses-target="loadMore" data-action="supplier-addresses#loadMore" class="<%= 'hidden' unless addresses_page.next_page %> min-h-10 rounded-lg border border-slate-200 px-4 text-sm font-semibold text-emerald-800 transition hover:bg-emerald-50">
          <%= t('admin.supplier_dossier.address_cards.load_more') %>
        </button>
      </div>
    </div>
  </div>
</section>
