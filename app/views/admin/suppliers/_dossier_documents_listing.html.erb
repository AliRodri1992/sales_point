<div class="mt-5 grid grid-cols-1 items-end gap-3 sm:grid-cols-2 xl:grid-cols-[minmax(0,1.7fr)_repeat(3,minmax(0,1fr))]"
     data-supplier-documents-target="filters">
  <label class="block min-w-0">
    <span class="mb-1 block h-4" aria-hidden="true"></span>
    <span class="sr-only"><%= t("#{dictionary}.search") %></span>
    <span class="relative block">
      <%= icon('magnifying-glass', class: 'pointer-events-none absolute left-3 top-3 size-4 text-slate-400') %>
      <input type="search" data-supplier-documents-target="search"
             data-action="input->supplier-documents#filter" placeholder="<%= t("#{dictionary}.search") %>"
             class="h-10 w-full rounded-lg border border-slate-200 bg-white py-2 pl-9 pr-3 text-sm focus:border-emerald-600 focus:ring-emerald-600">
    </span>
  </label>
  <label class="block min-w-0">
    <span class="mb-1 block h-4 text-xs font-semibold text-slate-700"><%= t("#{dictionary}.document_type") %></span>
    <select data-supplier-documents-target="categorySelect" data-action="change->supplier-documents#filter"
            class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm text-slate-700 focus:border-emerald-600 focus:ring-emerald-600">
      <% categories.each do |category| %>
        <option value="<%= category == 'all' ? '' : category %>"><%= t("#{dictionary}.categories.#{category}") %></option>
      <% end %>
    </select>
  </label>
  <label class="block min-w-0">
    <span class="mb-1 block h-4 text-xs font-semibold text-slate-700"><%= t("#{dictionary}.status") %></span>
    <select data-supplier-documents-target="status" data-action="change->supplier-documents#filter"
            class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm text-slate-700 focus:border-emerald-600 focus:ring-emerald-600">
      <option value=""><%= t("#{dictionary}.all") %></option>
      <% %w[active inactive].each do |status| %>
        <option value="<%= status %>"><%= t("#{dictionary}.statuses.#{status}") %></option>
      <% end %>
    </select>
  </label>
  <label class="block min-w-0">
    <span class="mb-1 block h-4 text-xs font-semibold text-slate-700"><%= t("#{dictionary}.date") %></span>
    <select data-supplier-documents-target="date" data-action="change->supplier-documents#filter"
            class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm text-slate-700 focus:border-emerald-600 focus:ring-emerald-600">
      <option value=""><%= t("#{dictionary}.all") %></option>
      <option value="30"><%= t("#{dictionary}.last_30_days") %></option>
      <option value="365"><%= t("#{dictionary}.last_year") %></option>
    </select>
  </label>
</div>

<div class="mt-5 overflow-x-auto rounded-xl border border-slate-200">
  <table class="w-full min-w-[850px] border-collapse text-left text-sm" aria-label="<%= t('admin.supplier_dossier.documents') %>">
    <thead class="bg-slate-50 text-xs font-semibold text-slate-700">
      <tr>
        <% %w[name document_type date size description status actions].each do |column| %>
          <th scope="col" class="px-3 py-3"><%= t("#{dictionary}.#{column}") %></th>
        <% end %>
      </tr>
    </thead>
    <tbody data-supplier-documents-target="list" class="divide-y divide-slate-100 bg-white">
      <% documents.each do |document| %>
        <% attachment = document.attachment %>
        <% download_url = admin_supplier_document_download_path(supplier, document_id: attachment.id) %>
        <% preview_url = admin_supplier_document_preview_path(supplier, document_id: attachment.id) %>
        <% update_url = admin_supplier_document_update_path(supplier, document_id: attachment.id) %>
        <tr data-supplier-documents-target="card" data-document-id="<%= attachment.id %>"
            data-category="<%= document.category %>"
            data-category-label="<%= t("#{dictionary}.categories.#{document.category}") %>"
            data-format="<%= document.format %>" data-status="<%= document.status %>"
            data-uploaded="<%= attachment.created_at.to_date.iso8601 %>"
            data-filename="<%= document.filename %>" data-size="<%= document.size %>"
            data-description="<%= document.description %>"
            data-date="<%= l(attachment.created_at, format: '%d %b %Y %H:%M') %>"
            data-download-url="<%= download_url %>" data-preview-url="<%= preview_url %>"
            data-update-url="<%= update_url %>" data-preview-kind="<%= document.preview_kind %>"
            class="transition-colors hover:bg-emerald-50/40">
          <td class="px-3 py-3">
            <button type="button" data-action="supplier-documents#select" aria-pressed="false"
                    aria-controls="supplier-document-preview"
                    aria-label="<%= t("#{dictionary}.select", name: document.filename) %>"
                    class="flex max-w-xs items-center gap-2 text-left font-semibold text-emerald-700 hover:text-emerald-800 hover:underline focus-visible:rounded focus-visible:outline-2 focus-visible:outline-emerald-600">
              <%= image_tag "supplier-document-#{document.icon}.svg", alt: '', class: 'size-8 shrink-0' %>
              <span class="min-w-0 break-all"><%= document.filename %></span>
            </button>
          </td>
          <td class="px-3 py-3">
            <span class="inline-flex rounded-full bg-emerald-50 px-2 py-1 text-xs font-semibold text-emerald-800">
              <%= t("#{dictionary}.categories.#{document.category}") %>
            </span>
          </td>
          <td class="whitespace-nowrap px-3 py-3 text-xs text-slate-600"><%= l(attachment.created_at.to_date, format: '%d %b %Y') %></td>
          <td class="whitespace-nowrap px-3 py-3 text-xs text-slate-600"><%= document.size %></td>
          <td class="max-w-60 break-words px-3 py-3 text-xs text-slate-600"><%= document.description.presence || t("#{dictionary}.no_description") %></td>
          <td class="px-3 py-3">
            <span class="<%= document.status == 'active' ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-600' %> inline-flex rounded-full px-2 py-1 text-xs font-semibold">
              <%= t("#{dictionary}.statuses.#{document.status}") %>
            </span>
          </td>
          <td class="px-3 py-3">
            <details class="relative">
              <summary class="flex size-8 cursor-pointer list-none items-center justify-center rounded-lg text-slate-600 hover:bg-emerald-50 hover:text-emerald-800 [&::-webkit-details-marker]:hidden"
                       aria-label="<%= t("#{dictionary}.actions") %>">
                <%= icon('ellipsis-vertical', class: 'size-5') %>
              </summary>
              <div class="absolute right-0 z-20 w-40 rounded-lg border border-slate-200 bg-white p-1 shadow-lg">
                <%= link_to t("#{dictionary}.download"), download_url,
                            class: 'block rounded px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-emerald-50' %>
                <% if can_manage_documents %>
                  <%= button_to t("#{dictionary}.delete"), admin_supplier_document_path(supplier, document_id: attachment.id),
                                method: :delete, form: { data: { turbo_confirm: t('admin.supplier_details.confirm') } },
                                class: 'w-full rounded px-3 py-2 text-left text-xs font-semibold text-rose-600 hover:bg-rose-50' %>
                <% end %>
              </div>
            </details>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<div data-supplier-documents-target="noResults" class="mt-3 hidden rounded-xl border border-slate-200 p-7 text-center text-sm text-slate-500">
  <%= t("#{dictionary}.no_results") %>
</div>
<div class="mt-4 flex flex-wrap items-center justify-between gap-3">
  <p data-supplier-documents-target="range" class="text-xs text-slate-500" aria-live="polite"></p>
  <div class="flex items-center gap-2">
    <button type="button" data-action="supplier-documents#previous" data-supplier-documents-target="previous"
            aria-label="<%= t("#{dictionary}.previous") %>"
            class="flex size-9 items-center justify-center rounded-lg border border-slate-200 text-slate-500 hover:bg-emerald-50">
      <%= icon('chevron-left', class: 'size-4') %>
    </button>
    <span data-supplier-documents-target="page"
          class="flex size-9 items-center justify-center rounded-lg border border-emerald-600 bg-emerald-50 text-xs font-semibold text-emerald-800">1</span>
    <button type="button" data-action="supplier-documents#next" data-supplier-documents-target="next"
            aria-label="<%= t("#{dictionary}.next") %>"
            class="flex size-9 items-center justify-center rounded-lg border border-slate-200 text-slate-500 hover:bg-emerald-50">
      <%= icon('chevron-right', class: 'size-4') %>
    </button>
  </div>
</div>
