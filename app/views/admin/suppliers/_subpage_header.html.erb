<header class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6" data-supplier-subpage-header>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex min-w-0 items-start gap-3 sm:gap-4">
      <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
        <%= delta_icon(icon, class: 'size-6') %>
      </span>
      <div class="min-w-0">
        <p class="break-words text-xs font-semibold uppercase tracking-wide text-emerald-700">
          <%= supplier.code %> · <%= supplier.name %>
        </p>
        <h1 class="mt-1 break-words font-jakarta text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"><%= title %></h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600"><%= subtitle %></p>
      </div>
    </div>
    <%= link_to back_path, data: { loading_message: t('admin.action_loader.returning') },
                class: 'inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-emerald-200 hover:bg-emerald-50 hover:text-emerald-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' do %>
      <%= delta_icon('arrow-left', class: 'size-4') %>
      <%= t('admin.supplier_details.back') %>
    <% end %>
  </div>
</header>
