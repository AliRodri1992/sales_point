<% total_count = local_assigns[:total_count] || @total_count || 0 %>
<% total_pages = local_assigns[:total_pages] || @total_pages || 1 %>
<% can_view_fiscal = current_user.admin? || current_user.permission?('suppliers.fiscal.view') ||
                     current_user.permission?('suppliers.fiscal.manage') %>
<% can_view_general = current_user.admin? || current_user.permission?('suppliers.view') ||
                      current_user.permission?('suppliers.update') %>

<div class="rounded-2xl border border-slate-200 bg-white">
  <div class="flex flex-wrap items-center justify-between gap-3 rounded-t-2xl px-5 py-3">
    <p class="text-xs text-slate-600"><%= t('admin.suppliers.index.filtered_count', count: total_count) %></p>
  </div>

  <% if suppliers.any? %>
    <div data-supplier-mobile-cards class="grid gap-3 px-4 pb-4 md:hidden">
      <% suppliers.each do |supplier| %>
        <article class="min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm" data-supplier-mobile-card="<%= supplier.id %>">
          <div class="flex min-w-0 items-start gap-3">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
              <%= delta_icon('building-office-2', class: 'size-5') %>
            </span>
            <div class="min-w-0 flex-1">
              <p class="break-words font-jakarta text-sm font-bold text-slate-900"><%= supplier.name %></p>
              <p class="mt-1 break-words text-xs font-medium text-slate-500"><%= supplier.code %></p>
              <% if can_view_general && supplier.trade_name.present? && supplier.trade_name != supplier.name %>
                <p class="mt-1 break-words text-xs text-slate-600"><%= supplier.trade_name %></p>
              <% end %>
            </div>
            <span class="shrink-0 rounded-full px-2.5 py-1 text-[11px] font-semibold <%= supplier.active? ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800' %>">
              <%= t("admin.suppliers.statuses.#{supplier.status}") %>
            </span>
          </div>
          <% if can_view_fiscal || can_view_general %>
            <dl class="mt-4 grid gap-3 border-t border-slate-100 pt-4 text-xs sm:grid-cols-2">
              <% if can_view_fiscal %>
                <div class="min-w-0">
                  <dt class="font-semibold text-slate-500"><%= t('admin.suppliers.index.columns.rfc') %></dt>
                  <dd class="mt-1 break-all font-medium text-slate-800"><%= supplier.rfc.presence || '—' %></dd>
                </div>
              <% end %>
              <% if can_view_general %>
                <div class="min-w-0">
                  <dt class="font-semibold text-slate-500"><%= t('admin.suppliers.index.columns.email') %></dt>
                  <dd class="mt-1 break-all font-medium text-slate-800"><%= supplier.email.presence || '—' %></dd>
                </div>
              <% end %>
            </dl>
          <% end %>
          <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-slate-100 pt-4">
            <% if supplier.deleted_at.nil? && policy(supplier).show? %>
              <%= link_to admin_supplier_path(supplier), class: 'inline-flex min-h-11 flex-1 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-3 text-sm font-semibold text-slate-700 hover:bg-slate-50' do %>
                <%= delta_icon('eye', class: 'size-4') %><%= t('admin.suppliers.index.show') %>
              <% end %>
            <% end %>
            <% if supplier.deleted_at.nil? && policy(supplier).edit? %>
              <%= link_to edit_admin_supplier_path(supplier), class: 'inline-flex min-h-11 flex-1 items-center justify-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-3 text-sm font-semibold text-emerald-800 hover:bg-emerald-100' do %>
                <%= delta_icon('pencil-square', class: 'size-4') %><%= t('admin.suppliers.index.edit') %>
              <% end %>
            <% end %>
            <% if supplier.deleted_at.present? && policy(supplier).restore? %>
              <%= button_to t('admin.suppliers.lifecycle.restore'), restore_admin_supplier_path(supplier), method: :patch,
                            class: 'inline-flex min-h-11 items-center rounded-xl border border-emerald-200 px-4 text-sm font-semibold text-emerald-800 hover:bg-emerald-50' %>
            <% elsif supplier.deleted_at.nil? && policy(supplier).destroy? %>
              <%= button_to admin_supplier_path(supplier), method: :delete,
                            form: { data: { turbo_confirm: t('admin.suppliers.index.confirm_delete') } },
                            class: 'inline-flex min-h-11 items-center gap-2 rounded-xl border border-rose-200 px-4 text-sm font-semibold text-rose-700 hover:bg-rose-50' do %>
                <%= delta_icon('archive-box', class: 'size-4') %><%= t('admin.suppliers.index.delete') %>
              <% end %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
    <div class="hidden overflow-x-auto md:block">
      <table class="w-full min-w-[760px] text-sm">
        <thead class="bg-slate-50" data-loading-scope="true">
          <tr class="border-y border-slate-200 text-[11px] font-semibold uppercase tracking-wide text-slate-600">
            <th scope="col" class="px-4 py-3 text-left"><%= sort_link('name', t('admin.suppliers.index.columns.name'), frame: '_top') %></th>
            <% if can_view_fiscal %>
              <th scope="col" class="px-4 py-3 text-left"><%= sort_link('rfc', t('admin.suppliers.index.columns.rfc'), frame: '_top') %></th>
            <% end %>
            <% if can_view_general %>
              <th scope="col" class="px-4 py-3 text-left"><%= sort_link('email', t('admin.suppliers.index.columns.email'), frame: '_top') %></th>
            <% end %>
            <th scope="col" class="px-4 py-3 text-center"><%= sort_link('status', t('admin.suppliers.index.columns.status'), frame: '_top') %></th>
            <th scope="col" class="sticky right-0 z-10 border-l border-slate-200 bg-slate-50 px-4 py-3 text-center"><%= t('admin.suppliers.index.columns.actions') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% suppliers.each do |supplier| %>
            <tr class="group transition hover:bg-emerald-50/40">
              <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                  <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-700"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 7h1m4 0h1M9 11h1m4 0h1M9 15h1m4 0h1M10 21v-3h4v3"/></svg></span>
                  <div class="min-w-0">
                    <p class="font-semibold text-slate-900"><%= supplier.name %></p><p class="text-xs text-slate-400"><%= supplier.code %></p>
                    <% if can_view_general && supplier.trade_name.present? && supplier.trade_name != supplier.name %>
                      <p class="text-xs text-slate-500"><%= supplier.trade_name %></p>
                    <% elsif can_view_general && supplier.classification.present? %>
                      <p class="text-xs text-slate-500"><%= t("admin.suppliers.index.advanced.options.#{supplier.classification}") %></p>
                    <% end %>
                  </div>
                </div>
              </td>
              <% if can_view_fiscal %>
                <td class="whitespace-nowrap px-4 py-3 text-slate-600"><%= supplier.rfc.presence || '—' %></td>
              <% end %>
              <% if can_view_general %>
                <td class="px-4 py-3 text-slate-600"><%= supplier.email.presence || '—' %></td>
              <% end %>
              <td class="px-4 py-3 text-center">
                <span class="inline-flex rounded-lg px-3 py-1 text-xs font-semibold <%= supplier.active? ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700' %>"><%= t("admin.suppliers.statuses.#{supplier.status}") %></span>
              </td>
              <td class="sticky right-0 z-10 border-l border-slate-100 bg-white px-4 py-3 transition-colors group-hover:bg-emerald-50">
                <div class="flex items-center justify-center gap-2">
                  <% if supplier.deleted_at.nil? && policy(supplier).show? %>
                    <%= link_to admin_supplier_path(supplier), data: { tooltip: t('admin.suppliers.index.show'), turbo_frame: '_top', loading_message: t('admin.action_loader.opening') }, class: 'inline-flex size-10 items-center justify-center rounded-lg border border-slate-200 bg-slate-100 text-slate-600 transition hover:border-slate-300 hover:bg-slate-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-500', aria: { label: t('admin.suppliers.index.show') } do %><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="3"/></svg><% end %>
                  <% end %>
                  <% if supplier.deleted_at.nil? && policy(supplier).edit? %>
                    <%= link_to edit_admin_supplier_path(supplier), data: { tooltip: t('admin.suppliers.index.edit'), turbo_frame: '_top', loading_message: t('admin.action_loader.editing') }, class: 'inline-flex size-10 items-center justify-center rounded-lg border border-emerald-200 bg-emerald-50 text-emerald-700 transition hover:border-emerald-300 hover:bg-emerald-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600', aria: { label: t('admin.suppliers.index.edit') } do %><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="m15 5 4 4M4 20l4.5-1 11-11a2.12 2.12 0 0 0-3-3l-11 11L4 20Z"/></svg><% end %>
                  <% end %>
                  <% if (supplier.deleted_at.present? && policy(supplier).restore?) ||
                          (supplier.deleted_at.nil? && policy(supplier).destroy?) %>
                    <details class="relative" data-controller="supplier-dropdown" data-supplier-floating-menu="true">
                      <summary class="inline-flex size-10 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-200 bg-slate-50 text-slate-500 transition hover:border-slate-300 hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-500 [&::-webkit-details-marker]:hidden" aria-label="<%= t('admin.suppliers.index.actions') %>"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/></svg></summary>
                      <div data-supplier-floating-panel class="absolute right-0 z-50 mt-1 min-w-44 rounded-xl border border-slate-200 bg-white p-1 shadow-xl">
                        <% if supplier.deleted_at.present? && policy(supplier).restore? %>
                          <%= button_to t('admin.suppliers.lifecycle.restore'), restore_admin_supplier_path(supplier),
                                        method: :patch, form: { data: { loading_message: t('admin.action_loader.archiving') } }, class: 'w-full rounded px-3 py-2 text-left text-xs font-semibold text-emerald-800 hover:bg-emerald-50' %>
                        <% elsif policy(supplier).destroy? %>
                          <%= button_to admin_supplier_path(supplier), method: :delete, form: { data: { loading_message: t('admin.action_loader.archiving') } }, class: 'flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-xs text-rose-700 hover:bg-rose-50', data: { controller: 'swal-confirm', turbo_frame: '_top', turbo_confirm: t('admin.suppliers.index.confirm_delete'), swal_cancel_text: t('admin.suppliers.confirm.cancel') }, aria: { label: t('admin.suppliers.index.delete') } do %><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="M4 7h16M10 11v7M14 11v7M6 7l1 14h10l1-14M9 7V4h6v3"/></svg><%= t('admin.suppliers.index.delete') %><% end %>
                        <% end %>
                      </div>
                    </details>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if total_count > 0 %>
      <% first_record = ((@current_page || 1) - 1) * (@per_page || 10) + 1 %>
      <% last_record = [first_record + (@per_page || 10) - 1, total_count].min %>
      <div class="flex flex-col gap-4 border-t border-slate-100 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <div class="flex flex-wrap items-center gap-4">
          <%= form_with url: admin_suppliers_path, method: :get, id: 'supplier-pagination-form',
                        data: { controller: 'supplier-page-size', loading_message: t('admin.action_loader.updating'), turbo_frame: '_top', action: 'change->supplier-page-size#apply' },
                        class: 'flex items-center gap-2 text-sm text-slate-600' do %>
            <label for="supplier-page-size"><%= t('admin.suppliers.index.pagination.per_page_label') %></label>
            <%= hidden_field_tag :archived, '1' if params[:archived] == '1' %>
            <% params.permit(:search, :status, :classification, :person_type, :currency, :credit,
                             :sat_fiscal_regime_id, :responsible_user_id, :credit_days_min, :credit_days_max,
                             :credit_limit_min, :credit_limit_max, :minimum_order_amount_min,
                             :minimum_order_amount_max, :discount_percent_min, :discount_percent_max,
                             :created_at_from, :created_at_to, :updated_at_from, :updated_at_to).to_h.each do |key, value| %>
              <%= hidden_field_tag key, value if value.present? %>
            <% end %>
            <%= hidden_field_tag :sort, params[:sort] if params[:sort].present? %>
            <%= hidden_field_tag :direction, params[:direction] if params[:direction].present? %>
            <div class="relative w-24" data-controller="delta-select">
              <%= select_tag :per_page, options_for_select(Admin::SuppliersListing::PER_PAGE_OPTIONS,
                                                           @per_page || 10),
                             id: 'supplier-page-size',
                             class: 'w-full rounded-lg border border-slate-300 px-2 py-1 text-sm text-slate-700 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500' %>
            </div>
            <span><%= t('admin.suppliers.index.pagination.per_page_suffix') %></span>
          <% end %>
          <p class="text-xs font-medium text-slate-600" aria-live="polite">
            <%= t('admin.suppliers.index.pagination.range', first: first_record, last: last_record, total: total_count) %>
          </p>
        </div>
        <% if total_pages > 1 %>
          <nav class="flex flex-wrap items-center gap-1 sm:justify-end" data-loading-scope="true" aria-label="<%= t('admin.suppliers.index.pagination.navigation') %>">
              <%= pagination_links(total_pages, frame: '_top', window: 2) %>
          </nav>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <% filter_keys = %w[search status classification person_type currency credit sat_fiscal_regime_id
                        responsible_user_id credit_days_min credit_days_max credit_limit_min credit_limit_max
                        minimum_order_amount_min minimum_order_amount_max discount_percent_min discount_percent_max
                        created_at_from created_at_to updated_at_from updated_at_to] %>
    <% has_filters = filter_keys.any? { |key| params[key].present? && params[key] != 'all' } %>
    <div class="flex flex-col items-center gap-3 px-6 py-12 text-center sm:px-12">
      <%= image_tag 'deltin/waving.svg', alt: '', loading: 'lazy', class: 'mb-1 h-28 w-28 object-contain' %>
      <h3 class="font-jakarta text-base font-bold text-slate-800">
        <%= t("admin.suppliers.index.#{has_filters ? 'no_results_title' : params[:archived] == '1' ? 'no_archived_title' : 'empty_title'}") %>
      </h3>
      <p class="max-w-md text-sm text-slate-500">
        <%= t("admin.suppliers.index.#{has_filters ? 'no_results_subtitle' : params[:archived] == '1' ? 'no_archived_subtitle' : 'empty_subtitle'}") %>
      </p>
      <% if has_filters %>
        <%= link_to t('admin.suppliers.index.advanced.clear'),
                    admin_suppliers_path(archived: (params[:archived] == '1' ? '1' : nil), per_page: params[:per_page]),
                    data: { turbo_frame: '_top', loading_message: t('admin.action_loader.updating') },
                    class: 'mt-2 inline-flex min-h-10 items-center rounded-lg border border-slate-200 px-4 text-sm font-semibold text-emerald-800 hover:bg-emerald-50' %>
      <% elsif params[:archived] != '1' && policy(Supplier.new).new? %>
        <%= link_to t('admin.suppliers.index.new'), new_admin_supplier_path,
                    data: { loading_message: t('admin.action_loader.creating') },
                    class: 'mt-2 inline-flex min-h-10 items-center rounded-lg bg-emerald-700 px-4 text-sm font-semibold text-white hover:bg-emerald-800' %>
      <% end %>
    </div>
  <% end %>
</div>
