<% documents = @dossier_documents_page.documents.map { |record| Suppliers::DocumentPresenter.new(record) } %>
<% trash_scope = supplier.supplier_documents.trashed %>
<% trash_total = trash_scope.count %>
<% trash_pages = [(trash_total.to_f / 12).ceil, 1].max %>
<% trash_page = params[:trash_page].to_i.clamp(1, trash_pages) %>
<% deleted_documents = trash_scope.includes(attachment: :blob).order(deleted_at: :desc, id: :desc)
                                 .limit(12).offset((trash_page - 1) * 12) %>
<% categories = %w[all contract fiscal catalog technical legal other] %>
<% dictionary = 'admin.supplier_documents' %>
<% initial = documents.first %>

<section id="supplier-dossier-documents" role="tabpanel" tabindex="0" aria-labelledby="supplier-dossier-tab-documents" data-supplier-dossier-target="panel" data-section="documents"
         data-controller="supplier-documents"
         data-supplier-documents-range-label-value="<%= t("#{dictionary}.range", from: '%{from}', to: '%{to}', total: '%{total}') %>"
         data-supplier-documents-files-selected-value="<%= t("#{dictionary}.files_selected", count: '%{count}') %>"
         data-supplier-documents-invalid-files-value="<%= t("#{dictionary}.invalid_files") %>"
         data-supplier-documents-server-page-value="<%= @dossier_documents_page.page %>"
         data-supplier-documents-server-total-value="<%= @dossier_documents_page.total_count %>"
         data-supplier-documents-server-filtered-value="<%= params[:documents_q].present? || params[:documents_category].present? || params[:documents_status].present? || params[:documents_days].present? %>"
         <% if @dossier_documents_page.page > 1 %>
           data-supplier-documents-previous-url-value="<%= admin_supplier_path(supplier, tab: 'documents', documents_page: @dossier_documents_page.page - 1, documents_q: params[:documents_q], documents_category: params[:documents_category], documents_status: params[:documents_status], documents_days: params[:documents_days]) %>"
         <% end %>
         <% if @dossier_documents_page.page < @dossier_documents_page.total_pages %>
           data-supplier-documents-next-url-value="<%= admin_supplier_path(supplier, tab: 'documents', documents_page: @dossier_documents_page.page + 1, documents_q: params[:documents_q], documents_category: params[:documents_category], documents_status: params[:documents_status], documents_days: params[:documents_days]) %>"
         <% end %>
         class="hidden w-full min-w-0 space-y-4 lg:flex-1">
  <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
          <%= icon('document-text', class: 'size-6') %>
        </span>
        <div>
          <h2 class="font-jakarta text-xl font-bold text-slate-900"><%= t('admin.supplier_dossier.documents') %></h2>
          <p class="mt-1 text-sm text-slate-500"><%= t('admin.supplier_dossier.document_empty.subtitle') %></p>
        </div>
      </div>
      <% if can_manage_documents %>
        <button type="button" data-action="supplier-documents#pickFiles"
                class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-emerald-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-800">
          <%= icon('arrow-up-tray', class: 'size-4') %> <%= t("#{dictionary}.upload") %>
        </button>
      <% end %>
    </div>
    <% if can_manage_documents %>
      <%= render 'dossier_documents_upload', supplier: supplier, categories: categories, dictionary: dictionary %>
    <% end %>

    <% if can_manage_documents && deleted_documents.any? %>
      <details class="mt-5 rounded-xl border border-slate-200 bg-slate-50 p-4">
        <summary class="cursor-pointer text-sm font-semibold text-slate-800">
          <%= t('admin.supplier_document_history.trash') %> (<%= trash_total %>)
        </summary>
        <div class="mt-3 space-y-2">
          <% deleted_documents.each do |deleted| %>
            <div class="flex items-center justify-between gap-3 rounded-lg bg-white p-3">
              <span class="break-all text-xs text-slate-700"><%= deleted.attachment.blob.filename %></span>
              <%= button_to t('admin.supplier_document_history.restore'),
                            admin_supplier_document_restore_path(supplier, document_id: deleted.attachment_id),
                            method: :patch, class: 'rounded-lg border border-emerald-200 px-3 py-2 text-xs font-semibold text-emerald-800' %>
            </div>
          <% end %>
          <nav class="mt-4 flex items-center justify-between text-sm text-slate-600" aria-label="<%= t('admin.supplier_document_history.trash') %>">
            <span><%= trash_page %> / <%= trash_pages %></span>
            <div class="flex gap-2">
              <% if trash_page > 1 %>
                <%= link_to t('admin.supplier_documents.previous'), admin_supplier_path(supplier, tab: 'documents', trash_page: trash_page - 1),
                            class: 'rounded-lg border border-slate-200 px-4 py-2' %>
              <% end %>
              <% if trash_page < trash_pages %>
                <%= link_to t('admin.supplier_documents.next'), admin_supplier_path(supplier, tab: 'documents', trash_page: trash_page + 1),
                            class: 'rounded-lg border border-slate-200 px-4 py-2' %>
              <% end %>
            </div>
          </nav>
        </div>
      </details>
    <% end %>

    <% if documents.any? || supplier.supplier_documents.visible.exists? %>
      <div data-supplier-documents-results>
        <%= render 'dossier_documents_listing', supplier: supplier, documents: documents,
                    categories: categories, can_manage_documents: can_manage_documents, dictionary: dictionary %>
      </div>

        <div data-supplier-documents-target="dialog"
             class="fixed inset-0 z-[100] hidden"
             data-action="keydown@window->supplier-documents#handleKeydown">
          <div data-action="click->supplier-documents#closePreview"
               class="absolute inset-0 bg-slate-900/50" aria-hidden="true"></div>
          <aside id="supplier-document-preview" role="dialog" aria-modal="true"
                 aria-labelledby="supplier-document-preview-title"
                 class="absolute inset-y-0 right-0 flex h-full w-full max-w-[42rem] flex-col overflow-y-auto border-l border-emerald-100 bg-white p-5 shadow-2xl sm:p-6">
            <div class="sticky top-0 z-10 -mx-5 -mt-5 mb-3 flex items-center justify-between border-b border-slate-200 bg-white px-5 py-4 sm:-mx-6 sm:-mt-6 sm:px-6">
              <h3 id="supplier-document-preview-title" class="font-jakarta text-lg font-bold text-slate-900"><%= t("#{dictionary}.preview") %></h3>
              <button type="button" data-supplier-documents-target="closeButton"
                      data-action="supplier-documents#closePreview"
                      class="inline-flex size-10 items-center justify-center rounded-xl text-slate-600 transition hover:bg-emerald-50 hover:text-emerald-800"
                      aria-label="<%= t("#{dictionary}.close_preview") %>">
                <%= icon('x-mark', class: 'size-5') %>
              </button>
            </div>
          <div data-supplier-documents-target="previewEmpty" class="hidden mt-5 rounded-lg border border-dashed border-emerald-200 bg-white px-4 py-10 text-center text-sm text-slate-500"><%= t("#{dictionary}.select_hint") %></div>
          <div data-supplier-documents-target="previewContent" class="hidden">
            <div class="mt-3 flex h-[54vh] min-h-64 items-center justify-center overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
              <iframe data-supplier-documents-target="previewFrame" title="<%= t("#{dictionary}.preview") %>"
                      class="hidden size-full border-0" referrerpolicy="same-origin"></iframe>
              <img data-supplier-documents-target="previewImage" alt="<%= t("#{dictionary}.preview") %>" class="hidden h-full w-full object-contain">
              <pre data-supplier-documents-target="previewText" class="hidden size-full overflow-auto whitespace-pre-wrap break-words p-3 text-left font-mono text-xs text-slate-700"></pre>
              <p data-supplier-documents-target="previewError" class="hidden px-5 text-center text-sm text-rose-600"><%= t("#{dictionary}.preview_error") %></p>
              <div data-supplier-documents-target="unsupported" class="hidden px-5 text-center text-sm text-slate-500">
                <%= icon('document-text', class: 'mx-auto mb-3 size-10 text-emerald-600') %><%= t("#{dictionary}.unsupported_preview") %>
              </div>
            </div>
            <p data-supplier-documents-target="previewName" class="mt-4 break-all text-sm font-bold text-slate-900"></p>
            <dl class="mt-3 space-y-3 text-xs">
              <div class="grid grid-cols-[5rem_minmax(0,1fr)] gap-2"><dt class="text-slate-500"><%= t("#{dictionary}.category") %></dt><dd data-supplier-documents-target="previewType" class="font-medium text-slate-800"></dd></div>
              <div class="grid grid-cols-[5rem_minmax(0,1fr)] gap-2"><dt class="text-slate-500"><%= t("#{dictionary}.size") %></dt><dd data-supplier-documents-target="previewSize" class="font-medium text-slate-800"></dd></div>
              <div class="grid grid-cols-[5rem_minmax(0,1fr)] gap-2"><dt class="text-slate-500"><%= t("#{dictionary}.date") %></dt><dd data-supplier-documents-target="previewDate" class="font-medium text-slate-800"></dd></div>
              <div class="grid grid-cols-[5rem_minmax(0,1fr)] gap-2"><dt class="text-slate-500"><%= t("#{dictionary}.description") %></dt><dd data-supplier-documents-target="previewDescription" class="break-words font-medium text-slate-800"></dd></div>
            </dl>
            <div class="mt-5 grid grid-cols-2 gap-2">
              <a data-supplier-documents-target="download" href="#" class="flex min-h-10 items-center justify-center gap-1 rounded-lg bg-emerald-700 px-2 text-xs font-bold text-white hover:bg-emerald-800"><%= icon('arrow-down-tray', class: 'size-4') %><%= t("#{dictionary}.download") %></a>
              <a data-supplier-documents-target="open" href="#" target="_blank" rel="noopener noreferrer"
                 class="flex min-h-10 items-center justify-center gap-1 rounded-lg border border-slate-200 bg-white px-2 text-xs font-semibold text-slate-700 hover:bg-emerald-50"><%= icon('arrow-top-right-on-square', class: 'size-4') %><%= t("#{dictionary}.open") %></a>
            </div>
            <% if can_manage_documents %>
              <details data-supplier-documents-target="replaceDetails" class="mt-2">
                <summary class="flex min-h-10 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-200 bg-white text-xs font-semibold text-slate-700 hover:bg-emerald-50 [&::-webkit-details-marker]:hidden"><%= t("#{dictionary}.replace") %></summary>
                <%= form_with url: admin_supplier_document_update_path(supplier, document_id: initial&.attachment&.id || 0), scope: :document, method: :patch, multipart: true,
                              data: { supplier_documents_target: 'replaceForm' }, class: 'mt-2 space-y-2' do |f| %>
                  <%= f.file_field :file, required: true, accept: '.pdf,.png,.jpg,.jpeg,.doc,.docx,.xls,.xlsx,.csv,.xml,.txt', class: 'block w-full text-xs' %>
                  <%= f.submit t("#{dictionary}.save"), class: 'w-full cursor-pointer rounded-lg bg-emerald-700 px-3 py-2 text-xs font-semibold text-white' %>
                <% end %>
              </details>
              <details data-supplier-documents-target="editDetails" class="mt-2">
                <summary class="flex min-h-10 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-200 bg-white text-xs font-semibold text-slate-700 hover:bg-emerald-50 [&::-webkit-details-marker]:hidden"><%= t("#{dictionary}.edit_info") %></summary>
                <%= form_with url: admin_supplier_document_update_path(supplier, document_id: initial&.attachment&.id || 0), scope: :document, method: :patch,
                              data: { supplier_documents_target: 'editForm' }, class: 'mt-2 space-y-3' do |f| %>
                  <%= f.label :category, t("#{dictionary}.category"), class: 'block text-xs font-semibold text-slate-700' %>
                  <%= f.select :category, categories.drop(1).map { |category| [t("#{dictionary}.categories.#{category}"), category] }, {},
                               data: { supplier_documents_target: 'editCategory' }, class: 'w-full rounded-lg border border-slate-200 px-3 py-2 text-xs' %>
                  <%= f.label :status, t("#{dictionary}.status"), class: 'block text-xs font-semibold text-slate-700' %>
                  <%= f.select :status, %w[active inactive].map { |status| [t("#{dictionary}.statuses.#{status}"), status] }, {},
                               data: { supplier_documents_target: 'editStatus' }, class: 'w-full rounded-lg border border-slate-200 px-3 py-2 text-xs' %>
                  <%= f.label :description, t("#{dictionary}.description"), class: 'block text-xs font-semibold text-slate-700' %>
                  <%= f.text_area :description, rows: 2, maxlength: 300, data: { supplier_documents_target: 'editDescription' },
                                  class: 'w-full rounded-lg border border-slate-200 px-3 py-2 text-xs' %>
                  <%= f.submit t("#{dictionary}.save"), class: 'w-full cursor-pointer rounded-lg bg-emerald-700 px-3 py-2 text-xs font-semibold text-white' %>
                <% end %>
              </details>
            <% end %>
          </div>
          </aside>
        </div>
    <% else %>
      <div class="mt-5 rounded-2xl border border-slate-200 px-5 py-10 text-center sm:px-8">
        <%= image_tag 'sdocuments.png', alt: '', loading: 'lazy', class: 'mx-auto w-full max-w-[250px]' %>
        <h3 class="mt-3 font-jakarta text-lg font-bold text-slate-900"><%= t('admin.supplier_dossier.document_empty.title') %></h3>
        <p class="mx-auto mt-2 max-w-lg text-sm text-slate-500"><%= t('admin.supplier_dossier.document_empty.description') %></p>
        <% if can_manage_documents %>
          <p class="mt-3 text-sm font-semibold text-emerald-700"><%= t("#{dictionary}.upload_hint") %></p>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
