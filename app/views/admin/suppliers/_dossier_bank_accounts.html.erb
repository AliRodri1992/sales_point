<section id="supplier-dossier-bank-accounts" data-supplier-dossier-target="panel" data-section="bank_accounts"
         class="hidden w-full min-w-0 space-y-4 lg:flex-1">
  <% bank_page = @dossier_bank_accounts_page %>
  <div data-finance-bank-accounts class="min-w-0 space-y-4">
    <div data-finance-banks-header class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
      <div data-finance-banks-heading-row class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex min-w-0 items-center gap-3">
          <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
            <%= icon('building-library', class: 'size-5') %>
          </span>
          <div>
            <h2 class="font-jakarta text-xl font-bold text-slate-900"><%= t('admin.accounts_payable.bank_accounts') %></h2>
            <p class="mt-1 text-sm text-slate-500"><%= t('admin.accounts_payable.bank_list.description') %></p>
          </div>
        </div>
        <%= link_to admin_supplier_bank_accounts_path(supplier),
                    aria: { label: t('admin.supplier_dossier.finance.manage_banks') },
                    class: 'inline-flex min-h-10 items-center gap-2 rounded-xl border border-emerald-200 bg-white px-4 py-2 text-sm font-semibold text-emerald-800 transition hover:bg-emerald-50' do %>
          <%= icon('arrow-top-right-on-square', class: 'size-4') %>
          <%= t('admin.supplier_dossier.finance.manage_banks') %>
        <% end %>
      </div>
    </div>

    <div data-finance-banks-content class="min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
      <%= form_with url: admin_supplier_path(supplier), method: :get,
                    class: 'grid items-end gap-3 sm:grid-cols-2 xl:grid-cols-[minmax(0,1fr)_minmax(9rem,12rem)_minmax(9rem,12rem)_auto]' do %>
        <%= hidden_field_tag :tab, 'bank_accounts' %>
        <div class="relative min-w-0 sm:col-span-2 xl:col-span-1">
          <label for="dossier-banks-search" class="sr-only"><%= t('admin.accounts_payable.bank_list.search') %></label>
          <%= icon('magnifying-glass', class: 'pointer-events-none absolute left-3 top-1/2 size-5 -translate-y-1/2 text-slate-400') %>
          <%= search_field_tag :banks_q, bank_page.query, id: 'dossier-banks-search', maxlength: 100,
                               placeholder: t('admin.accounts_payable.bank_list.search_placeholder'),
                               class: 'min-h-11 w-full rounded-xl border border-slate-200 bg-slate-50 py-2.5 pl-10 pr-3 text-sm text-slate-800 outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100' %>
        </div>
        <div>
          <label for="dossier-banks-bank" class="sr-only"><%= t('admin.bank_cards.bank_filter') %></label>
          <%= select_tag :banks_bank,
                         options_for_select([[t('admin.bank_cards.all_banks'), '']] + bank_page.banks.map { |bank| [bank, bank] },
                                            bank_page.bank),
                         id: 'dossier-banks-bank',
                         class: 'min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm text-slate-800 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100' %>
        </div>
        <div>
          <label for="dossier-banks-status" class="sr-only"><%= t('admin.bank_cards.status_filter') %></label>
          <%= select_tag :banks_status,
                         options_for_select([
                           [t('admin.bank_cards.all_statuses'), 'all'],
                           [t('admin.bank_cards.active_plural'), 'active'],
                           [t('admin.bank_cards.inactive_plural'), 'archived']
                         ], bank_page.status),
                         id: 'dossier-banks-status',
                         class: 'min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm text-slate-800 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100' %>
        </div>
        <%= button_tag type: :submit,
                       class: 'inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-emerald-700 px-4 text-sm font-semibold text-white transition hover:bg-emerald-800' do %>
          <%= icon('magnifying-glass', class: 'size-4') %>
          <%= t('admin.accounts_payable.bank_list.search') %>
        <% end %>
      <% end %>

      <nav data-finance-bank-status-tabs class="mt-5 flex gap-2 overflow-x-auto border-b border-slate-200"
           aria-label="<%= t('admin.bank_cards.status_filter') %>">
        <% [['all', :all, 'all_label'], ['active', :active, 'active_plural'],
            ['archived', :archived, 'inactive_plural']].each do |status, key, label| %>
          <%= link_to admin_supplier_path(supplier, tab: 'bank_accounts', banks_status: status,
                                          banks_q: bank_page.query.presence, banks_bank: bank_page.bank.presence),
                      aria: { current: ('page' if bank_page.status == status) },
                      class: "inline-flex shrink-0 items-center gap-1 border-b-[3px] px-4 py-3 text-sm font-semibold transition #{bank_page.status == status ? 'border-emerald-600 text-emerald-800' : 'border-transparent text-slate-500 hover:text-slate-800'}" do %>
            <%= t("admin.bank_cards.#{label}") %>
            <span class="text-xs tabular-nums">(<%= bank_page.counts.fetch(key) %>)</span>
          <% end %>
        <% end %>
      </nav>

      <div data-finance-bank-cards class="mt-5 grid min-w-0 gap-4 md:grid-cols-2 2xl:grid-cols-3">
        <%= render partial: 'admin/supplier_bank_accounts/account_card', collection: bank_page.accounts,
                   as: :account, locals: { supplier: supplier } %>

        <% if bank_page.status != 'archived' && bank_page.query.blank? && bank_page.bank.blank? &&
              supplier.active? &&
              policy(SupplierBankAccount.new(organization: current_organization, supplier: supplier)).create? %>
          <%= link_to new_admin_supplier_bank_account_path(supplier),
                      data: { finance_bank_add_tile: true },
                      class: 'flex min-h-[214px] min-w-0 flex-col items-center justify-center rounded-2xl border-2 border-dashed border-emerald-300 bg-emerald-50/30 p-5 text-center transition hover:border-emerald-600 hover:bg-emerald-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' do %>
            <span class="mb-3 flex size-14 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
              <%= icon('plus', class: 'size-7') %>
            </span>
            <span class="font-jakarta text-base font-bold text-emerald-800"><%= t('admin.accounts_payable.new_bank') %></span>
            <span class="mt-1 max-w-56 text-xs leading-5 text-slate-500"><%= t('admin.bank_cards.add_hint') %></span>
          <% end %>
        <% end %>
      </div>

      <% if bank_page.total_count.zero? %>
        <div data-finance-empty-banks class="mt-5 rounded-xl bg-slate-50 px-4 py-5 text-center text-sm text-slate-600">
          <p class="font-jakarta font-bold text-slate-800"><%= t('admin.accounts_payable.bank_list.empty_title') %></p>
          <p class="mt-1"><%= t('admin.accounts_payable.bank_list.empty_description') %></p>
        </div>
      <% end %>

      <footer data-finance-bank-pagination class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4">
        <p class="text-sm text-slate-500">
          <%= t('admin.bank_cards.range', from: bank_page.from, to: bank_page.to, total: bank_page.total_count) %>
        </p>
        <% if bank_page.total_pages > 1 %>
          <nav aria-label="<%= t('admin.bank_cards.pagination') %>" class="flex flex-wrap items-center gap-2">
            <% if bank_page.page > 1 %>
              <%= link_to t('admin.accounts_payable.bank_list.previous'),
                          admin_supplier_path(supplier, tab: 'bank_accounts', banks_q: bank_page.query.presence,
                                              banks_bank: bank_page.bank.presence, banks_status: bank_page.status,
                                              banks_page: bank_page.page - 1),
                          class: 'rounded-lg border border-slate-200 px-3 py-2 text-sm font-semibold text-emerald-800' %>
            <% end %>
            <span class="flex size-9 items-center justify-center rounded-lg bg-emerald-700 text-sm font-bold text-white tabular-nums">
              <%= bank_page.page %>
            </span>
            <% if bank_page.page < bank_page.total_pages %>
              <%= link_to t('admin.accounts_payable.bank_list.next'),
                          admin_supplier_path(supplier, tab: 'bank_accounts', banks_q: bank_page.query.presence,
                                              banks_bank: bank_page.bank.presence, banks_status: bank_page.status,
                                              banks_page: bank_page.page + 1),
                          class: 'rounded-lg border border-slate-200 px-3 py-2 text-sm font-semibold text-emerald-800' %>
            <% end %>
          </nav>
        <% end %>
      </footer>
    </div>
  </div>
</section>
