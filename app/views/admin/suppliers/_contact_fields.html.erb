<div data-supplier-nested-item class="<%= local_assigns.fetch(:embedded, false) ? '' : 'rounded-2xl border border-slate-200 bg-white p-5 shadow-sm' %>">
  <%= form.hidden_field :id if form.object.persisted? %>
  <%= form.hidden_field :_destroy, value: '0', data: { supplier_nested_destroy: true } %>
  <% if local_assigns.fetch(:allow_remove, true) %>
  <div class="mb-4 flex justify-end"><button type="button" data-action="supplier-nested#remove" class="text-sm font-semibold text-rose-600"><%= t('admin.supplier_details.delete') %></button></div>
<% end %>
  <div class="grid gap-4 sm:grid-cols-2">
    <% %i[name position email phone mobile_phone].each do |field| %>
      <div>
        <%= form.label field, t("admin.supplier_details.contact_fields.#{field}"), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <% if %i[phone mobile_phone].include?(field) %>
          <div data-controller="international-phone" class="[&_.iti]:w-full [&_.iti__tel-input]:w-full">
            <%= form.telephone_field field, placeholder: t("admin.supplier_placeholders.contact.#{field}"), data: { international_phone_target: 'input' }, class: "block min-h-11 w-full rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-2.5 text-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 #{form_state_classes(form.object, field)}" %>
          </div>
        <% else %>
          <%= form.text_field field, placeholder: t("admin.supplier_placeholders.contact.#{field}"), class: "block min-h-11 w-full rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-2.5 text-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 #{form_state_classes(form.object, field)}" %>
        <% end %>
        <%= error_message_for(form.object, field) %>
      </div>
    <% end %>
    <div>
      <% if local_assigns.fetch(:primary_locked, false) %>
        <%= form.hidden_field :primary, value: '1' %>
        <span class="text-sm font-semibold text-slate-700"><%= t('admin.supplier_details.primary') %></span>
      <% else %>
      <label class="inline-flex cursor-pointer items-center gap-3">
        <%= form.check_box :primary, class: 'peer sr-only' %>
        <span aria-hidden="true" class="relative inline-flex h-6 w-11 shrink-0 rounded-full bg-slate-300 transition-colors peer-checked:bg-emerald-600 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-emerald-600 after:absolute after:left-0.5 after:top-0.5 after:size-5 after:rounded-full after:bg-white after:shadow-sm after:transition-transform peer-checked:after:translate-x-5"></span>
        <span class="text-sm font-semibold text-slate-700"><%= t('admin.supplier_details.primary') %></span>
      </label>
      <% end %>
      <%= error_message_for(form.object, :primary) %>
    </div>
    <% if form.object.persisted? %>
    <div>
      <label class="inline-flex cursor-pointer items-center gap-3">
        <%= form.check_box :active, class: 'peer sr-only' %>
        <span aria-hidden="true" class="relative inline-flex h-6 w-11 shrink-0 rounded-full bg-slate-300 transition-colors peer-checked:bg-emerald-600 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-emerald-600 after:absolute after:left-0.5 after:top-0.5 after:size-5 after:rounded-full after:bg-white after:shadow-sm after:transition-transform peer-checked:after:translate-x-5"></span>
        <span class="text-sm font-semibold text-slate-700"><%= t('admin.supplier_details.contact_fields.active') %></span>
      </label>
      <%= error_message_for(form.object, :active) %>
    </div>
    <% end %>
  </div>
</div>
