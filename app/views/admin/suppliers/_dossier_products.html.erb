<section id="supplier-dossier-products" data-supplier-dossier-target="panel" data-section="products"
         class="hidden w-full min-w-0 lg:flex-1">
  <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
    <header class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex min-w-0 items-center gap-3">
        <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
          <%= icon('cube', class: 'size-5') %>
        </span>
        <div class="min-w-0">
          <h2 class="font-jakarta text-xl font-bold text-slate-900"><%= t('admin.procurement.title') %></h2>
          <p class="mt-1 text-sm text-slate-500"><%= t('admin.procurement.description') %></p>
        </div>
      </div>
      <%= link_to admin_supplier_supplier_products_path(supplier),
                  class: 'inline-flex min-h-10 shrink-0 items-center gap-2 rounded-xl border border-emerald-200 bg-white px-4 py-2 text-sm font-semibold text-emerald-800 transition hover:bg-emerald-50' do %>
        <%= icon('cube', class: 'size-4') %>
        <%= t('admin.supplier_dossier.product_empty.manage') %>
      <% end %>
    </header>

    <% if products_page.total_count.positive? %>
      <div data-supplier-products-grid class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4">
        <% products_page.offers.each do |offer| %>
          <% product = offer.product %>
          <article data-supplier-product-card class="min-w-0 rounded-xl border border-slate-200 bg-white p-4">
            <div class="flex min-w-0 items-start gap-3">
              <div class="flex size-24 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-slate-100 bg-slate-50 sm:size-28">
                <% if product.image.attached? %>
                  <%= image_tag product.image.variant(resize_to_limit: [160, 160]),
                                alt: product.name, loading: 'lazy',
                                class: 'h-full w-full object-contain' %>
                <% else %>
                  <%= image_tag 'supplier-product-placeholder.svg',
                                alt: t('admin.procurement.no_image'), loading: 'lazy',
                                class: 'h-full w-full object-contain' %>
                <% end %>
              </div>
              <div class="min-w-0 flex-1">
                <h3 class="break-words font-jakarta text-sm font-bold text-slate-900"><%= product.name %></h3>
                <p class="mt-1 break-words text-xs text-slate-500">
                  <%= t('admin.procurement.sku_label') %>: <%= product.sku.presence || product.code %>
                </p>
                <p class="mt-1 break-words text-xs text-slate-500">
                  <%= t('admin.procurement.supplier_sku') %>: <%= offer.supplier_sku.presence || '—' %>
                </p>
                <% if offer.preferred? %>
                  <span class="mt-2 inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-800">
                    <%= icon('star', class: 'size-3.5') %>
                    <%= t('admin.supplier_dossier.product_cards.preferred') %>
                  </span>
                <% end %>
              </div>
            </div>
            <dl class="mt-4 border-t border-slate-100 pt-3">
              <div>
                <dt class="text-xs text-slate-500"><%= t('admin.procurement.presentation') %></dt>
                <dd class="mt-1 break-words text-sm font-semibold text-slate-800">
                  <%= offer.presentation_name %> ·
                  <%= number_with_precision(offer.units_per_package, precision: 4, strip_insignificant_zeros: true) %>
                  <%= t('admin.procurement.units_short') %>
                </dd>
              </div>
              <div class="mt-3 grid grid-cols-2 divide-x divide-slate-100 border-t border-slate-100 pt-3">
                <div class="min-w-0 pr-2">
                  <dt class="text-xs text-slate-500"><%= t('admin.procurement.purchase_price') %></dt>
                  <dd class="mt-1 break-words text-base font-bold tabular-nums text-emerald-900">
                    <%= number_to_currency(offer.purchase_price, unit: '') %>
                    <span class="text-xs font-medium text-slate-500"><%= offer.currency.code %></span>
                  </dd>
                </div>
                <div class="min-w-0 pl-3">
                  <dt class="text-xs text-slate-500"><%= t('admin.procurement.unit_cost') %></dt>
                  <dd class="mt-1 break-words text-base font-bold tabular-nums text-emerald-900">
                    <%= number_to_currency(offer.unit_cost, unit: '', precision: 4, strip_insignificant_zeros: true) %>
                    <span class="text-xs font-medium text-slate-500"><%= offer.currency.code %></span>
                  </dd>
                </div>
              </div>
            </dl>
          </article>
        <% end %>
      </div>
      <footer data-supplier-products-pagination class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4">
        <p class="text-sm text-slate-500">
          <%= t('admin.supplier_dossier.product_cards.range', from: products_page.from,
                to: products_page.to, total: products_page.total_count) %>
        </p>
        <% if products_page.total_pages > 1 %>
          <nav aria-label="<%= t('admin.supplier_dossier.product_cards.pages') %>" class="flex flex-wrap items-center gap-1.5">
            <% if products_page.page > 1 %>
              <%= link_to admin_supplier_path(supplier, tab: 'products', products_page: products_page.page - 1),
                          aria: { label: t('admin.procurement.previous') },
                          class: 'inline-flex size-9 items-center justify-center rounded-lg border border-slate-200 text-slate-600 transition hover:border-emerald-200 hover:bg-emerald-50 hover:text-emerald-800' do %>
                <%= icon('chevron-left', class: 'size-4') %>
              <% end %>
            <% end %>
            <% products_page.visible_pages.each do |number| %>
              <%= link_to number, admin_supplier_path(supplier, tab: 'products', products_page: number),
                          aria: { current: ('page' if number == products_page.page) },
                          class: "inline-flex size-9 items-center justify-center rounded-lg border text-sm font-semibold tabular-nums #{number == products_page.page ? 'border-emerald-600 bg-emerald-100 text-emerald-900' : 'border-slate-200 text-slate-600 hover:bg-emerald-50 hover:text-emerald-800'}" %>
            <% end %>
            <% if products_page.page < products_page.total_pages %>
              <%= link_to admin_supplier_path(supplier, tab: 'products', products_page: products_page.page + 1),
                          aria: { label: t('admin.procurement.next') },
                          class: 'inline-flex size-9 items-center justify-center rounded-lg border border-slate-200 text-slate-600 transition hover:border-emerald-200 hover:bg-emerald-50 hover:text-emerald-800' do %>
                <%= icon('chevron-right', class: 'size-4') %>
              <% end %>
            <% end %>
          </nav>
        <% end %>
      </footer>
    <% else %>
      <div class="mt-5 rounded-2xl border border-slate-200 bg-white px-5 py-10 text-center sm:px-8 sm:py-12">
        <%= image_tag 'sproducts.png', alt: '', loading: 'lazy',
                      class: 'mx-auto h-auto w-full max-w-[260px] sm:max-w-[300px]' %>
        <h3 class="mt-3 font-jakarta text-lg font-bold text-slate-900 sm:text-xl">
          <%= t('admin.supplier_dossier.product_empty.title') %>
        </h3>
        <p class="mx-auto mt-2 max-w-lg text-sm leading-6 text-slate-500">
          <%= t('admin.supplier_dossier.product_empty.description') %>
        </p>
        <% if policy(supplier).manage_products? %>
          <%= link_to new_admin_supplier_supplier_product_path(supplier),
                      class: 'mt-6 inline-flex min-h-10 items-center justify-center gap-2 rounded-xl bg-emerald-700 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-800' do %>
            <%= icon('plus', class: 'size-4') %>
            <%= t('admin.supplier_dossier.product_empty.add_first') %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
