<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
  <div class="border-b border-slate-100 px-6 py-5">
    <h1 class="font-jakarta text-xl font-bold text-slate-900"><%= t('admin.suppliers.show.title') %></h1>
    <p class="mt-1 text-sm text-slate-500"><%= t('admin.suppliers.show.subtitle') %></p>
  </div>
  <dl class="grid gap-x-8 px-6 py-2 sm:grid-cols-2">
    <% fields = [
      ['code', supplier.code], ['name', supplier.name],
      ['email', supplier.email.presence || '—'], ['phone', supplier.phone.presence || '—'],
      ['rfc', supplier.rfc.presence || '—'],
      ['fiscal_regime', supplier.sat_fiscal_regime ? "#{supplier.sat_fiscal_regime.code} — #{supplier.sat_fiscal_regime.description}" : '—'],
      ['postal_code', supplier.postal_code.presence || '—'],
      ['status', t("admin.suppliers.statuses.#{supplier.status}")],
      ['notes', supplier.notes.presence || '—']
    ] %>
    <% fields.each do |key, value| %>
      <div class="border-b border-slate-100 py-4 <%= key == 'notes' ? 'sm:col-span-2' : '' %>">
        <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400"><%= t("admin.suppliers.show.fields.#{key}") %></dt>
        <dd class="mt-1 break-words text-sm font-medium text-slate-900"><%= value %></dd>
      </div>
    <% end %>
  </dl>
  <div class="flex items-center justify-end gap-2 border-t border-slate-100 px-6 py-4">
    <%= link_to t('admin.suppliers.show.back'), admin_suppliers_path,
                class: 'inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-600 transition hover:bg-slate-50' %>
    <% if policy(supplier).edit? %>
      <%= link_to edit_admin_supplier_path(supplier),
                  class: 'inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700' do %>
        <%= icon('pencil-square', class: 'size-4') %>
        <%= t('admin.suppliers.index.edit') %>
      <% end %>
    <% end %>
  </div>
</div>
