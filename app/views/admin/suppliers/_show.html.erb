<% contacts = supplier.contacts.not_deleted.order(primary: :desc, name: :asc) %>
<% addresses = supplier.addresses.not_deleted.includes(:country).order(primary: :desc, id: :asc) %>
<% fiscal_address = addresses.detect { |address| address.purpose == 'fiscal' } %>
<% schedules = supplier.supplier_schedules.not_deleted.includes(:branch).order(weekday: :asc, starts_at: :asc) %>
<% can_edit = policy(supplier).update? %>
<% can_view_finances = current_user.admin? || current_user.permission?('accounts_payable.view') %>
<% dossier_sections = %w[overview general fiscal commercial contacts addresses schedules documents products] %>
<% dossier_sections << 'finances' if can_view_finances %>

<div class="space-y-5" data-controller="supplier-dossier" data-supplier-dossier-initial-tab-value="<%= dossier_sections.include?(params[:tab]) ? params[:tab] : 'overview' %>">
  <nav aria-label="<%= t('admin.supplier_dossier.navigation.breadcrumbs') %>" class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
    <%= link_to t('admin.supplier_dossier.navigation.suppliers'), admin_suppliers_path, class: 'transition hover:text-emerald-700' %>
    <%= icon('chevron-right', class: 'size-4 text-slate-400') %>
    <span class="font-semibold text-slate-800"><%= supplier.name %></span>
  </nav>

  <header class="flex flex-wrap items-start justify-between gap-4 border-b border-slate-200 pb-5">
    <div class="flex min-w-0 items-center gap-4">
      <span class="flex size-16 shrink-0 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-800 sm:size-[76px]">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="size-9" aria-hidden="true">
          <path d="M3 21h18M5 21V5l8-2v18M13 9l6 2v10M8 8h2M8 12h2M8 16h2M16 14h1M16 17h1"/>
        </svg>
      </span>
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="font-jakarta text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"><%= supplier.name %></h1>
          <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-bold <%= supplier.active? ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-600' %>"><%= t("admin.suppliers.statuses.#{supplier.status}") %></span>
        </div>
        <p class="mt-1 text-sm text-slate-500">
          <%= supplier.code %>
          <% if supplier.classification.present? %>
            <span class="mx-2 text-slate-300">·</span>
            <%= t("admin.supplier_dossier.options.#{supplier.classification}") %>
          <% end %>
        </p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to admin_suppliers_path, data: { turbo_frame: '_top' }, class: 'inline-flex min-h-10 items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-emerald-50 hover:text-emerald-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' do %>
        <%= icon('arrow-left', class: 'size-4') %>
        <%= t('admin.supplier_dossier.back') %>
      <% end %>
      <% if can_edit %>
        <details class="group relative">
          <summary class="inline-flex size-10 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-700 shadow-sm transition hover:bg-emerald-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 [&::-webkit-details-marker]:hidden" aria-label="<%= t('admin.supplier_dossier.more_actions') %>">
            <%= icon('ellipsis-horizontal', class: 'size-5') %>
          </summary>
          <div class="absolute right-0 z-20 mt-2 min-w-44 rounded-xl border border-slate-200 bg-white p-2 shadow-lg">
            <%= link_to edit_admin_supplier_path(supplier), data: { turbo_frame: '_top' }, class: 'flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-emerald-50 hover:text-emerald-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' do %>
              <%= icon('pencil', class: 'size-4 text-emerald-700') %>
              <%= t('admin.supplier_details.edit') %>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>
  </header>

  <div class="flex flex-col gap-4 lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:items-stretch lg:gap-5 xl:grid-cols-[16rem_minmax(0,1fr)]">
    <%= render 'dossier_sidebar', can_view_finances: can_view_finances, can_view_products: policy(supplier).view_products? %>
    <div class="flex min-w-0 w-full flex-1 flex-col gap-4" data-supplier-dossier-content aria-label="<%= t('admin.supplier_dossier.navigation.content') %>">
      <%= render 'dossier_overview', supplier: supplier, contacts: contacts, addresses: addresses, schedules: schedules, can_edit: can_edit, can_view_products: policy(supplier).view_products? %>
      <%= render 'dossier_general', supplier: supplier, can_edit: can_edit %>
      <%= render 'dossier_fiscal', supplier: supplier, fiscal_address: fiscal_address, can_edit: can_edit %>

    <section data-supplier-dossier-target="panel" data-section="commercial" class="w-full min-w-0 lg:flex-1 hidden space-y-5"><div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><div class="mb-5 flex items-center gap-3"><span class="rounded-xl bg-emerald-50 p-3 text-emerald-700"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-6" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v5c0 1.66 3.58 3 8 3s8-1.34 8-3V5M4 10v5c0 1.66 3.58 3 8 3s8-1.34 8-3v-5M4 15v4c0 1.66 3.58 3 8 3s8-1.34 8-3v-4"/></svg></span><div><h2 class="font-jakarta text-xl font-bold text-slate-900"><%= t('admin.supplier_dossier.commercial.summary') %></h2><p class="text-sm text-slate-500"><%= t('admin.supplier_dossier.commercial.description') %></p></div></div><dl class="grid gap-4 border-t border-slate-100 pt-5 sm:grid-cols-2 lg:grid-cols-5"><div><dt class="text-xs font-medium text-slate-500"><%= t('admin.supplier_dossier.fields.currency') %></dt><dd class="mt-1 font-bold text-slate-900"><%= supplier.currency&.code || '—' %></dd></div>
<div><dt class="text-xs font-medium text-slate-500"><%= t('admin.supplier_dossier.fields.credit_days') %></dt><dd class="mt-1 font-bold text-slate-900"><%= supplier.credit_days.present? ? supplier.credit_days : '—' %></dd></div>
<div><dt class="text-xs font-medium text-slate-500"><%= t('admin.supplier_dossier.fields.credit_limit') %></dt><dd class="mt-1 font-bold text-slate-900"><%= supplier.credit_limit.present? ? number_to_currency(supplier.credit_limit) : '—' %></dd></div>
<div><dt class="text-xs font-medium text-slate-500"><%= t('admin.supplier_dossier.fields.discount_percent') %></dt><dd class="mt-1 font-bold text-slate-900"><%= supplier.discount_percent.present? ? "#{supplier.discount_percent}%" : '—' %></dd></div>
<div><dt class="text-xs font-medium text-slate-500"><%= t('admin.supplier_dossier.fields.minimum_order_amount') %></dt><dd class="mt-1 font-bold text-slate-900"><%= supplier.minimum_order_amount.present? ? number_to_currency(supplier.minimum_order_amount) : '—' %></dd></div></dl></div><div class="grid gap-5 lg:grid-cols-2"><div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><div class="mb-4 flex items-center gap-3 border-b border-slate-100 pb-4"><span class="rounded-xl bg-emerald-50 p-3 text-emerald-700"><%= icon('credit-card', class: 'size-6') %></span><h3 class="font-jakarta text-lg font-bold text-slate-900"><%= t('admin.supplier_dossier.commercial.payment') %></h3></div><dl><div class="flex items-center justify-between gap-4 border-b border-slate-100 py-4 last:border-0"><dt class="text-sm text-slate-500"><%= t('admin.supplier_dossier.fields.currency') %></dt><dd class="text-right font-semibold text-slate-900"><%= supplier.currency&.code || '—' %></dd></div>
<div class="flex items-center justify-between gap-4 border-b border-slate-100 py-4 last:border-0"><dt class="text-sm text-slate-500"><%= t('admin.supplier_dossier.fields.credit_days') %></dt><dd class="text-right font-semibold text-slate-900"><%= supplier.credit_days.present? ? supplier.credit_days : '—' %></dd></div>
<div class="flex items-center justify-between gap-4 border-b border-slate-100 py-4 last:border-0"><dt class="text-sm text-slate-500"><%= t('admin.supplier_dossier.fields.credit_limit') %></dt><dd class="text-right font-semibold text-slate-900"><%= supplier.credit_limit.present? ? number_to_currency(supplier.credit_limit) : '—' %></dd></div></dl></div><div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><div class="mb-4 flex items-center gap-3 border-b border-slate-100 pb-4"><span class="rounded-xl bg-emerald-50 p-3 text-emerald-700"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-6" aria-hidden="true"><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/><path d="M19 5 5 19"/></svg></span><h3 class="font-jakarta text-lg font-bold text-slate-900"><%= t('admin.supplier_dossier.commercial.purchase') %></h3></div><dl><div class="flex items-center justify-between gap-4 border-b border-slate-100 py-4 last:border-0"><dt class="text-sm text-slate-500"><%= t('admin.supplier_dossier.fields.discount_percent') %></dt><dd class="text-right font-semibold text-slate-900"><%= supplier.discount_percent.present? ? "#{supplier.discount_percent}%" : '—' %></dd></div>
<div class="flex items-center justify-between gap-4 border-b border-slate-100 py-4 last:border-0"><dt class="text-sm text-slate-500"><%= t('admin.supplier_dossier.fields.minimum_order_amount') %></dt><dd class="text-right font-semibold text-slate-900"><%= supplier.minimum_order_amount.present? ? number_to_currency(supplier.minimum_order_amount) : '—' %></dd></div></dl></div></div></section>

    <section data-supplier-dossier-target="panel" data-section="contacts" class="w-full min-w-0 lg:flex-1 hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
      <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
        <div>
          <div class="flex items-center gap-3">
            <h2 class="font-jakarta text-xl font-bold text-slate-900"><%= t('admin.supplier_details.contacts') %></h2>
            <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600"><%= contacts.size %></span>
          </div>
          <p class="mt-1 text-sm text-slate-500"><%= t('admin.supplier_details.contacts_description') %></p>
        </div>
      </div>

      <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
        <%= form_with url: admin_supplier_contacts_path(supplier), method: :get, data: { action: 'submit->supplier-dossier#filterContacts' }, class: 'flex w-full max-w-md items-center gap-2' do |form| %>
          <%= form.search_field :q, data: { supplier_dossier_target: 'contactSearch', action: 'input->supplier-dossier#filterContacts search->supplier-dossier#filterContacts' }, placeholder: t('admin.supplier_details.search_contacts'), aria: { label: t('admin.supplier_details.search_contacts') }, class: 'min-w-0 flex-1 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 focus:border-emerald-500 focus:ring-emerald-500' %>
        <% end %>
        <%= link_to admin_supplier_contacts_path(supplier), class: 'inline-flex min-h-10 items-center gap-2 rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-50' do %>
          <%= icon('users', class: 'size-4') %>
          <%= t('admin.supplier_details.manage_contacts') %>
        <% end %>
      </div>

      <div class="overflow-hidden rounded-xl border border-slate-200">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[850px] text-left text-sm">
            <thead class="bg-slate-50 text-xs font-semibold text-slate-600">
              <tr>
                <th scope="col" class="px-4 py-3"><%= t('admin.supplier_details.contact_fields.name') %></th>
                <th scope="col" class="px-4 py-3"><%= t('admin.supplier_details.contact_fields.position') %></th>
                <th scope="col" class="px-4 py-3"><%= t('admin.supplier_details.contact_fields.phone') %></th>
                <th scope="col" class="px-4 py-3"><%= t('admin.supplier_details.contact_fields.email') %></th>
                <th scope="col" class="px-4 py-3"><%= t('admin.supplier_details.contact_fields.primary') %></th>
                <th scope="col" class="px-4 py-3"><%= t('admin.supplier_details.contact_fields.active') %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 bg-white">
              <% contacts.each do |contact| %>
                <tr data-supplier-dossier-target="contactRow" data-search-text="<%= [contact.name, contact.position, contact.email, contact.phone, contact.mobile_phone].compact.join(' ') %>" class="transition hover:bg-slate-50/80">
                  <td class="px-4 py-4">
                    <div class="flex items-center gap-3">
                      <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-xs font-bold text-emerald-700"><%= contact.name.to_s.split.first(2).map { |part| part.first.upcase }.join %></span>
                      <span class="font-semibold text-slate-900"><%= contact.name %></span>
                    </div>
                  </td>
                  <td class="px-4 py-4 text-slate-600"><%= contact.position.presence || '—' %></td>
                  <td class="whitespace-nowrap px-4 py-4 text-slate-600"><%= contact.phone.presence || contact.mobile_phone.presence || '—' %></td>
                  <td class="px-4 py-4">
                    <% if contact.email.present? %>
                      <%= mail_to contact.email, contact.email, class: 'break-all text-emerald-700 hover:underline' %>
                    <% else %>
                      <span class="text-slate-400">—</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-4">
                    <% if contact.primary? %>
                      <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700"><%= icon('star', class: 'size-3.5') %><%= t('admin.supplier_details.primary') %></span>
                    <% else %>
                      <span class="text-slate-400">—</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-4">
                    <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold <%= contact.active? ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-600' %>">
                      <span class="size-1.5 rounded-full <%= contact.active? ? 'bg-emerald-500' : 'bg-slate-400' %>"></span>
                      <%= t("admin.supplier_details.contact_statuses.#{contact.active? ? 'active' : 'inactive'}") %>
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div data-supplier-dossier-target="contactEmpty" class="<%= 'hidden' if contacts.any? %> border-t border-slate-100 px-6 py-10 text-center text-sm text-slate-500"><%= t('admin.supplier_details.no_contacts') %></div>
        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 bg-slate-50/50 px-4 py-3">
          <p class="text-xs text-slate-500"><span data-supplier-dossier-target="contactCount"><%= contacts.size %></span> <%= t('admin.supplier_details.contacts') %></p>
        </div>
      </div>
    </section>

    <section data-supplier-dossier-target="panel" data-section="addresses" class="w-full min-w-0 lg:flex-1 hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
      <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
        <div>
          <div class="flex items-center gap-3">
            <h2 class="font-jakarta text-xl font-bold text-slate-900"><%= t('admin.supplier_details.addresses') %></h2>
            <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600"><%= addresses.size %></span>
          </div>
          <p class="mt-1 text-sm text-slate-500"><%= t('admin.supplier_details.addresses_description') %></p>
        </div>
      </div>
      <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
        <input type="search" data-supplier-dossier-target="addressSearch" data-action="input->supplier-dossier#filterAddresses search->supplier-dossier#filterAddresses" placeholder="<%= t('admin.supplier_details.search_addresses') %>" aria-label="<%= t('admin.supplier_details.search_addresses') %>" class="min-h-10 w-full max-w-md rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 focus:border-emerald-500 focus:ring-emerald-500">
        <%= link_to admin_supplier_addresses_path(supplier), class: 'inline-flex min-h-10 items-center gap-2 rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-50' do %>
          <%= icon('map-pin', class: 'size-4') %>
          <%= t('admin.supplier_details.manage_addresses') %>
        <% end %>
      </div>
      <div class="overflow-hidden rounded-xl border border-slate-200">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[950px] text-left text-sm">
            <thead class="bg-slate-50 text-xs font-semibold text-slate-600">
              <tr>
                <% %w[type address city state postal_code country primary].each do |field| %>
                  <th scope="col" class="px-4 py-3"><%= t("admin.supplier_details.address_columns.#{field}") %></th>
                <% end %>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 bg-white">
              <% addresses.each do |address| %>
                <tr data-supplier-dossier-target="addressRow" data-search-text="<%= [t("admin.supplier_details.address_purposes.#{address.purpose}"), address.full_address].compact.join(' ') %>" class="transition hover:bg-slate-50/80">
                  <td class="px-4 py-4"><span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700"><%= t("admin.supplier_details.address_purposes.#{address.purpose}") %></span></td>
                  <td class="px-4 py-4 font-medium text-slate-800"><%= [address.street, address.exterior_number, address.interior_number].compact_blank.join(' ') %><span class="block text-xs font-normal text-slate-500"><%= address.neighborhood.presence || '—' %></span></td>
                  <td class="px-4 py-4 text-slate-600"><%= address.city.presence || '—' %></td>
                  <td class="px-4 py-4 text-slate-600"><%= address.state.presence || '—' %></td>
                  <td class="px-4 py-4 text-slate-600"><%= address.postal_code.presence || '—' %></td>
                  <td class="px-4 py-4 text-slate-600"><%= address.country&.name || '—' %></td>
                  <td class="px-4 py-4">
                    <% if address.primary? %>
                      <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700"><%= icon('star', class: 'size-3.5') %><%= t('admin.supplier_details.primary') %></span>
                    <% else %>
                      <span class="text-slate-400">—</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div data-supplier-dossier-target="addressEmpty" class="<%= 'hidden' if addresses.any? %> border-t border-slate-100 px-6 py-10 text-center text-sm text-slate-500"><%= t('admin.supplier_details.no_addresses') %></div>
        <div class="border-t border-slate-100 bg-slate-50/50 px-4 py-3 text-xs text-slate-500">
          <span data-supplier-dossier-target="addressCount"><%= addresses.size %></span> <%= t('admin.supplier_details.addresses') %>
        </div>
      </div>
    </section>

    <section data-supplier-dossier-target="panel" data-section="schedules" class="w-full min-w-0 lg:flex-1 hidden rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-5">
        <div>
          <h2 class="font-jakarta text-xl font-bold text-slate-900"><%= t('admin.supplier_dossier.schedules') %></h2>
          <p class="mt-1 text-sm text-slate-500"><%= schedules.size %> · <%= t('admin.supplier_dossier.schedules') %></p>
        </div>
        <% if can_edit %>
          <%= link_to t('admin.supplier_details.add'), new_admin_supplier_schedule_path(supplier), class: 'inline-flex min-h-10 items-center rounded-xl bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700' %>
        <% end %>
      </div>
      <% if schedules.any? %>
        <% schedules.group_by(&:branch).sort_by { |branch, _| branch.name }.each do |branch, entries| %>
          <div class="mt-5">
            <h3 class="mb-3 font-semibold text-slate-900"><%= branch.name %></h3>
            <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
              <% entries.each do |schedule| %>
                <div class="rounded-xl border border-emerald-100 bg-emerald-50/40 p-4">
                  <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700"><%= t("admin.supplier_dossier.kinds.#{schedule.kind}") %></p>
                  <p class="mt-2 font-semibold text-slate-900"><%= t('date.day_names')[schedule.weekday] %></p>
                  <p class="mt-1 text-sm text-slate-600"><%= schedule.starts_at.strftime('%H:%M') %><% if schedule.ends_at.present? %>–<%= schedule.ends_at.strftime('%H:%M') %><% end %></p>
                  <% if schedule.notes.present? %><p class="mt-2 text-sm text-slate-600"><%= schedule.notes %></p><% end %>
                  <% if can_edit %><%= link_to t('admin.supplier_details.edit'), edit_admin_supplier_schedule_path(supplier, schedule), class: 'mt-3 inline-block text-sm font-semibold text-emerald-700 hover:underline' %><% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="py-8 text-center text-sm text-slate-500">—</p>
      <% end %>
      <%= link_to t('admin.supplier_dossier.schedules'), admin_supplier_schedules_path(supplier), class: 'mt-5 inline-block text-sm font-semibold text-emerald-700 hover:underline' %>
    </section>

    <section data-supplier-dossier-target="panel" data-section="products" class="w-full min-w-0 lg:flex-1 hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="font-jakarta text-lg font-bold text-slate-900"><%= t('admin.procurement.title') %></h2>
      <p class="mt-2 text-sm text-slate-500"><%= t('admin.procurement.description') %></p>
      <% if policy(supplier).view_products? %>
        <%= link_to t('admin.procurement.title'), admin_supplier_supplier_products_path(supplier),
                    class: 'mt-5 inline-flex rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white' %>
      <% end %>
    </section>

<% if can_view_finances %>
      <section data-supplier-dossier-target="panel" data-section="finances" class="w-full min-w-0 lg:flex-1 hidden space-y-5">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
            <div><h2 class="font-jakarta text-xl font-bold text-slate-900"><%= t('admin.accounts_payable.title') %></h2>
              <p class="mt-1 text-sm text-slate-500"><%= supplier.name %></p></div>
            <%= link_to t('admin.accounts_payable.payables'), admin_account_payables_path, class: 'text-sm font-semibold text-emerald-700 hover:underline' %>
          </div>
          <% open_payables = supplier.account_payables.includes(supplier_invoice: :currency).order(due_on: :asc).reject(&:settled?).first(10) %>
          <% open_payables.each do |payable| %>
            <div class="flex flex-wrap justify-between gap-3 border-t border-slate-100 py-3 text-sm">
              <%= link_to payable.supplier_invoice.folio.presence || "##{payable.supplier_invoice_id}", admin_account_payable_path(payable), class: 'font-semibold text-emerald-700' %>
              <span><%= number_to_currency(payable.balance, unit: '') %> <%= payable.supplier_invoice.currency.code %> · <%= l(payable.due_on) %></span>
            </div>
          <% end %>
          <% if open_payables.empty? %><p class="text-sm text-slate-500"><%= t('admin.accounts_payable.empty') %></p><% end %>
        </div>
        <% if current_user.admin? || current_user.permission?('accounts_payable.banks.view') %>
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="mb-3 text-lg font-bold"><%= t('admin.accounts_payable.bank_accounts') %></h3>
            <% supplier.supplier_bank_accounts.active.limit(3).each do |account| %>
              <p class="py-2 text-sm text-slate-600"><%= account.sat_bank&.name || account.bank_name %> · <%= account.masked_number %></p>
            <% end %>
            <%= link_to t('admin.accounts_payable.manage_banks'), admin_supplier_bank_accounts_path(supplier), class: 'mt-3 inline-block text-sm font-semibold text-emerald-700 hover:underline' %>
          </div>
        <% end %>
      </section>
    <% end %>

    <section data-supplier-dossier-target="panel" data-section="documents" class="w-full min-w-0 lg:flex-1 hidden rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
      <h2 class="mb-4 text-lg font-bold"><%= t('admin.supplier_dossier.documents') %></h2>
      <% supplier.documents.each do |document| %>
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 py-3">
          <%= link_to document.filename.to_s, admin_supplier_document_download_path(supplier, document_id: document.id), class: 'break-all text-sm font-semibold text-emerald-700' %>
          <% if policy(supplier).manage_documents? %><%= button_to t('admin.supplier_details.delete'), admin_supplier_document_path(supplier, document_id: document.id), method: :delete, form: { data: { turbo_confirm: t('admin.supplier_details.confirm') } }, class: 'text-sm font-semibold text-rose-600' %><% end %>
        </div>
      <% end %>
      <% if supplier.documents.empty? %><p class="text-sm text-slate-500">—</p><% end %>
      <div class="mt-5"><h3 class="text-sm font-semibold text-slate-700"><%= t('admin.supplier_dossier.tags') %></h3><p class="mt-2 text-sm text-slate-600"><%= supplier.tags.join(', ').presence || '—' %></p></div>
    </section>
    </div>
  </div>
</div>
