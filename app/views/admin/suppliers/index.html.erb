<%= turbo_stream_from "suppliers_catalog_#{current_organization.id}" %>

<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="font-jakarta text-2xl font-bold text-slate-900"><%= t('admin.suppliers.index.title') %></h1>
    <p class="mt-1 text-sm text-slate-500"><%= t('admin.suppliers.index.subtitle') %></p>
  </div>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
    <% if policy(Supplier.new).new? %>
      <%= link_to new_admin_supplier_path,
                  data: { tooltip: t('admin.suppliers.index.new') },
                  class: 'inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700' do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        <%= t('admin.suppliers.index.new') %>
      <% end %>
    <% end %>


  </div>
</div>

<div class="mb-5 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
  <div class="flex min-w-0 items-center gap-4 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-600"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-7" aria-hidden="true"><path d="M3 7h11v10H3zM14 10h4l3 4v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/><path d="M5 7V4h8v3"/></svg></span>
    <div class="min-w-0"><p class="text-sm text-slate-500"><%= t('admin.suppliers.index.metrics.total') %></p><p class="mt-1 text-2xl font-bold text-slate-900"><%= @supplier_stats.fetch(:total) %></p></div>
  </div>
  <div class="flex min-w-0 items-center gap-4 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-600"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-7" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg></span>
    <div class="min-w-0"><p class="text-sm text-slate-500"><%= t('admin.suppliers.index.metrics.active') %></p><p class="mt-1 text-2xl font-bold text-slate-900"><%= @supplier_stats.fetch(:active) %></p></div>
  </div>
  <div class="flex min-w-0 items-center gap-4 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-rose-50 text-rose-700"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-7" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M10 8v8M14 8v8"/></svg></span>
    <div class="min-w-0"><p class="text-sm text-slate-500"><%= t('admin.suppliers.index.metrics.inactive') %></p><p class="mt-1 text-2xl font-bold text-slate-900"><%= @supplier_stats.fetch(:inactive) %></p></div>
  </div>
  <div class="flex min-w-0 items-center gap-4 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-cyan-50 text-teal-600"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-7" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h4"/></svg></span>
    <div class="min-w-0"><p class="text-sm text-slate-500"><%= t('admin.suppliers.index.metrics.credit') %></p><p class="mt-1 text-2xl font-bold text-slate-900"><%= @supplier_stats.fetch(:credit) %></p></div>
  </div>
</div>

<%= form_with url: admin_suppliers_path, method: :get, data: { turbo_frame: '_top' }, class: 'mb-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm' do %>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 class="flex items-center gap-2 text-sm font-bold text-emerald-700"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true"><path d="M4 7h9M17 7h3M4 17h3M11 17h9"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="17" r="2"/></svg><%= t('admin.suppliers.index.advanced.title') %></h2>
    <div class="flex flex-wrap gap-2">
      <%= link_to t('admin.suppliers.index.advanced.clear'), admin_suppliers_path, class: 'rounded-lg px-3 py-2 text-sm font-medium text-emerald-700 hover:bg-emerald-50' %>
      <%= button_tag t('admin.suppliers.index.filters.apply'), type: 'submit', class: 'rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700' %>
    </div>
  </div>
  <div class="mt-4"><%= text_field_tag :search, params[:search], placeholder: t('admin.suppliers.index.search_placeholder'), class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500 focus:ring-emerald-500' %></div>
  <details class="mt-4" <%= 'open' if params.to_unsafe_h.keys.intersect?(%w[classification person_type currency credit sat_fiscal_regime_id responsible_user_id credit_days_min credit_days_max credit_limit_min credit_limit_max created_at_from created_at_to updated_at_from updated_at_to]) %>>
    <summary class="cursor-pointer text-sm font-semibold text-emerald-700"><%= t('admin.suppliers.index.advanced.expand') %></summary>
    <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
<div><label for="supplier_status" class="mb-1 block text-xs font-semibold text-slate-600"><%= t('admin.suppliers.index.advanced.status') %></label><%= render 'filter_dropdown', name: :status, options: ['all','active','inactive'].map { |value| [t("admin.suppliers.index.advanced.options.#{value}"), value] }, selected: params[:status] || 'all' %></div>
<div><label for="supplier_classification" class="mb-1 block text-xs font-semibold text-slate-600"><%= t('admin.suppliers.index.advanced.classification') %></label><%= render 'filter_dropdown', name: :classification, options: ['all','manufacturer','distributor','wholesaler','service','other'].map { |value| [t("admin.suppliers.index.advanced.options.#{value}"), value] }, selected: params[:classification] || 'all' %></div>
<div><label for="supplier_person_type" class="mb-1 block text-xs font-semibold text-slate-600"><%= t('admin.suppliers.index.advanced.person_type') %></label><%= render 'filter_dropdown', name: :person_type, options: ['all','individual','company'].map { |value| [t("admin.suppliers.index.advanced.options.#{value}"), value] }, selected: params[:person_type] || 'all' %></div>
<div><label for="supplier_currency" class="mb-1 block text-xs font-semibold text-slate-600"><%= t('admin.suppliers.index.advanced.currency') %></label><%= render 'filter_dropdown', name: :currency, options: ['all','MXN','USD','EUR'].map { |value| [t("admin.suppliers.index.advanced.options.#{value}"), value] }, selected: params[:currency] || 'all' %></div>
<div><label for="supplier_credit" class="mb-1 block text-xs font-semibold text-slate-600"><%= t('admin.suppliers.index.advanced.credit') %></label><%= render 'filter_dropdown', name: :credit, options: ['all','yes','no'].map { |value| [t("admin.suppliers.index.advanced.options.#{value}"), value] }, selected: params[:credit] || 'all' %></div>
<div><label for="supplier_sat_fiscal_regime_id" class="mb-1 block text-xs font-semibold text-slate-600"><%= t('admin.suppliers.index.advanced.fiscal_regime') %></label><%= render 'filter_dropdown', name: :sat_fiscal_regime_id, options: [[t('admin.suppliers.index.advanced.options.all'), '']] + @supplier_regimes.map { |regime| ["#{regime.code}", regime.id] }, selected: params[:sat_fiscal_regime_id] || 'all' %></div>
<div><label for="supplier_responsible_user_id" class="mb-1 block text-xs font-semibold text-slate-600"><%= t('admin.suppliers.index.advanced.responsible') %></label><%= render 'filter_dropdown', name: :responsible_user_id, options: [[t('admin.suppliers.index.advanced.options.all'), '']] + current_organization.users.order(:id).map { |user| [user.email, user.id] }, selected: params[:responsible_user_id] || 'all' %></div>
<div><label for="supplier_credit_days_min" class="mb-1 block text-xs font-semibold text-slate-600"><%= t('admin.suppliers.index.advanced.credit_days_min') %></label><%= number_field_tag :credit_days_min, params[:credit_days_min], id: 'supplier_credit_days_min', min: 0, step: 0.01, class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500' %></div>
<div><label for="supplier_credit_days_max" class="mb-1 block text-xs font-semibold text-slate-600"><%= t('admin.suppliers.index.advanced.credit_days_max') %></label><%= number_field_tag :credit_days_max, params[:credit_days_max], id: 'supplier_credit_days_max', min: 0, step: 0.01, class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500' %></div>
<div><label for="supplier_credit_limit_min" class="mb-1 block text-xs font-semibold text-slate-600"><%= t('admin.suppliers.index.advanced.credit_limit_min') %></label><%= number_field_tag :credit_limit_min, params[:credit_limit_min], id: 'supplier_credit_limit_min', min: 0, step: 0.01, class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500' %></div>
<div><label for="supplier_credit_limit_max" class="mb-1 block text-xs font-semibold text-slate-600"><%= t('admin.suppliers.index.advanced.credit_limit_max') %></label><%= number_field_tag :credit_limit_max, params[:credit_limit_max], id: 'supplier_credit_limit_max', min: 0, step: 0.01, class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500' %></div>
<div><label for="supplier_minimum_order_amount_min" class="mb-1 block text-xs font-semibold text-slate-600"><%= t('admin.suppliers.index.advanced.minimum_order_amount_min') %></label><%= number_field_tag :minimum_order_amount_min, params[:minimum_order_amount_min], id: 'supplier_minimum_order_amount_min', min: 0, step: 0.01, class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500' %></div>
<div><label for="supplier_minimum_order_amount_max" class="mb-1 block text-xs font-semibold text-slate-600"><%= t('admin.suppliers.index.advanced.minimum_order_amount_max') %></label><%= number_field_tag :minimum_order_amount_max, params[:minimum_order_amount_max], id: 'supplier_minimum_order_amount_max', min: 0, step: 0.01, class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500' %></div>
<div><label for="supplier_discount_percent_min" class="mb-1 block text-xs font-semibold text-slate-600"><%= t('admin.suppliers.index.advanced.discount_percent_min') %></label><%= number_field_tag :discount_percent_min, params[:discount_percent_min], id: 'supplier_discount_percent_min', min: 0, step: 0.01, class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500' %></div>
<div><label for="supplier_discount_percent_max" class="mb-1 block text-xs font-semibold text-slate-600"><%= t('admin.suppliers.index.advanced.discount_percent_max') %></label><%= number_field_tag :discount_percent_max, params[:discount_percent_max], id: 'supplier_discount_percent_max', min: 0, step: 0.01, class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500' %></div>
<div><label for="supplier_created_at_from" class="mb-1 block text-xs font-semibold text-slate-600"><%= t('admin.suppliers.index.advanced.created_at_from') %></label><%= date_field_tag :created_at_from, params[:created_at_from], id: 'supplier_created_at_from', class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500' %></div>
<div><label for="supplier_created_at_to" class="mb-1 block text-xs font-semibold text-slate-600"><%= t('admin.suppliers.index.advanced.created_at_to') %></label><%= date_field_tag :created_at_to, params[:created_at_to], id: 'supplier_created_at_to', class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500' %></div>
<div><label for="supplier_updated_at_from" class="mb-1 block text-xs font-semibold text-slate-600"><%= t('admin.suppliers.index.advanced.updated_at_from') %></label><%= date_field_tag :updated_at_from, params[:updated_at_from], id: 'supplier_updated_at_from', class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500' %></div>
<div><label for="supplier_updated_at_to" class="mb-1 block text-xs font-semibold text-slate-600"><%= t('admin.suppliers.index.advanced.updated_at_to') %></label><%= date_field_tag :updated_at_to, params[:updated_at_to], id: 'supplier_updated_at_to', class: 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500' %></div>
    </div>
  </details>
  <%= hidden_field_tag :per_page, params[:per_page] if params[:per_page].present? %>
  <%= hidden_field_tag :sort, params[:sort] if params[:sort].present? %>
  <%= hidden_field_tag :direction, params[:direction] if params[:direction].present? %>
<% end %>

<%= turbo_frame_tag "suppliers_list", data: { turbo_action: "advance" } do %>
  <%= render "list", suppliers: @suppliers %>
<% end %>
