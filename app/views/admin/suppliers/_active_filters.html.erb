<% filter_keys = %w[status classification person_type currency credit sat_fiscal_regime_id responsible_user_id credit_days_min credit_days_max credit_limit_min credit_limit_max minimum_order_amount_min minimum_order_amount_max discount_percent_min discount_percent_max created_at_from created_at_to updated_at_from updated_at_to] %>
<% can_view_fiscal_filters = current_user.admin? || current_user.permission?('suppliers.fiscal.view') ||
                             current_user.permission?('suppliers.fiscal.manage') %>
<% can_view_commercial_filters = current_user.admin? || current_user.permission?('suppliers.commercial.view') ||
                                 current_user.permission?('suppliers.commercial.manage') %>
<% filter_keys -= %w[sat_fiscal_regime_id] unless can_view_fiscal_filters %>
<% filter_keys -= %w[currency credit credit_days_min credit_days_max credit_limit_min credit_limit_max
                    minimum_order_amount_min minimum_order_amount_max discount_percent_min discount_percent_max] unless can_view_commercial_filters %>
<% active_filters = filter_keys.filter_map do |key|
     value = params[key].to_s
     next if value.blank? || value == 'all'
     allowed = { 'status' => %w[active inactive], 'classification' => %w[manufacturer distributor wholesaler service other], 'person_type' => %w[individual company], 'currency' => Array(@supplier_currencies).map(&:code), 'credit' => %w[yes no] }
     next if allowed.key?(key) && !allowed.fetch(key).include?(value)
     next if key == 'sat_fiscal_regime_id' && @supplier_regimes.none? { |regime| regime.id.to_s == value }
     next if key == 'responsible_user_id' && !current_organization.users.exists?(id: value)
     next if key.match?(/_(min|max)\z/) && !value.match?(/\A\d{1,12}(?:\.\d{1,2})?\z/)
     next if key.match?(/_at_(from|to)\z/) && !value.match?(/\A\d{4}-\d{2}-\d{2}\z/)

     name_key = { 'sat_fiscal_regime_id' => 'fiscal_regime', 'responsible_user_id' => 'responsible' }.fetch(key, key)
     label = t("admin.suppliers.index.advanced.#{name_key}", default: key.humanize)
     display = case key
               when 'status', 'classification', 'person_type', 'credit'
                 t("admin.suppliers.index.advanced.options.#{value}", default: value)
               when 'sat_fiscal_regime_id'
                 @supplier_regimes.find { |regime| regime.id.to_s == value }&.code || value
               when 'responsible_user_id'
                 current_organization.users.find_by(id: value)&.email || value
               else
                 value
               end
     [key, "#{label}: #{display}"]
   end %>
<% if active_filters.any? %>
  <div class="mt-4 flex flex-wrap items-center gap-2" aria-label="<%= t('admin.suppliers.index.advanced.title') %>">
    <span class="mr-1 text-xs font-semibold text-slate-600"><%= t('admin.suppliers.index.advanced.title') %> (<%= active_filters.size %>)</span>
    <% active_filters.each do |key, label| %>
      <% remaining = params.permit(:search, :status, :classification, :person_type, :currency, :credit, :sat_fiscal_regime_id, :responsible_user_id, :credit_days_min, :credit_days_max, :credit_limit_min, :credit_limit_max, :minimum_order_amount_min, :minimum_order_amount_max, :discount_percent_min, :discount_percent_max, :created_at_from, :created_at_to, :updated_at_from, :updated_at_to, :per_page, :sort, :direction, :archived).to_h.except(key, 'page') %>
      <% tone = if key == 'status'
                  params[key] == 'active' ? :active : :inactive
                elsif key == 'credit' && params[key] == 'yes'
                  :credit
                else
                  :neutral
                end %>
      <%= render 'shared/filter_badge', url: admin_suppliers_path(remaining), filter_key: key, label: label, tone: tone, aria_label: "#{t('admin.suppliers.index.advanced.clear')}: #{label}" %>
    <% end %>
    <%= link_to t('admin.suppliers.index.advanced.clear'), admin_suppliers_path, data: { action: 'click->supplier-search#clearFilters' }, class: 'ml-1 text-xs font-semibold text-emerald-700 hover:underline' %>
  </div>
<% end %>
