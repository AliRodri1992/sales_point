<% addresses.each do |address| %>
  <% archived = address.deleted_at.present? %>
  <% icon_name = { 'fiscal' => 'building-library', 'commercial' => 'building-office-2',
                   'delivery' => 'truck', 'general' => 'map-pin' }.fetch(address.purpose, 'map-pin') %>
  <article data-supplier-address-id="<%= address.id %>"
           class="flex h-full min-w-0 flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:border-emerald-200 hover:shadow-md">
    <div class="flex-1 p-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="flex min-w-0 items-center gap-3">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-xl <%= archived ? 'bg-slate-100 text-slate-500' : 'bg-emerald-50 text-emerald-700' %>">
            <%= icon(icon_name, class: 'size-5') %>
          </span>
          <h2 class="font-jakarta font-bold text-slate-900"><%= t("admin.supplier_details.address_purposes.#{address.purpose}") %></h2>
        </div>
        <% if archived %>
          <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600"><%= t('admin.supplier_details.deleted_records') %></span>
        <% elsif address.primary? %>
          <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
            <%= icon('check-circle', class: 'size-3.5') %><%= t('admin.supplier_details.primary') %>
          </span>
        <% end %>
      </div>
      <div class="mt-4 space-y-1 text-sm leading-6 text-slate-600">
        <p class="break-words font-medium text-slate-800"><%= [address.street, address.exterior_number, address.interior_number.presence].compact.join(' ') %></p>
        <p class="break-words"><%= address.neighborhood %></p>
        <p class="break-words">
          <%= [address.city, address.state].reject(&:blank?).join(', ') %>
          <% if address.postal_code.present? %>
            · <%= t('admin.supplier_details.address_fields.postal_code') %> <%= address.postal_code %>
          <% end %>
        </p>
        <p class="break-words text-slate-500"><%= address.country.localized_name %></p>
        <% if address.reference_notes.present? %>
          <p class="mt-2 break-words text-xs text-slate-500">
            <%= t('admin.supplier_details.address_form.references') %>: <%= address.reference_notes %>
          </p>
        <% end %>
      </div>
      <% if archived %>
        <p class="mt-3 flex items-center gap-2 text-xs text-slate-500">
          <%= icon('clock', class: 'size-4') %>
          <%= t('admin.supplier_details.deleted_on', date: l(address.deleted_at.to_date, format: :long)) %>
        </p>
      <% end %>
    </div>
    <% if can_manage_addresses %>
      <div class="flex min-h-14 flex-wrap items-center justify-end gap-2 border-t border-slate-100 bg-slate-50/60 px-5 py-3">
        <% if archived %>
          <%= button_to restore_admin_supplier_address_path(@supplier, address), method: :patch,
                        class: 'inline-flex min-h-10 items-center gap-2 rounded-xl border border-emerald-200 bg-white px-4 py-2 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-50' do %>
            <%= icon('arrow-path', class: 'size-4') %><%= t('admin.supplier_details.restore_address') %>
          <% end %>
        <% else %>
          <%= link_to edit_admin_supplier_address_path(@supplier, address),
                      class: 'inline-flex min-h-10 items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100' do %>
            <%= icon('pencil-square', class: 'size-4') %><%= t('admin.supplier_details.edit') %>
          <% end %>
          <%= button_to admin_supplier_address_path(@supplier, address), method: :delete,
                        form: { data: { turbo_confirm: t('admin.supplier_details.confirm') } },
                        class: 'inline-flex min-h-10 items-center gap-2 rounded-xl border border-rose-200 bg-white px-4 py-2 text-sm font-semibold text-rose-700 transition hover:bg-rose-50' do %>
            <%= icon('trash', class: 'size-4') %><%= t('admin.supplier_details.delete') %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </article>
<% end %>
