<% content_for :title, t('admin.supplier_details.add_address') %>
<div class="mx-auto max-w-5xl space-y-6">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-emerald-700"><%= @supplier.code %> · <%= @supplier.name %></p>
      <h1 class="font-jakarta text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl"><%= t('admin.supplier_details.add_address') %></h1>
      <p class="mt-2 text-sm text-slate-500"><%= t('admin.supplier_details.addresses') %> · <%= @supplier.name %></p>
    </div>
    <%= link_to admin_supplier_addresses_path(@supplier), class: 'inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50' do %>
      <%= icon('arrow-left', class: 'size-4') %>
      <%= t('admin.supplier_details.back') %>
    <% end %>
  </div>
  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 bg-gradient-to-r from-emerald-50 via-white to-white px-6 py-5 lg:px-8">
      <div class="flex items-center gap-3">
        <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-600 text-white shadow-sm"><%= icon('map-pin', class: 'size-5') %></div>
        <div>
          <h2 class="font-jakarta text-lg font-bold text-slate-900"><%= t('admin.supplier_details.add_address') %></h2>
          <p class="mt-1 text-sm text-slate-500"><%= @supplier.name %></p>
        </div>
      </div>
    </div>
    <%= render 'form' %>
  </div>
</div>
