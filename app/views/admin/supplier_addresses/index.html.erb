<div class="space-y-6" data-controller="swal-confirm">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700"><%= @supplier.code %> · <%= @supplier.name %></p>
      <h1 class="mt-1 font-jakarta text-2xl font-bold text-slate-900"><%= t('admin.supplier_details.addresses') %></h1>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to t('admin.supplier_details.back'), admin_supplier_path(@supplier), class: 'rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50' %>
      <% if policy(@supplier).update? %>
        <%= link_to new_admin_supplier_address_path(@supplier), class: 'inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-700' do %><%= icon('plus', class: 'size-4') %><%= t('admin.supplier_details.add_address') %><% end %>
      <% end %>
    </div>
  </div>
  </div>
  <% deleted_addresses = @supplier.addresses.with_deleted.where.not(deleted_at: nil).order(deleted_at: :desc) %>
  <% showing_deleted = params[:status] == 'deleted' %>
  <div class="grid gap-3 sm:grid-cols-2">
    <div class="rounded-xl border border-emerald-100 bg-emerald-50/60 p-4"><p class="text-xs font-semibold text-emerald-800"><%= t('admin.supplier_details.active_addresses') %></p><div class="mt-2 flex items-center gap-2"><%= icon('map-pin', class: 'size-5 text-emerald-700') %><p class="font-jakarta text-2xl font-bold text-slate-900"><%= @addresses.size %></p></div></div>
    <div class="rounded-xl border border-slate-200 bg-slate-50 p-4"><p class="text-xs font-semibold text-slate-600"><%= t('admin.supplier_details.deleted_addresses') %></p><div class="mt-2 flex items-center gap-2"><%= icon('archive-box', class: 'size-5 text-slate-500') %><p class="font-jakarta text-2xl font-bold text-slate-900"><%= deleted_addresses.size %></p></div></div>
  </div>
  <nav class="flex gap-5 border-b border-slate-200" aria-label="<%= t('admin.supplier_details.addresses') %>">
    <%= link_to t('admin.supplier_details.active_addresses'), admin_supplier_addresses_path(@supplier), class: "border-b-2 px-2 py-3 text-sm font-semibold #{showing_deleted ? 'border-transparent text-slate-500' : 'border-emerald-600 text-emerald-700'}" %>
    <%= link_to "#{t('admin.supplier_details.deleted_addresses')} (#{deleted_addresses.size})", admin_supplier_addresses_path(@supplier, status: 'deleted'), class: "border-b-2 px-2 py-3 text-sm font-semibold #{showing_deleted ? 'border-emerald-600 text-emerald-700' : 'border-transparent text-slate-500'}" %>
  </nav>
  <% unless showing_deleted %>
  <div class="grid items-stretch gap-4 md:grid-cols-2">
    <% @addresses.each do |address| %>
      <article class="flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:border-emerald-200 hover:shadow-md"><div class="flex-1 p-5">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-3"><span class="flex size-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><%= icon('map-pin', class: 'size-5') %></span><div><h2 class="font-jakarta font-bold text-slate-900"><%= t("admin.supplier_details.address_purposes.#{address.purpose}") %></h2><p class="text-xs text-slate-400">#<%= address.id %></p></div></div>
          <% if address.primary? %><span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700"><%= icon('check-circle', class: 'size-3.5') %><%= t('admin.supplier_details.primary') %></span><% end %>
        </div>
        <p class="mt-4 text-sm leading-6 text-slate-600"><%= address.full_address %></p></div>
        <% if policy(@supplier).update? %>
          <div class="flex min-h-16 items-center justify-end gap-2 border-t border-slate-100 bg-slate-50/60 px-5 py-3">
            <%= link_to edit_admin_supplier_address_path(@supplier, address), class: 'inline-flex min-h-10 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100' do %><%= icon('pencil-square', class: 'size-4') %><%= t('admin.supplier_details.edit') %><% end %>
            <%= button_to admin_supplier_address_path(@supplier, address), method: :delete, form: { data: { turbo_confirm: t('admin.supplier_details.confirm') } }, class: 'inline-flex min-h-10 items-center justify-center gap-2 rounded-xl border border-rose-200 bg-white px-4 py-2 text-sm font-semibold text-rose-700 transition hover:bg-rose-50' do %><%= icon('trash', class: 'size-4') %><%= t('admin.supplier_details.delete') %><% end %>
          </div>
        <% end %>
      </article>
    <% end %>
  </div>
  <% if @addresses.empty? %>
    <div class="rounded-2xl border border-dashed border-slate-200 bg-white p-10 text-center text-sm text-slate-500">—</div>
  <% end %>
  <% else %>
    <div class="rounded-xl border border-slate-200 bg-slate-50 p-4"><p class="font-semibold text-slate-800"><%= t('admin.supplier_details.deleted_addresses') %></p><p class="mt-1 text-sm text-slate-500"><%= t('admin.supplier_details.deleted_addresses_description') %></p></div>
    <div class="grid items-stretch gap-4 md:grid-cols-2">
      <% deleted_addresses.each do |address| %>
        <article class="flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="flex-1 p-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="flex items-center gap-3"><span class="flex size-10 items-center justify-center rounded-xl bg-slate-100 text-slate-500"><%= icon('map-pin', class: 'size-5') %></span><h2 class="font-jakarta font-bold text-slate-800"><%= t("admin.supplier_details.address_purposes.#{address.purpose}") %></h2></div>
              <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600"><%= t('admin.supplier_details.deleted_records') %></span>
            </div>
            <p class="mt-4 text-sm leading-6 text-slate-600"><%= address.full_address %></p>
            <p class="mt-3 flex items-center gap-2 text-xs text-slate-500"><%= icon('clock', class: 'size-4') %><%= t('admin.supplier_details.deleted_on', date: l(address.deleted_at.to_date, format: :long)) %></p>
          </div>
          <% if policy(@supplier).update? %>
            <div class="flex min-h-14 items-center justify-end border-t border-slate-100 bg-slate-50 px-5 py-3">
              <%= button_to restore_admin_supplier_address_path(@supplier, address), method: :patch, class: 'inline-flex min-h-10 items-center gap-2 rounded-xl border border-emerald-200 bg-white px-4 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-50' do %>
                <%= icon('arrow-path', class: 'size-4') %>
                <%= t('admin.supplier_details.restore_address') %>
              <% end %>
            </div>
          <% end %>
        </article>
      <% end %>
    </div>
    <% if deleted_addresses.empty? %>
      <div class="rounded-2xl border border-dashed border-slate-200 bg-white p-10 text-center text-sm text-slate-500"><%= t('admin.supplier_details.deleted_records') %>: 0</div>
    <% end %>
  <% end %>
</div>
