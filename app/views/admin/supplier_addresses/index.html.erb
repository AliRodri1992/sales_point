<div class="space-y-6" data-controller="swal-confirm">
  <div class="flex flex-wrap items-start justify-between gap-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div>
      <p class="text-sm font-medium text-emerald-700"><%= @supplier.name %></p>
      <h1 class="mt-1 font-jakarta text-2xl font-bold text-slate-900"><%= t('admin.supplier_details.addresses') %></h1>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to t('admin.supplier_details.back'), admin_supplier_path(@supplier), class: 'rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50' %>
      <% if policy(@supplier).update? %>
        <%= link_to t('admin.supplier_details.add_address'), new_admin_supplier_address_path(@supplier), class: 'rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-700' %>
      <% end %>
    </div>
  </div>
  <div class="grid gap-4 md:grid-cols-2">
    <% @addresses.each do |address| %>
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 class="font-semibold text-slate-900"><%= t("admin.supplier_details.address_purposes.#{address.purpose}") %></h2>
          <% if address.primary? %><span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700"><%= t('admin.supplier_details.primary') %></span><% end %>
        </div>
        <p class="mt-4 text-sm leading-6 text-slate-600"><%= address.full_address %></p>
        <% if policy(@supplier).update? %>
          <div class="mt-5 flex justify-end gap-4 border-t border-slate-100 pt-4">
            <%= link_to t('admin.supplier_details.edit'), edit_admin_supplier_address_path(@supplier, address), class: 'text-sm font-semibold text-emerald-700 hover:text-emerald-800' %>
            <%= button_to t('admin.supplier_details.delete'), admin_supplier_address_path(@supplier, address), method: :delete, form: { data: { turbo_confirm: t('admin.supplier_details.confirm') } }, class: 'text-sm font-semibold text-rose-600 hover:text-rose-700' %>
          </div>
        <% end %>
      </article>
    <% end %>
  </div>
  <% if @addresses.empty? %>
    <div class="rounded-2xl border border-dashed border-slate-200 bg-white p-10 text-center text-sm text-slate-500">—</div>
  <% end %>
  <% deleted_addresses = @supplier.addresses.with_deleted.where.not(deleted_at: nil).order(updated_at: :desc) %>
  <% if deleted_addresses.exists? %>
    <details class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <summary class="cursor-pointer font-semibold text-slate-800"><%= t('admin.supplier_details.deleted_records') %> (<%= deleted_addresses.count %>)</summary>
      <div class="mt-4 divide-y divide-slate-100">
        <% deleted_addresses.each do |address| %>
          <div class="flex flex-wrap items-center justify-between gap-3 py-3">
            <span class="text-sm text-slate-600"><%= address.full_address %></span>
            <% if policy(@supplier).update? %>
              <%= button_to t('admin.supplier_details.restore'), restore_admin_supplier_address_path(@supplier, address), method: :patch, class: 'text-sm font-semibold text-emerald-700' %>
            <% end %>
          </div>
        <% end %>
      </div>
    </details>
  <% end %>
</div>
