<div class="space-y-6" data-controller="swal-confirm">
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700"><%= @supplier.code %> · <%= @supplier.name %></p>
      <h1 class="mt-1 font-jakarta text-2xl font-bold text-slate-900"><%= t('admin.supplier_details.addresses') %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= t('admin.supplier_details.addresses_admin_description') %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to t('admin.supplier_details.back'), admin_supplier_path(@supplier, tab: 'addresses'), class: 'rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50' %>
      <% if policy(@supplier).manage_addresses? %>
        <%= link_to new_admin_supplier_address_path(@supplier), class: 'inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-700' do %><%= icon('plus', class: 'size-4') %><%= t('admin.supplier_details.add_address') %><% end %>
      <% end %>
    </div>
  </div>
  </div>
  <% deleted_addresses = @supplier.addresses.with_deleted.where.not(deleted_at: nil).order(deleted_at: :desc) %>
  <% showing_deleted = params[:status] == 'deleted' %>
  <% if @addresses.size.positive? || deleted_addresses.size.positive? %>
  <div data-address-statistics class="grid gap-3 sm:grid-cols-2">
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs font-semibold text-emerald-800"><%= t('admin.supplier_details.active_addresses') %></p><div class="mt-2 flex items-center gap-2"><%= icon('map-pin', class: 'size-5 text-emerald-700') %><p class="font-jakarta text-2xl font-bold text-slate-900"><%= @addresses.size %></p></div></div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs font-semibold text-slate-600"><%= t('admin.supplier_details.deleted_addresses') %></p><div class="mt-2 flex items-center gap-2"><%= icon('archive-box', class: 'size-5 text-slate-500') %><p class="font-jakarta text-2xl font-bold text-slate-900"><%= deleted_addresses.size %></p></div></div>
  </div>
  <% end %>
  <nav data-supplier-address-tabs class="inline-flex w-full flex-wrap gap-1 rounded-xl border border-slate-200 bg-slate-100 p-1 sm:w-auto" aria-label="<%= t('admin.supplier_details.addresses') %>">
    <%= link_to admin_supplier_addresses_path(@supplier), class: "inline-flex min-h-11 flex-1 items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold transition sm:flex-none #{showing_deleted ? 'text-slate-600 hover:bg-white/70' : 'bg-white text-emerald-700 shadow-sm'}", aria: { current: ('page' unless showing_deleted) } do %>
      <%= t('admin.supplier_details.active_addresses') %>
      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-700"><%= @addresses.size %></span>
    <% end %>
    <%= link_to admin_supplier_addresses_path(@supplier, status: 'deleted'), class: "inline-flex min-h-11 flex-1 items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold transition sm:flex-none #{showing_deleted ? 'bg-white text-emerald-700 shadow-sm' : 'text-slate-600 hover:bg-white/70'}", aria: { current: ('page' if showing_deleted) } do %>
      <%= t('admin.supplier_details.deleted_addresses') %>
      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-700"><%= deleted_addresses.size %></span>
    <% end %>
  </nav>
  <% unless showing_deleted %>
  <% if @addresses.any? %>
  <div class="grid items-stretch gap-4 md:grid-cols-2">
    <% @addresses.each do |address| %>
      <article class="flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:border-emerald-200 hover:shadow-md"><div class="flex-1 p-5">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-3"><span class="flex size-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><%= icon({ 'fiscal' => 'building-library', 'commercial' => 'building-office-2', 'delivery' => 'truck', 'general' => 'map-pin' }.fetch(address.purpose, 'map-pin'), class: 'size-5') %></span><div><h2 class="font-jakarta font-bold text-slate-900"><%= t("admin.supplier_details.address_purposes.#{address.purpose}") %></h2><p class="text-xs text-slate-400">#<%= address.id %></p></div></div>
          <% if address.primary? %><span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700"><%= icon('check-circle', class: 'size-3.5') %><%= t('admin.supplier_details.primary') %></span><% end %>
        </div>
        <div class="mt-4 space-y-1 text-sm leading-6 text-slate-600">
          <p class="font-medium text-slate-800"><%= [address.street, address.exterior_number, address.interior_number.presence].compact.join(' ') %></p>
          <p><%= address.neighborhood %></p>
          <p><%= [address.city, address.state].reject(&:blank?).join(', ') %><% if address.postal_code.present? %> · <%= t('admin.supplier_details.address_fields.postal_code') %> <%= address.postal_code %><% end %></p>
          <% if address.country.present? %><p class="text-slate-500"><%= address.country.localized_name %></p><% end %>
        </div></div>
        <% if policy(@supplier).manage_addresses? %>
          <div class="flex min-h-16 items-center justify-end gap-2 border-t border-slate-100 bg-slate-50/60 px-5 py-3">
            <%= link_to edit_admin_supplier_address_path(@supplier, address), class: 'inline-flex min-h-10 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100' do %><%= icon('pencil-square', class: 'size-4') %><%= t('admin.supplier_details.edit') %><% end %>
            <%= button_to admin_supplier_address_path(@supplier, address), method: :delete, form: { data: { turbo_confirm: t('admin.supplier_details.confirm') } }, class: 'inline-flex min-h-10 items-center justify-center gap-2 rounded-xl border border-rose-200 bg-white px-4 py-2 text-sm font-semibold text-rose-700 transition hover:bg-rose-50' do %><%= icon('trash', class: 'size-4') %><%= t('admin.supplier_details.delete') %><% end %>
          </div>
        <% end %>
      </article>
    <% end %>
  </div>
  <% else %>
    <div data-address-empty="active" class="flex min-h-[390px] items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-10 text-center sm:px-8">
      <div class="mx-auto max-w-xl">
        <%= image_tag 'saddresses.png', alt: '', loading: 'lazy', class: 'mx-auto h-auto w-full max-w-[240px] sm:max-w-[260px]' %>
        <h2 class="mt-3 font-jakarta text-xl font-bold text-slate-900">
          <%= t('admin.supplier_dossier.address_cards.empty_title') %>
        </h2>
        <p class="mx-auto mt-2 max-w-lg text-sm leading-6 text-slate-500">
          <%= t('admin.supplier_dossier.address_cards.empty_description') %>
        </p>
      </div>
    </div>
  <% end %>
  <% else %>
    <% if deleted_addresses.any? %>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><p class="font-semibold text-slate-800"><%= t('admin.supplier_details.deleted_addresses') %></p><p class="mt-1 text-sm text-slate-500"><%= t('admin.supplier_details.deleted_addresses_description') %></p></div>
    <div class="grid items-stretch gap-4 md:grid-cols-2">
      <% deleted_addresses.each do |address| %>
        <article class="flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="flex-1 p-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="flex items-center gap-3"><span class="flex size-10 items-center justify-center rounded-xl bg-slate-100 text-slate-500"><%= icon({ 'fiscal' => 'building-library', 'commercial' => 'building-office-2', 'delivery' => 'truck', 'general' => 'map-pin' }.fetch(address.purpose, 'map-pin'), class: 'size-5') %></span><h2 class="font-jakarta font-bold text-slate-800"><%= t("admin.supplier_details.address_purposes.#{address.purpose}") %></h2></div>
              <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600"><%= t('admin.supplier_details.deleted_records') %></span>
            </div>
            <div class="mt-4 space-y-1 text-sm leading-6 text-slate-600">
          <p class="font-medium text-slate-800"><%= [address.street, address.exterior_number, address.interior_number.presence].compact.join(' ') %></p>
          <p><%= address.neighborhood %></p>
          <p><%= [address.city, address.state].reject(&:blank?).join(', ') %><% if address.postal_code.present? %> · <%= t('admin.supplier_details.address_fields.postal_code') %> <%= address.postal_code %><% end %></p>
          <% if address.country.present? %><p class="text-slate-500"><%= address.country.localized_name %></p><% end %>
        </div>
            <p class="mt-3 flex items-center gap-2 text-xs text-slate-500"><%= icon('clock', class: 'size-4') %><%= t('admin.supplier_details.deleted_on', date: l(address.deleted_at.to_date, format: :long)) %></p>
          </div>
          <% if policy(@supplier).manage_addresses? %>
            <div class="flex min-h-14 items-center justify-end border-t border-slate-100 bg-slate-50 px-5 py-3">
              <%= button_to restore_admin_supplier_address_path(@supplier, address), method: :patch, class: 'inline-flex min-h-10 items-center gap-2 rounded-xl border border-emerald-200 bg-white px-4 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-50' do %>
                <%= icon('arrow-path', class: 'size-4') %>
                <%= t('admin.supplier_details.restore_address') %>
              <% end %>
            </div>
          <% end %>
        </article>
      <% end %>
    </div>
    <% else %>
      <div data-address-empty="deleted" class="flex min-h-[390px] items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-10 text-center sm:px-8">
        <div class="mx-auto max-w-xl">
          <%= image_tag 'saddresses.png', alt: '', loading: 'lazy', class: 'mx-auto h-auto w-full max-w-[240px] sm:max-w-[260px]' %>
          <h2 class="mt-3 font-jakarta text-xl font-bold text-slate-900">
            <%= t('admin.supplier_details.empty_deleted_addresses_title') %>
          </h2>
          <p class="mx-auto mt-2 max-w-lg text-sm leading-6 text-slate-500">
            <%= t('admin.supplier_details.empty_deleted_addresses_description') %>
          </p>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
