<%= form_with model: [:admin, @supplier, @address],
              class: 'space-y-4',
              html: { novalidate: true },
              data: {
                controller: 'supplier-address-preview supplier-address-location',
                action: 'input->supplier-address-preview#refresh change->supplier-address-preview#refresh input->supplier-address-location#changed change->supplier-address-location#changed',
                supplier_address_preview_placeholder_value: t('admin.supplier_details.address_form.preview_pending'),
                supplier_address_location_suggest_url_value: address_location_suggestion_admin_supplier_path(@supplier),
                supplier_address_location_map_url_value: address_map_admin_supplier_path(@supplier),
                supplier_address_location_unavailable_value: t('admin.supplier_details.address_form.location_unavailable'),
                supplier_address_location_ready_value: t('admin.supplier_details.address_form.location_ready'),
                supplier_address_location_confirmed_value: t('admin.supplier_details.address_form.location_confirmed'),
                supplier_address_location_searching_value: t('admin.supplier_details.address_form.location_searching')
              } do |form| %>
  <%= form.hidden_field :latitude, data: { supplier_address_location_target: 'latitude' } %>
  <%= form.hidden_field :longitude, data: { supplier_address_location_target: 'longitude' } %>
  <%= hidden_field_tag 'address[location_confirmed]', '0', data: { supplier_address_location_target: 'confirmed' } %>
  <%= hidden_field_tag 'address[location_signature]',
                       (@address.latitude.present? && @address.longitude.present? ?
                        Suppliers::AddressLocationProof.issue(
                          address: @address, supplier: @supplier, user: current_user,
                          latitude: @address.latitude, longitude: @address.longitude
                        ) : ''),
                       data: { supplier_address_location_target: 'signature' } %>

  <% if @address.errors[:base].any? %>
    <div role="alert" class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
      <%= @address.errors.full_messages_for(:base).to_sentence %>
    </div>
  <% end %>

  <div class="grid items-stretch gap-4 lg:grid-cols-[minmax(0,3fr)_minmax(320px,2fr)]">
    <section data-controller="supplier-postal-assist supplier-country-fields"
             data-action="input->supplier-postal-assist#input change->supplier-postal-assist#input change->supplier-country-fields#update"
             data-supplier-postal-assist-url-value="<%= postal_code_suggestions_admin_supplier_path(@supplier) %>"
             data-supplier-postal-assist-loading-value="<%= t('admin.supplier_details.address_form.postal_loading') %>"
             data-supplier-postal-assist-available-value="<%= t('admin.supplier_details.address_form.postal_available') %>"
             data-supplier-postal-assist-not-found-value="<%= t('admin.supplier_details.address_form.postal_not_found') %>"
             data-supplier-postal-assist-unavailable-value="<%= t('admin.supplier_details.address_form.postal_unavailable') %>"
             aria-labelledby="supplier-address-location-heading" class="min-w-0 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
      <div class="mb-6 flex items-center gap-3">
        <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
          <%= icon('map-pin', class: 'size-5') %>
        </span>
        <div>
          <h2 id="supplier-address-location-heading" class="font-jakarta text-lg font-bold text-slate-900"><%= t('admin.supplier_details.address_form.location_heading') %></h2>
          <p class="mt-1 text-sm text-slate-500"><%= t('admin.supplier_details.address_form.location_description') %></p>
        </div>
      </div>

      <div class="grid gap-x-4 gap-y-5 sm:grid-cols-2">
        <div class="min-w-0" data-address-field="country">
          <%= form.label :country_id, class: 'mb-2 block text-sm font-semibold text-slate-700' do %>
            <%= t('admin.supplier_details.address_fields.country') %> <span class="text-rose-600" aria-hidden="true">*</span>
          <% end %>
          <div class="relative" data-controller="delta-select" data-country-flags="true" data-search-placeholder="<%= t('admin.country_select.search') %>">
            <%= form.select :country_id,
                            options_for_select(
                              @countries.map { |country| [country.localized_name, country.id, { data: { country_code: country.iso_alpha2, flag_url: country_flag_asset_path(country) } }] },
                              form.object.country_id
                            ),
                            { include_blank: t('admin.supplier_placeholders.country') },
                            class: "block min-h-11 w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-800 focus:border-emerald-500 focus:ring-emerald-500 #{form_state_classes(@address, :country)}" %>
          </div>
          <%= error_message_for(@address, :country) %>
        </div>
        <div class="min-w-0" data-address-field="postal_code" data-country-postal-wrapper>
          <%= form.label :postal_code, class: 'mb-2 block text-sm font-semibold text-slate-700' do %>
            <span data-country-label data-country-label-mx="<%= t('admin.supplier_details.address_form.country_labels.postal_code.mx') %>" data-country-label-other="<%= t('admin.supplier_details.address_form.country_labels.postal_code.other') %>"><%= t('admin.supplier_details.address_form.country_labels.postal_code.mx') %></span> <span data-required-when="postal" class="text-rose-600" aria-hidden="true">*</span>
          <% end %>
          <%= form.text_field :postal_code, inputmode: 'text', autocomplete: 'postal-code',
                              placeholder: t('admin.supplier_details.address_form.placeholders.postal_code'),
                              class: "input-field min-h-11 w-full rounded-xl #{form_state_classes(@address, :postal_code)} px-4 py-2.5 text-sm text-slate-800 placeholder:text-slate-400" %>
          <%= error_message_for(@address, :postal_code) %>
          <p data-supplier-postal-assist-target="status" aria-live="polite" class="mt-1 text-xs text-slate-500"></p>
        </div>

        <% %i[state city].each do |field| %>
          <div class="min-w-0" data-address-field="<%= field %>">
            <%= form.label field, class: 'mb-2 block text-sm font-semibold text-slate-700' do %>
              <span data-country-label data-country-label-mx="<%= t("admin.supplier_details.address_form.country_labels.#{field}.mx") %>" data-country-label-other="<%= t("admin.supplier_details.address_form.country_labels.#{field}.other") %>"><%= t("admin.supplier_details.address_form.country_labels.#{field}.mx") %></span> <span data-required-when="<%= field == :city ? 'always' : 'state' %>" class="text-rose-600" aria-hidden="true">*</span>
            <% end %>
            <%= form.text_field field, autocomplete: (field == :state ? 'address-level1' : 'address-level2'),
                                placeholder: t("admin.supplier_details.address_form.placeholders.#{field}"),
                                class: "input-field min-h-11 w-full rounded-xl #{form_state_classes(@address, field)} px-4 py-2.5 text-sm text-slate-800 placeholder:text-slate-400" %>
            <%= error_message_for(@address, field) %>
          </div>
        <% end %>

        <div class="sm:col-span-2" data-address-field="neighborhood">
          <%= form.label :neighborhood, class: 'mb-2 block text-sm font-semibold text-slate-700' do %>
            <span data-country-label data-country-label-mx="<%= t('admin.supplier_details.address_form.country_labels.neighborhood.mx') %>" data-country-label-other="<%= t('admin.supplier_details.address_form.country_labels.neighborhood.other') %>"><%= t('admin.supplier_details.address_form.country_labels.neighborhood.mx') %></span> <span data-required-when="mx" class="text-rose-600" aria-hidden="true">*</span>
          <% end %>
          <%= form.text_field :neighborhood, list: 'supplier-neighborhoods',
                              placeholder: t('admin.supplier_details.address_form.placeholders.neighborhood'),
                              class: "input-field min-h-11 w-full rounded-xl #{form_state_classes(@address, :neighborhood)} px-4 py-2.5 text-sm text-slate-800 placeholder:text-slate-400" %>
          <datalist id="supplier-neighborhoods" data-supplier-postal-assist-target="neighborhoods"></datalist>
          <%= error_message_for(@address, :neighborhood) %>
        </div>

        <div class="sm:col-span-2" data-address-field="street">
          <%= form.label :street, class: 'mb-2 block text-sm font-semibold text-slate-700' do %>
            <%= t('admin.supplier_details.address_fields.street') %> <span class="text-rose-600" aria-hidden="true">*</span>
          <% end %>
          <%= form.text_field :street, autocomplete: 'street-address',
                              placeholder: t('admin.supplier_details.address_form.placeholders.street'),
                              class: "input-field min-h-11 w-full rounded-xl #{form_state_classes(@address, :street)} px-4 py-2.5 text-sm text-slate-800 placeholder:text-slate-400" %>
          <%= error_message_for(@address, :street) %>
        </div>

        <% %i[exterior_number interior_number].each do |field| %>
          <div class="min-w-0" data-address-field="<%= field %>">
            <%= form.label field, class: 'mb-2 block text-sm font-semibold text-slate-700' do %>
              <% if field == :exterior_number %>
                <span data-country-label data-country-label-mx="<%= t('admin.supplier_details.address_form.country_labels.exterior_number.mx') %>" data-country-label-other="<%= t('admin.supplier_details.address_form.country_labels.exterior_number.other') %>"><%= t('admin.supplier_details.address_form.country_labels.exterior_number.mx') %></span> <span data-required-when="mx" class="text-rose-600" aria-hidden="true">*</span>
              <% else %>
                <%= t("admin.supplier_details.address_fields.#{field}") %>
              <% end %>
            <% end %>
            <%= form.text_field field,
                                placeholder: t("admin.supplier_details.address_form.placeholders.#{field}"),
                                class: "input-field min-h-11 w-full rounded-xl #{form_state_classes(@address, field)} px-4 py-2.5 text-sm text-slate-800 placeholder:text-slate-400" %>
            <%= error_message_for(@address, field) %>
          </div>
        <% end %>

        <% if form.object.has_attribute?(:reference_notes) %>
        <div class="sm:col-span-2" data-address-field="reference_notes">
          <%= form.label :reference_notes, t('admin.supplier_details.address_form.references'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
          <%= form.text_area :reference_notes, rows: 2,
                             placeholder: t('admin.supplier_details.address_form.placeholders.references'),
                             class: "input-field min-h-20 w-full resize-y rounded-xl #{form_state_classes(@address, :reference_notes)} px-4 py-3 text-sm text-slate-800 placeholder:text-slate-400" %>
          <%= error_message_for(@address, :reference_notes) %>
        </div>
        <% end %>
      </div>
    </section>

    <div data-address-layout="right" class="flex min-w-0 flex-col gap-4 lg:h-full">
      <section aria-labelledby="supplier-address-preview-heading" class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <div class="mb-4 flex items-center gap-3">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><%= icon('map-pin', class: 'size-5') %></span>
          <div>
            <h2 id="supplier-address-preview-heading" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.supplier_details.address_form.preview_heading') %></h2>
            <p class="mt-1 text-xs text-slate-500"><%= t('admin.supplier_details.address_form.preview_description') %></p>
          </div>
        </div>
        <div class="grid min-w-0 gap-3 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
          <div class="relative min-h-44 overflow-hidden rounded-xl bg-slate-100">
            <div data-supplier-address-location-target="mapPlaceholder" class="absolute inset-0 flex items-center justify-center px-4 text-center text-xs text-slate-500">
              <%= t('admin.supplier_details.address_form.location_map_empty') %>
            </div>
            <img alt="<%= t('admin.supplier_details.address_form.location_map_alt') %>"
                 data-supplier-address-location-target="mapImage" class="hidden h-full min-h-44 w-full object-cover">
            <button type="button" data-supplier-address-location-target="mapClick"
                    data-action="click->supplier-address-location#adjust keydown->supplier-address-location#nudge pointerdown->supplier-address-location#dragStart pointerup->supplier-address-location#dragEnd"
                    aria-label="<%= t('admin.supplier_details.address_form.location_adjust') %>"
                    class="absolute inset-0 hidden w-full cursor-crosshair focus-visible:ring-2 focus-visible:ring-emerald-500"></button>
            <div data-supplier-address-location-target="pin"
                 class="pointer-events-none absolute left-1/2 top-1/2 hidden -translate-x-1/2 -translate-y-full rounded-full bg-white/90 p-1 text-emerald-700 shadow-lg">
              <%= icon('map-pin', class: 'size-6') %>
            </div>
          </div>
          <dl class="min-w-0 space-y-2 rounded-xl bg-slate-50 p-3 text-xs">
            <div>
              <dt class="font-semibold text-slate-500"><%= t('admin.supplier_details.address_form.preview_type') %></dt>
              <dd data-supplier-address-preview-target="purpose" class="mt-1 break-words font-semibold text-slate-800">—</dd>
            </div>
            <div>
              <dt class="font-semibold text-slate-500"><%= t('admin.supplier_details.address_form.preview_address') %></dt>
              <dd data-supplier-address-preview-target="address" class="mt-1 break-words text-slate-800"><%= t('admin.supplier_details.address_form.preview_pending') %></dd>
              <dd data-supplier-address-preview-target="area" class="mt-1 break-words text-slate-600"></dd>
              <dd data-supplier-address-preview-target="country" class="mt-1 break-words text-slate-600"></dd>
            </div>
            <div>
              <dt class="font-semibold text-slate-500"><%= t('admin.supplier_details.address_form.preview_priority') %></dt>
              <dd data-supplier-address-preview-target="primary" class="mt-1 break-words text-slate-800">—</dd>
            </div>
            <p data-supplier-address-preview-target="reference" class="hidden break-words border-t border-slate-200 pt-2 text-slate-600"></p>
          </dl>
        </div>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <button type="button" data-action="supplier-address-location#zoomIn" aria-label="<%= t('admin.supplier_details.location_zoom_in') %>"
                  class="min-h-10 rounded-lg border border-slate-200 px-3 text-sm font-semibold">+</button>
          <button type="button" data-action="supplier-address-location#zoomOut" aria-label="<%= t('admin.supplier_details.location_zoom_out') %>"
                  class="min-h-10 rounded-lg border border-slate-200 px-3 text-sm font-semibold">−</button>
          <button type="button" data-action="supplier-address-location#lookup" data-supplier-address-location-target="lookupButton"
                  class="inline-flex min-h-10 items-center gap-2 rounded-lg bg-emerald-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-emerald-700">
            <%= icon('magnifying-glass', class: 'size-4') %>
            <%= t('admin.supplier_details.address_form.location_search') %>
          </button>
          <button type="button" data-action="supplier-address-location#confirm" data-supplier-address-location-target="confirmButton"
                  class="hidden min-h-10 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs font-semibold text-emerald-800 hover:bg-emerald-100">
            <%= t('admin.supplier_details.address_form.location_confirm') %>
          </button>
        </div>
        <div class="mt-3">
          <%= form.label :location_adjustment_reason, t('admin.supplier_details.location_adjustment_reason'),
                         class: 'block text-xs font-semibold text-slate-700' %>
          <%= form.text_field :location_adjustment_reason, maxlength: 250,
                              placeholder: t('admin.supplier_details.location_adjustment_placeholder'),
                              class: 'mt-1 min-h-10 w-full rounded-lg border border-slate-200 px-3 text-sm' %>
          <%= error_message_for(@address, :location_adjustment_reason) %>
          <p class="mt-1 text-xs text-slate-500"><%= t('admin.supplier_details.location_adjustment_hint') %></p>
        </div>
        <p data-supplier-address-location-target="status" role="status" aria-live="polite"
           class="mt-2 text-xs leading-5 text-slate-600"><%= t('admin.supplier_details.address_form.location_optional') %></p>
        <p class="mt-2 text-[11px] leading-5 text-slate-500">
          <%= t('admin.supplier_details.address_form.location_map_help') %>
          <a href="https://www.mapbox.com/about/maps/" target="_blank" rel="noopener noreferrer"
             class="font-semibold underline underline-offset-2">© Mapbox © OpenStreetMap</a>
        </p>
      </section>

      <section aria-labelledby="supplier-address-classification-heading" class="flex-1 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <div class="mb-6 flex items-center gap-3">
          <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><%= icon('document-text', class: 'size-5') %></span>
          <div>
            <h2 id="supplier-address-classification-heading" class="font-jakarta text-lg font-bold text-slate-900"><%= t('admin.supplier_details.address_form.classification_heading') %></h2>
            <p class="mt-1 text-sm text-slate-500"><%= t('admin.supplier_details.address_form.classification_description') %></p>
          </div>
        </div>

        <fieldset data-address-field="purpose">
          <legend class="mb-3 text-sm font-semibold text-slate-800">
            <%= t('admin.supplier_details.address_form.address_type') %> <span class="text-rose-600" aria-hidden="true">*</span>
          </legend>
          <% purpose_icons = { 'fiscal' => 'building-office-2', 'commercial' => 'building-storefront', 'delivery' => 'truck', 'general' => 'map-pin' } %>
          <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
            <% %w[fiscal commercial delivery general].each do |purpose| %>
              <label class="flex min-h-28 min-w-0 cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-2 py-3 text-center text-xs font-semibold text-slate-700 transition hover:border-emerald-300 hover:bg-emerald-50 has-checked:border-emerald-600 has-checked:bg-emerald-50 has-checked:text-emerald-800 focus-within:outline focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-emerald-600">
                <%= icon(purpose_icons.fetch(purpose), class: 'size-6') %>
                <span><%= t("admin.supplier_details.address_purposes.#{purpose}") %></span>
                <%= form.radio_button :purpose, purpose,
                                      data: { label: t("admin.supplier_details.address_purposes.#{purpose}") },
                                      class: 'size-4 cursor-pointer accent-emerald-600' %>
              </label>
            <% end %>
          </div>
          <p class="mt-2 text-xs text-slate-500"><%= t('admin.supplier_details.address_form.purpose_hint') %></p>
          <%= error_message_for(@address, :purpose) %>
        </fieldset>

        <fieldset data-address-field="primary" class="mt-6 border-t border-slate-100 pt-5">
          <legend class="mb-3 text-sm font-semibold text-slate-800"><%= t('admin.supplier_details.address_form.is_primary') %></legend>
          <div class="space-y-2">
            <% [[false, 'secondary_option', 'secondary_hint'], [true, 'primary_option', 'primary_choice_hint']].each do |value, key, hint| %>
              <label class="flex min-h-16 cursor-pointer items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 transition hover:border-emerald-300 has-checked:border-emerald-600 has-checked:bg-emerald-50 focus-within:outline focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-emerald-600">
                <%= form.radio_button :primary, value, checked: (form.object.primary? == value),
                                      data: { label: t("admin.supplier_details.#{key}") },
                                      class: 'size-5 shrink-0 cursor-pointer accent-emerald-600' %>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-slate-900"><%= t("admin.supplier_details.#{key}") %></span>
                  <span class="mt-1 block text-xs leading-5 text-slate-500"><%= t("admin.supplier_details.address_form.#{hint}") %></span>
                </span>
              </label>
            <% end %>
          </div>
          <p class="mt-3 text-xs leading-5 text-slate-500"><%= t('admin.supplier_details.primary_hint') %></p>
          <%= error_message_for(@address, :primary) %>
        </fieldset>
      </section>
    </div>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-white px-5 py-4 shadow-sm sm:px-6">
    <p class="text-xs leading-5 text-slate-500"><%= t('admin.supplier_details.address_form.required_legend') %> <span class="font-semibold text-rose-600">*</span></p>
    <div class="ml-auto flex flex-wrap items-center gap-3">
      <%= link_to t('admin.supplier_details.address_form.cancel'), admin_supplier_addresses_path(@supplier),
                  class: 'inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50' %>
      <%= form.button type: :submit, class: 'inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' do %>
        <%= icon('check', class: 'size-4') %>
        <%= t("admin.supplier_details.address_form.#{@address.persisted? ? 'save_changes' : 'save_address'}") %>
      <% end %>
    </div>
  </div>
<% end %>
