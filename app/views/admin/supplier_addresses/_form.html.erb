<%= form_with model: [:admin, @supplier, @address], class: 'space-y-8 p-6 lg:p-8' do |form| %>
  <% if @address.errors[:base].any? %>
    <div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"><%= @address.errors.full_messages_for(:base).to_sentence %></div>
  <% end %>
  <section>
    <div class="mb-5 flex items-center gap-3">
      <span class="flex size-9 items-center justify-center rounded-lg bg-emerald-50 text-emerald-700"><%= icon('home', class: 'size-4') %></span>
      <h3 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.supplier_details.address_fields.street') %> / <%= t('admin.supplier_details.address_fields.neighborhood') %></h3>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      <% %i[street exterior_number interior_number neighborhood].each do |field| %>
        <div class="<%= 'sm:col-span-2' if field == :street %>">
          <%= form.label field, t("admin.supplier_details.address_fields.#{field}"), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
          <%= form.text_field field, class: "input-field w-full rounded-xl #{form_state_classes(@address, field)} px-4 py-3 text-sm text-slate-800 placeholder:text-slate-400", autocomplete: (field == :street ? 'street-address' : 'off') %>
          <%= error_message_for(@address, field) %>
        </div>
      <% end %>
      <div>
        <%= form.label :country_id, t('admin.supplier_details.address_fields.country'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.collection_select :country_id, @countries, :id, :localized_name, { include_blank: true }, class: "input-field w-full rounded-xl #{form_state_classes(@address, :country)} px-4 py-3 text-sm text-slate-800" %>
        <%= error_message_for(@address, :country) %>
      </div>
    </div>
  </section>
  <section class="border-t border-slate-100 pt-7">
    <div class="mb-5 flex items-center gap-3">
      <span class="flex size-9 items-center justify-center rounded-lg bg-emerald-50 text-emerald-700"><%= icon('map', class: 'size-4') %></span>
      <h3 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.supplier_details.address_fields.city') %> / <%= t('admin.supplier_details.address_fields.state') %></h3>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      <% %i[postal_code city state].each do |field| %>
        <div>
          <%= form.label field, t("admin.supplier_details.address_fields.#{field}"), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
          <%= form.text_field field, class: "input-field w-full rounded-xl #{form_state_classes(@address, field)} px-4 py-3 text-sm text-slate-800 placeholder:text-slate-400", maxlength: (5 if field == :postal_code), inputmode: (field == :postal_code ? 'numeric' : 'text'), autocomplete: ({ postal_code: 'postal-code', city: 'address-level2', state: 'address-level1' }[field]) %>
          <%= error_message_for(@address, field) %>
        </div>
      <% end %>
    </div>
  </section>
  <section class="border-t border-slate-100 pt-7">
    <div class="mb-5 flex items-center gap-3">
      <span class="flex size-9 items-center justify-center rounded-lg bg-emerald-50 text-emerald-700"><%= icon('cog-6-tooth', class: 'size-4') %></span>
      <h3 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.supplier_details.address_fields.purpose') %></h3>
    </div>
    <div class="space-y-6">
      <div class="max-w-xl">
        <%= form.label :purpose, t('admin.supplier_details.address_fields.purpose'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.select :purpose, Address::PURPOSES.map { |purpose| [t("admin.supplier_details.address_purposes.#{purpose}"), purpose] }, {}, class: "input-field w-full rounded-xl #{form_state_classes(@address, :purpose)} px-4 py-3 text-sm text-slate-800" %>
        <%= error_message_for(@address, :purpose) %>
      </div>
      <fieldset class="space-y-3">
        <legend class="text-sm font-semibold text-slate-700"><%= t('admin.supplier_details.primary') %></legend>
        <div class="flex flex-wrap gap-3">
          <% [[false, 'secondary_option'], [true, 'primary_option']].each do |value, key| %>
            <label class="relative inline-flex cursor-pointer items-center">
              <%= form.radio_button :primary, value.to_s, class: 'peer sr-only' %>
              <span class="inline-flex min-h-11 items-center rounded-full border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-600 transition hover:border-emerald-300 hover:bg-emerald-50 peer-checked:border-emerald-600 peer-checked:bg-emerald-50 peer-checked:text-emerald-800 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-emerald-600">
                <%= t("admin.supplier_details.#{key}") %>
              </span>
            </label>
          <% end %>
        </div>
        <p class="text-xs leading-5 text-slate-500"><%= t('admin.supplier_details.primary_hint') %></p>
        <%= error_message_for(@address, :primary) %>
      </fieldset>
    </div>
  </section>
  <div class="flex flex-wrap items-center justify-end gap-3 border-t border-slate-100 pt-6">
    <%= link_to t('admin.supplier_details.back'), admin_supplier_addresses_path(@supplier), class: 'inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50' %>
    <%= form.submit t('admin.supplier_details.save'), class: 'inline-flex cursor-pointer items-center justify-center rounded-xl bg-emerald-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus:ring-4 focus:ring-emerald-100' %>
  </div>
<% end %>
