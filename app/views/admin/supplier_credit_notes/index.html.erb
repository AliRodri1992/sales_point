<%= render 'admin/financials/navigation' %>
<section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="mb-6 flex flex-wrap justify-between gap-3"><h1 class="font-jakarta text-2xl font-bold"><%= t('admin.accounts_payable.credits') %></h1>
    <% if policy(SupplierCreditNote.new(organization: current_organization)).create? %>
      <%= link_to t('admin.accounts_payable.new_credit'), new_admin_supplier_credit_note_path, class: 'rounded-xl bg-emerald-600 px-4 py-2 text-sm font-semibold text-white' %><% end %>
  </div>
  <div class="overflow-x-auto"><table class="min-w-full text-left text-sm">
    <thead class="bg-slate-50"><tr><% %w[folio supplier issued_on amount balance status].each do |key| %><th class="p-3"><%= t("admin.accounts_payable.#{key}") %></th><% end %></tr></thead>
    <tbody><% @credits.each do |credit| %><tr class="border-t border-slate-100">
      <td class="p-3"><%= link_to credit.folio.presence || "##{credit.id}", admin_supplier_credit_note_path(credit), class: 'font-semibold text-emerald-700' %></td>
      <td class="p-3"><%= credit.supplier.name %></td><td class="p-3"><%= l(credit.issued_on) %></td>
      <td class="p-3"><%= number_to_currency(credit.total, unit: '') %></td>
      <td class="p-3"><%= number_to_currency(credit.available_amount, unit: '') %></td>
      <td class="p-3"><%= t("admin.accounts_payable.states.#{credit.status}") %></td>
    </tr><% end %></tbody>
  </table></div>
</section>

