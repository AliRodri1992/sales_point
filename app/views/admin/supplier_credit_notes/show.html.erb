<%= render 'admin/financials/navigation' %>
<section class="space-y-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <h1 class="font-jakarta text-2xl font-bold"><%= t('admin.accounts_payable.credit') %> <%= @credit.folio.presence || "##{@credit.id}" %></h1>
  <% if @credit.xml_document.attached? %>
    <%= link_to t('admin.accounts_payable.download_xml'), download_xml_admin_supplier_credit_note_path(@credit), class: 'inline-flex rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold text-emerald-700' %>
  <% end %>
  <p class="text-sm text-slate-600"><%= @credit.supplier.name %> · <%= @credit.currency.code %> · <%= t("admin.accounts_payable.states.#{@credit.status}") %></p>
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="rounded-xl bg-slate-50 p-4"><p class="text-xs text-slate-500"><%= t('admin.accounts_payable.amount') %></p><p class="text-2xl font-bold"><%= number_to_currency(@credit.total, unit: '') %></p></div>
    <div class="rounded-xl bg-slate-50 p-4"><p class="text-xs text-slate-500"><%= t('admin.accounts_payable.balance') %></p><p class="text-2xl font-bold"><%= number_to_currency(@credit.available_amount, unit: '') %></p></div>
  </div>
  <% if @credit.draft? && policy(@credit).post? %>
    <%= button_to t('admin.accounts_payable.post'), post_credit_admin_supplier_credit_note_path(@credit), class: 'rounded-xl bg-emerald-600 px-5 py-3 font-semibold text-white' %>
  <% end %>
  <% if @credit.posted? && @credit.available_amount.positive? && policy(@credit).apply? %>
    <%= form_with url: apply_admin_supplier_credit_note_path(@credit), class: 'space-y-4 rounded-xl bg-slate-50 p-5' do %>
      <h2 class="font-semibold"><%= t('admin.accounts_payable.apply_credit') %></h2>
      <%= select_tag :account_payable_id, options_from_collection_for_select(@payables.select { |p| p.supplier_invoice.currency_id == @credit.currency_id }, :id, :id),
                     prompt: t('admin.accounts_payable.select_payable'), required: true,
                     class: 'w-full rounded-xl border border-slate-300 p-3' %>
      <%= number_field_tag :amount, @credit.available_amount, min: '0.01', max: @credit.available_amount, step: '0.01', required: true,
                           class: 'w-full rounded-xl border border-slate-300 p-3' %>
      <%= submit_tag t('admin.accounts_payable.apply'), class: 'rounded-xl bg-emerald-600 px-5 py-3 font-semibold text-white' %>
    <% end %>
  <% end %>
  <% @credit.supplier_credit_allocations.each do |allocation| %>
    <p class="border-b border-slate-100 py-2 text-sm"><%= link_to "##{allocation.account_payable_id}", admin_account_payable_path(allocation.account_payable), class: 'font-semibold text-emerald-700' %>:
      <%= number_to_currency(allocation.amount, unit: '') %></p>
  <% end %>
  <% if !@credit.cancelled? && policy(@credit).cancel? %>
    <%= button_to t('admin.accounts_payable.cancel'), cancel_admin_supplier_credit_note_path(@credit), class: 'rounded-xl border border-rose-300 px-5 py-3 font-semibold text-rose-700', form: { data: { turbo_confirm: t('admin.accounts_payable.confirm') } } %>
  <% end %>
</section>

