<% content_for :title, t('admin.languages.new.title') %>
<% if turbo_frame_request? %>
  <%= turbo_frame_tag 'language_modal', class: 'catalog-workspace languages-workspace' do %>
    <div data-modal-target="panel" role="dialog" aria-modal="true" aria-labelledby="language-panel-title"
         class="w-full max-w-3xl rounded-2xl bg-slate-50 p-5 sm:p-7">
      <%= render 'panel' %>
    </div>
  <% end %>
<% else %>
  <div class="catalog-workspace languages-workspace"><%= render 'panel' %></div>
<% end %>
