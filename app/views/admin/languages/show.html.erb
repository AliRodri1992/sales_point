<% content_for :title, @language.name %>
<% if turbo_frame_request? %>
  <%= turbo_frame_tag 'language_modal', class: 'catalog-workspace languages-workspace' do %>
    <div data-modal-target="panel" role="dialog" aria-modal="true" aria-labelledby="language-show-title"
         class="w-full max-w-3xl rounded-2xl bg-slate-50 p-5 sm:p-7">
      <%= render 'show' %>
    </div>
  <% end %>
<% else %>
  <div class="catalog-workspace languages-workspace" id="language_detail_panel"><%= render 'show' %></div>
<% end %>
