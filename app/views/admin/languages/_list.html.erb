<%# Rendered in the Turbo Frame and after CRUD Turbo Streams. %>
<% total_count = local_assigns.fetch(:total_count, @total_count || 0) %>
<% total_pages = local_assigns.fetch(:total_pages, @total_pages || 1) %>
<% unfiltered_count = local_assigns.fetch(:unfiltered_count, @unfiltered_count || 0) %>
<% search_filter = params[:search].to_s.strip.presence %>
<% status_filter = params[:status] if Language.statuses.key?(params[:status]) %>
<% filtered = search_filter.present? || status_filter.present? %>

<% if filtered %>
  <nav class="languages-active-filters" aria-label="<%= t('admin.languages.ui.active_filters') %>">
    <span class="languages-active-filters__label"><%= t('admin.languages.ui.active_filters') %></span>
    <% if search_filter.present? %>
      <%= link_to admin_languages_path(request.query_parameters.except('search', 'page')),
                  class: 'languages-filter-chip', data: { turbo_frame: '_top' },
                  aria: { label: t('admin.languages.ui.remove_search') } do %>
        <span><%= t('admin.languages.ui.search_filter', value: search_filter) %></span>
        <%= delta_icon('x-mark', class: 'size-3.5', aria: { hidden: true }) %>
      <% end %>
    <% end %>
    <% if status_filter.present? %>
      <%= link_to admin_languages_path(request.query_parameters.except('status', 'page')),
                  class: 'languages-filter-chip', data: { turbo_frame: '_top' },
                  aria: { label: t('admin.languages.ui.remove_status') } do %>
        <span><%= t('admin.languages.ui.status_filter', value: t("admin.languages.statuses.#{status_filter}")) %></span>
        <%= delta_icon('x-mark', class: 'size-3.5', aria: { hidden: true }) %>
      <% end %>
    <% end %>
    <%= link_to t('admin.languages.ui.clear_filters'), admin_languages_path,
                class: 'languages-filter-clear', data: { turbo_frame: '_top' } %>
  </nav>
<% end %>

<section class="languages-results" aria-label="<%= t('admin.languages.index.card_title') %>">
  <header class="languages-results__header">
    <div>
      <h2><%= t('admin.languages.index.card_title') %></h2>
      <p aria-live="polite"><%= t('admin.languages.index.total_count', count: total_count) %></p>
    </div>
  </header>

  <% if languages.any? %>
    <div class="languages-desktop-table">
      <table>
        <thead>
          <tr>
            <th scope="col"><%= sort_link('name', t('admin.languages.index.columns.language'), frame: '_top') %></th>
            <th scope="col"><%= sort_link('code', t('admin.languages.index.columns.code'), frame: '_top') %></th>
            <th scope="col"><%= sort_link('status', t('admin.languages.index.columns.status'), frame: '_top') %></th>
            <th scope="col" class="languages-actions-heading"><%= t('admin.languages.index.columns.actions') %></th>
          </tr>
        </thead>
        <tbody>
          <% languages.each do |language| %>
            <tr>
              <td>
                <div class="languages-identity">
                  <%= image_tag language.flag_url('64x48'), srcset: language.flag_srcset, alt: '',
                                loading: 'lazy', class: 'languages-flag' %>
                  <div>
                    <span class="languages-name"><%= language.name %></span>
                    <% if language.code == I18n.default_locale.to_s %>
                      <span class="languages-default-label"><%= t('admin.languages.ui.default_language') %></span>
                    <% end %>
                  </div>
                </div>
              </td>
              <td><code class="languages-code"><%= language.code %></code></td>
              <td><%= catalog_status(language.active?, scope: 'admin.languages.statuses') %></td>
              <td><%= render 'row_actions', language: language %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <ul class="languages-mobile-list">
      <% languages.each do |language| %>
        <li>
          <div class="languages-mobile-card-head">
            <div class="languages-identity">
              <%= image_tag language.flag_url('64x48'), srcset: language.flag_srcset, alt: '',
                            loading: 'lazy', class: 'languages-flag' %>
              <div>
                <span class="languages-name"><%= language.name %></span>
                <code class="languages-code"><%= language.code %></code>
              </div>
            </div>
            <%= catalog_status(language.active?, scope: 'admin.languages.statuses') %>
          </div>
          <div class="languages-mobile-card-footer">
            <% if language.code == I18n.default_locale.to_s %>
              <span class="languages-default-label"><%= t('admin.languages.ui.default_language') %></span>
            <% else %>
              <span></span>
            <% end %>
            <%= render 'row_actions', language: language %>
          </div>
        </li>
      <% end %>
    </ul>

    <% if unfiltered_count > TablePagePreference::OPTIONS.min || total_pages > 1 %>
      <footer class="languages-pagination">
        <div class="languages-page-size">
        <%= label_tag :per_page, t('admin.languages.index.pagination.per_page_label') %>
        <div class="relative" data-controller="delta-select">
          <%= select_tag :per_page,
                         options_for_select(TablePagePreference::OPTIONS, @per_page || TablePagePreference::DEFAULT),
                         data: { controller: 'table-page-size', table_page_size_key_value: 'languages',
                                 action: 'change->table-page-size#apply' } %>
        </div>
      </div>
      <div class="languages-pagination-links">
        <%= pagination_links(total_pages, frame: '_top') if total_pages > 1 %>
      </div>
      </footer>
    <% end %>
  <% else %>
    <div class="languages-empty">
      <div class="languages-empty__icon"><%= delta_icon('language', class: 'size-7', aria: { hidden: true }) %></div>
      <% if unfiltered_count.positive? %>
        <h3><%= t('admin.languages.ui.no_results_title') %></h3>
        <p><%= t('admin.languages.ui.no_results_hint') %></p>
        <%= link_to t('admin.languages.ui.clear_filters'), admin_languages_path,
                    class: 'catalog-button', data: { turbo_frame: '_top' } %>
      <% else %>
        <h3><%= t('admin.languages.index.empty_title') %></h3>
        <p><%= t('admin.languages.index.empty_subtitle') %></p>
        <% if policy(Language).create? %>
          <%= link_to new_admin_language_path(request.query_parameters),
                      class: 'catalog-button catalog-button-primary',
                      data: { turbo_frame: 'language_modal' } do %>
            <%= delta_icon('plus', class: 'size-4', aria: { hidden: true }) %>
            <%= t('admin.languages.index.new') %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>
