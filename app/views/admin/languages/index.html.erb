<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="font-jakarta text-2xl font-bold text-slate-900">
      <%= t('admin.languages.index.title') %>
    </h1>
    <p class="mt-1 text-sm text-slate-500">
      <%= t('admin.languages.index.subtitle') %>
    </p>
  </div>
  <div class="flex items-center gap-2">
    <%= link_to new_admin_language_path,
                data: { turbo_frame: 'language_modal', tooltip: t('admin.languages.index.new') },
                class: 'inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700' do %>
      <%= icon('plus', class: 'size-4') %>
      <%= t('admin.languages.index.new') %>
    <% end %>
  </div>
</div>

<%= turbo_frame_tag "languages_list" do %>
  <%= render "list", languages: @languages %>
<% end %>
