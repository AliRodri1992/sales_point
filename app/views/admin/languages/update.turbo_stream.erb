<%= turbo_stream.update "language_modal", "" %>
<%= turbo_stream.update "languages_list" do %>
  <%= render "list", languages: @languages, total_count: @total_count, total_pages: @total_pages %>
<% end %>
<%= turbo_stream.update "language_detail_panel" do %>
  <%= render "show" %>
<% end %>
<turbo-stream action="swal" target="swal"><template><%= @swal_message %></template></turbo-stream>
