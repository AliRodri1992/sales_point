<% language = @language %>
<div
  data-modal-target="panel"
  role="dialog"
  aria-modal="true"
  aria-labelledby="language-modal-title"
  class="relative w-full max-w-lg rounded-2xl border border-slate-200 bg-white shadow-xl"
>
  <div class="flex items-center justify-between border-b border-slate-100 px-6 py-4">
    <div>
      <h2 id="language-modal-title" class="font-jakarta text-lg font-bold text-slate-900">
        <%= language.persisted? ? t('admin.languages.edit.title', name: language.name) : t('admin.languages.new.title') %>
      </h2>
      <p class="mt-0.5 text-sm text-slate-500">
        <%= language.persisted? ? t('admin.languages.edit.subtitle') : t('admin.languages.new.subtitle') %>
      </p>
    </div>
    <button
      type="button"
      data-modal-dismiss
      data-action="modal#close"
      class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-600"
      aria-label="<%= t('admin.languages.show.close') %>"
    >
      <%= icon('x-mark', class: 'size-5') %>
    </button>
  </div>

  <div class="px-6 py-6">
    <%= render 'form', language: language %>
  </div>
</div>
