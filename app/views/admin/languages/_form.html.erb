<% modal = local_assigns.fetch(:modal, false) %>
<% form_url = language.persisted? ? admin_language_path(language, request.query_parameters) :
                                   admin_languages_path(request.query_parameters) %>
<%= form_with model: [:admin, language], url: form_url,
              data: { turbo: modal, turbo_frame: modal ? 'language_modal' : '_top' },
              html: { novalidate: true }, class: 'languages-editor' do |form| %>
  <%= catalog_errors(language) %>
  <section class="catalog-card">
    <% unless modal %>
      <%= catalog_heading(t('admin.catalog_design.language_identity'),
                          t('admin.catalog_design.language_identity_hint'), icon: 'language') %>
    <% end %>

    <div class="catalog-card-body languages-editor__fields">
      <% [:name, :code, :flag_iso].each do |attribute| %>
        <div class="catalog-field">
          <%= form.label attribute, required_field_label(t("admin.languages.form.#{attribute}")) %>
          <%= form.text_field attribute,
                              maxlength: attribute == :name ? 100 : 2,
                              readonly: attribute == :code && language.persisted?,
                              autocomplete: 'off', spellcheck: false,
                              aria: { invalid: language.errors[attribute].any?,
                                      describedby: validation_describedby(language, attribute,
                                                                          "language_#{attribute}_hint") },
                              class: form_state_classes(language, attribute) %>
          <p id="language_<%= attribute %>_hint" class="catalog-hint">
            <%= t("admin.catalog_design.language_#{attribute}_hint") %>
          </p>
          <%= error_message_for(language, attribute) %>
        </div>
      <% end %>

      <div class="catalog-field">
        <%= form.label :status, t('admin.languages.form.status') %>
        <div class="relative" data-controller="delta-select">
          <%= form.select :status,
                          Language.statuses.keys.map { |value| [t("admin.languages.statuses.#{value}"), value] },
                          {},
                          disabled: language.persisted? && language.code == I18n.default_locale.to_s,
                          aria: { invalid: language.errors[:status].any?,
                                  describedby: validation_describedby(language, :status, 'language_status_hint') } %>
        </div>
        <p id="language_status_hint" class="catalog-hint">
          <%= language.persisted? && language.code == I18n.default_locale.to_s ?
                t('admin.languages.ui.default_status_hint') : t('admin.catalog_design.language_status_hint') %>
        </p>
        <%= error_message_for(language, :status) %>
      </div>
    </div>
  </section>

  <div class="languages-editor__note">
    <%= delta_icon('information-circle', class: 'size-5', aria: { hidden: true }) %>
    <div>
      <strong><%= t('admin.languages.ui.form_note_title') %></strong>
      <p><%= t('admin.languages.ui.form_note') %></p>
    </div>
  </div>

  <footer class="languages-editor__footer">
    <% if modal %>
      <button type="button" class="catalog-button" data-modal-dismiss data-action="modal#close">
        <%= t('admin.catalog_design.cancel') %>
      </button>
    <% else %>
      <%= link_to t('admin.catalog_design.cancel'), catalog_back_path(Language),
                  class: 'catalog-button', data: { turbo: false } %>
    <% end %>
    <%= form.submit(language.persisted? ? t('admin.languages.form.update') : t('admin.languages.form.create'),
                    class: 'catalog-button catalog-button-primary') %>
  </footer>
<% end %>
