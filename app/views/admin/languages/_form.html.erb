<%= form_with model: [:admin, language], data: { turbo: false }, class: 'catalog-layout' do |form| %>
  <div class="catalog-main">
    <%= catalog_errors(language) %>
    <section class="catalog-card">
      <%= catalog_heading(t('admin.catalog_design.language_identity'), t('admin.catalog_design.language_identity_hint'), icon: 'language') %>
      <div class="catalog-card-body catalog-fields">
        <% [:name, :code, :flag_iso].each do |attribute| %>
          <div class="catalog-field <%= 'catalog-full' if attribute == :name %>">
            <%= form.label attribute, t("admin.languages.form.#{attribute}") %>
            <%= form.text_field attribute, required: true, maxlength: attribute == :name ? 100 : 2, autocomplete: 'off', spellcheck: false, aria: { invalid: language.errors[attribute].any?, describedby: "language_#{attribute}_hint" }, class: form_state_classes(language, attribute) %>
            <p id="language_<%= attribute %>_hint" class="catalog-hint"><%= t("admin.catalog_design.language_#{attribute}_hint") %></p>
            <%= error_message_for(language, attribute) %>
          </div>
        <% end %>
        <div class="catalog-field">
          <%= form.label :status, t('admin.languages.form.status') %>
          <%= form.select :status, Language.statuses.keys.map { |status| [t("admin.languages.statuses.#{status}"), status] } %>
          <%= error_message_for(language, :status) %>
        </div>
      </div>
    </section>
    <footer class="catalog-footer"><%= link_to t('admin.catalog_design.cancel'), catalog_back_path(Language), class: 'catalog-button', data: { turbo: false } %><%= form.submit language.persisted? ? t('admin.languages.form.update') : t('admin.languages.form.create'), class: 'catalog-button catalog-button-primary' %></footer>
  </div>
  <aside class="catalog-aside"><section class="catalog-card catalog-card-body"><span class="catalog-icon"><%= delta_icon('globe-alt', class: 'size-5') %></span><h2 class="mt-4"><%= t('admin.catalog_design.language_help_title') %></h2><p><%= t('admin.catalog_design.language_help') %></p><p><%= t('admin.catalog_design.language_status_hint') %></p></section></aside>
<% end %>
