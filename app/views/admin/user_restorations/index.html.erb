<div class="mx-auto max-w-4xl space-y-6">
  <header class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-emerald-700"><%= t('admin.users.status_management.eyebrow') %></p>
      <h1 class="mt-1 font-jakarta text-2xl font-bold"><%= t('admin.users.status_management.deleted_accounts') %></h1>
      <p class="mt-2 text-sm text-slate-600"><%= t('admin.users.status_management.restore_warning') %></p>
    </div>
    <%= link_to t('admin.users.form.buttons.back'), admin_users_path,
                class: 'rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold' %>
  </header>
  <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5" aria-label="<%= t('user_restore_ui.search_title') %>">
    <%= form_with url: admin_user_restorations_path, method: :get, html: { novalidate: true },
                  class: 'flex flex-col gap-3 sm:flex-row sm:items-end' do %>
      <div class="min-w-0 flex-1">
        <%= label_tag :q, t('user_restore_ui.search_title'), class: 'mb-1 block text-sm font-semibold text-slate-700' %>
        <%= search_field_tag :q, params[:q], placeholder: t('user_restore_ui.search_placeholder'),
                             class: 'min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm' %>
      </div>
      <%= button_tag t('user_restore_ui.search_button'), type: 'submit',
                     class: 'min-h-11 rounded-xl bg-emerald-700 px-5 py-2 font-semibold text-white' %>
      <%= link_to t('user_restore_ui.clear_filters'), admin_user_restorations_path,
                  class: 'min-h-11 rounded-xl border border-slate-200 px-4 py-3 text-sm font-semibold text-emerald-800' %>
    <% end %>
    <p class="mt-3 text-sm text-slate-500"><%= t('user_restore_ui.results', count: @total_count) %></p>
  </section>
  <% if @deleted_users.empty? %>
    <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center text-slate-500">
      <%= t('admin.users.status_management.no_deleted_accounts') %>
    </div>
  <% else %>
    <div class="space-y-4">
      <% @deleted_users.each do |user| %>
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="font-semibold text-slate-900"><%= user.display_name %></h2>
          <p class="mt-1 break-all text-sm text-slate-500"><%= user.email %></p>
          <%= form_with url: admin_user_restoration_path(user), method: :post,
                        html: { novalidate: true }, class: 'mt-4 flex flex-col gap-3 sm:flex-row sm:items-end' do |form| %>
            <div class="min-w-0 flex-1">
              <%= form.label :reason, class: 'mb-1 block text-sm font-semibold' do %>
                <%= t('admin.users.status_management.reason') %><span class="ml-1 font-bold text-rose-600" aria-hidden="true">*</span>
              <% end %>
              <% current_error = @restoration_error_target_id == user.id %>
              <%= form.text_field :reason, value: current_error ? @restoration_form.reason : nil, maxlength: 1000,
                                  aria: { invalid: current_error && @restoration_form.errors[:reason].any? },
                                  class: "w-full rounded-xl border px-3 py-2 text-sm #{current_error ? form_state_classes(@restoration_form, :reason) : 'border-slate-300'}" %>
              <% if current_error %>
                <%= error_message_for(@restoration_form, :reason, label: t('admin.users.status_management.reason')) %>
              <% end %>
            </div>
            <%= form.submit t('admin.users.status_management.restore'),
                            data: { turbo_confirm: t('admin.users.status_management.restore_warning') },
                            class: 'cursor-pointer rounded-xl bg-emerald-700 px-5 py-2.5 text-sm font-semibold text-white' %>
          <% end %>
        </section>
      <% end %>
    </div>
    <% if @total_pages > 1 %>
      <nav class="mt-5 flex flex-wrap gap-2" aria-label="<%= t('user_restore_ui.pagination') %>">
        <%= pagination_links(@total_pages, window: 2) %>
      </nav>
    <% end %>
  <% end %>
</div>
