<main class="mx-auto max-w-[1480px] space-y-5 px-4 pb-8 pt-4 sm:px-6 sm:pt-6" data-loading-scope="true">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0 flex-[1_1_20rem]">
      <p class="text-xs font-bold uppercase tracking-widest text-emerald-700"><%= t('admin.email_templates.section') %></p>
      <h1 class="mt-1 break-words font-jakarta text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"><%= t('admin.email_templates.edit') %> · <%= @template.name %></h1>
      <p class="mt-2 text-sm leading-6 text-slate-500"><%= t('admin.email_templates.draft_explanation') %></p>
      <% if @template.customized? %>
        <p role="note" class="mt-3 inline-flex max-w-2xl items-start gap-2 rounded-xl border border-teal-200 bg-teal-50 px-3 py-2 text-sm leading-5 text-teal-900">
          <%= delta_icon('information-circle', class: 'mt-0.5 size-4 shrink-0') %>
          <%= t('admin.email_templates.custom_draft_notice', name: @template.source_template.name) %>
        </p>
      <% end %>
    </div>
    <%= render 'admin/email_templates/back_button', path: admin_email_template_path(@template) %>
  </header>

  <%= render 'workflow_steps', step: 2 %>

  <%= form_with model: @draft, url: draft_admin_email_template_path(@template, version_id: @draft.id),
                method: :patch, html: { novalidate: true }, class: 'grid min-w-0 items-start gap-5 xl:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]',
                data: { controller: 'email-template-preview email-template-editor email-template-unsaved',
                        email_template_unsaved_warning_value: t('admin.email_templates.unsaved_warning'),
                        action: 'input->email-template-preview#schedule change->email-template-preview#schedule input->email-template-unsaved#changed change->email-template-unsaved#changed submit->email-template-unsaved#submitting turbo:submit-end->email-template-unsaved#submitted',
                        email_template_preview_url_value: preview_draft_admin_email_template_path(@template, version_id: @draft.id),
                        email_template_preview_error_value: t('admin.email_templates.preview_error'),
                        email_template_preview_loading_value: t('admin.email_templates.preview_loading') } do |f| %>
    <%= f.hidden_field :lock_version %>
    <section class="min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="template-editor-title">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-4 sm:px-6">
        <div class="min-w-0">
          <h2 id="template-editor-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.content_title') %></h2>
          <p class="mt-1 text-xs text-slate-500"><%= t('admin.email_templates.content_hint') %></p>
        </div>
        <div class="flex items-center gap-2">
          <%= image_tag 'deltin/waving.svg', alt: t('admin.email_templates.deltin_alt'),
                        class: 'hidden size-12 shrink-0 object-contain sm:block' %>
          <span class="rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800"><%= t('admin.email_templates.status_labels.draft') %> · v<%= @draft.version_number %></span>
        </div>
      </div>


      <div class="space-y-6 px-5 py-5 sm:px-6">
        <div class="grid gap-4 lg:grid-cols-2">
          <div class="min-w-0">
          <%= f.label :subject, required_field_label(t('admin.email_templates.subject')), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
          <%= f.text_field :subject, maxlength: 250, aria: { invalid: @draft.errors[:subject].any?, describedby: validation_describedby(@draft, :subject) },
                           data: { action: 'focus->email-template-editor#rememberField' },
                           class: "min-h-11 w-full rounded-xl border px-4 py-2.5 text-sm focus:ring-2 #{ @draft.errors[:subject].any? ? 'border-rose-400 bg-rose-50/40 focus:border-rose-500 focus:ring-rose-100' : 'border-slate-300 focus:border-emerald-500 focus:ring-emerald-100' }" %>
          <%= error_message_for(@draft, :subject, label: t('admin.email_templates.subject')) %>
          </div>
          <div class="min-w-0">
          <%= f.label :preheader, t('admin.email_templates.preheader'), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
          <%= f.text_field :preheader, maxlength: 250, aria: { invalid: @draft.errors[:preheader].any?, describedby: validation_describedby(@draft, :preheader, 'email-template-preheader-hint') },
                           class: "min-h-11 w-full rounded-xl border px-4 py-2.5 text-sm focus:ring-2 #{ @draft.errors[:preheader].any? ? 'border-rose-400 bg-rose-50/40 focus:border-rose-500 focus:ring-rose-100' : 'border-slate-300 focus:border-emerald-500 focus:ring-emerald-100' }" %>
          <p id="email-template-preheader-hint" class="mt-1.5 text-xs leading-5 text-slate-500"><%= t('admin.email_templates.preheader_hint') %></p>
          <%= error_message_for(@draft, :preheader, label: t('admin.email_templates.preheader')) %>
          </div>
        </div>
        <div class="min-w-0">
          <%= f.label :html_body, required_field_label(t('admin.email_templates.html_source')), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
          <div class="mb-3 flex flex-wrap items-center gap-2" role="group" aria-label="<%= t('admin.email_templates.insert_variable') %>">
            <% %w[recipient_name organization_name activation_url platform_logo].each do |variable| %>
              <button type="button" data-action="click->email-template-editor#insertVariable"
                      data-variable="<%= variable %>" title="<%= t('admin.email_templates.insert_variable') %>"
                      class="min-h-9 rounded-lg border border-emerald-200 bg-emerald-50 px-3 font-mono text-[11px] font-semibold text-emerald-900 hover:bg-emerald-100 focus-visible:outline-2 focus-visible:outline-emerald-600">
                <%= "{{#{variable}}}" %>
              </button>
            <% end %>
          </div>
          <%= f.text_area :html_body, rows: 14, spellcheck: false,
                          data: { email_template_editor_target: 'htmlBody', action: 'focus->email-template-editor#rememberField' },
                          aria: { invalid: @draft.errors[:html_body].any?, describedby: validation_describedby(@draft, :html_body) },
                          class: "block min-h-80 w-full resize-y rounded-xl border bg-slate-900 px-4 py-3 font-mono text-xs leading-6 text-slate-100 focus:ring-2 #{ @draft.errors[:html_body].any? ? 'border-rose-400 focus:border-rose-500 focus:ring-rose-200' : 'border-slate-700 focus:border-emerald-500 focus:ring-emerald-100' }" %>
          <%= error_message_for(@draft, :html_body, label: t('admin.email_templates.html_source')) %>
        </div>
        <div>
          <%= f.label :text_body, required_field_label(t('admin.email_templates.plain_text')), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
          <%= f.text_area :text_body, rows: 7,
                          data: { action: 'focus->email-template-editor#rememberField' },
                          aria: { invalid: @draft.errors[:text_body].any?, describedby: validation_describedby(@draft, :text_body) },
                          class: "block min-h-32 w-full resize-y rounded-xl border px-4 py-3 font-mono text-xs leading-6 text-slate-800 focus:bg-white focus:ring-2 #{ @draft.errors[:text_body].any? ? 'border-rose-400 bg-rose-50/40 focus:border-rose-500 focus:ring-rose-100' : 'border-slate-300 bg-slate-50/60 focus:border-emerald-500 focus:ring-emerald-100' }" %>
          <%= error_message_for(@draft, :text_body, label: t('admin.email_templates.plain_text')) %>
        </div>
        <div>
          <%= f.label :allowed_variables_csv, t('admin.email_templates.variables'), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
          <%= f.text_field :allowed_variables_csv, autocomplete: 'off', spellcheck: false,
                           data: { email_template_editor_target: 'variables',
                                   action: 'input->email-template-editor#renderDeclaredVariables' },
                           aria: { invalid: @draft.errors[:allowed_variables].any?, describedby: validation_describedby(@draft, :allowed_variables, 'email-template-variables-hint') },
                           class: "min-h-11 w-full rounded-xl border px-4 py-2.5 font-mono text-xs focus:ring-2 #{ @draft.errors[:allowed_variables].any? ? 'border-rose-400 bg-rose-50/40 focus:border-rose-500 focus:ring-rose-100' : 'border-slate-300 focus:border-emerald-500 focus:ring-emerald-100' }" %>
          <div data-email-template-editor-target="variablePills" class="mt-2 flex flex-wrap gap-1.5" aria-live="polite"></div>
          <%= error_message_for(@draft, :allowed_variables, label: t('admin.email_templates.variables')) %>
          <p id="email-template-variables-hint" class="mt-1.5 text-xs leading-5 text-slate-500"><%= t('admin.email_templates.variables_hint') %></p>
          <details class="mt-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2">
            <summary class="cursor-pointer text-xs font-semibold text-emerald-800"><%= t('admin.email_templates.available_variables') %></summary>
            <p class="mt-2 text-xs leading-5 text-slate-600"><%= t('admin.email_templates.editor_shortcuts_hint') %></p>
            <div class="mt-3 flex flex-wrap gap-2">
              <% EmailTemplates::Renderer::KNOWN_VARIABLES.each do |variable| %>
                <button type="button" data-action="click->email-template-editor#insertVariable"
                        data-variable="<%= variable %>" title="<%= t('admin.email_templates.insert_variable') %>"
                        class="min-h-9 rounded-lg border border-slate-200 bg-white px-2.5 font-mono text-[11px] text-slate-700 hover:border-emerald-300 hover:bg-emerald-50 focus-visible:outline-2 focus-visible:outline-emerald-600">
                  <%= "{{#{variable}}}" %>
                </button>
              <% end %>
            </div>
          </details>
        </div>
      </div>
      <footer class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 bg-slate-50/70 px-5 py-4 sm:px-6">
        <span class="text-xs leading-5 text-slate-500"><%= t('admin.email_templates.save_hint') %></span>
        <%= f.submit t('admin.email_templates.save_draft'),
                     data: { turbo_submits_with: t('admin.email_templates.saving_draft') },
                     class: 'min-h-11 cursor-pointer rounded-xl bg-emerald-700 px-5 text-sm font-semibold text-white hover:bg-emerald-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' %>
      </footer>
    </section>

    <aside class="min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm xl:sticky xl:top-6" aria-labelledby="email-preview-title">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-4">
        <div>
          <h2 id="email-preview-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.live_preview') %></h2>
          <p class="mt-1 text-xs text-slate-500"><%= t('admin.email_templates.preview_hint') %></p>
        </div>
        <% if policy(@template).preview? && policy(@template).versions? %>
        <%= link_to t('admin.email_templates.saved_preview'), preview_admin_email_template_path(@template, version_id: @draft.id),
                    class: 'inline-flex min-h-10 items-center rounded-lg border border-emerald-200 bg-emerald-50 px-3 text-xs font-semibold text-emerald-800 hover:bg-emerald-100' %>
        <% end %>
      </div>
      <div class="space-y-4 p-4 sm:p-5">
        <p role="status" aria-live="polite" data-email-template-preview-target="status" class="min-h-5 text-xs text-slate-600"></p>
        <div class="rounded-xl border border-slate-100 bg-slate-50 p-3">
          <p class="text-xs font-semibold text-slate-500"><%= t('admin.email_templates.subject') %></p>
          <p class="mt-1 break-words text-sm font-semibold text-slate-900" data-email-template-preview-target="subject"><%= @draft.subject %></p>
        </div>
        <div class="inline-flex w-full gap-1 rounded-xl bg-slate-100 p-1" aria-label="<%= t('admin.email_templates.device_preview') %>">
          <button type="button" data-action="click->email-template-preview#showDesktop"
                  data-email-template-preview-target="desktopButton"
                  aria-controls="email-template-desktop-panel" aria-pressed="true"
                  class="min-h-10 flex-1 rounded-lg bg-white px-3 text-sm font-semibold text-emerald-800 shadow-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-600"><%= t('admin.email_templates.desktop') %></button>
          <button type="button" data-action="click->email-template-preview#showMobile"
                  data-email-template-preview-target="mobileButton"
                  aria-controls="email-template-mobile-panel" aria-pressed="false"
                  class="min-h-10 flex-1 rounded-lg px-3 text-sm font-semibold text-slate-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-600"><%= t('admin.email_templates.mobile') %></button>
        </div>
        <div id="email-template-desktop-panel" data-email-template-preview-target="desktopPanel" class="rounded-xl border border-slate-200 bg-slate-100 p-2">
          <iframe sandbox="" title="<%= t('admin.email_templates.desktop') %>" class="h-[440px] w-full rounded-lg border border-slate-200 bg-white sm:h-[570px]" data-email-template-preview-target="desktop"></iframe>
        </div>
        <div id="email-template-mobile-panel" data-email-template-preview-target="mobilePanel" class="hidden rounded-xl border border-slate-200 bg-slate-100 p-3 text-center">
          <iframe sandbox="" title="<%= t('admin.email_templates.mobile') %>" class="mx-auto h-[570px] w-full max-w-[375px] rounded-lg border border-slate-200 bg-white" data-email-template-preview-target="mobile"></iframe>
        </div>
        <div class="border-t border-slate-100 pt-4">
          <h3 class="mb-2 text-xs font-bold text-slate-700"><%= t('admin.email_templates.plain_text') %></h3>
          <pre class="max-h-48 overflow-auto whitespace-pre-wrap break-words rounded-xl bg-slate-50 p-3 font-mono text-xs leading-5 text-slate-700" data-email-template-preview-target="plain"><%= @draft.text_body %></pre>
        </div>
      </div>
    </aside>
  <% end %>
</main>
