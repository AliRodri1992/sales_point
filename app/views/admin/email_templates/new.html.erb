<main class="mx-auto max-w-5xl space-y-6 px-4 pb-8 pt-4 sm:px-6 sm:pt-6" data-loading-scope="true">
  <header class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="min-w-0">
      <p class="text-xs font-bold uppercase tracking-widest text-emerald-700"><%= t('admin.email_templates.section') %></p>
      <h1 class="mt-1 font-jakarta text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"><%= t('admin.email_templates.new') %></h1>
      <p class="mt-2 text-sm leading-6 text-slate-500"><%= t('admin.email_templates.new_intro') %></p>
    </div>
    <%= link_to admin_email_templates_path, class: 'inline-flex min-h-11 shrink-0 items-center gap-2 self-start rounded-xl border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 hover:bg-slate-50' do %>
      <%= delta_icon('arrow-left', class: 'size-4') %>
      <%= t('admin.email_templates.back') %>
    <% end %>
  </header>

  <%= form_with model: @template, url: admin_email_templates_path, class: 'overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm' do |f| %>
    <% if @template.errors.any? %>
      <div role="alert" class="m-5 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800">
        <p class="font-bold"><%= t('admin.email_templates.correct_errors') %></p>
        <ul class="mt-2 list-disc space-y-1 pl-5"><% @template.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>
    <div class="border-b border-slate-100 px-5 py-5 sm:px-6">
      <h2 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.identity_title') %></h2>
      <p class="mt-1 text-sm text-slate-500"><%= t('admin.email_templates.identity_hint') %></p>
    </div>
    <div class="grid gap-5 px-5 py-6 sm:grid-cols-2 sm:px-6">
      <div class="sm:col-span-2">
        <%= f.label :name, t('admin.email_templates.columns.name'), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
        <%= f.text_field :name, required: true, maxlength: 150, autocomplete: 'off', aria: { invalid: @template.errors[:name].any? },
                         class: 'min-h-11 w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100' %>
        <%= error_message_for(@template, :name) %>
      </div>
      <div>
        <%= f.label :key, t('admin.email_templates.columns.key'), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
        <%= f.text_field :key, required: true, maxlength: 100, autocomplete: 'off', spellcheck: false,
                         placeholder: t('admin.email_templates.key_example'), aria: { invalid: @template.errors[:key].any? },
                         class: 'min-h-11 w-full rounded-xl border border-slate-300 px-4 py-2.5 font-mono text-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100' %>
        <p class="mt-1.5 text-xs leading-5 text-slate-500"><%= t('admin.email_templates.key_hint') %></p>
        <%= error_message_for(@template, :key) %>
      </div>
      <div>
        <%= f.label :category, t('admin.email_templates.columns.category'), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
        <%= f.text_field :category, required: true, maxlength: 100, autocomplete: 'off',
                         placeholder: t('admin.email_templates.category_example'), aria: { invalid: @template.errors[:category].any? },
                         class: 'min-h-11 w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100' %>
        <%= error_message_for(@template, :category) %>
      </div>
      <div class="sm:col-span-2">
        <%= f.label :locale, t('admin.email_templates.columns.locale'), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
        <div class="relative" data-controller="delta-select" data-searchable="false">
          <%= f.select :locale, %w[es en ko].map { |code| [t("admin.email_templates.languages.#{code}"), code] },
                       {}, required: true, class: 'min-h-11 w-full rounded-xl border border-slate-300 px-3 text-sm' %>
        </div>
        <p class="mt-1.5 text-xs text-slate-500"><%= t('admin.email_templates.locale_hint') %></p>
        <%= error_message_for(@template, :locale) %>
      </div>
      <% if current_user.role?('super_admin') %>
        <div class="sm:col-span-2 rounded-xl border border-emerald-100 bg-emerald-50/70 p-4">
          <label class="flex cursor-pointer items-start gap-3">
            <%= check_box_tag :global, '1', params[:global] == '1', class: 'mt-0.5 size-5 rounded border-emerald-300 text-emerald-700 focus:ring-emerald-500' %>
            <span>
              <span class="block text-sm font-semibold text-slate-800"><%= t('admin.email_templates.global_scope') %></span>
              <span class="mt-1 block text-xs leading-5 text-slate-600"><%= t('admin.email_templates.global_hint') %></span>
            </span>
          </label>
        </div>
      <% end %>
    </div>
    <footer class="flex flex-wrap items-center justify-end gap-3 border-t border-slate-100 bg-slate-50/70 px-5 py-4 sm:px-6">
      <%= link_to t('admin.email_templates.cancel'), admin_email_templates_path,
                  class: 'inline-flex min-h-11 items-center rounded-xl border border-slate-200 bg-white px-5 text-sm font-semibold text-slate-700 hover:bg-slate-100' %>
      <%= f.submit t('admin.email_templates.create_draft'),
                   class: 'min-h-11 cursor-pointer rounded-xl bg-emerald-700 px-5 text-sm font-semibold text-white hover:bg-emerald-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' %>
    </footer>
  <% end %>
</main>
