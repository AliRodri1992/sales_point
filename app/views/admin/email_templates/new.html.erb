<main class="mx-auto max-w-3xl space-y-6 p-6">
  <header><%= link_to t('admin.email_templates.back'), admin_email_templates_path, class: 'text-sm text-emerald-700' %>
    <h1 class="mt-3 font-jakarta text-2xl font-bold"><%= t('admin.email_templates.new') %></h1>
  </header>
  <%= form_with model: @template, url: admin_email_templates_path, class: 'space-y-5 rounded-2xl border border-slate-200 bg-white p-6' do |f| %>
    <% @template.errors.full_messages.each do |error| %><p role="alert" class="text-sm text-rose-700"><%= error %></p><% end %>
    <% { key: :text_field, name: :text_field, category: :text_field }.each do |field, method| %>
      <div><%= f.label field, t("admin.email_templates.columns.#{field}"), class: 'mb-1 block text-sm font-semibold' %>
        <%= f.public_send(method, field, required: true, class: 'w-full rounded-xl border border-slate-300 px-3 py-2' %></div>
    <% end %>
    <div><%= f.label :locale, t('admin.email_templates.columns.locale'), class: 'mb-1 block text-sm font-semibold' %>
      <%= f.select :locale, [['Español', 'es'], ['English', 'en'], ['한국어', 'ko']], {}, class: 'w-full rounded-xl border border-slate-300 px-3 py-2' %></div>
    <% if current_user.role?('super_admin') %>
      <label class="flex items-center gap-3 text-sm"><%= check_box_tag :global, '1', false %> <%= t('admin.email_templates.global') %></label>
    <% end %>
    <%= f.submit t('admin.email_templates.save'), class: 'cursor-pointer rounded-xl bg-emerald-700 px-5 py-3 font-semibold text-white' %>
  <% end %>
</main>
