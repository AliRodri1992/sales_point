<main class="mx-auto max-w-7xl space-y-5 px-4 pb-8 pt-4 sm:px-6 sm:pt-6" data-loading-scope="true">
  <header class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div class="min-w-0">
      <p class="text-xs font-bold uppercase tracking-widest text-emerald-700"><%= t('admin.email_templates.section') %></p>
      <h1 class="mt-1 font-jakarta text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"><%= t('admin.email_templates.title') %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500"><%= t('admin.email_templates.intro') %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <% if policy(EmailBrandingSetting.new(organization: current_organization)).edit? %>
        <%= link_to t('admin.email_templates.branding'), edit_admin_email_branding_settings_path,
                    class: 'inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 transition hover:border-emerald-300 hover:bg-emerald-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' %>
      <% end %>
      <% if policy(EmailSenderSetting.new(organization: current_organization)).edit? %>
        <%= link_to t('admin.email_templates.sender'), edit_admin_email_sender_settings_path,
                    class: 'inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 transition hover:border-emerald-300 hover:bg-emerald-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' %>
      <% end %>
      <% if policy(EmailTemplate).create? %>
        <%= link_to new_admin_email_template_path,
                    class: 'inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-emerald-700 px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' do %>
          <%= delta_icon('plus', class: 'size-4') %>
          <%= t('admin.email_templates.new') %>
        <% end %>
      <% end %>
    </div>
  </header>


  <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5" aria-labelledby="email-template-filter-title">
    <header class="mb-4 flex items-center justify-between gap-3">
      <h2 id="email-template-filter-title" class="flex items-center gap-2 font-jakarta text-sm font-bold text-slate-800">
        <%= delta_icon('funnel', class: 'size-5 text-emerald-700') %><%= t('admin.email_templates.filters_title') %>
      </h2>
      <%= link_to t('admin.email_templates.clear_filters'), admin_email_templates_path,
                  data: { turbo_frame: '_top' }, class: 'text-xs font-semibold text-emerald-800 hover:underline' %>
    </header>
    <%= form_with url: admin_email_templates_path, method: :get,
                  data: { controller: 'email-template-filters', turbo_frame: 'email_templates_list', turbo_action: 'advance',
                          action: 'input->email-template-filters#search change->email-template-filters#change' },
                  class: 'space-y-4' do |f| %>
      <div class="grid items-end gap-3 sm:grid-cols-2 xl:grid-cols-[minmax(15rem,2fr)_repeat(2,minmax(10rem,1fr))]">
        <div class="min-w-0 sm:col-span-2 xl:col-span-1">
          <%= f.label :q, t('admin.email_templates.search_label'), class: 'mb-1.5 block text-xs font-semibold text-slate-600' %>
          <div class="relative">
            <%= delta_icon('magnifying-glass', class: 'pointer-events-none absolute left-3 top-1/2 size-5 -translate-y-1/2 text-slate-400') %>
            <%= f.search_field :q, value: params[:q], maxlength: 150, autocomplete: 'off',
                               placeholder: t('admin.email_templates.search'),
                               class: 'min-h-11 w-full rounded-xl border border-slate-300 bg-white py-2.5 pl-10 pr-3 text-sm text-slate-800 placeholder:text-slate-400 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100' %>
          </div>
        </div>
        <div>
          <%= f.label :locale, t('admin.email_templates.columns.locale'), class: 'mb-1.5 block text-xs font-semibold text-slate-600' %>
          <div data-controller="delta-select" data-searchable="false">
            <%= f.select :locale, [[t('admin.email_templates.all_languages'), ''], *%w[es en ko].map { |code| [t("admin.email_templates.languages.#{code}"), code] }],
                         { selected: params[:locale] }, class: 'min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm' %>
          </div>
        </div>
        <div>
          <%= f.label :status, t('admin.email_templates.columns.state'), class: 'mb-1.5 block text-xs font-semibold text-slate-600' %>
          <div data-controller="delta-select" data-searchable="false">
            <%= f.select :status, [[t('admin.email_templates.all_states'), ''], *EmailTemplate::STATUSES.map { |s| [t("admin.email_templates.states.#{s}"), s] }],
                         { selected: params[:status] }, class: 'min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm' %>
          </div>
        </div>
      </div>
      <details class="group rounded-xl border border-slate-200 bg-slate-50/70" <%= 'open' if %w[category scope origin updated_from updated_to].any? { |key| params[key].present? } %>>
        <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-3 px-4 text-sm font-semibold text-slate-700 focus-visible:outline-2 focus-visible:outline-2 focus-visible:outline-emerald-600">
          <span class="inline-flex items-center gap-2"><%= delta_icon('adjustments-horizontal', class: 'size-4 text-emerald-700') %><%= t('admin.email_templates.advanced_filters') %></span>
          <%= delta_icon('chevron-down', class: 'size-4 transition group-open:rotate-180') %>
        </summary>
        <div class="grid gap-3 border-t border-slate-200 p-4 sm:grid-cols-2 xl:grid-cols-5">
          <div>
            <%= f.label :category, t('admin.email_templates.columns.category'), class: 'mb-1.5 block text-xs font-semibold text-slate-600' %>
            <div data-controller="delta-select" data-searchable="false">
              <%= f.select :category, [[t('admin.email_templates.all_categories'), ''], *@categories.map { |c| [t("admin.email_templates.categories.#{c}", default: c), c] }],
                           { selected: params[:category] }, class: 'min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm' %>
            </div>
          </div>
          <div>
            <%= f.label :scope, t('admin.email_templates.columns.scope'), class: 'mb-1.5 block text-xs font-semibold text-slate-600' %>
            <div data-controller="delta-select" data-searchable="false">
              <%= f.select :scope, [[t('admin.email_templates.all_scopes'), ''],
                                   [t('admin.email_templates.global'), 'global'],
                                   [t('admin.email_templates.organization_scope'), 'organization']],
                           { selected: params[:scope] }, class: 'min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm' %>
            </div>
          </div>
          <div>
            <%= f.label :origin, t('admin.email_templates.origin_label'), class: 'mb-1.5 block text-xs font-semibold text-slate-600' %>
            <div data-controller="delta-select" data-searchable="false">
              <%= f.select :origin, [[t('admin.email_templates.all_origins'), ''],
                                     *%w[system customized organization].map { |kind| [t("admin.email_templates.origins.#{kind}"), kind] }],
                           { selected: params[:origin] }, class: 'min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm' %>
            </div>
          </div>
          <div>
            <%= f.label :updated_from, t('admin.email_templates.updated_from'), class: 'mb-1.5 block text-xs font-semibold text-slate-600' %>
            <%= f.date_field :updated_from, value: params[:updated_from], class: 'min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm' %>
          </div>
          <div>
            <%= f.label :updated_to, t('admin.email_templates.updated_to'), class: 'mb-1.5 block text-xs font-semibold text-slate-600' %>
            <%= f.date_field :updated_to, value: params[:updated_to], class: 'min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm' %>
          </div>
        </div>
      </details>
      <%= hidden_field_tag :per_page, params[:per_page] if params[:per_page].present? %>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="text-xs text-slate-500"><%= t('admin.email_templates.search_automatic_hint') %></p>
        <%= f.submit t('admin.email_templates.filter'), class: 'min-h-10 cursor-pointer rounded-xl border border-slate-200 px-4 text-xs font-semibold text-emerald-800 hover:bg-emerald-50' %>
      </div>
    <% end %>
  </section>

  <div class="delta-skeleton-region" data-controller="skeleton-loading"
       data-skeleton-loading-region-value="email_templates_list" aria-busy="false"
       data-action="skeleton:begin@document->skeleton-loading#begin skeleton:end@document->skeleton-loading#finish turbo:before-fetch-request@document->skeleton-loading#turboStart turbo:frame-load@document->skeleton-loading#turboFinish turbo:fetch-request-error@document->skeleton-loading#turboError turbo:frame-missing@document->skeleton-loading#turboMissing turbo:before-cache@document->skeleton-loading#clear">
    <span class="sr-only" role="status" aria-live="polite" hidden data-skeleton-loading-target="status"><%= t('admin.action_loader.processing') %></span>
    <div class="delta-skeleton-region__progress" data-skeleton-loading-target="indicator" hidden aria-hidden="true"><span></span></div>
    <div data-skeleton-loading-target="content">
      <%= turbo_frame_tag 'email_templates_list', data: { turbo_action: 'advance' } do %>
        <%= render 'list' %>
      <% end %>
    </div>
    <div data-skeleton-loading-target="placeholder" hidden><%= render Ui::SkeletonComponent.new(variant: :table, rows: 6, columns: 8) %></div>
    <div data-skeleton-loading-target="error" hidden role="alert" class="mt-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
      <span><%= t('admin.skeleton_loading.failed') %></span>
      <button type="button" data-action="skeleton-loading#retry" class="ml-2 font-semibold underline"><%= t('admin.skeleton_loading.retry') %></button>
    </div>
  </div>
</main>
