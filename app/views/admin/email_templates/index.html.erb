<main class="mx-auto max-w-7xl space-y-5 px-4 pb-8 pt-4 sm:px-6 sm:pt-6" data-loading-scope="true">
  <header class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div class="min-w-0">
      <p class="text-xs font-bold uppercase tracking-widest text-emerald-700"><%= t('admin.email_templates.section') %></p>
      <h1 class="mt-1 font-jakarta text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"><%= t('admin.email_templates.title') %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500"><%= t('admin.email_templates.intro') %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <% if current_user.permission?('email_branding.manage') %>
        <%= link_to t('admin.email_templates.branding'), edit_admin_email_branding_settings_path,
                    class: 'inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 transition hover:border-emerald-300 hover:bg-emerald-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' %>
      <% end %>
      <% if current_user.permission?('email_settings.manage') %>
        <%= link_to t('admin.email_templates.sender'), edit_admin_email_sender_settings_path,
                    class: 'inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 transition hover:border-emerald-300 hover:bg-emerald-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' %>
      <% end %>
      <% if policy(EmailTemplate).create? %>
        <%= link_to new_admin_email_template_path,
                    class: 'inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-emerald-700 px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' do %>
          <%= delta_icon('plus', class: 'size-4') %>
          <%= t('admin.email_templates.new') %>
        <% end %>
      <% end %>
    </div>
  </header>

  <section class="rounded-2xl border border-slate-200 bg-white shadow-sm" aria-label="<%= t('admin.email_templates.filters_title') %>">
    <%= form_with url: admin_email_templates_path, method: :get, class: 'grid grid-cols-1 items-end gap-3 p-4 sm:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_180px_180px_auto] lg:p-5' do |f| %>
      <div class="min-w-0 sm:col-span-2 lg:col-span-1">
        <%= f.label :q, t('admin.email_templates.search_label'), class: 'mb-1.5 block text-xs font-semibold text-slate-600' %>
        <div class="relative">
          <%= delta_icon('magnifying-glass', class: 'pointer-events-none absolute left-3 top-1/2 size-5 -translate-y-1/2 text-slate-400') %>
          <%= f.search_field :q, value: params[:q], maxlength: 150, autocomplete: 'off',
                             placeholder: t('admin.email_templates.search'),
                             class: 'min-h-11 w-full rounded-xl border border-slate-300 bg-white py-2.5 pl-11 pr-3 text-sm text-slate-800 placeholder:text-slate-400 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100' %>
        </div>
      </div>
      <div class="min-w-0">
        <%= f.label :locale, t('admin.email_templates.columns.locale'), class: 'mb-1.5 block text-xs font-semibold text-slate-600' %>
        <div class="relative" data-controller="delta-select" data-searchable="false">
          <%= f.select :locale, [[t('admin.email_templates.all_languages'), ''], *%w[es en ko].map { |code| [t("admin.email_templates.languages.#{code}"), code] }],
                       { selected: params[:locale] }, class: 'min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-800' %>
        </div>
      </div>
      <div class="min-w-0">
        <%= f.label :status, t('admin.email_templates.columns.state'), class: 'mb-1.5 block text-xs font-semibold text-slate-600' %>
        <div class="relative" data-controller="delta-select" data-searchable="false">
          <%= f.select :status, [[t('admin.email_templates.all_states'), ''], *EmailTemplate::STATUSES.map { |state| [t("admin.email_templates.states.#{state}"), state] }],
                       { selected: params[:status] }, class: 'min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-800' %>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <%= f.submit t('admin.email_templates.filter'),
                     class: 'min-h-11 flex-1 cursor-pointer rounded-xl bg-slate-900 px-5 text-sm font-semibold text-white transition hover:bg-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 lg:flex-none' %>
        <% if params[:q].present? || params[:locale].present? || params[:status].present? %>
          <%= link_to t('admin.email_templates.clear_filters'), admin_email_templates_path,
                      class: 'inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-200 px-3 text-sm font-semibold text-slate-600 hover:bg-slate-50' %>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="email-templates-list-title">
    <div class="flex flex-col gap-3 border-b border-slate-100 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-5">
      <div>
        <h2 id="email-templates-list-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.list_title') %></h2>
        <p class="mt-1 text-xs text-slate-500"><%= t('admin.email_templates.result_count', count: @total) %></p>
      </div>
      <nav class="flex flex-wrap items-center gap-1.5" aria-label="<%= t('admin.email_templates.status_summary') %>">
        <% %w[published draft inactive archived].each do |state| %>
          <% selected = params[:status] == state %>
          <%= link_to admin_email_templates_path(q: params[:q], locale: params[:locale], status: selected ? nil : state),
                      class: "inline-flex min-h-9 items-center gap-2 rounded-lg border px-3 py-1.5 text-xs font-semibold transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 #{selected ? 'border-emerald-300 bg-emerald-50 text-emerald-800' : 'border-slate-200 bg-white text-slate-600 hover:bg-slate-50'}" do %>
            <%= t("admin.email_templates.states.#{state}") %>
            <span class="tabular-nums <%= selected ? 'text-emerald-800' : 'text-slate-500' %>"><%= @counts.fetch(state, 0) %></span>
          <% end %>
        <% end %>
      </nav>
    </div>

    <% if @templates.any? %>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[810px] text-left text-sm">
          <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-600">
            <tr>
              <% %w[name key locale scope state version updated actions].each do |column| %>
                <th scope="col" class="px-4 py-3.5 first:pl-5 last:pr-5"><%= t("admin.email_templates.columns.#{column}") %></th>
              <% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @templates.each do |template| %>
              <% tone = { 'published' => 'bg-emerald-50 text-emerald-800 ring-emerald-200',
                          'draft' => 'bg-amber-50 text-amber-800 ring-amber-200',
                          'inactive' => 'bg-slate-100 text-slate-700 ring-slate-200',
                          'archived' => 'bg-rose-50 text-rose-700 ring-rose-200' }.fetch(template.status, 'bg-slate-100 text-slate-700 ring-slate-200') %>
              <tr class="transition hover:bg-slate-50/80">
                <td class="max-w-64 px-4 py-4 pl-5">
                  <%= link_to template.name, admin_email_template_path(template),
                              class: 'block break-words font-semibold text-slate-900 hover:text-emerald-700 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-600' %>
                  <span class="mt-1 block text-xs text-slate-500"><%= template.category %></span>
                </td>
                <td class="max-w-44 break-all px-4 py-4 font-mono text-xs text-slate-600"><%= template.key %></td>
                <td class="px-4 py-4"><%= t("admin.email_templates.languages.#{template.locale}") %></td>
                <td class="px-4 py-4 text-slate-600"><%= template.organization&.name || t('admin.email_templates.global') %></td>
                <td class="px-4 py-4">
                  <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset <%= tone %>"><%= t("admin.email_templates.status_labels.#{template.status}") %></span>
                </td>
                <td class="px-4 py-4 font-medium tabular-nums text-slate-700"><%= template.published_version&.version_number ? "v#{template.published_version.version_number}" : '—' %></td>
                <td class="whitespace-nowrap px-4 py-4 text-xs text-slate-500"><%= l(template.updated_at, format: :short) %></td>
                <td class="px-4 py-4 pr-5">
                  <%= link_to t('admin.email_templates.view'), admin_email_template_path(template),
                              class: 'inline-flex min-h-10 items-center rounded-lg px-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-50 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-600',
                              aria: { label: t('admin.email_templates.view_named', name: template.name) } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="flex flex-col items-center px-5 py-12 text-center">
        <span class="mb-4 inline-flex size-12 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-700"><%= delta_icon('document-text', class: 'size-6') %></span>
        <h3 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.empty_title') %></h3>
        <p class="mt-2 max-w-md text-sm leading-6 text-slate-500"><%= t('admin.email_templates.empty') %></p>
        <% if params[:q].present? || params[:locale].present? || params[:status].present? %>
          <%= link_to t('admin.email_templates.clear_filters'), admin_email_templates_path,
                      class: 'mt-4 inline-flex min-h-11 items-center rounded-xl border border-emerald-200 px-4 text-sm font-semibold text-emerald-700 hover:bg-emerald-50' %>
        <% elsif policy(EmailTemplate).create? %>
          <%= link_to t('admin.email_templates.new'), new_admin_email_template_path,
                      class: 'mt-4 inline-flex min-h-11 items-center rounded-xl bg-emerald-700 px-4 text-sm font-semibold text-white hover:bg-emerald-800' %>
        <% end %>
      </div>
    <% end %>
  </section>

  <% if @total_pages > 1 %>
    <nav class="flex flex-wrap items-center justify-between gap-3 text-sm text-slate-600" aria-label="<%= t('admin.email_templates.pagination_label') %>">
      <span><%= t('admin.email_templates.page_status', page: @page, pages: @total_pages) %></span>
      <div class="flex gap-2">
        <% if @page > 1 %>
          <%= link_to t('admin.email_templates.previous'),
                      admin_email_templates_path(page: @page - 1, q: params[:q], locale: params[:locale], status: params[:status]),
                      class: 'inline-flex min-h-10 items-center rounded-lg border border-slate-200 bg-white px-4 font-semibold hover:bg-slate-50' %>
        <% end %>
        <% if @page < @total_pages %>
          <%= link_to t('admin.email_templates.next'),
                      admin_email_templates_path(page: @page + 1, q: params[:q], locale: params[:locale], status: params[:status]),
                      class: 'inline-flex min-h-10 items-center rounded-lg border border-slate-200 bg-white px-4 font-semibold hover:bg-slate-50' %>
        <% end %>
      </div>
    </nav>
  <% end %>
</main>
