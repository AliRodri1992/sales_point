<main class="mx-auto max-w-7xl space-y-5 px-4 pb-8 pt-4 sm:px-6 sm:pt-6" data-loading-scope="true">
  <header>
    <%= link_to admin_email_template_path(@template), class: 'inline-flex items-center gap-2 text-sm font-semibold text-emerald-700 hover:underline' do %>
      <%= delta_icon('arrow-left', class: 'size-4') %>
      <%= t('admin.email_templates.back') %>
    <% end %>
    <h1 class="mt-3 font-jakarta text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"><%= t('admin.email_templates.compare') %></h1>
    <p class="mt-2 text-sm text-slate-500"><%= t('admin.email_templates.compare_hint') %></p>
  </header>
  <div class="grid min-w-0 items-start gap-5 lg:grid-cols-2">
    <% [@left, @right].each do |version| %>
      <section class="min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <header class="border-b border-slate-100 px-5 py-4">
          <h2 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.preview_version', version: version.version_number) %></h2>
          <span class="mt-1 inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700"><%= t("admin.email_templates.status_labels.#{version.status}") %></span>
        </header>
        <div class="min-w-0 space-y-5 p-5">
          <div>
            <h3 class="text-xs font-semibold text-slate-500"><%= t('admin.email_templates.subject') %></h3>
            <p class="mt-1 break-words text-sm font-semibold text-slate-900"><%= version.subject %></p>
          </div>
          <% if version.preheader.present? %>
            <div>
              <h3 class="text-xs font-semibold text-slate-500"><%= t('admin.email_templates.preheader') %></h3>
              <p class="mt-1 break-words text-sm text-slate-700"><%= version.preheader %></p>
            </div>
          <% end %>
          <div>
            <h3 class="mb-2 text-xs font-semibold text-slate-600"><%= t('admin.email_templates.html_source') %></h3>
            <pre class="max-h-96 overflow-auto whitespace-pre-wrap break-all rounded-xl bg-slate-50 p-4 font-mono text-xs leading-5 text-slate-700"><%= version.html_body %></pre>
          </div>
          <div>
            <h3 class="mb-2 text-xs font-semibold text-slate-600"><%= t('admin.email_templates.plain_text') %></h3>
            <pre class="max-h-72 overflow-auto whitespace-pre-wrap break-words rounded-xl bg-slate-50 p-4 font-mono text-xs leading-5 text-slate-700"><%= version.text_body %></pre>
          </div>
        </div>
      </section>
    <% end %>
  </div>
</main>
