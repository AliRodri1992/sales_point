<main class="mx-auto max-w-6xl space-y-6 p-6">
  <%= link_to t('admin.email_templates.back'), admin_email_template_path(@template), class: 'font-semibold text-emerald-700' %>
  <h1 class="font-jakarta text-2xl font-bold"><%= t('admin.email_templates.compare') %></h1>
  <div class="grid gap-5 lg:grid-cols-2">
    <% [@left, @right].each do |version| %>
      <section class="min-w-0 space-y-3 rounded-2xl border border-slate-200 bg-white p-5">
        <h2 class="font-semibold"><%= t('admin.email_templates.versions') %> · v<%= version.version_number %></h2>
        <dl class="text-sm"><dt class="text-slate-500"><%= t('admin.email_templates.subject') %></dt>
          <dd class="font-semibold"><%= version.subject %></dd></dl>
        <h3 class="text-sm font-semibold">HTML</h3>
        <pre class="max-h-96 overflow-auto whitespace-pre-wrap break-all rounded-xl bg-slate-50 p-4 text-xs"><%= version.html_body %></pre>
        <h3 class="text-sm font-semibold"><%= t('admin.email_templates.plain_text') %></h3>
        <pre class="overflow-auto whitespace-pre-wrap rounded-xl bg-slate-50 p-4 text-xs"><%= version.text_body %></pre>
      </section>
    <% end %>
  </div>
</main>
