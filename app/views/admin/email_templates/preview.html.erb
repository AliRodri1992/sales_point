<main class="mx-auto max-w-5xl space-y-5 p-6">
  <%= link_to t('admin.email_templates.back'), admin_email_template_path(@template), class: 'font-semibold text-emerald-700' %>
  <h1 class="font-jakarta text-2xl font-bold"><%= t('admin.email_templates.preview') %></h1>
  <p class="text-sm text-slate-500"><%= @subject %></p>
  <div class="grid gap-6 lg:grid-cols-2">
    <section class="rounded-2xl border border-slate-200 bg-white p-4">
      <h2 class="mb-3 font-semibold"><%= t('admin.email_templates.desktop') %></h2>
      <iframe sandbox="" title="<%= t('admin.email_templates.preview') %>" srcdoc="<%= @html %>" class="h-[650px] w-full border border-slate-100"></iframe>
    </section>
    <section class="rounded-2xl border border-slate-200 bg-white p-4">
      <h2 class="mb-3 font-semibold"><%= t('admin.email_templates.mobile') %></h2>
      <iframe sandbox="" title="<%= t('admin.email_templates.mobile') %>" srcdoc="<%= @html %>" class="mx-auto h-[650px] w-full max-w-[360px] border border-slate-100"></iframe>
    </section>
  </div>
  <h2 class="font-semibold"><%= t('admin.email_templates.plain_text') %></h2>
  <pre class="whitespace-pre-wrap rounded-xl bg-slate-100 p-4 text-sm"><%= @plain %></pre>
</main>
