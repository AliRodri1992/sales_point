<main class="mx-auto max-w-7xl space-y-5 px-4 pb-8 pt-4 sm:px-6 sm:pt-6" data-loading-scope="true">
  <header class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="min-w-0">
      <%= link_to admin_email_template_path(@template), class: 'inline-flex items-center gap-2 text-sm font-semibold text-emerald-700 hover:underline' do %>
        <%= delta_icon('arrow-left', class: 'size-4') %>
        <%= t('admin.email_templates.back') %>
      <% end %>
      <h1 class="mt-3 font-jakarta text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"><%= t('admin.email_templates.preview') %></h1>
      <p class="mt-2 break-words text-sm text-slate-500"><%= @subject %></p>
    </div>
    <span class="self-start rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600"><%= t('admin.email_templates.preview_version', version: @version.version_number) %></span>
  </header>
  <div class="grid min-w-0 items-start gap-5 lg:grid-cols-[minmax(0,1.6fr)_minmax(300px,1fr)]">
    <section class="min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5" aria-labelledby="preview-desktop-title">
      <h2 id="preview-desktop-title" class="mb-3 font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.desktop') %></h2>
      <div class="rounded-xl border border-slate-200 bg-slate-100 p-2">
        <iframe sandbox="" title="<%= t('admin.email_templates.desktop') %>" srcdoc="<%= @html %>" class="h-[560px] w-full rounded-lg border border-slate-200 bg-white sm:h-[690px]"></iframe>
      </div>
    </section>
    <section class="min-w-0 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5" aria-labelledby="preview-mobile-title">
      <h2 id="preview-mobile-title" class="mb-3 font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.mobile') %></h2>
      <div class="rounded-xl border border-slate-200 bg-slate-100 p-3 text-center">
        <iframe sandbox="" title="<%= t('admin.email_templates.mobile') %>" srcdoc="<%= @html %>" class="mx-auto h-[560px] w-full max-w-[375px] rounded-lg border border-slate-200 bg-white sm:h-[690px]"></iframe>
      </div>
    </section>
  </div>
  <section class="min-w-0 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.plain_text') %></h2>
    <pre class="mt-3 max-h-80 overflow-auto whitespace-pre-wrap break-words rounded-xl bg-slate-50 p-4 font-mono text-xs leading-6 text-slate-700"><%= @plain %></pre>
  </section>
</main>
