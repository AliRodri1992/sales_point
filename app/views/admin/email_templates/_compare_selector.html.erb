<%= form_with url: compare_admin_email_template_path(@template), method: :get,
              data: { turbo_frame: '_top' },
              class: 'grid w-full items-end gap-3 sm:grid-cols-[minmax(9rem,1fr)_minmax(9rem,1fr)_auto]' do |f| %>
  <% choices = @versions.map do |version|
       [t('admin.email_templates.preview_version', version: version.version_number), version.id]
     end %>
  <div class="min-w-0">
    <%= f.label :left, t('admin.email_templates.compare_left'), class: 'mb-1.5 block text-xs font-semibold text-slate-700' %>
    <div data-controller="delta-select" data-searchable="false">
      <%= f.select :left, choices, { selected: local_assigns.fetch(:left_id) },
                   class: 'min-h-10 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm' %>
    </div>
  </div>
  <div class="min-w-0">
    <%= f.label :right, t('admin.email_templates.compare_right'), class: 'mb-1.5 block text-xs font-semibold text-slate-700' %>
    <div data-controller="delta-select" data-searchable="false">
      <%= f.select :right, choices, { selected: local_assigns.fetch(:right_id) },
                   class: 'min-h-10 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm' %>
    </div>
  </div>
  <%= f.submit t('admin.email_templates.compare'),
               class: 'min-h-10 cursor-pointer rounded-xl bg-emerald-700 px-4 text-xs font-semibold text-white hover:bg-emerald-800' %>
<% end %>
