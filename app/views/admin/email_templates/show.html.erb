<main class="mx-auto max-w-7xl space-y-5 px-4 pb-8 pt-4 sm:px-6 sm:pt-6" data-loading-scope="true">
  <header class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="min-w-0">
      <%= link_to admin_email_templates_path, class: 'inline-flex items-center gap-2 text-sm font-semibold text-emerald-700 hover:underline' do %>
        <%= delta_icon('arrow-left', class: 'size-4') %>
        <%= t('admin.email_templates.back') %>
      <% end %>
      <p class="mt-3 text-xs font-bold uppercase tracking-widest text-emerald-700"><%= t('admin.email_templates.section') %></p>
      <h1 class="mt-1 break-words font-jakarta text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"><%= @template.name %></h1>
      <p class="mt-2 break-all font-mono text-xs text-slate-500"><%= @template.key %> · <%= t("admin.email_templates.languages.#{@template.locale}") %> · <%= @template.organization&.name || t('admin.email_templates.global') %></p>
      <span class="mt-3 inline-flex rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-700"><%= t("admin.email_templates.status_labels.#{@template.status}") %></span>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <% if policy(@template).update? %>
        <%= link_to t('admin.email_templates.edit'), edit_admin_email_template_path(@template),
                    class: 'inline-flex min-h-11 items-center rounded-xl bg-emerald-700 px-4 text-sm font-semibold text-white hover:bg-emerald-800' %>
      <% end %>
      <% if policy(@template).preview? && @template.published_version.present? %>
        <%= link_to t('admin.email_templates.preview'), preview_admin_email_template_path(@template),
                    class: 'inline-flex min-h-11 items-center rounded-xl border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 hover:bg-slate-50' %>
      <% end %>
      <% if policy(@template).archive? && @template.status != 'archived' %>
        <%= button_to t('admin.email_templates.archive'), archive_admin_email_template_path(@template), method: :patch,
                      data: { turbo_confirm: t('admin.email_templates.confirm_archive') },
                      class: 'min-h-11 rounded-xl border border-rose-200 bg-white px-4 text-sm font-semibold text-rose-700 hover:bg-rose-50' %>
      <% end %>
    </div>
  </header>

  <div class="grid min-w-0 items-start gap-5 lg:grid-cols-[minmax(0,1.5fr)_minmax(300px,1fr)]">
    <% if policy(@template).versions? %>
    <section class="min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="email-template-versions-title">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 px-5 py-4">
        <div>
          <h2 id="email-template-versions-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.versions') %></h2>
          <p class="mt-1 text-xs text-slate-500"><%= t('admin.email_templates.versions_hint') %></p>
        </div>
        <% if @versions.size >= 2 && policy(@template).versions? %>
          <%= link_to t('admin.email_templates.compare'),
                      compare_admin_email_template_path(@template, left: @versions[1].id, right: @versions[0].id),
                      class: 'inline-flex min-h-10 items-center rounded-lg border border-emerald-200 px-3 text-xs font-semibold text-emerald-800 hover:bg-emerald-50' %>
        <% end %>
      </div>
      <% if @versions.any? %>
        <ol class="divide-y divide-slate-100 px-5">
          <% @versions.each do |version| %>
            <li class="flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:justify-between">
              <div class="min-w-0">
                <p class="font-semibold tabular-nums text-slate-900">v<%= version.version_number %></p>
                <p class="mt-1 text-xs text-slate-500"><%= t("admin.email_templates.status_labels.#{version.status}") %><% if version.published_at %> · <%= l(version.published_at, format: :short) %><% end %></p>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <% if policy(@template).preview? %>
                  <%= link_to t('admin.email_templates.preview'), preview_admin_email_template_path(@template, version_id: version.id),
                              class: 'inline-flex min-h-10 items-center rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-700 hover:bg-slate-50' %>
                <% end %>
                <% if version.status == 'draft' && policy(@template).publish? %>
                  <%= button_to t('admin.email_templates.publish'), publish_admin_email_template_path(@template, version_id: version.id),
                                data: { turbo_confirm: t('admin.email_templates.confirm_publish') },
                                class: 'min-h-10 rounded-lg bg-emerald-700 px-3 text-xs font-semibold text-white hover:bg-emerald-800' %>
                <% elsif version.status == 'published' && policy(@template).versions? && policy(@template).update? %>
                  <%= button_to t('admin.email_templates.restore'), restore_admin_email_template_path(@template, version_id: version.id),
                                data: { turbo_confirm: t('admin.email_templates.confirm_restore') },
                                class: 'min-h-10 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-700 hover:bg-slate-50' %>
                <% end %>
              </div>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="px-5 py-8 text-sm text-slate-500"><%= t('admin.email_templates.no_versions') %></p>
      <% end %>
    </section>
    <% end %>

    <% if policy(@template).send_test? %>
    <section class="min-w-0 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm" aria-labelledby="email-test-title">
      <h2 id="email-test-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.send_test') %></h2>
      <% if @template.published_version.present? %>
        <p class="mt-2 text-sm leading-6 text-slate-500"><%= t('admin.email_templates.send_test_hint') %></p>
        <%= form_with url: send_test_admin_email_template_path(@template), method: :post, class: 'mt-4 space-y-3' do |f| %>
          <%= f.label :email, t('admin.email_templates.test_recipient'), class: 'block text-sm font-semibold text-slate-700' %>
          <%= f.email_field :email, required: true, maxlength: 254, autocomplete: 'email',
                            value: (current_user.email unless current_user.role?('super_admin')),
                            readonly: !current_user.role?('super_admin'), placeholder: t('admin.email_templates.recipient_placeholder'),
                            class: 'min-h-11 w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100' %>
          <% unless current_user.role?('super_admin') %>
            <p class="text-xs leading-5 text-slate-500"><%= t('admin.email_templates.test_self_only') %></p>
          <% end %>
          <%= f.submit t('admin.email_templates.send_test'),
                       class: 'min-h-11 w-full cursor-pointer rounded-xl bg-emerald-700 px-4 text-sm font-semibold text-white hover:bg-emerald-800' %>
        <% end %>
      <% else %>
        <p class="mt-3 text-sm leading-6 text-slate-500"><%= t('admin.email_templates.test_unavailable') %></p>
      <% end %>
    </section>
    <% end %>
  </div>

  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="email-audit-title">
    <div class="border-b border-slate-100 px-5 py-4">
      <h2 id="email-audit-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.audit') %></h2>
    </div>
    <% if @audits.any? %>
      <ol class="divide-y divide-slate-100 px-5">
        <% @audits.each do |audit| %>
          <li class="flex flex-wrap items-center justify-between gap-2 py-3 text-sm">
            <span class="font-semibold text-slate-700"><%= t("admin.email_templates.audit_actions.#{audit.action}", default: audit.action.humanize) %></span>
            <span class="text-xs text-slate-500"><%= audit.actor&.display_name || t('admin.email_templates.unknown_actor') %> · <%= l(audit.created_at, format: :short) %></span>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="px-5 py-7 text-sm text-slate-500"><%= t('admin.email_templates.no_audits') %></p>
    <% end %>
  </section>
</main>
