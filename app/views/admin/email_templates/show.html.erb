<main class="mx-auto max-w-6xl space-y-6 p-6">
  <header class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <%= link_to t('admin.email_templates.back'), admin_email_templates_path, class: 'text-sm font-semibold text-emerald-700' %>
      <h1 class="mt-2 font-jakarta text-2xl font-bold"><%= @template.name %></h1>
      <p class="mt-1 font-mono text-xs text-slate-500"><%= @template.key %> · <%= @template.locale %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if policy(@template).update? %>
        <%= link_to t('admin.email_templates.edit'), edit_admin_email_template_path(@template), class: 'rounded-xl bg-emerald-700 px-4 py-2 text-sm font-semibold text-white' %>
      <% end %>
      <% if policy(@template).preview? && @template.published_version %>
        <%= link_to t('admin.email_templates.preview'), preview_admin_email_template_path(@template), class: 'rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold' %>
      <% end %>
    </div>
  </header>
  <section class="grid gap-5 lg:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
      <h2 class="font-bold"><%= t('admin.email_templates.versions') %></h2>
      <% if @versions.size >= 2 && policy(@template).versions? %>
        <%= link_to t('admin.email_templates.compare'),
                    compare_admin_email_template_path(@template, left: @versions[1].id, right: @versions[0].id),
                    class: 'mt-3 inline-block text-sm font-semibold text-emerald-700' %>
      <% end %>
      <ol class="mt-4 divide-y divide-slate-100">
        <% @versions.each do |version| %>
          <li class="flex flex-wrap items-center justify-between gap-2 py-3 text-sm">
            <span>v<%= version.version_number %> · <%= t("admin.email_templates.states.#{version.status}") %></span>
            <div class="flex gap-2">
              <% if version.status == 'draft' && policy(@template).publish? %>
                <%= button_to t('admin.email_templates.publish'), publish_admin_email_template_path(@template, version_id: version.id), data: { turbo_confirm: t('admin.email_templates.confirm_publish') }, class: 'font-semibold text-emerald-700' %>
              <% elsif version.status == 'published' && policy(@template).versions? %>
                <%= button_to t('admin.email_templates.restore'), restore_admin_email_template_path(@template, version_id: version.id), class: 'font-semibold text-slate-700' %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ol>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
      <h2 class="font-bold"><%= t('admin.email_templates.send_test') %></h2>
      <% if policy(@template).send_test? %>
        <%= form_with url: send_test_admin_email_template_path(@template), method: :post, class: 'mt-4 flex flex-col gap-3' do |f| %>
          <%= f.label :email, t('admin.email_templates.test_recipient'), class: 'text-sm font-semibold' %>
          <%= f.email_field :email, required: true, class: 'rounded-xl border border-slate-300 px-3 py-2' %>
          <%= f.submit t('admin.email_templates.send_test'), class: 'cursor-pointer rounded-xl bg-emerald-700 px-4 py-3 text-sm font-semibold text-white' %>
        <% end %>
      <% end %>
    </div>
  </section>
  <section class="rounded-2xl border border-slate-200 bg-white p-5">
    <h2 class="font-bold"><%= t('admin.email_templates.audit') %></h2>
    <ol class="mt-3 divide-y divide-slate-100">
      <% @audits.each do |audit| %>
        <li class="py-2 text-sm"><%= audit.action %> · <%= audit.actor&.display_name || '—' %> · <%= l(audit.created_at, format: :short) %></li>
      <% end %>
    </ol>
  </section>
</main>
