<main class="mx-auto max-w-[1560px] space-y-6 px-4 pb-10 pt-4 sm:px-6 sm:pt-6" data-loading-scope="true">
  <% can_preview = policy(@template).preview? %>
  <% current_version = @template.published_version %>
  <% test_available = @template.status == 'published' && @template.enabled? && current_version.present? %>
  <% status_tone = { 'published' => 'border-emerald-200 bg-emerald-50 text-emerald-800',
                     'draft' => 'border-amber-200 bg-amber-50 text-amber-800',
                     'inactive' => 'border-slate-200 bg-slate-100 text-slate-700',
                     'archived' => 'border-rose-200 bg-rose-50 text-rose-800' }.fetch(@template.status) %>

  <header class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
    <div class="min-w-0">
      <p class="mt-2 text-xs font-bold uppercase tracking-[.16em] text-emerald-700"><%= t('admin.email_templates.section') %></p>
      <h1 class="mt-1 break-words font-jakarta text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"><%= @template.name %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600"><%= t('admin.email_templates.detail_intro') %></p>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-bold <%= status_tone %>">
          <%= t("admin.email_templates.status_labels.#{@template.status}") %>
        </span>
        <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-700">
          <%= t("admin.email_templates.languages.#{@template.locale}") %>
        </span>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-2 lg:justify-end">
      <%= link_to admin_email_templates_path, data: { turbo_frame: '_top' },
                  class: 'inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' do %>
        <%= delta_icon('arrow-left', class: 'size-4') %>
        <%= t('admin.email_templates.back') %>
      <% end %>
      <% if can_preview && current_version %>
        <%= link_to preview_admin_email_template_path(@template),
                    class: 'inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-emerald-200 bg-white px-4 text-sm font-semibold text-emerald-800 shadow-sm hover:bg-emerald-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' do %>
          <%= delta_icon('eye', class: 'size-4') %>
          <%= t('admin.email_templates.preview') %>
        <% end %>
      <% end %>
      <% if policy(@template).update? %>
        <%= link_to edit_admin_email_template_path(@template),
                    class: 'inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-emerald-700 px-4 text-sm font-semibold text-white shadow-sm hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' do %>
          <%= delta_icon('pencil-square', class: 'size-4') %>
          <%= t('admin.email_templates.edit') %>
        <% end %>
      <% end %>
    </div>
  </header>

  <section class="min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="email-template-overview-title">
    <header class="flex items-center gap-3 border-b border-slate-100 px-5 py-4 sm:px-6">
      <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
        <%= delta_icon('document-text', class: 'size-5') %>
      </span>
      <div class="min-w-0">
        <h2 id="email-template-overview-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.detail_overview_title') %></h2>
        <p class="mt-0.5 text-xs leading-5 text-slate-500"><%= t('admin.email_templates.detail_overview_hint') %></p>
      </div>
    </header>
    <dl class="grid gap-x-6 gap-y-5 p-5 sm:grid-cols-2 sm:p-6 xl:grid-cols-4">
      <div class="min-w-0">
        <dt class="text-xs font-semibold text-slate-500"><%= t('admin.email_templates.columns.key') %></dt>
        <dd class="mt-1 break-all font-mono text-sm font-medium text-slate-900"><%= @template.key %></dd>
      </div>
      <div class="min-w-0">
        <dt class="text-xs font-semibold text-slate-500"><%= t('admin.email_templates.columns.category') %></dt>
        <dd class="mt-1 break-words text-sm font-semibold text-slate-900"><%= t("admin.email_templates.categories.#{@template.category}", default: @template.category) %></dd>
      </div>
      <div class="min-w-0">
        <dt class="text-xs font-semibold text-slate-500"><%= t('admin.email_templates.columns.scope') %></dt>
        <dd class="mt-1 break-words text-sm font-semibold text-slate-900"><%= @template.organization&.name || t('admin.email_templates.global') %></dd>
      </div>
      <div class="min-w-0">
        <dt class="text-xs font-semibold text-slate-500"><%= t('admin.email_templates.columns.updated') %></dt>
        <dd class="mt-1 text-sm font-semibold text-slate-900"><%= l(@template.updated_at, format: :short) %></dd>
      </div>
    </dl>
    <div class="flex flex-col gap-1 border-t border-slate-100 bg-slate-50/70 px-5 py-3 sm:flex-row sm:items-center sm:gap-3 sm:px-6">
      <span class="shrink-0 text-xs font-bold text-slate-600"><%= t('admin.email_templates.detail_subject_label') %></span>
      <p class="min-w-0 break-words text-sm font-semibold text-slate-900"><%= current_version&.subject || @template.subject %></p>
    </div>
  </section>

  <div class="min-w-0 space-y-5">
    <section class="min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="email-template-content-title">
        <header class="flex flex-col gap-3 border-b border-slate-100 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
          <div class="min-w-0">
            <h2 id="email-template-content-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.detail_content_title') %></h2>
            <p class="mt-1 text-xs leading-5 text-slate-500"><%= t('admin.email_templates.detail_content_hint') %></p>
          </div>
          <% if current_version %>
            <span class="inline-flex shrink-0 self-start rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-800"><%= t('admin.email_templates.preview_version', version: current_version.version_number) %></span>
          <% end %>
        </header>
        <% if can_preview && current_version && @preview_html.present? %>
          <div class="space-y-5 p-4 sm:p-6 lg:p-8" data-controller="email-template-detail">
            <p class="flex items-center gap-2 text-xs leading-5 text-slate-500">
              <%= delta_icon('information-circle', class: 'size-4 shrink-0') %>
              <%= t('admin.email_templates.detail_preview_sample') %>
            </p>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <span class="text-xs font-semibold text-slate-600"><%= t('admin.email_templates.detail_device_label') %></span>
              <div class="inline-flex gap-1 rounded-xl bg-slate-100 p-1" role="group" aria-label="<%= t('admin.email_templates.detail_device_label') %>">
                <button type="button" data-email-template-detail-target="desktopButton" data-action="click->email-template-detail#showDesktop"
                        aria-controls="email-template-show-frame" aria-pressed="true"
                        class="inline-flex min-h-10 items-center gap-2 rounded-lg bg-white px-3 text-xs font-semibold text-emerald-800 shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600">
                  <%= delta_icon('computer-desktop', class: 'size-4') %>
                  <%= t('admin.email_templates.desktop') %>
                </button>
                <button type="button" data-email-template-detail-target="mobileButton" data-action="click->email-template-detail#showMobile"
                        aria-controls="email-template-show-frame" aria-pressed="false"
                        class="inline-flex min-h-10 items-center gap-2 rounded-lg px-3 text-xs font-semibold text-slate-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600">
                  <%= delta_icon('device-phone-mobile', class: 'size-4') %>
                  <%= t('admin.email_templates.mobile') %>
                </button>
              </div>
            </div>
            <div class="min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 p-3 sm:p-6 lg:p-8">
              <div data-email-template-detail-target="frame" class="mx-auto w-full max-w-[920px] overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition-[max-width] duration-200">
                <iframe id="email-template-show-frame" title="<%= t('admin.email_templates.detail_content_title') %>" sandbox=""
                        loading="lazy" srcdoc="<%= h(String.new(@preview_html)) %>" class="block h-[700px] w-full border-0 sm:h-[860px]"></iframe>
              </div>
            </div>
            <details class="group rounded-xl border border-slate-200 bg-slate-50/70">
              <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-3 px-4 text-sm font-semibold text-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600">
                <%= t('admin.email_templates.detail_text_toggle') %>
                <%= delta_icon('chevron-down', class: 'size-4 shrink-0 transition group-open:rotate-180') %>
              </summary>
              <pre class="max-h-64 overflow-auto whitespace-pre-wrap break-words border-t border-slate-200 p-4 font-mono text-xs leading-6 text-slate-700"><%= @preview_plain %></pre>
            </details>
          </div>
        <% elsif !current_version %>
          <div class="flex flex-col items-center gap-3 px-5 py-10 text-center">
            <%= image_tag 'deltin/waving.svg', alt: t('admin.email_templates.deltin_alt'), class: 'size-24 object-contain' %>
            <h3 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.detail_no_version') %></h3>
            <p class="max-w-md text-sm leading-6 text-slate-600"><%= t('admin.email_templates.detail_no_version_hint') %></p>
            <% if policy(@template).update? %>
              <%= link_to t('admin.email_templates.edit'), edit_admin_email_template_path(@template),
                          class: 'mt-1 inline-flex min-h-11 items-center justify-center rounded-xl border border-emerald-200 bg-emerald-50 px-4 text-sm font-semibold text-emerald-800 hover:bg-emerald-100' %>
            <% end %>
          </div>
        <% else %>
          <div class="flex items-start gap-3 p-6 text-sm leading-6 text-slate-600">
            <%= delta_icon('information-circle', class: 'mt-0.5 size-5 shrink-0 text-emerald-700') %>
            <p><%= t(@preview_error ? 'admin.email_templates.detail_preview_error' : 'admin.email_templates.detail_preview_restricted') %></p>
          </div>
        <% end %>
    </section>

    <div class="grid min-w-0 items-start gap-5 xl:grid-cols-[minmax(0,1.2fr)_minmax(300px,0.8fr)]">
      <div class="min-w-0 space-y-5">
      <% if policy(@template).versions? %>
        <section class="min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="email-template-versions-title">
          <header class="flex flex-col gap-3 border-b border-slate-100 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
            <div class="min-w-0">
              <h2 id="email-template-versions-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.versions') %></h2>
              <p class="mt-1 text-xs leading-5 text-slate-500"><%= t('admin.email_templates.detail_versions_count', count: @versions.size) %></p>
            </div>
            <% if @versions.size >= 2 %>
              <%= link_to t('admin.email_templates.compare'),
                          compare_admin_email_template_path(@template, left: @versions[1].id, right: @versions[0].id),
                          class: 'inline-flex min-h-10 items-center justify-center self-start rounded-lg border border-emerald-200 px-3 text-xs font-semibold text-emerald-800 hover:bg-emerald-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' %>
            <% end %>
          </header>
          <% if @versions.any? %>
            <ol class="max-h-[520px] divide-y divide-slate-100 overflow-y-auto px-5 sm:px-6">
              <% @versions.each do |version| %>
                <li class="flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:justify-between">
                  <div class="min-w-0">
                    <p class="font-semibold tabular-nums text-slate-900"><%= t('admin.email_templates.preview_version', version: version.version_number) %></p>
                    <p class="mt-1 text-xs text-slate-500"><%= t("admin.email_templates.status_labels.#{version.status}") %><% if version.published_at %> · <%= l(version.published_at, format: :short) %><% end %></p>
                  </div>
                  <div class="flex flex-wrap items-center gap-2">
                    <% if can_preview %>
                      <%= link_to t('admin.email_templates.preview'), preview_admin_email_template_path(@template, version_id: version.id),
                                  class: 'inline-flex min-h-10 items-center justify-center rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-700 hover:bg-slate-50' %>
                    <% end %>
                    <% if version.status == 'draft' && policy(@template).publish? %>
                      <%= button_to t('admin.email_templates.publish'), publish_admin_email_template_path(@template, version_id: version.id),
                                    data: { turbo_confirm: t('admin.email_templates.confirm_publish') },
                                    class: 'min-h-10 rounded-lg bg-emerald-700 px-3 text-xs font-semibold text-white hover:bg-emerald-800' %>
                    <% elsif version.status == 'published' && policy(@template).versions? && policy(@template).update? %>
                      <%= button_to t('admin.email_templates.restore'), restore_admin_email_template_path(@template, version_id: version.id),
                                    data: { turbo_confirm: t('admin.email_templates.confirm_restore') },
                                    class: 'min-h-10 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-700 hover:bg-slate-50' %>
                    <% end %>
                  </div>
                </li>
              <% end %>
            </ol>
          <% else %>
            <p class="px-5 py-8 text-sm text-slate-600"><%= t('admin.email_templates.no_versions') %></p>
          <% end %>
        </section>
      <% end %>
    </div>

    <aside class="min-w-0 space-y-5" aria-label="<%= t('admin.email_templates.detail_management_title') %>">
      <% if policy(@template).send_test? %>
        <section class="min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="email-test-title">
          <header class="border-b border-slate-100 px-5 py-4">
            <h2 id="email-test-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.send_test') %></h2>
            <p class="mt-1 text-xs leading-5 text-slate-500"><%= t('admin.email_templates.send_test_hint') %></p>
          </header>
          <% if test_available %>
            <%= form_with url: send_test_admin_email_template_path(@template), method: :post, class: 'space-y-4 p-5', data: { turbo_submits_with: t('admin.email_templates.send_test') } do |f| %>
              <div class="min-w-0">
                <%= f.label :email, t('admin.email_templates.test_recipient'), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
                <%= f.email_field :email, required: true, maxlength: 254, autocomplete: 'email',
                                  value: (current_user.email unless current_user.role?('super_admin')),
                                  readonly: !current_user.role?('super_admin'), placeholder: t('admin.email_templates.recipient_placeholder'),
                                  class: 'min-h-11 w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100' %>
              </div>
              <% unless current_user.role?('super_admin') %>
                <p class="text-xs leading-5 text-slate-500"><%= t('admin.email_templates.test_self_only') %></p>
              <% end %>
              <%= f.submit t('admin.email_templates.send_test'),
                           class: 'min-h-11 w-full cursor-pointer rounded-xl bg-emerald-700 px-4 text-sm font-semibold text-white hover:bg-emerald-800 disabled:opacity-60' %>
              <p class="text-xs leading-5 text-slate-500"><%= t('admin.email_templates.detail_preview_sample') %></p>
            <% end %>
          <% else %>
            <p class="px-5 py-6 text-sm leading-6 text-slate-600"><%= t('admin.email_templates.detail_test_unavailable') %></p>
          <% end %>
        </section>
      <% end %>

      <% if policy(@template).archive? && @template.status != 'archived' %>
        <section class="min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="email-template-management-title">
          <header class="border-b border-slate-100 px-5 py-4">
            <h2 id="email-template-management-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.detail_management_title') %></h2>
            <p class="mt-1 text-xs leading-5 text-slate-500"><%= t('admin.email_templates.detail_management_hint') %></p>
          </header>
          <div class="space-y-4 p-5">
            <p class="text-xs leading-5 text-slate-600"><%= t('admin.email_templates.detail_archive_hint') %></p>
            <%= button_to t('admin.email_templates.archive'), archive_admin_email_template_path(@template), method: :patch,
                          data: { turbo_confirm: t('admin.email_templates.confirm_archive') },
                          class: 'inline-flex min-h-11 w-full items-center justify-center rounded-xl border border-rose-200 bg-white px-4 text-sm font-semibold text-rose-700 hover:bg-rose-50' %>
          </div>
        </section>
      <% end %>

      <% if @can_view_audits %>
        <section class="min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="email-audit-title">
          <header class="border-b border-slate-100 px-5 py-4">
            <h2 id="email-audit-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.audit') %></h2>
            <p class="mt-1 text-xs leading-5 text-slate-500"><%= t('admin.email_templates.detail_activity_hint') %></p>
          </header>
          <% if @audits.any? %>
            <ol class="max-h-96 divide-y divide-slate-100 overflow-y-auto px-5">
              <% @audits.each do |audit| %>
                <li class="flex flex-col gap-1 py-3 text-sm">
                  <span class="font-semibold text-slate-800"><%= t("admin.email_templates.audit_actions.#{audit.action}", default: audit.action.humanize) %></span>
                  <span class="break-words text-xs leading-5 text-slate-500">
                    <%= audit.actor&.display_name || t('admin.email_templates.unknown_actor') %>
                    · <%= l(audit.created_at, format: :short) %>
                  </span>
                </li>
              <% end %>
            </ol>
          <% else %>
            <p class="px-5 py-7 text-sm text-slate-600"><%= t('admin.email_templates.no_audits') %></p>
          <% end %>
        </section>
      <% end %>
    </aside>
    </div>
  </div>
</main>
