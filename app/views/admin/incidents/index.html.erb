<% content_for :title, t(@team ? 'incidents.team' : 'incidents.mine') %>
<div class="incident-card"><header class="mb-4 flex items-center justify-between"><h1 class="font-jakarta text-2xl font-bold"><%= t(@team ? 'incidents.team' : 'incidents.mine') %></h1><%= link_to t('incidents.new'), new_admin_incident_path, class: 'incident-secondary' %></header>
<% if @can_manage %>
  <nav class="mb-4 flex gap-3">
    <%= link_to t('incidents.mine'), admin_incidents_path, class: 'incident-secondary' %>
    <%= link_to t('incidents.team'), admin_incidents_path(view: 'team'), class: 'incident-secondary' %>
  </nav>
<% end %>
<% if @incidents.empty? %><p><%= t('incidents.empty') %></p><% end %>
<ul class="divide-y divide-slate-200"><% @incidents.each do |incident| %><li class="flex flex-wrap items-center justify-between gap-2 py-3"><%= link_to incident.folio, admin_incident_path(incident), class: 'font-semibold text-emerald-700 underline' %><span><%= incident.description.truncate(70) %></span><span><%= t("incidents.choices.#{incident.status}") %></span></li><% end %></ul>
<nav class="flex gap-3"><%= link_to '←', admin_incidents_path(view: ('team' if @team), page: @page - 1), aria: { label: t('incidents.prev') } if @page > 1 %><%= link_to '→', admin_incidents_path(view: ('team' if @team), page: @page + 1), aria: { label: t('incidents.next') } if @more %></nav></div>
