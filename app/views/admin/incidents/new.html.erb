<% content_for :title, t('incidents.new') %>
<div class="mx-auto max-w-[92rem]">
<header class="mb-6 flex flex-wrap items-center justify-between gap-3">
  <div><p class="text-xs font-bold uppercase tracking-widest text-emerald-700"><%= t('incidents.group') %></p>
  <h1 class="font-jakarta text-3xl font-bold text-slate-900"><%= t('incidents.new') %></h1></div>
  <%= link_to t('incidents.mine'), admin_incidents_path, class: 'incident-secondary' %>
</header>
<div class="grid items-start gap-5 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
<%= form_with model: @incident, url: admin_incidents_path, multipart: true, class: 'incident-card',
  data: { controller: 'incident-form', turbo: false, action: 'submit->incident-form#submit change->incident-form#moduleChanged',
    incident_form_failure_value: t('incidents.failed'), incident_form_remove_value: t('incidents.remove') } do |form| %>
  <%= hidden_field_tag :origin, params[:origin] %>
  <%= form.hidden_field :submission_key %>
  <div class="flex items-center justify-between"><h2 class="font-jakarta text-lg font-bold"><%= t('incidents.data') %></h2>
    <%= render 'help', section: 'data', title: t('incidents.data') %></div>
  <div role="alert" tabindex="-1" class="text-rose-700" data-incident-form-target="error"><%= @incident.errors.full_messages.to_sentence %></div>
  <div class="mt-4 grid gap-4 sm:grid-cols-2">
    <%= render 'dropdown', field: :affected_module, selected: @incident.affected_module, options: Incident::SCREENS.keys.map { |key| [incident_module_label(key), key] } %>
    <div data-incident-form-target="screens">
      <%= render 'dropdown', field: :affected_screen, selected: @incident.affected_screen, options: Incident::SCREENS.values.flatten.uniq.map { |key| [t("incidents.screens.#{key}"), key] } %>
    </div>
    <%= tag.script Incident::SCREENS.to_json.html_safe, type: 'application/json', data: { incident_form_target: 'catalog' } %>
    <div class="sm:col-span-2"><%= form.label :description, class: 'incident-label' do %><%= t('incidents.fields.description') %> <span class="text-rose-600">*</span><% end %>
      <%= form.text_area :description, required: true, maxlength: 8000, rows: 3, class: 'incident-input' %></div>
    <% { category: IncidentType.available.pluck(:code), frequency: Incident::FREQUENCIES }.each do |field, keys| %>
      <%= render 'dropdown', field: field, selected: @incident.public_send(field), options: keys.map { |key| [t("incidents.choices.#{key}"), key] } %>
    <% end %>
    <%= render 'dropdown', field: :blocks_operation, selected: @incident.blocks_operation, options: [[t('incidents.continued'), 'false'], [t('incidents.blocked'), 'true']] %>
    <div><%= form.label :occurred_at, t('incidents.fields.occurred_at'), class: 'incident-label' %><%= form.datetime_local_field :occurred_at, class: 'incident-input' %></div>
    <div class="sm:col-span-2"><%= form.label :expected_result, t('incidents.fields.expected_result'), class: 'incident-label' %><%= form.text_area :expected_result, rows: 2, maxlength: 4000, class: 'incident-input' %></div>
    <div class="sm:col-span-2" data-incident-form-target="operation" data-labels="<%= t('incidents.references').to_json %>"><%= form.label :operation_reference, t('incidents.fields.operation_reference'), class: 'incident-label' %><%= form.text_field :operation_reference, maxlength: 160, class: 'incident-input' %></div>
  </div>
  <div class="my-4 flex items-center gap-2"><strong><%= t('incidents.files') %> (<span data-incident-form-target="count">0</span>)</strong>
    <%= render 'help', section: 'files', title: t('incidents.files') %>
    <button type="button" class="incident-secondary ml-auto" data-action="incident-form#pick"><%= t('incidents.attach') %></button>
    <%= form.file_field :attachments, multiple: true, include_hidden: false, accept: Incident::FORMATS.keys.map { |ext| ".#{ext}" }.join(','), class: 'hidden', data: { incident_form_target: 'picker', action: 'change->incident-form#add' } %>
  </div>
  <ul class="flex flex-wrap gap-2" data-incident-form-target="gallery"></ul>
  <template data-incident-form-target="tile"><li class="incident-tile"><div class="incident-preview"></div><small></small><button type="button">×</button></li></template>
  <% %w[xlsx pdf docx csv mp4 txt].each do |kind| %>
    <template data-kind="<%= kind %>"><%= render 'icon', kind: kind %></template>
  <% end %>
  <div class="mt-5 flex items-center justify-between gap-3"><small><b class="text-rose-600">*</b> <%= t('incidents.required') %></small>
    <%= form.submit t('incidents.send'), class: 'min-h-11 cursor-pointer rounded-xl bg-emerald-700 px-4 font-semibold text-white hover:bg-emerald-800 disabled:opacity-50' %></div>
<% end %>
<aside class="incident-card"><div class="flex items-center justify-between"><h2 class="font-jakarta text-lg font-bold"><%= t('incidents.context') %></h2><%= render 'help', section: 'context', title: t('incidents.context') %></div>
<dl class="mt-4 space-y-3"><% { origin: incident_origin_label(@incident), organization: current_organization.name, branch: current_branch&.name }.each do |key, value| %>
<div><dt class="text-xs text-slate-500"><%= t("incidents.#{key}") %></dt><dd><%= value.presence || '—' %></dd></div><% end %></dl></aside>
</div></div>
