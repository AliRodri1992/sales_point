<% if turbo_frame_request? %>
  <%= turbo_frame_tag "category_modal" do %>
    <%= render "panel" %>
  <% end %>
<% else %>
  <div class="mx-auto max-w-2xl space-y-5">
    <header>
      <h1 class="font-jakarta text-2xl font-bold text-slate-900"><%= t('admin.categories.new.title') %></h1>
      <p class="mt-1 text-sm text-slate-600"><%= t('admin.categories.new.subtitle') %></p>
    </header>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
      <%= render "form", category: @category, standalone: true %>
    </div>
  </div>
<% end %>
