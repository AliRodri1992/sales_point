<%# Count locals are provided for streamed updates, while ordinary requests use controller values. %>
<% total_count = local_assigns[:total_count] || @total_count || 0 %>
<% total_pages = local_assigns[:total_pages] || @total_pages || 1 %>
<% unfiltered_count = local_assigns[:unfiltered_count] || @unfiltered_count || 0 %>
<% search_filter = params[:search].to_s.strip %>
<% status_filter = %w[active inactive].include?(params[:status].to_s) ? params[:status].to_s : nil %>
<% sort_filter = %w[name code status created_at updated_at].include?(params[:sort].to_s) ? params[:sort].to_s : nil %>
<% sort_direction = params[:direction].to_s == 'desc' ? 'desc' : 'asc' %>
<% sort_is_custom = (sort_filter.present? && sort_filter != 'name') || sort_direction == 'desc' %>
<% has_filters = search_filter.present? || status_filter.present? || sort_is_custom %>

<% if has_filters %>
  <nav class="categories-filter-chips" aria-label="<%= t('admin.categories.index.active_filters') %>">
    <span class="categories-filter-chips-label"><%= t('admin.categories.index.active_filters') %></span>
    <% if search_filter.present? %>
      <%= link_to admin_categories_path(request.query_parameters.except('search', 'page')),
                  class: 'categories-filter-chip', data: { turbo_frame: '_top' },
                  aria: { label: "#{t('admin.categories.index.clear_search')}: #{search_filter}" } do %>
        <span><%= t('admin.categories.index.search_label') %>: <%= search_filter %></span>
        <span aria-hidden="true">×</span>
      <% end %>
    <% end %>
    <% if status_filter.present? %>
      <%= link_to admin_categories_path(request.query_parameters.except('status', 'page')),
                  class: 'categories-filter-chip', data: { turbo_frame: '_top' },
                  aria: { label: t('admin.categories.index.clear_status') } do %>
        <span><%= t('admin.categories.form.status') %>: <%= t("admin.categories.statuses.#{status_filter}") %></span>
        <span aria-hidden="true">×</span>
      <% end %>
    <% end %>
    <% if sort_is_custom %>
      <% sort_label = sort_filter.blank? || sort_filter == 'name' ? t('admin.categories.index.columns.name') : t("admin.categories.index.filters.sort_#{sort_filter}") %>
      <%= link_to admin_categories_path(request.query_parameters.except('sort', 'direction', 'page')),
                  class: 'categories-filter-chip', data: { turbo_frame: '_top' },
                  aria: { label: t('admin.categories.index.clear_sort') } do %>
        <span><%= t('admin.categories.index.filters.sort_by') %>: <%= sort_label %> · <%= t("admin.categories.index.filters.#{sort_direction == 'desc' ? 'descending' : 'ascending'}") %></span>
        <span aria-hidden="true">×</span>
      <% end %>
    <% end %>
    <%= link_to t('admin.categories.index.clear_filters'), admin_categories_path,
                class: 'categories-clear-filters', data: { turbo_frame: '_top' } %>
  </nav>
<% end %>

<section class="categories-directory" aria-labelledby="categories-directory-title"
         data-categories-current-sort="<%= sort_filter || 'name' %>"
         data-categories-current-direction="<%= sort_direction %>">
  <header class="categories-directory-heading">
    <div>
      <h2 id="categories-directory-title"><%= t('admin.categories.index.card_title') %></h2>
      <p><%= t('admin.categories.index.total_count', count: total_count) %></p>
    </div>
    <% if categories.any? %>
      <span class="categories-page-count"><%= t('admin.categories.index.showing', count: categories.size) %></span>
    <% end %>
  </header>

  <% if categories.any? %>
    <div class="categories-desktop-table">
      <table class="categories-table">
        <thead>
          <tr>
            <th scope="col" <%= tag.attributes(aria: { sort: sort_direction == 'desc' ? 'descending' : 'ascending' }) if sort_filter.nil? || sort_filter == 'name' %>><%= sort_link('name', t('admin.categories.index.columns.name'), frame: 'categories_list') %></th>
            <th scope="col" <%= tag.attributes(aria: { sort: sort_direction == 'desc' ? 'descending' : 'ascending' }) if sort_filter == 'code' %>><%= sort_link('code', t('admin.categories.index.columns.code'), frame: 'categories_list') %></th>
            <th scope="col"><%= t('admin.categories.index.columns.description') %></th>
            <th scope="col"><%= t('admin.categories.index.columns.status') %></th>
            <th scope="col" class="categories-actions-heading"><%= t('admin.categories.index.columns.actions') %></th>
          </tr>
        </thead>
        <tbody>
          <% categories.each do |category| %>
            <tr>
              <td>
                <span class="categories-identity">
                  <span class="categories-avatar" aria-hidden="true"><%= category.name.to_s[0].to_s.upcase %></span>
                  <span class="categories-name">
                    <% if policy(Category).show? %>
                      <%= link_to category.name, admin_category_path(category, request.query_parameters),
                                  data: { turbo_frame: 'category_modal', categories_filter_navigation: true }, class: 'categories-name-link' %>
                    <% else %>
                      <%= category.name %>
                    <% end %>
                  </span>
                </span>
              </td>
              <td><code class="categories-code"><%= category.code %></code></td>
              <td><span class="categories-description"><%= category.description.presence || '—' %></span></td>
              <td>
                <span class="categories-status <%= 'categories-status--inactive' unless category.active? %>">
                  <%= t("admin.categories.statuses.#{category.status}") %>
                </span>
              </td>
              <td><%= render 'actions', category: category %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <ul class="categories-mobile-list" aria-label="<%= t('admin.categories.index.card_title') %>">
      <% categories.each do |category| %>
        <li class="categories-mobile-card">
          <div class="categories-mobile-card-heading">
            <span class="categories-avatar" aria-hidden="true"><%= category.name.to_s[0].to_s.upcase %></span>
            <div class="categories-mobile-identity">
              <strong>
                <% if policy(Category).show? %>
                  <%= link_to category.name, admin_category_path(category, request.query_parameters),
                              data: { turbo_frame: 'category_modal', categories_filter_navigation: true }, class: 'categories-name-link' %>
                <% else %>
                  <%= category.name %>
                <% end %>
              </strong>
              <code class="categories-code"><%= category.code %></code>
            </div>
            <span class="categories-status <%= 'categories-status--inactive' unless category.active? %>">
              <%= t("admin.categories.statuses.#{category.status}") %>
            </span>
          </div>
          <% if category.description.present? %>
            <p class="categories-mobile-description"><%= category.description %></p>
          <% end %>
          <%= render 'actions', category: category %>
        </li>
      <% end %>
    </ul>

    <% if total_count.positive? %>
      <footer class="categories-pagination">
        <div class="categories-pagination-size">
          <label for="categories_per_page"><%= t('admin.categories.index.pagination.per_page_label') %></label>
          <div class="relative" data-controller="delta-select">
            <%= select_tag :per_page,
                  options_for_select(TablePagePreference::OPTIONS, @per_page || TablePagePreference::DEFAULT),
                  id: 'categories_per_page',
                  data: { controller: 'table-page-size', table_page_size_key_value: 'categories',
                          action: 'change->table-page-size#apply' } %>
          </div>
        </div>
        <%= pagination_links(total_pages, frame: 'categories_list') if total_pages > 1 %>
      </footer>
    <% end %>
  <% else %>
    <div class="categories-empty-state">
      <div class="categories-empty-icon" aria-hidden="true"><%= delta_icon('funnel', class: 'size-7') %></div>
      <% if unfiltered_count.positive? %>
        <h3><%= t('admin.categories.index.no_results') %></h3>
        <p><%= t('admin.categories.index.no_results_hint') %></p>
        <%= link_to t('admin.categories.index.clear_filters'), admin_categories_path,
                    data: { turbo_frame: '_top' }, class: 'categories-secondary-button' %>
      <% else %>
        <h3><%= t('admin.categories.index.empty_title') %></h3>
        <p><%= t('admin.categories.index.empty_subtitle') %></p>
      <% end %>
    </div>
  <% end %>
</section>
