<%# total_count / total_pages come from locals when rendered via
    Turbo::StreamsChannel broadcast (no controller ivars), or fall
    back to the controller-set instance variables for normal requests. %>
<% total_count = local_assigns[:total_count] || @total_count || 0 %>
<% total_pages = local_assigns[:total_pages] || @total_pages || 1 %>
<% unfiltered_count = local_assigns[:unfiltered_count] || @unfiltered_count || 0 %>

<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
  <div class="flex items-center justify-between px-6 py-4">
    <div>
      <h3 class="font-bold"><%= t('admin.categories.index.card_title') %></h3>
      <p class="mt-1 text-xs text-slate-400">
        <%= t('admin.categories.index.total_count', count: total_count) %>
      </p>
    </div>
  </div>

  <% if categories.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-y border-slate-100 text-xs text-slate-400">
            <th class="px-6 py-3 text-left font-medium">
              <%= sort_link('name', t('admin.categories.index.columns.name'), frame: 'categories_list') %>
            </th>
            <th class="px-6 py-3 text-left font-medium">
              <%= sort_link('code', t('admin.categories.index.columns.code'), frame: 'categories_list') %>
            </th>
            <th class="px-6 py-3 text-center font-medium">
              <%= t('admin.categories.index.columns.status') %>
            </th>
            <th class="px-6 py-3 text-center font-medium">
              <%= t('admin.categories.index.columns.actions') %>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% categories.each do |category| %>
            <tr class="hover:bg-slate-50">
              <td class="px-6 py-4 font-semibold">
                <%= category.name %>
              </td>
              <td class="px-6 py-4">
                <code class="rounded-md bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600"><%= category.code %></code>
              </td>
              <td class="px-6 py-4 text-center">
                <span class="inline-flex items-center justify-center rounded-full px-2 py-1 text-[11px] font-semibold
                  <%= category.active? ? 'bg-emerald-50 text-emerald-600' : 'bg-slate-100 text-slate-500' %>">
                  <%= t("admin.categories.statuses.#{category.status}") %>
                </span>
              </td>
              <td class="px-6 py-4 text-center">
                <div class="flex items-center justify-center gap-1">
                  <% if policy(Category).show? %>
<%= link_to admin_category_path(category),
                              data: { turbo_frame: 'category_modal', tooltip: t('admin.categories.show.title') },
                              class: 'inline-flex items-center justify-center rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-600',
                              aria: { label: t('admin.categories.show.title') } do %>
                    <%= delta_icon('eye', class: 'size-4') %>
                  <% end %>
<% end %>
                  <% if policy(Category).update? %>
<%= link_to edit_admin_category_path(category),
                              data: { turbo_frame: 'category_modal', tooltip: t('admin.categories.index.edit') },
                              class: 'inline-flex items-center justify-center rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-600',
                              aria: { label: t('admin.categories.index.edit') } do %>
                    <%= delta_icon('pencil-square', class: 'size-4') %>
                  <% end %>
<% end %>
                  <% if policy(Category).destroy? %>
<%= button_to admin_category_path(category),
                                method: :delete,
                                class: 'inline-flex items-center justify-center rounded-lg p-2 text-slate-400 transition hover:bg-rose-50 hover:text-rose-600',
                                data: {
                                  controller: 'swal-confirm',
                                  turbo_frame: 'categories_list',
                                  turbo_confirm: t('admin.categories.index.confirm_delete'),
                                  swal_cancel_text: t('admin.categories.confirm.cancel')
                                },
                                aria: { label: t('admin.categories.index.delete') } do %>
                    <%= delta_icon('trash', class: 'size-4') %>
                  <% end %>
<% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if total_count > 0 %>
      <div class="flex items-center justify-between gap-4 border-t border-slate-100 px-6 py-4"
>
        <div class="flex items-center gap-2 text-sm text-slate-600">
          <span><%= t('admin.categories.index.pagination.per_page_label') %>:</span>
          <div class="relative min-w-20" data-controller="delta-select">
          <%= select_tag :per_page,
                options_for_select(TablePagePreference::OPTIONS, @per_page || TablePagePreference::DEFAULT),
                data: { controller: 'table-page-size', table_page_size_key_value: 'categories',
                        action: 'change->table-page-size#apply' },
                class: 'w-full rounded-lg border border-slate-300 px-2 py-2 text-sm text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500' %>
          </div>
        </div>
        <div class="flex items-center gap-1">
          <%= pagination_links(total_pages, frame: 'categories_list') if total_pages > 1 %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="flex flex-col items-center gap-2 p-12 text-center">
      <%= delta_icon('cog', class: 'size-8 text-slate-300') %>
      <% if unfiltered_count.positive? %>
        <p class="text-sm font-semibold text-slate-600"><%= t('admin.categories.index.no_results') %></p>
        <%= link_to t('admin.categories.index.clear_filters'), admin_categories_path,
                    data: { turbo_frame: '_top' },
                    class: 'mt-2 inline-flex min-h-11 items-center rounded-xl border border-slate-200 px-4 text-sm font-semibold text-blue-700 hover:bg-slate-50' %>
      <% else %>
        <p class="text-sm font-semibold text-slate-500"><%= t('admin.categories.index.empty_title') %></p>
        <p class="text-xs text-slate-400"><%= t('admin.categories.index.empty_subtitle') %></p>
      <% end %>
    </div>
  <% end %>
</div>
