<div class="categories-workspace">
  <header class="categories-page-header">
    <div class="categories-heading-copy">
      <p class="categories-eyebrow"><%= t('admin.categories.index.kicker') %></p>
      <h1><%= t('admin.categories.index.title') %></h1>
      <p class="categories-subtitle"><%= t('admin.categories.index.subtitle') %></p>
    </div>
    <% if policy(Category).create? %>
      <%= link_to new_admin_category_path,
                  data: { turbo_frame: 'category_modal', tooltip: t('admin.categories.index.new') },
                  class: 'categories-primary-button' do %>
        <%= delta_icon('plus', class: 'size-4', aria: { hidden: true }) %>
        <%= t('admin.categories.index.new') %>
      <% end %>
    <% end %>
  </header>

  <section class="categories-filter-panel" aria-labelledby="categories-filter-title">
    <div class="categories-filter-heading">
      <h2 id="categories-filter-title"><%= t('admin.categories.index.search_label') %></h2>
      <p><%= t('admin.categories.index.filter_hint') %></p>
    </div>
    <%= form_with url: admin_categories_path, method: :get,
                  data: { turbo_frame: 'categories_list', controller: 'categories-search' },
                  class: 'categories-filter-form' do %>
      <%= hidden_field_tag :sort, params[:sort].presence || 'name', id: 'category_sort' %>
      <%= hidden_field_tag :direction, params[:direction].presence || 'asc', id: 'category_direction' %>
      <div class="categories-filter-field categories-search-field">
        <%= label_tag :category_search, t('admin.categories.index.search_label') %>
        <%= search_field_tag :search, params[:search], id: 'category_search',
              maxlength: 100, autocomplete: 'off',
              placeholder: t('admin.categories.index.search_placeholder'),
              data: { action: 'input->categories-search#debouncedSubmit' } %>
      </div>
      <div class="categories-filter-field categories-status-field">
        <%= label_tag :category_status, t('admin.categories.form.status') %>
        <div class="relative" data-controller="delta-select">
          <%= select_tag :status,
                options_for_select([
                  [t('admin.categories.index.filters.all_statuses'), 'all'],
                  [t('admin.categories.statuses.active'), 'active'],
                  [t('admin.categories.statuses.inactive'), 'inactive']
                ], params[:status].presence || 'all'),
                id: 'category_status',
                data: { action: 'change->categories-search#submitNow' } %>
        </div>
      </div>
      <button type="submit" class="categories-apply-button">
        <%= delta_icon('funnel', class: 'size-4', aria: { hidden: true }) %>
        <%= t('admin.categories.index.filters.apply') %>
      </button>

    <% end %>
  </section>

  <div id="categories_alert" aria-live="assertive" class="categories-alert"></div>
  <%= turbo_stream_from "categories_catalog_#{current_organization.id}" %>

  <div class="delta-skeleton-region" data-controller="skeleton-loading"
       data-skeleton-loading-region-value="categories_list" aria-busy="false"
       data-action="skeleton:begin@document->skeleton-loading#begin skeleton:end@document->skeleton-loading#finish turbo:before-fetch-request@document->skeleton-loading#turboStart turbo:frame-load@document->skeleton-loading#turboFinish turbo:fetch-request-error@document->skeleton-loading#turboError turbo:frame-missing@document->skeleton-loading#turboMissing turbo:before-cache@document->skeleton-loading#clear">
    <span class="sr-only" role="status" aria-live="polite" hidden data-skeleton-loading-target="status"><%= t('admin.action_loader.processing') %></span>
    <div class="delta-skeleton-region__progress" data-skeleton-loading-target="indicator" hidden aria-hidden="true"><span></span></div>
    <div data-skeleton-loading-target="content">
      <%= turbo_frame_tag "categories_list" do %>
        <%= render "list", categories: @categories %>
      <% end %>
    </div>
    <div data-skeleton-loading-target="placeholder" hidden>
      <%= render Ui::SkeletonComponent.new(variant: :table, rows: 6, columns: 5) %>
    </div>
    <div data-skeleton-loading-target="error" hidden role="alert"
         class="mt-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
      <span><%= t('admin.skeleton_loading.failed') %></span>
      <button type="button" data-action="skeleton-loading#retry"
              class="ml-2 font-semibold underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-rose-600"><%= t('admin.skeleton_loading.retry') %></button>
    </div>
  </div>
</div>
