<% category = @category %>
<div
  data-modal-target="panel"
  role="dialog"
  aria-modal="true"
  aria-labelledby="category-modal-title"
  class="categories-modal"
>
  <div class="categories-modal-header">
    <div>
      <h2 id="category-modal-title" class="font-jakarta text-lg font-bold text-slate-900">
        <%= category.persisted? ? t('admin.categories.edit.title', name: category.name) : t('admin.categories.new.title') %>
      </h2>
      <p class="mt-0.5 text-sm text-slate-500">
        <%= category.persisted? ? t('admin.categories.edit.subtitle') : t('admin.categories.new.subtitle') %>
      </p>
    </div>
    <button
      type="button"
      data-modal-dismiss
      data-action="modal#close"
      class="categories-modal-close"
      aria-label="<%= t('admin.categories.show.close') %>"
    >
      <%= delta_icon('x-mark', class: 'size-5') %>
    </button>
  </div>

  <div class="categories-modal-body">
    <%= render 'form', category: category %>
  </div>
</div>
