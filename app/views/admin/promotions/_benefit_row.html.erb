<div data-campaign-row class="grid items-end gap-3 py-3 sm:grid-cols-[1fr_1fr_auto]" <%= 'hidden' if form.object.marked_for_destruction? %>>
  <%= form.hidden_field :id if form.object.persisted? %>
  <%= form.hidden_field :_destroy, value: form.object.marked_for_destruction? ? 1 : 0 if form.object.persisted? %>
  <%= catalog_select(form, :kind, PromotionBenefit.kinds.keys.map { |kind| [t("admin.catalog_design.benefit_#{kind}"), kind] }, include_blank: false) %>
  <%= catalog_field(form, :value, type: :number_field, label: required_field_label(t('admin.catalog_design.value')), step: 'any', aria: { required: true }) %>
  <button type="button" class="catalog-button" data-action="promotion-editor#remove"><%= t('admin.catalog_design.remove') %></button>
</div>
