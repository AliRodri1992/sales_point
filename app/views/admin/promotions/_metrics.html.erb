<div class="promotion-metrics" aria-label="<%= campaign_text('metrics.title') %>">
  <% { 'total' => 'tag', 'active' => 'check', 'scheduled' => 'calendar', 'paused' => 'pause' }.each do |state, icon| %>
    <% options = campaign_filters.except(:status) %>
    <% options = options.merge(status: state) unless state == 'total' %>
    <% selected = state != 'total' && campaign_filters[:status] == state %>
    <%= link_to admin_promotions_path(options), class: "promotion-metric promotion-metric--#{state}",
                data: { campaign_metric: state }, aria: { current: selected ? 'true' : nil } do %>
      <span class="min-w-0">
        <span class="promotion-metric-label"><%= campaign_text("metrics.#{state}") %></span>
        <strong><%= number_with_delimiter(@promotion_metrics.fetch(state)) %></strong>
      </span>
      <span class="promotion-metric-icon"><%= promotion_icon(icon, class: 'size-5') %></span>
    <% end %>
  <% end %>
</div>
