<% filters = campaign_filters %>
<% selected_labels = { 'product_id' => @selected_product&.name, 'category_id' => @selected_category&.name } %>
<% chips = filters.slice(*PromotionsHelper::CAMPAIGN_FILTERS) %>
<%= form_with url: admin_promotions_path, method: :get, class: 'catalog-card !overflow-visible mb-4 p-4 sm:p-5', role: 'search' do %>
  <% %i[sort direction per_page].each do |field| %>
    <%= hidden_field_tag field, filters[field] if filters[field].present? %>
  <% end %>
  <div class="grid items-end gap-4 sm:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_auto]">
    <div class="catalog-field">
      <%= label_tag :campaign_search, campaign_text('filters.search') %>
      <%= search_field_tag :search, filters[:search], id: 'campaign_search', autocomplete: 'off' %>
    </div>
    <div class="catalog-field">
      <%= label_tag :campaign_status, campaign_text('filters.status') %>
      <%= select_tag :status, options_for_select(campaign_choices('status', PromotionsHelper::CAMPAIGN_STATES), filters[:status]),
                     id: 'campaign_status', include_blank: t('admin.catalog_design.all_statuses') %>
    </div>
    <%= button_tag t('admin.catalog_design.filter'), name: nil, class: 'catalog-button catalog-button-primary' %>
  </div>
  <%= tag.details class: 'mt-4 border-t border-slate-100 pt-3', open: chips.except(:search, :status).present? do %>
    <summary class="w-fit cursor-pointer rounded py-2 text-sm font-semibold text-[var(--brand-on-white)]"><%= t('admin.catalog_design.advanced_filters') %></summary>
    <div class="mt-3 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      <div class="catalog-field">
        <%= label_tag :campaign_currency, campaign_text('filters.currency') %>
        <div data-controller="delta-select" data-searchable="true" data-search-placeholder="<%= campaign_text('lookup.currencies') %>">
          <%= select_tag :currency, options_for_select(campaign_currency_options, filters[:currency]), id: 'campaign_currency', include_blank: t('admin.catalog_design.all_options') %>
        </div>
      </div>
      <% PromotionsHelper::FILTER_OPTIONS.except(:status).each do |key, values| %>
        <div class="catalog-field">
          <%= label_tag "campaign_#{key}", campaign_text("filters.#{key}") %>
          <%= select_tag key, options_for_select(values.map { |value| [campaign_filter_value(key, value), value] }, filters[key]),
                         id: "campaign_#{key}", include_blank: t('admin.catalog_design.all_options') %>
        </div>
      <% end %>
      <div class="catalog-field">
        <%= label_tag :campaign_segment, campaign_text('filters.customer_segment') %>
        <%= text_field_tag :customer_segment, filters[:customer_segment], id: 'campaign_segment', maxlength: 100 %>
      </div>
      <% { 'product' => @selected_product, 'category' => @selected_category }.each do |kind, selected| %>
        <%= render 'lookup', kind: kind, selected: selected, filter: true %>
      <% end %>
    </div>
  <% end %>
<% end %>
<% if chips.any? %>
  <nav aria-label="<%= campaign_text('applied_filters') %>" class="mb-4 flex flex-wrap items-center gap-2">
    <% chips.each do |field, value| %>
      <% display = campaign_filter_value(field, value, selected_labels) || campaign_text('unavailable') %>
      <%= link_to admin_promotions_path(filters.except(field)), class: 'inline-flex min-h-10 items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 text-xs font-semibold text-emerald-900',
                  aria: { label: campaign_text('remove_filter', field: campaign_text("filters.#{field}"), value: display) } do %>
        <%= campaign_text("filters.#{field}") %> · <%= display %><%= delta_icon('x-mark', class: 'size-3.5') %>
      <% end %>
    <% end %>
    <%= link_to t('admin.catalog_design.product_clear_all'), admin_promotions_path(filters.slice(:sort, :direction, :per_page)), class: 'rounded px-2 py-2 text-sm underline' %>
  </nav>
<% end %>
