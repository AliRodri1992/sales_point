<% filters = campaign_filters %>
<% selected_labels = { 'product_id' => @selected_product&.name, 'category_id' => @selected_category&.name } %>
<% chips = filters.slice(*PromotionsHelper::CAMPAIGN_FILTERS) %>
<% advanced_count = chips.except(:search, :status).size %>
<%= form_with url: admin_promotions_path, method: :get, class: 'catalog-card promotion-directory-filters', role: 'search', aria: { label: campaign_text('filter_title') } do %>
  <div class="promotion-filter-heading">
    <h2><%= campaign_text('filter_title') %></h2>
    <%= render 'section_help', section: 'filters', title: campaign_text('filter_title') %>
  </div>
  <% %i[sort direction per_page].each do |field| %>
    <%= hidden_field_tag field, filters[field] if filters[field].present? %>
  <% end %>
  <div class="promotion-filter-grid">
    <div class="catalog-field promotion-filter-search">
      <%= label_tag :campaign_search, campaign_text('directory.search_label') %>
      <div class="promotion-search-wrap">
        <%= promotion_icon('search', class: 'size-4') %>
        <%= search_field_tag :search, filters[:search], id: 'campaign_search', autocomplete: 'off', placeholder: campaign_text('directory.search_placeholder') %>
      </div>
    </div>
    <div class="catalog-field promotion-filter-status">
      <%= label_tag :campaign_status, campaign_text('filters.status') %>
      <div data-controller="delta-select">
        <%= select_tag :status, options_for_select(campaign_choices('status', PromotionsHelper::CAMPAIGN_STATES), filters[:status]),
                       id: 'campaign_status', include_blank: t('admin.catalog_design.all_statuses') %>
      </div>
    </div>
    <%= tag.details class: 'promotion-directory-advanced', open: advanced_count.positive? do %>
      <summary class="promotion-advanced-summary catalog-button" aria-controls="campaign-advanced-fields">
        <%= promotion_icon('filter', class: 'size-4') %><%= t('admin.catalog_design.advanced_filters') %>
        <% if advanced_count.positive? %><span class="promotion-advanced-count"><%= advanced_count %></span><% end %>
      </summary>
    <% end %>
    <%= button_tag name: nil, class: 'catalog-button catalog-button-primary promotion-filter-submit' do %>
      <%= promotion_icon('search', class: 'size-4') %><%= t('admin.catalog_design.search') %>
    <% end %>
    <div class="promotion-advanced-fields" id="campaign-advanced-fields">
      <div class="catalog-field">
        <%= label_tag :campaign_currency, campaign_text('filters.currency') %>
        <div data-controller="delta-select" data-searchable="true" data-search-placeholder="<%= campaign_text('lookup.currencies') %>">
          <%= select_tag :currency, options_for_select(campaign_currency_options, filters[:currency]), id: 'campaign_currency', include_blank: campaign_text('directory.all.currency') %>
        </div>
      </div>
      <% %i[benefit_kind validity usage].each do |key| %>
        <% values = PromotionsHelper::FILTER_OPTIONS.fetch(key) %>
        <div class="catalog-field">
          <%= label_tag "campaign_#{key}", campaign_text("directory.filter_labels.#{key}") %>
          <div data-controller="delta-select">
            <%= select_tag key, options_for_select(values.map { |value| [campaign_text("directory.choices.#{key}.#{value}"), value] }, filters[key]),
                           id: "campaign_#{key}", include_blank: campaign_text("directory.all.#{key}") %>
          </div>
        </div>
      <% end %>
      <div class="catalog-field">
        <%= label_tag :campaign_segment, campaign_text('filters.customer_segment') %>
        <%= text_field_tag :customer_segment, filters[:customer_segment], id: 'campaign_segment', maxlength: 100, placeholder: campaign_text('directory.segment_placeholder') %>
      </div>
      <% { 'product' => @selected_product, 'category' => @selected_category }.each do |kind, selected| %>
        <%= render 'lookup', kind: kind, selected: selected, filter: true %>
      <% end %>
    </div>
  </div>
  <% if chips.any? %>
    <nav aria-label="<%= campaign_text('applied_filters') %>" class="promotion-filter-chips">
      <% chips.each do |field, value| %>
        <% display = campaign_filter_value(field, value, selected_labels) || campaign_text('unavailable') %>
        <% label = campaign_text("directory.chips.#{field}") %>
        <%= link_to admin_promotions_path(filters.except(field)), class: 'promotion-filter-chip',
                    aria: { label: campaign_text('remove_filter', field: label, value: display) } do %>
          <span><%= label %>: <%= display %></span><%= promotion_icon('x', class: 'size-3') %>
        <% end %>
      <% end %>
      <%= link_to campaign_text('directory.clear_all'), admin_promotions_path(filters.slice(:sort, :direction, :per_page)), class: 'promotion-filter-clear' %>
    </nav>
  <% end %>
<% end %>
