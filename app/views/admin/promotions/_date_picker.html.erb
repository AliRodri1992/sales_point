<% if enabled %>
  <div class="promotion-date" data-controller="promotion-date" data-promotion-date-today-value="<%= Time.zone.today.iso8601 %>"
       data-action="keydown.esc->promotion-date#escape click@document->promotion-date#outside">
    <%= yield %>
    <button type="button" class="promotion-date-trigger catalog-button" hidden data-promotion-date-target="trigger"
            data-action="promotion-date#toggle" aria-expanded="false" aria-haspopup="dialog" aria-controls="<%= field_id %>-calendar"
            data-label="<%= campaign_text('calendar.open') %>"
            aria-label="<%= campaign_text('calendar.open') %>">
      <%= promotion_icon('calendar', class: 'size-5') %>
    </button>
    <div class="promotion-date-panel" id="<%= field_id %>-calendar" data-promotion-date-target="panel" hidden
         role="dialog" aria-label="<%= campaign_text('calendar.open') %>">
      <div class="flex items-center justify-between gap-2">
        <button type="button" class="promotion-date-nav" data-action="promotion-date#previous" aria-label="<%= campaign_text('calendar.previous') %>">
          <%= promotion_icon('chevron-left', class: 'size-4') %>
        </button>
        <strong class="text-sm" data-promotion-date-target="month" aria-live="polite"></strong>
        <button type="button" class="promotion-date-nav" data-action="promotion-date#next" aria-label="<%= campaign_text('calendar.next') %>">
          <%= promotion_icon('chevron-right', class: 'size-4') %>
        </button>
      </div>
      <div class="promotion-date-grid" data-promotion-date-target="days"></div>
      <div class="mt-3 flex flex-wrap justify-between gap-2 border-t border-slate-100 pt-3">
        <button type="button" class="catalog-button" data-action="promotion-date#clear"><%= campaign_text('calendar.clear') %></button>
        <button type="button" class="catalog-button catalog-button-primary" data-action="promotion-date#today"><%= campaign_text('calendar.today') %></button>
      </div>
      <p class="catalog-hint"><%= campaign_text('calendar.time_hint') %></p>
    </div>
  </div>
<% else %>
  <%= yield %>
<% end %>
