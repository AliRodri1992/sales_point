<div class="promotion-help" data-controller="promotion-help"
     data-action="keydown.esc->promotion-help#escape click@document->promotion-help#outside">
  <button type="button" class="promotion-help-trigger" data-section-help-trigger
          data-promotion-help-target="trigger" data-action="promotion-help#toggle"
          aria-label="<%= campaign_text('help.label', title: title) %>" aria-expanded="false"
          aria-controls="promotion-help-<%= section %>">
    <%= delta_icon('question-circle', class: 'size-5') %>
  </button>
  <div id="promotion-help-<%= section %>" class="promotion-help-panel" data-section-help-panel
       data-promotion-help-target="panel" hidden>
    <div class="mb-2 flex items-start justify-between gap-2">
      <strong class="text-sm text-slate-900"><%= title %></strong>
      <button type="button" class="promotion-help-trigger -mt-2 -mr-2" data-action="promotion-help#closeAndFocus"
              aria-label="<%= campaign_text('help.close') %>"><%= delta_icon('x-mark', class: 'size-4') %></button>
    </div>
    <p><%= campaign_text("help.#{section}.purpose") %></p>
    <p class="mt-3 font-semibold text-[var(--brand-on-white)]"><%= campaign_text('help.how_to') %></p>
    <p class="mt-1"><%= campaign_text("help.#{section}.usage") %></p>
  </div>
</div>
