<section id="campaign-conditions" class="catalog-card !overflow-visible" aria-labelledby="campaign-conditions-title">
  <%= render 'section_heading', title: campaign_text('editor.conditions'), subtitle: campaign_text('editor.conditions_hint'),
             id: 'campaign-conditions-title', icon: 'filter', section: 'conditions' %>
  <div class="catalog-card-body">
    <%= error_message_for(form.object, :promotion_conditions) %>
    <div data-promotion-editor-target="conditions">
      <%= form.fields_for :promotion_conditions, include_id: false do |row| %>
        <%= render 'condition_row', form: row %>
      <% end %>
    </div>
    <template data-promotion-editor-target="conditionTemplate">
      <%= form.fields_for :promotion_conditions, PromotionCondition.new(kind: 'product'), child_index: 'NEW_RECORD', include_id: false do |row| %>
        <%= render 'condition_row', form: row %>
      <% end %>
    </template>
    <button type="button" class="catalog-button" data-action="promotion-editor#addCondition" data-promotion-editor-target="addCondition">
      <%= promotion_icon('plus', class: 'size-4') %><%= campaign_text('editor.add_condition') %>
    </button>
    <p class="catalog-hint empty:hidden" role="status" data-promotion-editor-target="conditionNotice"></p>
    <% unless @target_lists.nil? %>
      <div class="catalog-field mt-4">
        <%= form.label :price_list_id, campaign_text('editor.price_list') %>
        <div class="relative" data-controller="delta-select" data-searchable="true" data-search-placeholder="<%= campaign_text('lookup.lists') %>">
          <%= form.select :price_list_id, @target_lists.map { |list| ["#{list.code} · #{list.name}", list.id] },
                          { include_blank: campaign_text('editor.all_lists') },
                          aria: { invalid: form.object.errors[:price_list].any?, describedby: validation_describedby(form.object, :price_list) } %>
        </div>
        <%= error_message_for(form.object, :price_list, label: campaign_text('price_list')) %>
      </div>
    <% end %>
  </div>
</section>
