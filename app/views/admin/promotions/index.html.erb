<% content_for :title, t('admin.catalog_design.promotions') %>
<div class="catalog-workspace promotion-workspace promotion-directory-workspace">
  <header class="catalog-header promotion-directory-heading">
    <%= render 'module_heading', eyebrow: t('admin.catalog_design.commercial'),
               title: t('admin.catalog_design.promotions'), intro: campaign_text('directory.intro') %>
    <% if policy(Promotion).create? %>
      <%= link_to new_admin_promotion_path(campaign_navigation_params), class: 'catalog-button catalog-button-primary' do %>
        <%= promotion_icon('plus', class: 'size-4') %><%= campaign_text('directory.new') %>
      <% end %>
    <% end %>
  </header>
  <%= render 'metrics' %>
  <%= render 'filters' %>
  <section id="campaign-results" class="catalog-list-directory promotion-directory" aria-labelledby="campaign-results-title">
    <header class="promotion-directory-titlebar">
      <div class="min-w-0">
        <div class="promotion-directory-title">
          <h2 id="campaign-results-title"><%= campaign_text('directory_title') %></h2>
          <span class="promotion-directory-count" aria-label="<%= campaign_text('results', count: @total_count) %>"><%= number_with_delimiter(@total_count) %></span>
          <%= render 'section_help', section: 'directory', title: campaign_text('directory_title') %>
        </div>
        <p><%= @total_count.zero? ? campaign_text('directory.no_results') : campaign_text('directory.showing', shown: @records.size, total: @total_count) %></p>
      </div>
      <%= render 'directory_sort' %>
    </header>
    <% if @records.any? %>
      <table class="promotion-directory-table" role="table">
        <caption class="sr-only"><%= campaign_text('directory.caption') %></caption>
        <thead role="rowgroup">
          <tr role="row"><% %w[campaign benefit audience validity usage status actions].each do |key| %>
            <th scope="col" role="columnheader"><%= campaign_text("directory.columns.#{key}") %></th>
          <% end %></tr>
        </thead>
        <tbody role="rowgroup">
          <% currency_places = campaign_currency_places %>
          <% @records.each do |record| %>
            <%= render 'campaign', record: record, precision: currency_places.fetch(record.currency, 2) %>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="promotion-directory-empty">
        <span class="promotion-directory-empty-icon"><%= promotion_icon('search', class: 'size-7') %></span>
        <h3><%= campaign_text('directory.empty_title') %></h3>
        <p><%= campaign_text('directory.empty_hint') %></p>
        <%= link_to campaign_text('directory.clear_filters'), admin_promotions_path(campaign_filters.slice(:sort, :direction, :per_page)), class: 'catalog-button' %>
      </div>
    <% end %>
    <%= render 'admin/shared/catalog_pagination', key: 'promotions', total_pages: @total_pages,
               current_page: @current_page, per_page_label: campaign_text('directory.rows_per_page'), frame: '_top' %>
  </section>
</div>
