<% used = @usage_counts.fetch(record.id, 0) %>
<div class="min-w-0 text-sm tabular-nums">
  <% if record.usage_limit %>
    <span><%= number_with_delimiter(used) %> / <%= number_with_delimiter(record.usage_limit) %></span>
    <progress class="promotion-detail-progress <%= 'is-full' if used >= record.usage_limit %>"
              aria-label="<%= campaign_text('redemptions') %>"
              value="<%= [used, record.usage_limit].min %>" max="<%= record.usage_limit %>"></progress>
  <% else %>
    <span><%= campaign_text('uses', count: used) %></span>
    <span class="promotion-detail-usage-meta"><%= t('admin.catalog_design.no_limit') %></span>
  <% end %>
</div>
