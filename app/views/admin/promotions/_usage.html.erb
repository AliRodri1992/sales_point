<% used = @usage_counts.fetch(record.id, 0) %>
<div class="min-w-0 text-sm tabular-nums">
  <% if record.usage_limit %>
    <span><%= campaign_text('used_of', used: number_with_delimiter(used), limit: number_with_delimiter(record.usage_limit)) %></span>
    <progress class="mt-1 block h-1.5 w-full max-w-32 accent-[var(--brand-on-white)]"
              aria-label="<%= campaign_text('redemptions') %>"
              value="<%= [used, record.usage_limit].min %>" max="<%= record.usage_limit %>"></progress>
  <% else %>
    <%= campaign_text('uses', count: used) %>
  <% end %>
</div>
