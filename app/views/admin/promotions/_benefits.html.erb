<section id="campaign-benefits" class="catalog-card !overflow-visible" aria-labelledby="campaign-benefits-title">
  <%= render 'section_heading', title: campaign_text('editor.benefits'), subtitle: campaign_text('editor.benefits_hint'),
             icon: 'percent', id: 'campaign-benefits-title', section: 'benefit' %>
  <div class="catalog-card-body">
    <%= error_message_for(form.object, :promotion_benefits) %>
    <p class="mb-3 text-xs font-semibold text-slate-600" aria-live="polite"
       aria-label="<%= campaign_text('benefits_count_label') %>">
      <span data-promotion-editor-target="benefitCount"><%= form.object.promotion_benefits.count { |row| !row.marked_for_destruction? && row.deleted_at.nil? } %> / <%= Promotion::MAX_BENEFITS %></span>
    </p>
    <div data-promotion-editor-target="benefits">
      <%= form.fields_for :promotion_benefits, include_id: false do |row| %>
        <%= render 'benefit_row', form: row %>
      <% end %>
    </div>
    <template data-promotion-editor-target="benefitTemplate">
      <%= form.fields_for :promotion_benefits, PromotionBenefit.new(kind: 'percentage'), child_index: 'NEW_RECORD', include_id: false do |row| %>
        <%= render 'benefit_row', form: row %>
      <% end %>
    </template>
    <button type="button" class="catalog-button" data-action="promotion-editor#addBenefit" data-promotion-editor-target="addBenefit">
      <%= promotion_icon('plus', class: 'size-4') %><%= campaign_text('add_benefit') %>
    </button>
    <p class="text-sm text-slate-600 empty:hidden" role="status" data-promotion-editor-target="benefitNotice"></p>
    <p class="catalog-hint mt-3"><%= campaign_text('editor.best_benefit_hint') %></p>
    <div class="catalog-fields mt-5">
      <div data-controller="delta-select">
        <%= catalog_select(form, :combination_mode, campaign_choices('editor.modes', %w[best_price exclusive]), label: campaign_text('editor.mode'), include_blank: false) %>
      </div>
      <%= catalog_field(form, :priority, type: :number_field, step: 1, label: required_field_label(campaign_text('priority')), aria: { required: true }) %>
      <%= catalog_field(form, :maximum_discount, type: :number_field, step: 'any', label: campaign_text('editor.cap'), placeholder: t('admin.catalog_design.no_limit')) %>
    </div>
  </div>
</section>
