<% content_for :title, @record.name %>
<% precision = campaign_currency_places.fetch(@record.currency, 2) %>
<div class="catalog-workspace promotion-workspace">
  <header class="catalog-header">
    <%= render 'module_heading', eyebrow: t('admin.catalog_design.promotions'), title: @record.name, record: @record %>
    <div class="catalog-actions">
      <%= render 'back_button' %>
      <% if policy(@record).update? && !%w[archived exhausted expired].include?(@record.effective_status.to_s) %>
        <%= link_to edit_admin_promotion_path(@record, campaign_navigation_params), class: 'catalog-button catalog-button-primary' do %>
          <%= delta_icon('pencil', class: 'size-4') %><%= t('admin.catalog_design.edit') %>
        <% end %>
      <% end %>
    </div>
  </header>

  <%= catalog_errors(@record) %>
  <%= error_message_for(@record, :status, label: campaign_text('filters.status')) %>
  <div class="promotion-detail-grid">
      <section class="catalog-card !overflow-visible" aria-labelledby="campaign-offer-title">
        <%= render 'section_heading', title: campaign_text('sections.benefit'), subtitle: t('admin.catalog_design.promotion_benefits_hint'),
                   icon: 'promotion-percent', id: 'campaign-offer-title', section: 'benefit' %>
        <div class="catalog-card-body">
          <% if @record.promotion_benefits.any? %>
            <ul class="mb-5 grid gap-3 sm:grid-cols-2">
              <% @record.promotion_benefits.each do |benefit| %>
                <li class="border-l-2 border-[var(--brand)] pl-3">
                  <span class="block font-jakarta text-2xl font-bold tabular-nums"><%= campaign_benefit_label(benefit, @record.currency, precision) %></span>
                  <span class="text-xs text-slate-600"><%= t("admin.catalog_design.benefit_#{benefit.kind}") %></span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="mb-5 text-sm text-slate-600"><%= campaign_text('no_benefit') %></p>
          <% end %>
          <dl class="catalog-definition">
            <div><dt><%= campaign_text('mode') %></dt><dd><%= campaign_text("modes.#{@record.combination_mode}") %></dd></div>
            <div><dt><%= campaign_text('priority') %></dt><dd><%= @record.priority %></dd></div>
            <div><dt><%= campaign_text('cap') %></dt><dd><%= @record.maximum_discount ? campaign_money(@record.maximum_discount, @record.currency, precision) : t('admin.catalog_design.no_limit') %></dd></div>
          </dl>
        </div>
      </section>

      <section class="catalog-card !overflow-visible" aria-labelledby="campaign-conditions-title">
        <%= render 'section_heading', title: campaign_text('sections.conditions'), subtitle: campaign_text('conditions_hint'),
                   icon: 'funnel', id: 'campaign-conditions-title', section: 'conditions' %>
        <div class="catalog-card-body">
          <% if @record.promotion_conditions.any? %>
            <dl class="catalog-definition">
              <% @record.promotion_conditions.group_by(&:kind).each do |kind, conditions| %>
                <div><dt><%= campaign_condition_label(kind) %></dt>
                  <dd><%= conditions.map { |condition| campaign_condition_value(condition, @record.currency, precision) }.join(', ') %></dd>
                </div>
              <% end %>
            </dl>
          <% else %>
            <p class="text-sm"><%= campaign_text('no_conditions') %></p>
          <% end %>
          <% if policy(PriceList).index? %>
            <dl class="catalog-definition mt-4">
              <div><dt><%= campaign_text('price_list') %></dt>
                <dd><%= @record.price_list_id ? (@record.price_list&.name || campaign_text('unavailable')) : campaign_text('all_lists') %></dd>
              </div>
            </dl>
          <% end %>
        </div>
      </section>

      <section class="catalog-card !overflow-visible" aria-labelledby="campaign-validity-title">
        <%= render 'section_heading', title: campaign_text('sections.validity'), subtitle: campaign_text('date_hint', zone: Time.zone.name),
                   icon: 'calendar', id: 'campaign-validity-title', section: 'validity' %>
        <dl class="catalog-card-body catalog-definition">
          <% %i[starts_at ends_at].each do |field| %>
            <div><dt><%= t("admin.catalog_design.#{field}") %></dt><dd><%= campaign_date(@record.public_send(field), format: :long) %></dd></div>
          <% end %>
        </dl>
      </section>
      <%= render 'usage_and_actions', record: @record %>
      <%= render 'admin/shared/commercial_overlaps', record: @record, promotion_help: true %>
      <div class="promotion-full">
        <%= render 'admin/shared/commercial_preview', record: @record, preview_url: preview_admin_promotion_path(@record, format: :json), lookup_url: products_lookup_admin_promotions_path(format: :json), promotion_help: true %>
      </div>
      <% if policy(@record).history? %>
        <section class="catalog-card promotion-full !overflow-visible" aria-labelledby="campaign-history-title">
          <%= render 'section_heading', title: campaign_text('history'), subtitle: nil,
                     icon: 'clock', id: 'campaign-history-title', section: 'history' %>
          <% if @history.any? %>
            <ol class="divide-y divide-slate-100 px-4 sm:px-6">
              <% @history.each do |entry| %>
                <li class="flex flex-wrap justify-between gap-2 py-3 text-sm">
                  <div><strong><%= campaign_text("events.#{entry.event.split('.').last}", default: campaign_text('updated')) %></strong>
                    <% if entry.actor %><p class="catalog-hint"><%= entry.actor.display_name %></p><% end %>
                  </div>
                  <time datetime="<%= entry.created_at.iso8601 %>" class="text-xs text-slate-600"><%= campaign_date(entry.created_at, format: :long) %></time>
                </li>
              <% end %>
            </ol>
          <% else %>
            <p class="catalog-card-body text-sm text-slate-600"><%= campaign_text('no_history') %></p>
          <% end %>
        </section>
      <% end %>
  </div>
</div>
