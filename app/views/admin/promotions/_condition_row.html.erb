<% kind = form.object.kind %>
<% target = PromotionsHelper::TARGET_KINDS[kind] %>
<div data-campaign-row data-condition-kind="<%= kind %>" class="promotion-editor-row promotion-condition-row" <%= 'hidden' if form.object.marked_for_destruction? %>>
  <%= form.hidden_field :id if form.object.persisted? %>
  <%= form.hidden_field :_destroy, value: form.object.marked_for_destruction? ? 1 : 0 if form.object.persisted? %>
  <div data-controller="delta-select" data-action="change->promotion-editor#changeCondition">
    <%= catalog_select(form, :kind, campaign_choices('editor.condition_kinds', %w[product category excluded_product excluded_category min_quantity min_subtotal customer_segment]), label: campaign_text('editor.condition_kind'), include_blank: false) %>
  </div>
  <div class="promotion-condition-value">
    <% %i[product category].each do |relation| %>
      <div data-condition-value="<%= relation %>" <%= 'hidden' unless target == relation %>>
        <%= render 'condition_target', form: form, relation: relation %>
      </div>
    <% end %>
    <% PromotionsHelper::RULE_FIELDS.each do |rule_kind, field| %>
      <div data-condition-value="<%= rule_kind %>" <%= 'hidden' unless kind == rule_kind %>>
        <%= catalog_field(form, field, type: field == :customer_segment ? :text_field : :number_field,
                          label: required_field_label(t('admin.catalog_design.value')), step: field == :customer_segment ? nil : 'any') %>
      </div>
    <% end %>
  </div>
  <button type="button" class="promotion-editor-remove" data-action="promotion-editor#remove" aria-label="<%= campaign_text('editor.remove_condition') %>"><%= promotion_icon('x', class: 'size-4') %></button>
</div>
