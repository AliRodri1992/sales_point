<header class="catalog-card-heading promotion-section-heading">
  <span class="catalog-icon" aria-hidden="true"><%= delta_icon(icon, class: 'size-5') %></span>
  <div class="min-w-0 flex-1">
    <h2 id="<%= id %>"><%= title %></h2>
    <% if subtitle.present? %><p><%= subtitle %></p><% end %>
  </div>
  <%= render 'admin/promotions/section_help', section: section, title: title %>
</header>
