<% permissions = policy(record) %>
<% context = campaign_navigation_params %>
<div class="catalog-list-row-actions promotion-row-actions" role="group" data-promotion-row-actions
     aria-label="<%= campaign_text('columns.actions') %>">
  <% if permissions.show? %>
    <%= link_to admin_promotion_path(record, context), class: 'catalog-list-icon-button',
                data: { tooltip: campaign_text('row_actions.show') },
                aria: { label: "#{campaign_text('row_actions.show')}: #{record.name}" } do %>
      <%= promotion_icon('eye', class: 'size-4') %>
    <% end %>
  <% end %>
  <% if permissions.update? && %w[draft active scheduled paused].include?(record.effective_status.to_s) %>
    <%= link_to edit_admin_promotion_path(record, context), class: 'catalog-list-icon-button',
                data: { tooltip: t('admin.catalog_design.edit') },
                aria: { label: "#{t('admin.catalog_design.edit')}: #{record.name}" } do %>
      <%= promotion_icon('edit', class: 'size-4') %>
    <% end %>
  <% elsif permissions.update? %>
    <%= button_tag type: 'button', disabled: true, class: 'catalog-list-icon-button', title: campaign_text('directory.edit_unavailable'),
                   aria: { label: campaign_text('directory.edit_unavailable') } do %>
      <%= promotion_icon('edit', class: 'size-4') %>
    <% end %>
  <% end %>
  <% if permissions.destroy? && record.transition_available?('archive') %>
    <%= button_to admin_promotion_path(record, context), method: :delete,
                  class: 'catalog-list-icon-button catalog-list-icon-button--danger',
                  form: { data: { turbo_confirm: campaign_text('confirm.archive', name: record.name) } },
                  data: { tooltip: campaign_text('row_actions.delete') },
                  aria: { label: "#{campaign_text('row_actions.delete')}: #{record.name}" } do %>
      <%= promotion_icon('trash', class: 'size-4') %>
    <% end %>
  <% elsif permissions.destroy? %>
    <%= button_tag type: 'button', disabled: true, class: 'catalog-list-icon-button catalog-list-icon-button--danger',
                   title: campaign_text('directory.archive_unavailable'), aria: { label: campaign_text('directory.archive_unavailable') } do %>
      <%= promotion_icon('trash', class: 'size-4') %>
    <% end %>
  <% end %>
</div>
