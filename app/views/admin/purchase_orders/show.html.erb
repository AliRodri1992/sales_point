<%= render 'admin/purchases/navigation' %>
<section class="space-y-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div><h1 class="font-jakarta text-2xl font-bold"><%= @order.code %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= @order.supplier.name %> · <%= @order.branch.name %></p></div>
    <span class="rounded-xl bg-slate-100 px-4 py-2 text-sm"><%= t("admin.purchases.statuses.#{@order.status}") %></span>
  </div>
  <div class="flex flex-wrap gap-4 text-sm">
    <span><%= t('admin.purchases.currency') %>: <strong><%= @order.currency.code %></strong></span>
    <span><%= t('admin.purchases.total') %>: <strong><%= @order.total.round(2) %></strong></span>
    <span><%= t('admin.purchases.expected_on') %>: <%= @order.expected_on %></span>
    <span><%= t('admin.purchases.approved_by') %>: <%= @order.approved_by&.display_name || '—' %></span>
  </div>
  <div class="overflow-x-auto">
    <table class="min-w-full text-left text-sm">
      <thead><tr><% %w[product quantity unit_price discount_percent received outstanding].each do |key| %>
        <th class="p-3"><%= t("admin.purchases.#{key}") %></th><% end %></tr></thead>
      <tbody><% @order.purchase_order_items.includes(:product).each do |item| %>
        <tr class="border-t border-slate-100">
          <td class="p-3"><%= item.product.name %></td>
          <td class="p-3"><%= item.quantity %></td>
          <td class="p-3"><%= item.unit_price %></td>
          <td class="p-3"><%= item.discount_percent %>%</td>
          <td class="p-3"><%= @order.received_quantity_for(item) %></td>
          <td class="p-3"><%= @order.outstanding_quantity_for(item) %></td>
        </tr>
      <% end %></tbody>
    </table>
  </div>
  <p class="text-sm"><%= @order.notes %></p>
  <div class="flex flex-wrap gap-3">
    <% if @order.draft? && policy(@order).edit? %>
      <%= link_to t('admin.purchases.edit'), edit_admin_purchase_order_path(@order),
                  class: 'rounded-xl border border-slate-200 px-5 py-3 font-semibold' %>
      <%= button_to t('admin.purchases.submit'), submit_admin_purchase_order_path(@order),
                    class: 'rounded-xl bg-emerald-600 px-5 py-3 font-semibold text-white' %>
    <% end %>
    <% if @order.pending_approval? && policy(@order).approve? %>
      <%= button_to t('admin.purchases.approve'), approve_admin_purchase_order_path(@order),
                    class: 'rounded-xl bg-emerald-600 px-5 py-3 font-semibold text-white' %>
      <%= button_to t('admin.purchases.reject'), reject_admin_purchase_order_path(@order),
                    class: 'rounded-xl border border-rose-300 px-5 py-3 text-rose-700' %>
    <% end %>
    <% if @order.approved? && policy(@order).dispatch? %>
      <%= button_to t('admin.purchases.dispatch'), send_order_admin_purchase_order_path(@order),
                    class: 'rounded-xl bg-emerald-600 px-5 py-3 text-white' %>
    <% end %>
    <% if @order.receivable? && policy(@order).receive? %>
      <%= link_to t('admin.purchases.new_receipt'), new_admin_purchase_order_goods_receipt_path(@order),
                  class: 'rounded-xl bg-emerald-600 px-5 py-3 text-white' %>
    <% end %>
    <%= link_to t('admin.purchases.receipts'), admin_purchase_order_goods_receipts_path(@order),
                class: 'rounded-xl border border-slate-200 px-5 py-3' %>
    <% if @order.status.in?(%w[ordered partially_received received]) &&
          @order.goods_receipts.exists? && policy(@order).close? %>
      <%= button_to t('admin.purchases.close_with_differences'), close_admin_purchase_order_path(@order),
                    class: 'rounded-xl border border-amber-300 px-5 py-3 font-semibold text-amber-800',
                    form: { data: { turbo_confirm: t('admin.purchases.close_with_differences') } } %>
    <% end %>
    <% if @order.status.in?(%w[draft pending_approval approved ordered]) && policy(@order).cancel? %>
      <%= button_to t('admin.purchases.cancel'), cancel_admin_purchase_order_path(@order),
                    class: 'rounded-xl border border-rose-300 px-5 py-3 text-rose-700',
                    form: { data: { turbo_confirm: t('admin.purchases.cancel') } } %>
    <% end %>
  </div>
  <% if @order.purchase_approvals.any? %>
    <h2 class="font-semibold"><%= t('admin.purchases.history') %></h2>
    <% @order.purchase_approvals.includes(:decided_by).each do |decision| %>
      <p class="text-sm text-slate-600"><%= decision.decided_by.display_name %>:
        <%= t("admin.purchases.statuses.#{decision.decision}") %> · <%= l(decision.created_at, format: :short) %></p>
    <% end %>
  <% end %>
</section>
