<%= render 'admin/purchases/navigation' %>
<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <h1 class="font-jakarta text-2xl font-bold"><%= t('admin.purchases.orders') %></h1>
  <% if policy(PurchaseOrder.new(organization: current_organization)).create? %>
    <%= link_to t('admin.purchases.new_order'), new_admin_purchase_order_path,
                class: 'rounded-xl bg-emerald-600 px-5 py-3 font-semibold text-white' %>
  <% end %>
</div>
<div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white">
  <table class="min-w-full divide-y divide-slate-100 text-sm">
    <thead><tr>
      <% %w[code supplier branch status total].each do |key| %>
        <th class="p-4 text-left"><%= t("admin.purchases.#{key}") %></th>
      <% end %>
    </tr></thead><tbody>
      <% @orders.each do |order| %>
        <tr class="border-t border-slate-100">
          <td class="p-4"><%= link_to order.code, admin_purchase_order_path(order),
                                           class: 'font-semibold text-emerald-700 hover:underline' %></td>
          <td class="p-4"><%= order.supplier.name %></td>
          <td class="p-4"><%= order.branch.name %></td>
          <td class="p-4"><%= t("admin.purchases.statuses.#{order.status}") %></td>
          <td class="p-4"><%= order.total.round(2) %> <%= order.currency.code %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @orders.empty? %><p class="p-6 text-sm text-slate-500"><%= t('admin.purchases.empty') %></p><% end %>
</div>
