<nav aria-label="Finance pages" class="mt-5 flex items-center justify-between text-sm text-slate-600">
  <div class="flex flex-wrap items-center gap-3">
    <% if @total_records.positive? %>
      <label for="financial-per-page"><%= t('admin.general_settings.unit') %></label>
      <%= select_tag :per_page, options_for_select(TablePagePreference::OPTIONS, @per_page),
                     id: 'financial-per-page',
                     data: { controller: 'table-page-size', table_page_size_key_value: controller_name,
                             action: 'change->table-page-size#apply' },
                     class: 'min-h-10 rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-700' %>
    <% end %>
    <span><%= @total_records %> · <%= @page %> / <%= @total_pages %></span>
  </div>
  <div class="flex gap-2">
    <% if @page > 1 %>
      <%= link_to '‹', url_for(page: @page - 1),
                  class: 'rounded-lg border border-slate-200 px-4 py-2 text-emerald-800' %>
    <% end %>
    <% if @page < @total_pages %>
      <%= link_to '›', url_for(page: @page + 1),
                  class: 'rounded-lg border border-slate-200 px-4 py-2 text-emerald-800' %>
    <% end %>
  </div>
</nav>
