<% style = case status.to_s
           when 'paid', 'posted', 'confirmed', 'active', 'approved'
             'bg-emerald-50 text-emerald-800 ring-emerald-200'
           when 'overdue', 'cancelled', 'reversed', 'rejected'
             'bg-rose-50 text-rose-800 ring-rose-200'
           when 'partial', 'pending', 'draft'
             'bg-amber-50 text-amber-800 ring-amber-200'
           else
             'bg-slate-100 text-slate-700 ring-slate-200'
           end %>
<span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset <%= style %>">
  <%= t("admin.accounts_payable.states.#{status}") %>
</span>
