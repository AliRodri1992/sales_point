<section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="email-settings-audit-title">
  <header class="border-b border-slate-100 px-5 py-4">
    <h2 id="email-settings-audit-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('email_setting_audits.heading') %></h2>
  </header>
  <% if audits.any? %>
    <ol class="divide-y divide-slate-100 px-5">
      <% audits.each do |audit| %>
        <li class="flex flex-wrap items-start justify-between gap-3 py-3 text-sm">
          <div class="min-w-0">
            <p class="font-semibold text-slate-800"><%= audit.actor&.display_name || t('admin.email_templates.unknown_actor') %></p>
            <% changes = audit.changeset.map do |key, values|
                 label = t("admin.email_templates.settings_fields.#{key}", default: key.to_s.humanize)
                 safe_detail = %w[primary_color secondary_color button_color default_locale].include?(key)
                 safe_detail && values.is_a?(Array) && values.size == 2 ?
                   "#{label}: #{values.first.presence || '—'} → #{values.last.presence || '—'}" : label
               end %>
            <p class="mt-1 break-words text-xs text-slate-500"><%= changes.join(', ') %></p>
          </div>
          <time datetime="<%= audit.created_at.iso8601 %>" class="shrink-0 text-xs text-slate-500"><%= l(audit.created_at, format: :short) %></time>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="px-5 py-6 text-sm text-slate-500"><%= t('email_setting_audits.empty') %></p>
  <% end %>
</section>
