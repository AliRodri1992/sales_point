<section class="rounded-2xl border border-slate-200 bg-white p-6" aria-label="Historial de cambios">
  <h2 class="mb-4 text-lg font-bold text-slate-900">Historial de cambios</h2>
  <% if audits.any? %>
    <ol class="divide-y divide-slate-100">
      <% audits.each do |audit| %>
        <li class="flex flex-wrap items-start justify-between gap-2 py-3 text-sm">
          <div>
            <p class="font-semibold text-slate-800"><%= audit.actor.display_name %></p>
            <p class="mt-1 text-slate-500"><%= audit.changeset.keys.map(&:humanize).join(', ') %></p>
          </div>
          <time datetime="<%= audit.created_at.iso8601 %>" class="text-xs text-slate-500">
            <%= l(audit.created_at, format: :short) %>
          </time>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="text-sm text-slate-500">Todavía no hay cambios registrados.</p>
  <% end %>
</section>
