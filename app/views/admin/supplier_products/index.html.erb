<div class="space-y-6">
  <header class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div>
      <%= link_to @supplier.name, admin_supplier_path(@supplier, tab: 'products'), class: 'text-sm text-emerald-700 hover:underline' %>
      <h1 class="mt-2 font-jakarta text-2xl font-bold text-slate-900"><%= t('admin.procurement.title') %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= t('admin.procurement.description') %></p>
    </div>
    <% if policy(@supplier).manage_products? %>
      <%= link_to t('admin.procurement.add'), new_admin_supplier_supplier_product_path(@supplier),
                  class: 'rounded-xl bg-emerald-600 px-4 py-3 text-sm font-semibold text-white hover:bg-emerald-700' %>
    <% end %>
  </header>
  <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-slate-100 text-left text-sm">
      <thead class="bg-slate-50 text-slate-600"><tr>
        <% %w[product presentation purchase_price unit_cost preferred actions].each do |column| %>
          <th class="px-4 py-3 font-semibold"><%= t("admin.procurement.#{column}") %></th>
        <% end %>
      </tr></thead>
      <tbody class="divide-y divide-slate-100">
        <% @offers.each do |offer| %>
          <tr>
            <td class="px-4 py-3"><%= offer.product.name %> <span class="text-slate-400"><%= offer.supplier_sku %></span></td>
            <td class="px-4 py-3"><%= offer.presentation_name %> × <%= offer.units_per_package %></td>
            <td class="px-4 py-3"><%= offer.purchase_price %> <%= offer.currency.code %></td>
            <td class="px-4 py-3 font-semibold"><%= offer.unit_cost %> <%= offer.currency.code %></td>
            <td class="px-4 py-3"><%= offer.preferred? ? t('admin.procurement.yes') : '—' %></td>
            <td class="px-4 py-3">
              <% if policy(@supplier).manage_products? %>
                <%= link_to t('admin.procurement.edit'), edit_admin_supplier_supplier_product_path(@supplier, offer), class: 'text-emerald-700 hover:underline' %>
                <%= button_to t('admin.procurement.delete'), admin_supplier_supplier_product_path(@supplier, offer),
                              method: :delete, form: { data: { turbo_confirm: t('admin.supplier_details.confirm') } },
                              class: 'mt-2 text-rose-600 hover:underline' %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @offers.empty? %><p class="p-6 text-sm text-slate-500"><%= t('admin.procurement.empty') %></p><% end %>
  </div>
</div>
