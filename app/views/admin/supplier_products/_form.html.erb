<%= form_with model: [:admin, @supplier, @offer], class: 'space-y-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm',
              data: { loading_message: t('admin.action_loader.saving') } do |form| %>
  <% if @offer.errors.any? %>
    <div class="rounded-lg bg-rose-50 p-3 text-sm text-rose-700"><%= @offer.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="grid gap-5 md:grid-cols-2">
    <div>
      <%= form.label :product_id, t('admin.procurement.product'), class: 'mb-2 block text-sm font-semibold' %>
      <div class="relative" data-controller="delta-select" data-searchable="true">
<%= form.collection_select :product_id, @products, :id, :name, { include_blank: true },
                                 { required: true, disabled: @offer.persisted?, class: 'w-full rounded-xl border border-slate-200 p-3' } %>
</div>
    </div>
    <div>
      <%= form.label :supplier_sku, t('admin.procurement.supplier_sku'), class: 'mb-2 block text-sm font-semibold' %>
      <%= form.text_field :supplier_sku, class: 'w-full rounded-xl border border-slate-200 p-3' %>
    </div>
    <div>
      <%= form.label :presentation_name, t('admin.procurement.presentation'), class: 'mb-2 block text-sm font-semibold' %>
      <%= form.text_field :presentation_name, required: true, class: 'w-full rounded-xl border border-slate-200 p-3' %>
    </div>
    <div>
      <%= form.label :units_per_package, t('admin.procurement.units_per_package'), class: 'mb-2 block text-sm font-semibold' %>
      <%= form.number_field :units_per_package, min: 0.0001, step: 0.0001, required: true, class: 'w-full rounded-xl border border-slate-200 p-3' %>
    </div>
    <div>
      <%= form.label :purchase_price, t('admin.procurement.purchase_price'), class: 'mb-2 block text-sm font-semibold' %>
      <%= form.number_field :purchase_price, min: 0, step: 0.0001, required: true, class: 'w-full rounded-xl border border-slate-200 p-3' %>
    </div>
    <div>
      <%= form.label :currency_id, t('admin.procurement.currency'), class: 'mb-2 block text-sm font-semibold' %>
      <div class="relative" data-controller="delta-select">
<%= form.collection_select :currency_id, @currencies, :id, :code, {}, { required: true, class: 'w-full rounded-xl border border-slate-200 p-3' } %>
</div>
    </div>
    <% %i[discount_percent freight_amount nonrecoverable_tax minimum_quantity lead_time_days].each do |field| %>
      <div>
        <%= form.label field, t("admin.procurement.#{field}"), class: 'mb-2 block text-sm font-semibold' %>
        <%= form.number_field field, min: 0, step: field == :lead_time_days ? 1 : 0.001,
                              class: 'w-full rounded-xl border border-slate-200 p-3' %>
      </div>
    <% end %>
  </div>
  <p class="text-sm text-slate-500"><%= t('admin.procurement.preferred_form_hint') %></p>
  <div class="flex flex-wrap gap-5">
    <label class="flex items-center gap-2"><%= form.check_box :active %><%= t('admin.procurement.active') %></label>
  </div>
  <div class="flex gap-3">
    <%= form.submit t('admin.procurement.save'), class: 'rounded-xl bg-emerald-600 px-5 py-3 font-semibold text-white' %>
    <%= link_to t('admin.procurement.back'), admin_supplier_supplier_products_path(@supplier),
                data: { loading_message: t('admin.action_loader.returning') },
                class: 'rounded-xl border border-slate-200 px-5 py-3 font-semibold' %>
  </div>
<% end %>
