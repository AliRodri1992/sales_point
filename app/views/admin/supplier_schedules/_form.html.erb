<%= form_with model: @schedule,
              url: @schedule.persisted? ? admin_supplier_schedule_path(@supplier, @schedule) : admin_supplier_schedules_path(@supplier),
              data: { turbo: false, loading_message: t('admin.action_loader.saving') },
              class: 'mx-auto max-w-5xl space-y-5' do |form| %>
  <%= hidden_field_tag :return_to, 'dossier' if params[:return_to] == 'dossier' %>

  <% if @schedule.errors[:base].any? %>
    <div role="alert" class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm font-medium text-rose-800">
      <%= @schedule.errors.full_messages_for(:base).to_sentence %>
    </div>
  <% end %>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7"
           aria-labelledby="supplier-schedule-identity">
    <div class="mb-6 flex items-center gap-3 border-b border-slate-100 pb-5">
      <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
        <%= delta_icon('calendar-days', class: 'size-5') %>
      </span>
      <div>
        <h2 id="supplier-schedule-identity" class="font-jakarta text-lg font-bold text-slate-900">
          <%= t('admin.supplier_dossier.schedules') %>
        </h2>
        <p class="mt-1 text-sm text-slate-500"><%= t('admin.supplier_calendar.scheduled') %></p>
      </div>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      <div class="min-w-0">
        <%= form.label :branch_id, t('admin.supplier_dossier.branch'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <div data-controller="delta-select" class="relative">
          <%= form.collection_select :branch_id, @branches, :id, :name,
                                     { include_blank: true },
                                     required: true,
                                     class: "min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-3 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 #{form_state_classes(@schedule, :branch)}" %>
        </div>
        <%= error_message_for(@schedule, :branch) %>
      </div>
      <div class="min-w-0">
        <%= form.label :kind, t('admin.supplier_dossier.kind'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <div data-controller="delta-select" class="relative">
          <%= form.select :kind,
                          SupplierSchedule::KINDS.map { |kind| [t("admin.supplier_dossier.kinds.#{kind}"), kind] },
                          {}, class: "min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-3 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 #{form_state_classes(@schedule, :kind)}" %>
        </div>
        <%= error_message_for(@schedule, :kind) %>
      </div>
      <div class="min-w-0 sm:col-span-2">
        <%= form.label :weekday, t('admin.supplier_dossier.weekday'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <div data-controller="delta-select" class="relative">
          <%= form.select :weekday, (0..6).map { |day| [t('date.day_names')[day], day] },
                          {}, class: "min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-3 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 #{form_state_classes(@schedule, :weekday)}" %>
        </div>
        <%= error_message_for(@schedule, :weekday) %>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7"
           aria-labelledby="supplier-schedule-timing">
    <div class="mb-6 flex items-center gap-3 border-b border-slate-100 pb-5">
      <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-sky-50 text-sky-700">
        <%= delta_icon('clock', class: 'size-5') %>
      </span>
      <h2 id="supplier-schedule-timing" class="font-jakarta text-lg font-bold text-slate-900">
        <%= t('admin.supplier_dossier.starts_at') %> · <%= t('admin.supplier_dossier.ends_at') %>
      </h2>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      <% %i[starts_at ends_at].each do |field| %>
        <div class="min-w-0">
          <%= form.label field, t("admin.supplier_dossier.#{field}"),
                         class: 'mb-2 block text-sm font-semibold text-slate-700' %>
          <%= form.time_field field, required: field == :starts_at,
                              class: "min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-3 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 #{form_state_classes(@schedule, field)}" %>
          <%= error_message_for(@schedule, field) %>
        </div>
      <% end %>
      <div class="min-w-0 sm:col-span-2">
        <%= form.label :notes, t('admin.supplier_dossier.notes'),
                       class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.text_area :notes, rows: 3, maxlength: 1000,
                           class: "min-h-28 w-full resize-y rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-3 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 #{form_state_classes(@schedule, :notes)}" %>
        <%= error_message_for(@schedule, :notes) %>
      </div>
    </div>
  </section>

  <footer class="flex flex-col-reverse gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:flex-row sm:justify-end sm:p-5">
    <%= link_to t('admin.supplier_calendar.cancel'), admin_supplier_schedules_path(@supplier),
                data: { loading_message: t('admin.action_loader.returning') },
                class: 'inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-200 px-5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50' %>
    <%= form.submit t('admin.supplier_details.save'),
                    class: 'min-h-11 cursor-pointer rounded-xl bg-emerald-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-emerald-700' %>
  </footer>
<% end %>
