<div class="mx-auto max-w-3xl space-y-5">
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h1 class="font-jakarta text-xl font-bold text-slate-900"><%= t('admin.supplier_dossier.schedules') %></h1>
    <p class="mt-1 text-sm text-slate-500"><%= t('admin.supplier_calendar.scheduled') %></p>
  </div>
<%= form_with model: @schedule, url: @schedule.persisted? ? admin_supplier_schedule_path(@supplier, @schedule) : admin_supplier_schedules_path(@supplier), data: { turbo: false, loading_message: t('admin.action_loader.saving') }, class: 'grid gap-x-6 gap-y-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:grid-cols-2 sm:p-7' do |form| %>
  <%= hidden_field_tag :return_to, 'dossier' if params[:return_to] == 'dossier' %>
  <div class="min-w-0"><div class="min-w-0"><div data-controller="delta-select" class="relative">
    <%= form.label :branch_id, t('admin.supplier_dossier.branch'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
    <%= form.collection_select :branch_id, @branches, :id, :name, { include_blank: true }, required: true, class: "min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-3 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 #{form_state_classes(@schedule, :branch)}" %>
    </div>
    <%= error_message_for(@schedule, :branch) %>
  </div>
  <div class="min-w-0"><div data-controller="delta-select" class="relative">
    <%= form.label :kind, t('admin.supplier_dossier.kind'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
    <%= form.select :kind, SupplierSchedule::KINDS.map { |kind| [t("admin.supplier_dossier.kinds.#{kind}"), kind] }, {}, class: "min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-3 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 #{form_state_classes(@schedule, :kind)}" %>
    </div>
    <%= error_message_for(@schedule, :kind) %>
  </div>
  <div class="min-w-0"><div data-controller="delta-select" class="relative">
    <%= form.label :weekday, t('admin.supplier_dossier.weekday'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
    <%= form.select :weekday, (0..6).map { |day| [t('date.day_names')[day], day] }, {}, class: "min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-3 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 #{form_state_classes(@schedule, :weekday)}" %>
    </div>
    <%= error_message_for(@schedule, :weekday) %>
  </div>
  <% %i[starts_at ends_at].each do |field| %>
    <div class="min-w-0">
      <%= form.label field, t("admin.supplier_dossier.#{field}"), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
      <%= form.time_field field, required: field == :starts_at, class: "min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-3 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 #{form_state_classes(@schedule, field)}" %>
      <%= error_message_for(@schedule, field) %>
    </div>
  <% end %>
  <div class="sm:col-span-2">
    <%= form.label :notes, t('admin.supplier_dossier.notes'), class: 'mb-2 block text-sm font-semibold text-slate-700' %>
    <%= form.text_area :notes, rows: 3, maxlength: 1000, class: "min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-3 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 #{form_state_classes(@schedule, :notes)}" %>
    </div>
    <%= error_message_for(@schedule, :notes) %>
  </div>
  <div class="flex flex-wrap justify-end gap-3 border-t border-slate-100 pt-5 sm:col-span-2">
    <%= link_to t('admin.supplier_calendar.cancel'), admin_supplier_path(@supplier, tab: 'schedules'),
                data: { loading_message: t('admin.action_loader.returning') },
                class: 'inline-flex min-h-11 items-center rounded-xl border border-slate-200 px-5 text-sm font-semibold text-slate-700' %>
  <%= form.submit t('admin.supplier_details.save'), class: 'min-h-11 cursor-pointer rounded-xl bg-emerald-600 px-6 py-3 text-sm font-semibold text-white hover:bg-emerald-700' %>
  </div>
<% end %>
</div>
