<%= form_with model: @schedule, url: @schedule.persisted? ? admin_supplier_schedule_path(@supplier, @schedule) : admin_supplier_schedules_path(@supplier), data: { turbo: false }, class: 'space-y-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm' do |form| %>
  <div data-controller="delta-select" class="relative">
    <%= form.label :branch_id, t('admin.supplier_dossier.branch') %>
    <%= form.collection_select :branch_id, @branches, :id, :name, { include_blank: true }, required: true, class: "min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-3 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 #{form_state_classes(@schedule, :branch)}" %>
    <%= error_message_for(@schedule, :branch) %>
  </div>
  <div data-controller="delta-select" class="relative">
    <%= form.label :kind, t('admin.supplier_dossier.kind') %>
    <%= form.select :kind, SupplierSchedule::KINDS.map { |kind| [t("admin.supplier_dossier.kinds.#{kind}"), kind] }, {}, class: "min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-3 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 #{form_state_classes(@schedule, :kind)}" %>
    <%= error_message_for(@schedule, :kind) %>
  </div>
  <div data-controller="delta-select" class="relative">
    <%= form.label :weekday, t('admin.supplier_dossier.weekday') %>
    <%= form.select :weekday, (0..6).map { |day| [t('date.day_names')[day], day] }, {}, class: "min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-3 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 #{form_state_classes(@schedule, :weekday)}" %>
    <%= error_message_for(@schedule, :weekday) %>
  </div>
  <% %i[starts_at ends_at].each do |field| %>
    <div>
      <%= form.label field, t("admin.supplier_dossier.#{field}") %>
      <%= form.time_field field, required: field == :starts_at, class: "min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-3 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 #{form_state_classes(@schedule, field)}" %>
      <%= error_message_for(@schedule, field) %>
    </div>
  <% end %>
  <div>
    <%= form.label :notes, t('admin.supplier_dossier.notes') %>
    <%= form.text_area :notes, class: "min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50/60 px-4 py-3 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 #{form_state_classes(@schedule, :notes)}" %>
    <%= error_message_for(@schedule, :notes) %>
  </div>
  <%= form.submit t('admin.supplier_details.save'), class: 'min-h-11 cursor-pointer rounded-xl bg-emerald-600 px-6 py-3 text-sm font-semibold text-white hover:bg-emerald-700' %>
<% end %>
