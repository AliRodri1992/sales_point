<div class="space-y-6">
  <header class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700"><%= @supplier.code %> · <%= @supplier.name %></p>
      <h1 class="mt-1 font-jakarta text-2xl font-bold text-slate-900"><%= t('admin.supplier_dossier.schedules') %></h1>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= link_to t('admin.supplier_details.back'), admin_supplier_path(@supplier, tab: 'schedules'), class: 'inline-flex min-h-11 items-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50' %>
      <% if policy(@supplier).manage_schedules? %>
        <%= link_to t('admin.supplier_details.add'), new_admin_supplier_schedule_path(@supplier), class: 'inline-flex min-h-11 items-center rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-700' %>
      <% end %>
    </div>
  </header>
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% @schedules.each do |schedule| %>
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between gap-3">
          <h2 class="font-semibold text-slate-900"><%= schedule.branch.name %></h2>
          <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700"><%= t("admin.supplier_dossier.kinds.#{schedule.kind}") %></span>
        </div>
        <p class="mt-3 text-sm font-medium text-slate-700"><%= t('date.day_names')[schedule.weekday] %></p>
        <p class="mt-1 text-sm text-slate-600"><%= schedule.starts_at.strftime('%H:%M') %><% if schedule.ends_at.present? %>–<%= schedule.ends_at.strftime('%H:%M') %><% end %></p>
        <% if schedule.notes.present? %><p class="mt-3 text-sm text-slate-500"><%= schedule.notes %></p><% end %>
        <% if policy(@supplier).manage_schedules? %>
          <div class="mt-5 flex flex-wrap items-center gap-4 border-t border-slate-100 pt-4">
            <%= link_to t('admin.supplier_details.edit'), edit_admin_supplier_schedule_path(@supplier, schedule), class: 'text-sm font-semibold text-emerald-700 hover:underline' %>
            <%= button_to t('admin.supplier_details.delete'), admin_supplier_schedule_path(@supplier, schedule), method: :delete, form: { data: { turbo_confirm: t('admin.supplier_details.confirm') } }, class: 'text-sm font-semibold text-rose-600 hover:underline' %>
          </div>
        <% end %>
      </article>
    <% end %>
  </div>
  <% if policy(@supplier).manage_schedules? %>
    <section class="space-y-3 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="font-jakarta text-lg font-bold text-slate-900"><%= t('admin.supplier_schedule_exceptions.title') %></h2>
      <%= form_with url: admin_supplier_schedule_exceptions_path(@supplier),
                    scope: :supplier_schedule_exception, class: 'grid gap-3 md:grid-cols-2' do |form| %>
        <div>
          <%= form.label :starts_on, t('admin.supplier_schedule_exceptions.starts_on') %>
          <%= form.date_field :starts_on, required: true, class: 'mt-1 w-full rounded-xl border border-slate-200 p-3' %>
        </div>
        <div>
          <%= form.label :ends_on, t('admin.supplier_schedule_exceptions.ends_on') %>
          <%= form.date_field :ends_on, class: 'mt-1 w-full rounded-xl border border-slate-200 p-3' %>
        </div>
        <div>
          <%= form.label :reason, t('admin.supplier_schedule_exceptions.reason') %>
          <%= form.select :reason, SupplierScheduleException::REASONS.map { |value| [t("admin.supplier_schedule_exceptions.reasons.#{value}"), value] },
                          {}, class: 'mt-1 w-full rounded-xl border border-slate-200 p-3' %>
        </div>
        <div>
          <%= form.label :branch_id, t('admin.supplier_dossier.branch') %>
          <%= form.collection_select :branch_id, @branches, :id, :name,
                                     { include_blank: t('admin.supplier_schedule_exceptions.all_branches') },
                                     class: 'mt-1 w-full rounded-xl border border-slate-200 p-3' %>
        </div>
        <div>
          <%= form.label :supplier_schedule_id, t('admin.supplier_calendar.specific_schedule') %>
          <%= form.collection_select :supplier_schedule_id, @schedules, :id, :id,
                                     { include_blank: t('admin.supplier_calendar.all_schedules') },
                                     class: 'mt-1 w-full rounded-xl border border-slate-200 p-3' %>
        </div>
        <div class="md:col-span-2">
          <%= form.label :notes, t('admin.supplier_schedule_exceptions.notes') %>
          <%= form.text_area :notes, rows: 2, maxlength: 1000, class: 'mt-1 w-full rounded-xl border border-slate-200 p-3' %>
        </div>
        <%= form.submit t('admin.supplier_details.save'), class: 'w-fit cursor-pointer rounded-xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white' %>
      <% end %>
    </section>
  <% end %>
  <section class="space-y-3">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="font-jakarta text-lg font-bold text-slate-900"><%= t('admin.supplier_schedule_exceptions.title') %>
        (<%= @exceptions_total %>)</h2>
      <div class="flex gap-3 text-sm font-semibold text-emerald-800">
        <%= link_to t('admin.supplier_closure.active_records'),
                    admin_supplier_schedules_path(@supplier), class: 'hover:underline' %>
        <%= link_to t('admin.supplier_closure.archived_records'),
                    admin_supplier_schedules_path(@supplier, archived: '1'), class: 'hover:underline' %>
      </div>
    </div>
    <% if @exceptions.any? %>
      <%= form_with url: bulk_update_admin_supplier_schedule_exceptions_path(@supplier),
                    method: :patch, class: 'space-y-3' do %>
        <% if policy(@supplier).manage_schedules? %>
        <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white p-3">
          <label class="flex items-center gap-2 text-sm text-slate-700">
            <input type="checkbox" onchange="this.closest('form').querySelectorAll('[name=\u0022exception_ids[]\u0022]').forEach(element => element.checked = this.checked)">
            <%= t('admin.supplier_closure.select_all') %>
          </label>
          <%= hidden_field_tag :operation, @archived_exceptions ? 'restore' : 'archive' %>
          <%= submit_tag t(@archived_exceptions ? 'admin.supplier_closure.bulk_restore' :
                           'admin.supplier_closure.bulk_archive'), name: nil,
                         class: 'cursor-pointer rounded-lg bg-emerald-700 px-4 py-2 text-sm font-semibold text-white' %>
        </div>
        <% end %>
        <% @exceptions.each do |exception| %>
          <label class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4">
            <% if policy(@supplier).manage_schedules? %>
              <%= check_box_tag 'exception_ids[]', exception.id, false,
                                class: 'size-4 rounded border-slate-300 text-emerald-700' %>
            <% end %>
            <span class="text-sm text-slate-700">
              <%= t("admin.supplier_schedule_exceptions.reasons.#{exception.reason}") %>
              · <%= l(exception.starts_on) %>
              <% if exception.ends_on.present? %>–<%= l(exception.ends_on) %><% end %>
              · <%= exception.branch&.name || t('admin.supplier_schedule_exceptions.all_branches') %>
              <% if exception.notes.present? %>· <%= exception.notes %><% end %>
              <% if policy(@supplier).manage_schedules? && !@archived_exceptions %>
                <%= link_to t('admin.supplier_calendar.edit'),
                            edit_admin_supplier_schedule_exception_path(@supplier, exception),
                            class: 'ml-3 text-emerald-700 underline' %>
              <% end %>
            </span>
          </label>
        <% end %>
      <% end %>
    <% end %>
    <nav class="flex items-center justify-between text-sm text-slate-600">
      <span><%= @exceptions_page %> / <%= @exceptions_pages %></span>
      <div class="flex gap-2">
        <% if @exceptions_page > 1 %>
          <%= link_to '‹', admin_supplier_schedules_path(@supplier, archived: params[:archived],
                                                         page: @exceptions_page - 1),
                      class: 'rounded-lg border border-slate-200 px-4 py-2' %>
        <% end %>
        <% if @exceptions_page < @exceptions_pages %>
          <%= link_to '›', admin_supplier_schedules_path(@supplier, archived: params[:archived],
                                                         page: @exceptions_page + 1),
                      class: 'rounded-lg border border-slate-200 px-4 py-2' %>
        <% end %>
      </div>
    </nav>
  </section>
  <% if @schedules.empty? %>
    <div class="rounded-2xl border border-dashed border-slate-200 bg-white p-10 text-center text-sm text-slate-500">—</div>
  <% end %>
</div>
  <% deleted_schedules = @supplier.supplier_schedules.with_deleted.where.not(deleted_at: nil).includes(:branch) %>
  <% if deleted_schedules.any? %>
    <section class="space-y-3">
      <h2 class="font-jakarta text-lg font-bold text-slate-900"><%= t('admin.supplier_details.deleted_records') %></h2>
      <% deleted_schedules.each do |schedule| %>
        <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-sm text-slate-600"><%= schedule.branch.name %> · <%= t("admin.supplier_dossier.kinds.#{schedule.kind}") %></p>
          <% if policy(@supplier).manage_schedules? %>
            <%= button_to t('admin.supplier_details.restore'), restore_admin_supplier_schedule_path(@supplier, schedule),
                          method: :patch, class: 'rounded-lg border border-emerald-200 bg-white px-4 py-2 text-sm font-semibold text-emerald-700' %>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>
