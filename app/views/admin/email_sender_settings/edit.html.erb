<main class="mx-auto max-w-3xl space-y-6 p-6">
  <%= link_to t('admin.email_templates.back'), admin_email_templates_path, class: 'text-sm text-emerald-700' %>
  <h1 class="font-jakarta text-2xl font-bold"><%= t('admin.email_templates.sender') %></h1>
  <%= form_with model: @sender, url: admin_email_sender_settings_path, method: :patch, class: 'space-y-4 rounded-2xl border border-slate-200 bg-white p-6' do |f| %>
    <% @sender.errors.full_messages.each do |message| %><p role="alert" class="text-sm text-rose-700"><%= message %></p><% end %>
    <% %i[display_name from_address reply_to].each do |attribute| %>
      <div><%= f.label attribute, attribute.to_s.humanize, class: 'mb-1 block text-sm font-semibold' %>
        <%= f.text_field attribute, class: 'w-full rounded-xl border border-slate-300 p-3' %></div>
    <% end %>
    <div><%= f.label :default_locale, t('admin.email_templates.columns.locale'), class: 'mb-1 block text-sm font-semibold' %>
      <%= f.select :default_locale, [['Español', 'es'], ['English', 'en'], ['한국어', 'ko']], {}, class: 'w-full rounded-xl border border-slate-300 p-3' %></div>
    <%= f.submit t('admin.email_templates.save'), class: 'cursor-pointer rounded-xl bg-emerald-700 px-5 py-3 font-semibold text-white' %>
  <% end %>
</main>
