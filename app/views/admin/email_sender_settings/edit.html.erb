<main class="mx-auto max-w-5xl space-y-5 px-4 pb-8 pt-4 sm:px-6 sm:pt-6" data-loading-scope="true">
  <header class="flex flex-wrap items-start justify-between gap-4 flex">
    <div class="min-w-0 flex-[1_1_20rem]">
      <p class="text-xs font-bold uppercase tracking-widest text-emerald-700"><%= t('admin.email_templates.section') %></p>
      <h1 class="mt-1 font-jakarta text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"><%= t('admin.email_templates.sender') %></h1>
      <p class="mt-2 text-sm leading-6 text-slate-500"><%= t('admin.email_templates.sender_intro') %></p>
    </div>
    <%= render 'admin/email_templates/back_button', path: admin_email_templates_path %>
  </header>

  <%= form_with model: @sender, url: admin_email_sender_settings_path, method: :patch,
                class: 'overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm' do |f| %>
    <% if @sender.errors.any? %>
      <div role="alert" class="m-5 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800">
        <p class="font-bold"><%= t('admin.email_templates.correct_errors') %></p>
        <ul class="mt-2 list-disc pl-5"><% @sender.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>
    <div class="border-b border-slate-100 px-5 py-4 sm:px-6">
      <h2 class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.sender_identity_title') %></h2>
      <p class="mt-1 text-sm text-slate-500"><%= t('admin.email_templates.sender_identity_hint') %></p>
    </div>
    <div class="grid gap-5 px-5 py-6 sm:grid-cols-2 sm:px-6">
      <% %i[display_name from_address reply_to].each do |field| %>
        <div class="<%= field == :display_name ? 'sm:col-span-2' : '' %>">
          <%= f.label field, t("admin.email_templates.settings_fields.#{field}"), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
          <% if field == :display_name %>
            <%= f.text_field field, maxlength: 150, class: 'min-h-11 w-full rounded-xl border border-slate-300 px-4 text-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100' %>
          <% else %>
            <%= f.email_field field, maxlength: 254, autocomplete: 'email',
                              class: 'min-h-11 w-full rounded-xl border border-slate-300 px-4 text-sm focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100' %>
          <% end %>
          <%= error_message_for(@sender, field) %>
        </div>
      <% end %>
      <div class="sm:col-span-2">
        <%= f.label :default_locale, t('admin.email_templates.settings_fields.default_locale'), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
        <div class="relative" data-controller="delta-select" data-searchable="false">
          <%= f.select :default_locale, %w[es en ko].map { |code| [t("admin.email_templates.languages.#{code}"), code] },
                       {}, class: 'min-h-11 w-full rounded-xl border border-slate-300 px-3 text-sm' %>
        </div>
        <%= error_message_for(@sender, :default_locale) %>
      </div>
    </div>
    <footer class="flex justify-end border-t border-slate-100 bg-slate-50/70 px-5 py-4 sm:px-6">
      <%= f.submit t('admin.email_templates.save'),
                   class: 'min-h-11 cursor-pointer rounded-xl bg-emerald-700 px-5 text-sm font-semibold text-white hover:bg-emerald-800' %>
    </footer>
  <% end %>
  <%= render 'admin/email_setting_audits/history', audits: @audits %>
</main>
