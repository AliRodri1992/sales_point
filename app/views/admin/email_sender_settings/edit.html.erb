<% content_for :title, t('admin.email_templates.sender') %>
<% sender_status = @sender_ready ? 'verified' : @sender.domain_status == 'verified' ? 'mismatch' : @sender.domain_status.to_s %>
<% status_tone = @sender_ready ? 'border-emerald-200 bg-emerald-50 text-emerald-800' : 'border-amber-200 bg-amber-50 text-amber-800' %>

<main class="mx-auto max-w-[1560px] space-y-6 px-4 pb-10 pt-4 sm:px-6 sm:pt-6" data-loading-scope="true">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0 flex-[1_1_20rem]">
      <p class="text-xs font-bold uppercase tracking-[.16em] text-emerald-700"><%= t('admin.email_templates.section') %></p>
      <h1 class="mt-1 font-jakarta text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"><%= t('admin.email_templates.sender') %></h1>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600"><%= t('admin.email_templates.sender_intro') %></p>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-bold <%= status_tone %>">
          <%= delta_icon(@sender_ready ? 'check-circle' : 'information-circle', class: 'size-4') %>
          <%= t("admin.email_templates.sender_status.#{sender_status}", default: t('admin.email_templates.sender_status.unverified')) %>
        </span>
        <span class="inline-flex rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-600">
          <%= t('admin.email_templates.sender_organization_scope') %>
        </span>
      </div>
    </div>
    <%= render 'admin/email_templates/back_button', path: admin_email_templates_path %>
  </header>

  <section class="flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white px-5 py-4 shadow-sm sm:flex-row sm:items-start sm:gap-4 sm:px-6" aria-labelledby="sender-delivery-title">
    <span class="flex size-11 shrink-0 items-center justify-center rounded-xl <%= @sender_ready ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-800' %>">
      <%= delta_icon(@sender_ready ? 'shield-check' : 'exclamation-circle', class: 'size-6') %>
    </span>
    <div class="min-w-0">
      <h2 id="sender-delivery-title" class="font-jakarta text-sm font-bold text-slate-900"><%= t('admin.email_templates.sender_delivery_title') %></h2>
      <p class="mt-1 text-sm leading-6 text-slate-600">
        <%= t(@sender_ready ? 'admin.email_templates.sender_delivery_ready' :
              @global_sender_ready ? 'admin.email_templates.sender_delivery_global' : 'admin.email_templates.sender_delivery_default') %>
      </p>
    </div>
  </section>

  <%= form_with model: @sender, url: admin_email_sender_settings_path, method: :patch, html: { novalidate: true },
                class: 'grid min-w-0 items-start gap-5 xl:grid-cols-[minmax(0,1.35fr)_minmax(320px,0.85fr)]',
                data: { controller: 'email-sender',
                        email_sender_default_name_value: 'Delta POS',
                        email_sender_default_from_value: t('admin.email_templates.sender_preview_address_placeholder'),
                        email_sender_default_reply_value: t('admin.email_templates.sender_preview_reply_placeholder'),
                        email_sender_default_domain_value: t('admin.email_templates.sender_domain_unavailable') } do |f| %>
    <div class="min-w-0 space-y-5">

      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="sender-identity-title">
        <header class="flex items-start gap-3 border-b border-slate-100 px-5 py-4 sm:px-6">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><%= delta_icon('envelope', class: 'size-5') %></span>
          <div class="min-w-0">
            <h2 id="sender-identity-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.sender_identity_title') %></h2>
            <p class="mt-1 text-xs leading-5 text-slate-600"><%= t('admin.email_templates.sender_identity_hint') %></p>
          </div>
        </header>
        <div class="grid gap-5 p-5 sm:grid-cols-2 sm:p-6">
          <div class="sm:col-span-2">
            <%= f.label :display_name, required_field_label(t('admin.email_templates.settings_fields.display_name')), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
            <%= f.text_field :display_name, maxlength: 150, autocomplete: 'organization',
                             data: { email_sender_target: 'name', action: 'input->email-sender#updatePreview' },
                             aria: { invalid: @sender.errors[:display_name].any? },
                             class: "min-h-11 w-full rounded-xl border bg-white px-4 text-sm focus:ring-2 #{ @sender.errors[:display_name].any? ? 'border-rose-400 focus:border-rose-500 focus:ring-rose-100' : 'border-slate-300 focus:border-emerald-500 focus:ring-emerald-100' }" %>
            <%= error_message_for(@sender, :display_name, label: t('admin.email_templates.settings_fields.display_name')) %>
            <p class="mt-1.5 text-xs leading-5 text-slate-500"><%= t('admin.email_templates.sender_name_hint') %></p>
          </div>
          <div class="min-w-0">
            <%= f.label :from_address, required_field_label(t('admin.email_templates.settings_fields.from_address')), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
            <%= f.email_field :from_address, maxlength: 254, autocomplete: 'email', inputmode: 'email',
                              placeholder: t('admin.email_templates.sender_from_example'),
                              data: { email_sender_target: 'from', action: 'input->email-sender#updatePreview' },
                              aria: { invalid: @sender.errors[:from_address].any? },
                              class: "min-h-11 w-full rounded-xl border bg-white px-4 text-sm focus:ring-2 #{ @sender.errors[:from_address].any? ? 'border-rose-400 focus:border-rose-500 focus:ring-rose-100' : 'border-slate-300 focus:border-emerald-500 focus:ring-emerald-100' }" %>
            <%= error_message_for(@sender, :from_address, label: t('admin.email_templates.settings_fields.from_address')) %>
            <p class="mt-1.5 text-xs leading-5 text-slate-500"><%= t('admin.email_templates.sender_from_hint') %></p>
          </div>
          <div class="min-w-0">
            <%= f.label :reply_to, t('admin.email_templates.settings_fields.reply_to'), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
            <%= f.email_field :reply_to, maxlength: 254, autocomplete: 'email', inputmode: 'email',
                              placeholder: t('admin.email_templates.sender_reply_example'),
                              data: { email_sender_target: 'reply', action: 'input->email-sender#updatePreview' },
                              aria: { invalid: @sender.errors[:reply_to].any? },
                              class: "min-h-11 w-full rounded-xl border bg-white px-4 text-sm focus:ring-2 #{ @sender.errors[:reply_to].any? ? 'border-rose-400 focus:border-rose-500 focus:ring-rose-100' : 'border-slate-300 focus:border-emerald-500 focus:ring-emerald-100' }" %>
            <%= error_message_for(@sender, :reply_to, label: t('admin.email_templates.settings_fields.reply_to')) %>
            <p class="mt-1.5 text-xs leading-5 text-slate-500"><%= t('admin.email_templates.sender_reply_hint') %></p>
          </div>
        </div>
      </section>

      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="sender-preferences-title">
        <header class="flex items-start gap-3 border-b border-slate-100 px-5 py-4 sm:px-6">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><%= delta_icon('language', class: 'size-5') %></span>
          <div>
            <h2 id="sender-preferences-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.sender_preferences_title') %></h2>
            <p class="mt-1 text-xs leading-5 text-slate-600"><%= t('admin.email_templates.sender_preferences_hint') %></p>
          </div>
        </header>
        <div class="grid gap-5 p-5 sm:grid-cols-2 sm:p-6">
          <div class="min-w-0">
            <%= f.label :default_locale, required_field_label(t('admin.email_templates.settings_fields.default_locale')), class: 'mb-1.5 block text-sm font-semibold text-slate-700' %>
            <div data-controller="delta-select" data-searchable="false">
              <%= f.select :default_locale, %w[es en ko].map { |code| [t("admin.email_templates.languages.#{code}"), code] },
                           {}, data: { email_sender_target: 'locale', action: 'change->email-sender#updatePreview' },
                           aria: { invalid: @sender.errors[:default_locale].any? },
                           class: 'min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm' %>
            </div>
            <%= error_message_for(@sender, :default_locale, label: t('admin.email_templates.settings_fields.default_locale')) %>
            <p class="mt-1.5 text-xs leading-5 text-slate-500"><%= t('admin.email_templates.sender_locale_hint') %></p>
          </div>
          <div class="min-w-0">
            <p class="mb-1.5 text-sm font-semibold text-slate-700"><%= t('admin.email_templates.sender_domain_label') %></p>
            <div class="flex min-h-11 items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm font-medium text-slate-700">
              <%= delta_icon('shield-check', class: 'size-4 shrink-0 text-slate-400') %>
              <span class="min-w-0 truncate" title="<%= @sender.domain.presence || t('admin.email_templates.sender_domain_unavailable') %>"><%= @sender.domain.presence || t('admin.email_templates.sender_domain_unavailable') %></span>
            </div>
            <p class="mt-1.5 text-xs leading-5 text-slate-500"><%= t('admin.email_templates.sender_domain_readonly') %></p>
          </div>
        </div>
      </section>

      <footer class="flex flex-wrap items-center justify-end gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
        <%= link_to t('admin.email_templates.cancel'), admin_email_templates_path,
                    class: 'inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-200 bg-white px-5 text-sm font-semibold text-slate-700 hover:bg-slate-50' %>
        <%= f.submit t('admin.email_templates.save'),
                     class: 'inline-flex min-h-11 cursor-pointer items-center justify-center rounded-xl bg-emerald-700 px-6 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600' %>
      </footer>
    </div>

    <aside class="min-w-0 space-y-5 xl:sticky xl:top-6" aria-label="<%= t('admin.email_templates.sender_preview_title') %>">
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="sender-preview-title">
        <header class="flex items-start gap-3 border-b border-slate-100 px-5 py-4">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><%= delta_icon('eye', class: 'size-5') %></span>
          <div>
            <h2 id="sender-preview-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.sender_preview_title') %></h2>
            <p class="mt-1 text-xs leading-5 text-slate-600"><%= t('admin.email_templates.sender_preview_hint') %></p>
          </div>
        </header>
        <div class="bg-slate-50 p-4 sm:p-5">
          <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-100 bg-slate-50/80 px-4 py-3">
              <span class="text-xs font-semibold text-slate-600"><%= t('admin.email_templates.sender_preview_example') %></span>
            </div>
            <dl class="space-y-4 px-4 py-5 text-sm">
              <div class="grid grid-cols-[minmax(85px,auto)_minmax(0,1fr)] items-start gap-3">
                <dt class="text-xs font-semibold text-slate-500"><%= t('admin.email_templates.sender_preview_from') %></dt>
                <dd class="min-w-0 break-words font-semibold text-slate-900">
                  <span data-email-sender-target="previewName"><%= @sender.display_name.presence || 'Delta POS' %></span>
                  <span class="block break-all text-xs font-normal text-slate-500" data-email-sender-target="previewFrom"><%= @sender.from_address.presence || t('admin.email_templates.sender_preview_address_placeholder') %></span>
                </dd>
              </div>
              <div class="grid grid-cols-[minmax(85px,auto)_minmax(0,1fr)] items-start gap-3">
                <dt class="text-xs font-semibold text-slate-500"><%= t('admin.email_templates.sender_preview_reply') %></dt>
                <dd class="min-w-0 break-all text-xs font-medium text-slate-700" data-email-sender-target="previewReply"><%= @sender.reply_to.presence || t('admin.email_templates.sender_preview_reply_placeholder') %></dd>
              </div>
              <div class="grid grid-cols-[minmax(85px,auto)_minmax(0,1fr)] items-start gap-3">
                <dt class="text-xs font-semibold text-slate-500"><%= t('admin.email_templates.sender_preview_language') %></dt>
                <dd class="min-w-0 text-xs font-medium text-slate-700" data-email-sender-target="previewLocale"><%= t("admin.email_templates.languages.#{@sender.default_locale}") %></dd>
              </div>
            </dl>
          </div>
        </div>
        <div class="border-t border-slate-100 px-5 py-4">
          <p class="flex items-center gap-2 text-xs font-semibold text-slate-600">
            <%= delta_icon('information-circle', class: 'size-4 shrink-0 text-emerald-700') %>
            <%= t('admin.email_templates.sender_preview_disclaimer') %>
          </p>
        </div>
      </section>

      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="sender-verification-title">
        <header class="flex items-start gap-3 border-b border-slate-100 px-5 py-4">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><%= delta_icon('shield-check', class: 'size-5') %></span>
          <div>
            <h2 id="sender-verification-title" class="font-jakarta text-base font-bold text-slate-900"><%= t('admin.email_templates.sender_verification_title') %></h2>
            <p class="mt-1 text-xs leading-5 text-slate-600"><%= t('admin.email_templates.sender_verification_hint') %></p>
          </div>
        </header>
        <div class="space-y-4 px-5 py-5 text-sm">
          <div class="flex items-start justify-between gap-3">
            <span class="text-slate-600"><%= t('admin.email_templates.sender_status_label') %></span>
            <span class="shrink-0 rounded-full border px-2.5 py-1 text-xs font-bold <%= status_tone %>"><%= t("admin.email_templates.sender_status.#{sender_status}", default: t('admin.email_templates.sender_status.unverified')) %></span>
          </div>
          <div class="flex items-start justify-between gap-3">
            <span class="text-slate-600"><%= t('admin.email_templates.sender_preview_domain') %></span>
            <span class="max-w-[55%] break-all text-right font-semibold text-slate-800" data-email-sender-target="previewDomain"><%= @sender.from_address.to_s.split('@').last.presence || t('admin.email_templates.sender_domain_unavailable') %></span>
          </div>
          <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-3">
              <h3 class="text-xs font-bold text-slate-800"><%= t('admin.email_templates.sender_domain_setup_title') %></h3>
              <p class="mt-1 text-xs leading-5 text-slate-600"><%= t('admin.email_templates.sender_verification_disclaimer') %></p>
              <p class="mt-2 text-xs leading-5 text-slate-600"><%= t('admin.email_templates.sender_domain_setup_hint') %></p>
            </div>
        </div>
      </section>
    </aside>
  <% end %>

  <%= render 'admin/email_setting_audits/history', audits: @audits if @can_view_audits %>
</main>
