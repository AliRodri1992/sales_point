<% content_for :title, t('admin.subscriptions.show.title') %>
<div>
  <div class="mb-7 flex items-start justify-between gap-4">
    <div><h1 class="font-jakarta text-2xl font-bold text-slate-900"><%= @subscription.organization.name %></h1><p class="mt-1 text-sm text-slate-500"><%= @subscription.membership_plan.name %></p></div>
    <div class="flex gap-2"><%= link_to t('admin.subscriptions.show.back'), admin_subscriptions_path, class: 'rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700' %><%= link_to t('admin.subscriptions.edit.title'), edit_admin_subscription_path(@subscription), class: 'rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white' %></div>
  </div>
  <div class="grid gap-6 lg:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-400"><%= t('admin.subscriptions.show.status') %></p>
      <p class="mt-2 text-xl font-bold text-slate-900"><%= t("admin.subscriptions.statuses.#{@subscription.status}") %></p>
      <dl class="mt-5 space-y-3 text-sm">
        <div><dt class="text-slate-400"><%= t('admin.subscriptions.show.starts_at') %></dt><dd><%= l(@subscription.starts_at, format: :short) %></dd></div>
        <div><dt class="text-slate-400"><%= t('admin.subscriptions.show.ends_at') %></dt><dd><%= @subscription.ends_at ? l(@subscription.ends_at, format: :short) : '—' %></dd></div>
        <div><dt class="text-slate-400"><%= t('admin.subscriptions.show.trial_ends_at') %></dt><dd><%= @subscription.trial_ends_at ? l(@subscription.trial_ends_at, format: :short) : '—' %></dd></div>
        <% if @subscription.trial? %><div><dt class="text-slate-400"><%= t('admin.subscriptions.show.days_remaining') %></dt><dd><%= @subscription.trial_days_remaining %></dd></div><% end %>
      </dl>
      <div class="mt-6 rounded-xl border border-slate-100 bg-slate-50 p-4">
        <p class="mb-3 text-sm font-semibold text-slate-700"><%= t('admin.subscriptions.show.change_plan') %></p>
        <%= form_with url: change_plan_admin_subscription_path(@subscription), method: :patch, class: 'flex gap-2' do %>
          <%= select_tag :membership_plan_id, options_from_collection_for_select(MembershipPlan.where(deleted_at: nil).order(:position), :id, :name, @subscription.membership_plan_id), class: 'flex-1 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm' %>
          <%= submit_tag t('admin.subscriptions.show.change_plan'), class: 'rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white' %>
        <% end %>
      </div>
      <div class="mt-6 flex flex-wrap gap-2">
        <% if @subscription.active_or_trialing? %>
          <%= button_to t('admin.subscriptions.show.pause'), pause_admin_subscription_path(@subscription), method: :patch, class: 'rounded-lg border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700' %>
          <%= button_to t('admin.subscriptions.show.cancel'), cancel_admin_subscription_path(@subscription), method: :patch, class: 'rounded-lg bg-rose-600 px-3 py-2 text-sm font-semibold text-white' %>
        <% elsif @subscription.paused? %>
          <%= button_to t('admin.subscriptions.show.resume'), resume_admin_subscription_path(@subscription), method: :patch, class: 'rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white' %>
        <% end %>
      </div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-2">
      <h2 class="text-base font-semibold text-slate-800"><%= t('admin.subscriptions.show.features') %></h2>
      <div class="mt-4 divide-y divide-slate-100">
        <% @subscription.membership_plan.membership_plan_features.includes(:membership_feature).where(deleted_at: nil).each do |feature| %>
          <div class="flex items-center justify-between gap-4 py-3"><span class="text-sm font-medium text-slate-700"><%= feature.membership_feature.name %></span><span class="text-sm text-slate-500"><%= feature.limit || (feature.value == 'unlimited' ? t('admin.membership_plans.show.unlimited') : feature.enabled? ? '✓' : '—') %></span></div>
        <% end %>
      </div>
    </div>
  </div>
  <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-base font-semibold text-slate-800"><%= t('admin.subscriptions.show.events') %></h2>
    <div class="mt-4 divide-y divide-slate-100">
      <% @events.each do |event| %>
        <div class="py-3 text-sm"><span class="font-semibold text-slate-800"><%= event.event_type.humanize %></span><span class="ml-2 text-slate-500"><%= event.created_at.to_fs(:short) %></span><p class="mt-1 text-slate-500"><%= event.description %></p></div>
      <% end %>
    </div>
  </div>
</div>
