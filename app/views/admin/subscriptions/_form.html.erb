<div class="max-w-4xl rounded-xl border border-slate-200 bg-white shadow-sm">
  <%= form_with model: @subscription, class: 'space-y-6 p-6 lg:p-8' do |form| %>
    <div>
      <%= form.label :organization_id, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
      <%= form.collection_select :organization_id, @organizations, :id, :name, { prompt: 'Selecciona una organización' }, class: "input-field w-full rounded-xl #{form_state_classes(@subscription, :organization)} border px-4 py-3 text-sm" %>
      <%= error_message_for(@subscription, :organization) %>
    </div>
    <div>
      <%= form.label :membership_plan_id, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
      <%= form.collection_select :membership_plan_id, @membership_plans, :id, :name, { prompt: 'Selecciona un plan' }, class: "input-field w-full rounded-xl #{form_state_classes(@subscription, :membership_plan)} border px-4 py-3 text-sm" %>
      <%= error_message_for(@subscription, :membership_plan) %>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :status, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.select :status, Subscription.statuses.keys.map { |status| [t("admin.subscriptions.statuses.#{status}"), status] }, {}, class: 'input-field w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm' %>
        <%= error_message_for(@subscription, :status) %>
      </div>
      <div>
        <%= form.label :starts_at, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.datetime_local_field :starts_at, class: "input-field w-full rounded-xl #{form_state_classes(@subscription, :starts_at)} px-4 py-3 text-sm" %>
        <%= error_message_for(@subscription, :starts_at) %>
      </div>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :ends_at, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.datetime_local_field :ends_at, class: "input-field w-full rounded-xl #{form_state_classes(@subscription, :ends_at)} px-4 py-3 text-sm" %>
        <%= error_message_for(@subscription, :ends_at) %>
      </div>
      <div>
        <%= form.label :trial_ends_at, class: 'mb-2 block text-sm font-semibold text-slate-700' %>
        <%= form.datetime_local_field :trial_ends_at, class: "input-field w-full rounded-xl #{form_state_classes(@subscription, :trial_ends_at)} px-4 py-3 text-sm" %>
        <%= error_message_for(@subscription, :trial_ends_at) %>
      </div>
    </div>
    <div class="flex justify-end border-t border-slate-100 pt-5">
      <%= form.submit submit_label, class: 'rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700' %>
    </div>
  <% end %>
</div>
