<div class="space-y-6">
  <%= link_to t('admin.procurement.back'), admin_supplier_supplier_products_path(@supplier),
              class: 'text-sm font-semibold text-emerald-700 hover:underline' %>
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h1 class="font-jakarta text-2xl font-bold"><%= t('admin.procurement.compare') %>: <%= @product.name %></h1>
    <p class="mt-2 text-sm text-slate-500"><%= t('admin.procurement.currency_warning') %></p>
  </div>
  <% @currency_groups.each do |code, entries| %>
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <h2 class="bg-slate-50 p-4 font-semibold"><%= code %></h2>
      <table class="min-w-full divide-y divide-slate-100 text-left text-sm">
        <thead><tr>
          <% %w[supplier presentation unit_cost lead_time_days preferred].each do |column| %>
            <th class="p-4"><%= t("admin.procurement.#{column}") %></th>
          <% end %>
        </tr></thead>
        <tbody>
          <% entries.each do |entry| %>
            <tr class="border-t border-slate-100">
              <td class="p-4"><%= entry[:offer].supplier.name %></td>
              <td class="p-4"><%= entry[:offer].presentation_name %> × <%= entry[:offer].units_per_package %></td>
              <td class="p-4 font-semibold"><%= entry[:cost_per_unit] %> <%= code %></td>
              <td class="p-4"><%= entry[:lead_time_days] %></td>
              <td class="p-4"><%= entry[:preferred] ? t('admin.procurement.yes') : '—' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>
  <% if @currency_groups.empty? %><p class="text-sm text-slate-500"><%= t('admin.procurement.empty') %></p><% end %>
</div>
