<dl id="branch-overview" class="branch-overview"
    aria-label="<%= t('admin.branch_workspace.overview') %>">
  <div class="branch-overview-item">
    <dt class="text-sm font-medium text-slate-600"><%= t('admin.catalog_design.total') %></dt>
    <dd class="font-jakarta text-base font-bold tabular-nums text-slate-900"><%= @branch_counts.values.sum %></dd>
  </div>
  <% %w[preparing active suspended closed].each do |state| %>
    <div class="branch-overview-divider" aria-hidden="true"></div>
    <div class="branch-overview-item">
      <dt class="branch-overview-label"><%= t("admin.branch_lifecycle.statuses.#{state}") %></dt>
      <dd class="font-jakarta text-sm font-bold tabular-nums"><%= @branch_counts.fetch(state, 0) %></dd>
    </div>
  <% end %>
</dl>
