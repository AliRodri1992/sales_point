<div class="catalog-workspace branch-workspace">
  <header class="catalog-header branch-form-header">
    <div class="branch-form-header-copy">
      <p class="catalog-eyebrow"><%= t('admin.branch_workspace.eyebrow') %></p>
      <h1><%= title %></h1>
      <p><%= t('admin.branch_workspace.form_intro') %></p>
    </div>
    <%= link_to branch_directory_path, class: 'catalog-button branch-form-back' do %>
      <%= delta_icon('arrow-left', class: 'size-4') %>
      <%= t('admin.branches.form.buttons.back') %>
    <% end %>
  </header>
  <%= form_with model: @branch, url: @branch.persisted? ? admin_branch_path(@branch, branch_directory_parameters) : admin_branches_path(branch_directory_parameters), class: 'catalog-layout branch-form-layout', data: { turbo: false } do |form| %>
    <div class="catalog-main branch-form-main">
      <%= catalog_errors(@branch) %>
      <nav class="catalog-nav branch-form-nav" aria-label="<%= t('admin.catalog_design.sections') %>"><% %w[identity contact location notes].each do |section| %><a href="#branch-<%= section %>"><%= t("admin.branch_workspace.#{section}") %></a><% end %></nav>
      <section class="catalog-card branch-form-section" id="branch-identity"><%= catalog_heading(t('admin.branch_workspace.identity'), t('admin.branch_workspace.identity_hint'), icon: 'building-storefront') %><div class="catalog-card-body catalog-fields">
        <div class="catalog-full"><%= catalog_field(form, :name, label: t('admin.branches.form.fields.name'), required: true, maxlength: 100, autocomplete: 'organization') %></div>
        <div><%= catalog_field(form, :code, label: t('admin.branch_workspace.code'), maxlength: 30, pattern: '[A-Za-z0-9_-]{1,30}', autocomplete: 'off', placeholder: t('admin.branch_workspace.code_placeholder')) %><p class="catalog-hint"><%= t('admin.branch_workspace.code_hint') %></p></div>
        <label class="catalog-toggle branch-status-card"><%= form.check_box :status %><span><strong><%= t('admin.branches.form.status.active') %></strong><small><%= t('admin.branch_workspace.status_hint') %></small></span></label>
      </div></section>
      <section class="catalog-card branch-form-section" id="branch-contact"><%= catalog_heading(t('admin.branch_workspace.contact'), t('admin.branch_workspace.contact_hint'), icon: 'phone') %><div class="catalog-card-body catalog-fields">
        <%= render 'phone_fields', form: form %>
        <div><%= catalog_field(form, :contact_email, type: :email_field, label: t('admin.branch_workspace.contact_email'), maxlength: 254, autocomplete: 'email') %><p class="catalog-hint"><%= t('admin.branch_workspace.email_hint') %></p></div>
      </div></section>
      <section class="catalog-card branch-form-section" id="branch-location">
        <%= catalog_heading(t('admin.branch_workspace.location'), t('admin.branch_workspace.location_hint'), icon: 'map-pin') %>
        <div class="catalog-card-body">
          <%= form.fields_for :address do |address_form| %>
            <%= address_form.hidden_field :id if address_form.object.persisted? %>
            <div class="catalog-fields" data-controller="branch-address supplier-postal-assist supplier-country-fields"
                 data-action="input->supplier-country-fields#rememberDraft input->supplier-postal-assist#input change->supplier-postal-assist#input change->supplier-country-fields#update change->branch-address#update"
                 data-supplier-country-fields-state-required-codes-value="<%= Addresses::CountryRules::STATE_REQUIRED.to_json %>"
                 data-supplier-postal-assist-url-value="<%= postal_suggestions_admin_branches_path %>"
                 data-supplier-postal-assist-choice-placeholder-value="<%= t('admin.supplier_details.postal_choose_neighborhood') %>"
                 data-supplier-postal-assist-loading-value="<%= t('admin.supplier_details.address_form.postal_loading') %>"
                 data-supplier-postal-assist-available-value="<%= t('admin.supplier_details.address_form.postal_available') %>"
                 data-supplier-postal-assist-not-found-value="<%= t('admin.supplier_details.address_form.postal_not_found') %>"
                 data-supplier-postal-assist-unavailable-value="<%= t('admin.supplier_details.address_form.postal_unavailable') %>">
              <div class="catalog-field">
                <%= address_form.label :country_id, t('admin.branches.form.fields.country') %>
                <div data-controller="delta-select" data-country-flags="true" data-search-placeholder="<%= t('admin.country_select.search') %>">
                  <%= address_form.select :country_id, options_for_select(branch_country_options(address_form.object), address_form.object.country_id),
                      { include_blank: t('admin.supplier_placeholders.country') },
                      required: true, data: { branch_address_target: 'country', supplier_postal_field: 'country_id' } %>
                </div>
                <%= error_message_for(address_form.object, :country) %>
              </div>
              <div class="catalog-field" data-country-postal-wrapper>
                <%= address_form.label :postal_code do %>
                  <span data-country-label
                        data-country-label-mx="<%= t('admin.supplier_details.address_form.country_labels.postal_code.mx') %>"
                        data-country-label-other="<%= t('admin.supplier_details.address_form.country_labels.postal_code.other') %>"><%= t('admin.supplier_details.address_form.country_labels.postal_code.mx') %></span>
                  <span data-required-when="postal" class="text-rose-600" aria-hidden="true">*</span>
                <% end %>
                <%= address_form.text_field :postal_code, maxlength: 10, autocomplete: 'postal-code', inputmode: 'text',
                    data: { branch_address_target: 'field', branch_attribute: 'postal_code', supplier_postal_field: 'postal_code' } %>
                <%= error_message_for(address_form.object, :postal_code) %>
                <p class="catalog-hint" data-supplier-postal-assist-target="status" aria-live="polite"></p>
              </div>
              <% %i[state city].each do |attribute| %>
                <div class="catalog-field">
                  <%= address_form.label attribute do %>
                    <span data-country-label
                          data-country-label-mx="<%= t("admin.supplier_details.address_form.country_labels.#{attribute}.mx") %>"
                          data-country-label-other="<%= t("admin.supplier_details.address_form.country_labels.#{attribute}.other") %>"><%= t("admin.supplier_details.address_form.country_labels.#{attribute}.mx") %></span>
                    <span data-required-when="<%= attribute == :city ? 'always' : 'state' %>" class="text-rose-600" aria-hidden="true">*</span>
                  <% end %>
                  <%= address_form.text_field attribute, maxlength: 100, autocomplete: attribute == :state ? 'address-level1' : 'address-level2',
                      data: { branch_address_target: 'field', branch_attribute: attribute, supplier_postal_field: attribute } %>
                  <%= error_message_for(address_form.object, attribute) %>
                </div>
              <% end %>
              <div class="catalog-field" data-address-field="neighborhood">
                <%= address_form.label :neighborhood do %>
                  <span data-country-label
                        data-country-label-mx="<%= t('admin.supplier_details.address_form.country_labels.neighborhood.mx') %>"
                        data-country-label-other="<%= t('admin.supplier_details.address_form.country_labels.neighborhood.other') %>"><%= t('admin.supplier_details.address_form.country_labels.neighborhood.mx') %></span>
                  <span data-required-when="mx" class="text-rose-600" aria-hidden="true">*</span>
                <% end %>
                <%= address_form.text_field :neighborhood, maxlength: 100, list: 'branch-neighborhoods',
                    data: { branch_address_target: 'field', branch_attribute: 'neighborhood', supplier_postal_field: 'neighborhood' } %>
                <datalist id="branch-neighborhoods" data-supplier-postal-assist-target="neighborhoods"></datalist>
                <div class="mt-2 hidden" data-controller="delta-select" data-searchable="true"
                     data-search-placeholder="<%= t('admin.supplier_details.postal_search_neighborhood') %>"
                     data-supplier-postal-assist-target="choicesWrapper">
                  <select aria-label="<%= t('admin.supplier_details.postal_choose_neighborhood') %>"
                          data-supplier-postal-assist-target="choices"
                          data-action="change->supplier-postal-assist#chooseNeighborhood"></select>
                </div>
                <%= error_message_for(address_form.object, :neighborhood) %>
              </div>
              <div class="catalog-field">
                <%= address_form.label :street, t('admin.branches.form.fields.street') %>
                <%= address_form.text_field :street, maxlength: 150, autocomplete: 'address-line1', required: true,
                    data: { branch_address_target: 'field', branch_attribute: 'street' } %>
                <%= error_message_for(address_form.object, :street) %>
              </div>
              <% %i[exterior_number interior_number].each do |attribute| %>
                <div class="catalog-field">
                  <%= address_form.label attribute do %>
                    <%= t("admin.branches.form.fields.#{attribute}") %>
                    <% if attribute == :exterior_number %><span data-required-when="mx" class="text-rose-600" aria-hidden="true">*</span><% end %>
                  <% end %>
                  <%= address_form.text_field attribute, maxlength: 20, autocomplete: 'off',
                      data: { branch_address_target: 'field', branch_attribute: attribute } %>
                  <%= error_message_for(address_form.object, attribute) %>
                </div>
              <% end %>
              <div class="catalog-field catalog-full">
                <%= address_form.label :reference_notes, t('admin.branch_workspace.reference_notes') %>
                <%= address_form.text_area :reference_notes, maxlength: 200, rows: 2 %>
                <%= error_message_for(address_form.object, :reference_notes) %>
                <p class="catalog-hint"><%= t('admin.branch_workspace.reference_hint') %></p>
              </div>
            </div>
          <% end %>
        </div>
      </section>
      <section class="catalog-card branch-form-section" id="branch-notes"><%= catalog_heading(t('admin.branch_workspace.notes'), t('admin.branch_workspace.notes_hint'), icon: 'document-text') %><div class="catalog-card-body"><%= form.label :note_body, t('admin.branch_workspace.notes'), class: 'catalog-label' %><%= form.text_area :note_body, name: "#{form.object_name}[notes]", maxlength: 2000, rows: 4, class: 'min-h-28 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-emerald-500 focus:ring-emerald-500' %><%= error_message_for(@branch, :notes) %></div></section>
      <footer class="catalog-footer branch-form-footer"><%= link_to t('admin.catalog_design.cancel'), branch_directory_path, class: 'catalog-button' %><%= form.submit submit_label, class: 'catalog-button catalog-button-primary' %></footer>
    </div>
    <aside class="catalog-aside branch-form-aside" aria-label="<%= t('admin.branch_workspace.setup_title') %>"><section class="catalog-card catalog-card-body"><span class="branch-avatar"><%= delta_icon('building-storefront', class: 'size-6') %></span><h2><%= t('admin.branch_workspace.setup_title') %></h2><p><%= t('admin.branch_workspace.setup_hint') %></p><ul class="branch-checklist"><li><%= t('admin.branch_workspace.setup_identity') %></li><li><%= t('admin.branch_workspace.setup_contact') %></li><li><%= t('admin.branch_workspace.setup_location') %></li></ul></section><div class="catalog-notice"><%= t('admin.branch_workspace.optional_hint') %></div><section class="catalog-card catalog-card-body"><h2><%= t('admin.branch_workspace.history_title') %></h2><p><%= t('admin.catalog_design.branch_status_hint') %></p></section></aside>
  <% end %>
</div>
