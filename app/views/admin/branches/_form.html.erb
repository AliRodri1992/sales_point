<div>
  <div class="mb-7 flex items-start justify-between gap-4">
    <div>
      <h1 class="font-jakarta text-2xl font-bold text-slate-900"><%= title %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= t('admin.branches.form.subtitle') %></p>
    </div>
    <%= link_to admin_branches_path,
                class: 'inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50' do %>
      <%= icon('arrow-left', class: 'size-4') %>
      <%= t('admin.branches.form.buttons.back') %>
    <% end %>
  </div>

  <div class="max-w-4xl rounded-xl border border-slate-200 bg-white shadow-sm">
    <%= form_with model: @branch, class: 'space-y-6 p-6 lg:p-8' do |form| %>
      <div>
        <%= form.label :name, t('admin.branches.form.fields.name'), class: 'mb-1.5 block text-sm font-medium text-slate-700' %>
        <%= form.text_field :name, required: true, class: 'w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100' %>
        <% @branch.errors[:name].each do |message| %>
          <p class="mt-1.5 text-xs font-medium text-red-600"><%= t('admin.branches.form.fields.name') %> <%= message %>.</p>
        <% end %>
      </div>

      <div>
        <%= form.label :phone, t('admin.branches.form.fields.phone'), class: 'mb-1.5 block text-sm font-medium text-slate-700' %>
        <%= form.telephone_field :phone, class: 'w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100' %>
        <% @branch.errors[:phone].each do |message| %>
          <p class="mt-1.5 text-xs font-medium text-red-600"><%= t('admin.branches.form.fields.phone') %> <%= message %>.</p>
        <% end %>
      </div>

      <%= form.fields_for :address do |address_form| %>
        <div class="border-t border-slate-100 pt-6">
          <div class="mb-5">
            <h2 class="text-sm font-semibold text-slate-800"><%= t('admin.branches.form.address.title') %></h2>
            <p class="mt-1 text-xs text-slate-500"><%= t('admin.branches.form.address.description') %></p>
          </div>
          <%= address_form.hidden_field :id %>

          <div class="grid gap-4 sm:grid-cols-2">
            <% {
              street: 'street',
              exterior_number: 'exterior_number',
              interior_number: 'interior_number',
              neighborhood: 'neighborhood',
              postal_code: 'postal_code',
              city: 'city',
              state: 'state',
              country: 'country'
            }.each do |attribute, translation_key| %>
              <div class="<%= attribute == :street ? 'sm:col-span-2' : '' %>">
                <%= address_form.label attribute, t("admin.branches.form.fields.#{translation_key}"), class: 'mb-1.5 block text-sm font-medium text-slate-700' %>
                <%= address_form.text_field attribute,
                                            required: attribute == :postal_code || attribute == :country,
                                            class: 'w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100' %>
                <% address_form.object.errors[attribute].each do |message| %>
                  <p class="mt-1.5 text-xs font-medium text-red-600"><%= t("admin.branches.form.fields.#{translation_key}") %> <%= message %>.</p>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-200 px-4 py-3">
        <%= form.check_box :status, checked: @branch.new_record? ? true : @branch.status, class: 'size-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500' %>
        <span>
          <span class="block text-sm font-medium text-slate-700"><%= t('admin.branches.form.status.active') %></span>
          <span class="block text-xs text-slate-500"><%= t('admin.branches.form.status.description') %></span>
        </span>
      </label>

      <div class="flex justify-end gap-3 border-t border-slate-100 pt-5">
        <%= link_to admin_branches_path, class: 'rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50' do %>
          <%= t('admin.branches.form.buttons.cancel') %>
        <% end %>
        <%= form.submit submit_label, class: 'rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700' %>
      </div>
    <% end %>
  </div>
</div>
