<% content_for :title, "#{@branch.name} | #{t('admin.branches.index.title')}" %>

<div>
  <div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-medium text-slate-500"><%= t('admin.branches.index.title') %></p>
      <h1 class="mt-1 font-jakarta text-2xl font-bold text-slate-900"><%= @branch.name %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= t('admin.branches.form.subtitle') %></p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <%= link_to admin_branches_path,
                  class: 'inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50' do %>
        <%= icon('arrow-left', class: 'size-4') %>
        <%= t('admin.branches.form.buttons.back') %>
      <% end %>

      <% if @can_manage_branches %>
        <%= link_to edit_admin_branch_path(@branch),
                    class: 'inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700' do %>
          <%= icon('pencil-square', class: 'size-4') %>
          <%= t('admin.branches.actions.edit') %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm lg:p-8">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-base font-semibold text-slate-900"><%= t('admin.branches.index.columns.branch') %></h2>
          <p class="mt-1 text-sm text-slate-500"><%= @branch.name %></p>
        </div>

        <% if @branch.status %>
          <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">
            <%= t('admin.branches.statuses.active') %>
          </span>
        <% else %>
          <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">
            <%= t('admin.branches.statuses.inactive') %>
          </span>
        <% end %>
      </div>

      <dl class="mt-6 divide-y divide-slate-100">
        <div class="flex items-center justify-between gap-4 py-3">
          <dt class="text-sm text-slate-500"><%= t('admin.branches.form.fields.name') %></dt>
          <dd class="text-right text-sm font-medium text-slate-900"><%= @branch.name %></dd>
        </div>
        <div class="flex items-center justify-between gap-4 py-3">
          <dt class="text-sm text-slate-500"><%= t('admin.branches.form.fields.phone') %></dt>
          <dd class="text-right text-sm font-medium text-slate-900"><%= @branch.phone.presence || t('admin.branches.index.no_phone') %></dd>
        </div>
      </dl>
    </section>

    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm lg:p-8">
      <div>
        <h2 class="text-base font-semibold text-slate-900"><%= t('admin.branches.form.address.title') %></h2>
        <p class="mt-1 text-sm text-slate-500"><%= t('admin.branches.form.address.description') %></p>
      </div>

      <% if @branch.address %>
        <dl class="mt-6 grid gap-x-6 gap-y-4 sm:grid-cols-2">
          <% {
            street: 'street',
            exterior_number: 'exterior_number',
            interior_number: 'interior_number',
            neighborhood: 'neighborhood',
            postal_code: 'postal_code',
            city: 'city',
            state: 'state',
            country: 'country'
          }.each do |attribute, translation_key| %>
            <div class="<%= attribute == :street ? 'sm:col-span-2' : '' %>">
              <dt class="text-xs font-medium uppercase tracking-wide text-slate-400">
                <%= t("admin.branches.form.fields.#{translation_key}") %>
              </dt>
              <dd class="mt-1 text-sm font-medium text-slate-900">
                <%= @branch.address.public_send(attribute).presence || t('admin.branches.index.no_data') %>
              </dd>
            </div>
          <% end %>
        </dl>
      <% else %>
        <p class="mt-6 text-sm text-slate-500"><%= t('admin.branches.index.no_address') %></p>
      <% end %>
    </section>
  </div>
</div>