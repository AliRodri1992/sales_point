<% content_for :title, "#{@branch.name} | #{t('admin.branches.index.title')}" %>
<div class="catalog-workspace branch-workspace">
  <header class="catalog-header"><div><p class="catalog-eyebrow"><%= t('admin.branch_workspace.eyebrow') %> · <%= branch_code(@branch) %></p><h1><%= @branch.name %></h1><p><%= branch_location(@branch) %></p><div class="mt-3"><%= catalog_status(@branch.status, scope: 'admin.branches.statuses') %></div></div><div class="catalog-actions"><%= link_to branch_directory_path, class: 'catalog-button' do %><%= delta_icon('arrow-left', class: 'size-4') %><%= t('admin.branches.form.buttons.back') %><% end %><% if policy(@branch).update? %><%= link_to edit_admin_branch_path(@branch, branch_directory_parameters), class: 'catalog-button catalog-button-primary' do %><%= delta_icon('pencil-square', class: 'size-4') %><%= t('admin.branches.actions.edit') %><% end %><% end %></div></header>
  <div class="catalog-layout"><div class="catalog-main">
    <section class="catalog-card"><%= catalog_heading(t('admin.branch_workspace.identity'), t('admin.branch_workspace.detail_hint'), icon: 'building-storefront') %><dl class="catalog-card-body catalog-definition"><div><dt><%= t('admin.branch_workspace.code') %></dt><dd><%= @branch.code.presence || t('admin.branch_workspace.not_registered') %></dd></div><div><dt><%= t('admin.branch_workspace.assigned_team') %></dt><dd><%= t('admin.branch_workspace.assigned_people', count: @branch_team_count) %></dd></div><div><dt><%= t('admin.branch_workspace.created_at') %></dt><dd><%= l(@branch.created_at, format: :long) %></dd></div><div><dt><%= t('admin.branch_workspace.updated_at') %></dt><dd><%= l(@branch.updated_at, format: :long) %></dd></div></dl></section>
    <section class="catalog-card"><%= catalog_heading(t('admin.branch_workspace.contact'), t('admin.branch_workspace.contact_hint'), icon: 'phone') %><dl class="catalog-card-body catalog-definition"><div><dt><%= t('admin.phones.primary_mobile') %></dt><dd><%= branch_contact_link(@branch) %></dd><% if branch_mobile(@branch)&.whatsapp_enabled? %><p class="catalog-hint"><%= t('admin.branch_workspace.whatsapp') %></p><% end %></div><div><dt><%= t('admin.branch_workspace.contact_email') %></dt><dd><%= @branch.contact_email.present? ? mail_to(@branch.contact_email) : t('admin.branch_workspace.not_registered') %></dd></div></dl></section>
    <section class="catalog-card"><%= catalog_heading(t('admin.branch_workspace.location'), t('admin.branch_workspace.location_hint'), icon: 'map-pin') %><div class="catalog-card-body"><% if @branch.address %><dl class="catalog-definition"><% { street: 'street', exterior_number: 'exterior_number', interior_number: 'interior_number', neighborhood: 'neighborhood', city: 'city', state: 'state', postal_code: 'postal_code', country: 'country' }.each do |attribute, label| %><div><dt><%= t("admin.branches.form.fields.#{label}") %></dt><dd><%= (attribute == :country ? @branch.address.country&.localized_name : @branch.address.public_send(attribute)).presence || t('admin.branch_workspace.not_registered') %></dd></div><% end %><% if @branch.address.reference_notes.present? %><div class="catalog-full"><dt><%= t('admin.branch_workspace.reference_notes') %></dt><dd><%= @branch.address.reference_notes %></dd></div><% end %></dl><% else %><p class="branch-muted"><%= t('admin.branch_workspace.location_pending') %></p><% end %></div></section>
    <section class="catalog-card"><%= catalog_heading(t('admin.branch_workspace.notes'), t('admin.branch_workspace.notes_hint'), icon: 'document-text') %><div class="catalog-card-body branch-notes"><%= @branch.notes.presence || t('admin.branch_workspace.no_notes') %></div></section>
  </div><aside class="catalog-aside"><% if @branch_operation_counts %><section class="catalog-card catalog-card-body"><h2><%= t('admin.branch_workspace.operations') %></h2><p><%= t('admin.branch_workspace.operations_hint') %></p><dl class="branch-operation-stats"><% @branch_operation_counts.each do |key, value| %><div><dt><%= t("admin.branch_workspace.#{key}") %></dt><dd><%= value %></dd></div><% end %></dl><%= link_to admin_branch_inventories_path(@branch), class: 'catalog-button w-full' do %><%= delta_icon('cube', class: 'size-4') %><%= t('admin.inventory.title') %><% end %></section><% end %><div class="catalog-notice"><%= t('admin.branch_workspace.history_hint') %></div></aside></div>
</div>
