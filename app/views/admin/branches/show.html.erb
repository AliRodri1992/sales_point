<% content_for :title, "#{@branch.name} | #{t('admin.branches.index.title')}" %>
<% can_manage_branch = policy(@branch).update? %>
<% can_change_lifecycle = policy(@branch).manage? %>
<% address = @branch.address %>
<% mobile = branch_mobile(@branch) %>
<% note_body = @branch.note_body %>

<div class="catalog-workspace branch-workspace branch-details">
  <header class="catalog-header branch-detail-header">
    <div class="branch-detail-header-content">
      <span class="branch-detail-avatar" aria-hidden="true">
        <%= delta_icon('building-storefront', class: 'size-8') %>
      </span>
      <div class="branch-detail-heading">
        <p class="catalog-eyebrow"><%= t('admin.branch_workspace.eyebrow') %></p>
        <div class="branch-detail-title-row">
          <h1><%= @branch.name %></h1>
          <%= branch_operational_status(@branch) %>
        </div>
        <p class="branch-detail-location">
          <%= delta_icon('map-pin', class: 'size-4') %>
          <span><%= branch_location(@branch) %></span>
        </p>
        <% if @branch.code.present? %>
          <p class="branch-detail-code"><%= t('admin.branch_workspace.code') %>: <strong><%= @branch.code %></strong></p>
        <% end %>
      </div>
    </div>

    <div class="catalog-actions branch-detail-actions">
      <%= link_to branch_directory_path, class: 'catalog-button', data: { turbo_frame: '_top' } do %>
        <%= delta_icon('arrow-left', class: 'size-4') %>
        <%= t('admin.branches.form.buttons.back') %>
      <% end %>
      <% if can_manage_branch %>
        <%= link_to edit_admin_branch_path(@branch, branch_directory_parameters),
                    class: 'catalog-button catalog-button-primary', data: { turbo_frame: '_top' } do %>
          <%= delta_icon('pencil-square', class: 'size-4') %>
          <%= t('admin.branches.actions.edit') %>
        <% end %>
      <% end %>
    </div>
  </header>

  <section class="catalog-card branch-lifecycle-panel" aria-labelledby="branch-lifecycle-title">
    <div class="catalog-card-body">
      <h2 id="branch-lifecycle-title" class="font-jakarta text-base font-bold"><%= t('admin.branch_lifecycle.title') %></h2>
      <p class="catalog-hint"><%= t("admin.branch_lifecycle.descriptions.#{@branch.operational_status}") %></p>

      <% if @branch.preparing? || @branch.suspended? %>
        <h3 class="mt-4 font-semibold"><%= t('admin.branch_lifecycle.requirements_title') %></h3>
        <ul class="mt-2 grid gap-2 sm:grid-cols-2">
          <% branch_activation_requirements(@branch).each do |key, complete| %>
            <li class="flex items-center gap-2 text-sm">
              <%= delta_icon(complete ? 'check-circle' : 'exclamation-circle',
                             class: "size-4 #{complete ? 'text-emerald-600' : 'text-amber-600'}") %>
              <%= t("admin.branch_lifecycle.requirements.#{key}") %>
            </li>
          <% end %>
        </ul>
      <% end %>
      <% if @transition_error.present? && !%w[reason_required reason_too_long].include?(@transition_error_code) %>
        <p class="mt-3 rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-800"
           role="alert"><%= @transition_error %></p>
      <% end %>
      <% if can_change_lifecycle && !@branch.closed? %>
        <% Branches::TransitionStatus::ALLOWED.fetch(@branch.operational_status, []).each do |target| %>
          <% blockers = branch_transition_blockers(@branch, target) %>
          <% if blockers.any? %>
            <section class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4"
                     aria-label="<%= t('admin.branch_lifecycle.pending_for', action: t("admin.branch_lifecycle.actions.#{target}")) %>">
              <h3 class="text-sm font-bold text-amber-900">
                <%= t('admin.branch_lifecycle.pending_for', action: t("admin.branch_lifecycle.actions.#{target}")) %>
              </h3>
              <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-amber-900">
                <% blockers.each do |blocker| %>
                  <li>
                    <%= t(target == 'active' ? "admin.branch_lifecycle.requirements.#{blocker}" :
                                                 "admin.branch_lifecycle.blockers.#{blocker}") %>
                    <% if (destination = branch_blocker_path(@branch, blocker)) %>
                      <%= link_to t('admin.branch_lifecycle.resolve_blocker'), destination,
                                  class: 'ml-1 font-semibold underline hover:text-amber-700',
                                  data: { turbo_frame: '_top' } %>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </section>
          <% end %>
        <% end %>
      <% end %>
      <% if can_change_lifecycle && !@branch.closed? %>
        <% allowed = Branches::TransitionStatus::ALLOWED.fetch(@branch.operational_status, []) %>
        <% selected_state = if allowed.include?(@transition_to)
                              @transition_to
                            else
                              allowed.find { |state| branch_transition_blockers(@branch, state).empty? } || allowed.first
                            end %>
        <% selected_blocked = branch_transition_blockers(@branch, selected_state).any? %>
        <%= form_with url: transition_status_admin_branch_path(@branch, branch_directory_parameters),
                      method: :patch, class: 'mt-5 space-y-4 rounded-xl border border-slate-200 p-4',
                      html: { novalidate: true },
                      data: { controller: 'branch-transition',
                              unavailable_message: t('admin.branch_lifecycle.unavailable'),
                              turbo_confirm: t("admin.branch_lifecycle.confirmations.#{selected_state}"),
                              confirm_record: @branch.name } do |transition_form| %>
          <div class="catalog-field">
            <%= transition_form.label :to_status,
                                      branch_required_label(t('admin.branch_lifecycle.next_status')),
                                      class: 'catalog-label' %>
            <div data-controller="delta-select" data-searchable="false">
              <%= select_tag :to_status,
                             options_for_select(allowed.map { |state|
                               [t("admin.branch_lifecycle.actions.#{state}"), state,
                                { data: { blocked: branch_transition_blockers(@branch, state).any?,
                                          description: t("admin.branch_lifecycle.descriptions.#{state}"),
                                          confirmation: t("admin.branch_lifecycle.confirmations.#{state}"),
                                          action_label: t("admin.branch_lifecycle.actions.#{state}") } }]
                             }, selected_state),
                             id: 'branch-transition-target',
                             data: { branch_transition_target: 'status',
                                     action: 'change->branch-transition#update' },
                             aria: { describedby: 'branch-transition-help branch-transition-availability' },
                             class: 'w-full rounded-xl border border-slate-200 px-3 py-2 text-sm' %>
            </div>
            <p id="branch-transition-help" data-branch-transition-target="description"
               class="mt-2 text-sm text-slate-600">
              <%= t("admin.branch_lifecycle.descriptions.#{selected_state}") %>
            </p>
            <p id="branch-transition-availability" data-branch-transition-target="availability"
               class="mt-2 text-sm font-semibold text-amber-900" role="status" aria-live="polite"
               <%= 'hidden' unless selected_blocked %>>
              <%= t('admin.branch_lifecycle.unavailable') if selected_blocked %>
            </p>
          </div>
          <div class="catalog-field">
            <%= transition_form.label :reason,
                                      branch_required_label(t('admin.branch_lifecycle.reason')),
                                      class: 'catalog-label' %>
            <%= transition_form.text_field :reason, maxlength: 2000, autocomplete: 'off',
                            value: @transition_reason,
                            aria: { invalid: %w[reason_required reason_too_long].include?(@transition_error_code),
                                    describedby: (%w[reason_required reason_too_long].include?(@transition_error_code) ?
                                                    'branch-transition-reason-error' : nil) },
                            class: 'w-full rounded-xl border border-slate-200 px-3 py-2 text-sm' %>
            <% if %w[reason_required reason_too_long].include?(@transition_error_code) %>
              <p id="branch-transition-reason-error" class="mt-1 text-xs text-rose-700" role="alert">
                <%= t('admin.branch_lifecycle.reason') %> <%= @transition_error %>
              </p>
            <% end %>
          </div>
          <%= transition_form.button t("admin.branch_lifecycle.actions.#{selected_state}"),
                                     type: :submit,
                                     class: 'catalog-button catalog-button-primary',
                                     disabled: selected_blocked,
                                     data: { branch_transition_target: 'submit' },
                                     aria: { describedby: 'branch-transition-help branch-transition-availability' } %>
        <% end %>
      <% end %>
      <% if @branch.branch_status_transitions.exists? %>
        <h3 class="mt-5 font-semibold"><%= t('admin.branch_lifecycle.history') %></h3>
        <ol class="mt-2 space-y-2">
          <% @branch.branch_status_transitions.includes(:changed_by).order(created_at: :desc).limit(20).each do |entry| %>
            <li class="text-sm">
              <time datetime="<%= entry.created_at.iso8601 %>"><%= l(entry.created_at, format: :long) %></time>
              · <%= entry.from_status.present? ? t("admin.branch_lifecycle.statuses.#{entry.from_status}") : '—' %>
              → <%= t("admin.branch_lifecycle.statuses.#{entry.to_status}") %>
              · <%= entry.changed_by&.display_name || t('admin.branch_lifecycle.system_actor') %>
              <% if entry.reason.present? %> — <%= entry.reason %><% end %>
            </li>
          <% end %>
        </ol>
      <% end %>
    </div>
  </section>

  <nav class="catalog-nav branch-detail-nav" aria-label="<%= t('admin.catalog_design.sections') %>">
    <% %w[identity contact location notes].each do |section| %>
      <%= link_to t("admin.branch_workspace.#{section}"), "#branch-detail-#{section}" %>
    <% end %>
    <% if @branch_operation_counts %>
      <%= link_to t('admin.branch_workspace.operations'), '#branch-detail-operations' %>
    <% end %>
  </nav>

  <div class="catalog-layout branch-detail-layout <%= 'branch-detail-layout-single' unless @branch_operation_counts %>">
    <div class="catalog-main branch-detail-main">
      <section class="catalog-card branch-detail-card" id="branch-detail-identity"
               aria-labelledby="branch-detail-identity-title">
        <%= catalog_heading(t('admin.branch_workspace.identity'), t('admin.branch_workspace.detail_hint'),
                            icon: 'building-storefront', id: 'branch-detail-identity-title') %>
        <dl class="catalog-card-body catalog-definition branch-detail-definition">
          <div>
            <dt><%= t('admin.branch_workspace.code') %></dt>
            <dd><%= @branch.code.presence || t('admin.branch_workspace.not_registered') %></dd>
          </div>
          <div>
            <dt><%= t('admin.branch_workspace.assigned_team') %></dt>
            <dd><%= t('admin.branch_workspace.assigned_people', count: @branch_team_count) %></dd>
          </div>
          <div>
            <dt><%= t('admin.branch_workspace.created_at') %></dt>
            <dd><time datetime="<%= @branch.created_at.iso8601 %>"><%= l(@branch.created_at, format: :long) %></time></dd>
          </div>
          <div>
            <dt><%= t('admin.branch_workspace.updated_at') %></dt>
            <dd><time datetime="<%= @branch.updated_at.iso8601 %>"><%= l(@branch.updated_at, format: :long) %></time></dd>
          </div>
        </dl>
      </section>

      <section class="catalog-card branch-detail-card" id="branch-detail-contact"
               aria-labelledby="branch-detail-contact-title">
        <%= catalog_heading(t('admin.branch_workspace.contact'), t('admin.branch_workspace.contact_hint'),
                            icon: 'phone', id: 'branch-detail-contact-title') %>
        <dl class="catalog-card-body catalog-definition branch-detail-definition">
          <div>
            <dt><%= t('admin.phones.primary_mobile') %></dt>
            <dd>
              <% if mobile %>
                <%= link_to mobile.number, "tel:#{mobile.number}", class: 'branch-detail-link' %>
                <% if mobile.whatsapp_enabled? %>
                  <span class="branch-detail-hint"><%= t('admin.branch_workspace.whatsapp') %></span>
                <% end %>
              <% else %>
                <span class="branch-detail-empty"><%= t('admin.branch_workspace.contact_pending') %></span>
              <% end %>
            </dd>
          </div>
          <div>
            <dt><%= t('admin.branch_workspace.contact_email') %></dt>
            <dd>
              <% if @branch.contact_email.present? %>
                <%= mail_to @branch.contact_email, @branch.contact_email, class: 'branch-detail-link' %>
              <% else %>
                <span class="branch-detail-empty"><%= t('admin.branch_workspace.not_registered') %></span>
              <% end %>
            </dd>
          </div>
        </dl>
      </section>

      <section class="catalog-card branch-detail-card" id="branch-detail-location"
               aria-labelledby="branch-detail-location-title">
        <%= catalog_heading(t('admin.branch_workspace.location'), t('admin.branch_workspace.location_hint'),
                            icon: 'map-pin', id: 'branch-detail-location-title') %>
        <div class="catalog-card-body">
          <% if address %>
            <div class="branch-detail-address-summary">
              <span class="branch-detail-address-icon" aria-hidden="true">
                <%= delta_icon('map-pin', class: 'size-5') %>
              </span>
              <div>
                <p class="branch-detail-address-line">
                  <%= [address.street, address.exterior_number].compact_blank.join(' ').presence ||
                      t('admin.branch_workspace.location_pending') %>
                </p>
                <p class="branch-detail-address-locality"><%= branch_location(@branch) %></p>
              </div>
            </div>
            <dl class="catalog-definition branch-detail-definition branch-detail-address-fields">
              <% %i[interior_number neighborhood city state postal_code country].each do |attribute| %>
                <div>
                  <dt><%= t("admin.branches.form.fields.#{attribute}") %></dt>
                  <dd>
                    <%= (attribute == :country ? address.country&.localized_name : address.public_send(attribute)).presence ||
                        t('admin.branch_workspace.not_registered') %>
                  </dd>
                </div>
              <% end %>
            </dl>
            <% if address.reference_notes.present? %>
              <div class="branch-detail-directions">
                <h3><%= t('admin.branch_workspace.reference_notes') %></h3>
                <p><%= address.reference_notes %></p>
              </div>
            <% end %>
          <% else %>
            <p class="branch-detail-empty"><%= t('admin.branch_workspace.location_pending') %></p>
          <% end %>
        </div>
      </section>

      <section class="catalog-card branch-detail-card" id="branch-detail-notes"
               aria-labelledby="branch-detail-notes-title">
        <%= catalog_heading(t('admin.branch_workspace.notes'), t('admin.branch_workspace.notes_hint'),
                            icon: 'document-text', id: 'branch-detail-notes-title') %>
        <div class="catalog-card-body">
          <% if note_body.present? %>
            <p class="branch-notes"><%= note_body %></p>
          <% else %>
            <p class="branch-detail-empty"><%= t('admin.branch_workspace.no_notes') %></p>
          <% end %>
        </div>
      </section>
    </div>

    <% if @branch_operation_counts %>
      <aside class="catalog-aside branch-detail-aside">
        <section class="catalog-card" id="branch-detail-operations"
                 aria-labelledby="branch-detail-operations-title">
          <%= catalog_heading(t('admin.branch_workspace.operations'), t('admin.branch_workspace.operations_hint'),
                              icon: 'cube', id: 'branch-detail-operations-title') %>
          <div class="catalog-card-body">
            <dl class="branch-operation-stats">
              <% @branch_operation_counts.each do |key, value| %>
                <div>
                  <dt><%= t("admin.branch_workspace.#{key}") %></dt>
                  <dd><%= value %></dd>
                </div>
              <% end %>
            </dl>
            <%= link_to admin_branch_inventories_path(@branch), class: 'catalog-button branch-detail-inventory-link',
                        data: { turbo_frame: '_top' } do %>
              <%= delta_icon('cube', class: 'size-4') %>
              <%= t('admin.inventory.title') %>
            <% end %>
            <%= render 'terminal_management' %>
          </div>
        </section>
        <div class="catalog-notice branch-detail-notice" role="note">
          <%= delta_icon('information-circle', class: 'size-5') %>
          <p><%= t('admin.branch_workspace.history_hint') %></p>
        </div>
      </aside>
    <% end %>
  </div>
  <% if can_change_lifecycle %>
    <%= render 'change_history' %>
  <% end %>
</div>
