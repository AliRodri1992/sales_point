<% content_for :title, t('admin.branches.index.page_title') %>
<div class="catalog-workspace branch-workspace" data-controller="branch-directory" data-action="click->branch-directory#navigate:capture turbo:frame-load->branch-directory#navigated turbo:fetch-request-error->branch-directory#navigationFailed turbo:frame-missing->branch-directory#navigationFailed popstate@window->branch-directory#restore" aria-busy="false">
  <header class="catalog-header branch-page-header">
    <p class="catalog-eyebrow"><%= t('admin.branch_workspace.eyebrow') %></p>
    <div class="branch-page-title-row">
      <h1><%= t('admin.branches.index.title') %></h1>
      <% if @can_manage_branches %>
        <%= link_to new_admin_branch_path(branch_directory_parameters), class: 'catalog-button catalog-button-primary branch-create-button' do %>
          <%= delta_icon('plus', class: 'size-4') %>
          <%= t('admin.branches.index.new') %>
        <% end %>
      <% end %>
    </div>
    <p class="branch-page-description"><%= t('admin.branch_workspace.intro') %></p>
  </header>

  <%= render 'overview' %>

  <section class="branch-directory-panel" aria-labelledby="branches-result-title">
    <%= render 'filters' %>
    <div data-branch-directory-target="error" class="branch-filter-error mx-5 my-3 rounded-xl border border-rose-200 bg-rose-50 p-3 text-sm text-rose-800" role="alert" hidden>
      <%= t('admin.branch_workspace.request_error') %>
      <button type="button" class="ml-2 font-semibold underline" data-action="branch-directory#retry"><%= t('admin.skeleton_loading.retry') %></button>
    </div>
    <div id="branch-results-announcement" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
    <div class="branch-loading-line" aria-hidden="true"></div>
    <div class="branch-loading-skeleton" data-branch-directory-target="loading"
         role="status" aria-live="polite" hidden>
      <span class="sr-only"><%= t('admin.branch_lifecycle.loading_results') %></span>
      <div aria-hidden="true">
        <% 5.times do %>
          <div class="branch-loading-skeleton-row">
            <% 4.times do %><div class="branch-loading-skeleton-line"></div><% end %>
          </div>
        <% end %>
      </div>
    </div>
    <%= turbo_frame_tag 'branches_list' do %>
      <%= render 'list', branches: @branches, total_count: @total_count, total_pages: @total_pages, current_page: @current_page, per_page: @per_page, can_manage_branches: @can_manage_branches %>
    <% end %>
  </section>
</div>
