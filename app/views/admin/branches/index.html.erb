<% content_for :title, t('admin.branches.index.page_title') %>

<div data-controller="branches"
     data-create-url="<%= admin_branches_path %>"
     data-branches-new-title-value="<%= t('admin.branches.form.new_title') %>"
     data-branches-edit-title-value="<%= t('admin.branches.form.edit_title') %>"
     data-branches-create-submit-value="<%= t('admin.branches.form.buttons.create') %>"
     data-branches-update-submit-value="<%= t('admin.branches.form.buttons.update') %>">
  <div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="font-jakarta text-2xl font-bold text-slate-900"><%= t('admin.branches.index.title') %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= t('admin.branches.index.subtitle') %></p>
    </div>
    <button type="button" data-action="click->branches#openCreate"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">
      <%= icon('plus', class: 'size-4') %> <%= t('admin.branches.index.new') %>
    </button>
  </div>

  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <% if @branches.any? %>
      <div class="hidden overflow-x-auto md:block">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"><%= t('admin.branches.index.columns.branch') %></th>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"><%= t('admin.branches.index.columns.phone') %></th>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"><%= t('admin.branches.index.columns.address') %></th>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"><%= t('admin.branches.index.columns.status') %></th>
              <th class="px-6 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500"><%= t('admin.branches.index.columns.actions') %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @branches.each do |branch| %>
              <% address = branch.address %>
              <tr class="transition hover:bg-slate-50">
                <td class="px-6 py-4"><span class="font-medium text-slate-900"><%= branch.name %></span></td>
                <td class="px-6 py-4 text-sm text-slate-600"><%= branch.phone.presence || t('admin.branches.index.no_data') %></td>
                <td class="max-w-xs truncate px-6 py-4 text-sm text-slate-600"><%= address&.full_address.presence || t('admin.branches.index.no_data') %></td>
                <td class="px-6 py-4">
                  <% if branch.status %>
                    <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700"<%= t('admin.branches.statuses.active') %></span>
                  <% else %>
                    <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600"<%= t('admin.branches.statuses.inactive') %></span>
                  <% end %>
                </td>
                <td class="px-6 py-4">
                  <div class="flex justify-end gap-1">
                    <button type="button"
                            data-action="click->branches#openEdit"
                            data-branch-id="<%= branch.id %>"
                            data-branch-name="<%= branch.name %>"
                            data-branch-phone="<%= branch.phone %>"
                            data-branch-status="<%= branch.status %>"
                            data-address-id="<%= address&.id %>"
                            data-address-street="<%= address&.street %>"
                            data-address-exterior-number="<%= address&.exterior_number %>"
                            data-address-interior-number="<%= address&.interior_number %>"
                            data-address-neighborhood="<%= address&.neighborhood %>"
                            data-address-city="<%= address&.city %>"
                            data-address-state="<%= address&.state %>"
                            data-address-country="<%= address&.country %>"
                            data-address-postal-code="<%= address&.postal_code %>"
                            title="<%= t('admin.branches.actions.edit') %>"
                            aria-label="<%= t('admin.branches.actions.edit') %>"
                            class="rounded-lg p-2 text-blue-600 transition hover:bg-blue-50">
                      <%= icon('pencil-square', class: 'size-5') %>
                    </button>
                    <%= button_to admin_branch_path(branch),
                                  method: :delete,
                                  title: t('admin.branches.actions.delete'),
                                  aria: { label: t('admin.branches.actions.delete') },
                                  form: { data: { turbo_confirm: t('admin.branches.confirm_delete') } },
                                  class: 'rounded-lg p-2 text-red-600 transition hover:bg-red-50' do %>
                      <%= icon('trash', class: 'size-5') %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="divide-y divide-slate-100 md:hidden">
        <% @branches.each do |branch| %>
          <% address = branch.address %>
          <div class="p-4">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="font-semibold text-slate-900"><%= branch.name %></h2>
                <p class="mt-1 text-sm text-slate-500"><%= branch.phone.presence || 'Sin teléfono' %></p>
              </div>
              <% if branch.status %>
                <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700"<%= t('admin.branches.statuses.active') %></span>
              <% else %>
                <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600"<%= t('admin.branches.statuses.inactive') %></span>
              <% end %>
            </div>
            <p class="mt-3 text-sm text-slate-600"><%= address&.full_address.presence || 'Sin dirección' %></p>
            <div class="mt-4 flex justify-end gap-1">
              <button type="button"
                      data-action="click->branches#openEdit"
                      data-branch-id="<%= branch.id %>"
                      data-branch-name="<%= branch.name %>"
                      data-branch-phone="<%= branch.phone %>"
                      data-branch-status="<%= branch.status %>"
                      data-address-id="<%= address&.id %>"
                      data-address-street="<%= address&.street %>"
                      data-address-exterior-number="<%= address&.exterior_number %>"
                      data-address-interior-number="<%= address&.interior_number %>"
                      data-address-neighborhood="<%= address&.neighborhood %>"
                      data-address-city="<%= address&.city %>"
                      data-address-state="<%= address&.state %>"
                      data-address-country="<%= address&.country %>"
                      data-address-postal-code="<%= address&.postal_code %>"
                      title="<%= t('admin.branches.actions.edit') %>"
                      aria-label="<%= t('admin.branches.actions.edit') %>"
                      class="rounded-lg p-2 text-blue-600 transition hover:bg-blue-50">
                <%= icon('pencil-square', class: 'size-5') %>
              </button>
              <%= button_to admin_branch_path(branch),
                            method: :delete,
                            title: t('admin.branches.actions.delete'),
                            aria: { label: t('admin.branches.actions.delete') },
                            form: { data: { turbo_confirm: t('admin.branches.confirm_delete') } },
                            class: 'rounded-lg p-2 text-red-600 transition hover:bg-red-50' do %>
                <%= icon('trash', class: 'size-5') %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-6 py-14 text-center">
        <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-slate-100 text-slate-500">
          <%= icon('building-office-2', class: 'size-6') %>
        </div>
        <h2 class="mt-4 text-base font-semibold text-slate-900"><%= t('admin.branches.empty.title') %></h2>
        <p class="mt-1 text-sm text-slate-500"><%= t('admin.branches.empty.subtitle') %></p>
        <button type="button" data-action="click->branches#openCreate"
                class="mt-5 inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">
          <%= icon('plus', class: 'size-4') %> <%= t('admin.branches.index.new') %>
        </button>
      </div>
    <% end %>
  </div>

  <div data-branches-target="modal"
       data-action="click->branches#background keydown.esc@window->branches#close"
       class="fixed inset-0 z-50 hidden items-center justify-center overflow-y-auto bg-slate-900/40 p-4 backdrop-blur-[2px] sm:p-6"
       aria-hidden="true">
    <div class="w-full max-w-2xl rounded-2xl bg-white shadow-xl">
      <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
        <div>
          <h2 data-branches-target="modalTitle" class="font-jakarta text-lg font-bold text-slate-900"><%= t('admin.branches.form.new_title') %></h2>
          <p class="mt-1 text-sm text-slate-500"><%= t('admin.branches.form.subtitle') %></p>
        </div>
        <button type="button" data-action="click->branches#close"
                class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-600"
                aria-label="<%= t('admin.branches.form.close') %>">
          <%= icon('x-mark', class: 'size-5') %>
        </button>
      </div>

      <%= form_with model: @branch, url: admin_branches_path, method: :post,
                    data: { branches_target: 'form' }, class: 'space-y-5 px-6 py-6' do |form| %>
        <div>
          <%= form.label :name, t('admin.branches.form.fields.name'), class: 'mb-1.5 block text-sm font-medium text-slate-700' %>
          <%= form.text_field :name, required: true, data: { branches_target: 'name' },
                              class: 'w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100' %>
          <% @branch.errors[:name].each do |message| %>
            <p class="mt-1.5 text-xs font-medium text-red-600"><%= t('admin.branches.form.fields.name') %> <%= message %>.</p>
          <% end %>
        </div>

        <div>
          <%= form.label :phone, t('admin.branches.form.fields.phone'), class: 'mb-1.5 block text-sm font-medium text-slate-700' %>
          <%= form.telephone_field :phone, data: { branches_target: 'phone' },
                                   class: 'w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100' %>
        </div>

        <%= form.fields_for :address do |address_form| %>
          <div class="border-t border-slate-100 pt-5">
            <div class="mb-4">
              <h3 class="text-sm font-semibold text-slate-800"><%= t('admin.branches.form.address.title') %></h3>
              <p class="mt-1 text-xs text-slate-500"><%= t('admin.branches.form.address.description') %></p>
            </div>

            <%= address_form.hidden_field :id %>

            <div class="grid gap-4 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <%= address_form.label :street, t('admin.branches.form.fields.street'), class: 'mb-1.5 block text-sm font-medium text-slate-700' %>
                <%= address_form.text_field :street, data: { branches_target: 'street' },
                                            class: 'w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100' %>
                <% address_form.object.errors[:street].each do |message| %>
                  <p class="mt-1.5 text-xs font-medium text-red-600"><%= t('admin.branches.form.fields.street') %> <%= message %>.</p>
                <% end %>
              </div>

              <div>
                <%= address_form.label :exterior_number, t('admin.branches.form.fields.exterior_number'), class: 'mb-1.5 block text-sm font-medium text-slate-700' %>
                <%= address_form.text_field :exterior_number, data: { branches_target: 'exteriorNumber' },
                                            class: 'w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100' %>
                <% address_form.object.errors[:exterior_number].each do |message| %>
                  <p class="mt-1.5 text-xs font-medium text-red-600"><%= t('admin.branches.form.fields.exterior_number') %> <%= message %>.</p>
                <% end %>
              </div>

              <div>
                <%= address_form.label :interior_number, t('admin.branches.form.fields.interior_number'), class: 'mb-1.5 block text-sm font-medium text-slate-700' %>
                <%= address_form.text_field :interior_number, data: { branches_target: 'interiorNumber' },
                                            class: 'w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100' %>
                <% address_form.object.errors[:interior_number].each do |message| %>
                  <p class="mt-1.5 text-xs font-medium text-red-600"><%= t('admin.branches.form.fields.interior_number') %> <%= message %>.</p>
                <% end %>
              </div>

              <div>
                <%= address_form.label :neighborhood, t('admin.branches.form.fields.neighborhood'), class: 'mb-1.5 block text-sm font-medium text-slate-700' %>
                <%= address_form.text_field :neighborhood, data: { branches_target: 'neighborhood' },
                                            class: 'w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100' %>
                <% address_form.object.errors[:neighborhood].each do |message| %>
                  <p class="mt-1.5 text-xs font-medium text-red-600"><%= t('admin.branches.form.fields.neighborhood') %> <%= message %>.</p>
                <% end %>
              </div>

              <div>
                <%= address_form.label :postal_code, t('admin.branches.form.fields.postal_code'), class: 'mb-1.5 block text-sm font-medium text-slate-700' %>
                <%= address_form.text_field :postal_code, required: true, data: { branches_target: 'postalCode' },
                                            class: 'w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100' %>
                <% address_form.object.errors[:postal_code].each do |message| %>
                  <p class="mt-1.5 text-xs font-medium text-red-600"><%= t('admin.branches.form.fields.postal_code') %> <%= message %>.</p>
                <% end %>
              </div>

              <div>
                <%= address_form.label :city, t('admin.branches.form.fields.city'), class: 'mb-1.5 block text-sm font-medium text-slate-700' %>
                <%= address_form.text_field :city, data: { branches_target: 'city' },
                                            class: 'w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100' %>
                <% address_form.object.errors[:city].each do |message| %>
                  <p class="mt-1.5 text-xs font-medium text-red-600"><%= t('admin.branches.form.fields.city') %> <%= message %>.</p>
                <% end %>
              </div>

              <div>
                <%= address_form.label :state, t('admin.branches.form.fields.state'), class: 'mb-1.5 block text-sm font-medium text-slate-700' %>
                <%= address_form.text_field :state, data: { branches_target: 'state' },
                                            class: 'w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100' %>
                <% address_form.object.errors[:state].each do |message| %>
                  <p class="mt-1.5 text-xs font-medium text-red-600"><%= t('admin.branches.form.fields.state') %> <%= message %>.</p>
                <% end %>
              </div>

              <div>
                <%= address_form.label :country, t('admin.branches.form.fields.country'), class: 'mb-1.5 block text-sm font-medium text-slate-700' %>
                <%= address_form.text_field :country, required: true, data: { branches_target: 'country' },
                                            class: 'w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100' %>
                <% address_form.object.errors[:country].each do |message| %>
                  <p class="mt-1.5 text-xs font-medium text-red-600"><%= t('admin.branches.form.fields.country') %> <%= message %>.</p>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-200 px-4 py-3">
          <%= form.check_box :status, checked: @branch.new_record? ? true : @branch.status,
                             data: { branches_target: 'status' },
                             class: 'size-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500' %>
          <span>
            <span class="block text-sm font-medium text-slate-700"><%= t('admin.branches.form.status.active') %></span>
            <span class="block text-xs text-slate-500"><%= t('admin.branches.form.status.description') %></span>
          </span>
        </label>

        <div class="flex justify-end gap-3 border-t border-slate-100 pt-5">
          <button type="button" data-action="click->branches#close"
                  class="rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">
            <%= t('admin.branches.form.buttons.cancel') %>
          </button>
          <button type="submit" data-branches-target="submit"
                  class="rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700">
            <%= t('admin.branches.form.buttons.create') %>
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>
