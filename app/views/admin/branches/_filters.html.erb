<%= form_with url: admin_branches_path, method: :get, class: 'branch-filters', data: { branch_directory_target: 'form', action: 'submit->branch-directory#submit' } do %>
  <div class="branch-toolbar">
    <div class="branch-search"><label class="sr-only" for="branch-search"><%= t('admin.branch_workspace.filters.search') %></label><%= delta_icon('magnifying-glass', class: 'size-5') %><%= search_field_tag :search, @branch_filters['search'], id: 'branch-search', maxlength: 150, placeholder: t('admin.branch_workspace.search_placeholder'), autocomplete: 'off', data: { action: 'input->branch-directory#schedule compositionstart->branch-directory#compositionStart compositionend->branch-directory#compositionEnd' } %></div>
    <div class="branch-status-filter"><label class="sr-only" for="branch-filter-status"><%= t('admin.branch_workspace.filters.status') %></label><div class="branch-select" data-controller="delta-select" data-search-placeholder="<%= t('admin.branch_workspace.filters.search') %>" data-searchable="false"><%= select_tag :status, options_for_select([[t('admin.catalog_design.all_statuses'), ''], [t('admin.catalog_design.active'), 'active'], [t('admin.catalog_design.inactive'), 'inactive']], @branch_filters['status']), id: 'branch-filter-status', data: { action: 'change->branch-directory#change' } %></div></div>
    <details class="branch-advanced" <%= 'open' if @branch_filters.except('search', 'status').values.any?(&:present?) %>>
      <summary><%= delta_icon('adjustments-horizontal', class: 'size-4') %><%= t('admin.branch_workspace.advanced') %><%= delta_icon('chevron-down', class: 'size-3.5') %></summary>
      <div class="branch-advanced-panel">
        <div class="branch-advanced-heading"><h2><%= t('admin.branch_workspace.advanced') %></h2><p><%= t('admin.branch_workspace.automatic_hint') %></p></div>
        <div class="branch-advanced-grid">
          <div><label for="branch-filter-country"><%= t('admin.branch_workspace.filters.country_id') %></label><div class="branch-select" data-controller="delta-select" data-search-placeholder="<%= t('admin.branch_workspace.filters.search') %>" data-searchable="true"><%= select_tag :country_id, options_for_select([[t('admin.branch_workspace.any_country'), ''], *@branch_countries.map { |country| [country.localized_name, country.id] }], @branch_filters['country_id']), id: 'branch-filter-country', data: { action: 'change->branch-directory#change' } %></div></div>
          <div><label for="branch-filter-state"><%= t('admin.branch_workspace.filters.state') %></label><div class="branch-select" data-controller="delta-select" data-search-placeholder="<%= t('admin.branch_workspace.filters.search') %>" data-searchable="true"><%= select_tag :state, options_for_select([[t('admin.branch_workspace.any_state'), ''], *@branch_states.map { |value| [value, value] }], @branch_filters['state']), id: 'branch-filter-state', data: { action: 'change->branch-directory#change' } %></div></div>
          <div><label for="branch-filter-city"><%= t('admin.branch_workspace.filters.city') %></label><div class="branch-select" data-controller="delta-select" data-search-placeholder="<%= t('admin.branch_workspace.filters.search') %>" data-searchable="true"><%= select_tag :city, options_for_select([[t('admin.branch_workspace.any_city'), ''], *@branch_cities.map { |value| [value, value] }], @branch_filters['city']), id: 'branch-filter-city', data: { action: 'change->branch-directory#change' } %></div></div>
          <% { contact: %w[with_phone without_phone with_email without_email], team: %w[assigned unassigned] }.each do |key, options| %><div><label for="branch-filter-<%= key %>"><%= t("admin.branch_workspace.filters.#{key}") %></label><div class="branch-select" data-controller="delta-select" data-search-placeholder="<%= t('admin.branch_workspace.filters.search') %>" data-searchable="false"><%= select_tag key, options_for_select([[t('admin.branch_workspace.any_option'), ''], *options.map { |value| [t("admin.branch_workspace.options.#{value}"), value] }], @branch_filters[key.to_s]), id: "branch-filter-#{key}", data: { action: 'change->branch-directory#change' } %></div></div><% end %>
          <% %w[created_from created_to].each do |key| %><div><label for="branch-filter-<%= key %>"><%= t("admin.branch_workspace.filters.#{key}") %></label><%= date_field_tag key, @branch_filters[key], id: "branch-filter-#{key}", data: { action: 'change->branch-directory#change' } %></div><% end %>
        </div>
      </div>
    </details>
  </div>
  <%= render 'filter_badges' %>
  <noscript><button type="submit" class="catalog-button"><%= t('admin.catalog_design.filter') %></button></noscript>
<% end %>
