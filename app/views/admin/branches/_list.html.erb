<div class="branch-results-heading"><h2 id="branches-result-title" tabindex="-1" role="status" aria-live="polite" aria-atomic="true"><%= t('admin.branch_workspace.results', count: total_count) %></h2><span class="branch-muted"><%= t('admin.branch_workspace.page', current: current_page, total: total_pages) %></span></div>
<% if branches.any? %>
  <div class="branch-table-wrap"><table class="branch-table"><thead><tr>
    <th><%= sort_link('branches.name', t('admin.branches.index.columns.branch'), frame: 'branches_list') %></th>
    <th><%= t('admin.branch_workspace.contact') %></th><th><%= sort_link('addresses.street', t('admin.branches.index.columns.address'), frame: 'branches_list') %></th>
    <th><%= sort_link('branches.operational_status', t('admin.branches.index.columns.status'), frame: 'branches_list') %></th><th class="branch-actions-heading"><%= t('admin.branches.index.columns.actions') %></th>
  </tr></thead><tbody>
    <% branches.each do |branch| %><tr>
      <td><div class="branch-identity"><span class="branch-avatar"><%= delta_icon('building-storefront', class: 'size-5') %></span><div><%= link_to branch.name, admin_branch_path(branch, branch_directory_parameters), class: 'branch-name', data: { turbo_frame: '_top' } %><p class="branch-secondary"><span class="branch-code"><%= branch_code(branch) %></span> · <%= t('admin.branch_workspace.assigned_people', count: @branch_team_counts.fetch(branch.id, 0)) %></p></div></div></td>
      <td><%= branch_contact_link(branch) %><% if branch.contact_email.present? %><p class="branch-secondary"><%= mail_to branch.contact_email %></p><% end %></td>
      <td><p class="branch-address"><%= [branch.address&.street, branch.address&.exterior_number].compact_blank.join(' ').presence || t('admin.branch_workspace.location_pending') %></p><p class="branch-secondary"><%= branch_location(branch) %></p></td>
      <td><%= branch_operational_status(branch) %></td><td><%= render 'actions', branch: branch, can_manage_branches: can_manage_branches %></td>
    </tr><% end %>
  </tbody></table></div>
  <div class="branch-mobile-list"><% branches.each do |branch| %><article class="branch-mobile-card"><div class="branch-mobile-heading"><div><%= link_to branch.name, admin_branch_path(branch, branch_directory_parameters), class: 'branch-name', data: { turbo_frame: '_top' } %><p class="branch-secondary"><%= branch_code(branch) %></p></div><%= branch_operational_status(branch) %></div><p class="branch-mobile-location"><%= delta_icon('map-pin', class: 'size-4') %><%= branch_location(branch) %></p><%= branch_contact_link(branch) %><% if branch.contact_email.present? %><p class="branch-secondary"><%= mail_to branch.contact_email %></p><% end %><div class="branch-mobile-footer"><span class="branch-muted"><%= t('admin.branch_workspace.assigned_people', count: @branch_team_counts.fetch(branch.id, 0)) %></span><%= render 'actions', branch: branch, can_manage_branches: can_manage_branches %></div></article><% end %></div>
  <div class="branch-pagination"><%= render 'admin/shared/table_pagination', table_key: 'branches' %></div>
<% else %>
  <div class="branch-empty"><span class="branch-avatar"><%= delta_icon('building-storefront', class: 'size-6') %></span><h3><%= t(@branch_filters.values.any?(&:present?) ? 'admin.branch_workspace.no_matches' : 'admin.branches.empty.title') %></h3><p><%= t(@branch_filters.values.any?(&:present?) ? 'admin.branch_workspace.no_matches_hint' : 'admin.branches.empty.subtitle') %></p>
  <% if @branch_filters.values.any?(&:present?) %><%= link_to t('admin.branch_workspace.clear_all'), admin_branches_path, class: 'catalog-button', data: { action: 'click->branch-directory#clear', turbo_frame: '_top' } %><% elsif can_manage_branches %><%= link_to t('admin.branches.index.new'), new_admin_branch_path, class: 'catalog-button catalog-button-primary', data: { turbo_frame: '_top' } %><% end %></div>
<% end %>
