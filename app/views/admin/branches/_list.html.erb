  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <% if branches.any? %>
      <div class="hidden overflow-x-auto md:block">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"><%= t('admin.branches.index.columns.branch') %></th>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"><%= t('admin.branches.index.columns.phone') %></th>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"><%= t('admin.branches.index.columns.address') %></th>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"><%= t('admin.branches.index.columns.status') %></th>
              <th class="px-6 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500"><%= t('admin.branches.index.columns.actions') %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% branches.each do |branch| %>
              <% address = branch.address %>
              <tr class="transition hover:bg-slate-50">
                <td class="px-6 py-4"><span class="font-medium text-slate-900"><%= branch.name %></span></td>
                <td class="px-6 py-4 text-sm text-slate-600"><%= branch.phone.presence || t('admin.branches.index.no_data') %></td>
                <td class="max-w-xs truncate px-6 py-4 text-sm text-slate-600"><%= address&.full_address.presence || t('admin.branches.index.no_data') %></td>
                <td class="px-6 py-4">
                  <% if branch.status %>
                    <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700"><%= t('admin.branches.statuses.active') %></span>
                  <% else %>
                    <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600"><%= t('admin.branches.statuses.inactive') %></span>
                  <% end %>
                </td>
                <td class="px-6 py-4">
                  <div class="flex justify-end gap-1">
                    <%= link_to admin_branch_path(branch),
                                title: t('admin.branches.index.title'),
                                aria: { label: t('admin.branches.index.title') },
                                class: 'rounded-lg p-2 text-slate-600 transition hover:bg-slate-100' do %>
                      <%= icon('eye', class: 'size-5') %>
                    <% end %>
                    <% if can_manage_branches %>
                      <%= link_to edit_admin_branch_path(branch),
                                  title: t('admin.branches.actions.edit'),
                                  aria: { label: t('admin.branches.actions.edit') },
                                  class: 'rounded-lg p-2 text-blue-600 transition hover:bg-blue-50' do %>
                        <%= icon('pencil-square', class: 'size-5') %>
                      <% end %>
                      <%= button_to admin_branch_path(branch),
                                    method: :delete,
                                    title: t('admin.branches.actions.delete'),
                                    aria: { label: t('admin.branches.actions.delete') },
                                    form: {
                                      data: {
                                        controller: 'swal-confirm',
                                        turbo_frame: 'branches_list',
                                        turbo_confirm: t('admin.branches.confirm_delete'),
                                        swal_cancel_text: t('admin.branches.confirm.cancel')
                                      }
                                    },
                                    class: 'rounded-lg p-2 text-red-600 transition hover:bg-red-50' do %>
                        <%= icon('trash', class: 'size-5') %>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="divide-y divide-slate-100 md:hidden">
        <% branches.each do |branch| %>
          <% address = branch.address %>
          <div class="p-4">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="font-semibold text-slate-900"><%= branch.name %></h2>
                <p class="mt-1 text-sm text-slate-500"><%= branch.phone.presence || t('admin.branches.index.no_phone') %></p>
              </div>
              <% if branch.status %>
                <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700"><%= t('admin.branches.statuses.active') %></span>
              <% else %>
                <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600"><%= t('admin.branches.statuses.inactive') %></span>
              <% end %>
            </div>
            <p class="mt-3 text-sm text-slate-600"><%= address&.full_address.presence || t('admin.branches.index.no_address') %></p>
            <div class="mt-4 flex justify-end gap-1">
              <%= link_to admin_branch_path(branch),
                          title: t('admin.branches.index.title'),
                          aria: { label: t('admin.branches.index.title') },
                          class: 'rounded-lg p-2 text-slate-600 transition hover:bg-slate-100' do %>
                <%= icon('eye', class: 'size-5') %>
              <% end %>
              <% if can_manage_branches %>
                <%= link_to edit_admin_branch_path(branch),
                            title: t('admin.branches.actions.edit'),
                            aria: { label: t('admin.branches.actions.edit') },
                            class: 'rounded-lg p-2 text-blue-600 transition hover:bg-blue-50' do %>
                  <%= icon('pencil-square', class: 'size-5') %>
                <% end %>
                <%= button_to admin_branch_path(branch),
                              method: :delete,
                              title: t('admin.branches.actions.delete'),
                              aria: { label: t('admin.branches.actions.delete') },
                              form: {
                                      data: {
                                        controller: 'swal-confirm',
                                        turbo_frame: 'branches_list',
                                        turbo_confirm: t('admin.branches.confirm_delete'),
                                        swal_cancel_text: t('admin.branches.confirm.cancel')
                                      }
                                    },
                              class: 'rounded-lg p-2 text-red-600 transition hover:bg-red-50' do %>
                  <%= icon('trash', class: 'size-5') %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <% if total_count > 10 %>
        <div class="flex flex-col gap-4 border-t border-slate-100 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-2 text-sm text-slate-600">
            <label for="branches-per-page"><%= t('admin.branches.index.pagination.per_page_label') %></label>
            <%= select_tag :per_page,
                          options_for_select(Admin::BranchesController::PER_PAGE_OPTIONS, per_page),
                          id: 'branches-per-page',
                          data: { controller: 'branches-pagination', action: 'change->branches-pagination#perPageChanged' },
                          class: 'rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500' %>
          </div>

          <% if total_pages > 1 %>
            <nav class="flex items-center gap-1" aria-label="<%= t('admin.branches.index.pagination.navigation') %>">
              <% if current_page > 1 %>
                <%= link_to t('admin.branches.index.pagination.prev'),
                            admin_branches_path(request.query_parameters.merge(page: current_page - 1)),
                            class: 'rounded-lg border border-slate-300 px-3 py-1.5 text-sm text-slate-700 transition hover:bg-slate-100' %>
              <% end %>

              <% (1..total_pages).each do |page| %>
                <% if page == current_page %>
                  <span class="rounded-lg bg-blue-600 px-3 py-1.5 text-sm font-semibold text-white" aria-current="page"><%= page %></span>
                <% else %>
                  <%= link_to page,
                              admin_branches_path(request.query_parameters.merge(page: page)),
                              class: 'rounded-lg border border-slate-300 px-3 py-1.5 text-sm text-slate-700 transition hover:bg-slate-100' %>
                <% end %>
              <% end %>

              <% if current_page < total_pages %>
                <%= link_to t('admin.branches.index.pagination.next'),
                            admin_branches_path(request.query_parameters.merge(page: current_page + 1)),
                            class: 'rounded-lg border border-slate-300 px-3 py-1.5 text-sm text-slate-700 transition hover:bg-slate-100' %>
              <% end %>
            </nav>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="px-6 py-14 text-center">
        <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-slate-100 text-slate-500">
          <%= icon('building-office-2', class: 'size-6') %>
        </div>
        <h2 class="mt-4 text-base font-semibold text-slate-900"><%= t('admin.branches.empty.title') %></h2>
        <p class="mt-1 text-sm text-slate-500"><%= t('admin.branches.empty.subtitle') %></p>
        <% if can_manage_branches %>
          <%= link_to new_admin_branch_path,
                      class: 'mt-5 inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700' do %>
            <%= icon('plus', class: 'size-4') %>
            <%= t('admin.branches.index.new') %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
