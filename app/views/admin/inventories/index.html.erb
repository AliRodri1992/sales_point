<div class="space-y-6">
  <header class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h1 class="font-jakarta text-2xl font-bold text-slate-900"><%= t('admin.inventory.title') %>: <%= @branch.name %></h1>
    <p class="mt-2 text-sm text-slate-500"><%= t('admin.inventory.description') %></p>
  </header>

  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <%= form_with url: admin_branch_inventories_path(@branch), scope: :inventory, class: 'flex flex-wrap gap-3' do |form| %>
      <%= form.collection_select :product_id, current_organization.products.not_deleted.order(:name),
                                 :id, :name, { include_blank: t('admin.inventory.product') },
                                 { required: true, class: 'rounded-xl border border-slate-200 p-3' } %>
      <%= form.number_field :min_stock, placeholder: t('admin.inventory.min_stock'), min: 0, step: 0.001,
                            class: 'rounded-xl border border-slate-200 p-3' %>
      <%= form.number_field :max_stock, placeholder: t('admin.inventory.max_stock'), min: 0, step: 0.001,
                            class: 'rounded-xl border border-slate-200 p-3' %>
      <%= form.submit t('admin.inventory.add'), class: 'rounded-xl bg-emerald-600 px-4 py-3 font-semibold text-white' %>
    <% end %>
  </div>

  <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-slate-100 text-sm">
      <thead><tr>
        <% %w[product stock min_stock max_stock movements].each do |key| %>
          <th class="p-4 text-left"><%= t("admin.inventory.#{key}") %></th>
        <% end %>
      </tr></thead>
      <tbody>
        <% @inventories.each do |inventory| %>
          <tr class="border-t border-slate-100">
            <td class="p-4"><%= inventory.product.name %></td>
            <td class="p-4"><%= inventory.stock %></td>
            <td class="p-4"><%= inventory.min_stock %></td>
            <td class="p-4"><%= inventory.max_stock || '—' %></td>
            <td class="p-4">
              <%= link_to t('admin.purchases.lot_traceability'),
                          admin_branch_inventory_inventory_lots_path(@branch, inventory),
                          class: 'mb-2 inline-block font-semibold text-emerald-700 hover:underline' %>
              <%= form_with url: adjust_admin_branch_inventory_path(@branch, inventory), class: 'flex gap-2' do |form| %>
                <%= form.number_field :quantity, required: true, step: 0.001,
                                      placeholder: t('admin.inventory.quantity'),
                                      class: 'w-32 rounded-xl border border-slate-200 p-2' %>
                <%= form.submit t('admin.inventory.adjust'),
                                class: 'rounded-lg bg-emerald-600 px-3 py-2 font-semibold text-white' %>
              <% end %>
              <% inventory.inventory_movements.order(created_at: :desc).limit(5).each do |movement| %>
                <p class="mt-1 text-xs text-slate-500"><%= movement.kind %>: <%= movement.quantity %></p>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
