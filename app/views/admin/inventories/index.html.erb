<div class="space-y-6">
  <header class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h1 class="font-jakarta text-2xl font-bold text-slate-900">
      <%= t('admin.inventory.title') %>: <%= @branch.name %>
    </h1>
    <p class="mt-2 text-sm text-slate-500"><%= t('admin.inventory.description') %></p>
  </header>

  <% unless @branch.closed? || @branch.suspended? %>
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
             aria-labelledby="inventory-create-title">
      <h2 id="inventory-create-title" class="mb-4 font-jakarta text-sm font-bold text-slate-800">
        <%= t('admin.inventory.add') %>
      </h2>
      <%= form_with model: (@new_inventory || Inventory.new), scope: :inventory,
                    url: admin_branch_inventories_path(@branch),
                    html: { novalidate: true }, class: 'grid gap-4 sm:grid-cols-3' do |form| %>
        <div class="catalog-field sm:col-span-3">
          <%= form.label :product_id, branch_required_label(t('admin.inventory.product')),
                         class: 'catalog-label' %>
          <div data-controller="delta-select" data-searchable="true"
               data-search-placeholder="<%= t('admin.branch_workspace.filters.search') %>">
            <%= form.collection_select :product_id, current_organization.products.not_deleted.order(:name),
                                       :id, :name, { include_blank: t('admin.inventory.product') },
                                       { class: 'w-full rounded-xl border border-slate-200 p-3',
                                         aria: { invalid: @new_inventory&.errors&.attribute_names&.include?(:product),
                                                 describedby: 'inventory-product-error' } } %>
          </div>
          <% if @new_inventory&.errors&.[](:product)&.present? %>
            <p id="inventory-product-error" role="alert" class="mt-1 text-xs text-rose-700">
              <%= t('admin.inventory.product') %> <%= @new_inventory.errors[:product].join(', ') %>
            </p>
          <% end %>
        </div>
        <% %i[min_stock max_stock].each do |field| %>
          <div class="catalog-field">
            <%= form.label field, t("admin.inventory.#{field}"), class: 'catalog-label' %>
            <%= form.number_field field, step: 0.001,
                                  class: 'w-full rounded-xl border border-slate-200 p-3',
                                  aria: { invalid: @new_inventory&.errors&.attribute_names&.include?(field),
                                          describedby: "inventory-#{field}-error" } %>
            <% if @new_inventory&.errors&.[](field)&.present? %>
              <p id="inventory-<%= field %>-error" role="alert" class="mt-1 text-xs text-rose-700">
                <%= t("admin.inventory.#{field}") %> <%= @new_inventory.errors[field].join(', ') %>
              </p>
            <% end %>
          </div>
        <% end %>
        <div class="flex items-end">
          <%= form.submit t('admin.inventory.add'), class: 'catalog-button catalog-button-primary w-full' %>
        </div>
      <% end %>
    </section>
  <% end %>

  <section class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-slate-100 text-sm">
      <thead><tr>
        <% %w[product stock min_stock max_stock movements].each do |key| %>
          <th scope="col" class="p-4 text-left"><%= t("admin.inventory.#{key}") %></th>
        <% end %>
      </tr></thead>
      <tbody>
        <% @inventories.each do |inventory| %>
          <tr class="border-t border-slate-100">
            <td class="p-4"><%= inventory.product.name %></td>
            <td class="p-4"><%= inventory.stock %></td>
            <td class="p-4"><%= inventory.min_stock %></td>
            <td class="p-4"><%= inventory.max_stock || '—' %></td>
            <td class="p-4">
              <%= link_to t('admin.purchases.lot_traceability'),
                          admin_branch_inventory_inventory_lots_path(@branch, inventory),
                          class: 'mb-2 inline-block font-semibold text-emerald-700 hover:underline' %>
              <% unless @branch.closed? %>
                <% if inventory.product.tracking_serial? %>
                  <p class="mb-2 text-xs text-amber-800">
                    <%= t('admin.branch_lifecycle.serial_adjustment_notice') %>
                  </p>
                <% else %>
                  <%= form_with url: adjust_admin_branch_inventory_path(@branch, inventory),
                                html: { novalidate: true },
                                class: 'flex flex-wrap items-start gap-2' do |form| %>
                    <% if inventory.product.tracking_lot? || inventory.inventory_lots.any? %>
                      <div class="catalog-field">
                        <%= label_tag "inventory-lot-#{inventory.id}",
                                      branch_required_label(t('admin.branch_lifecycle.inventory_lot_label')),
                                      class: 'catalog-label' %>
                        <% available_lots = inventory.inventory_lots.reject(&:quarantined?).sort_by(&:code) %>
                        <% lot_options = available_lots.map { |lot| ["#{lot.code} · #{lot.quantity}", lot.id] } %>
                        <div data-controller="delta-select" data-searchable="false">
                          <%= select_tag :inventory_lot_id,
                                         options_for_select(
                                           [[t('admin.branch_lifecycle.inventory_lot_choose'), ''], *lot_options],
                                           @adjustment_inventory_id == inventory.id ? @adjustment_lot_id : nil
                                         ),
                                         id: "inventory-lot-#{inventory.id}",
                                         class: 'w-44 rounded-xl border border-slate-200 p-2',
                                         aria: { required: true,
                                                 invalid: @adjustment_inventory_id == inventory.id &&
                                                          @adjustment_lot_error.present?,
                                                 describedby: "inventory-lot-error-#{inventory.id}" } %>
                        </div>
                        <% if @adjustment_inventory_id == inventory.id && @adjustment_lot_error.present? %>
                          <p id="inventory-lot-error-<%= inventory.id %>" role="alert"
                             class="mt-1 max-w-44 text-xs text-rose-700">
                            <%= t('admin.branch_lifecycle.inventory_lot_label') %>
                            <%= @adjustment_lot_error %>
                          </p>
                        <% end %>
                      </div>
                    <% end %>
                    <div class="catalog-field">
                      <%= form.label :quantity, t('admin.inventory.quantity'), class: 'sr-only' %>
                      <%= form.number_field :quantity, step: 0.001,
                                            value: (@adjustment_inventory_id == inventory.id ? @adjustment_value : nil),
                                            placeholder: t('admin.inventory.quantity'),
                                            class: 'w-32 rounded-xl border border-slate-200 p-2',
                                            aria: { invalid: @adjustment_inventory_id == inventory.id &&
                                                             @adjustment_error.present?,
                                                    describedby: "inventory-quantity-error-#{inventory.id}" } %>
                      <% if @adjustment_inventory_id == inventory.id && @adjustment_error.present? %>
                        <p id="inventory-quantity-error-<%= inventory.id %>" role="alert"
                           class="mt-1 max-w-40 text-xs text-rose-700">
                          <%= t('admin.inventory.quantity') %> <%= @adjustment_error %>
                        </p>
                      <% end %>
                    </div>
                    <%= form.submit t('admin.inventory.adjust'),
                                    class: 'catalog-button catalog-button-primary' %>
                  <% end %>
                <% end %>
              <% end %>
              <% (@recent_movements_by_inventory[inventory.id] || []).each do |movement| %>
                <p class="mt-1 text-xs text-slate-500"><%= movement.kind %>: <%= movement.quantity %></p>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @inventories.empty? %>
      <p class="p-6 text-sm text-slate-600"><%= t('admin.branch_lifecycle.inventory_empty') %></p>
    <% end %>
  </section>
</div>
