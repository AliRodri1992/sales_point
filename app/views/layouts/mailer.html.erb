<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t('demo_request_mailer.new_request.subject') %></title>
  </head>
  <body style="margin:0;padding:0;background-color:#f1f5f9;color:#0f172a;font-family:Arial,Helvetica,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background-color:#f1f5f9;">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:640px;background-color:#ffffff;border:1px solid #e2e8f0;border-radius:16px;overflow:hidden;">
            <tr>
              <td style="padding:28px 32px;background-color:#064e3b;">
                <img src="<%= image_url('delta-pos-logo.svg') %>" width="44" height="44" alt="<%= t('demo_request_mailer.new_request.logo_alt') %>" style="display:block;width:44px;height:44px;">
                <div style="height:16px;line-height:16px;">&nbsp;</div>
                <div style="font-size:22px;line-height:30px;font-weight:700;color:#ffffff;">Delta POS</div>
                <div style="font-size:13px;line-height:20px;color:#d1fae5;"><%= t('demo_request_mailer.new_request.brand_tagline') %></div>
              </td>
            </tr>
            <tr>
              <td style="padding:36px 32px 32px;"><%= yield %></td>
            </tr>
            <tr>
              <td style="padding:20px 32px;background-color:#f8fafc;border-top:1px solid #e2e8f0;text-align:center;">
                <div style="font-size:12px;line-height:18px;color:#64748b;"><%= t('demo_request_mailer.new_request.footer') %></div>
                <div style="height:4px;line-height:4px;">&nbsp;</div>
                <div style="font-size:12px;line-height:18px;color:#94a3b8;"><%= t('demo_request_mailer.new_request.copyright', year: Time.current.year) %></div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
