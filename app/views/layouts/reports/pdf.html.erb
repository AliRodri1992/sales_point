<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: DejaVu Sans, sans-serif; font-size: 10px; color: #334155; }
    header { border-bottom: 3px solid #059669; padding-bottom: 12px; margin-bottom: 18px; }
    h1 { color: #0f172a; font-size: 21px; margin: 0 0 8px; }
    .brand { color: #047857; font-size: 13px; font-weight: bold; }
    .meta { color: #64748b; }
    table { border-collapse: collapse; width: 100%; table-layout: fixed; }
    thead { display: table-header-group; }
    tr { page-break-inside: avoid; }
    th { background: #047857; color: white; text-align: left; padding: 9px; }
    td { border-bottom: 1px solid #e2e8f0; padding: 8px; word-wrap: break-word; }
    tr:nth-child(even) td { background: #f8fafc; }
  </style>
</head>
<body><%= yield %></body>
</html>
