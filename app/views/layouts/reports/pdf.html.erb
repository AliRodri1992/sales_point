<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'DejaVu Sans', sans-serif; font-size: 10px; color: #334155; }
    .report-header { display: table; width: 100%; padding: 0 0 16px; margin-bottom: 20px; border-bottom: 3px solid #059669; }
    .report-brand, .report-meta { display: table-cell; vertical-align: middle; }
    .report-brand { width: 58%; }
    .organization-logo { display: block; max-width: 180px; max-height: 58px; width: auto; height: auto; }
    .default-logo { display: table; }
    .default-logo svg, .default-logo .brand { display: table-cell; vertical-align: middle; }
    .default-logo .brand { padding-left: 10px; }
    .brand { font-size: 21px; font-weight: bold; letter-spacing: 1px; color: #0f172a; }
    .brand span { color: #059669; }
    .report-type { margin-top: 5px; font-size: 13px; font-weight: bold; color: #334155; }
    .report-meta { text-align: right; font-size: 9px; color: #64748b; line-height: 1.7; }
    .report-meta strong { font-size: 11px; color: #0f172a; }
    table { border-collapse: collapse; width: 100%; table-layout: fixed; }
    thead { display: table-header-group; }
    tr { page-break-inside: avoid; }
    th { background: #047857; color: #fff; text-align: left; padding: 11px 9px; font-size: 9px; }
    td { border-bottom: 1px solid #e2e8f0; padding: 10px 9px; word-wrap: break-word; overflow-wrap: break-word; }
    tbody tr:nth-child(even) td { background: #f8fafc; }
  </style>
</head>
<body><%= yield %></body>
</html>
