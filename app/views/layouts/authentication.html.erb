<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full bg-slate-50">
   <head>
      <title><%= content_for?(:title) ? yield(:title) : "Post - Terminal" %></title>
      <meta name="viewport" content="width=device-width,initial-scale=1">
      <meta name="apple-mobile-web-app-capable" content="yes">
      <meta name="application-name" content="Sale Point">
      <meta name="mobile-web-app-capable" content="yes">
      <%= csrf_meta_tags %>
      <%= csp_meta_tag %>

      <%= yield :head %>

      <link rel="icon" href="/icon.png" type="image/png">
      <link rel="icon" href="/icon.svg" type="image/svg+xml">
      <link rel="apple-touch-icon" href="/icon.png">

      <%# 1. Favicon multi-resolución para navegadores clásicos y modernos %>
      <%= favicon_link_tag 'favicon.ico', rel: 'icon', sizes: 'any' %>

      <%# 2. Favicons específicos en formato PNG (32x32 se prioriza en pantallas retina) %>
      <%= favicon_link_tag 'favicon-32x32.png', rel: 'icon', type: 'image/png', sizes: '32x32' %>
      <%= favicon_link_tag 'favicon-16x16.png', rel: 'icon', type: 'image/png', sizes: '16x16' %>

      <%# 3. Icono de acceso directo exclusivo para Apple (iOS/Safari) %>
      <%= favicon_link_tag 'apple-touch-icon.png', rel: 'apple-touch-icon', type: 'image/png', sizes: '180x180' %>

      <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
      <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

   </head>

   <body class="h-full antialiased relative select-none">
      <%= yield %>
   </body>
</html>
