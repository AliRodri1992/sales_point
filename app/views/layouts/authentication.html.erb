<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full bg-slate-50">
   <head>
      <title><%= content_for?(:title) ? yield(:title) : "Post - Terminal" %></title>
      <meta name="viewport" content="width=device-width,initial-scale=1">
      <meta name="apple-mobile-web-app-capable" content="yes">
      <meta name="application-name" content="<%= t("app.name") %> <%= t("app.short_name") %>">
      <meta name="mobile-web-app-capable" content="yes">
      <%= csrf_meta_tags %>
      <%= csp_meta_tag %>
      <%= yield :head %>

      <%= favicon_link_tag 'delta-pos-favicon.svg', rel: 'icon', type: 'image/svg+xml' %>
      <%= favicon_link_tag 'apple-touch-icon.png', rel: 'apple-touch-icon', type: 'image/png', sizes: '180x180' %>

      <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
      <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    </head>

    <body class="min-h-screen overflow-x-hidden bg-slate-900 font-sans text-slate-600 antialiased <%= "theme-#{current_terminal_theme}" %>" data-controller="terminal">
      <div data-terminal-target="wrapper">
        <div
          data-controller="swal-flash"
          data-swal-flash-message-value="<%= flash[:swal_message] %>"
          data-swal-flash-icon-value="<%= flash[:swal_message] ? 'error' : 'success' %>">
          <%= yield %>
        </div>
      </div>
    </body>
</html>
