<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full bg-slate-50">
   <head>
      <title><%= content_for?(:title) ? yield(:title) : "Post - Terminal" %></title>
      <meta name="viewport" content="width=device-width,initial-scale=1">
      <meta name="apple-mobile-web-app-capable" content="yes">
      <meta name="application-name" content="Sale Point">
      <meta name="mobile-web-app-capable" content="yes">
      <%= csrf_meta_tags %>
      <%= csp_meta_tag %>

      <%= yield :head %>

      <%= favicon_link_tag 'favicon.ico', rel: 'icon', sizes: 'any' %>
      <%= favicon_link_tag 'apple-touch-icon.png', rel: 'apple-touch-icon', type: 'image/png', sizes: '180x180' %>

      <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
      <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

   </head>

   <body class="h-full antialiased relative select-none">
      <div data-controller="swal-flash"
           data-swal-flash-message-value="<%= flash[:swal_message] || flash[:alert] || flash[:notice] %>"
           data-swal-flash-icon-value="<%= flash[:alert] ? 'error' : 'success' %>">
         <%= yield %>
      </div>
   </body>
</html>
