<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full scroll-smooth">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : t("app.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app.name") %> <%= t("app.short_name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= t("app.description") %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= favicon_link_tag "delta-pos-favicon.svg", rel: "icon", type: "image/svg+xml" %>
    <%= favicon_link_tag "apple-touch-icon.png", rel: "apple-touch-icon", type: "image/png", sizes: "180x180" %>
    <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body class="min-h-full bg-slate-50 font-inter text-slate-600 antialiased selection:bg-emerald-600 selection:text-white">
    <div
      data-controller="swal-flash"
      data-swal-flash-message-value="<%= session.delete(:swal_message) %>"
      data-swal-flash-icon-value="<%= session.delete(:swal_icon) || 'success' %>"
    ></div>
    <%= yield %>
  </body>
</html>