<!DOCTYPE html>
<html lang="es" class="h-full scroll-smooth">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Delta POS | Sistema de Punto de Venta" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Delta POS">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="Delta POS: plataforma moderna para administrar ventas, inventario, clientes y operación comercial desde cualquier dispositivo.">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%= favicon_link_tag "favicon.ico", rel: "icon", sizes: "any" %>
    <%= favicon_link_tag "apple-touch-icon.png", rel: "apple-touch-icon", type: "image/png", sizes: "180x180" %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-full bg-slate-50 font-inter text-slate-600 antialiased selection:bg-emerald-600 selection:text-white">
    <main>
      <%= yield %>
    </main>
  </body>
</html>
