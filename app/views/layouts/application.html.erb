<!DOCTYPE html>
<html lang="es" class="h-full scroll-smooth">
  <head>
    <title>
      <%= content_for?(:title) ? yield(:title) : "Nexo POS | Sistema de Punto de Venta" %>
    </title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Sale Point">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="Sistema de Punto de Venta moderno para administrar ventas, inventario, compras y clientes desde cualquier dispositivo.">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= favicon_link_tag 'favicon.ico', rel: 'icon', sizes: 'any' %>
    <%= favicon_link_tag 'apple-touch-icon.png', rel: 'apple-touch-icon', type: 'image/png', sizes: '180x180' %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="bg-slate-950 text-white antialiased selection:bg-blue-600 selection:text-white">
     <main>
       <%= yield %>
     </main>
  </body>
</html>
