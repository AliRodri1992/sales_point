<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full bg-slate-100">
<head>
  <title><%= content_for?(:title) ? yield(:title) : t('admin.dashboard.index.title') %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="application-name" content="Nexo POS">
  <meta name="mobile-web-app-capable" content="yes">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= yield :head %>

  <%= favicon_link_tag 'favicon.ico', rel: 'icon', sizes: 'any' %>
  <%= favicon_link_tag 'apple-touch-icon.png', rel: 'apple-touch-icon', type: 'image/png', sizes: '180x180' %>
  <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
</head>

<body class="min-h-full bg-slate-100 text-slate-900 antialiased">
<script
  id="javascriptTranslations" type="application/json">
  <%= raw javascript_dashboard_translations %>
</script>

<div class="flex min-h-screen">
  <%= render "admin/shared/sidebar" %>

  <div class="flex min-w-0 flex-1 flex-col">
    <%= render "admin/shared/topbar" %>

    <%= render "admin/shared/breadcrumbs" %>

    <main class="flex-1 px-4 py-6 lg:px-6">
      <%= turbo_frame_tag "flash" do %>
        <%= render "admin/shared/flash" %>
      <% end %>

      <% if flash[:swal_message].present? %>
        <div data-controller="swal-flash"
             data-swal-flash-message-value="<%= flash[:swal_message] %>"
             data-swal-flash-icon-value="success"
             class="hidden"></div>
      <% end %>

      <%= yield %>
    </main>

    <%= render "admin/shared/footer" %>
  </div>
</div>

<%= render "admin/shared/chat" %>
<%= render "admin/shared/online_users" %>

<%= turbo_frame_tag "language_modal",
      data: {
        controller: "modal",
        action: "turbo:frame-load->modal#frameLoaded keydown.esc@window->modal#close click->modal#background"
      },
      class: "language-modal fixed inset-0 z-[60] hidden items-center justify-center overflow-y-auto bg-slate-900/40 p-4 backdrop-blur-[2px] sm:p-6",
      aria: { hidden: "true" } %>

<%= turbo_frame_tag "area_modal",
      data: {
        controller: "modal",
        action: "turbo:frame-load->modal#frameLoaded keydown.esc@window->modal#close click->modal#background"
      },
      class: "area-modal fixed inset-0 z-[60] hidden items-center justify-center overflow-y-auto bg-slate-900/40 p-4 backdrop-blur-[2px] sm:p-6",
      aria: { hidden: "true" } %>
</body>
</html>