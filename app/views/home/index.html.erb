<div class="landing-page">
<%= render Landing::NavbarComponent.new %>

<main class="overflow-x-hidden">
  <%= render Landing::HeroComponent.new(
    badge: t('landing.hero.badge'),
    title: t('landing.hero.title'),
    highlighted: t('landing.hero.highlighted'),
    description: t('landing.hero.description'),
    primary_button_text: t('landing.buttons.start'),
    primary_button_href: new_user_registration_path,
    secondary_button_text: t('landing.buttons.request_demo'),
    secondary_button_href: new_demo_request_path
  ) %>

  <section id="solucion" class="border-y border-slate-200/50 bg-slate-100/60 py-12 lg:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <h2 class="font-jakarta text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl"><%= t('landing.hero.problem_title') %></h2>
        <p class="mt-4 text-base text-slate-500 sm:text-lg"><%= t('landing.hero.old_model_intro') %></p>
      </div>
      <div class="mx-auto grid max-w-5xl gap-12 md:grid-cols-2">
        <article class="space-y-4 rounded-2xl border border-rose-100 bg-rose-50/50 p-8">
          <h3 class="flex items-center gap-2 font-jakarta text-xl font-bold text-rose-800"><span aria-hidden="true">❌</span><%= t('landing.hero.old_model_title') %></h3>
          <ul class="space-y-3 text-sm text-slate-600">
            <li><span aria-hidden="true">👉</span> <%= t('home.old_model.item_1') %></li>
            <li><span aria-hidden="true">👉</span> <%= t('home.old_model.item_2') %></li>
            <li><span aria-hidden="true">👉</span> <%= t('home.old_model.item_3') %></li>
          </ul>
        </article>
        <article class="space-y-4 rounded-2xl border border-emerald-100 bg-emerald-50/50 p-8">
          <h3 class="flex items-center gap-2 font-jakarta text-xl font-bold text-emerald-600"><span aria-hidden="true">🚀</span><%= t('landing.hero.new_model_title') %></h3>
          <ul class="space-y-3 text-sm text-slate-600">
            <li><span aria-hidden="true">✅</span> <%= t('home.new_model.item_1') %></li>
            <li><span aria-hidden="true">✅</span> <%= t('home.new_model.item_2') %></li>
            <li><span aria-hidden="true">✅</span> <%= t('home.new_model.item_3') %></li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <%= render Landing::FeaturesComponent.new(title: t('landing.features.title'), subtitle: t('landing.features.subtitle'), features: @features) %>

  <section class="relative min-h-[460px] overflow-hidden border-t border-slate-100 bg-gradient-to-b from-white to-slate-50 py-12 lg:py-16" data-controller="testimonials-carousel">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-8 max-w-2xl text-center">
        <h2 class="font-jakarta text-3xl font-extrabold tracking-tight text-slate-900"><%= t('landing.hero.testimonials_title') %></h2>
      </div>

      <div id="landing-testimonials" aria-label="<%= t('landing.testimonials.title') %>">
        <% @testimonials.each_slice(3) do |testimonials| %>
          <div data-testimonials-carousel-target="slide" class="mb-8 grid grid-cols-1 gap-8 md:grid-cols-3">
            <% testimonials.each do |testimonial| %>
              <%= render Landing::TestimonialComponent.new(**testimonial.to_h) %>
            <% end %>
          </div>
        <% end %>
      </div>
      <% if @testimonials.size > 3 %>
        <div class="mt-8 hidden items-center justify-center gap-4" data-testimonials-carousel-target="controls">
          <button type="button" data-action="testimonials-carousel#previous" aria-controls="landing-testimonials" class="min-h-11 rounded-xl border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 hover:bg-slate-50"><%= t('landing.testimonials.controls.previous') %></button>
          <span role="status" aria-live="polite" aria-atomic="true" class="text-sm font-medium text-slate-600">
            <span class="sr-only"><%= t('landing.testimonials.controls.group') %></span>
            <span data-testimonials-carousel-target="status"></span>
          </span>
          <button type="button" data-action="testimonials-carousel#next" aria-controls="landing-testimonials" class="min-h-11 rounded-xl bg-emerald-700 px-4 text-sm font-semibold text-white hover:bg-emerald-800"><%= t('landing.testimonials.controls.next') %></button>
        </div>
      <% end %>
    </div>
  </section>

  <section id="precios" class="border-t border-slate-200/60 bg-slate-100/50 py-12 lg:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center"><h2 class="font-jakarta text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl"><%= t('landing.hero.prices_title') %></h2></div>
      <div class="mx-auto grid max-w-4xl items-stretch gap-8 md:grid-cols-2"><% @plans.first(2).each do |plan| %><%= render Landing::PricingCardComponent.new(**plan.to_h) %><% end %></div>
    </div>
  </section>

  <%= render Landing::FaqComponent.new(title: t('landing.faq.title'), subtitle: t('landing.faq.subtitle'), questions: @questions) %>
  <%= render Landing::CtaComponent.new(title: t('landing.hero.cta_title'), description: t('landing.hero.cta_description'), button_text: t('landing.buttons.start'), button_href: new_user_registration_path) %>
</main>

<%= render Landing::FooterComponent.new %>
</div>
