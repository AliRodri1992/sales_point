<%= render Landing::NavbarComponent.new %>

<main class="overflow-x-hidden">
  <%= render Landing::HeroComponent.new(
    badge: t("landing.hero.badge"),
    title: t("landing.hero.title"),
    highlighted: t("landing.hero.highlighted"),
    description: t("landing.hero.description"),
    image: "logo.png",
    primary_button: Ui::ButtonComponent.new(
      text: t("landing.buttons.start_free"),
      href: new_user_registration_path,
      icon: :rocket_launch,
      size: :lg,
      variant: :primary
    ),
    secondary_button: Ui::ButtonComponent.new(
      text: t("landing.buttons.view_demo"),
      href: new_demo_request_path,
      icon: :play_circle,
      size: :lg,
      variant: :outline
    ),
    statistics: []
  ) %>

  <section id="solucion" class="border-y border-slate-200/60 bg-slate-100/60 py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <%= render Ui::SectionTitleComponent.new(
        title: "¿Cansado de sistemas lentos que frenan tu negocio?",
        subtitle: "Delta POS está diseñado para reducir fricciones operativas y darte una visión clara de tu negocio."
      ) %>

      <div class="mx-auto mt-10 grid max-w-5xl gap-8 md:grid-cols-2">
        <article class="rounded-2xl border border-rose-100 bg-rose-50/50 p-7">
          <h3 class="font-jakarta text-xl font-bold text-rose-800">El modelo obsoleto</h3>
          <ul class="mt-5 space-y-3 text-sm leading-6 text-slate-600">
            <li>• Filas largas por procesos de venta lentos.</li>
            <li>• Descuadres de inventario entre sucursales.</li>
            <li>• Reportes manuales y difíciles de consolidar.</li>
          </ul>
        </article>

        <article class="rounded-2xl border border-emerald-100 bg-emerald-50/50 p-7">
          <h3 class="font-jakarta text-xl font-bold text-emerald-700">La experiencia Delta POS</h3>
          <ul class="mt-5 space-y-3 text-sm leading-6 text-slate-600">
            <li>• Cobros ágiles con una interfaz clara e intuitiva.</li>
            <li>• Inventario centralizado y preparado para múltiples sucursales.</li>
            <li>• Información operativa disponible desde cualquier dispositivo.</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <%= render Landing::FeaturesComponent.new(
    title: t("landing.features.title"),
    subtitle: t("landing.features.subtitle"),
    features: @features
  ) %>

  <section class="border-t border-slate-100 bg-gradient-to-b from-white to-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <%= render Ui::SectionTitleComponent.new(
        title: t("landing.testimonials.title"),
        subtitle: t("landing.testimonials.subtitle")
      ) %>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <% @testimonials.each do |testimonial| %>
          <%= render Landing::TestimonialComponent.new(**testimonial.to_h) %>
        <% end %>
      </div>
    </div>
  </section>

  <section id="precios" class="border-t border-slate-200/60 bg-slate-100/50 py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <%= render Ui::SectionTitleComponent.new(
        badge: t("landing.pricing.badge"),
        title: t("landing.pricing.title"),
        subtitle: t("landing.pricing.subtitle")
      ) %>

      <div class="mt-10 grid gap-8 md:grid-cols-2">
        <% @plans.first(2).each do |plan| %>
          <%= render Landing::PricingCardComponent.new(**plan.to_h) %>
        <% end %>
      </div>
    </div>
  </section>

  <%= render Landing::FaqComponent.new(
    title: t("landing.faq.title"),
    subtitle: t("landing.faq.subtitle"),
    questions: @questions
  ) %>

  <div id="contacto">
    <%= render Landing::CtaComponent.new(
      title: t("landing.cta.title"),
      description: t("landing.cta.description"),
      button: Ui::ButtonComponent.new(
        text: t("landing.buttons.create_account"),
        href: new_user_registration_path,
        icon: :rocket_launch,
        size: :lg,
        variant: :secondary
      )
    ) %>
  </div>
</main>

<%= render Landing::FooterComponent.new %>
