<main class="mx-auto mt-12 max-w-lg rounded-2xl border border-slate-200 bg-white p-8 shadow-lg">
  <h1 class="font-jakarta text-2xl font-bold"><%= t('user_invitations.title') %></h1>
  <p class="mt-3 text-sm text-slate-600"><%= t('user_invitations.description', organization: @invitation.organization.name) %></p>
  <%= form_with url: accept_user_invitation_path(token: @token), method: :patch, scope: :invitation, html: { novalidate: true }, class: 'mt-6 space-y-4' do |form| %>
    <div>
      <%= form.label :password, t('user_invitations.password'), class: 'block text-sm font-semibold' %><span class="ml-1 font-bold text-rose-600" aria-hidden="true">*</span>
      <%= form.password_field :password, autocomplete: 'new-password',
                              aria: { invalid: @invitation.user.errors[:password].any?,
                                      describedby: @invitation.user.errors[:password].any? ? 'user_password_error' : nil },
                              class: 'input-field min-h-11 w-full rounded-xl' %>
      <%= error_message_for(@invitation.user, :password, label: t('user_invitations.password')) %>
    </div>
    <div>
      <%= form.label :password_confirmation, t('user_invitations.password_confirmation'), class: 'block text-sm font-semibold' %><span class="ml-1 font-bold text-rose-600" aria-hidden="true">*</span>
      <%= form.password_field :password_confirmation, autocomplete: 'new-password',
                              aria: { invalid: @invitation.user.errors[:password_confirmation].any?,
                                      describedby: @invitation.user.errors[:password_confirmation].any? ? 'user_password_confirmation_error' : nil },
                              class: 'input-field min-h-11 w-full rounded-xl' %>
      <%= error_message_for(@invitation.user, :password_confirmation, label: t('user_invitations.password_confirmation')) %>
    </div>
    <%= form.submit t('user_invitations.activate'), class: 'w-full rounded-xl bg-emerald-700 px-5 py-3 font-semibold text-white' %>
  <% end %>
</main>
