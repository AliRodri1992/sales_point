<main class="mx-auto mt-12 max-w-lg rounded-2xl border border-slate-200 bg-white p-8 shadow-lg">
  <h1 class="font-jakarta text-2xl font-bold"><%= t('user_invitations.title') %></h1>
  <p class="mt-3 text-sm text-slate-600"><%= t('user_invitations.description', organization: @invitation.organization.name) %></p>
  <%= form_with url: accept_user_invitation_path(token: @token), method: :patch, scope: :invitation, class: 'mt-6 space-y-4' do |form| %>
    <div><%= form.label :password, t('user_invitations.password'), class: 'block text-sm font-semibold' %>
      <%= form.password_field :password, minlength: 9, required: true, autocomplete: 'new-password', class: 'input-field w-full rounded-xl' %></div>
    <div><%= form.label :password_confirmation, t('user_invitations.password_confirmation'), class: 'block text-sm font-semibold' %>
      <%= form.password_field :password_confirmation, minlength: 9, required: true, autocomplete: 'new-password', class: 'input-field w-full rounded-xl' %></div>
    <% @invitation.user.errors.full_messages.each do |message| %><p role="alert" class="text-sm text-rose-700"><%= message %></p><% end %>
    <%= form.submit t('user_invitations.activate'), class: 'w-full rounded-xl bg-emerald-700 px-5 py-3 font-semibold text-white' %>
  <% end %>
</main>
