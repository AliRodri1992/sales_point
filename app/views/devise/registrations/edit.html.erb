<h2><%= t('devise.registrations.edit.title', resource: resource_name.to_s.humanize) %></h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <p><%= f.label :email %></p>
    <p><%= f.email_field :email, autofocus: true, autocomplete: "email" %></p>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
  <% end %>

  <div class="field">
    <p><%= f.label :password %> <i>(<%= t('devise.registrations.edit.leave_blank') %>)</i></p>
    <p><%= f.password_field :password, autocomplete: "new-password" %></p>
    <% if @minimum_password_length %>
      <p><em><%= t('devise.registrations.edit.minimum', count: @minimum_password_length) %></em></p>
    <% end %>
  </div>

  <div class="field">
    <p><%= f.label :password_confirmation %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :current_password %> <i>(<%= t('devise.registrations.edit.current_password_hint') %>)</i></p>
    <p><%= f.password_field :current_password, autocomplete: "current-password" %></p>
  </div>

  <div class="actions">
    <%= f.submit t('devise.registrations.edit.submit') %>
  </div>
<% end %>

<h3><%= t('devise.registrations.edit.cancel_account') %></h3>

<div><%= t('devise.registrations.edit.unhappy') %> <%= button_to t('devise.registrations.edit.cancel_account'), registration_path(resource_name), data: { confirm: t('devise.registrations.edit.confirm'), turbo_confirm: t('devise.registrations.edit.confirm') }, method: :delete %></div>

<%= link_to t('devise.registrations.edit.back'), :back %>
