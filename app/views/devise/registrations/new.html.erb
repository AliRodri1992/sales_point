<% content_for :title, t('.page_title') %>

<div class="min-h-screen w-full bg-slate-900 <%= "theme-#{current_terminal_theme}" %> <%= "theme-selected" if terminal_theme_selected? %>" data-controller="terminal" data-terminal-target="wrapper">
  <div class="flex min-h-screen w-full flex-col lg:flex-row">
    <aside class="relative hidden min-h-screen select-none overflow-hidden bg-slate-900 text-white lg:flex lg:w-[42%] lg:flex-col lg:justify-between lg:p-12">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(16,185,129,0.14),transparent_38%)]"></div>
      <div class="pointer-events-none absolute inset-0 opacity-[0.08] [background-image:linear-gradient(rgba(255,255,255,0.16)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.16)_1px,transparent_1px)] [background-size:24px_24px]"></div>
      <div class="relative z-10 flex items-center gap-3">
        <%= image_tag "isotipo.png", class: "h-20 w-20 shrink-0 rounded-full", alt: t('.brand_alt') %>
        <div class="flex flex-col leading-none"><span class="font-jakarta text-[30px] font-extrabold tracking-tight text-white">DELTA <span class="text-emerald-500">POS</span></span><span class="mt-1 font-sans text-xs font-medium uppercase leading-none tracking-[0.2em] text-slate-400"><%= t('.brand_tagline') %></span></div>
      </div>
      <div class="relative z-10 my-auto max-w-md space-y-6">
        <div class="space-y-3"><span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-[11px] font-semibold text-emerald-400"><span aria-hidden="true">⚡</span><%= t('.panel_badge') %></span><h1 class="font-jakarta text-3xl font-extrabold leading-tight tracking-tight lg:text-4xl"><%= t('.panel_title') %></h1><p class="text-sm leading-relaxed text-slate-400"><%= t('.panel_description') %></p></div>
        <div class="space-y-3.5 border-t border-white/[0.06] pt-5"><div class="flex items-start gap-3"><div class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-md bg-emerald-500/10 text-xs font-bold text-emerald-400">✓</div><div><h2 class="text-xs font-semibold leading-none text-white"><%= t('.benefit_one_title') %></h2><p class="mt-1 text-[11px] leading-relaxed text-slate-400"><%= t('.benefit_one_description') %></p></div></div><div class="flex items-start gap-3"><div class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-md bg-emerald-500/10 text-xs font-bold text-emerald-400">✓</div><div><h2 class="text-xs font-semibold leading-none text-white"><%= t('.benefit_two_title') %></h2><p class="mt-1 text-[11px] leading-relaxed text-slate-400"><%= t('.benefit_two_description') %></p></div></div></div>
      </div>
      <p class="relative z-10 text-[11px] tracking-wide text-slate-500"><%= t('.copyright', year: Time.current.year) %></p>
    </aside>
    <main class="relative flex min-h-screen w-full flex-col bg-white lg:w-[58%] lg:overflow-hidden">
      <div class="absolute right-6 top-6 z-30 flex items-center gap-3"><%= render Authentication::ThemeSelectorComponent.new(themes: terminal_themes, current_theme: current_terminal_theme) %><%= render Authentication::LanguageSelectorComponent.new(current_language: current_language, languages: terminal_languages) %></div>
      <div class="flex min-h-screen w-full items-center justify-center overflow-y-auto px-6 py-24 sm:px-12 lg:px-16 lg:py-16"><div class="my-auto w-full max-w-sm space-y-5"><section data-terminal-target="loginCard" class="space-y-5">
        <div class="space-y-1"><h2 class="font-jakarta text-2xl font-extrabold tracking-tight text-slate-900"><%= t('.title') %></h2><p class="text-xs text-slate-500"><%= t('.subtitle') %></p></div>
        <%= render Authentication::ErrorBannerComponent.new(resource: resource) %>
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: 'space-y-4', autocomplete: 'off', novalidate: true }) do |f| %>
          <div><% email_has_error = resource.errors[:email].present? %><%= f.label :email, t('.email'), class: 'block font-jakarta text-xs font-medium text-slate-700' %><%= f.email_field :email, autofocus: true, autocomplete: 'email', placeholder: t('.email_placeholder'), class: "input-field mt-1 block w-full appearance-none rounded-xl border bg-white px-3 py-2 text-xs text-slate-800 shadow-sm transition-all placeholder:text-slate-400 #{email_has_error ? 'input-field-error border-rose-500 bg-rose-50' : 'border-slate-200'}", data: { terminal_target: 'input', action: 'input->terminal#clearErrors' } %><%= error_message_for(resource, :email) %></div>
          <div><% password_has_error = resource.errors[:password].present? %><%= f.label :password, t('.password'), class: 'block font-jakarta text-xs font-medium text-slate-700' %><% if @minimum_password_length %><p class="mt-1 text-[11px] text-slate-400"><%= t('.password_minimum', count: @minimum_password_length) %></p><% end %><div class="relative mt-1"><%= f.password_field :password, autocomplete: 'new-password', placeholder: '••••••••', class: "input-field block w-full appearance-none rounded-xl border bg-white px-3 py-2 pr-10 text-xs text-slate-900 shadow-sm transition-all #{password_has_error ? 'input-field-error border-rose-500 bg-rose-50' : 'border-slate-200'}", data: { terminal_target: 'password' } %><button type="button" data-action="click->terminal#togglePassword" class="absolute right-2.5 top-1/2 -translate-y-1/2 rounded-lg p-1 text-slate-400 transition hover:text-slate-600" aria-label="<%= t('.toggle_password') %>"><%= icon 'eye', variant: :outline, class: 'h-4 w-4' %></button></div><%= error_message_for(resource, :password) %></div>
          <div><% confirmation_has_error = resource.errors[:password_confirmation].present? %><%= f.label :password_confirmation, t('.password_confirmation'), class: 'block font-jakarta text-xs font-medium text-slate-700' %><%= f.password_field :password_confirmation, autocomplete: 'new-password', placeholder: '••••••••', class: "input-field mt-1 block w-full appearance-none rounded-xl border bg-white px-3 py-2 text-xs text-slate-900 shadow-sm transition-all #{confirmation_has_error ? 'input-field-error border-rose-500 bg-rose-50' : 'border-slate-200'}", data: { terminal_target: 'input', action: 'input->terminal#clearErrors' } %><%= error_message_for(resource, :password_confirmation) %></div>
          <button type="submit" data-terminal-target="loginSubmit" data-loading-text="<%= t('.submitting') %>" class="btn-submit-dynamic flex w-full items-center justify-center gap-2 rounded-xl px-6 py-3 text-xs font-semibold tracking-wide text-white shadow-md transition-all duration-200"><span><%= t('.submit') %></span><%= icon 'arrow-right', variant: :outline, class: 'h-4 w-4' %></button>
        <% end %>
        <div class="border-t border-slate-100 pt-4 text-center"><p class="text-xs text-slate-500"><%= t('.already_have_account') %> <%= link_to t('.sign_in'), new_user_session_path, class: 'font-semibold theme-text transition hover:opacity-80' %></p></div>
      </section></div></div>
    </main>
  </div>
</div>
