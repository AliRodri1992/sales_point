<% content_for :title, t(".page_title") %>

<div
  class="registration-page min-h-screen w-full bg-slate-900 <%= current_terminal_theme %> <%= "theme-selected" if terminal_theme_selected? %>"
  data-controller="terminal registration-wizard"
  data-terminal-target="wrapper"
  data-registration-wizard-target="wrapper"
  data-initial-step="<%= @registration_error_step || 1 %>"
  data-action="keydown->registration-wizard#handleKeydown input->registration-wizard#clearFieldError change->registration-wizard#clearFieldError"
  data-validation-required="<%= t(".client_validation_required") %>"
  data-validation-password-match="<%= t(".client_validation_password_match") %>"
  data-validation-tax-id="<%= t(".client_validation_tax_id") %>"
  data-validation-branches="<%= t(".client_validation_branches") %>"
  data-validation-terms="<%= t(".client_validation_terms") %>"
  data-validation-email="<%= t(".client_validation_email") %>"
  data-validation-field-required="<%= t(".client_validation_field_required") %>"
  data-validation-tax-format="<%= t(".client_validation_tax_format") %>"
  data-validation-password-length="<%= t(".client_validation_password_length") %>">

  <div class="flex min-h-screen w-full flex-col lg:h-dvh lg:min-h-0 lg:flex-row">
    <aside class="relative hidden min-h-screen select-none overflow-hidden bg-slate-900 text-white lg:sticky lg:top-0 lg:flex lg:h-dvh lg:min-h-0 lg:w-[42%] lg:flex-col lg:justify-between lg:p-12">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(16,185,129,0.14),transparent_38%)]"></div>
      <div class="pointer-events-none absolute inset-0 opacity-[0.08] [background-image:linear-gradient(rgba(255,255,255,0.16)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.16)_1px,transparent_1px)] [background-size:24px_24px]"></div>

      <div class="relative z-10 flex items-center gap-3">
        <%= image_tag "delta-pos-logo.svg", class: "h-20 w-20 shrink-0", alt: t(".brand_alt") %>
        <div class="flex flex-col leading-none">
          <span class="font-jakarta text-[30px] font-extrabold tracking-tight text-white">
            DELTA <span class="text-emerald-500">POS</span>
          </span>
          <span class="mt-0.5 font-sans text-xs font-medium uppercase leading-none tracking-[0.2em] text-slate-400">
            <%= t(".brand_tagline") %>
          </span>
        </div>
      </div>

      <div class="relative z-10 my-auto max-w-md space-y-6">
        <div class="space-y-3">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-400">
            <span aria-hidden="true">⚡</span>
            <%= t(".panel_badge") %>
          </span>
          <h1 class="font-jakarta text-3xl font-extrabold leading-tight tracking-tight lg:text-4xl">
            <%= t(".panel_title") %>
          </h1>
          <p class="text-sm leading-relaxed text-slate-400">
            <%= t(".panel_description") %>
          </p>
        </div>

        <div class="space-y-3.5 border-t border-white/[0.06] pt-5">
          <div class="flex items-start gap-3">
            <div class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-md bg-emerald-500/10 text-xs font-bold text-emerald-400">✓</div>
            <div>
              <h2 class="text-xs font-semibold leading-none text-white"><%= t(".benefit_one_title") %></h2>
              <p class="mt-1 text-xs leading-relaxed text-slate-400"><%= t(".benefit_one_description") %></p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-md bg-emerald-500/10 text-xs font-bold text-emerald-400">✓</div>
            <div>
              <h2 class="text-xs font-semibold leading-none text-white"><%= t(".benefit_two_title") %></h2>
              <p class="mt-1 text-xs leading-relaxed text-slate-400"><%= t(".benefit_two_description") %></p>
            </div>
          </div>
        </div>
      </div>

      <p class="relative z-10 text-xs tracking-wide text-slate-500">
        <%= t(".copyright") %>
      </p>
    </aside>

    <main class="relative flex min-h-screen w-full flex-col bg-white lg:h-dvh lg:min-h-0 lg:w-[58%] lg:overflow-hidden">
      <div class="absolute left-5 top-6 z-30 flex items-center gap-2 lg:hidden" aria-label="Delta POS">
        <%= image_tag "delta-pos-logo.svg", class: "h-9 w-9", alt: "" %>
        <span class="font-jakarta text-base font-extrabold tracking-tight text-slate-900">DELTA <span class="text-emerald-700">POS</span></span>
      </div>
      <div class="absolute right-6 top-6 z-40 flex items-center gap-3">
        <%= render Authentication::ThemeSelectorComponent.new(themes: terminal_themes, current_theme: current_terminal_theme) %>
        <%= render Authentication::LanguageSelectorComponent.new(current_language: current_language, languages: terminal_languages) %>
      </div>

      <div class="flex min-h-screen w-full items-start justify-center px-5 pb-12 pt-28 sm:px-10 lg:h-full lg:min-h-0 lg:overflow-y-auto lg:overscroll-contain lg:px-16 lg:py-16">
        <div data-registration-form-card class="mx-auto w-full max-w-lg space-y-6">
          <%= form_for(
            resource,
            as: resource_name,
            url: registration_path(resource_name),
            html: {
              class: "space-y-5",
              novalidate: true,
              data: { action: "submit->registration-wizard#submit" }
            }
          ) do |f| %>
            <%= hidden_field_tag :setup_type, params[:setup_type].to_s, data: { registration_wizard_target: "setupType" } %>
            <%= hidden_field_tag :business_sector, params[:business_sector].to_s, data: { registration_wizard_target: "businessSector" } %>
            <%= hidden_field_tag :migration_volume, params[:migration_volume].to_s, data: { registration_wizard_target: "migrationVolume" } %>
            <%= hidden_field_tag :migration_priority, params[:migration_priority].to_s, data: { registration_wizard_target: "migrationPriority" } %>
            <%= hidden_field_tag :branches, "1", data: { registration_wizard_target: "branchesHidden" } %>
            <%= hidden_field_tag :currency, params[:currency].presence || "MXN", data: { registration_wizard_target: "currency" } %>
            <%= hidden_field_tag :terminals, params[:terminals].presence || "1", data: { registration_wizard_target: "terminals" } %>
            <%= hidden_field_tag :payment_integration, params[:payment_integration].presence || "cash", data: { registration_wizard_target: "payments" } %>

            <%= hidden_field_tag :timezone, params[:timezone].presence || "America/Mexico_City", data: { registration_wizard_target: "timezone" } %>
            <%= render Authentication::ErrorBannerComponent.new(resource: resource) %>
            <header class="mb-4 space-y-1.5">
              <h1 class="font-jakarta text-2xl font-extrabold tracking-tight text-slate-900"><%= t(".title") %></h1>
              <p class="text-sm leading-relaxed text-slate-600"><%= t(".subtitle") %></p>
            </header>
            <noscript><p class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900"><%= t(".no_script") %></p></noscript>

            <nav class="relative mx-auto mb-6 flex w-full max-w-lg select-none items-start justify-between" aria-label="<%= t(".step_label") %>">
              <div class="absolute left-[10%] right-[10%] top-4 z-0 h-0.5 bg-slate-200">
                <div data-registration-wizard-target="progress" class="h-full w-0 bg-emerald-700 transition-all duration-300"></div>
              </div>
              <% step_keys = %w[one two three four five] %>
              <% 5.times do |index| %>
                <div class="relative z-10 flex w-1/5 min-w-0 flex-col items-center gap-2 text-center">
                  <div data-registration-wizard-target="node" data-step="<%= index + 1 %>"
                    aria-label="<%= t(".step_names.#{step_keys[index]}") %>"
                    class="flex h-8 w-8 items-center justify-center rounded-full border-2 border-slate-200 bg-white text-xs font-bold text-slate-500 transition-all duration-300">
                    <%= index + 1 %>
                  </div>
                  <span data-step-label class="text-xs font-medium leading-tight text-slate-600"><%= t(".step_names.#{step_keys[index]}") %></span>
                </div>
              <% end %>
            </nav>

            <span data-registration-wizard-target="stepCounter" class="sr-only">1 / 5</span>

            <section data-registration-wizard-target="step" data-step="1" class="space-y-5">
              <div>
                <h2 class="font-jakarta text-base font-extrabold leading-none text-slate-900"><%= t(".step_one.title") %></h2>
                <p class="mt-1 text-xs text-slate-400"><%= t(".step_one.subtitle") %></p>
              </div>

              <div data-field class="relative space-y-3 pb-9">
                <% [
                  ["new", "step_one.new_title", "step_one.new_description", "sparkles"],
                  ["migration", "step_one.migration_title", "step_one.migration_description", "arrow-path"]
                ].each do |type, title_key, description_key, icon_name| %>
                  <button
                    type="button"
                    data-action="click->registration-wizard#selectSetup"
                    data-setup-type="<%= type %>"
                    data-registration-wizard-target="setupCard"
                    class="group relative flex w-full cursor-pointer appearance-none items-start space-x-3 rounded-xl border-2 border-slate-100 bg-white p-3.5 text-left shadow-sm transition-all duration-200 hover:border-emerald-600"
                    aria-pressed="false">
                    <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 transition-transform group-hover:scale-105">
                      <%= delta_icon icon_name, class: "h-4 w-4" %>
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="block text-xs font-bold leading-none text-slate-900"><%= t(".#{title_key}") %></span>
                      <span class="mt-1.5 block text-xs leading-normal text-slate-400"><%= t(".#{description_key}") %></span>
                    </span>                  </button>
                <% end %>
              </div>
            </section>

            <section data-registration-wizard-target="step" data-step="2" class="hidden space-y-5">
              <div>
                <h2 class="font-jakarta text-base font-extrabold leading-none text-slate-900"><%= t(".step_two.title") %></h2>
                <p class="mt-1 text-xs text-slate-400"><%= t(".step_two.subtitle") %></p>
              </div>

              <div data-field class="relative pb-9">
                <label for="first-name" class="block font-jakarta text-xs font-medium text-slate-700"><%= t(".step_two.first_name") %></label>
                <input id="first-name" name="first_name" value="<%= params[:first_name] %>" type="text" autocomplete="given-name" placeholder="<%= t(".step_two.first_name_placeholder") %>" class="appearance-none mt-1 block w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-800 shadow-sm placeholder-slate-400 transition-all focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" data-registration-wizard-target="firstName">
              </div>

              <div data-field class="relative pb-9">
                <label for="last-name" class="block font-jakarta text-xs font-medium text-slate-700"><%= t(".step_two.last_name") %></label>
                <input id="last-name" name="last_name" value="<%= params[:last_name] %>" type="text" autocomplete="family-name" placeholder="<%= t(".step_two.last_name_placeholder") %>" class="appearance-none mt-1 block w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-800 shadow-sm placeholder-slate-400 transition-all focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" data-registration-wizard-target="lastName">
              </div>

              <div data-field class="relative pb-9">
                <%= f.label :email, t(".step_two.email"), class: "block font-jakarta text-xs font-medium text-slate-700" %>
                <%= f.email_field :email, value: resource.email, autocomplete: "email", placeholder: t(".step_two.email_placeholder"), class: "appearance-none mt-1 block w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-800 shadow-sm placeholder-slate-400 transition-all focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500", data: { registration_wizard_target: "input" } %>
                <% if resource.errors[:email].any? %>
                  <p data-registration-field-error role="alert" class="absolute inset-x-0 bottom-0 h-9 overflow-y-auto text-xs font-medium leading-4 text-rose-700"><%= resource.errors[:email].first %></p>
                <% end %>
              </div>

              <div class="grid gap-3 sm:grid-cols-2">
                <div data-field class="relative pb-9">
                  <%= f.label :password, t(".step_two.password"), class: "block font-jakarta text-xs font-medium text-slate-700" %>
                  <div class="relative mt-1">
                    <%= f.password_field :password, autocomplete: "new-password", placeholder: "••••••••", class: "appearance-none block w-full rounded-xl border border-slate-200 px-4 py-3 pr-10 text-sm text-slate-800 shadow-sm placeholder-slate-400 transition-all focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500", data: { registration_wizard_target: "password" } %>
                    <button type="button" data-action="click->registration-wizard#togglePassword" class="absolute right-2 top-1/2 -translate-y-1/2 rounded-lg p-1 text-slate-400" aria-label="<%= t(".step_two.toggle_password") %>">
                      <%= delta_icon "eye", class: "h-4 w-4" %>
                    </button>
                  </div>
                  <% if @minimum_password_length %><p class="mt-1 text-xs text-slate-400"><%= t(".step_two.password_minimum", count: @minimum_password_length) %></p><% end %>
                  <% if resource.errors[:password].any? %>
                  <p data-registration-field-error role="alert" class="absolute inset-x-0 bottom-0 h-9 overflow-y-auto text-xs font-medium leading-4 text-rose-700"><%= resource.errors[:password].first %></p>
                <% end %>
                </div>
                <div data-field class="relative pb-9">
                  <%= f.label :password_confirmation, t(".step_two.password_confirmation"), class: "block font-jakarta text-xs font-medium text-slate-700" %>
                  <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••", class: "appearance-none mt-1 block w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-800 shadow-sm placeholder-slate-400 transition-all focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500", data: { registration_wizard_target: "confirmation" } %>
                  <% if resource.errors[:password_confirmation].any? %>
                  <p data-registration-field-error role="alert" class="absolute inset-x-0 bottom-0 h-9 overflow-y-auto text-xs font-medium leading-4 text-rose-700"><%= resource.errors[:password_confirmation].first %></p>
                <% end %>
                </div>
              </div>
            </section>

            <section data-registration-wizard-target="step" data-step="3" class="hidden space-y-5">
              <div>
                <h2 class="font-jakarta text-base font-extrabold leading-none text-slate-900"><%= t(".step_three.title") %></h2>
                <p class="mt-1 text-xs text-slate-400"><%= t(".step_three.subtitle") %></p>
              </div>

              <div data-field class="relative pb-9">
                <label for="company-name" class="block font-jakarta text-xs font-medium text-slate-700"><%= t(".step_three.company_name") %></label>
                <input id="company-name" name="company_name" value="<%= params[:company_name] %>" type="text" placeholder="<%= t(".step_three.company_name_placeholder") %>" class="appearance-none mt-1 block w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-800 shadow-sm placeholder-slate-400 transition-all focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" data-registration-wizard-target="companyName">
              </div>

              <div data-field class="relative pb-9">
                <label for="tax-id" class="block font-jakarta text-xs font-medium text-slate-700"><%= t(".step_three.tax_id") %></label>
                <input id="tax-id" name="tax_id" value="<%= params[:tax_id] %>" type="text" maxlength="13" placeholder="<%= t(".step_three.tax_id_placeholder") %>" class="appearance-none mt-1 block w-full rounded-xl border border-slate-200 px-4 py-3 text-sm uppercase text-slate-800 shadow-sm placeholder-slate-400 transition-all focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" data-registration-wizard-target="taxId">
              </div>
            </section>

            <section data-registration-wizard-target="step" data-step="4" class="hidden space-y-5">
              <div>
                <h2 class="font-jakarta text-base font-extrabold leading-none text-slate-900"><%= t(".step_four.title") %></h2>
                <p class="mt-1 text-xs text-slate-400"><%= t(".step_four.subtitle") %></p>
              </div>

              <div data-field class="relative pb-9">
                <label for="business-sector" class="block font-jakarta text-xs font-medium text-slate-700"><%= t(".step_four.business_sector") %></label>
                <button type="button" id="business-sector" data-registration-wizard-target="dropdown" data-dropdown-name="business-sector" data-action="click->registration-wizard#toggleDropdown" aria-haspopup="listbox" aria-expanded="false" aria-controls="registration-menu-business-sector" class="mt-1 flex w-full items-center justify-between rounded-xl border border-slate-200 px-3 py-1.5 text-left text-xs text-slate-800 shadow-sm transition-all focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500">
                  <span data-registration-wizard-target="dropdownLabel"><%= t(".step_four.select_sector") %></span>
                  <%= delta_icon "chevron-down", class: "h-4 w-4 shrink-0 text-slate-400" %>
                </button>
                <div data-registration-wizard-target="dropdownMenu" data-dropdown-name="business-sector" id="registration-menu-business-sector" role="listbox" class="absolute left-0 right-0 z-40 mt-1 hidden w-full overflow-hidden rounded-xl border border-slate-100/80 bg-white shadow-2xl focus:outline-none">
                  <% [["grocery", ".step_four.sectors.grocery"], ["fashion", ".step_four.sectors.fashion"], ["restaurant", ".step_four.sectors.restaurant"], ["pharmacy", ".step_four.sectors.pharmacy"]].each do |value, label_key| %>
                    <button type="button" role="option" data-dropdown-name="business-sector" data-dropdown-value="<%= value %>" data-dropdown-label="<%= t(label_key) %>" data-action="click->registration-wizard#selectDropdown" class="w-full text-left px-4 py-2 text-xs font-semibold text-slate-600 transition-all duration-150 hover:bg-gradient-to-br hover:from-emerald-600 hover:to-teal-600 hover:text-white focus:outline-none focus:ring-0" data-dropdown-option="true">
                      <%= t(label_key) %>
                    </button>
                  <% end %>
                </div>
              </div>

              <div data-registration-wizard-target="migrationFields" class="hidden grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="migration-volume" class="block font-jakarta text-xs font-medium text-slate-700"><%= t(".step_four.migration_volume") %></label>
                  <select id="migration-volume" class="mt-1 block w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-800 shadow-sm transition-all focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" data-action="change->registration-wizard#selectVolume">
                    <option value=""><%= t(".step_four.select_volume") %></option>
                    <option value="under_500" <%= "selected" if params[:migration_volume] == "under_500" %>><%= t(".step_four.volumes.under_500") %></option>
                    <option value="500_5000" <%= "selected" if params[:migration_volume] == "500_5000" %>><%= t(".step_four.volumes.500_5000") %></option>
                    <option value="over_5000" <%= "selected" if params[:migration_volume] == "over_5000" %>><%= t(".step_four.volumes.over_5000") %></option>
                  </select>
                </div>
                <div>
                  <label for="migration-priority" class="block font-jakarta text-xs font-medium text-slate-700"><%= t(".step_four.migration_priority") %></label>
                  <select id="migration-priority" class="mt-1 block w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-800 shadow-sm transition-all focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" data-action="change->registration-wizard#selectPriority">
                    <option value=""><%= t(".step_four.select_priority") %></option>
                    <option value="catalog" <%= "selected" if params[:migration_priority] == "catalog" %>><%= t(".step_four.priorities.catalog") %></option>
                    <option value="inventory" <%= "selected" if params[:migration_priority] == "inventory" %>><%= t(".step_four.priorities.inventory") %></option>
                    <option value="customers" <%= "selected" if params[:migration_priority] == "customers" %>><%= t(".step_four.priorities.customers") %></option>
                    <option value="all" <%= "selected" if params[:migration_priority] == "all" %>><%= t(".step_four.priorities.all") %></option>
                  </select>
                </div>
              </div>

              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="branches-input" class="block font-jakarta text-xs font-medium text-slate-700"><%= t(".step_four.branches") %></label>
                  <input id="branches-input" type="number" min="1" value="1" class="mt-1 block w-full cursor-not-allowed rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-500 shadow-sm" disabled>
                  <p class="mt-1.5 text-xs leading-relaxed text-slate-500"><%= t(".branch_hint") %></p>
                </div>
                <div data-field class="relative pb-9">
                  <label for="currency" class="block font-jakarta text-xs font-medium text-slate-700"><%= t(".step_four.currency") %></label>
                  <button type="button" id="currency" data-registration-wizard-target="dropdown" data-dropdown-name="currency" data-action="click->registration-wizard#toggleDropdown" aria-haspopup="listbox" aria-expanded="false" aria-controls="registration-menu-currency" class="mt-1 flex w-full items-center justify-between rounded-xl border border-slate-200 px-3 py-1.5 text-left text-xs text-slate-800 shadow-sm transition-all focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500">
                    <span data-registration-wizard-target="dropdownLabel"><%= params[:currency].presence || "MXN" %></span>
                    <%= delta_icon "chevron-down", class: "h-4 w-4 shrink-0 text-slate-400" %>
                  </button>
                  <div data-registration-wizard-target="dropdownMenu" data-dropdown-name="currency" id="registration-menu-currency" role="listbox" class="absolute left-0 right-0 z-40 mt-1 hidden w-full overflow-hidden rounded-xl border border-slate-100/80 bg-white shadow-2xl focus:outline-none">
                    <% @currencies.each do |currency| %>
                      <button type="button" role="option" data-dropdown-name="currency" data-dropdown-value="<%= currency.code %>" data-dropdown-label="<%= currency.code %>" data-action="click->registration-wizard#selectDropdown" class="w-full text-left px-4 py-2 text-xs font-semibold text-slate-600 transition-all duration-150 hover:bg-gradient-to-br hover:from-emerald-600 hover:to-teal-600 hover:text-white focus:outline-none focus:ring-0" data-dropdown-option="true">
                        <%= currency.code %>
                      </button>
                    <% end %>
                  </div>
                </div>
              </div>
              <div data-field class="relative mt-4 pb-9">
                <label for="timezone-select" class="block font-jakarta text-sm font-medium text-slate-700"><%= t(".timezone_label") %></label>
                <select id="timezone-select" data-action="change->registration-wizard#selectTimezone" class="mt-1 block min-h-11 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-800 shadow-sm focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600">
                  <% OrganizationSetting::ONBOARDING_TIMEZONES.each do |zone| %>
                    <option value="<%= zone %>" <%= "selected" if (params[:timezone].presence || "America/Mexico_City") == zone %>><%= zone %></option>
                  <% end %>
                </select>
              </div>
            </section>

            <section data-registration-wizard-target="step" data-step="5" class="hidden space-y-5">
              <div>
                <h2 class="font-jakarta text-base font-extrabold leading-none text-slate-900"><%= t(".step_five.title") %></h2>
                <p class="mt-1 text-xs text-slate-400"><%= t(".step_five.subtitle") %></p>
              </div>

              <div data-field class="relative pb-9">
                <label for="terminals" class="block font-jakarta text-xs font-medium text-slate-700"><%= t(".step_five.terminals") %></label>
                <button type="button" id="terminals" data-registration-wizard-target="dropdown" data-dropdown-name="terminals" data-action="click->registration-wizard#toggleDropdown" aria-haspopup="listbox" aria-expanded="false" aria-controls="registration-menu-terminals" class="mt-1 flex w-full items-center justify-between rounded-xl border border-slate-200 px-3 py-1.5 text-left text-xs text-slate-800 shadow-sm transition-all focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500">
                  <span data-registration-wizard-target="dropdownLabel"><%= t(".step_five.terminal_options.one") %></span>
                  <%= delta_icon "chevron-down", class: "h-4 w-4 shrink-0 text-slate-400" %>
                </button>
                <div data-registration-wizard-target="dropdownMenu" data-dropdown-name="terminals" id="registration-menu-terminals" role="listbox" class="absolute left-0 right-0 z-40 mt-1 hidden w-full overflow-hidden rounded-xl border border-slate-100/80 bg-white shadow-2xl focus:outline-none">
                  <% [["1", ".step_five.terminal_options.one"], ["2", ".step_five.terminal_options.two"], ["3", ".step_five.terminal_options.three_five"], ["4", ".step_five.terminal_options.four"], ["5", ".step_five.terminal_options.five"], ["6", ".step_five.terminal_options.over_five"]].each do |value, label_key| %>
                    <button type="button" role="option" data-dropdown-name="terminals" data-dropdown-value="<%= value %>" data-dropdown-label="<%= t(label_key) %>" data-action="click->registration-wizard#selectDropdown" class="w-full text-left px-4 py-2 text-xs font-semibold text-slate-600 transition-all duration-150 hover:bg-gradient-to-br hover:from-emerald-600 hover:to-teal-600 hover:text-white focus:outline-none focus:ring-0" data-dropdown-option="true">
                      <%= t(label_key) %>
                    </button>
                  <% end %>
                </div>
              </div>

              <div data-field class="relative pb-9">
                <label for="payment-integration" class="block font-jakarta text-xs font-medium text-slate-700"><%= t(".step_five.payments") %></label>
                <button type="button" id="payment-integration" data-registration-wizard-target="dropdown" data-dropdown-name="payment-integration" data-action="click->registration-wizard#toggleDropdown" aria-haspopup="listbox" aria-expanded="false" aria-controls="registration-menu-payment-integration" class="mt-1 flex w-full items-center justify-between rounded-xl border border-slate-200 px-3 py-1.5 text-left text-xs text-slate-800 shadow-sm transition-all focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500">
                  <span data-registration-wizard-target="dropdownLabel"><%= t(".step_five.payment_options.cash") %></span>
                  <%= delta_icon "chevron-down", class: "h-4 w-4 shrink-0 text-slate-400" %>
                </button>
                <div data-registration-wizard-target="dropdownMenu" data-dropdown-name="payment-integration" id="registration-menu-payment-integration" role="listbox" class="absolute left-0 right-0 z-40 mt-1 hidden w-full overflow-hidden rounded-xl border border-slate-100/80 bg-white shadow-2xl focus:outline-none">
                  <% [["cash", ".step_five.payment_options.cash"], ["card", ".step_five.payment_options.card"], ["qr", ".step_five.payment_options.qr"]].each do |value, label_key| %>
                    <button type="button" role="option" data-dropdown-name="payment-integration" data-dropdown-value="<%= value %>" data-dropdown-label="<%= t(label_key) %>" data-action="click->registration-wizard#selectDropdown" class="w-full text-left px-4 py-2 text-xs font-semibold text-slate-600 transition-all duration-150 hover:bg-gradient-to-br hover:from-emerald-600 hover:to-teal-600 hover:text-white focus:outline-none focus:ring-0" data-dropdown-option="true">
                      <%= t(label_key) %>
                    </button>
                  <% end %>
                </div>
              </div>

              <p class="text-xs leading-relaxed text-slate-500"><%= t(".payment_hint") %></p>
              <div data-registration-wizard-target="summary" class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <h3 class="text-sm font-bold text-slate-900"><%= t(".registration_summary") %></h3>
                <p class="mt-1 text-xs text-slate-500"><%= t(".registration_summary_hint") %></p>
                <dl class="mt-3 grid gap-x-4 gap-y-3 sm:grid-cols-2">
                  <% [[:name, "step_two.first_name"], [:email, "step_two.email"], [:company, "step_three.company_name"], [:tax, "step_three.tax_id"], [:sector, "step_four.business_sector"], [:currency, "step_four.currency"], [:terminals, "step_five.terminals"], [:payment, "step_five.payments"]].each do |key, label| %>
                    <div class="min-w-0">
                      <dt class="text-xs font-medium text-slate-500"><%= t(".#{label}") %></dt>
                      <dd data-summary-key="<%= key %>" class="mt-1 break-words text-sm font-semibold text-slate-900">—</dd>
                    </div>
                  <% end %>
                </dl>
              </div>
              <div data-field class="relative pb-9 pt-1">
                <div class="flex items-start gap-3">
                  <input id="terms" name="terms" type="checkbox" value="1" <%= "checked" if params[:terms].to_s.in?(%w[1 on true]) %> class="mt-0.5 h-5 w-5 shrink-0 rounded-md border border-slate-300 bg-white shadow-sm accent-[var(--theme-primary-start)] focus:ring-2 focus:ring-emerald-600" data-registration-wizard-target="terms">
                  <label for="terms" class="block text-sm leading-relaxed text-slate-700"><%= t(".step_five.terms") %></label>
                </div>
              </div>
            </section>

            <div class="grid grid-cols-2 gap-3 pt-1.5">
              <button
                type="button"
                data-registration-wizard-target="back"
                data-action="click->registration-wizard#previous"
                class="hidden min-h-12 w-full border border-slate-200 py-3 text-sm font-semibold text-slate-700 transition rounded-xl hover:bg-slate-50">
                <%= t(".back") %>
              </button>
              <button
                type="button"
                data-registration-wizard-target="next"
                data-action="click->registration-wizard#next"
                data-next-label="<%= t(".next") %>"
                data-submit-label="<%= t(".submit") %>"
                data-saving-label="<%= t(".saving") %>"
                class="col-span-2 flex min-h-12 w-full items-center justify-center rounded-xl px-4 py-3 text-sm font-semibold text-white shadow-md btn-delta-gradient transition-all duration-150 hover:scale-[0.99] active:scale-[0.98] focus:outline-none">
                <span><%= t(".next") %></span>
              </button>
            </div>
          <% end %>

          <div class="mt-4 border-t border-slate-100 pt-4 text-center">
            <p class="text-xs text-slate-500">
              <%= t(".already_have_account") %>
              <%= link_to t(".sign_in"), new_user_session_path, class: "font-semibold text-theme-link hover:opacity-85" %>
            </p>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>
