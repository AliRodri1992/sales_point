<% content_for :title, t('.page_title') %>

<%= render Landing::NavbarComponent.new %>

<main class="overflow-x-hidden bg-white text-slate-900">
  <section class="bg-slate-50 pb-12 pt-4 sm:pb-16 sm:pt-6 lg:pb-20 lg:pt-8">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <%= link_to root_path, class: "mb-8 inline-flex items-center gap-2 font-semibold text-blue-600 transition hover:text-blue-800" do %>
        <%= icon "arrow-left", class: "h-5 w-5" %>
        <%= t('.back') %>
      <% end %>

      <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-20">
        <%= render DemoRequests::BenefitsComponent.new %>
        <%= render DemoRequests::FormComponent.new(
          demo_request: @demo_request,
          notice: flash[:notice]
        ) %>
      </div>
    </div>
  </section>
</main>

<%= render Landing::FooterComponent.new %>
