<% content_for :title, t('.page_title') %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<main class="demo-request-page" data-controller="demo-request-wizard"
  data-action="language-selector:changed->demo-request-wizard#changeLanguage keydown->demo-request-wizard#themeKeydown click@window->demo-request-wizard#closeThemeOutside"
  data-demo-request-wizard-network-message-value="<%= t('demo_requests.form.network_error') %>"
  data-demo-request-wizard-server-message-value="<%= t('demo_requests.form.server_error') %>"
  data-demo-request-wizard-close-label-value="<%= t('demo_requests.form.close_notice') %>">
  <div class="demo-layout">
    <section class="demo-benefits relative bg-delta-dark text-white" aria-labelledby="demo-request-title">
      <div class="pointer-events-none absolute inset-0 bg-grid-pattern"></div>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-emerald-600/10 via-transparent to-transparent"></div>
      <%= render DemoRequests::BenefitsComponent.new %>
    </section>
    <section class="demo-main">
      <div class="demo-toolbar">
        <button type="button" data-demo-request-wizard-target="themeButton" data-action="demo-request-wizard#toggleTheme"
          aria-expanded="false" aria-controls="demo-theme-options" class="demo-theme-button">
          <%= render Ui::IconComponent.new(name: 'swatch', size: :sm, color: :gray) %>
          <span><%= t('demo_requests.new.theme') %></span>
          <%= render Ui::IconComponent.new(name: 'chevron-down', size: :xs, color: :gray) %>
        </button>
        <div id="demo-theme-options" data-demo-request-wizard-target="themeDropdown" class="demo-theme-options hidden">
          <p class="mb-3 text-sm font-semibold text-slate-700"><%= t('demo_requests.new.brand_color') %></p>
          <div class="grid grid-cols-4 gap-2 sm:grid-cols-5" role="group" aria-label="<%= t('demo_requests.new.theme') %>">
            <% DemoRequests::FormComponent::THEMES.each do |name, start, finish| %>
              <button type="button" data-demo-request-wizard-target="themeOption" data-action="demo-request-wizard#selectTheme"
                data-theme="<%= name %>" data-start="<%= start %>" data-end="<%= finish %>" aria-pressed="<%= name == 'emerald' %>"
                title="<%= t("demo_requests.form.themes.#{name}") %>" aria-label="<%= t("demo_requests.form.themes.#{name}") %>"
                class="demo-theme-option">
                <span class="h-6 w-6 rounded-full border border-slate-300" style="background: linear-gradient(135deg, <%= start %>, <%= finish %>);" aria-hidden="true"></span>
              </button>
            <% end %>
          </div>
        </div>
        <%= render Authentication::LanguageSelectorComponent.new(
          languages: Language.available.order(:code),
          current_language: Language.available.find_by(code: I18n.locale.to_s) || current_language
        ) %>
      </div>
      <div class="demo-form-shell">
        <header class="mb-8">
          <h1 class="font-jakarta text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl"><%= t('demo_requests.form.title') %></h1>
          <p class="mt-2 text-sm leading-6 text-slate-600"><%= t('demo_requests.new.contact_description') %></p>
        </header>
        <%= render DemoRequests::FormComponent.new(demo_request: @demo_request, notice: flash[:notice]) %>
      </div>
    </section>
  </div>
</main>
